{
  "manifest_version": 3,
  "name": "HLV Invoice Guard",
  "version": "1.0.0",
  "description": "Check AMIS invoice proposal lines against Odoo sale and linked purchase orders.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://amisapp.misa.vn/*",
    "https://www.hoanglongvu-erp.com/*"
  ],
  "action": {
    "default_title": "HLV Invoice Guard",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://amisapp.misa.vn/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
