# Chép thành raw_db.env rồi sửa. Cả full_refresh.sh (bash source) và incremental_sync.py đọc file này,
# nên mỗi dòng chỉ KEY=VALUE, không comment cuối dòng, không dấu cách quanh "=".

# Host khai trong ~/.ssh/config của user chạy đồng bộ (xem README) — trỏ 20926417@hoanglongvu.odoo.com
SSH_TARGET=odoosh-prd
REMOTE_DB=hoanglongvu-prd-20926417

# DB thô trên server này (Postgres 16, kết nối local bằng user đang chạy script)
RAW_DB=hlv_raw

# Chỗ để bản dump, file khoá, log lỗi restore
WORK_DIR=/var/lib/hlv_raw

# Mỗi lần đồng bộ đọc lùi lại từng này phút trước mốc lần trước: bản ghi có write_date cũ
# nhưng commit muộn vẫn được lấy; đọc trùng không sao vì upsert theo id.
OVERLAP_MINUTES=10
