<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="hlv_loyalty_misa_payment.Panel">
        <div class="o_lmp" t-att-class="'o_lmp--' + cardStyle.tone">

            <div class="o_lmp__head">
                <i class="o_lmp__icon fa" t-att-class="cardStyle.icon"/>
                <div class="o_lmp__headtext">
                    <div class="o_lmp__over">Thu tiền hóa đơn MISA</div>
                    <div class="o_lmp__title" t-esc="cardStyle.title"/>
                    <div class="o_lmp__sub" t-esc="subline"/>
                </div>
                <div class="o_lmp__actions">
                    <button type="button" class="btn btn-sm btn-light"
                            t-att-disabled="state.loading" t-on-click="onRefresh">
                        <i class="fa fa-refresh me-1"/>Tra lại
                    </button>
                    <button type="button" class="btn btn-sm btn-light"
                            t-att-disabled="state.loading or !state.data" t-on-click="onShowRaw">
                        <i class="fa fa-code me-1"/>Dữ liệu thô
                    </button>
                </div>
            </div>

            <t t-if="!state.loading and !state.error and data.available and !data.error and data.invoice_no">

                <div class="o_lmp__invoices">
                    <div t-foreach="data.vouchers" t-as="voucher" t-key="voucher_index"
                         class="o_lmp__inv" t-att-class="toneClass(voucher.paid_state, 'o_lmp__inv')">
                        <div class="o_lmp__inv-top">
                            <span class="o_lmp__inv-no" t-esc="voucher.invoice_no"/>
                            <span class="o_lmp__pill" t-att-class="toneClass(voucher.paid_state, 'o_lmp__pill')">
                                <i class="fa" t-att-class="stateIcon(voucher.paid_state)"/>
                                <t t-esc="voucher.paid_label"/>
                            </span>
                        </div>
                        <div class="o_lmp__inv-meta">
                            <span t-if="voucher.invoice_series" t-esc="voucher.invoice_series"/>
                            <span t-if="voucher.invoice_date" t-esc="formatDate(voucher.invoice_date)"/>
                            <span t-if="voucher.refno_finance" t-esc="voucher.refno_finance"/>
                        </div>
                        <div class="o_lmp__inv-amount">
                            <t t-esc="formatMoney(voucher.total_amount)"/> đ
                        </div>
                        <div t-if="voucher.partner_name" class="o_lmp__inv-partner" t-esc="voucher.partner_name"/>
                    </div>

                    <div t-if="!data.vouchers.length" class="o_lmp__empty">
                        MISA không trả về chứng từ nào đúng số hóa đơn <b t-esc="data.invoice_no"/>.
                    </div>
                </div>

                <div t-if="data.other_vouchers.length" class="o_lmp__note">
                    <i class="fa fa-exclamation-triangle me-1"/>
                    MISA còn trả về <t t-esc="data.other_vouchers.length"/> chứng từ KHÁC số hóa đơn
                    đang tra (tìm theo kiểu chứa nên lẫn hóa đơn gần giống) — không tính vào kết luận:
                    <t t-foreach="data.other_vouchers" t-as="other" t-key="other_index">
                        <span class="o_lmp__chip ms-1">
                            <t t-esc="other.invoice_no"/> · <t t-esc="other.paid_label"/>
                        </span>
                    </t>
                </div>

                <table class="o_lmp__lines">
                    <thead>
                        <tr>
                            <th>Mã hàng</th>
                            <th>Tên hàng</th>
                            <th>Đơn hàng</th>
                            <th class="text-end">SL điểm / SL HĐ</th>
                            <th class="text-end">Tiền trên HĐ</th>
                            <th t-if="showLineInvoiceColumn">Số hóa đơn</th>
                            <th class="text-end">Thu tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="data.lines" t-as="line" t-key="line_index">
                            <td>
                                <span t-if="line.item_code" class="o_lmp__code" t-esc="line.item_code"/>
                                <span t-else="" class="o_lmp__muted">—</span>
                            </td>
                            <td>
                                <t t-esc="line.product_name"/>
                                <div t-if="line.match_scope === 'code_only'" class="o_lmp__warn">
                                    <i class="fa fa-exclamation-triangle me-1"/>Khớp theo mã hàng, hóa đơn
                                    ghi mã đơn hàng khác — cần kiểm tra tay.
                                </div>
                                <div t-if="line.qty_shortfall" class="o_lmp__warn">
                                    <i class="fa fa-exclamation-triangle me-1"/>Còn
                                    <t t-esc="formatQty(line.qty_shortfall)"/> chưa thấy trên hóa đơn.
                                </div>
                            </td>
                            <td class="o_lmp__muted" t-esc="line.order_code or '—'"/>
                            <td class="text-end o_lmp__nowrap">
                                <t t-esc="formatQty(line.qty)"/>
                                <span class="o_lmp__muted"> / </span>
                                <t t-esc="formatQty(line.invoiced_qty)"/>
                            </td>
                            <td class="text-end o_lmp__nowrap" t-esc="formatMoney(line.invoiced_amount)"/>
                            <td t-if="showLineInvoiceColumn" class="o_lmp__muted" t-esc="invoiceNosOf(line)"/>
                            <td class="text-end">
                                <span class="o_lmp__pill" t-att-class="toneClass(line.paid_state, 'o_lmp__pill')">
                                    <i class="fa" t-att-class="stateIcon(line.paid_state)"/>
                                    <t t-esc="lineLabel(line.paid_state)"/>
                                </span>
                            </td>
                        </tr>
                        <tr t-if="!data.lines.length">
                            <td t-att-colspan="lineColspan" class="o_lmp__empty">
                                Phiếu kho này không có dòng hàng tích điểm nào để đối chiếu.
                            </td>
                        </tr>
                    </tbody>
                </table>

                <div t-if="footnote" class="o_lmp__foot" t-esc="footnote"/>
            </t>
        </div>
    </t>

    <t t-name="hlv_loyalty_misa_payment.RawDialog">
        <Dialog title="'Dữ liệu thô MISA'" size="'xl'">
            <p class="text-muted small">
                Đúng nguyên văn MISA trả về cho 3 bước: tra số hóa đơn, tìm chứng từ bán hàng
                (sa_voucher_get) và chi tiết từng dòng hàng (get_paging_detail).
            </p>
            <pre class="o_loyalty_misa_payment_raw" t-esc="rawText"/>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="onCopy">Copy</button>
                <button class="btn btn-secondary" t-on-click="() => this.props.close()">Đóng</button>
            </t>
        </Dialog>
    </t>

</templates>
