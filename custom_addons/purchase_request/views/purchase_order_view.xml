<odoo>
    <record id="purchase_order_form" model="ir.ui.view">
        <field name="name">purchase.order.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="attributes">
                <attribute name="context">{'res_partner_search_mode': 'supplier', 'show_address': 1, 'default_is_company': True, 'show_vat': True, 'hlv_prioritize_company': True, 'hlv_product_ids': hlv_product_ids}</attribute>
                <attribute name="domain">[('type', '!=', 'delivery')]</attribute>
            </field>
            <field name="partner_id" position="after">
                <field name="hlv_product_ids" widget="many2many_tags" invisible="1"/>
            </field>
            <xpath expr="//field[@name='order_line']/list" position="inside">
                <field name="purchase_request_lines" column_invisible="1" />
                <button
                    invisible="not purchase_request_lines"
                    name="action_open_request_line_tree_view"
                    title="Dòng yêu cầu"
                    type="object"
                    icon="fa-folder-open-o"
                />
            </xpath>
            <xpath expr="//header/button[@name='button_confirm']" position="after">
                <button name="button_confirm" 
                        type="object" 
                        string="Xác nhận đơn hàng" 
                        invisible="state != 'sent'"
                        class="oe_highlight" 
                        data-hotkey="x"/>
            </xpath>

        </field>
    </record>
    <record id="purchase_order_line_form2" model="ir.ui.view">
        <field name="name">purchase.order.line.form2</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_form2" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <separator string="Dòng yêu cầu mua hàng" />
                <field name="purchase_request_lines" />
            </field>
        </field>
    </record>
    <record id="purchase_order_line_tree" model="ir.ui.view">
        <field name="name">purchase.order.line.list</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_tree" />
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="purchase_request_lines" column_invisible="1" />
                <button
                    invisible="not purchase_request_lines"
                    name="action_open_request_line_tree_view"
                    title="Dòng yêu cầu"
                    type="object"
                    icon="fa-folder-open-o"
                />
            </xpath>
        </field>
    </record>
</odoo>
