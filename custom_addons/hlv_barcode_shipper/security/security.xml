<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Shipper Security Group -->
        <record id="group_shipper" model="res.groups">
            <field name="name">Shipper</field>
            <field name="category_id" ref="base.module_category_inventory_inventory"/>
            <field name="comment">Users in this group can scan barcodes and process delivery orders through mobile interface</field>
        </record>
        
        <!-- Shipper Manager Security Group -->
        <record id="group_shipper_manager" model="res.groups">
            <field name="name">Shipper Manager</field>
            <field name="category_id" ref="base.module_category_inventory_inventory"/>
            <field name="implied_ids" eval="[(4, ref('group_shipper'))]"/>
            <field name="comment">Users in this group can manage shipper operations and view scan logs</field>
        </record>
        
        <!-- Record Rules for Shipper Group -->
        
        <!-- Stock Picking - Shippers can only read assigned/partially_available outgoing pickings -->
        <!-- TEMPORARILY DISABLED - May interfere with picking creation -->
        <!--
        <record id="stock_picking_shipper_rule" model="ir.rule">
            <field name="name">Stock Picking: Shipper Access</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="domain_force">[
                ('picking_type_id.code', '=', 'outgoing'),
                ('state', 'in', ['assigned', 'partially_available', 'done'])
            ]</field>
            <field name="groups" eval="[(4, ref('group_shipper'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        -->
        
        <!-- Stock Package Level - Shippers can read/write for scanning -->
        <record id="stock_package_level_shipper_rule" model="ir.rule">
            <field name="name">Stock Package Level: Shipper Access</field>
            <field name="model_id" ref="stock.model_stock_package_level"/>
            <field name="domain_force">[
                ('picking_id.picking_type_id.code', '=', 'outgoing'),
                ('picking_id.state', 'in', ['assigned', 'partially_available', 'done'])
            ]</field>
            <field name="groups" eval="[(4, ref('group_shipper'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <!-- Stock Move Line - Shippers can read/write for scanning -->
        <record id="stock_move_line_shipper_rule" model="ir.rule">
            <field name="name">Stock Move Line: Shipper Access</field>
            <field name="model_id" ref="stock.model_stock_move_line"/>
            <field name="domain_force">[
                ('picking_id.picking_type_id.code', '=', 'outgoing'),
                ('picking_id.state', 'in', ['assigned', 'partially_available', 'done'])
            ]</field>
            <field name="groups" eval="[(4, ref('group_shipper'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <!-- Barcode Scan Log - Shippers can only see their own logs -->
        <record id="barcode_scan_log_shipper_rule" model="ir.rule">
            <field name="name">Barcode Scan Log: Shipper Own Records</field>
            <field name="model_id" ref="model_barcode_scan_log"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_shipper'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <!-- Barcode Scan Log - Managers can see all logs -->
        <record id="barcode_scan_log_manager_rule" model="ir.rule">
            <field name="name">Barcode Scan Log: Manager All Records</field>
            <field name="model_id" ref="model_barcode_scan_log"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_shipper_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        
        <!-- Product access for shippers (read-only) -->
        <record id="product_product_shipper_rule" model="ir.rule">
            <field name="name">Product: Shipper Read Access</field>
            <field name="model_id" ref="product.model_product_product"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_shipper'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <!-- Stock Quant Package access for shippers (read-only) -->
        <record id="stock_quant_package_shipper_rule" model="ir.rule">
            <field name="name">Stock Quant Package: Shipper Read Access</field>
            <field name="model_id" ref="stock.model_stock_quant_package"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_shipper'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <!-- Partner access for shippers (read-only) -->
        <record id="res_partner_shipper_rule" model="ir.rule">
            <field name="name">Partner: Shipper Read Access</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_shipper'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
    </data>
</odoo>