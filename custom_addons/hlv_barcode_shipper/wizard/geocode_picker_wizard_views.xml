<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_geocode_picker_wizard_form" model="ir.ui.view">
        <field name="name">geocode.picker.wizard.form</field>
        <field name="model">geocode.picker.wizard</field>
        <field name="arch" type="xml">
            <form string="Chọn Tọa Độ Trên Bản Đồ">
                <group>
                    <field name="address"/>
                    <group>
                        <field name="latitude"/>
                        <field name="longitude"/>
                    </group>
                </group>
                <div class="o_google_map_picker_container" style="width: 100%; height: 400px; margin-top: 15px; border: 1px solid #ccc;">
                    <field name="map_view" widget="google_map_picker" nolabel="1" class="d-block w-100 h-100"/>
                </div>
                <footer>
                    <button name="action_save" type="object" string="Lưu Tọa Độ" class="btn-primary"/>
                    <button string="Hủy" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
