<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="shipper_interface_v2" name="Barcode Shipper Interface V2">
            <!-- Dùng web.layout để Odoo tự động chèn thư viện web/core/owl -->
            <t t-call="web.layout">
                <t t-set="head">
                    <title>Shipper V2 (OWL)</title>
                    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"/>
                    
                    <!-- FontAwesome -->
                    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css"/>
                    
                    <!-- Assets Backend chứa các module OWL của chúng ta -->
                    <t t-call-assets="web.assets_backend" t-js="true" t-css="true"/>
                    
                    <t t-call-assets="hlv_barcode_shipper.assets_shipper_v2" t-js="true" t-css="true"/>
                    
                    <!-- Global Colors -->
                    <link rel="stylesheet" href="/hlv_barcode_shipper/static/src/css/hlv_global_colors.css"/>
                    <link rel="stylesheet" href="/hlv_barcode_shipper/static/src/css/barcode_shipper.css"/>
                    
                    <!-- Polyfill cho BarcodeDetector -->
                    <script src="https://fastly.jsdelivr.net/npm/barcode-detector@3/dist/iife/polyfill.min.js"></script>
                </t>
                
                <body class="o_web_client bg-light">
                    <!-- Root Mount Point cho OWL App -->
                    <div id="shipper_app_root_v2"></div>
                </body>
            </t>
        </template>
    </data>
</odoo>
