<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Access Denied Template -->
        <template id="access_denied" name="Access Denied">
            <t t-call="web.layout">
                <t t-set="head">
                    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
                    <style>
                        .access-denied-container {
                            max-width: 600px;
                            margin: 50px auto;
                            padding: 40px 20px;
                            text-align: center;
                            background: #ffffff;
                            border-radius: 8px;
                            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
                        }
                        .access-denied-icon {
                            font-size: 64px;
                            color: #dc3545;
                            margin-bottom: 20px;
                        }
                        .access-denied-title {
                            font-size: 24px;
                            font-weight: 600;
                            color: #2c3e50;
                            margin-bottom: 16px;
                        }
                        .access-denied-message {
                            font-size: 16px;
                            color: #6c757d;
                            margin-bottom: 24px;
                            line-height: 1.5;
                        }
                        .access-denied-btn {
                            display: inline-block;
                            padding: 12px 24px;
                            background-color: #007bff;
                            color: white;
                            text-decoration: none;
                            border-radius: 6px;
                            font-weight: 500;
                        }
                        .access-denied-btn:hover {
                            background-color: #0056b3;
                            color: white;
                        }
                    </style>
                </t>

                <div class="access-denied-container">
                    <div class="access-denied-icon">🚫</div>
                    <h1 class="access-denied-title">Access Denied</h1>
                    <p class="access-denied-message">
                        You don't have permission to access the Shipper Scanner.<br/>
                        Please contact your administrator to get "Shipper" access rights.
                    </p>
                    <a href="/web" class="access-denied-btn">← Back to Odoo</a>
                </div>
            </t>
        </template>

        <!-- Mobile Shipper Interface Template -->
        <template id="shipper_interface" name="Shipper Barcode Interface">
            <t t-call="web.layout">
                <t t-set="head">
                    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no"/>
                    <!-- Camera Library -->
                    <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
                    
                    <link rel="stylesheet" href="/hlv_barcode_shipper/static/src/css/barcode_shipper.css"/>
                </t>

                <div class="hlv-barcode-shipper">
                    <div class="shipper-container">
                        
                        <!-- Header -->
                        <div class="shipper-header">
                            <h2>📦 Giao Hàng (Shipper)</h2>
                            <div class="user-info">
                                👤 <t t-esc="user.name"/>
                            </div>
                        </div>

                        <!-- Step 1: Scan PICK -->
                        <div id="step-scan-pick" class="scan-step active">
                            <div class="card">
                                <div class="step-title">🔍 Bước 1: Quét Phiếu PICK</div>
                                <p class="step-desc">Quét mã vạch trên phiếu PICK để tìm đơn giao hàng tương ứng.</p>
                                
                                <div id="pick-result" class="alert"></div>

                                <div class="camera-section" id="camera-pick">
                                    <div id="reader-pick"></div>
                                    <div class="camera-controls">
                                        <button class="btn btn-secondary btn-sm" onclick="window.barcodeShipper.stopCamera()">❌ Đóng Camera</button>
                                    </div>
                                </div>

                                <div class="input-group">
                                    <input type="text" id="pick-barcode-input" class="form-control" placeholder="Nhập mã PICK..." autocomplete="off"/>
                                </div>
                                
                                <button id="btn-open-camera-pick" class="btn btn-primary btn-block">
                                    📷 Mở Camera
                                </button>
                                <button id="scan-pick-btn" class="btn btn-outline btn-block">
                                    👉 Xác nhận mã
                                </button>
                            </div>
                        </div>

                        <!-- Step 2: Scan Items -->
                        <div id="step-scan-items" class="scan-step">
                            <div class="card">
                                <div class="step-title">📦 Bước 2: Quét Hàng Hóa</div>
                                <div id="order-info"></div>

                                <div id="item-result" class="alert"></div>

                                <div class="camera-section" id="camera-item">
                                    <div id="reader-item"></div>
                                    <div class="camera-controls">
                                        <button class="btn btn-secondary btn-sm" onclick="window.barcodeShipper.stopCamera()">❌ Đóng Camera</button>
                                    </div>
                                </div>

                                <div class="input-group">
                                    <input type="text" id="item-barcode-input" class="form-control" placeholder="Quét kiện hoặc sản phẩm..." autocomplete="off"/>
                                </div>

                                <button id="btn-open-camera-item" class="btn btn-primary btn-block">
                                    📷 Mở Camera
                                </button>
                                <button id="scan-item-btn" class="btn btn-outline btn-block">
                                    👉 Xác nhận mã
                                </button>

                                <!-- Progress -->
                                <div class="progress-wrapper">
                                    <div id="progress-fill" class="progress-fill"></div>
                                </div>
                                <div class="progress-stats">
                                    <span>Tiến độ:</span>
                                    <span id="progress-text">0 / 0</span>
                                </div>

                                <!-- List -->
                                <div id="items-list" class="items-list"></div>

                                <!-- Actions -->
                                <div style="margin-top: 20px; display: flex; gap: 10px;">
                                    <button id="complete-delivery-btn" class="btn btn-success" style="flex: 1; display: none;">
                                        ✅ Hoàn tất
                                    </button>
                                    <button id="reset-scan-btn" class="btn btn-warning" style="flex: 1;">
                                        🔄 Làm lại
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Step 3: Complete -->
                        <div id="step-complete" class="scan-step">
                            <div class="card" style="text-align: center; padding: 40px 20px;">
                                <div style="font-size: 60px; margin-bottom: 20px;">🎉</div>
                                <h3 style="color: var(--success-color); margin-bottom: 10px;">Giao Hàng Thành Công!</h3>
                                <div id="completion-result" class="alert alert-success show" style="display: inline-block; margin-bottom: 30px;">
                                    Đơn hàng đã được xác nhận.
                                </div>
                                <button id="new-delivery-btn" class="btn btn-primary btn-block">
                                    🚚 Giao đơn tiếp theo
                                </button>
                            </div>
                        </div>

                        <!-- Footer -->
                        <div style="text-align: center; margin-top: 20px;">
                            <button id="show-history-btn" class="btn btn-outline btn-sm">📋 Lịch sử quét</button>
                            <button id="help-btn" class="btn btn-outline btn-sm">❓ Hướng dẫn</button>
                        </div>

                    </div>
                </div>

                <!-- Modals -->
                <div id="history-modal" class="modal-overlay">
                    <div class="modal-box">
                        <div class="modal-header">
                            <div class="modal-title">Lịch sử quét</div>
                            <div class="modal-close">×</div>
                        </div>
                        <div id="history-content" class="modal-body">Loading...</div>
                    </div>
                </div>

                <div id="help-modal" class="modal-overlay">
                    <div class="modal-box">
                        <div class="modal-header">
                            <div class="modal-title">Hướng dẫn sử dụng</div>
                            <div class="modal-close">×</div>
                        </div>
                        <div class="modal-body">
                            <ol style="padding-left: 20px; line-height: 1.6;">
                                <li><strong>Bước 1:</strong> Quét mã vạch trên phiếu PICK (ví dụ: PICK001).</li>
                                <li><strong>Bước 2:</strong> Hệ thống hiển thị danh sách kiện và sản phẩm cần giao.</li>
                                <li><strong>Bước 3:</strong> Dùng Camera hoặc máy quét để quét từng mã vạch (Code 128 hoặc QR).</li>
                                <li><strong>Bước 4:</strong> Khi quét đủ 100%, nút "Hoàn tất" sẽ hiện ra. Nhấn để xác nhận.</li>
                            </ol>
                            <div class="alert alert-warning show" style="margin-top: 10px;">
                                ⚠️ <strong>Lưu ý:</strong> Không tải lại trang khi đang quét dở để tránh mất dữ liệu.
                            </div>
                        </div>
                    </div>
                </div>

                <script src="/hlv_barcode_shipper/static/src/js/barcode_scanner.js"></script>
            </t>
        </template>

    </data>
</odoo>
