<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Access Denied Template -->
        <template id="access_denied" name="Access Denied">
            <t t-call="web.layout">
                <t t-set="head">
                    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
                    <style>
                        .access-denied-container {
                            max-width: 600px;
                            margin: 50px auto;
                            padding: 40px 20px;
                            text-align: center;
                            background: #ffffff;
                            border-radius: 8px;
                            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
                        }
                        .access-denied-icon {
                            font-size: 64px;
                            color: #dc3545;
                            margin-bottom: 20px;
                        }
                        .access-denied-title {
                            font-size: 24px;
                            font-weight: 600;
                            color: #2c3e50;
                            margin-bottom: 16px;
                        }
                        .access-denied-message {
                            font-size: 16px;
                            color: #6c757d;
                            margin-bottom: 24px;
                            line-height: 1.5;
                        }
                        .access-denied-btn {
                            display: inline-block;
                            padding: 12px 24px;
                            background-color: #007bff;
                            color: white;
                            text-decoration: none;
                            border-radius: 6px;
                            font-weight: 500;
                        }
                        .access-denied-btn:hover {
                            background-color: #0056b3;
                            color: white;
                        }
                    </style>
                </t>

                <div class="access-denied-container">
                    <div class="access-denied-icon">🚫</div>
                    <h1 class="access-denied-title">Access Denied</h1>
                    <p class="access-denied-message">
                        You don't have permission to access the Shipper Scanner.<br/>
                        Please contact your administrator to get "Shipper" access rights.
                    </p>
                    <a href="/web" class="access-denied-btn">← Back to Odoo</a>
                </div>
            </t>
        </template>

        <!-- Mobile Shipper Interface Template -->
        <template id="shipper_interface" name="Shipper Barcode Interface">
            <t t-call="web.layout">
                <t t-set="head">
                    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"/>
                    <script src="https://fastly.jsdelivr.net/npm/barcode-detector@3/dist/iife/polyfill.min.js"></script>
                    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css"/>
                    <link rel="stylesheet" href="/hlv_barcode_shipper/static/src/css/barcode_shipper.css"/>
                </t>

                <div class="hlv-barcode-shipper">
                    <div class="shipper-container">

                        <!-- Header -->
                        <div class="shipper-header">
                            <div class="header-title">
                                <i class="fa fa-shipping-fast"></i> Shipper
                            </div>
                            <div class="user-info">
                                <i class="fa fa-user-circle"></i> <t t-esc="user.shipper_name or user.name"/>
                            </div>
                        </div>

                        <!-- Tab Navigation -->
                        <div class="tab-nav">
                            <button class="tab-btn active" data-tab="receive">
                                <i class="fa fa-inbox"></i> Nhận hàng
                            </button>
                            <button class="tab-btn" data-tab="deliver">
                                <i class="fa fa-truck"></i> Giao hàng
                            </button>
                            <button class="tab-btn" data-tab="return">
                                <i class="fa fa-undo-alt"></i> Trả hàng
                            </button>
                            <button class="tab-btn" data-tab="delivered">
                                <i class="fa fa-clipboard-check"></i> Đã giao
                            </button>
                        </div>

                        <!-- ==================== TAB: NHẬN HÀNG ==================== -->
                        <div id="tab-receive" class="tab-content active">

                            <!-- Receive Step 1: Danh sách phiếu sẵn sàng nhận -->
                            <div id="receive-step-scan" class="scan-step active">

                                <!-- Camera (hidden by default) -->
                                <div class="camera-section" id="camera-receive">
                                    <div id="reader-receive" class="camera-reader"></div>
                                    <div class="camera-controls">
                                        <button class="btn btn-secondary btn-sm" id="btn-close-camera-receive">
                                            <i class="fa fa-times"></i> Đóng Camera
                                        </button>
                                    </div>
                                </div>

                                <!-- Scan / search bar -->
                                <div class="scan-bar-card">
                                    <div id="receive-scan-result" class="alert"></div>
                                    <div class="input-group-row" style="margin-bottom:0;">
                                        <input type="text" id="receive-barcode-input" class="form-control"
                                            placeholder="Quét mã phiếu / đơn hàng để tìm nhanh..."
                                            autocomplete="off" inputmode="none"/>
                                        <button id="receive-scan-btn" class="btn btn-secondary" title="Tìm kiếm">
                                            <i class="fa fa-search"></i>
                                        </button>
                                        <button id="btn-open-camera-receive" class="btn btn-primary" title="Mở camera">
                                            <i class="fa fa-camera"></i>
                                        </button>
                                    </div>
                                </div>

                                <!-- Available pickings accordion (rendered by JS) -->
                                <div id="receive-available-accordion">
                                    <div class="loading-placeholder">
                                        <i class="fa fa-spinner fa-spin" style="font-size:1.5rem;color:#aaa;"></i>
                                        <div style="color:#888;margin-top:8px;">Đang tải danh sách phiếu...</div>
                                    </div>
                                </div>

                                <!-- Sticky confirm bar (shown when pickings selected) -->
                                <div id="receive-confirm-bar" class="sticky-confirm-bar" style="display:none;">
                                    <span id="receive-selected-info" style="font-weight:600;color:#333;">0 phiếu đã chọn</span>
                                    <button id="confirm-receive-selected-btn" class="btn btn-success">
                                        <i class="fa fa-check-circle"></i> Xác nhận nhận hàng
                                    </button>
                                </div>
                            </div>

                            <!-- Receive Step 2: Detail scan (if config requires) -->
                            <div id="receive-step-detail" class="scan-step">
                                <div class="card-box" style="padding-bottom: 0;">
                                    <div class="step-header">
                                        <div class="step-icon"><i class="fa fa-barcode"></i></div>
                                        <div class="step-info">
                                            <div class="step-title">Quét chi tiết kiện nhận</div>
                                            <div id="receive-customer-info" class="customer-info" style="display:none;">
                                                <i class="fa fa-user"></i> Khách: <span id="receive-customer-name" style="font-weight: bold;"></span>
                                            </div>
                                        </div>
                                    </div>

                                    <div id="receive-detail-result" class="alert"></div>

                                    <div class="camera-section" id="camera-receive-detail">
                                        <div id="reader-receive-detail" class="camera-reader"></div>
                                        <div class="camera-controls">
                                            <button class="btn btn-secondary btn-sm" onclick="window.barcodeShipper.stopCamera()">
                                                <i class="fa fa-times"></i> Đóng Camera
                                            </button>
                                        </div>
                                    </div>

                                    <div class="action-area">
                                        <button id="btn-open-camera-receive-detail" class="btn btn-primary btn-lg btn-block mb-3">
                                            <i class="fa fa-camera"></i> Quét Kiện / Sản Phẩm
                                        </button>
                                        <div class="input-group-row">
                                            <input type="text" id="receive-detail-barcode-input" class="form-control" placeholder="Nhập mã vạch..." autocomplete="off" inputmode="none"/>
                                            <button id="receive-detail-scan-btn" class="btn btn-secondary">
                                                <i class="fa fa-check"></i>
                                            </button>
                                        </div>
                                    </div>

                                    <div id="receive-so-accordion" class="accordion-container"></div>

                                    <div class="global-progress-wrapper">
                                        <div class="progress-stats">
                                            <span>Tiến độ nhận</span>
                                            <span id="receive-progress-text">0 / 0</span>
                                        </div>
                                        <div class="progress mb-3">
                                            <div id="receive-progress-fill" class="progress-bar"></div>
                                        </div>
                                        <button id="confirm-receive-btn" class="btn btn-success btn-lg btn-block" style="display: none;">
                                            <i class="fa fa-check-circle"></i> Xác nhận nhận hàng
                                        </button>
                                        <button id="receive-back-btn" class="btn btn-outline btn-block mt-2">
                                            <i class="fa fa-arrow-left"></i> Quay lại
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ==================== TAB: GIAO HÀNG ==================== -->
                        <div id="tab-deliver" class="tab-content">

                            <!-- Deliver Step 1: Scan PICK -->
                            <div id="step-scan-pick" class="scan-step active">
                                <div class="card-box">
                                    <div class="step-header">
                                        <div class="step-icon"><i class="fa fa-search"></i></div>
                                        <div class="step-info">
                                            <div class="step-title">Quét phiếu giao hàng</div>
                                            <p class="step-desc">Quét mã vạch từng phiếu OUT, chụp ảnh bàn giao ngay, sau đó tiến hành quét kiện.</p>
                                        </div>
                                    </div>

                                    <div id="pick-result" class="alert"></div>

                                    <div class="camera-section" id="camera-pick">
                                        <div id="reader-pick" class="camera-reader"></div>
                                        <div class="camera-controls">
                                            <button class="btn btn-secondary btn-sm" onclick="window.barcodeShipper.stopCamera()">
                                                <i class="fa fa-times"></i> Đóng Camera
                                            </button>
                                        </div>
                                    </div>

                                    <div class="action-area">
                                        <button id="btn-open-camera-pick" class="btn btn-primary btn-lg btn-block mb-3">
                                            <i class="fa fa-camera"></i> Mở Camera Quét Mã
                                        </button>
                                        <div class="separator">hoặc nhập thủ công</div>
                                        <div class="input-group-row">
                                            <input type="text" id="pick-barcode-input" class="form-control" placeholder="Nhập mã PICK..." autocomplete="off" inputmode="none"/>
                                            <button id="scan-pick-btn" class="btn btn-secondary">
                                                <i class="fa fa-arrow-right"></i>
                                            </button>
                                        </div>
                                    </div>

                                    <!-- List of received pickings ready to deliver -->
                                    <div id="deliver-received-list" style="margin-top: 15px;"></div>

                                    <!-- Inline photo capture (hiện sau khi quét được phiếu) -->
                                    <canvas id="pick-inline-canvas" style="display:none;"></canvas>
                                    <div id="pick-inline-photo" style="display:none; margin-top:12px;">
                                        <div style="background:#fffde7;border:1px solid #f9a825;border-radius:10px;padding:12px;">
                                            <!-- Picking info header -->
                                            <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">
                                                <div style="background:var(--primary-color);color:#fff;border-radius:50%;width:32px;height:32px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                                    <i class="fa fa-camera"></i>
                                                </div>
                                                <div style="flex:1;">
                                                    <div style="font-weight:700;font-size:14px;" id="pick-inline-picking-name">---</div>
                                                    <div style="font-size:12px;color:#888;" id="pick-inline-so-name"></div>
                                                </div>
                                            </div>
                                            <!-- Open camera button -->
                                            <div id="pick-inline-open-section">
                                                <button id="pick-inline-open-camera-btn" class="btn btn-primary btn-block mb-2">
                                                    <i class="fa fa-camera"></i> Mở Camera Chụp Ảnh Phiếu
                                                </button>
                                                <button id="pick-inline-skip-btn" class="btn btn-outline btn-block" style="font-size:12px;">
                                                    <i class="fa fa-forward"></i> Bỏ qua ảnh cho phiếu này
                                                </button>
                                            </div>
                                            <!-- Camera live preview -->
                                            <div id="pick-inline-camera-section" style="display:none;">
                                                <div style="position:relative;border-radius:8px;overflow:hidden;background:#000;margin-bottom:8px;">
                                                    <video id="pick-inline-video" autoplay="autoplay" playsinline="playsinline" muted="muted" style="width:100%;display:block;max-height:280px;object-fit:cover;"></video>
                                                </div>
                                                <div style="display:flex;gap:8px;">
                                                    <button id="pick-inline-capture-btn" class="btn btn-success btn-lg" style="flex:1;">
                                                        <i class="fa fa-circle"></i> Chụp ảnh
                                                    </button>
                                                    <button id="pick-inline-close-cam-btn" class="btn btn-outline">
                                                        <i class="fa fa-times"></i>
                                                    </button>
                                                </div>
                                            </div>
                                            <!-- Photo preview + confirm -->
                                            <div id="pick-inline-preview-section" style="display:none;">
                                                <img id="pick-inline-preview-img" style="width:100%;border-radius:8px;margin-bottom:8px;border:2px solid var(--success-color);" src="" alt=""/>
                                                <div id="pick-inline-photo-result" class="alert" style="margin-bottom:8px;"></div>
                                                <div style="display:flex;gap:8px;">
                                                    <button id="pick-inline-confirm-btn" class="btn btn-success" style="flex:1;">
                                                        <i class="fa fa-check"></i> Xác nhận ảnh
                                                    </button>
                                                    <button id="pick-inline-retake-btn" class="btn btn-outline">
                                                        <i class="fa fa-redo"></i> Chụp lại
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Danh sách phiếu đã xác nhận + nút tiến hành giao -->
                                    <div id="pick-confirmed-list" style="display:none; margin-top:12px;"></div>
                                </div>
                            </div>

                            <!-- Deliver Step 2: Scan Items -->
                            <div id="step-scan-items" class="scan-step">
                                <div class="card-box" style="padding-bottom: 0;">
                                    <div class="step-header">
                                        <div class="step-icon"><i class="fa fa-box-open"></i></div>
                                        <div class="step-info">
                                            <div class="step-title">Quét Hàng Hóa</div>
                                            <div id="customer-info" class="customer-info" style="display:none;">
                                                <i class="fa fa-user"></i> Khách: <span id="customer-name" style="font-weight: bold;"></span>
                                            </div>
                                        </div>
                                    </div>

                                    <div id="item-result" class="alert"></div>

                                    <div class="camera-section" id="camera-item">
                                        <div id="reader-item" class="camera-reader"></div>
                                        <div class="camera-controls">
                                            <button class="btn btn-secondary btn-sm" onclick="window.barcodeShipper.stopCamera()">
                                                <i class="fa fa-times"></i> Đóng Camera
                                            </button>
                                        </div>
                                    </div>

                                    <div class="action-area">
                                        <button id="btn-open-camera-item" class="btn btn-primary btn-lg btn-block mb-3">
                                            <i class="fa fa-camera"></i> Quét Kiện / Sản Phẩm
                                        </button>
                                        <div class="input-group-row">
                                            <input type="text" id="item-barcode-input" class="form-control" placeholder="Nhập mã vạch..." autocomplete="off" inputmode="none"/>
                                            <button id="scan-item-btn" class="btn btn-secondary">
                                                <i class="fa fa-check"></i>
                                            </button>
                                        </div>
                                    </div>

                                    <div id="so-accordion" class="accordion-container"></div>

                                    <div class="global-progress-wrapper">
                                        <div class="progress-stats">
                                            <span>Tổng tiến độ</span>
                                            <span id="global-progress-text">0 / 0</span>
                                        </div>
                                        <div class="progress mb-3">
                                            <div id="global-progress-fill" class="progress-bar"></div>
                                        </div>
                                        <button id="complete-all-btn" class="btn btn-success btn-lg btn-block" style="display: none;">
                                            <i class="fa fa-arrow-right"></i> Tiếp theo
                                        </button>
                                        <button id="reset-scan-btn" class="btn btn-outline btn-block mt-2">
                                            <i class="fa fa-redo"></i> Làm lại
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Deliver Step 3: Chụp ảnh phiếu giao hàng -->
                            <div id="step-photo" class="scan-step">
                                <div class="card-box">
                                    <div class="step-header">
                                        <div class="step-icon"><i class="fa fa-camera"></i></div>
                                        <div class="step-info">
                                            <div class="step-title">Chụp phiếu giao hàng</div>
                                            <p class="step-desc">Chụp ảnh từng phiếu bàn giao. Mã QR sẽ tự nhận diện đơn hàng.</p>
                                        </div>
                                    </div>

                                    <!-- Tiến độ (hiện khi nhiều đơn) -->
                                    <div id="photo-progress-wrap" style="margin-bottom:12px;display:none;">
                                        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;">
                                            <span style="font-size:13px;font-weight:600;">Tiến độ chụp ảnh</span>
                                            <span id="photo-progress-text" style="font-size:13px;color:var(--primary-color);font-weight:600;">0/0 phiếu</span>
                                        </div>
                                        <div style="height:6px;background:#e0e0e0;border-radius:3px;overflow:hidden;">
                                            <div id="photo-progress-fill" style="height:100%;background:var(--success-color);border-radius:3px;transition:width 0.3s;width:0%;"></div>
                                        </div>
                                    </div>

                                    <!-- Danh sách phiếu cần chụp -->
                                    <div id="photo-pending-list" style="margin-bottom:10px;"></div>

                                    <div id="photo-result" class="alert"></div>

                                    <!-- Camera live preview với QR overlay -->
                                    <div id="photo-camera-section" class="photo-camera-section" style="display:none;">
                                        <div style="position:relative;border-radius:8px;overflow:hidden;background:#000;">
                                            <video id="photo-video" autoplay="autoplay" playsinline="playsinline" muted="muted" style="width:100%;display:block;"></video>
                                            <!-- QR detection overlay -->
                                            <div id="photo-qr-overlay" style="position:absolute;bottom:10px;left:8px;right:8px;display:none;">
                                                <div id="photo-qr-badge" style="background:rgba(0,0,0,0.75);color:#fff;padding:6px 14px;border-radius:20px;text-align:center;font-size:13px;font-weight:600;">
                                                    <i class="fa fa-qrcode"></i> <span id="photo-qr-text"></span>
                                                </div>
                                            </div>
                                        </div>
                                        <div style="display:flex;gap:8px;margin-top:8px;">
                                            <button id="photo-capture-btn" class="btn btn-success btn-lg" style="flex:1;">
                                                <i class="fa fa-circle"></i> Chụp ảnh
                                            </button>
                                            <button id="photo-close-camera-btn" class="btn btn-secondary">
                                                <i class="fa fa-times"></i>
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Photo preview after capture -->
                                    <div id="photo-preview-section" style="display:none;">
                                        <canvas id="photo-canvas" style="display:none;"></canvas>
                                        <div id="photo-qr-result" style="margin-bottom:8px;border-radius:6px;font-size:13px;"></div>
                                        <img id="photo-preview-img" style="width:100%;border-radius:8px;border:2px solid #ccc;" alt="Ảnh phiếu"/>
                                        <!-- Ảnh đã lưu (nhiều đơn) -->
                                        <div id="photo-captured-list" style="margin-top:10px;"></div>
                                        <div style="display:flex;gap:8px;margin-top:12px;">
                                            <button id="photo-retake-btn" class="btn btn-outline" style="flex:1;">
                                                <i class="fa fa-redo"></i> Chụp lại
                                            </button>
                                            <button id="photo-confirm-btn" class="btn btn-success" style="flex:1;display:none;">
                                                <i class="fa fa-check"></i> Lưu &amp; Tiếp
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Open camera / choose file buttons -->
                                    <div id="photo-open-section">
                                        <button id="photo-open-camera-btn" class="btn btn-primary btn-lg btn-block mb-3">
                                            <i class="fa fa-camera"></i> Mở Camera Chụp Ảnh
                                        </button>
                                        <label class="btn btn-outline btn-block" style="cursor:pointer;">
                                            <i class="fa fa-image"></i> Chọn ảnh từ thư viện
                                            <input type="file" id="photo-file-input" accept="image/*" style="display:none;"/>
                                        </label>
                                    </div>

                                    <div style="margin-top:16px;">
                                        <button id="photo-send-btn" class="btn btn-success btn-lg btn-block" style="display:none;">
                                            <i class="fa fa-paper-plane"></i> Gửi ảnh &amp; Hoàn tất
                                        </button>
                                        <button id="photo-skip-btn" class="btn btn-outline btn-block mt-2">
                                            <i class="fa fa-forward"></i> Bỏ qua, hoàn tất không ảnh
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Deliver Step 4: Complete -->
                            <div id="step-complete" class="scan-step">
                                <div class="card-box text-center success-card">
                                    <div class="success-icon"><i class="fa fa-check-circle"></i></div>
                                    <h3 class="success-title">Giao Hàng Thành Công!</h3>
                                    <div id="completion-result" class="alert alert-success show mb-4">
                                        Đơn hàng đã được xác nhận.
                                    </div>
                                    <button id="new-delivery-btn" class="btn btn-primary btn-lg btn-block">
                                        <i class="fa fa-truck"></i> Giao đơn tiếp theo
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- ==================== TAB: TRẢ HÀNG ==================== -->
                        <div id="tab-return" class="tab-content">

                            <!-- Return Step 1: List received pickings -->
                            <div id="return-step-list" class="scan-step active">
                                <div class="card-box">
                                    <div class="step-header">
                                        <div class="step-icon"><i class="fa fa-undo-alt"></i></div>
                                        <div class="step-info">
                                            <div class="step-title">Trả hàng đã nhận</div>
                                            <p class="step-desc">Chọn phiếu cần trả và nhập lý do.</p>
                                        </div>
                                    </div>

                                    <div id="return-result" class="alert"></div>

                                    <!-- Toolbar: Chọn tất cả + Quét phiếu -->
                                    <div style="margin-bottom:10px;">
                                        <div style="margin-bottom:8px;">
                                            <button id="return-select-all-btn" class="btn btn-outline btn-sm">
                                                <i class="fa fa-check-double"></i> Chọn tất cả
                                            </button>
                                        </div>
                                        <div class="input-group-row" style="margin-bottom:0;">
                                            <input type="text" id="return-scan-input" class="form-control"
                                                placeholder="Quét mã phiếu để chọn..."
                                                autocomplete="off" inputmode="none"/>
                                            <button id="return-scan-btn" class="btn btn-secondary" title="Tìm kiếm">
                                                <i class="fa fa-search"></i>
                                            </button>
                                            <button id="btn-open-camera-return-scan" class="btn btn-primary" title="Mở camera">
                                                <i class="fa fa-camera"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <!-- Embedded camera for return scan -->
                                    <div id="camera-return-scan" class="camera-section" style="margin-bottom:10px;">
                                        <div id="reader-return-scan" style="width:100%;"></div>
                                    </div>

                                    <div id="return-picking-list" style="margin-bottom: 15px;">
                                        <!-- JS renders the list here -->
                                    </div>

                                    <div id="return-actions" style="display: none;">
                                        <div style="margin-bottom: 10px;">
                                            <label style="font-weight: 600; font-size: 0.9rem; display: block; margin-bottom: 5px;">
                                                <i class="fa fa-comment-alt"></i> Lý do trả hàng:
                                            </label>
                                            <input type="text" id="return-reason-input" class="return-reason-input" placeholder="VD: Khách từ chối, hàng lỗi, sai địa chỉ..." autocomplete="off"/>
                                        </div>
                                        <button id="confirm-return-btn" class="btn btn-danger btn-lg btn-block">
                                            <i class="fa fa-undo-alt"></i> Xác nhận trả hàng
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Return Step 2: Detail scan (if config requires) -->
                            <div id="return-step-detail" class="scan-step">
                                <div class="card-box" style="padding-bottom: 0;">
                                    <div class="step-header">
                                        <div class="step-icon"><i class="fa fa-barcode"></i></div>
                                        <div class="step-info">
                                            <div class="step-title">Quét chi tiết kiện trả</div>
                                        </div>
                                    </div>

                                    <div id="return-detail-result" class="alert"></div>

                                    <div class="camera-section" id="camera-return-detail">
                                        <div id="reader-return-detail" class="camera-reader"></div>
                                        <div class="camera-controls">
                                            <button class="btn btn-secondary btn-sm" onclick="window.barcodeShipper.stopCamera()">
                                                <i class="fa fa-times"></i> Đóng Camera
                                            </button>
                                        </div>
                                    </div>

                                    <div class="action-area">
                                        <button id="btn-open-camera-return-detail" class="btn btn-primary btn-lg btn-block mb-3">
                                            <i class="fa fa-camera"></i> Quét Kiện / Sản Phẩm
                                        </button>
                                        <div class="input-group-row">
                                            <input type="text" id="return-detail-barcode-input" class="form-control" placeholder="Nhập mã vạch..." autocomplete="off" inputmode="none"/>
                                            <button id="return-detail-scan-btn" class="btn btn-secondary">
                                                <i class="fa fa-check"></i>
                                            </button>
                                        </div>
                                    </div>

                                    <div id="return-so-accordion" class="accordion-container"></div>

                                    <div class="global-progress-wrapper">
                                        <div class="progress-stats">
                                            <span>Tiến độ quét trả</span>
                                            <span id="return-progress-text">0 / 0</span>
                                        </div>
                                        <div class="progress mb-3">
                                            <div id="return-progress-fill" class="progress-bar"></div>
                                        </div>
                                        <button id="confirm-return-detail-btn" class="btn btn-danger btn-lg btn-block" style="display: none;">
                                            <i class="fa fa-undo-alt"></i> Xác nhận trả hàng
                                        </button>
                                        <button id="return-detail-back-btn" class="btn btn-outline btn-block mt-2">
                                            <i class="fa fa-arrow-left"></i> Quay lại
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ==================== TAB: ĐÃ GIAO ==================== -->
                        <div id="tab-delivered" class="tab-content">
                            <div class="card-box">
                                <div class="step-header">
                                    <div class="step-icon"><i class="fa fa-clipboard-check"></i></div>
                                    <div class="step-info">
                                        <div class="step-title">Đơn hàng đã giao</div>
                                        <div class="step-subtitle">Danh sách phiếu đã giao thành công.</div>
                                    </div>
                                </div>
                                <div class="input-group-row" style="margin-top:10px;margin-bottom:0;">
                                    <input type="date" id="delivered-date-filter" class="form-control" style="flex:unset;width:auto;"/>
                                    <button id="delivered-filter-btn" class="btn btn-secondary" title="Lọc">
                                        <i class="fa fa-filter"></i> Lọc
                                    </button>
                                    <button id="delivered-clear-btn" class="btn btn-outline" title="Xóa lọc">
                                        <i class="fa fa-times"></i>
                                    </button>
                                </div>
                                <div id="delivered-list" style="margin-top:10px;">
                                    <div class="empty-state" style="padding:20px;">
                                        <i class="fa fa-clipboard-check" style="font-size:2rem;color:#ddd;display:block;margin-bottom:8px;"></i>
                                        Chọn tab để xem danh sách.
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Footer -->
                        <div class="shipper-footer">
                            <button id="show-history-btn" class="btn btn-text"><i class="fa fa-history"></i> Lịch sử</button>
                            <button id="help-btn" class="btn btn-text"><i class="fa fa-question-circle"></i> Hướng dẫn</button>
                        </div>

                    </div>
                </div>

                <!-- Modals -->
                <div id="history-modal" class="modal-overlay">
                    <div class="modal-content">
                        <div class="modal-header">
                            <div class="modal-title"><i class="fa fa-history"></i> Lịch sử quét</div>
                            <button class="modal-close"><i class="fa fa-times"></i></button>
                        </div>
                        <div id="history-content" class="modal-body">Loading...</div>
                    </div>
                </div>

                <div id="help-modal" class="modal-overlay">
                    <div class="modal-content">
                        <div class="modal-header">
                            <div class="modal-title"><i class="fa fa-info-circle"></i> Hướng dẫn sử dụng</div>
                            <button class="modal-close"><i class="fa fa-times"></i></button>
                        </div>
                        <div class="modal-body">
                            <div class="help-steps">
                                <div class="help-step">
                                    <span class="step-num">1</span>
                                    <span><b>Nhận hàng:</b> Quét phiếu để xác nhận nhận hàng từ kho trước khi đi giao.</span>
                                </div>
                                <div class="help-step">
                                    <span class="step-num">2</span>
                                    <span><b>Giao hàng:</b> Quét phiếu rồi quét kiện/sản phẩm, cuối cùng hoàn tất.</span>
                                </div>
                                <div class="help-step">
                                    <span class="step-num">3</span>
                                    <span><b>Trả hàng:</b> Chọn phiếu đã nhận, nhập lý do và xác nhận trả.</span>
                                </div>
                            </div>
                            <div class="alert alert-warning show mt-3">
                                <i class="fa fa-exclamation-triangle"></i> <strong>Lưu ý:</strong> Không tải lại trang khi đang quét dở.
                            </div>
                        </div>
                    </div>
                </div>

                <script src="/hlv_barcode_shipper/static/src/js/barcode_scanner.js"></script>
            </t>
        </template>


        <!-- Action to open the Shipper Interface -->
        <record id="action_barcode_shipper_interface" model="ir.actions.act_url">
            <field name="name">Shipper Barcode</field>
            <field name="url">/barcode/shipper</field>
            <field name="target">self</field>
        </record>

        <!-- Top-level Menu Item -->
        <menuitem id="menu_barcode_shipper_root"
            name="Shipper Scan"
            action="action_barcode_shipper_interface"
            web_icon="hlv_barcode_shipper,static/description/icon.png"
            groups="hlv_barcode_shipper.group_shipper"
            sequence="10"/>

    </data>
</odoo>
