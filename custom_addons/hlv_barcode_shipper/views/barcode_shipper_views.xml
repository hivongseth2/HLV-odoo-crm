<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Access Denied Template -->
        <template id="access_denied" name="Access Denied">
            <t t-call="web.layout">
                <t t-set="head_website">
                    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
                    <style>
                        .access-denied-container {
                            max-width: 600px;
                            margin: 50px auto;
                            padding: 40px 20px;
                            text-align: center;
                            background: #ffffff;
                            border-radius: 8px;
                            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
                        }
                        .access-denied-icon {
                            font-size: 64px;
                            color: #dc3545;
                            margin-bottom: 20px;
                        }
                        .access-denied-title {
                            font-size: 24px;
                            font-weight: 600;
                            color: #2c3e50;
                            margin-bottom: 16px;
                        }
                        .access-denied-message {
                            font-size: 16px;
                            color: #6c757d;
                            margin-bottom: 24px;
                            line-height: 1.5;
                        }
                        .access-denied-btn {
                            display: inline-block;
                            padding: 12px 24px;
                            background-color: #007bff;
                            color: white;
                            text-decoration: none;
                            border-radius: 6px;
                            font-weight: 500;
                        }
                        .access-denied-btn:hover {
                            background-color: #0056b3;
                            color: white;
                        }
                    </style>
                </t>
                
                <div class="access-denied-container">
                    <div class="access-denied-icon">🚫</div>
                    <h1 class="access-denied-title">Access Denied</h1>
                    <p class="access-denied-message">
                        You don't have permission to access the Shipper Scanner.<br/>
                        Please contact your administrator to get "Shipper" access rights.
                    </p>
                    <a href="/web" class="access-denied-btn">← Back to Odoo</a>
                </div>
            </t>
        </template>
        
        <!-- Mobile Shipper Interface Template -->
        <template id="shipper_interface" name="Shipper Barcode Interface">
            <t t-call="web.layout">
                <t t-set="head_website">
                    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no"/>
                    <link rel="stylesheet" href="/hlv_barcode_shipper/static/src/css/barcode_shipper.css"/>
                </t>
                
                <div class="hlv-barcode-shipper">
                    <div class="shipper-container">
                    <!-- Header -->
                    <div class="shipper-header">
                        <h2>📦 Shipper Scanner</h2>
                        <div class="user-info">
                            <span>👤 <t t-esc="user.name"/></span>
                        </div>
                    </div>
                    
                    <!-- Main Content -->
                    <div class="shipper-content">
                        
                        <!-- Step 1: Scan PICK Order -->
                        <div id="step-scan-pick" class="scan-step active">
                            <div class="step-header">
                                <h3>🔍 Step 1: Scan PICK Order</h3>
                                <p>Scan the PICK order barcode to find delivery order</p>
                            </div>
                            
                            <div class="barcode-input-group">
                                <input type="text" 
                                       id="pick-barcode-input" 
                                       class="barcode-input" 
                                       placeholder="Scan or enter PICK barcode..."
                                       autocomplete="off"/>
                                <button id="scan-pick-btn" class="btn btn-primary">
                                    📱 Scan PICK
                                </button>
                            </div>
                            
                            <div id="pick-result" class="result-message"></div>
                        </div>
                        
                        <!-- Step 2: Scan Packages/Products -->
                        <div id="step-scan-items" class="scan-step">
                            <div class="step-header">
                                <h3>📦 Step 2: Scan Items</h3>
                                <div id="order-info" class="order-info"></div>
                            </div>
                            
                            <div class="barcode-input-group">
                                <input type="text" 
                                       id="item-barcode-input" 
                                       class="barcode-input" 
                                       placeholder="Scan package or product..."
                                       autocomplete="off"/>
                                <button id="scan-item-btn" class="btn btn-secondary">
                                    📦 Scan Item
                                </button>
                            </div>
                            
                            <div id="item-result" class="result-message"></div>
                            
                            <!-- Items List -->
                            <div id="items-list" class="items-list"></div>
                            
                            <!-- Progress -->
                            <div id="scan-progress" class="progress-container">
                                <div class="progress-bar">
                                    <div id="progress-fill" class="progress-fill"></div>
                                </div>
                                <div id="progress-text" class="progress-text">0 / 0 items scanned</div>
                            </div>
                            
                            <!-- Complete Button -->
                            <button id="complete-delivery-btn" class="btn btn-success btn-large" style="display: none;">
                                ✅ Complete Delivery
                            </button>
                            
                            <!-- Reset Button -->
                            <button id="reset-scan-btn" class="btn btn-warning">
                                🔄 Start Over
                            </button>
                        </div>
                        
                        <!-- Step 3: Completion -->
                        <div id="step-complete" class="scan-step">
                            <div class="step-header">
                                <h3>✅ Delivery Completed</h3>
                            </div>
                            
                            <div id="completion-result" class="result-message"></div>
                            
                            <button id="new-delivery-btn" class="btn btn-primary btn-large">
                                🚚 New Delivery
                            </button>
                        </div>
                        
                    </div>
                    
                    <!-- Footer -->
                    <div class="shipper-footer">
                        <button id="show-history-btn" class="btn btn-link">📋 View History</button>
                        <button id="help-btn" class="btn btn-link">❓ Help</button>
                    </div>
                    
                    <!-- History Modal -->
                    <div id="history-modal" class="modal">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h3>📋 Scan History</h3>
                                <span class="close">×</span>
                            </div>
                            <div id="history-content" class="modal-body">
                                Loading...
                            </div>
                        </div>
                    </div>
                    
                    <!-- Help Modal -->
                    <div id="help-modal" class="modal">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h3>❓ How to Use</h3>
                                <span class="close">×</span>
                            </div>
                            <div class="modal-body">
                                <ol>
                                    <li><strong>Scan PICK Order:</strong> Use your device camera or type the PICK barcode (e.g., PICK00001)</li>
                                    <li><strong>Scan Items:</strong> Scan each package (PACK) or product barcode in the delivery order</li>
                                    <li><strong>Complete:</strong> When all items are scanned, tap "Complete Delivery"</li>
                                    <li><strong>Alternative:</strong> You can re-scan the PICK barcode to complete directly</li>
                                </ol>
                                <p><strong>Tips:</strong></p>
                                <ul>
                                    <li>Make sure your camera has good lighting</li>
                                    <li>Hold the barcode steady in the camera view</li>
                                    <li>You can also type barcodes manually if needed</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    
                    </div>
                </div>
                
                <!-- JavaScript -->
                <script src="/hlv_barcode_shipper/static/src/js/barcode_scanner.js"></script>
                <script>
                    // Initialize the barcode scanner when page loads
                    document.addEventListener('DOMContentLoaded', function() {
                        if (typeof BarcodeShipper !== 'undefined') {
                            window.barcodeShipper = new BarcodeShipper();
                        }
                    });
                </script>
            </t>
        </template>
        
