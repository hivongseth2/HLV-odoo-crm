<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="barcode_scan_log_list" model="ir.ui.view">
            <field name="name">barcode.scan.log.list</field>
            <field name="model">barcode.scan.log</field>
            <field name="arch" type="xml">
                <list string="Barcode Scan Logs" default_order="scan_time desc">
                    <field name="scan_time"/>
                    <field name="user_id"/>
                    <field name="barcode"/>
                    <field name="scan_type"/>
                    <field name="status"
                           decoration-success="status == 'success'"
                           decoration-danger="status == 'error'"
                           decoration-warning="status == 'warning'"/>
                    <field name="picking_id" optional="show"/>
                    <field name="package_id" optional="hide"/>
                    <field name="product_id" optional="hide"/>
                    <field name="message" optional="hide"/>
                    <field name="session_id" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="barcode_scan_log_form" model="ir.ui.view">
            <field name="name">barcode.scan.log.form</field>
            <field name="model">barcode.scan.log</field>
            <field name="arch" type="xml">
                <form string="Barcode Scan Log" create="false" edit="false">
                    <sheet>
                        <group>
                            <group string="Scan Information">
                                <field name="barcode"/>
                                <field name="scan_type"/>
                                <field name="scan_time"/>
                                <field name="user_id"/>
                                <field name="status"/>
                                <field name="session_id"/>
                            </group>
                            <group string="Related Records">
                                <field name="picking_id"/>
                                <field name="package_id"/>
                                <field name="product_id"/>
                            </group>
                        </group>
                        <group string="Message">
                            <field name="message" nolabel="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_barcode_scan_log" model="ir.actions.act_window">
            <field name="name">Barcode Scan Logs</field>
            <field name="res_model">barcode.scan.log</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_barcode_scan_log_root"
                  name="Barcode Shipper"
                  parent="stock.menu_stock_root"
                  sequence="90"/>

        <menuitem id="menu_barcode_scan_log"
                  name="Scan Logs"
                  parent="menu_barcode_scan_log_root"
                  action="action_barcode_scan_log"
                  groups="hlv_barcode_shipper.group_shipper_manager"/>
    </data>
</odoo>
