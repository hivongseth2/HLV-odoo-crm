<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hlv.barcode.shipper</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='barcode_setting_container']" position="after">
                <h2 class="mt32">HLV Barcode Shipper</h2>
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <!-- <field name="hlv_barcode_shipper_allow_package"/> -->
                        </div>
                        <div class="o_setting_right_pane">
                            <!-- <label for="hlv_barcode_shipper_allow_package"/> -->
                            <div class="text-muted">
                                Nếu được bật, Shipper có thể quét mã kiện (Package) để xác nhận tất cả sản phẩm bên trong.
                                Nếu tắt, bắt buộc quét từng sản phẩm.
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
