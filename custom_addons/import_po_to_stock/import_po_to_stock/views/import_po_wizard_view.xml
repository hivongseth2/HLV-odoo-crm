<odoo>
    <record id="view_import_po_wizard" model="ir.ui.view">
        <field name="name">import.po.wizard</field>
        <field name="model">import.po.wizard</field>
        <field name="arch" type="xml">
            <form string="Import PO to Stock">
                <group>
                    <field name="file"/>
                    <field name="filename"/>
                </group>
                <footer>
                    <button string="Import" type="object" name="action_import" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <act_window id="action_import_po_wizard"
                name="Import PO"
                res_model="import.po.wizard"
                view_mode="form"
                target="new"/>
</odoo>
