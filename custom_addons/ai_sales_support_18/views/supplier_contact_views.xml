<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Supplier Contact Tree View -->
        <record id="supplier_contact_view_tree" model="ir.ui.view">
            <field name="name">ai.sales.supplier.contact.tree</field>
            <field name="model">ai.sales.supplier.contact</field>
            <field name="arch" type="xml">
                <tree string="Supplier Contacts" decoration-muted="not is_active">
                    <field name="supplier_name"/>
                    <field name="contact_person"/>
                    <field name="zalo_user_id"/>
                    <field name="zalo_phone"/>
                    <field name="priority" widget="priority"/>
                    <field name="success_rate"/>
                    <field name="response_time_avg"/>
                    <field name="last_contact_date"/>
                    <field name="is_active" widget="boolean_toggle"/>
                </tree>
            </field>
        </record>

        <!-- Supplier Contact Form View -->
        <record id="supplier_contact_view_form" model="ir.ui.view">
            <field name="name">ai.sales.supplier.contact.form</field>
            <field name="model">ai.sales.supplier.contact</field>
            <field name="arch" type="xml">
                <form string="Supplier Contact">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_communications" type="object" class="oe_stat_button" icon="fa-comments">
                                <field name="communication_log_ids" widget="statinfo" string="Communications"/>
                            </button>
                        </div>
                        
                        <widget name="web_ribbon" title="Inactive" bg_color="text-bg-danger" invisible="is_active"/>
                        
                        <group>
                            <group>
                                <field name="supplier_id" required="1"/>
                                <field name="supplier_name" readonly="1"/>
                                <field name="contact_person"/>
                                <field name="contact_position"/>
                                <field name="is_active"/>
                            </group>
                            <group>
                                <field name="zalo_user_id" required="1"/>
                                <field name="zalo_phone"/>
                                <field name="priority" widget="priority"/>
                            </group>
                        </group>
                        
                        <group string="Statistics">
                            <group>
                                <field name="success_rate" widget="percentage"/>
                                <field name="response_time_avg" widget="float_time"/>
                            </group>
                            <group>
                                <field name="last_contact_date" readonly="1"/>
                            </group>
                        </group>
                        
                        <group string="Product Categories">
                            <field name="product_category_ids" widget="many2many_tags" nolabel="1"/>
                        </group>
                        
                        <group string="Notes">
                            <field name="notes" nolabel="1" widget="text"/>
                        </group>
                        
                        <notebook>
                            <page string="Communication Log">
                                <field name="communication_log_ids" readonly="1">
                                    <tree>
                                        <field name="create_date"/>
                                        <field name="inquiry_id"/>
                                        <field name="message_type" widget="badge" decoration-info="message_type=='outgoing'" decoration-success="message_type=='incoming'"/>
                                        <field name="status" widget="badge"/>
                                        <field name="response_time" widget="float_time"/>
                                        <field name="is_successful" widget="boolean_toggle"/>
                                    </tree>
                                    <form>
                                        <group>
                                            <field name="inquiry_id"/>
                                            <field name="message_type"/>
                                            <field name="status"/>
                                            <field name="zalo_message_id"/>
                                            <field name="response_time" widget="float_time"/>
                                            <field name="is_successful"/>
                                        </group>
                                        <group string="Message Content">
                                            <field name="message_content" nolabel="1" widget="text"/>
                                        </group>
                                    </form>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Supplier Contact Search View -->
        <record id="supplier_contact_view_search" model="ir.ui.view">
            <field name="name">ai.sales.supplier.contact.search</field>
            <field name="model">ai.sales.supplier.contact</field>
            <field name="arch" type="xml">
                <search string="Supplier Contacts">
                    <field name="supplier_name"/>
                    <field name="contact_person"/>
                    <field name="zalo_user_id"/>
                    <field name="zalo_phone"/>
                    <field name="product_category_ids"/>
                    
                    <filter string="Active" name="active" domain="[('is_active', '=', True)]"/>
                    <filter string="Inactive" name="inactive" domain="[('is_active', '=', False)]"/>
                    
                    <separator/>
                    <filter string="High Priority" name="high_priority" domain="[('priority', 'in', ['3', '4'])]"/>
                    <filter string="Good Success Rate" name="good_success" domain="[('success_rate', '>=', 80)]"/>
                    <filter string="Fast Response" name="fast_response" domain="[('response_time_avg', '<=', 2)]"/>
                    
                    <group expand="0" string="Group By">
                        <filter string="Supplier" name="group_supplier" context="{'group_by': 'supplier_id'}"/>
                        <filter string="Priority" name="group_priority" context="{'group_by': 'priority'}"/>
                        <filter string="Active Status" name="group_active" context="{'group_by': 'is_active'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Supplier Contact Action -->
        <record id="supplier_contact_action" model="ir.actions.act_window">
            <field name="name">Supplier Contacts</field>
            <field name="res_model">ai.sales.supplier.contact</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Add your first supplier contact!
                </p>
                <p>
                    Configure supplier contacts with their Zalo user IDs to enable
                    automatic communication when stock is insufficient.
                </p>
            </field>
        </record>

        <!-- Communication Log Tree View -->
        <record id="communication_log_view_tree" model="ir.ui.view">
            <field name="name">ai.sales.communication.log.tree</field>
            <field name="model">ai.sales.communication.log</field>
            <field name="arch" type="xml">
                <tree string="Communication Log">
                    <field name="create_date"/>
                    <field name="supplier_contact_id"/>
                    <field name="inquiry_id"/>
                    <field name="message_type" widget="badge" decoration-info="message_type=='outgoing'" decoration-success="message_type=='incoming'"/>
                    <field name="status" widget="badge"/>
                    <field name="response_time" widget="float_time"/>
                    <field name="is_successful" widget="boolean_toggle"/>
                </tree>
            </field>
        </record>

        <!-- Communication Log Action -->
        <record id="communication_log_action" model="ir.actions.act_window">
            <field name="name">Communication Log</field>
            <field name="res_model">ai.sales.communication.log</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_recent': 1}</field>
        </record>
    </data>
</odoo>