<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view cho Zalo Stock Notification Config -->
    <record id="view_zalo_stock_notification_form" model="ir.ui.view">
        <field name="name">hlv.zalo.stock.notification.form</field>
        <field name="model">hlv.zalo.stock.notification</field>
        <field name="arch" type="xml">
            <form string="Zalo Stock Notification Config">
                <header>
                    <button name="action_open_oauth"
                        string="Authorize with Zalo"
                        type="object"
                        class="oe_highlight"
                        invisible="use_shared_token or refresh_token != False" />
                    <button name="action_test_send_message" 
                        string="Test Gửi Tin Nhắn" 
                        type="object" 
                        class="btn-primary"
                        invisible="not active"/>
                    <button name="action_preview_send_message"
                        string="Preview Tin Nhắn" 
                        type="object"
                        class="btn-secondary"
                        invisible="not active"/>
                    <button name="action_refresh_token"
                        string="Refresh Token"
                        type="object"
                        class="btn-secondary"
                        invisible="use_shared_token or not active or not (refresh_token != False)" />
                    <button name="action_send_reminder_now"
                        string="Gửi Nhắc Nhở Ngay"
                        type="object"
                        class="btn-warning"
                        invisible="not enable_interaction_reminder" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <widget name="web_ribbon" title="Inactive"
                            bg_color="bg-danger"
                            invisible="active" />
                    </div>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="active" />
                            <field name="use_shared_token" 
                                   help="Khuyến nghị BẬT để sử dụng Shared Token Manager (dễ quản lý hơn)"/>
                            <field name="send_on_po_create" />
                            <field name="send_on_incoming" />
                            <field name="send_on_outgoing" />
                        </group>
                        <group invisible="not use_shared_token">
                            <div style="padding: 10px; background-color: #d4edda; border: 1px solid #c3e6cb; border-radius: 5px;">
                              <p style="margin: 5px 0; color: #155724;">
                                <b>✅ Đang sử dụng Shared Token Manager</b>
                              </p>
                              <p style="margin: 5px 0; color: #155724;">
                                Token được quản lý tập trung tại <b>Zalo > 🔑 Shared Token</b>
                              </p>
                            </div>
                        </group>
                    </group>
                    
                    <group string="⚠️ Own Token (Deprecated)" invisible="use_shared_token">
                        <div style="padding: 10px; background-color: #fff3cd; border: 1px solid #ffeaa7; border-radius: 5px; margin: 10px 0;">
                          <p style="margin: 5px 0; color: #856404;">
                            <b>⚠️ Chế độ này đã deprecated</b>
                          </p>
                          <p style="margin: 5px 0; color: #856404;">
                            Khuyến nghị BẬT "Use Shared Token" để dễ quản lý hơn
                          </p>
                        </div>
                        <group>
                            <field name="app_id" />
                            <field name="secret_key" password="True" />
                            <field name="callback_url" widget="url" />
                        </group>
                        <group>
                            <field name="access_token" password="True" />
                            <field name="token_expires_at" />
                        </group>
                    </group>

                    <group string="OAuth Authorization" invisible="refresh_token != False">
                        <div class="alert alert-warning" role="alert">
                            <p>
                                <strong>Bước 1: Nhập App ID, Secret Key và Callback URL</strong>
                            </p>
                            <p><strong>Bước 2: Click nút "🔐 Authorize with Zalo"</strong> để lấy
                                token tự động</p>
                            <p>Bạn sẽ được redirect tới Zalo để authorize, sau đó token sẽ được lưu
                                tự động.</p>
                        </div>
                        <field name="authorize_url" widget="url" readonly="1"
                            invisible="not authorize_url" />
                    </group>

                    <group string="Refresh Token">
                        <field name="refresh_token" widget="text" password="True" />
                    </group>

                    <group string="Danh Sách Người Nhận Thông Báo">
                        <field name="recipient_ids" widget="text"
                            placeholder="Nhập mỗi Zalo User ID trên một dòng&#10;Ví dụ:&#10;1228622149344688972&#10;6358388935615848913&#10;7233270943621398925" />
                    </group>

                    <!-- NEW: Cơ chế saler online/offline cho XUẤT KHO -->
                    <group string="📤 Cấu Hình Phiếu XUẤT KHO (Theo Nhân Viên Sale Online/Offline)">
                        <group>
                            <field name="online_saler_codes" widget="text"
                                placeholder="Nhập mỗi mã nhân viên sale online trên một dòng&#10;Ví dụ:&#10;SALER_ONLINE_1&#10;SALER_ONLINE_2&#10;SALER_ONLINE_3" />
                        </group>
                        <group>
                            <field name="online_recipient_user_id"
                                placeholder="Zalo User ID kế toán xử lý đơn hàng ONLINE" />
                            <field name="offline_recipient_user_id"
                                placeholder="Zalo User ID kế toán xử lý đơn hàng OFFLINE" />
                        </group>
                    </group>

                    <!-- NEW: Cấu hình cho NHẬP KHO -->
                    <group string="📥 Cấu Hình Phiếu NHẬP KHO">
                        <field name="incoming_recipient_user_id"
                            placeholder="Zalo User ID kế toán xử lý TẤT CẢ phiếu nhập kho" />

                        <field name="incoming_warehouse_mapping_text" widget="text"
                               placeholder="Ví dụ:&#10;TSN:1111111111111111111&#10;KBC:2222222222222222222,3333333333333333333" />
                        <div class="alert alert-info" role="alert" style="margin-top: 8px;">
                            <p style="margin: 0;">
                                Mỗi dòng 1 cấu hình: <code>WAREHOUSE_CODE:ID1,ID2,...</code><br/>
                                Nếu kho có trong danh sách này, sẽ gửi cho các ID tương ứng thay vì ID chung ở trên.<br/>
                                Nếu kho KHÔNG có trong danh sách này, sẽ fallback về ID chung.
                            </p>
                        </div>

                    </group>

                    <!-- NEW: Cấu hình cho PO Create -->
                    <group string="📝 Cấu Hình TẠO ĐƠN MUA HÀNG (PO)">
                        <field name="po_create_recipient_user_id" placeholder="User ID mặc định cho PO mới" />
                        <field name="po_create_warehouse_mapping_text" widget="text"
                               placeholder="Ví dụ:&#10;TSN:1111111111111111111&#10;KBC:2222222222222222222" />
                        <div class="alert alert-info" role="alert" style="margin-top: 8px;">
                            <p style="margin: 0;">
                                Mỗi dòng 1 cấu hình: <code>WAREHOUSE_CODE:ID1,ID2,...</code><br/>
                                Gửi thông báo ngay khi PO được tạo (hoặc khi MISA sync xong).
                            </p>
                        </div>
                    </group>

                    <!-- NEW: Cấu hình nhắc nhở tương tác định kỳ -->
                    <group string="🔔 Cấu Hình Nhắc Nhở Tương Tác (Tránh bị ngừng nhận tin)">
                        <group>
                            <field name="enable_interaction_reminder" />
                            <field name="reminder_interval_days"
                                invisible="not enable_interaction_reminder" />
                            <field name="last_reminder_sent"
                                invisible="not enable_interaction_reminder" />
                        </group>
                        <group invisible="not enable_interaction_reminder">
                            <div class="alert alert-warning" role="alert">
                                <p style="margin: 5px 0;">
                                    <b>⚠️ Lưu ý về chính sách Zalo:</b>
                                </p>
                                <p style="margin: 5px 0;">
                                    Zalo yêu cầu người dùng phải tương tác với OA trong vòng 7 ngày.
                                    Nếu không tương tác, hệ thống sẽ tạm ngừng gửi tin nhắn.
                                </p>
                                <p style="margin: 5px 0;">
                                    Tính năng này sẽ tự động gửi tin nhắn nhắc nhở để kế toán phản hồi,
                                    đảm bảo luôn nhận được thông báo đơn hàng.
                                </p>
                            </div>
                        </group>
                        <field name="reminder_message_template"
                            widget="text"
                            invisible="not enable_interaction_reminder"
                            placeholder="Nội dung tin nhắn nhắc nhở..." />
                    </group>

                                        <!-- NEW: Mapping MISA saler_code -> Zalo OA User ID -->
                    <group string="📤 Thông báo trực tiếp cho Nhân Viên Sale (phiếu XUẤT)">
                        <field name="saler_mapping_text" widget="text"
                               placeholder="Ví dụ:&#10;DUONGTHIHA:4954993286556475779&#10;NGUYENVANA:1111111111111111111,2222222222222222222" />
                        <div class="alert alert-info" role="alert" style="margin-top: 8px;">
                            <p style="margin: 0;">
                                Mỗi dòng 1 cấu hình: <code>MISA_SALER_CODE:ID1,ID2,...</code><br/>
                                Ví dụ: <code>DUONGTHIHA:4954993286556475779,</code><br/>
                                Khi phiếu XUẤT kho thuộc nhân viên đó (theo
                                <code>Sale Order.x_studio_misa_saler_code</code>) hệ thống sẽ
                                gửi thêm thông báo tới các Zalo User ID ở đây.
                            </p>
                        </div>
                    </group>


                    <group string="❌ Cấu Hình HỦY ĐƠN BÁN (SO)">
                        <field name="cancel_so_warehouse_mapping_text" widget="text"
                               placeholder="Ví dụ:&#10;TSN:1111111111111111111&#10;KBC:2222222222222222222" />
                        <div class="alert alert-danger" role="alert" style="margin-top: 8px;">
                            <p style="margin: 0;">
                                Mỗi dòng 1 cấu hình: <code>WAREHOUSE_CODE:ID1,ID2,...</code><br/>
                                Khi đơn bán bị HỦY, hệ thống sẽ quét các phiếu kho của đơn đó thuộc kho nào
                                và gửi tin nhắn cảnh báo cho các ID tương ứng.
                            </p>
                        </div>
                    </group>

                    <group string="🔒 Thông báo Hủy Dự Trữ / Giữ Hàng (cho Sale)">
                        <field name="hold_unreserve_saler_mapping_text" widget="text"
                               placeholder="Ví dụ:&#10;DUONGTHIHA:4954993286556475779&#10;NGUYENVANA:1111111111111111111,2222222222222222222" />
                        <div class="alert alert-warning" role="alert" style="margin-top: 8px;">
                            <p style="margin: 0;">
                                Mỗi dòng 1 cấu hình: <code>MISA_SALER_CODE:ID1,ID2,...</code><br/>
                                Mapping RIÊNG — <b>không dùng chung</b> với mục "📤 Thông báo trực tiếp
                                cho Nhân Viên Sale (phiếu XUẤT)" ở trên (vì mục đó hiện đã tạm ngừng).<br/>
                                Áp dụng cho: yêu cầu Giữ hàng theo Sale (trang /search_stock) bị hết
                                hạn / bị từ chối / bị kho "Hủy dự trữ"; và phiếu Lấy hàng (PICK) của
                                đơn bán bị "Hủy dự trữ" hoặc bị xóa dòng dự trữ thủ công.
                            </p>
                        </div>
                    </group>


                    <!-- COMMENT: Warehouse mapping - tạm thời không sử dụng -->
                    <!-- <group string="Cấu Hình Người Nhận Thông Báo Theo Kho">
                        <field name="warehouse_recipient_ids" nolabel="1" />
                    </group> -->

                    <!-- COMMENT: Saler mapping cũ - tạm thời không sử dụng -->
                    <!-- <group string="Cấu Hình Người Nhận Thông Báo Theo Mã Nhân Viên Sale">
                        <field name="saler_recipient_ids" nolabel="1" />
                    </group> -->

                    <group string="Hướng Dẫn">
                        <div class="alert alert-info" role="alert">
                            <h4>📋 Cấu hình Zalo Stock Notification:</h4>
                            <ol>
                                <li>Nhập <b>App ID</b> và <b>Secret Key</b> từ Zalo Developer Portal</li>
                                <li>Nhập <b>Callback URL</b>: <code>
                                    https://your-odoo-domain.com/hlv_zalo/stock_notification/oauth/callback</code></li>
                                <li>Click nút <b>"🔐 Authorize with Zalo"</b> → Token sẽ tự động lưu</li>
                                <li><b>📤 Cấu hình Phiếu XUẤT KHO:</b>
                                    <ul>
                                        <li><b>Mã Nhân Viên Sale Online:</b> Nhập danh sách mã nhân viên phụ trách bán online (mỗi mã một dòng)</li>
                                        <li><b>User ID Kế Toán Online:</b> Nhập Zalo User ID của kế toán xử lý đơn hàng online</li>
                                        <li><b>User ID Kế Toán Offline:</b> Nhập Zalo User ID của kế toán xử lý đơn hàng offline</li>
                                    </ul>
                                </li>
                                <li><b>📥 Cấu hình Phiếu NHẬP KHO:</b>
                                    <ul>
                                        <li><b>User ID Kế Toán Nhập Kho:</b> Nhập Zalo User ID của kế toán xử lý TẤT CẢ phiếu nhập kho</li>
                                    </ul>
                                </li>
                                <li>Chọn loại đơn hàng cần gửi thông báo (Nhập/Xuất)</li>
                                <li>Click <b>"Preview Tin Nhắn"</b> để kiểm tra cấu hình</li>
                                <li>Click <b>"Test Gửi Tin Nhắn"</b> để test gửi</li>
                            </ol>
                            <p>
                                <b>⚠️ Điều kiện gửi thông báo:</b>
                            </p>
                            <ul>
                                <li>Đơn hàng đã validate (Done)</li>
                                <li>Loại đơn: Nhập kho (Incoming) hoặc Xuất kho (Outgoing)</li>
                                <li><b>Với đơn xuất:</b> Chỉ gửi thông báo cho bước <b>xuất cuối cùng tới khách hàng</b> (location_dest_id là customer)</li>
                                <li>Chưa gửi thông báo trước đó</li>
                            </ul>
                            <p>
                                <b>💡 Cơ chế hoạt động:</b>
                            </p>
                            <ul>
                                <li><b>📤 Phiếu XUẤT KHO (Outgoing):</b>
                                    <ol>
                                        <li>Lấy mã nhân viên sale từ sale.order (x_studio_misa_saler_code)</li>
                                        <li>Kiểm tra mã nhân viên có nằm trong danh sách "Mã Nhân Viên Sale Online" không</li>
                                        <li>Nếu <b>CÓ</b> → Gửi tin nhắn tới <b>User ID Kế Toán Online</b></li>
                                        <li>Nếu <b>KHÔNG</b> → Gửi tin nhắn tới <b>User ID Kế Toán Offline</b></li>
                                        <li>Nếu <b>không có mã nhân viên sale</b> → Không gửi (log warning)</li>
                                    </ol>
                                </li>
                                <li><b>📥 Phiếu NHẬP KHO (Incoming):</b>
                                    <ol>
                                        <li>Kiểm tra nguồn gốc phiếu nhập (location_id.usage)</li>
                                        <li><b>Phiếu nhập từ NHÀ CUNG CẤP</b> (đơn mua hàng) → Gửi tin nhắn tới <b>User ID Kế Toán Nhập Kho</b></li>
                                        <li><b>Chuyển kho nội bộ</b> (internal transfer) → <b>BỎ QUA</b>, không gửi</li>
                                        <li><b>Nhập từ trả hàng</b> (customer return) → Có thể mở comment trong code để bật (mặc định tắt)</li>
                                    </ol>
                                </li>
                            </ul>
                            <p>
                                <b>🔍 Lưu ý:</b>
                            </p>
                            <ul>
                                <li>Chỉ nên có 1 config active tại một thời điểm</li>
                                <li>Hệ thống tự động refresh access token mỗi giờ</li>
                                <li>Để lấy Callback URL chính xác, sử dụng domain của Odoo của bạn</li>
                                <li><b>Mã nhân viên sale:</b> Lấy từ field "Mã nhân viên sale MISA" (x_studio_misa_saler_code) trong Sale Order</li>
                                <li>Thêm mã nhân viên vào danh sách online dễ dàng, chỉ cần cập nhật trực tiếp mà không cần tạo bản ghi mới</li>
                            </ul>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List view cho Zalo Stock Notification Config (renamed from tree in Odoo 18) -->
    <record id="view_zalo_stock_notification_list" model="ir.ui.view">
        <field name="name">hlv.zalo.stock.notification.list</field>
        <field name="model">hlv.zalo.stock.notification</field>
        <field name="arch" type="xml">
            <list string="Zalo Stock Notification Configs">
                <field name="name" />
                <field name="app_id" />
                <field name="token_expires_at" />
                <field name="send_on_incoming" />
                <field name="send_on_outgoing" />
                <field name="active" />
            </list>
        </field>
    </record>

    <!-- Action cho Zalo Stock Notification Config -->
    <record id="action_zalo_stock_notification" model="ir.actions.act_window">
        <field name="name">Zalo Stock Notification</field>
        <field name="res_model">hlv.zalo.stock.notification</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo cấu hình Zalo Stock Notification
            </p>
            <p>
                Cấu hình để gửi thông báo tự động qua Zalo tới nhân viên nội bộ khi có đơn hàng
                nhập/xuất kho.
            </p>
        </field>
    </record>

    <!-- Menu item -->
    <menuitem id="menu_zalo_stock_notification"
        name="Zalo Stock Notification"
        parent="menu_hlv_zalo"
        action="action_zalo_stock_notification"
        sequence="100" />

