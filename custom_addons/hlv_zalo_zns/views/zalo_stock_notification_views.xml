<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view cho Zalo Stock Notification Config -->
    <record id="view_zalo_stock_notification_form" model="ir.ui.view">
        <field name="name">hlv.zalo.stock.notification.form</field>
        <field name="model">hlv.zalo.stock.notification</field>
        <field name="arch" type="xml">
            <form string="Zalo Stock Notification Config">
                <header>
                    <button name="action_open_oauth"
                        string="Authorize with Zalo"
                        type="object"
                        class="oe_highlight"
                        invisible="refresh_token != False" />
                    <button name="action_test_send_message" 
                        string="Test Gửi Tin Nhắn" 
                        type="object" 
                        class="btn-primary"
                        invisible="not active or not refresh_token"/>
                    <button name="action_preview_send_message"
                        string="Preview Tin Nhắn" 
                        type="object"
                        class="btn-secondary"
                        invisible="not active or not refresh_token"/>
                    <button name="action_refresh_token"
                        string="Refresh Token"
                        type="object"
                        class="btn-secondary"
                        invisible="not active or not (refresh_token != False)" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <widget name="web_ribbon" title="Inactive"
                            bg_color="bg-danger"
                            invisible="active" />
                    </div>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="active" />
                            <field name="app_id" />
                            <field name="secret_key" password="True" />
                            <field name="callback_url" widget="url" />
                        </group>
                        <group>
                            <field name="access_token" password="True" />
                            <field name="token_expires_at" />
                            <field name="send_on_incoming" />
                            <field name="send_on_outgoing" />
                        </group>
                    </group>

                    <group string="OAuth Authorization" invisible="refresh_token != False">
                        <div class="alert alert-warning" role="alert">
                            <p>
                                <strong>Bước 1: Nhập App ID, Secret Key và Callback URL</strong>
                            </p>
                            <p><strong>Bước 2: Click nút "🔐 Authorize with Zalo"</strong> để lấy
                                token tự động</p>
                            <p>Bạn sẽ được redirect tới Zalo để authorize, sau đó token sẽ được lưu
                                tự động.</p>
                        </div>
                        <field name="authorize_url" widget="url" readonly="1"
                            invisible="not authorize_url" />
                    </group>

                    <group string="Refresh Token">
                        <field name="refresh_token" widget="text" password="True" />
                    </group>

                    <group string="Danh Sách Người Nhận Thông Báo">
                        <field name="recipient_ids" widget="text"
                            placeholder="Nhập mỗi Zalo User ID trên một dòng&#10;Ví dụ:&#10;1228622149344688972&#10;6358388935615848913&#10;7233270943621398925" />
                    </group>

                    <group string="Cấu Hình Người Nhận Thông Báo Theo Kho">
                        <field name="warehouse_recipient_ids" nolabel="1" />
                    </group>

                    <group string="Cấu Hình Người Nhận Thông Báo Theo Mã Nhân Viên Sale">
                        <field name="saler_recipient_ids" nolabel="1" />
                    </group>

                    <group string="Hướng Dẫn">
                        <div class="alert alert-info" role="alert">
                            <h4>📋 Cấu hình Zalo Stock Notification:</h4>
                            <ol>
                                <li>Nhập <b>App ID</b> và <b>Secret Key</b> từ Zalo Developer Portal</li>
                                <li>Nhập <b>Callback URL</b>: <code>
                                    https://your-odoo-domain.com/hlv_zalo/stock_notification/oauth/callback</code></li>
                                <li>Click nút <b>"🔐 Authorize with Zalo"</b> → Token sẽ tự động lưu</li>
                                <li><b>Tùy chọn A (Danh sách mặc định):</b> Nhập các <b>Zalo User ID</b> của người cần nhận thông báo trong phần "Danh Sách Người Nhận Thông Báo" (mỗi ID một dòng)</li>
                                <li><b>Tùy chọn B (Mapping theo kho):</b> Thêm các dòng trong bảng "Cấu Hình Người Nhận Thông Báo Theo Kho" để gán danh sách người nhận khác nhau cho mỗi kho (TSN → User A,B; TSNSR → User C,D; KBC → User E,F)</li>
                                <li><b>Tùy chọn C (Mapping theo mã nhân viên sale):</b> Thêm các dòng trong bảng "Cấu Hình Người Nhận Thông Báo Theo Mã Nhân Viên Sale" để gán danh sách người nhận cho từng nhân viên sale (BACHTHIKIMTHUY → User X; NGUYENVANA → User Y)</li>
                                <li>Chọn loại đơn hàng cần gửi thông báo (Nhập/Xuất)</li>
                                <li>Click <b>"Test Gửi Tin Nhắn"</b> để kiểm tra</li>
                            </ol>
                            <p>
                                <b>⚠️ Điều kiện gửi thông báo:</b>
                            </p>
                            <ul>
                                <li>Đơn hàng đã validate (Done)</li>
                                <li>Loại đơn: Nhập kho (Incoming) hoặc Xuất kho (Outgoing)</li>
                                <li><b>Kho phải có cấu hình trong bảng hoặc sử dụng danh sách mặc định</b></li>
                                <li><b>Với đơn xuất:</b> Chỉ gửi thông báo cho bước <b>xuất cuối cùng tới khách hàng</b> (location_dest_id là customer)</li>
                                <li>Chưa gửi thông báo trước đó</li>
                            </ul>
                            <p>
                                <b>💡 Lưu ý:</b>
                            </p>
                            <ul>
                                <li>Chỉ nên có 1 config active tại một thời điểm</li>
                                <li>Hệ thống tự động refresh access token mỗi giờ</li>
                                <li><b>Logic gửi thông báo:</b></li>
                                <ul>
                                    <li>Nếu có cấu hình warehouse mapping → Gửi tới danh sách người nhận của kho đó</li>
                                    <li>Nếu có cấu hình saler mapping (chỉ áp dụng cho đơn xuất) → Gửi tới danh sách người nhận của nhân viên sale đó</li>
                                    <li>Nếu không có cấu hình warehouse và saler mapping → Sử dụng danh sách mặc định</li>
                                    <li><b>Các cấu hình hoạt động độc lập:</b> Có thể chỉ setup theo kho, chỉ setup theo nhân viên sale, hoặc setup cả hai (sẽ gửi cho cả hai nhóm)</li>
                                </ul>
                                <li><b>Quy trình 3 bước tại TSN:</b> Kho → Đóng gói → Xuất → Khách hàng. Thông báo CHỈ gửi ở bước cuối cùng (Xuất → Khách hàng)</li>
                                <li>Để lấy Callback URL chính xác, sử dụng domain của Odoo của bạn</li>
                                <li><b>Mã nhân viên sale:</b> Lấy từ field "Mã nhân viên sale MISA" (x_studio_misa_saler_code) trong Sale Order</li>
                            </ul>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List view cho Zalo Stock Notification Config (renamed from tree in Odoo 18) -->
    <record id="view_zalo_stock_notification_list" model="ir.ui.view">
        <field name="name">hlv.zalo.stock.notification.list</field>
        <field name="model">hlv.zalo.stock.notification</field>
        <field name="arch" type="xml">
            <list string="Zalo Stock Notification Configs">
                <field name="name" />
                <field name="app_id" />
                <field name="token_expires_at" />
                <field name="send_on_incoming" />
                <field name="send_on_outgoing" />
                <field name="active" />
            </list>
        </field>
    </record>

    <!-- Action cho Zalo Stock Notification Config -->
    <record id="action_zalo_stock_notification" model="ir.actions.act_window">
        <field name="name">Zalo Stock Notification</field>
        <field name="res_model">hlv.zalo.stock.notification</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo cấu hình Zalo Stock Notification
            </p>
            <p>
                Cấu hình để gửi thông báo tự động qua Zalo tới nhân viên nội bộ khi có đơn hàng
                nhập/xuất kho.
            </p>
        </field>
    </record>

    <!-- Menu item -->
    <menuitem id="menu_zalo_stock_notification"
        name="Zalo Stock Notification"
        parent="stock.menu_stock_config_settings"
        action="action_zalo_stock_notification"
        sequence="100" />

    <!-- List view cho Zalo Warehouse Recipient -->
    <record id="view_zalo_warehouse_recipient_list" model="ir.ui.view">
        <field name="name">hlv.zalo.warehouse.recipient.list</field>
        <field name="model">hlv.zalo.warehouse.recipient</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="warehouse_id" required="1" />
                <field name="recipient_ids" widget="text" />
                <field name="active" />
            </list>
        </field>
    </record>

    <!-- List view cho Zalo Saler Recipient -->
    <record id="view_zalo_saler_recipient_list" model="ir.ui.view">
        <field name="name">hlv.zalo.saler.recipient.list</field>
        <field name="model">hlv.zalo.saler.recipient</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="saler_code" required="1" placeholder="Ví dụ: BACHTHIKIMTHUY" />
                <field name="recipient_ids" widget="text" />
                <field name="active" />
            </list>
        </field>
    </record>

    <!-- Inherit Stock Picking form để thêm button gửi Zalo Notification -->
    <record id="view_picking_form_inherit_zalo_notification" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.zalo.notification</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_zalo_notification_now"
                    string="Gửi Zalo Thông Báo"
                    type="object"
                    class="btn-secondary"
                    invisible="state != 'done' or picking_type_code not in ['incoming', 'outgoing']" />
            </xpath>

            <xpath expr="//sheet//group[@name='other_infos']" position="after">
                <group string="Zalo Notification">
                    <field name="zalo_stock_notification_sent" readonly="1" />
                </group>
            </xpath>
        </field>
    </record>

</odoo>