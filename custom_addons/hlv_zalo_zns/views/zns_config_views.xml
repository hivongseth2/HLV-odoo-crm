<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_hlv_zalo_zns_form" model="ir.ui.view">
    <field name="name">hlv.zalo.zns.form</field>
    <field name="model">hlv.zalo.zns</field>
    <field name="arch" type="xml">
      <form string="Zalo ZNS Configuration">
        <header>
          <button name="action_open_oauth" string="Authorize OA" type="object" class="oe_highlight"
                  invisible="use_shared_token"/>
        </header>
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="use_shared_token" 
                     help="Khuyến nghị BẬT để sử dụng Shared Token Manager (dễ quản lý hơn)"/>
              <field name="template_id"/>
              <field name="oa_id"/>
            </group>
          </group>
          
          <notebook>
            <page string="✅ Shared Token (Recommended)" invisible="not use_shared_token">
              <group>
                <div style="padding: 10px; background-color: #d4edda; border: 1px solid #c3e6cb; border-radius: 5px; margin: 10px 0;">
                  <p style="margin: 5px 0; color: #155724;">
                    <b>✅ Đang sử dụng Shared Token Manager</b>
                  </p>
                  <p style="margin: 5px 0; color: #155724;">
                    Token được quản lý tập trung tại <b>Zalo > 🔑 Shared Token</b>
                  </p>
                  <p style="margin: 5px 0; color: #155724;">
                    Không cần cấu hình token ở đây nữa!
                  </p>
                </div>
              </group>
            </page>
            
            <page string="⚠️ Own Token (Deprecated)" invisible="use_shared_token">
              <group>
                <div style="padding: 10px; background-color: #fff3cd; border: 1px solid #ffeaa7; border-radius: 5px; margin: 10px 0;">
                  <p style="margin: 5px 0; color: #856404;">
                    <b>⚠️ Chế độ này đã deprecated</b>
                  </p>
                  <p style="margin: 5px 0; color: #856404;">
                    Khuyến nghị BẬT "Use Shared Token" để dễ quản lý hơn
                  </p>
                </div>
              </group>
              <group>
                <group>
                  <field name="app_id"/>
                  <field name="app_secret" password="True"/>
                  <field name="callback_url"/>
                </group>
                <group string="Token">
                  <field name="access_token" readonly="1" password="True"/>
                  <field name="refresh_token" readonly="1" password="True"/>
                  <field name="token_expires_at" readonly="1"/>
                </group>
              </group>
              <group string="Helpers">
                <field name="authorize_url" readonly="1" widget="url"/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_hlv_zalo_zns_list" model="ir.ui.view">
    <field name="name">hlv.zalo.zns.list</field>
    <field name="model">hlv.zalo.zns</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="app_id"/>
        <field name="oa_id"/>
        <field name="template_id"/>
        <field name="token_expires_at"/>
      </list>
    </field>
  </record>


<record id="action_hlv_zalo_zns" model="ir.actions.act_window">
  <field name="name">Zalo ZNS</field>
  <field name="res_model">hlv.zalo.zns</field>
  <field name="view_mode">list,form</field>
  <field name="domain">[]</field>
</record>


  <menuitem id="menu_hlv_root" name="HLV Tools" sequence="50"/>
  <menuitem id="menu_hlv_zalo" name="Zalo" parent="menu_hlv_root" sequence="10"/>
  <menuitem id="menu_hlv_zalo_zns" name="ZNS Config" parent="menu_hlv_zalo" action="action_hlv_zalo_zns" sequence="10"/>
</odoo>
