<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="menu_zalo_shared_token"
        name="🔑 Shared Token"
        parent="menu_hlv_zalo"
        action="action_zalo_shared_token"
        sequence="1" />
    <!-- Form view cho Zalo Shared Token -->
    <record id="view_zalo_shared_token_form" model="ir.ui.view">
        <field name="name">hlv.zalo.shared.token.form</field>
        <field name="model">hlv.zalo.shared.token</field>
        <field name="arch" type="xml">
            <form string="Zalo Shared Token Manager">
                <header>
                    <button name="action_open_oauth"
                        string="Authorize with Zalo"
                        type="object"
                        class="oe_highlight"
                        invisible="refresh_token != False" />
                    <button name="action_test_token" 
                        string="Test Token" 
                        type="object" 
                        class="btn-primary"
                        invisible="not access_token"/>
                    <button name="action_refresh_token"
                        string="Refresh Token"
                        type="object"
                        class="btn-secondary"
                        invisible="not refresh_token" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <widget name="web_ribbon" title="Inactive"
                            bg_color="bg-danger"
                            invisible="active" />
                    </div>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. HLV Zalo OA Token"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Basic Information">
                            <field name="active" />
                            <field name="app_id" />
                            <field name="secret_key" password="True" />
                            <field name="callback_url" widget="url" />
                        </group>
                        <group string="Token Status">
                            <field name="token_status" readonly="1" 
                                   decoration-success="token_status and '✅' in token_status"
                                   decoration-danger="token_status and '❌' in token_status"
                                   decoration-warning="token_status and ('⚠️' in token_status or '⏰' in token_status)"/>
                            <field name="token_expires_at" readonly="1"/>
                            <field name="last_refresh_date" readonly="1"/>
                            <field name="refresh_count" readonly="1"/>
                        </group>
                    </group>
                    
                    <group string="Tokens (Editable)">
                        <field name="access_token" password="False"/>
                        <field name="refresh_token" password="False"/>
                    </group>
                    
                    <group string="OAuth Authorization">
                        <field name="authorize_url" widget="url" readonly="1"/>
                    </group>
                    
                    <notebook>
                        <page string="📖 Hướng Dẫn">
                            <group>
                                <div style="padding: 10px;">
                                    <h3>🎯 Mục đích của Shared Token Manager</h3>
                                    <p>
                                        Shared Token Manager quản lý tập trung access token và refresh token cho 
                                        <b>TẤT CẢ</b> các chức năng Zalo trong hệ thống:
                                    </p>
                                    <ul>
                                        <li><b>ZNS Config</b> - Gửi tin nhắn ZNS cho khách hàng</li>
                                        <li><b>Stock Notification</b> - Gửi thông báo nội bộ khi xuất/nhập kho</li>
                                        <li>Các chức năng Zalo khác trong tương lai</li>
                                    </ul>
                                    
                                    <h3>✅ Lợi ích</h3>
                                    <ul>
                                        <li>✨ <b>Tập trung quản lý:</b> Chỉ cần authorize 1 lần, tất cả chức năng đều dùng được</li>
                                        <li>🔄 <b>Đồng bộ tự động:</b> Token được refresh tự động, không lo hết hạn</li>
                                        <li>🛡️ <b>An toàn:</b> Token được lưu ở 1 nơi duy nhất, dễ bảo mật</li>
                                        <li>🚀 <b>Dễ bảo trì:</b> Không cần cập nhật token ở nhiều nơi</li>
                                    </ul>
                                    
                                    <h3>📋 Hướng dẫn cấu hình</h3>
                                    <ol>
                                        <li>Vào <b>Zalo Developer Portal</b> để lấy App ID và Secret Key</li>
                                        <li>Nhập <b>App ID</b> và <b>Secret Key</b> vào form này</li>
                                        <li>Cập nhật <b>Callback URL</b> thành domain Odoo của bạn:<br/>
                                            <code>https://your-odoo-domain.com/hlv_zalo/shared/oauth/callback</code>
                                        </li>
                                        <li>Nhập Callback URL này vào <b>Zalo Developer Portal</b> trong phần OAuth Settings</li>
                                        <li>Click <b>"Authorize with Zalo"</b> để lấy token lần đầu</li>
                                        <li>Sau khi authorize thành công, click <b>"Test Token"</b> để kiểm tra</li>
                                    </ol>
                                    
                                    <h3>🔧 Cách sử dụng trong code</h3>
                                    <p>Các module khác sẽ gọi:</p>
                                    <pre style="background: #f5f5f5; padding: 10px; border-radius: 5px;">
# Lấy access token từ Shared Token Manager
access_token = self.env['hlv.zalo.shared.token']._get_shared_token()

if access_token:
    # Sử dụng access_token để gọi Zalo API
    headers = {'access_token': access_token}
    # ... gọi API
                                    </pre>
                                    
                                    <h3>⚙️ Token tự động refresh</h3>
                                    <ul>
                                        <li>Cron job chạy mỗi giờ để refresh token tự động</li>
                                        <li>On-demand refresh khi phát hiện token hết hạn</li>
                                        <li>Advisory lock để tránh conflict khi refresh</li>
                                    </ul>
                                    
                                    <h3>🔍 Lưu ý quan trọng</h3>
                                    <ul>
                                        <li>⚠️ <b>Chỉ nên có 1 bản ghi active</b> tại một thời điểm</li>
                                        <li>⚠️ Sau khi cấu hình xong, <b>cập nhật ZNS Config và Stock Notification Config</b> 
                                            để sử dụng Shared Token</li>
                                        <li>⚠️ Không cần nhập token thủ công vào các config khác nữa</li>
                                    </ul>
                                </div>
                            </group>
                        </page>
                        
                        <page string="📊 Statistics">
                            <group>
                                <group string="Usage Statistics">
                                    <field name="refresh_count" readonly="1"/>
                                    <field name="last_refresh_date" readonly="1"/>
                                    <field name="token_expires_at" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List view cho Zalo Shared Token -->
    <record id="view_zalo_shared_token_list" model="ir.ui.view">
        <field name="name">hlv.zalo.shared.token.list</field>
        <field name="model">hlv.zalo.shared.token</field>
        <field name="arch" type="xml">
            <list string="Zalo Shared Tokens">
                <field name="name" />
                <field name="app_id" />
                <field name="token_status" 
                       decoration-success="token_status and '✅' in token_status"
                       decoration-danger="token_status and '❌' in token_status"
                       decoration-warning="token_status and ('⚠️' in token_status or '⏰' in token_status)"/>
                <field name="token_expires_at" />
                <field name="last_refresh_date" />
                <field name="refresh_count" />
                <field name="active" />
            </list>
        </field>
    </record>

    <!-- Action cho Zalo Shared Token -->
    <record id="action_zalo_shared_token" model="ir.actions.act_window">
        <field name="name">Zalo Shared Token</field>
        <field name="res_model">hlv.zalo.shared.token</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo Zalo Shared Token Manager
            </p>
            <p>
                Quản lý tập trung token cho tất cả các chức năng Zalo trong hệ thống.
                Chỉ cần authorize 1 lần, tất cả module đều sử dụng chung token.
            </p>
        </field>
    </record>

    <!-- Menu item - Đặt ở đầu menu Zalo -->


</odoo>
