<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron job để tự động refresh Zalo Stock Notification access token -->
        <!-- 
            === HOẠT ĐỘNG ===
            - Chạy mỗi 1 giờ làm fallback
            - Kiểm tra token hết hạn và gọi refresh_access_token()
            - Có logging chi tiết để debug
            
            === KẾT HỢP VỚI ON-DEMAND REFRESH ===
            - Nếu token hết hạn trong lúc gửi thông báo → on-demand refresh sẽ gọi ngay (không chờ cron)
            - Cron job này chỉ là fallback nếu on-demand fail hoặc để làm "housekeeping" định kỳ
        -->
        <record id="ir_cron_refresh_zalo_stock_notification_token" model="ir.cron">
            <field name="name">Refresh Zalo Stock Notification Access Token</field>
            <field name="model_id" ref="model_hlv_zalo_stock_notification"/>
            <field name="state">code</field>
            <field name="code"><![CDATA[
configs = model.search([('active', '=', True)])
for config in configs:
    try:
        if config._is_token_expired():
            config.refresh_access_token()
    except Exception:
        pass
            ]]></field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>