<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron job gửi tin nhắn nhắc nhở tương tác định kỳ -->
        <record id="ir_cron_zalo_interaction_reminder" model="ir.cron">
            <field name="name">Zalo - Gửi tin nhắn nhắc nhở tương tác</field>
            <field name="model_id" ref="model_hlv_zalo_stock_notification"/>
            <field name="state">code</field>
            <field name="code">model.cron_send_interaction_reminder()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
