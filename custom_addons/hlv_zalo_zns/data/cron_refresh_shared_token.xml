<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron job để tự động refresh Zalo Shared Token -->
        <!-- 
            === HOẠT ĐỘNG ===
            - Chạy mỗi 1 giờ
            - Kiểm tra token hết hạn và gọi refresh_access_token()
            - Có logging chi tiết để debug
            - Chỉ xử lý các token manager đang active
        -->
        <record id="ir_cron_refresh_zalo_shared_token" model="ir.cron">
            <field name="name">Refresh Zalo Shared Access Token</field>
            <field name="model_id" ref="model_hlv_zalo_shared_token"/>
            <field name="state">code</field>
            <field name="code"><![CDATA[
token_managers = model.search([('active', '=', True)])
for token_manager in token_managers:
    try:
        if token_manager._is_token_expired():
            token_manager.refresh_access_token()
    except Exception:
        pass
            ]]></field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
