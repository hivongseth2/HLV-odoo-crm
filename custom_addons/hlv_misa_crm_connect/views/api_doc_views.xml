<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="api_doc_view_list" model="ir.ui.view">
        <field name="name">hlv.misa.crm.api.doc.list</field>
        <field name="model">hlv.misa.crm.api.doc</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="section"/>
                <field name="name"/>
                <field name="route"/>
                <field name="is_write" widget="boolean_toggle" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="api_doc_view_form" model="ir.ui.view">
        <field name="name">hlv.misa.crm.api.doc.form</field>
        <field name="model">hlv.misa.crm.api.doc</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <field name="section"/>
                    </div>
                    <field name="guide_html" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="api_doc_view_search" model="ir.ui.view">
        <field name="name">hlv.misa.crm.api.doc.search</field>
        <field name="model">hlv.misa.crm.api.doc</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="route"/>
                <filter name="write" string="Ghi dữ liệu MISA" domain="[('is_write', '=', True)]"/>
                <group>
                    <filter name="group_section" string="Nhóm" context="{'group_by': 'section'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_api_doc" model="ir.actions.act_window">
        <field name="name">Hướng dẫn API</field>
        <field name="res_model">hlv.misa.crm.api.doc</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_section': 1}</field>
    </record>
</odoo>
