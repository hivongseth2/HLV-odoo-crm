<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="api_config_view_form" model="ir.ui.view">
        <field name="name">hlv.misa.crm.api.config.form</field>
        <field name="model">hlv.misa.crm.api.config</field>
        <field name="arch" type="xml">
            <form string="Cấu hình API MISA CRM">
                <header>
                    <button name="action_save" type="object" string="Lưu" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Hệ thống bên ngoài gọi <field name="base_url" class="d-inline fw-bold" nolabel="1"/>…
                        bằng header <code>X-API-Key</code>. Odoo đăng nhập MISA thay họ (tài khoản MISA của Odoo).
                        Hướng dẫn từng endpoint: menu <b>Hướng dẫn API</b>.
                    </div>
                    <group>
                        <group string="Bật / tắt">
                            <field name="enabled"/>
                            <div class="text-muted" colspan="2">
                                Tắt: mọi route trả 503, kể cả key đúng.
                            </div>
                            <field name="allow_write" invisible="not enabled"/>
                            <div class="text-muted" colspan="2" invisible="not enabled">
                                Bật: được tạo cơ hội trên MISA qua API. Tắt: chỉ tra cứu.
                            </div>
                        </group>
                        <group string="API key">
                            <field name="api_key" placeholder="Chưa có key — mọi request bị từ chối"/>
                            <div colspan="2">
                                <button name="action_new_key" type="object" string="Tạo key mới" icon="fa-refresh"
                                        class="btn-secondary"
                                        confirm="Key cũ sẽ hết hiệu lực ngay — bên gọi phải đổi sang key mới. Tiếp tục?"/>
                            </div>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_api_config" model="ir.actions.act_window">
        <field name="name">Cấu hình API MISA CRM</field>
        <field name="res_model">hlv.misa.crm.api.config</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
