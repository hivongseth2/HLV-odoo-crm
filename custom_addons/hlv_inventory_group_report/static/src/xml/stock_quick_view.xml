<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hlv_inventory_group_report.StockQuickView">
        <div class="o_action o_view_controller" style="background:#f4f6f8; height:100%; display:flex; flex-direction:column; overflow:hidden;">

            <!-- ── Thanh toolbar ── -->
            <div style="background:#fff; border-bottom:1px solid #dee2e6; padding:10px 20px; display:flex; align-items:center; gap:14px; flex-wrap:wrap; box-shadow:0 1px 4px rgba(0,0,0,0.06); flex-shrink:0;">

                <div style="font-size:15px; font-weight:700; color:#1a2639; display:flex; align-items:center; gap:8px; white-space:nowrap;">
                    <i class="fa fa-cubes" style="color:#6c757d;"/>
                    T&#x1ed3;n kho theo nh&#xf3;m
                </div>

                <!-- Chon kho -->
                <div style="display:flex; align-items:center; gap:6px; position:relative;">
                    <label style="font-size:11px; font-weight:700; color:#8492a6; letter-spacing:.5px; white-space:nowrap;">KHO</label>
                    <div style="position:relative;">
                        <button t-on-click="toggleWhDropdown"
                                style="border:1px solid #ced4da; border-radius:6px; padding:5px 10px; font-size:13px; min-width:170px; background:#fff; cursor:pointer; display:flex; align-items:center; justify-content:space-between; gap:8px;">
                            <span t-esc="warehouseSummary" style="color:#495057;"/>
                            <i class="fa fa-chevron-down" style="font-size:10px; color:#8492a6;"/>
                        </button>
                        <t t-if="state.whOpen">
                            <div style="position:absolute; top:calc(100% + 4px); left:0; background:#fff; border:1px solid #dee2e6; border-radius:8px; box-shadow:0 4px 16px rgba(0,0,0,0.14); z-index:9999; min-width:210px; padding:4px 0;">
                                <div t-on-click="toggleAllWarehouses"
                                     style="padding:8px 14px; font-size:12px; font-weight:700; color:#1a2639; cursor:pointer; border-bottom:1px solid #f0f0f0; display:flex; align-items:center; gap:8px;">
                                    <input type="checkbox" t-att-checked="state.warehouseIds.length === state.warehouses.length" style="cursor:pointer;"/>
                                    T&#x1ea5;t c&#x1ea3; kho
                                </div>
                                <t t-foreach="state.warehouses" t-as="wh" t-key="wh.id">
                                    <div t-on-click="() => toggleWarehouse(wh.id)"
                                         style="padding:7px 14px; font-size:13px; cursor:pointer; display:flex; align-items:center; gap:8px; color:#212121;">
                                        <input type="checkbox" t-att-checked="isWhSelected(wh.id)" style="cursor:pointer;"/>
                                        <span t-esc="wh.name"/>
                                    </div>
                                </t>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- Hien SP het hang -->
                <label style="display:flex; align-items:center; gap:7px; font-size:13px; cursor:pointer; color:#495057; white-space:nowrap;">
                    <input type="checkbox" style="width:14px; height:14px; cursor:pointer;"
                           t-att-checked="state.showZero" t-on-change="onShowZeroChange"/>
                    Hi&#x1ec7;n SP h&#x1ebf;t h&#xe0;ng
                </label>

                <!-- Xuat Excel + Tong ton -->
                <div style="margin-left:auto; display:flex; align-items:center; gap:10px;">
                    <t t-if="state.groupId and state.lines.length > 0">
                        <button t-on-click="exportExcel"
                                style="background:#217346; color:#fff; border:none; border-radius:7px; padding:7px 16px; font-size:13px; font-weight:600; cursor:pointer; display:flex; align-items:center; gap:7px;">
                            <i class="fa fa-file-excel-o"/> Xu&#x1ea5;t Excel
                        </button>
                    </t>
                    <t t-if="state.groupId and !state.loading">
                        <div style="background:#1a2639; color:#fff; border-radius:8px; padding:7px 16px; font-size:14px; font-weight:700; white-space:nowrap;">
                            T&#x1ed5;ng t&#x1ed3;n: <t t-esc="formatQty(state.total)"/>
                        </div>
                    </t>
                </div>
            </div>

            <!-- ── Body: sidebar + content ── -->
            <div style="display:flex; flex:1; overflow:hidden;" t-on-click="closeDropdown">

                <!-- Sidebar nhom -->
                <div style="width:200px; background:#1a2639; overflow-y:auto; flex-shrink:0; padding:8px 0;">
                    <div style="padding:10px 14px 6px; font-size:10px; font-weight:700; color:#8492a6; letter-spacing:.8px; text-transform:uppercase;">
                        Nh&#xf3;m s&#x1ea3;n ph&#x1ea9;m
                    </div>
                    <t t-foreach="state.groups" t-as="g" t-key="g.id">
                        <div t-on-click="() => selectGroup(g.id)"
                             t-att-style="'padding:9px 14px; cursor:pointer; font-size:13px; font-weight:500; border-left:3px solid transparent; transition:all .15s; ' + (state.groupId === g.id ? 'background:rgba(255,255,255,0.12); border-left-color:#4fc3f7; color:#fff;' : 'color:#b0bec5;')">
                            <t t-esc="g.name"/>
                        </div>
                    </t>
                    <t t-if="state.groups.length === 0">
                        <div style="padding:20px 14px; color:#546e7a; font-size:12px;">
                            Ch&#x1b0;a c&#xf3; nh&#xf3;m n&#xe0;o
                        </div>
                    </t>
                </div>

                <!-- Main content -->
                <div style="flex:1; overflow:auto; padding:20px;">

                    <t t-if="!state.groupId">
                        <div style="text-align:center; padding:80px 20px; color:#adb5bd;">
                            <i class="fa fa-hand-o-left" style="font-size:48px; display:block; margin-bottom:14px;"/>
                            <div style="font-size:15px;">Ch&#x1ecdn nh&#xf3;m s&#x1ea3;n ph&#x1ea9;m &#x1edf; b&#xean;n tr&#xe1;i</div>
                        </div>
                    </t>

                    <t t-elif="state.loading">
                        <div style="text-align:center; padding:80px;">
                            <i class="fa fa-spinner fa-spin" style="font-size:32px; color:#6c757d;"/>
                            <div style="margin-top:10px; color:#6c757d; font-size:13px;">&#x110;ang t&#x1ea3;i...</div>
                        </div>
                    </t>

                    <t t-elif="state.lines.length === 0">
                        <div style="text-align:center; padding:80px; color:#adb5bd;">
                            <i class="fa fa-inbox" style="font-size:48px; display:block; margin-bottom:14px;"/>
                            <div style="font-size:15px;">Kh&#xf4;ng c&#xf3; s&#x1ea3;n ph&#x1ea9;m n&#xe0;o c&#xf3; t&#x1ed3;n kho</div>
                        </div>
                    </t>

                    <t t-else="">
                        <div style="background:#fff; border-radius:10px; box-shadow:0 1px 6px rgba(0,0,0,0.07); overflow:hidden;">
                            <table style="width:100%; border-collapse:collapse; font-size:13px;">
                                <thead>
                                    <tr style="background:#1a2639; color:#fff;">
                                        <th style="padding:10px 14px; width:40px; text-align:center;">#</th>
                                        <th style="padding:10px 14px; width:130px;">M&#xe3; SP</th>
                                        <th style="padding:10px 14px;">T&#xean;n s&#x1ea3;n ph&#x1ea9;m</th>
                                        <t t-if="state.columns.length > 0">
                                            <t t-foreach="state.columns" t-as="col" t-key="col.id">
                                                <th style="padding:10px 14px; width:110px; text-align:right;">
                                                    <t t-esc="col.name"/>
                                                </th>
                                            </t>
                                            <th style="padding:10px 16px; width:110px; text-align:right; background:#16213a;">T&#x1ed4;NG</th>
                                        </t>
                                        <t t-else="">
                                            <th style="padding:10px 16px; width:120px; text-align:right;">T&#x1ed3;n kho</th>
                                        </t>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.lines" t-as="line" t-key="line_index">
                                        <tr t-att-style="'border-bottom:1px solid #f0f0f0; ' + (line_index % 2 === 1 ? 'background:#fafbfc;' : '')">
                                            <td style="padding:8px 14px; text-align:center; color:#adb5bd; font-size:11px;">
                                                <t t-esc="line_index + 1"/>
                                            </td>
                                            <td style="padding:8px 14px; font-family:monospace; font-size:11px; color:#546e7a;">
                                                <t t-esc="line.code"/>
                                            </td>
                                            <td style="padding:8px 14px; color:#212121;">
                                                <t t-esc="line.name"/>
                                            </td>
                                            <t t-if="state.columns.length > 0">
                                                <t t-foreach="line.col_qtys" t-as="qty" t-key="qty_index">
                                                    <td t-att-style="'padding:8px 14px; text-align:right; font-weight:600; ' + (qty > 0 ? 'color:#198754;' : 'color:#ced4da;')">
                                                        <t t-esc="formatQty(qty)"/>
                                                    </td>
                                                </t>
                                                <td t-att-style="'padding:8px 16px; text-align:right; font-weight:700; font-size:14px; background:#f8fff9; ' + (line.total > 0 ? 'color:#198754;' : 'color:#adb5bd;')">
                                                    <t t-esc="formatQty(line.total)"/>
                                                </td>
                                            </t>
                                            <t t-else="">
                                                <td t-att-style="'padding:8px 16px; text-align:right; font-weight:700; font-size:14px; ' + (line.total > 0 ? 'color:#198754;' : 'color:#adb5bd;')">
                                                    <t t-esc="formatQty(line.total)"/>
                                                </td>
                                            </t>
                                        </tr>
                                    </t>
                                </tbody>
                                <tfoot>
                                    <tr style="background:#e8f5e9; border-top:2px solid #198754;">
                                        <td colspan="3" style="padding:10px 14px; font-weight:700; text-align:right; color:#155724; font-size:12px; letter-spacing:.3px;">
                                            T&#x1ed4;NG T&#x1ed2;N KHO
                                        </td>
                                        <t t-if="state.columns.length > 0">
                                            <td t-foreach="state.columns" t-as="col" t-key="col.id"
                                                style="padding:10px 14px; text-align:right; font-weight:700; color:#198754; font-size:13px;">
                                                <t t-esc="formatQty(getColTotal(col_index))"/>
                                            </td>
                                            <td style="padding:10px 16px; font-weight:700; text-align:right; font-size:16px; color:#198754;">
                                                <t t-esc="formatQty(state.total)"/>
                                            </td>
                                        </t>
                                        <t t-else="">
                                            <td style="padding:10px 16px; font-weight:700; text-align:right; font-size:16px; color:#198754;">
                                                <t t-esc="formatQty(state.total)"/>
                                            </td>
                                        </t>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </t>

                </div>
            </div>

        </div>
    </t>
</templates>