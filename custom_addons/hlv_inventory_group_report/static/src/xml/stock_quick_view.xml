<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hlv_inventory_group_report.StockQuickView">
        <div class="o_action o_view_controller" style="background:#f4f6f8; height:100%; display:flex; flex-direction:column; overflow:hidden;">

            <!-- Thanh toolbar -->
            <div style="background:#fff; border-bottom:1px solid #dee2e6; padding:10px 20px; display:flex; align-items:center; gap:14px; flex-wrap:wrap; box-shadow:0 1px 4px rgba(0,0,0,0.06); flex-shrink:0;">
                <div style="font-size:15px; font-weight:700; color:#1a2639; display:flex; align-items:center; gap:8px; white-space:nowrap;">
                    <i class="fa fa-cubes" style="color:#6c757d;"/>
                    Tồn kho theo nhóm
                </div>
                <div style="display:flex; align-items:center; gap:6px; position:relative;">
                    <label style="font-size:11px; font-weight:700; color:#8492a6; letter-spacing:.5px; white-space:nowrap;">KHO</label>
                    <div style="position:relative;">
                        <button t-on-click="toggleWhDropdown"
                                style="border:1px solid #ced4da; border-radius:6px; padding:5px 10px; font-size:13px; min-width:170px; background:#fff; cursor:pointer; display:flex; align-items:center; justify-content:space-between; gap:8px;">
                            <span t-esc="warehouseSummary" style="color:#495057;"/>
                            <i class="fa fa-chevron-down" style="font-size:10px; color:#8492a6;"/>
                        </button>
                        <t t-if="state.whOpen">
                            <div style="position:absolute; top:calc(100% + 4px); left:0; background:#fff; border:1px solid #dee2e6; border-radius:8px; box-shadow:0 4px 16px rgba(0,0,0,0.14); z-index:9999; min-width:210px; padding:4px 0;">
                                <div t-on-click="toggleAllWarehouses"
                                     style="padding:8px 14px; font-size:12px; font-weight:700; color:#1a2639; cursor:pointer; border-bottom:1px solid #f0f0f0; display:flex; align-items:center; gap:8px;">
                                    <input type="checkbox" t-att-checked="state.warehouseIds.length === state.warehouses.length" style="cursor:pointer;"/>
                                    Tất cả kho
                                </div>
                                <t t-foreach="state.warehouses" t-as="wh" t-key="wh.id">
                                    <div t-on-click="() => this.toggleWarehouse(wh.id)"
                                         style="padding:7px 14px; font-size:13px; cursor:pointer; display:flex; align-items:center; gap:8px; color:#212121;">
                                        <input type="checkbox" t-att-checked="isWhSelected(wh.id)" style="cursor:pointer;"/>
                                        <span t-esc="wh.name"/>
                                    </div>
                                </t>
                            </div>
                        </t>
                    </div>
                </div>
                <label style="display:flex; align-items:center; gap:7px; font-size:13px; cursor:pointer; color:#495057; white-space:nowrap;">
                    <input type="checkbox" style="width:14px; height:14px; cursor:pointer;"
                           t-att-checked="state.showZero" t-on-change="onShowZeroChange"/>
                    Hiện SP hết hàng
                </label>
                <div style="margin-left:auto; display:flex; align-items:center; gap:10px;">
                    <t t-if="state.groupId and state.lines.length > 0">
                        <button t-on-click="exportExcel"
                                style="background:#217346; color:#fff; border:none; border-radius:7px; padding:7px 16px; font-size:13px; font-weight:600; cursor:pointer; display:flex; align-items:center; gap:7px;">
                            <i class="fa fa-file-excel-o"/> Xuất Excel
                        </button>
                    </t>
                    <t t-if="state.groupId and !state.loading">
                        <div style="background:#1a2639; color:#fff; border-radius:8px; padding:7px 16px; font-size:14px; font-weight:700; white-space:nowrap;">
                            Tổng tồn: <t t-esc="formatQty(state.total)"/>
                        </div>
                    </t>
                </div>
            </div>

            <!-- Body: sidebar + content -->
            <div style="display:flex; flex:1; overflow:hidden;">

                <!-- Sidebar -->
                <div style="width:220px; background:#1a2639; display:flex; flex-direction:column; flex-shrink:0;">
                    <div style="padding:10px 14px 6px; font-size:10px; font-weight:700; color:#8492a6; letter-spacing:.8px; text-transform:uppercase; flex-shrink:0;">
                        Nhóm sản phẩm
                    </div>
                    <div style="flex:1; overflow-y:auto;">
                        <t t-foreach="state.groups" t-as="g" t-key="g.id">
                            <t t-if="state.editingGroupId !== g.id">
                                <div t-on-click="() => this.selectGroup(g.id)"
                                     t-att-style="'display:flex; align-items:center; padding:8px 10px 8px 14px; cursor:pointer; font-size:13px; font-weight:500; border-left:3px solid transparent; ' + (state.groupId === g.id ? 'background:rgba(255,255,255,0.12); border-left-color:#4fc3f7; color:#fff;' : 'color:#b0bec5;')">
                                    <span style="flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" t-esc="g.name"/>
                                    <button t-on-click.stop="() => this.startEditGroup(g.id, g.name)"
                                            style="background:none; border:none; color:#8492a6; cursor:pointer; padding:2px 5px; font-size:12px; flex-shrink:0; line-height:1;" title="Sửa tên">
                                        ✏
                                    </button>
                                    <button t-on-click.stop="() => this.deleteGroup(g.id)"
                                            style="background:none; border:none; color:#8492a6; cursor:pointer; padding:2px 5px; font-size:12px; flex-shrink:0; line-height:1;" title="Xóa nhóm">
                                        ✕
                                    </button>
                                </div>
                            </t>
                            <t t-else="">
                                <div style="padding:8px 10px; background:rgba(255,255,255,0.08);">
                                    <input t-model="state.editGroupName" t-on-keydown="onEditGroupKeydown"
                                           style="width:100%; box-sizing:border-box; padding:5px 8px; border:1px solid #4fc3f7; border-radius:4px; font-size:12px; background:#0d1b2a; color:#fff; outline:none;"/>
                                    <div style="display:flex; gap:4px; margin-top:6px;">
                                        <button t-on-click="confirmRenameGroup"
                                                style="flex:1; background:#4fc3f7; color:#000; border:none; border-radius:4px; padding:4px; font-size:11px; cursor:pointer; font-weight:700;">
                                            ✓ Lưu
                                        </button>
                                        <button t-on-click="cancelEditGroup"
                                                style="background:#546e7a; color:#fff; border:none; border-radius:4px; padding:4px 8px; font-size:11px; cursor:pointer;">
                                            Hủy
                                        </button>
                                    </div>
                                </div>
                            </t>
                        </t>
                    </div>
                    <div style="border-top:1px solid rgba(255,255,255,0.08); padding:10px; flex-shrink:0;">
                        <t t-if="!state.addingGroup">
                            <button t-on-click="startAddGroup"
                                    style="width:100%; background:rgba(79,195,247,0.12); color:#4fc3f7; border:1px dashed rgba(79,195,247,0.4); border-radius:6px; padding:7px; font-size:12px; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:6px;">
                                <i class="fa fa-plus"/> Thêm nhóm
                            </button>
                        </t>
                        <t t-else="">
                            <input t-model="state.newGroupName" t-on-keydown="onAddGroupKeydown"
                                   placeholder="Tên nhóm mới..."
                                   style="width:100%; box-sizing:border-box; padding:6px 8px; border:1px solid #4fc3f7; border-radius:4px; font-size:12px; background:#0d1b2a; color:#fff; outline:none; margin-bottom:6px;"/>
                            <div style="display:flex; gap:4px;">
                                <button t-on-click="confirmAddGroup"
                                        style="flex:1; background:#4fc3f7; color:#000; border:none; border-radius:4px; padding:5px; font-size:12px; cursor:pointer; font-weight:700;">
                                    ✓ Tạo
                                </button>
                                <button t-on-click="cancelAddGroup"
                                        style="background:#546e7a; color:#fff; border:none; border-radius:4px; padding:5px 10px; font-size:12px; cursor:pointer;">
                                    Hủy
                                </button>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- Main content -->
                <div style="flex:1; overflow:auto; padding:20px;" t-on-click="closeDropdown">

                    <t t-if="!state.groupId">
                        <div style="text-align:center; padding:80px 20px; color:#adb5bd;">
                            <i class="fa fa-hand-o-left" style="font-size:48px; display:block; margin-bottom:14px;"/>
                            <div style="font-size:15px;">Chọn nhóm sản phẩm ở bên trái</div>
                        </div>
                    </t>

                    <t t-else="">
                        <!-- Tabs -->
                        <div style="display:flex; gap:4px; margin-bottom:18px; border-bottom:2px solid #e9ecef; padding-bottom:0;">
                            <button t-on-click="() => this.setTab('stock')"
                                    t-att-style="'border:none; cursor:pointer; padding:8px 18px; font-size:13px; font-weight:600; border-bottom:2px solid transparent; margin-bottom:-2px; background:transparent; ' + (state.activeTab === 'stock' ? 'border-bottom-color:#0d6efd; color:#0d6efd;' : 'color:#6c757d;')">
                                <i class="fa fa-table" style="margin-right:5px;"/> Tồn kho
                            </button>
                            <button t-on-click="() => this.setTab('manage')"
                                    t-att-style="'border:none; cursor:pointer; padding:8px 18px; font-size:13px; font-weight:600; border-bottom:2px solid transparent; margin-bottom:-2px; background:transparent; ' + (state.activeTab === 'manage' ? 'border-bottom-color:#0d6efd; color:#0d6efd;' : 'color:#6c757d;')">
                                <i class="fa fa-cogs" style="margin-right:5px;"/> Quản lý sản phẩm
                            </button>
                        </div>

                        <!-- TAB: Ton kho -->
                        <t t-if="state.activeTab === 'stock'">
                            <t t-if="state.loading">
                                <div style="text-align:center; padding:80px;">
                                    <i class="fa fa-spinner fa-spin" style="font-size:32px; color:#6c757d;"/>
                                    <div style="margin-top:10px; color:#6c757d; font-size:13px;">Đang tải...</div>
                                </div>
                            </t>
                            <t t-elif="state.lines.length === 0">
                                <div style="text-align:center; padding:80px; color:#adb5bd;">
                                    <i class="fa fa-inbox" style="font-size:48px; display:block; margin-bottom:14px;"/>
                                    <div style="font-size:15px;">Không có sản phẩm nào có tồn kho</div>
                                </div>
                            </t>
                            <t t-else="">
                                <div style="background:#e8f4fd; border:1px solid #b8daff; border-radius:6px; padding:8px 14px; margin-bottom:12px; font-size:12px; color:#004085; display:flex; align-items:center; gap:8px;">
                                    <i class="fa fa-info-circle"/> Click vào dòng sản phẩm để xem vị trí tồn kho chi tiết
                                </div>
                                <div style="background:#fff; border-radius:10px; box-shadow:0 1px 6px rgba(0,0,0,0.07); overflow:hidden;">
                                    <table style="width:100%; border-collapse:collapse; font-size:13px;">
                                        <thead>
                                            <tr style="background:#1a2639; color:#fff;">
                                                <th style="padding:10px 12px; width:36px; text-align:center; border-right:1px solid rgba(255,255,255,0.07);">#</th>
                                                <th style="padding:10px 12px; width:100px; text-align:center; border-right:1px solid rgba(255,255,255,0.07);">Ảnh / Mã SP</th>
                                                <th style="padding:10px 12px; border-right:1px solid rgba(255,255,255,0.07);">Tên sản phẩm</th>
                                                <th style="padding:10px 10px; width:60px; text-align:center; border-right:1px solid rgba(255,255,255,0.07);">ĐVT</th>
                                                <t t-if="state.columns.length > 0">
                                                    <t t-foreach="state.columns" t-as="col" t-key="col.id">
                                                        <th style="padding:10px 12px; width:110px; text-align:right; border-right:1px solid rgba(255,255,255,0.07);">
                                                            <t t-esc="col.name"/>
                                                        </th>
                                                    </t>
                                                    <th style="padding:10px 14px; width:120px; text-align:right; background:#198754; color:#fff; font-size:14px;">TỔNG</th>
                                                </t>
                                                <t t-else="">
                                                    <th style="padding:10px 14px; width:120px; text-align:right; background:#198754; color:#fff; font-size:14px;">Tồn kho</th>
                                                </t>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="state.lines" t-as="line" t-key="line_index">
                                                <tr t-on-click="() => this.toggleProductLocations(line.id)"
                                                    t-att-style="'border-bottom:1px solid #f0f0f0; cursor:pointer; ' + (state.expandedProductId === line.id ? 'background:#e8f4fd;' : (line_index % 2 === 1 ? 'background:#fafbfc;' : ''))">
                                                    <td style="padding:8px 12px; text-align:center; color:#adb5bd; font-size:11px; vertical-align:middle; border-right:1px solid #f0f0f0;">
                                                        <t t-esc="line_index + 1"/>
                                                    </td>
                                                    <td style="padding:6px 12px; text-align:center; vertical-align:middle; border-right:1px solid #f0f0f0;">
                                                        <div style="display:inline-flex; flex-direction:column; align-items:center; gap:3px;">
                                                            <img t-att-src="line.image_url"
                                                                 style="width:52px; height:52px; object-fit:contain; border-radius:6px; border:1px solid #e9ecef; background:#fafafa;"/>
                                                            <span style="font-family:monospace; font-size:10px; color:#546e7a; max-width:90px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"><t t-esc="line.code"/></span>
                                                        </div>
                                                    </td>
                                                    <td style="padding:8px 12px; color:#212121; vertical-align:middle; border-right:1px solid #f0f0f0;">
                                                        <span t-esc="line.name"/>
                                                        <i class="fa fa-map-marker"
                                                           t-att-style="'margin-left:8px; font-size:11px; ' + (state.expandedProductId === line.id ? 'color:#0d6efd;' : 'color:#ced4da;')"/>
                                                    </td>
                                                    <td style="padding:8px 10px; text-align:center; vertical-align:middle; font-size:11px; color:#6c757d; border-right:1px solid #f0f0f0; white-space:nowrap;">
                                                        <t t-esc="line.uom"/>
                                                    </td>
                                                    <t t-if="state.columns.length > 0">
                                                        <t t-foreach="line.col_qtys" t-as="qty" t-key="qty_index">
                                                            <td t-att-style="'padding:8px 12px; text-align:right; font-weight:600; vertical-align:middle; border-right:1px solid #f0f0f0; ' + (qty > 0 ? 'color:#198754;' : 'color:#ced4da;')">
                                                                <t t-esc="formatQty(qty)"/>
                                                            </td>
                                                        </t>
                                                        <td t-att-style="'padding:8px 14px; text-align:right; font-weight:800; font-size:15px; vertical-align:middle; border-left:2px solid #198754; ' + (line.total > 0 ? 'background:#f0fff4; color:#198754;' : 'background:#fafafa; color:#adb5bd;')">
                                                            <t t-esc="formatQty(line.total)"/>
                                                        </td>
                                                    </t>
                                                    <t t-else="">
                                                        <td t-att-style="'padding:8px 14px; text-align:right; font-weight:800; font-size:15px; vertical-align:middle; border-left:2px solid #198754; ' + (line.total > 0 ? 'background:#f0fff4; color:#198754;' : 'background:#fafafa; color:#adb5bd;')">
                                                            <t t-esc="formatQty(line.total)"/>
                                                        </td>
                                                    </t>
                                                </tr>
                                                <!-- Vi tri ton kho (expand) -->
                                                <t t-if="state.expandedProductId === line.id">
                                                    <tr style="background:#f0f7ff;">
                                                        <td t-att-colspan="tableColspan" style="padding:12px 20px; border-bottom:2px solid #b8daff;">
                                                            <t t-if="!state.locationData[line.id]">
                                                                <div style="color:#6c757d; font-size:12px; padding:4px 0;">
                                                                    <i class="fa fa-spinner fa-spin"/> Đang tải vị trí...
                                                                </div>
                                                            </t>
                                                            <t t-else="">
                                                                <div style="font-size:12px; font-weight:700; color:#004085; margin-bottom:8px; display:flex; align-items:center; gap:6px;">
                                                                    <i class="fa fa-map-marker" style="color:#0d6efd;"/>
                                                                    Vị trí tồn kho: <span t-esc="line.name"/>
                                                                </div>
                                                                <t t-if="state.locationData[line.id].length === 0">
                                                                    <div style="color:#adb5bd; font-size:12px; font-style:italic;">Không có tồn kho ở vị trí nào trong kho đã chọn.</div>
                                                                </t>
                                                                <t t-else="">
                                                                    <table style="font-size:12px; border-collapse:collapse; min-width:100%;">
                                                                        <thead>
                                                                            <tr style="background:#dbeafe; color:#1e3a8a;">
                                                                                <th style="padding:5px 12px; text-align:left;">Kho</th>
                                                                                <th style="padding:5px 12px; text-align:left;">Vị trí</th>
                                                                                <th style="padding:5px 12px; text-align:right;">Số lượng</th>
                                                                            </tr>
                                                                        </thead>
                                                                        <tbody>
                                                                            <t t-foreach="state.locationData[line.id]" t-as="loc" t-key="loc_index">
                                                                                <tr t-att-style="'border-bottom:1px solid #e0ecff; ' + (loc.outgoing ? 'background:#fff8e1;' : (loc_index % 2 === 1 ? 'background:#f5f9ff;' : ''))">
                                                                                    <td style="padding:5px 12px; color:#546e7a;"><t t-esc="loc.warehouse"/></td>
                                                                                    <td style="padding:5px 12px; font-family:monospace; font-size:11px; color:#1a2639;">
                                                                                        <t t-esc="loc.location"/>
                                                                                        <t t-if="loc.outgoing">
                                                                                            <span style="display:inline-block; margin-left:8px; background:#fd7e14; color:#fff; border-radius:10px; padding:1px 8px; font-size:10px; font-weight:700; font-family:sans-serif; vertical-align:middle; white-space:nowrap;">
                                                                                                &#128666; Chu\u1ea9n b\u1ecb giao
                                                                                            </span>
                                                                                        </t>
                                                                                    </td>
                                                                                    <td t-att-style="'padding:5px 12px; text-align:right; font-weight:700; ' + (loc.outgoing ? 'color:#fd7e14;' : 'color:#198754;')"><t t-esc="formatQty(loc.qty)"/></td>
                                                                                </tr>
                                                                            </t>
                                                                        </tbody>
                                                                    </table>
                                                                </t>
                                                            </t>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </t>
                                        </tbody>
                                        <tfoot>
                                            <tr style="background:#e8f5e9; border-top:2px solid #198754;">
                                                <td colspan="4" style="padding:10px 12px; font-weight:700; text-align:right; color:#155724; font-size:12px; letter-spacing:.3px;">
                                                    TỔNG TỒN KHO
                                                </td>
                                                <t t-if="state.columns.length > 0">
                                                    <td t-foreach="state.columns" t-as="col" t-key="col.id"
                                                        style="padding:10px 12px; text-align:right; font-weight:700; color:#198754; font-size:13px; border-right:1px solid #c3e6cb;">
                                                        <t t-esc="formatQty(getColTotal(col_index))"/>
                                                    </td>
                                                    <td style="padding:10px 14px; font-weight:800; text-align:right; font-size:17px; color:#fff; background:#198754; border-left:2px solid #146c43;">
                                                        <t t-esc="formatQty(state.total)"/>
                                                    </td>
                                                </t>
                                                <t t-else="">
                                                    <td style="padding:10px 14px; font-weight:800; text-align:right; font-size:17px; color:#fff; background:#198754; border-left:2px solid #146c43;">
                                                        <t t-esc="formatQty(state.total)"/>
                                                    </td>
                                                </t>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </t>
                        </t>

                        <!-- TAB: Quan ly san pham -->
                        <t t-elif="state.activeTab === 'manage'">

                            <!-- Search -->
                            <div style="background:#fff; border-radius:10px; padding:18px; margin-bottom:16px; box-shadow:0 1px 6px rgba(0,0,0,0.07);">
                                <div style="font-size:13px; font-weight:700; color:#1a2639; margin-bottom:12px;">
                                    <i class="fa fa-plus-circle" style="color:#198754; margin-right:6px;"/>
                                    Thêm sản phẩm vào nhóm
                                </div>
                                <div style="display:flex; gap:8px; margin-bottom:10px;">
                                    <input t-model="state.productQuery" t-on-keydown="onProductQueryKeydown"
                                           placeholder="Nhập mã hoặc tên sản phẩm..."
                                           style="flex:1; padding:7px 12px; border:1px solid #ced4da; border-radius:6px; font-size:13px; outline:none;"/>
                                    <button t-on-click="searchProducts"
                                            style="background:#0d6efd; color:#fff; border:none; border-radius:6px; padding:7px 14px; font-size:13px; cursor:pointer; display:flex; align-items:center; gap:6px;">
                                        <i class="fa fa-search"/> Tìm
                                    </button>
                                </div>
                                <t t-if="state.productLoading">
                                    <div style="color:#6c757d; font-size:12px; padding:8px;">
                                        <i class="fa fa-spinner fa-spin"/> Đang tìm...
                                    </div>
                                </t>
                                <t t-elif="state.productResults.length > 0">
                                    <!-- Pagination info bar -->
                                    <t t-if="state.productTotalCount > 50">
                                        <div style="display:flex; align-items:center; justify-content:space-between; padding:6px 10px; background:#f8f9fa; border:1px solid #dee2e6; border-bottom:none; border-radius:6px 6px 0 0; font-size:12px; color:#495057;">
                                            <span>
                                                Hiển <b><t t-esc="state.productPage * 50 + 1"/></b>&#8211;<b><t t-esc="Math.min((state.productPage + 1) * 50, state.productTotalCount)"/></b> / <b><t t-esc="state.productTotalCount"/></b> sản phẩm
                                            </span>
                                            <div style="display:flex; gap:4px;">
                                                <button t-on-click="searchProductsPrev"
                                                        t-att-style="'border:1px solid #dee2e6; border-radius:4px; padding:3px 10px; font-size:12px; cursor:pointer; ' + (state.productPage === 0 ? 'background:#f8f9fa; color:#adb5bd; pointer-events:none;' : 'background:#fff; color:#0d6efd;')">
                                                    &#8592; Trước
                                                </button>
                                                <span style="padding:3px 8px; font-size:12px; color:#495057;">
                                                    Trang <b><t t-esc="state.productPage + 1"/></b> / <b><t t-esc="Math.ceil(state.productTotalCount / 50)"/></b>
                                                </span>
                                                <button t-on-click="searchProductsNext"
                                                        t-att-style="'border:1px solid #dee2e6; border-radius:4px; padding:3px 10px; font-size:12px; cursor:pointer; ' + ((state.productPage + 1) * 50 >= state.productTotalCount ? 'background:#f8f9fa; color:#adb5bd; pointer-events:none;' : 'background:#fff; color:#0d6efd;')">
                                                    Tiếp &#8594;
                                                </button>
                                            </div>
                                        </div>
                                    </t>
                                    <div t-att-style="'border:1px solid #dee2e6; max-height:400px; overflow-y:auto; ' + (state.productTotalCount > 50 ? 'border-radius:0 0 8px 8px;' : 'border-radius:8px;')">
                                        <t t-foreach="state.productResults" t-as="p" t-key="p.id">
                                            <div t-att-style="'display:flex; align-items:center; padding:10px 12px; gap:12px; ' + (p_index > 0 ? 'border-top:1px solid #f5f5f5;' : '')">
                                                <img t-att-src="p.image_url"
                                                     style="width:56px; height:56px; object-fit:contain; border-radius:8px; border:1px solid #e9ecef; background:#fafafa; flex-shrink:0;"/>
                                                <div style="flex:1; min-width:0;">
                                                    <div style="font-family:monospace; font-size:11px; color:#546e7a; margin-bottom:2px;"><t t-esc="p.code"/></div>
                                                    <div style="font-size:13px; color:#212121; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><t t-esc="p.name"/></div>
                                                </div>
                                                <button t-on-click="() => this.addProductToGroup(p.id)"
                                                        style="background:#198754; color:#fff; border:none; border-radius:6px; padding:7px 16px; font-size:12px; cursor:pointer; white-space:nowrap; flex-shrink:0; font-weight:600;">
                                                    + Thêm
                                                </button>
                                            </div>
                                        </t>
                                    </div>
                                    <!-- Bottom pagination -->
                                    <t t-if="state.productTotalCount > 50">
                                        <div style="display:flex; justify-content:center; gap:6px; margin-top:8px;">
                                            <button t-on-click="searchProductsPrev"
                                                    t-att-style="'border:1px solid #dee2e6; border-radius:6px; padding:5px 16px; font-size:12px; cursor:pointer; ' + (state.productPage === 0 ? 'background:#f8f9fa; color:#adb5bd; pointer-events:none;' : 'background:#0d6efd; color:#fff; border-color:#0d6efd;')">
                                                &#8592; Trang trước
                                            </button>
                                            <button t-on-click="searchProductsNext"
                                                    t-att-style="'border:1px solid #dee2e6; border-radius:6px; padding:5px 16px; font-size:12px; cursor:pointer; ' + ((state.productPage + 1) * 50 >= state.productTotalCount ? 'background:#f8f9fa; color:#adb5bd; pointer-events:none;' : 'background:#0d6efd; color:#fff; border-color:#0d6efd;')">
                                                Trang tiếp &#8594;
                                            </button>
                                        </div>
                                    </t>
                                </t>
                                <t t-elif="state.productQuery and !state.productLoading">
                                    <div style="color:#adb5bd; font-size:12px; padding:8px;">Không tìm thấy sản phẩm nào.</div>
                                </t>
                            </div>

                            <!-- Danh sach san pham -->
                            <div style="background:#fff; border-radius:10px; overflow:hidden; box-shadow:0 1px 6px rgba(0,0,0,0.07); margin-bottom:16px;">
                                <div style="padding:12px 16px; font-size:13px; font-weight:700; color:#1a2639; border-bottom:1px solid #f0f0f0; display:flex; align-items:center; gap:8px;">
                                    <i class="fa fa-list" style="color:#6c757d;"/>
                                    Sản phẩm trong nhóm
                                    <span style="background:#e9ecef; color:#495057; border-radius:12px; padding:1px 8px; font-size:11px;">
                                        <t t-esc="state.groupProducts.length"/>
                                    </span>
                                </div>
                                <t t-if="state.groupProducts.length === 0">
                                    <div style="text-align:center; padding:30px; color:#adb5bd; font-size:13px;">
                                        Chưa có sản phẩm nào trong nhóm này
                                    </div>
                                </t>
                                <t t-else="">
                                    <t t-foreach="state.groupProducts" t-as="p" t-key="p.id">
                                        <div t-att-style="'display:flex; align-items:center; padding:10px 16px; gap:14px; ' + (p_index > 0 ? 'border-top:1px solid #f5f5f5;' : '') + (p_index % 2 === 1 ? ' background:#fafbfc;' : '')">
                                            <img t-att-src="p.image_url"
                                                 style="width:56px; height:56px; object-fit:contain; border-radius:8px; border:1px solid #e9ecef; background:#fafafa; flex-shrink:0;"/>
                                            <div style="flex:1; min-width:0;">
                                                <div style="font-family:monospace; font-size:11px; color:#546e7a; margin-bottom:3px;"><t t-esc="p.code"/></div>
                                                <div style="font-size:13px; color:#212121;"><t t-esc="p.name"/></div>
                                            </div>
                                            <button t-on-click="() => this.removeProductFromGroup(p.id)"
                                                    style="background:none; border:1px solid #dee2e6; color:#dc3545; border-radius:6px; padding:6px 14px; font-size:11px; cursor:pointer; white-space:nowrap; flex-shrink:0;">
                                                ✕ Xóa
                                            </button>
                                        </div>
                                    </t>
                                </t>
                            </div>

                            <!-- Import tu Excel -->
                            <div style="background:#fff; border-radius:10px; padding:18px; box-shadow:0 1px 6px rgba(0,0,0,0.07);">
                                <div style="font-size:13px; font-weight:700; color:#1a2639; margin-bottom:12px; display:flex; align-items:center; gap:8px;">
                                    <i class="fa fa-upload" style="color:#0d6efd;"/>
                                    Import danh sách sản phẩm từ Excel
                                </div>
                                <div style="background:#fff8e1; border:1px solid #ffe082; border-radius:6px; padding:10px 14px; margin-bottom:14px; font-size:12px; color:#5d4037; line-height:1.7;">
                                    <b>Hướng dẫn:</b><br/>
                                    &#8226; File định dạng <b>.xlsx</b> hoặc <b>.xls</b><br/>
                                    &#8226; <b>Cột A</b>: Mã sản phẩm (default_code) &#8212; ví dụ: 284606017, 656414001<br/>
                                    &#8226; Dòng đầu có thể là tiêu đề (Mã SP / default_code) &#8212; tự động bỏ qua<br/>
                                    &#8226; Mỗi dòng một mã sản phẩm
                                </div>
                                <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
                                    <input type="file" id="hlv-import-file" accept=".xlsx,.xls" t-on-change="handleImportFile"
                                           style="flex:1; min-width:200px; padding:7px; border:1px solid #ced4da; border-radius:6px; font-size:13px; cursor:pointer;"/>
                                    <t t-if="state.importLoading">
                                        <span style="color:#0d6efd; font-size:13px; display:flex; align-items:center; gap:6px;">
                                            <i class="fa fa-spinner fa-spin"/> Đang nhập dữ liệu...
                                        </span>
                                    </t>
                                </div>
                                <t t-if="state.importResults">
                                    <div style="margin-top:14px; border:1px solid #dee2e6; border-radius:8px; overflow:hidden;">
                                        <div style="background:#f8f9fa; padding:10px 16px; display:flex; gap:16px; flex-wrap:wrap; border-bottom:1px solid #dee2e6; align-items:center;">
                                            <span style="font-size:13px; font-weight:700; color:#1a2639;">Kết quả import (<t t-esc="state.importResults.total"/> mã):</span>
                                            <span style="color:#198754; font-size:12px; font-weight:600;">&#10003; Thêm mới: <t t-esc="state.importResults.added.length"/></span>
                                            <span style="color:#fd7e14; font-size:12px; font-weight:600;">&#9888; Đã có: <t t-esc="state.importResults.already_in.length"/></span>
                                            <span style="color:#dc3545; font-size:12px; font-weight:600;">&#10007; Không tìm thấy: <t t-esc="state.importResults.not_found.length"/></span>
                                            <button t-on-click="resetImportFile"
                                                    style="margin-left:auto; background:none; border:1px solid #dee2e6; border-radius:4px; padding:3px 10px; font-size:11px; cursor:pointer; color:#6c757d;">
                                                Xóa kết quả
                                            </button>
                                        </div>
                                        <t t-if="state.importResults.added.length > 0">
                                            <div style="padding:10px 16px; border-bottom:1px solid #f0f0f0;">
                                                <div style="font-size:12px; font-weight:700; color:#198754; margin-bottom:6px;">Đã thêm thành công:</div>
                                                <t t-foreach="state.importResults.added" t-as="item" t-key="item_index">
                                                    <div style="font-size:12px; padding:2px 0; display:flex; gap:12px;">
                                                        <span style="font-family:monospace; color:#546e7a; flex-shrink:0; width:130px;"><t t-esc="item.code"/></span>
                                                        <span style="color:#212121;"><t t-esc="item.name"/></span>
                                                    </div>
                                                </t>
                                            </div>
                                        </t>
                                        <t t-if="state.importResults.not_found.length > 0">
                                            <div style="padding:10px 16px; border-bottom:1px solid #f0f0f0;">
                                                <div style="font-size:12px; font-weight:700; color:#dc3545; margin-bottom:6px;">Không tìm thấy mã:</div>
                                                <div style="display:flex; gap:6px; flex-wrap:wrap;">
                                                    <t t-foreach="state.importResults.not_found" t-as="code" t-key="code_index">
                                                        <span style="background:#fff5f5; border:1px solid #fecaca; border-radius:4px; padding:2px 10px; font-family:monospace; font-size:11px; color:#dc3545;"><t t-esc="code"/></span>
                                                    </t>
                                                </div>
                                            </div>
                                        </t>
                                        <t t-if="state.importResults.already_in.length > 0">
                                            <div style="padding:10px 16px;">
                                                <div style="font-size:12px; font-weight:700; color:#fd7e14; margin-bottom:6px;">Đã có trong nhóm:</div>
                                                <t t-foreach="state.importResults.already_in" t-as="item" t-key="item_index">
                                                    <div style="font-size:12px; padding:2px 0; display:flex; gap:12px;">
                                                        <span style="font-family:monospace; color:#546e7a; flex-shrink:0; width:130px;"><t t-esc="item.code"/></span>
                                                        <span style="color:#6c757d;"><t t-esc="item.name"/></span>
                                                    </div>
                                                </t>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                            </div>

                        </t>

                    </t>

                </div>
            </div>

        </div>
    </t>
</templates>
