<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="public_search_template" name="Tra cứu Excel mua hàng">
        <t t-call="website.layout">
            <div class="eps-page">
                <main class="eps-shell">
                    <section class="eps-header">
                        <div>
                            <p class="eps-kicker">Tra cứu Excel</p>
                            <h1>Sổ chi tiết mua hàng</h1>
                            <p class="eps-subtitle" t-if="excel_file">
                                <t t-esc="excel_file.name"/>
                            </p>
                        </div>
                        <div class="eps-count" t-if="auth_ok and searched">
                            <span t-esc="total"/>
                            <small>kết quả</small>
                        </div>
                    </section>

                    <t t-if="not_found">
                        <section class="eps-empty">
                            <h2>Chưa có file khả dụng</h2>
                            <p>Vui lòng liên hệ admin để upload và kích hoạt file Excel.</p>
                        </section>
                    </t>

                    <t t-if="not not_found and not auth_ok">
                        <section class="eps-auth-card">
                            <h2>Xác thực truy cập</h2>
                            <p>Nhập mật khẩu để vào trang tra cứu.</p>

                            <t t-if="auth_config_error">
                                <div class="eps-alert"><t t-esc="auth_config_error"/></div>
                            </t>
                            <t t-if="auth_error">
                                <div class="eps-alert"><t t-esc="auth_error"/></div>
                            </t>

                            <form method="post" t-att-action="request.httprequest.path" class="eps-auth-form" t-if="not auth_config_error">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="password"
                                       name="access_password"
                                       placeholder="Nhập mật khẩu truy cập"
                                       required="required"
                                       autocomplete="current-password"/>
                                <button type="submit">Xác nhận</button>
                            </form>
                        </section>
                    </t>

                    <t t-if="not not_found and auth_ok">
                        <section class="eps-search-panel">
                            <form method="get" t-att-action="'/excel-purchase-search/%s' % excel_file.public_slug" class="eps-search-form">
                                <div class="eps-input-wrap">
                                    <span class="eps-search-icon">⌕</span>
                                    <input type="text"
                                           name="q"
                                           t-att-value="keyword"
                                           placeholder="Nhập từ khóa rời: pu04 pvn, ống 4 pvn, mã chứng từ..."
                                           autocomplete="off"/>
                                </div>
                                <button type="submit">Tìm kiếm</button>
                            </form>
                        </section>

                        <t t-if="error">
                            <div class="eps-alert"><t t-esc="error"/></div>
                        </t>

                        <t t-if="not searched">
                            <section class="eps-empty">
                                <h2>Nhập từ khóa để bắt đầu</h2>
                                <p>Kết quả chỉ tìm trong các cột admin đã cho phép tìm kiếm.</p>
                            </section>
                        </t>

                        <t t-if="searched and total == 0 and not error">
                            <section class="eps-empty">
                                <h2>Không tìm thấy dữ liệu</h2>
                                <p>Thử từ khóa ngắn hơn hoặc dùng mã chứng từ, tên nhà cung cấp, tên hàng.</p>
                            </section>
                        </t>

                        <t t-if="rows">
                            <section class="eps-table-card">
                                <div class="eps-table-scroll">
                                    <table class="eps-table">
                                        <thead>
                                            <tr>
                                                <th class="eps-row-col">Dòng</th>
                                                <t t-foreach="columns" t-as="column">
                                                    <th><t t-esc="column.name"/></th>
                                                </t>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="rows" t-as="row">
                                                <tr>
                                                    <td class="eps-row-col"><t t-esc="row['excel_row']"/></td>
                                                    <t t-foreach="row['values']" t-as="value">
                                                        <td><t t-esc="value"/></td>
                                                    </t>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </section>
                            <div class="eps-pager">
                                <t t-call="website.pager"/>
                            </div>
                        </t>
                    </t>
                </main>
            </div>
        </t>
    </template>
</odoo>
