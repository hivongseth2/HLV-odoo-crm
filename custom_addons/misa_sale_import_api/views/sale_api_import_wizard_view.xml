<odoo>
  <record id="view_sale_api_import_wizard_form" model="ir.ui.view">
    <field name="name">sale.api.import.wizard.form</field>
    <field name="model">sale.api.import.wizard</field>
    <field name="arch" type="xml">
      <form string="Import Sale Orders from MISA API">
        <group>
          <field name="from_date"/>
          <field name="to_date"/>
        </group>
        <footer>
          <button name="action_import" string="Import" type="object" class="btn-primary"/>
          <button string="Cancel" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field> <!-- 🔁 PHẢI đóng đúng thẻ field ở đây -->
  </record>
</odoo>
