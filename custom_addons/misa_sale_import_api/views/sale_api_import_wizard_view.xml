<odoo>
  <record id="action_sale_api_import_wizard" model="ir.actions.act_window">
    <field name="name">Import MISA Sale Orders</field>
    <field name="res_model">sale.api.import.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

  <menuitem id="menu_misa_import"
            name="Import từ MISA API"
            parent="sale.sale_order_menu"
            action="action_sale_api_import_wizard"
            sequence="100"/>

  <record id="view_sale_api_import_form" model="ir.ui.view">
    <field name="name">sale.api.import.wizard.form</field>
    <field name="model">sale.api.import.wizard</field>
    <field name="arch" type="xml">
      <form string="Import MISA Sale Orders">
        <group>
          <field name="date_from"/>
          <field name="date_to"/>
        </group>
        <footer>
          <button name="button_import" string="Import" type="object" class="btn-primary"/>
          <button string="Cancel" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </record>
</odoo>
