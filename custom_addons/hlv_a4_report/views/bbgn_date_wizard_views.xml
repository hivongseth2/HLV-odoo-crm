<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Form view cho wizard -->
  <record id="view_bbgn_date_wizard_form" model="ir.ui.view">
    <field name="name">bbgn.date.wizard.form</field>
    <field name="model">bbgn.date.wizard</field>
    <field name="arch" type="xml">
      <form string="Chọn ngày đơn đặt hàng" create="false" edit="false">
        <group>
          <field name="picking_id" readonly="1"/>
          <field name="order_date" required="1"/>
        </group>
        <footer>
          <button string="In biên bản" type="object" name="action_print" class="btn-primary"/>
          <button string="Hủy" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <!-- Action mở wizard -->
  <record id="action_open_bbgn_date_wizard" model="ir.actions.act_window">
    <field name="name">Chọn ngày đơn đặt hàng</field>
    <field name="res_model">bbgn.date.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    <field name="context">{'default_picking_id': active_id}</field>
  </record>

  <!-- Server Action xuất hiện trong menu Hành động của stock.picking -->
  <record id="server_action_open_bbgn_date_wizard" model="ir.actions.server">
    <field name="name">In BBGN A4 không giá (chọn ngày)</field>
    <field name="model_id" ref="stock.model_stock_picking"/>
    <field name="state">code</field>
    <field name="code">
action = env.ref('hlv_a4_report.action_open_bbgn_date_wizard').read()[0]
action['context'] = dict(env.context, default_picking_id=record.id)
action
    </field>
    <field name="binding_model_id" ref="stock.model_stock_picking"/>
    <field name="binding_type">action</field>
  </record>

</odoo>
