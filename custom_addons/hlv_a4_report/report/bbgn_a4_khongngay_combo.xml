<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Action report -->
    <record id="bbgn_a4_khongngay_combo" model="ir.actions.report">
        <field name="name">BBGN A4 Không Ngày - COMBO</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hlv_a4_report.bbgn_a4_khongngay_combo_doc</field>
        <field name="print_report_name">
            'BBGN A4 Không Ngày COMBO - %s' % (object.name or 'Picking')
        </field>
        <field name="binding_model_id" ref="stock.model_stock_picking" />
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="hlv_a4_report.paperformat_hlv_a4_portrait" />
    </record>

    <template id="bbgn_a4_khongngay_combo_doc">
        <t t-call="web.html_container">
            <t t-call="web.report_layout">
                <style type="text/css">
                    @font-face {
                    font-family: 'HLV-TNR';
                    src: url('/hlv_a4_report/static/fonts/times-new-roman.ttf') format('truetype');
                    font-weight: 400;
                    font-style: normal;
                    font-display: swap;
                    }
                    @font-face {
                    font-family: 'HLV-TNR';
                    src: url('/hlv_a4_report/static/fonts/times-new-roman-bold.ttf')
                    format('truetype');
                    font-weight: 700;
                    font-style: normal;
                    font-display: swap;
                    }
                    @font-face {
                    font-family: 'HLV-TNR';
                    src: url('/hlv_a4_report/static/fonts/times-new-roman-italic.ttf')
                    format('truetype');
                    font-weight: 400;
                    font-style: italic;
                    font-display: swap;
                    }
                    @font-face {
                    font-family: 'HLV-TNR';
                    src: url('/hlv_a4_report/static/fonts/times-new-roman-bolditalic.ttf')
                    format('truetype');
                    font-weight: 700;
                    font-style: italic;
                    font-display: swap;
                    }

                    html, body, .o_report_layout, .o_report_layout * {
                    font-family: 'HLV-TNR', 'DejaVu Sans', sans-serif !important;
                    }

                    .hlv-title {
                    font-weight: 700;
                    }
                </style>

                <div class="page">
                    <t t-foreach="docs" t-as="picking">
                        <!-- Lấy sale.order để hiển thị thông tin -->
                        <t t-set="so" t-value="picking.sale_id or (picking.move_ids and picking.move_ids[0].sale_line_id and picking.move_ids[0].sale_line_id.order_id)"/>

                        <div class="page">

                            <!-- Header công ty -->
                            <table style="width:100%;margin-top:30px">
                                <tr>
                                    <!-- Logo -->
                                    <td
                                        style="width:220px; text-align:center; vertical-align:middle; padding-right:5px">
                                        <t t-if="picking.company_id.logo">
                                            <img t-att-src="image_data_uri(picking.company_id.logo)"
                                                style="max-height:150px; position:relative; top:-20px; height:130px; width:180px; object-fit:contain; text-align:center; vertical-align:middle;" />
                                        </t>
                                        <t t-else="">
                                            <img
                                                t-att-src="'/web/image/res.company/%s/logo' % picking.company_id.id"
                                                style="max-height:150px; height:150px; width:120px;" />
                                        </t>
                                    </td>

                                    <!-- Thông tin công ty -->
                                    <td style="vertical-align:top; padding-left:10px;">
                                        <div style="font-weight:700; font-size:16px;">
                                            <t>CÔNG TY TNHH VI NA HOÀNG LONG VŨ</t>
                                            </div>
                                        <div>
                                            <t t-set="addr"
                                                t-value="picking.company_id.partner_id._display_address(without_company=True) or ''" />
                                            <t t-foreach="addr.split(' - ')" t-as="line">
                                                <t t-esc="line" />
                                                <br />
                                            </t>
                                        </div>
                                        <div>Mã số thuế: <span t-esc="picking.company_id.vat or ''" /></div>
                                        <div>Website: <span t-esc="picking.company_id.website or ''" /></div>
                                    </td>
                                </tr>
                            </table>

                            <!-- Tiêu đề -->
                            <div style="text-align:center; margin-top:-5px">
                                <div style="font-size:20px; font-weight:800;">BIÊN BẢN BÀN GIAO</div>

                                <!-- Năm tự động: ưu tiên date_done -> scheduled_date -> create_date
                                -> năm hiện tại -->
                                <t t-set="dt_src" t-value="o.date_order or o.create_date" />
                                <t t-set="year_str" t-value="(dt_src and dt_src.strftime('%Y')) or datetime.datetime.now().strftime('%Y')" />

                                <div> (Số phiếu xuất: <span t-esc="o.name" /> – ngày ... tháng ...
                                    năm <t t-esc="year_str" />) </div>
                            </div>

                            <!-- Hai bên -->
                            <table style="width:100%; font-size:13px; margin-top:10px;">
                                <tr>
                                    <td style="width:180px; font-weight:600;">Đại diện bên nhận (A)</td>
                                    <td style="font-weight:700;"
                                        t-esc="so and so.partner_id and so.partner_id.commercial_partner_id.name or ''" />
                                </tr>
                                <tr>
                                    <td>Ông (Bà)</td>
                                    <td />
                                </tr>
                                <tr>
                                    <td>Địa chỉ</td>
                                    <td class="h6-fs" style="width:379.875px;">
                                        <t t-set="p"
                                            t-value="so and so.partner_id and so.partner_id.commercial_partner_id or so.partner_id" />
                                        <t
                                            t-esc="(p.street or '') + (p.street2 and (', ' + p.street2) or '')" />
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding-top:6px; font-weight:600;">Đại diện bên giao (B)</td>
                                    <td style="padding-top:6px; font-weight:700;">
                                        CÔNG TY TNHH VI NA HOÀNG LONG VŨ
                                    </td>
                                </tr>
                                <tr>
                                    <td>Ông (Bà)</td>
                                    <td />
                                </tr>
                                <tr>
                                    <td class="label">Địa chỉ</td>
                                    <td>
                                        <t t-set="addr_b"
                                            t-value="picking.company_id.partner_id._display_address(without_company=True) or ''" />
                                        <t t-foreach="addr_b.split('-')" t-as="line">
                                            <t t-esc="line" />
                                            <br />
                                        </t>
                                    </td>
                                </tr>
                            </table>

                            <div style="margin:15px 15px 6px 0; font-weight:700">Bên B đã bàn giao
                                cho bên A:</div>

                            <!-- COMBO: Lấy dữ liệu từ helper với picking -->
                            <t t-set="enriched_lines" t-value="env['hlv.report.helper'].get_enriched_lines_for_picking_combo(picking)"/>

                            <!-- Bảng hàng hóa -->
                            <table
                                style="width:100%; border-collapse:collapse; margin-top:6px; font-size:13px;">
                                <thead>
                                    <tr>
                                        <th
                                            style="border:1px solid #000; padding:6px; width:40px; text-align:center;">
                                            STT</th>
                                        <th style="border:1px solid #000; padding:6px;">Tên hàng</th>
                                        <th
                                            style="border:1px solid #000; padding:6px; width:120px; text-align:center;">Đơn
                                            vị tính</th>
                                        <th
                                            style="border:1px solid #000; padding:6px; width:120px; text-align:center;">Số
                                            lượng</th>
                                        <th
                                            style="border:1px solid #000; padding:6px; width:160px; text-align:center;">Ghi
                                            chú</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="idx" t-value="1" />
                                    <t t-foreach="enriched_lines" t-as="line_data">
                                        <!-- Sử dụng dữ liệu từ helper -->
                                        <t t-set="is_child" t-value="line_data['is_combo_child']"/>
                                        <t t-set="qty_show" t-value="line_data['qty']"/>

                                        <!-- Chỉ render khi qty_show > 0 -->
                                        <t t-if="qty_show &gt; 0 and line_data['type'] != 'parent'">
                                            <tr>
                                                <!-- STT -->
                                                <td
                                                    style="border:1px solid #000; padding:6px; text-align:center;">
                                                    <t t-if="line_data['type'] == 'parent'">
                                                        <t t-esc="idx" />
                                                        <t t-set="idx" t-value="idx + 1"/>
                                                    </t>
                                                </td>

                                                <!-- Tên hàng -->
                                                <td style="border:1px solid #000; padding:6px;">
                                                    <t t-if="is_child">
                                                        <span style="padding-left:24px;">
                                                            <t t-esc="line_data['product_name']"/>
                                                        </span>
                                                    </t>
                                                    <t t-else="">
                                                        <span t-esc="line_data['product_name']" />
                                                    </t>
                                                </td>

                                                <!-- Đơn vị tính -->
                                                <td
                                                    style="border:1px solid #000; padding:6px; text-align:center;">
                                                    <span t-esc="line_data['uom']" />
                                                </td>

                                                <!-- Số lượng -->
                                                <td
                                                    style="border:1px solid #000; padding:6px; text-align:center;">
                                                    <span t-esc="'%0.2f' % qty_show" />
                                                </td>

                                                <!-- Ghi chú -->
                                                <td style="border:1px solid #000; padding:6px;" />
                                            </tr>
                                        </t>
                                    </t>

                                    <!-- Không có dòng nào đủ điều kiện -->
                                    <t t-if="not enriched_lines">
                                        <tr>
                                            <td colspan="5"
                                                style="border:1px solid #000; padding:8px; text-align:center; font-style:italic;">
                                                Không có dòng hàng.
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>

                            <!-- Chữ ký -->
                            <table style="width:100%; margin-top:24px; text-align:center;">
                                <tr>
                                    <td style="width:50%; font-weight:700;">ĐẠI DIỆN BÊN NHẬN<br />(Ký,
                                        họ tên)</td>
                                    <td style="width:50%; font-weight:700;">ĐẠI DIỆN BÊN GIAO<br />(Ký,
                                        họ tên)</td>
                                </tr>
                                <tr>
                                    <td style="height:100px;" />
                                    <td style="height:100px;" />
                                </tr>
                            </table>

                        </div>
                    </t>
                </div>

            </t>
        </t>
    </template>

</odoo>
