<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Action report: Phiếu xuất HLV - A5 (Landscape) -->
  <record id="report_px_hlv_a5" model="ir.actions.report">
    <field name="name">Phiếu xuất Hoàng Long Vũ - A5</field>
    <field name="model">stock.picking</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">hlv_a4_report.report_px_hlv_a5_doc</field>
    <field name="print_report_name">
      'Phiếu xuất Hoàng Long Vũ - A5 - %s' % (object.name or 'Picking')
    </field>
    <field name="binding_model_id" ref="stock.model_stock_picking"/>
    <field name="binding_type">report</field>
    <!-- Trỏ đúng paperformat A5 landscape đã khai báo -->
    <field name="paperformat_id" ref="hlv_a4_report.paperformat_hlv_a5_landscape"/>
  </record>

  <!-- Template: Phiếu xuất HLV - A5 (Landscape) -->
  <template id="report_px_hlv_a5_doc">
    <t t-call="web.html_container">
      <t t-call="web.report_layout">
        <style type="text/css">
          /* ===== Fonts riêng A5 ===== */
          @font-face{font-family:'HLV-TNR';src:url('/hlv_a4_report/static/fonts/times-new-roman.ttf') format('truetype');font-weight:400;font-style:normal;font-display:swap;}
          @font-face{font-family:'HLV-TNR';src:url('/hlv_a4_report/static/fonts/times-new-roman-bold.ttf') format('truetype');font-weight:700;font-style:normal;font-display:swap;}
          @font-face{font-family:'HLV-TNR';src:url('/hlv_a4_report/static/fonts/times-new-roman-italic.ttf') format('truetype');font-weight:400;font-style:italic;font-display:swap;}
          @font-face{font-family:'HLV-TNR';src:url('/hlv_a4_report/static/fonts/times-new-roman-bolditalic.ttf') format('truetype');font-weight:700;font-style:italic;font-display:swap;}

          /* Base A5 landscape (210x148mm, lề 5mm) */
          html, body, .o_report_layout, .o_report_layout * {
            font-family:'HLV-TNR','DejaVu Serif','Liberation Serif',serif !important;
            font-size:11px !important;
            font-synthesis:none;
          }
          em,i{font-style:italic!important;font-weight:400!important;}
          strong em, strong i, b em, b i{font-style:italic!important;font-weight:700!important;}

          /* Font sizes (A5) */
          .fs-company-name{font-size:13px!important;font-weight:700;}
          .fs-company-info{font-size:10px!important;}
          .fs-title{font-size:14px!important;font-weight:700;}
          .fs-subtitle{font-size:10.5px!important;}
          .fs-customer-info{font-size:10.5px!important;}
          .fs-table-header{font-size:10.5px!important;font-weight:600;}
          .fs-table-content{font-size:10.5px!important;}
          .fs-table-total{font-size:10.5px!important;font-weight:600;}
          .fs-note{font-size:10.5px!important;font-style:italic;}
          .fs-signature{font-size:10.5px!important;}
          .fs-footer{font-size:9px!important;}

          table{border-collapse:collapse;width:100%;}
          .hdr-logo{width:165px;text-align:center;vertical-align:middle;padding-right:6px;}
          .hdr-logo img{max-height:90px;height:80px;width:140px;object-fit:contain;position:relative;top:-8px;}
          .hdr-info{vertical-align:top;padding-left:8px;}
          .mt-2{margin-top:2px;} .mt-4{margin-top:4px;} .mt-6{margin-top:6px;} .mt-8{margin-top:8px;} .mt-10{margin-top:10px;}

          /* Bảng hàng hóa A5: thu gọn cột */
          .tbl th,.tbl td{border:1px solid #000;}
          .tbl th{background:#eee;text-align:center;}

          .col-stt{width:26px;text-align:center;white-space:nowrap;}
          .col-name{width:auto;}
          .col-uom{width:46px;text-align:center;white-space:nowrap;}
          .col-qty{width:52px;text-align:center;white-space:nowrap;}
          .col-price{width:70px;text-align:right;white-space:nowrap;}
          .col-vatp{width:50px;text-align:center;white-space:nowrap;}
          .col-vat{width:70px;text-align:right;white-space:nowrap;}
          .col-amt{width:80px;text-align:right;white-space:nowrap;}
          .col-wh{width:80px;text-align:center;white-space:nowrap;}

          /* Chữ ký: chia đều 3 cột để không bị “xuống dòng dọc” */
          .sig td{width:33.333%;text-align:center;}
        </style>

        <div class="page">
          <t t-foreach="docs" t-as="o">
            <div class="page">
              <!-- Header -->
              <table class="mt-10">
                <tr>
                  <td class="hdr-logo">
                    <t t-if="o.company_id.logo">
                      <img t-att-src="image_data_uri(o.company_id.logo)"/>
                    </t>
                    <t t-else="">
                      <img t-att-src="'/web/image/res.company/%s/logo' % o.company_id.id"/>
                    </t>
                  </td>
                  <td class="hdr-info">
                    <div class="fs-company-name">CÔNG TY TNHH VI NA HOÀNG LONG VŨ</div>
                    <div class="fs-company-info">
                      Địa chỉ: <t t-esc="o.company_id.partner_id._display_address(without_company=True).replace('\n',' ') or ''"/>
                    </div>
                    <table style="width:100%;" class="mt-2">
                      <tr>
                        <td class="fs-company-info" style="padding:0 6px 0 0;white-space:nowrap;">Điện thoại:</td>
                        <td class="fs-company-info" style="padding:0 8px 0 0;"><t t-esc="o.company_id.phone or ''"/></td>
                        <td class="fs-company-info" style="padding:0;white-space:nowrap;">Di động:</td>
                        <td class="fs-company-info"><t t-esc="o.company_id.mobile or o.company_id.partner_id.mobile or ''"/></td>
                      </tr>
                      <tr>
                        <td class="fs-company-info" style="padding:2px 6px 0 0;white-space:nowrap;">Email:</td>
                        <td class="fs-company-info" style="padding:2px 8px 0 0;"><t t-esc="o.company_id.email or ''"/></td>
                        <td class="fs-company-info" style="padding:2px 6px 0 0;white-space:nowrap;">Website:</td>
                        <td class="fs-company-info" style="padding-top:2px;"><t t-esc="o.company_id.website or ''"/></td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <!-- Tiêu đề -->
              <div style="text-align:center;" class="mt-2">
                <div class="fs-title">PHIẾU XUẤT KHO KIÊM BÁN HÀNG</div>
                <t t-set="dt_src" t-value="o.date_done or o.scheduled_date or o.date or o.create_date"/>
                <div class="fs-subtitle">
                  (Số phiếu xuất: <span t-esc="o.name"/>; ngày:
                  <t t-if="dt_src"><t t-esc="dt_src.strftime('%d/%m/%Y')"/></t>
                  <t t-else="">__/__/____</t>)
                </div>
              </div>

              <!-- Thông tin KH -->
              <table class="mt-6">
                <t t-set="warehouse_name" t-value="(o.picking_type_id and o.picking_type_id.warehouse_id and o.picking_type_id.warehouse_id.name) or ''"/>
                <t t-set="khachle_label" t-value="(o.partner_id.commercial_partner_id.name)"/>
                <tr>
                  <td class="fs-customer-info" style="width:120px;white-space:nowrap;">Khách hàng:</td>
                  <td class="fs-customer-info"><span t-esc="khachle_label"/></td>
                </tr>
                <tr>
                  <td class="fs-customer-info" style="white-space:nowrap;">Địa chỉ:</td>
                  <td class="fs-customer-info"></td>
                </tr>
                <tr>
                  <td class="fs-customer-info" style="white-space:nowrap;">SĐT người nhận:</td>
                  <td class="fs-customer-info"><span t-esc="khachle_label"/></td>
                </tr>
              </table>

              <div class="fs-note mt-4">Cảm ơn quý khách hàng đã quan tâm sản phẩm Hoàng Long Vũ, chúng tôi rất hân hạnh được phục vụ quý khách</div>

              <!-- Dòng hàng & tổng -->
              <t t-set="is_done" t-value="o.state == 'done'"/>
              <t t-set="lines" t-value="is_done and o.move_line_ids or o.move_ids"/>
              <t t-set="total_untaxed" t-value="0.0"/>
              <t t-set="total_tax" t-value="0.0"/>

              <!-- Bảng hàng hóa -->
              <table class="tbl mt-6">
                <thead>
                  <tr>
                    <th class="fs-table-header col-stt">STT</th>
                    <th class="fs-table-header col-name">Tên hàng</th>
                    <th class="fs-table-header col-uom">DVT</th>
                    <th class="fs-table-header col-qty">SL</th>
                    <th class="fs-table-header col-price">Đơn giá</th>
                    <th class="fs-table-header col-vatp">VAT (%)</th>
                    <th class="fs-table-header col-vat">Thuế VAT</th>
                    <th class="fs-table-header col-amt">Thành tiền</th>
                    <th class="fs-table-header col-wh">Kho xuất</th>
                  </tr>
                </thead>
                <tbody>
                  <t t-set="idx" t-value="0"/>
                  <t t-foreach="lines" t-as="l">
                    <!-- qty_show -->
                    <t t-set="qty_show" t-value="0.0"/>
                    <t t-if="l._name == 'stock.move'">
                      <t t-set="qty_show" t-value="l.product_uom_qty or 0.0"/>
                    </t>
                    <t t-elif="l._name == 'stock.move.line'">
                      <t t-set="qty_show" t-value="(l.move_id and l.move_id.product_uom_qty) or 0.0"/>
                      <t t-if="l.product_uom_id and l.move_id and l.move_id.product_uom and l.product_uom_id.id != l.move_id.product_uom.id">
                        <t t-set="qty_show" t-value="l.move_id.product_uom._compute_quantity(l.move_id.product_uom_qty or 0.0, l.product_uom_id)"/>
                      </t>
                    </t>

                    <!-- unit_price & vat% -->
                    <t t-set="unit_price" t-value="0.0"/>
                    <t t-set="line_tax_percent" t-value="0.0"/>
                    <t t-if="l._name == 'stock.move'">
                      <t t-set="unit_price" t-value="(l.sale_line_id and l.sale_line_id.price_unit) or 0.0"/>
                      <t t-if="l.sale_line_id and l.sale_line_id.tax_id">
                        <t t-set="line_tax_percent" t-value="l.sale_line_id.tax_id[0].amount or 0.0"/>
                      </t>
                    </t>
                    <t t-elif="l._name == 'stock.move.line'">
                      <t t-set="unit_price" t-value="(l.move_id and l.move_id.sale_line_id and l.move_id.sale_line_id.price_unit) or 0.0"/>
                      <t t-if="l.move_id and l.move_id.sale_line_id and l.move_id.sale_line_id.tax_id">
                        <t t-set="line_tax_percent" t-value="l.move_id.sale_line_id.tax_id[0].amount or 0.0"/>
                      </t>
                    </t>

                    <!-- totals -->
                    <t t-set="line_total" t-value="(qty_show or 0.0) * (unit_price or 0.0)"/>
                    <t t-set="line_tax_value" t-value="(line_total * (line_tax_percent or 0.0) / 100.0)"/>

                    <t t-if="qty_show &gt; 0">
                      <t t-set="total_untaxed" t-value="total_untaxed + line_total"/>
                      <t t-set="total_tax" t-value="total_tax + line_tax_value"/>

                      <tr>
                        <td class="fs-table-content col-stt"><t t-esc="idx + 1"/></td>
                        <td class="fs-table-content col-name" style="padding:3px 5px;">
                          <span t-esc="l.product_id and l.product_id.display_name or ''"/>
                          <t t-if="l._name == 'stock.move' and l.description_picking and (not l.product_id or l.description_picking not in (l.product_id.display_name or ''))">
                            <div style="color:#444;" class="fs-table-content" t-esc="l.description_picking"/>
                          </t>
                        </td>
                        <td class="fs-table-content col-uom">
                          <t t-if="l._name == 'stock.move.line'">
                            <span t-esc="(l.product_uom_id and l.product_uom_id.name) or (l.product_id and l.product_id.uom_id and l.product_id.uom_id.name) or ''"/>
                          </t>
                          <t t-else="">
                            <span t-esc="(l.product_uom and l.product_uom.name) or (l.product_id and l.product_id.uom_id and l.product_id.uom_id.name) or ''"/>
                          </t>
                        </td>
                        <td class="fs-table-content col-qty"><span t-esc="'%0.2f' % qty_show"/></td>
                        <td class="fs-table-content col-price"><span t-esc="'{:,.0f}'.format(unit_price or 0.0).replace(',', '.')"/></td>
                        <td class="fs-table-content col-vatp"><span t-esc="'%s' % (line_tax_percent or 0.0)"/></td>
                        <td class="fs-table-content col-vat"><span t-esc="'{:,.0f}'.format(line_tax_value or 0.0).replace(',', '.')"/></td>
                        <td class="fs-table-content col-amt"><span t-esc="'{:,.0f}'.format(line_total or 0.0).replace(',', '.')"/></td>
                        <td class="fs-table-content col-wh"><span t-esc="warehouse_name"/></td>
                      </tr>

                      <t t-set="idx" t-value="idx + 1"/>
                    </t>
                  </t>

                  <!-- No lines -->
                  <t t-if="idx == 0">
                    <tr>
                      <td class="fs-table-content" colspan="9" style="text-align:center;font-style:italic;">
                        Không có dòng hàng.
                      </td>
                    </tr>
                  </t>

                  <!-- 3 hàng tổng -->
                  <tr>
                    <!-- Gộp trái: STT..SL (4 cột), rowspan 3 -->
                    <td colspan="4" rowspan="3" style="background:#eee;"></td>
                    <!-- Nhãn tổng: gộp 3 cột (Đơn giá + VAT% + Thuế VAT) -->
                    <td class="fs-table-total" colspan="3" style="text-align:left;">Tổng tiền hàng (VNĐ)</td>
                    <!-- Giá trị tổng: cột Thành tiền -->
                    <td class="fs-table-total" style="text-align:right;">
                      <span t-esc="'{:,.0f}'.format(total_untaxed or 0.0).replace(',', '.')"/>
                    </td>
                    <!-- Kho xuất: rowspan 3, trống xám -->
                    <td rowspan="3" style="background:#eee;"></td>
                  </tr>
                  <tr>
                    <td class="fs-table-total" colspan="3" style="text-align:left;">Tổng thuế VAT (VNĐ)</td>
                    <td class="fs-table-total" style="text-align:right;">
                      <span t-esc="'{:,.0f}'.format(total_tax or 0.0).replace(',', '.')"/>
                    </td>
                  </tr>
                  <tr>
                    <td class="fs-table-total" colspan="3" style="text-align:left;">Tổng tiền thanh toán (VNĐ)</td>
                    <td class="fs-table-total" style="text-align:right;">
                      <span t-esc="'{:,.0f}'.format((total_untaxed + total_tax) or 0.0).replace(',', '.')"/>
                    </td>
                  </tr>
                  <tr>
                    <td class="fs-table-total" colspan="4" style="background:#eee;">Thành tiền thanh toán (Bằng chữ):</td>
                    <td class="fs-table-total" colspan="5" style="background:#eee;text-align:center;">
                      <span t-esc="env['hlv.amount'].amount_to_text_vn((total_untaxed + total_tax) or 0.0)"/>
                    </td>
                  </tr>
                </tbody>
              </table>

              <!-- Chữ ký -->
              <table class="sig mt-8">
                <tr>
                  <td class="fs-signature">Người nhận hàng</td>
                  <td class="fs-signature">Người kiểm hàng</td>
                  <td class="fs-signature">Người tạo phiếu</td>
                </tr>
                <tr>
                  <td style="height:72px;"></td>
                  <td style="height:72px;"></td>
                  <td style="height:72px;"></td>
                </tr>
              </table>

              <!-- Footer -->
              <div class="fs-footer" style="position:fixed;bottom:16px;left:0;width:100%;text-align:center;margin-top:8px;">
                PHÂN PHỐI CHÍNH HÃNG: SKF-NSK-KOYO-NTN-ASAHI-IKO-MITSUBOSHI-LS-HANYOUNG-BOSCH-MILWAUKEE-MAKITA
              </div>
            </div>
          </t>
        </div>

      </t>
    </t>
  </template>

</odoo>
