<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bbgn_a4_khongngay" model="ir.actions.report">
        <field name="name">BBGN A4 Không Ngày</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hlv_a4_report.bbgn_a4_khongngay_doc</field>
        <field name="print_report_name">'BBGN A4 Không Ngày - %s' % (object.name or "Picking")</field>
        <field name="binding_model_id" ref="stock.model_stock_picking" />
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="hlv_a4_report.paperformat_hlv_a4_portrait" />
    </record>

    <template id="bbgn_a4_khongngay_doc">
        <t t-call="web.external_layout">
            <main>
                <t t-foreach="docs" t-as="o">
                    <div class="page">
                        <style type="text/css">
                            .bbgn * { font-family: 'HLV-TNR', Times, 'Times New Roman', serif
                            !important; font-size: 14px; }
                            .bbgn .tbl { width: 100%; border-collapse: collapse; }
                            .bbgn .tbl th, .bbgn .tbl td { border: 1px solid #000; padding: 6px; }
                            .bbgn .th-center { text-align: center; }
                        </style>

                        <div class="bbgn">
                            <!-- Header công ty -->
                            <table style="width:100%; margin-top: 10px;">
                                <tr>
                                    <td
                                        style="width:220px; text-align:center; vertical-align:middle; padding-right:5px">
                                        <t t-if="o.company_id.logo">
                                            <img t-att-src="image_data_uri(o.company_id.logo)"
                                                style="max-height:150px; height:130px; width:180px; object-fit:contain;" />
                                        </t>
                                        <t t-else="">
                                            <img
                                                t-att-src="'/web/image/res.company/%s/logo' % o.company_id.id"
                                                style="max-height:150px; height:130px; width:180px; object-fit:contain;" />
                                        </t>
                                    </td>
                                    <td style="vertical-align:top; padding-left:10px;">
                                        <div style="font-weight:700; font-size:16px;"
                                            t-esc="o.company_id.name" />
                                        <div>
                                            <t t-set="addr"
                                                t-value="o.company_id.partner_id._display_address(without_company=True) or ''" />
                                            <t t-foreach="addr.splitlines()" t-as="line">
                                                <t t-esc="line" />
                                                <br />
                                            </t>
                                        </div>
                                        <div>Mã số thuế: <span t-esc="o.company_id.vat or ''" /></div>
                                        <div>Website: <span t-esc="o.company_id.website or ''" /></div>
                                    </td>
                                </tr>
                            </table>

                            <!-- Tiêu đề -->
                            <div style="text-align:center; margin-top: 6px;">
                                <div style="font-size:20px; font-weight:800;">BIÊN BẢN BÀN GIAO</div>
                                <div> (Số phiếu xuất: <span t-esc="o.name" /> – ngày ... tháng ...
                                    năm ...) </div>
                            </div>

                            <!-- Hai bên -->
                            <table style="width:100%; margin-top:10px;">
                                <tr>
                                    <td style="width:220px; font-weight:600;">Đại diện bên nhận (A)</td>
                                    <td style="font-weight:700;"
                                        t-esc="o.partner_id.commercial_partner_id.name or ''" />
                                </tr>
                                <tr>
                                    <td>Ông (Bà)</td>
                                    <td></td>
                                </tr>
                                <tr>
                                    <td>Địa chỉ</td>
                                    <td>
                                        <t t-set="p"
                                            t-value="o.partner_id and o.partner_id.commercial_partner_id or o.partner_id" />
                                        <t
                                            t-esc="(p.street or '') + (p.street2 and (', ' + p.street2) or '')" />
                                    </td>
                                </tr>

                                <tr>
                                    <td style="padding-top:6px; font-weight:600;">Đại diện bên giao
                                        (B)</td>
                                    <td style="padding-top:6px; font-weight:700;"
                                        t-esc="o.company_id.name" />
                                </tr>
                                <tr>
                                    <td>Ông (Bà)</td>
                                    <td></td>
                                </tr>
                                <tr>
                                    <td>Địa chỉ</td>
                                    <td>
                                        <t t-set="addr_b"
                                            t-value="o.company_id.partner_id._display_address(without_company=True) or ''" />
                                        <t t-foreach="addr_b.splitlines()" t-as="line">
                                            <t t-esc="line" />
                                            <br />
                                        </t>
                                    </td>
                                </tr>
                            </table>

                            <div style="margin:15px 0 6px 0; font-weight:700">Bên B đã bàn giao cho
                                bên A:</div>

                            <!-- Chọn nguồn dữ liệu -->
                            <t t-set="is_done" t-value="o.state == 'done'" />
                            <!-- Nếu done: in theo move line; nếu chưa: in theo move -->
                            <t t-set="lines" t-value="is_done and o.move_line_ids or o.move_ids" />

                            <!-- Bảng hàng hóa -->
                            <table class="tbl" style="margin-top:6px; font-size:13px;">
                                <thead>
                                    <tr>
                                        <th class="th-center" style="width:40px;">STT</th>
                                        <th>Tên hàng</th>
                                        <th class="th-center" style="width:120px;">Đơn vị tính</th>
                                        <th class="th-center" style="width:120px;">Số lượng</th>
                                        <th class="th-center" style="width:160px;">Ghi chú</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="idx" t-value="0" />
                                    <t t-foreach="lines" t-as="l">
                                        <!-- Tính qty_show + UoM hiển thị -->
                                        <t t-if="is_done">
                                            <!-- move line -->
                                            <t t-set="qty_show" t-value="l.qty_done or 0.0" />
                                            <t t-set="uom_name"
                                                t-value="(l.product_uom_id and l.product_uom_id.name) or (l.product_id.uom_id and l.product_id.uom_id.name) or ''" />
                                        </t>
                                        <t t-else="">
                                            <!-- move -->
                                            <t t-set="qty_show" t-value="l.product_uom_qty or 0.0" />
                                            <t t-set="uom_name"
                                                t-value="(l.product_uom and l.product_uom.name) or (l.product_id.uom_id and l.product_id.uom_id.name) or ''" />
                                        </t>

                                        <t t-if="qty_show &gt; 0">
                                            <tr>
                                                <td class="th-center">
                                                    <t t-esc="idx + 1" />
                                                </td>
                                                <td>
                                                    <span t-esc="l.product_id.display_name or ''" />
                                                    <t
                                                        t-if="(not is_done) and l.description_picking and (not l.product_id or l.description_picking not in (l.product_id.display_name or ''))">
                                                        <div style="font-size:12px; color:#444;"
                                                            t-esc="l.description_picking" />
                                                    </t>
                                                </td>
                                                <td class="th-center">
                                                    <t t-esc="uom_name" />
                                                </td>
                                                <td class="th-center">
                                                    <t t-esc="'%0.2f' % qty_show" />
                                                </td>
                                                <td></td>
                                            </tr>
                                            <t t-set="idx" t-value="idx + 1" />
                                        </t>
                                    </t>

                                    <t t-if="idx == 0">
                                        <tr>
                                            <td colspan="5"
                                                style="padding:8px; text-align:center; font-style:italic;">
                                                Không có dòng hàng.
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>

                            <!-- Chữ ký -->
                            <table style="width:100%; margin-top:24px; text-align:center;">
                                <tr>
                                    <td style="width:50%; font-weight:700;">ĐẠI DIỆN BÊN NHẬN<br />(Ký,
                                        họ tên)</td>
                                    <td style="width:50%; font-weight:700;">ĐẠI DIỆN BÊN GIAO<br />(Ký,
                                        họ tên)</td>
                                </tr>
                                <tr>
                                    <td style="height:100px;"></td>
                                    <td style="height:100px;"></td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </t>
            </main>
        </t>
    </template>
</odoo>