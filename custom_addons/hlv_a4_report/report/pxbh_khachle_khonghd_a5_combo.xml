<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Action report: PXBH Khách lẻ không hóa đơn - A5 COMBO (Landscape) -->
  <record id="report_pxbh_khachle_khonghd_a5_combo" model="ir.actions.report">
    <field name="name">PXBH Khách lẻ không hóa đơn A5</field>
    <field name="model">stock.picking</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">hlv_a4_report.report_pxbh_khachle_khonghd_a5_combo_doc</field>
    <field name="print_report_name">
      'Phiếu Xuất Kho Kiêm Bán Hàng - Khách Lẻ Không Hóa Đơn (A5) - %s' % (object.name or 'Picking')
    </field>
    <field name="binding_model_id" ref="stock.model_stock_picking"/>
    <field name="binding_type">report</field>
    <!-- Trỏ paperformat A5 landscape đã có -->
    <field name="paperformat_id" ref="hlv_a4_report.paperformat_hlv_a5_landscape"/>
  </record>

  <!-- Template: PXBH Khách lẻ không hóa đơn - A5 Landscape COMBO -->
  <template id="report_pxbh_khachle_khonghd_a5_combo_doc">
    <t t-call="web.html_container">
      <t t-call="web.report_layout">
        <style type="text/css">
          /* ====== Fonts riêng A5 ====== */
          @font-face{font-family:'HLV-TNR';src:url('/hlv_a4_report/static/fonts/times-new-roman.ttf') format('truetype');font-weight:400;font-style:normal;font-display:swap;}
          @font-face{font-family:'HLV-TNR';src:url('/hlv_a4_report/static/fonts/times-new-roman-bold.ttf') format('truetype');font-weight:700;font-style:normal;font-display:swap;}
          @font-face{font-family:'HLV-TNR';src:url('/hlv_a4_report/static/fonts/times-new-roman-italic.ttf') format('truetype');font-weight:400;font-style:italic;font-display:swap;}
          @font-face{font-family:'HLV-TNR';src:url('/hlv_a4_report/static/fonts/times-new-roman-bolditalic.ttf') format('truetype');font-weight:700;font-style:italic;font-display:swap;}

          /* Base A5 landscape (210x148mm, lề 5mm) */
          html, body, .o_report_layout, .o_report_layout *{
            font-family:'HLV-TNR','DejaVu Serif','Liberation Serif',serif !important;
            font-size:11px !important;
            font-synthesis:none;
          }
          em,i{font-style:italic!important;font-weight:400!important;}
          strong em,strong i,b em,b i{font-style:italic!important;font-weight:700!important;}

          /* Sizes */
          .fs-company-name{font-size:13px!important;font-weight:700;}
          .fs-company-info{font-size:10px!important;}
          .fs-title{font-size:14px!important;font-weight:700;}
          .fs-subtitle{font-size:10.5px!important;}
          .fs-customer-info{font-size:10.5px!important;}
          .fs-table-header{font-size:10.5px!important;font-weight:600;}
          .fs-table-content{font-size:10.5px!important;}
          .fs-table-total{font-size:10.5px!important;font-weight:600;}
          .fs-note{font-size:10.5px!important;font-style:italic;}
          .fs-signature{font-size:10.5px!important;}
          .fs-footer{font-size:9px!important;}

          table{border-collapse:collapse;width:100%;}
          .mt-2{margin-top:2px;} .mt-4{margin-top:4px;} .mt-6{margin-top:6px;} .mt-8{margin-top:8px;} .mt-10{margin-top:10px;}

          /* Header */
          .hdr-logo{width:165px;text-align:center;vertical-align:middle;padding-right:6px;}
          .hdr-logo img{max-height:90px;height:80px;width:140px;object-fit:contain;position:relative;top:-8px;}
          .hdr-info{vertical-align:top;padding-left:8px;}

          /* Bảng hàng hóa A5 */
          .tbl th,.tbl td{border:1px solid #000;}
          .tbl th{background:#eee;text-align:center;}

          /* Cột: thu gọn để vừa A5 */
          .col-stt{width:26px;text-align:center;white-space:nowrap;}
          .col-name{width:auto;}
          .col-uom{width:48px;text-align:center;white-space:nowrap;}
          .col-qty{width:52px;text-align:center;white-space:nowrap;}
          .col-price{width:78px;text-align:right;white-space:nowrap;}
          .col-amt{width:86px;text-align:right;white-space:nowrap;}
          .col-wh{width:86px;text-align:center;white-space:nowrap;}

          /* Chữ ký 2 cột */
          .sig td{width:50%;vertical-align:top;}
        </style>

        <div class="page">
          <t t-foreach="docs" t-as="o">
            <!-- COMBO: Lấy stock.picking -->
            <t t-set="so" t-value="o"/>

            <div class="page">

              <!-- Header công ty -->
              <table class="mt-10">
                <tr>
                  <td class="hdr-logo">
                    <t t-if="o.company_id.logo">
                      <img t-att-src="image_data_uri(o.company_id.logo)"/>
                    </t>
                    <t t-else="">
                      <img t-att-src="'/web/image/res.company/%s/logo' % o.company_id.id"/>
                    </t>
                  </td>
                  <td class="hdr-info">
                    <div class="fs-company-name">CÔNG TY TNHH VI NA HOÀNG LONG VŨ</div>
                    <div class="fs-company-info">
                      Địa chỉ:
                      <t t-esc="o.company_id.partner_id._display_address(without_company=True).replace('\n',' ') or ''"/>
                    </div>
                    <table class="mt-2" style="width:100%;">
                      <tr>
                        <td class="fs-company-info" style="padding:0 6px 0 0;white-space:nowrap;">Điện thoại:</td>
                        <td class="fs-company-info" style="padding:0 8px 0 0;"><t t-esc="o.company_id.phone or ''"/></td>
                        <td class="fs-company-info" style="padding:0;white-space:nowrap;">Di động:</td>
                        <td class="fs-company-info"><t t-esc="o.company_id.mobile or o.company_id.partner_id.mobile or ''"/></td>
                      </tr>
                      <tr>
                        <td class="fs-company-info" style="padding:2px 6px 0 0;white-space:nowrap;">Email:</td>
                        <td class="fs-company-info" style="padding:2px 8px 0 0;"><t t-esc="o.company_id.email or ''"/></td>
                        <td class="fs-company-info" style="padding:2px 6px 0 0;white-space:nowrap;">Website:</td>
                        <td class="fs-company-info" style="padding-top:2px;"><t t-esc="o.company_id.website or ''"/></td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <!-- Tiêu đề -->
              <div style="text-align:center;" class="mt-2">
                <div class="fs-title">PHIẾU XUẤT KHO KIÊM BÁN HÀNG</div>
                <t t-set="dt_src" t-value="o.date_order or o.create_date or datetime.datetime.now()"/>
                <div class="fs-subtitle">
                  (Số phiếu xuất: <span t-esc="o.name"/>; ngày: <t t-esc="dt_src.strftime('%d/%m/%Y')"/>)
                </div>
              </div>

              <!-- Thông tin KH -->
              <table class="mt-6">
                <t t-set="warehouse_name" t-value="(o.warehouse_id and o.warehouse_id.name) or ''"/>
                <t t-set="khachle_label" t-value="'KHÁCH LẺ CỬA HÀNG %s' % warehouse_name"/>
                <tr>
                  <td class="fs-customer-info" style="width:120px;white-space:nowrap;">Khách hàng:</td>
                  <td class="fs-customer-info"><span t-esc="khachle_label"/></td>
                </tr>
                <tr>
                  <td class="fs-customer-info" style="white-space:nowrap;">Địa chỉ:</td>
                  <td class="fs-customer-info"></td>
                </tr>
                <tr>
                  <td class="fs-customer-info" style="white-space:nowrap;">SĐT người nhận:</td>
                  <td class="fs-customer-info"><span t-esc="khachle_label"/></td>
                </tr>
              </table>

              <div class="fs-note mt-4">Cảm ơn quý khách hàng đã quan tâm sản phẩm Hoàng Long Vũ, chúng tôi rất hân hạnh được phục vụ quý khách</div>

              <!-- COMBO: Lấy dữ liệu từ helper với picking -->
              <t t-set="enriched_lines" t-value="env['hlv.report.helper'].get_enriched_lines_for_picking_combo(picking)"/>
              <t t-set="total_untaxed" t-value="0.0"/>

              <!-- Bảng hàng hóa -->
              <table class="tbl mt-6">
                <thead>
                  <tr>
                    <th class="fs-table-header col-stt">STT</th>
                    <th class="fs-table-header col-name">Tên hàng</th>
                    <th class="fs-table-header col-uom">DVT</th>
                    <th class="fs-table-header col-qty">SL</th>
                    <th class="fs-table-header col-price">Đơn giá</th>
                    <th class="fs-table-header col-amt">Thành tiền</th>
                    <th class="fs-table-header col-wh">Kho xuất</th>
                  </tr>
                </thead>
                <tbody>
                  <t t-set="idx" t-value="1"/>
                  <t t-foreach="enriched_lines" t-as="line_data">
                    <!-- Sử dụng dữ liệu từ helper -->
                    <t t-set="is_child" t-value="line_data['is_combo_child']"/>
                    <t t-set="qty_show" t-value="line_data['qty']"/>
                    <t t-set="unit_price" t-value="line_data['price_unit']"/>
                    <t t-set="line_total" t-value="(qty_show or 0.0) * (unit_price or 0.0)"/>

                    <t t-if="qty_show &gt; 0 and line_data['type'] != 'parent'">
                      <t t-set="total_untaxed" t-value="total_untaxed + line_total"/>

                      <tr>
                        <td class="fs-table-content col-stt">
                          <t t-if="line_data['type'] == 'parent'">
                            <t t-esc="idx"/>
                            <t t-set="idx" t-value="idx + 1"/>
                          </t>
                        </td>
                        <td class="fs-table-content col-name" style="padding:3px 5px;">
                          <t t-if="is_child">
                            <span style="padding-left:24px;">
                              <t t-esc="line_data['product_name']"/>
                            </span>
                          </t>
                          <t t-else="">
                            <span t-esc="line_data['product_name']"/>
                          </t>
                        </td>
                        <td class="fs-table-content col-uom">
                          <span t-esc="line_data['uom']"/>
                        </td>
                        <td class="fs-table-content col-qty"><span t-esc="'%0.2f' % qty_show"/></td>
                        <td class="fs-table-content col-price"><span t-esc="'{:,.0f}'.format(unit_price or 0.0).replace(',', '.')"/></td>
                        <td class="fs-table-content col-amt"><span t-esc="'{:,.0f}'.format(line_total or 0.0).replace(',', '.')"/></td>
                        <td class="fs-table-content col-wh"><span t-esc="warehouse_name"/></td>
                      </tr>
                    </t>
                  </t>

                  <!-- Không có dòng -->
                  <t t-if="not enriched_lines">
                    <tr>
                      <td class="fs-table-content" colspan="7" style="text-align:center;font-style:italic;">
                        Không có dòng hàng.
                      </td>
                    </tr>
                  </t>

                  <!-- 3 hàng tổng (giữ cấu trúc A4, co chiều rộng) -->
                  <tr>
                    <!-- Gộp trái: STT -> DVT (3 cột), rowspan 3 -->
                    <td colspan="3" rowspan="3" style="background:#eee;"></td>
                    <!-- Nhãn tổng: gộp SL + Đơn giá (2 cột) -->
                    <td class="fs-table-total" colspan="2" style="text-align:left;">Tổng tiền hàng (VNĐ)</td>
                    <!-- Thành tiền -->
                    <td class="fs-table-total" style="text-align:right;">
                      <span t-esc="'{:,.0f}'.format(total_untaxed or 0.0).replace(',', '.')"/>
                    </td>
                    <!-- Kho xuất: rowspan 3, trống xám -->
                    <td rowspan="3" style="background:#eee;"></td>
                  </tr>
                  <tr>
                    <td class="fs-table-total" colspan="2" style="text-align:left;">Tổng thuế VAT (VNĐ)</td>
                    <td class="fs-table-total" style="text-align:right;"></td>
                  </tr>
                  <tr>
                    <td class="fs-table-total" colspan="2" style="text-align:left;">Tổng tiền thanh toán (VNĐ)</td>
                    <td class="fs-table-total" style="text-align:right;">
                      <span t-esc="'{:,.0f}'.format(total_untaxed or 0.0).replace(',', '.')"/>
                    </td>
                  </tr>
                  <tr>
                    <td class="fs-table-total" colspan="4" style="background:#eee;">Thành tiền thanh toán (Bằng chữ):</td>
                    <td class="fs-table-total" colspan="3" style="background:#eee;text-align:center;">
                      <span t-esc="env['hlv.amount'].amount_to_text_vn(total_untaxed)"/>
                    </td>
                  </tr>
                </tbody>
              </table>

              <!-- Chữ ký -->
              <t t-set="khachle_label" t-value="'KHÁCH LẺ CỬA HÀNG %s' % warehouse_name"/>
              <table class="sig mt-8">
                <tr>
                  <td class="fs-signature" style="padding-left:24px;">Người nhận hàng</td>
                  <td class="fs-signature" style="padding-right:24px;text-align:right;">
                    <span t-esc="khachle_label"/>
                  </td>
                </tr>
                <tr>
                  <td style="height:72px;"></td>
                  <td style="height:72px;"></td>
                </tr>
              </table>

              <!-- Footer -->
              <div class="fs-footer" style="position:fixed;bottom:16px;left:0;width:100%;text-align:center;margin-top:8px;">
                PHÂN PHỐI CHÍNH HÃNG: SKF-NSK-KOYO-NTN-ASAHI-IKO-MITSUBOSHI-LS-HANYOUNG-BOSCH-MILWAUKEE-MAKITA
              </div>

            </div>
          </t>
        </div>

      </t>
    </t>
  </template>

</odoo>
