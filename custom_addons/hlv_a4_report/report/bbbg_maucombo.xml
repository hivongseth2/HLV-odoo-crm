<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Action report -->
    <record id="bbbg_a4_co_po" model="ir.actions.report">
        <field name="name">BBBG COMBO</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <!-- trỏ đúng template -->
        <field name="report_name">hlv_a4_report.bbbg_combo_doc</field>
        <field name="print_report_name">
            'BBBG COMBO - %s' % (object.name or 'Picking')
        </field>
        <field name="binding_model_id" ref="sale.model_sale_order" />
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="hlv_a4_report.paperformat_hlv_a4_portrait" />
    </record>

    <template id="bbbg_combo_doc">
        <t t-call="web.html_container">
            <t t-call="web.report_layout">
                <style type="text/css">
                    @font-face{font-family:'HLV-TNR';src:url('/hlv_a4_report/static/fonts/times-new-roman.ttf')
                    format('truetype');font-weight:400;font-style:normal;font-display:swap;}
                    @font-face{font-family:'HLV-TNR';src:url('/hlv_a4_report/static/fonts/times-new-roman-bold.ttf')
                    format('truetype');font-weight:700;font-style:normal;font-display:swap;}
                    @font-face{font-family:'HLV-TNR';src:url('/hlv_a4_report/static/fonts/times-new-roman-italic.ttf')
                    format('truetype');font-weight:400;font-style:italic;font-display:swap;}
                    @font-face{font-family:'HLV-TNR';src:url('/hlv_a4_report/static/fonts/times-new-roman-bolditalic.ttf')
                    format('truetype');font-weight:700;font-style:italic;font-display:swap;}
                    html, body, .o_report_layout, .o_report_layout * { font-family:'HLV-TNR','DejaVu
                    Sans',sans-serif !important; }
                    .hlv-title{font-weight:700;}
                    table { border-collapse: collapse; }
                </style>

                <t t-foreach="docs" t-as="so">
                    <!-- Nguồn ngày -->
                    <t t-set="dt_src" t-value="so.date_order or so.create_date" />
                    <t t-if="dt_src">
                        <t t-set="d_str" t-value="dt_src.strftime('%d')" />
                        <t t-set="m_str" t-value="dt_src.strftime('%m')" />
                        <t t-set="y_str" t-value="dt_src.strftime('%Y')" />
                    </t>
                    <t t-else="">
                        <t t-set="d_str" t-value="datetime.datetime.now().strftime('%d')" />
                        <t t-set="m_str" t-value="datetime.datetime.now().strftime('%m')" />
                        <t t-set="y_str" t-value="datetime.datetime.now().strftime('%Y')" />
                    </t>

                    <!-- Dòng hàng hóa: lấy từ sale.order.line -->
                    <t t-set="lines" t-value="so.order_line" />

                    <div class="page">

                        <!-- Header công ty -->
                        <table style="width:100%; margin-top:30px">
                            <tr>
                                <td
                                    style="width:220px; text-align:center; vertical-align:middle; padding-right:5px">
                                    <t t-if="so.company_id.logo">
                                        <img t-att-src="image_data_uri(so.company_id.logo)"
                                            style="max-height:150px; position:relative; top:-20px; height:130px; width:180px; object-fit:contain;" />
                                    </t>
                                    <t t-else="">
                                        <img
                                            t-att-src="'/web/image/res.company/%s/logo' % so.company_id.id"
                                            style="max-height:150px; height:150px; width:120px;" />
                                    </t>
                                </td>

                                <td style="vertical-align:top; padding-left:10px;">
                                    <div style="font-weight:700; font-size:16px;">CÔNG TY TNHH VI NA
                                        HOÀNG LONG VŨ</div>
                                    <div>
                                        <t t-set="addr"
                                            t-value="so.company_id.partner_id._display_address(without_company=True) or ''" />
                                        <t t-foreach="addr.split(' - ')" t-as="line">
                                            <t t-esc="line" />
                                            <br />
                                        </t>
                                    </div>
                                    <div>Mã số thuế: <span t-esc="so.company_id.vat or ''" />
                                    </div>
                                    <div>Website: <span t-esc="so.company_id.website or ''" />
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- Tiêu đề -->
                        <div style="text-align:center; margin-top:-5px">
                            <div style="font-size:20px; font-weight:800;">BIÊN BẢN BÀN GIAO</div>
                            <div>(Số phiếu xuất: <span t-esc="so.name" /> – ngày <t t-esc="d_str" />
                                tháng <t t-esc="m_str" /> năm <t t-esc="y_str" /> )</div>
                        </div>

                        <!-- Hai bên -->
                        <table style="width:100%; font-size:13px; margin-top:10px;">
                            <tr>
                                <td style="width:180px; font-weight:600;">Đại diện bên nhận (A)</td>
                                <td style="font-weight:700;"
                                    t-esc="so.partner_id and so.partner_id.commercial_partner_id.name or ''" />
                            </tr>
                            <tr>
                                <td>Ông (Bà)</td>
                                <td />
                            </tr>
                            <tr>
                                <td>Địa chỉ</td>
                                <td class="h6-fs" style="width:379.875px;">
                                    <t t-set="p"
                                        t-value="so.partner_id and so.partner_id.commercial_partner_id or so.partner_id" />
                                    <t
                                        t-esc="(p.street or '') + (p.street2 and (', ' + p.street2) or '')" />
                                </td>
                            </tr>
                            <tr>
                                <td style="padding-top:6px; font-weight:600;">Đại diện bên giao (B)</td>
                                <td style="padding-top:6px; font-weight:700;">CÔNG TY TNHH VI NA
                                    HOÀNG LONG VŨ</td>
                            </tr>
                            <tr>
                                <td>Ông (Bà)</td>
                                <td />
                            </tr>
                            <tr>
                                <td class="label">Địa chỉ</td>
                                <td>
                                    <t t-set="addr_b"
                                        t-value="so.company_id.partner_id._display_address(without_company=True) or ''" />
                                    <t t-foreach="addr_b.split(' - ')" t-as="line">
                                        <t t-esc="line" />
                                        <br />
                                    </t>
                                </td>
                            </tr>
                        </table>

                        <div style="margin:15px 15px 6px 0; font-weight:700">Bên B đã bàn giao cho
                            bên A:</div>

                        <!-- Bảng hàng hóa -->
                        <table style="width:100%; border-collapse:collapse; margin-top:6px; font-size:13px;">
                            <thead>
                                <tr>
                                    <th style="border:1px solid #000; padding:6px; width:40px; text-align:center;">STT</th>
                                    <th style="border:1px solid #000; padding:6px;">Tên hàng</th>
                                    <th style="border:1px solid #000; padding:6px; width:120px; text-align:center;">Đơn vị tính</th>
                                    <th style="border:1px solid #000; padding:6px; width:120px; text-align:center;">Số lượng</th>
                                    <th style="border:1px solid #000; padding:6px; width:160px; text-align:center;">Ghi chú</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="idx" t-value="1" />
                                <t t-foreach="lines" t-as="l">
                                    <t t-set="is_child" t-value="l.x_studio_is_combo_child" />
                                    <t t-set="qty_show" t-value="l.product_uom_qty or 0.0" />
                                    <t t-if="qty_show &gt; 0">
                                        <tr>
                                            <td style="border:1px solid #000; padding:6px; text-align:center;">
                                                <t t-if="not is_child">
                                                    <t t-esc="idx" />
                                                    <t t-set="idx" t-value="idx + 1" />
                                                </t>
                                            </td>
                                            <td style="border:1px solid #000; padding:6px;">
                                                <t t-if="is_child">
                                                    <span style="padding-left:24px;">&#8627; <t t-esc="l.product_id and l.product_id.display_name or ''" /></span>
                                                </t>
                                                <t t-else="">
                                                    <span t-esc="l.product_id and l.product_id.display_name or ''" />
                                                </t>
                                            </td>
                                            <td style="border:1px solid #000; padding:6px; text-align:center;">
                                                <span t-esc="l.product_uom and l.product_uom.name or (l.product_id and l.product_id.uom_id and l.product_id.uom_id.name) or ''" />
                                            </td>
                                            <td style="border:1px solid #000; padding:6px; text-align:center;">
                                                <span t-esc="'%0.2f' % qty_show" />
                                            </td>
                                            <td style="border:1px solid #000; padding:6px;">
                                                <t t-esc="so.origin or ''" />
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                                <t t-if="lines | length == 0">
                                    <tr>
                                        <td colspan="5" style="border:1px solid #000; padding:8px; text-align:center; font-style:italic;">
                                            Không có dòng hàng.
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Chữ ký -->
                        <table style="width:100%; margin-top:24px; text-align:center;">
                            <tr>
                                <td style="width:50%; font-weight:700;">ĐẠI DIỆN BÊN NHẬN<br /> (Ký,
                                    họ tên)</td>
                                <td style="width:50%; font-weight:700;">ĐẠI DIỆN BÊN GIAO<br /> (Ký,
                                    họ tên)</td>
                            </tr>
                            <tr>
                                <td style="height:100px;" />
                                <td style="height:100px;" />
                            </tr>
                        </table>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>