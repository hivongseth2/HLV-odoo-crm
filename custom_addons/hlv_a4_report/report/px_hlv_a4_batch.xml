<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action report: Phiếu xuất kho theo lô - Batch Picking -->
    <record id="report_px_hlv_a4_batch" model="ir.actions.report">
        <field name="name">Phiếu xuất kho theo lô - A4</field>
        <field name="model">stock.picking.batch</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hlv_a4_report.report_px_hlv_a4_batch_doc</field>
        <field name="print_report_name">
            'Phiếu xuất kho theo lô - A4 - %s' % (object.name or 'Batch')
        </field>
    <field name="binding_model_id" ref="stock_picking_batch.model_stock_picking_batch"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="hlv_a4_report.paperformat_hlv_a4_portrait" />
    </record>

    <!-- Template -->
    <template t-name="hlv_a4_report.report_px_hlv_a4_batch_doc">
        <t t-call="web.html_container">
            <t t-call="web.report_layout">
                <style type="text/css">
                    @font-face{
                        font-family:'HLV-TNR';
                        src:url('/hlv_a4_report/static/fonts/times-new-roman.ttf') format('truetype');
                        font-weight:400; font-style:normal; font-display:swap;
                    }
                    @font-face{
                        font-family:'HLV-TNR';
                        src:url('/hlv_a4_report/static/fonts/times-new-roman-bold.ttf') format('truetype');
                        font-weight:700; font-style:normal; font-display:swap;
                    }
                    @font-face{
                        font-family:'HLV-TNR';
                        src:url('/hlv_a4_report/static/fonts/times-new-roman-italic.ttf') format('truetype');
                        font-weight:400; font-style:italic; font-display:swap;
                    }
                    @font-face{
                        font-family:'HLV-TNR';
                        src:url('/hlv_a4_report/static/fonts/times-new-roman-bolditalic.ttf') format('truetype');
                        font-weight:700; font-style:italic; font-display:swap;
                    }
                    html, body, .o_report_layout, .o_report_layout * {
                        font-family:'HLV-TNR','DejaVu Serif','Liberation Serif',serif !important;
                        font-size:12px !important;
                        font-synthesis:none;
                    }
                    .fs-company-name { font-size:14px !important; font-weight:700; }
                    .fs-company-info { font-size:11px !important; }
                    .fs-title { font-size:14px !important; font-weight:700; }
                    .fs-subtitle { font-size:11px !important; }
                    .fs-customer-info { font-size:11px !important; }
                    .fs-table-header { font-size:11px !important; font-weight:600; }
                    .fs-table-content { font-size:11px !important; }
                    .fs-table-total { font-size:11px !important; font-weight:600; }
                    .fs-note { font-size:11px !important; font-style:italic; }
                    .fs-signature { font-size:11px !important; }
                    .fs-footer { font-size:9px !important; }
                </style>
                <div class="page">
                    <t t-foreach="docs" t-as="batch">
                        <div class="page">
                            <!-- Header công ty -->
                            <table style="width:100%;margin-top:30px">
                                <tr>
                                    <td style="width:220px; text-align:center; vertical-align:middle; padding-right:5px">
                                        <t t-if="batch.company_id.logo">
                                            <img t-att-src="image_data_uri(batch.company_id.logo)" style="max-height:150px; position:relative; top:-20px; height:130px; width:180px; object-fit:contain; text-align:center; vertical-align:middle;"/>
                                        </t>
                                        <t t-else="">
                                            <img t-att-src="'/web/image/res.company/%s/logo' % batch.company_id.id" style="max-height:150px; height:150px; width:120px;"/>
                                        </t>
                                    </td>
                                    <td style="vertical-align:top; padding-left:10px;">
                                        <div class="fs-company-name">
                                            <t>CÔNG TY TNHH VI NA HOÀNG LONG VŨ</t>
                                        </div>
                                        <div class="fs-company-info"> 
                                            Địa chỉ: <t t-esc="batch.company_id.partner_id._display_address(without_company=True).replace('\n',' ') or ''"/>
                                        </div>
                                        <table style="width:100%; margin-top:2px; border-collapse:collapse;">
                                            <tr>
                                                <td class="fs-company-info" style="padding:0 8px 0 0; white-space:nowrap;">Điện thoại:</td>
                                                <td class="fs-company-info" style="padding:0 12px 0 0;">
                                                    <t t-esc="batch.company_id.phone or ''"/>
                                                </td>
                                                <td class="fs-company-info" style="padding:0 0px; white-space:nowrap;">Di động:</td>
                                                <td class="fs-company-info">
                                                    <t t-esc="batch.company_id.mobile or batch.company_id.partner_id.mobile or ''"/>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td class="fs-company-info" style="padding:2px 8px 0 0; white-space:nowrap;">Email:</td>
                                                <td class="fs-company-info" style="padding:2px 12px 0 0;">
                                                    <t t-esc="batch.company_id.email or ''"/>
                                                </td>
                                                <td class="fs-company-info" style="padding:2px 8px 0 0; white-space:nowrap;">Website:</td>
                                                <td class="fs-company-info" style="padding-top:2px;">
                                                    <t t-esc="batch.company_id.website or ''"/>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                            <div style="text-align:center; margin-top:-5px">
                                <div class="fs-title">PHIẾU XUẤT KHO THEO LÔ</div>
                                <t t-set="dt_src" t-value="batch.create_date"/>
                                <div class="fs-subtitle">
                                    (Số lô: <span t-esc="batch.name"/>; ngày:
                                    <t t-if="dt_src"><t t-esc="dt_src.strftime('%d/%m/%Y')"/></t>
                                    <t t-else="">__/__/____</t>)
                                </div>
                            </div>
                            <!-- Danh sách các lệnh chuyển hàng trong batch -->
                            <table style="width:100%; border-collapse:collapse; margin-top:10px;">
                                <thead>
                                    <tr>
                                        <th style="border:1px solid #000;">STT</th>
                                        <th style="border:1px solid #000;">Số phiếu xuất</th>
                                        <th style="border:1px solid #000;">Khách hàng</th>
                                        <th style="border:1px solid #000;">Kho xuất</th>
                                        <th style="border:1px solid #000;">Ngày xuất</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="idx" t-value="0"/>
                                    <t t-foreach="batch.picking_ids" t-as="picking">
                                        <tr>
                                            <td style="border:1px solid #000; text-align:center;"><t t-esc="idx + 1"/></td>
                                            <td style="border:1px solid #000;"><t t-esc="picking.name"/></td>
                                            <td style="border:1px solid #000;"><t t-esc="picking.partner_id.name or ''"/></td>
                                            <td style="border:1px solid #000;"><t t-esc="picking.picking_type_id.warehouse_id.name or ''"/></td>
                                            <td style="border:1px solid #000;"><t t-if="picking.date_done"><t t-esc="picking.date_done.strftime('%d/%m/%Y')"/></t><t t-else="">__/__/____</t></td>
                                        </tr>
                                        <t t-set="idx" t-value="idx + 1"/>
                                    </t>
                                </tbody>
                            </table>
                            <div class="fs-note" style="font-weight:400; margin-top:5px;">
                                Cảm ơn quý khách hàng đã quan tâm sản phẩm Hoàng Long Vũ, chúng tôi rất hân hạnh được phục vụ quý khách
                            </div>
                            <!-- Bảng tổng hợp hàng hóa của toàn bộ batch -->
                            <t t-set="all_lines" t-value="[]"/>
                            <t t-foreach="batch.picking_ids" t-as="picking">
                                <t t-set="is_done" t-value="picking.state == 'done'"/>
                                <t t-set="lines" t-value="is_done and picking.move_line_ids or picking.move_ids"/>
                                <t t-set="all_lines" t-value="all_lines + [l for l in lines]"/>
                            </t>
                            <t t-set="total_untaxed" t-value="0.0"/>
                            <t t-set="total_tax" t-value="0.0"/>
                            <table style="width:100%; border-collapse:collapse; margin-top:10px;">
                                <thead>
                                    <tr>
                                        <th class="fs-table-header" style="border:1px solid #000; width:38px; text-align:center; background:#eee;">STT</th>
                                        <th class="fs-table-header" style="border:1px solid #000; width:300px; text-align:center; background:#eee;">Tên hàng</th>
                                        <th class="fs-table-header" style="border:1px solid #000; width:55px; text-align:center; background:#eee;">DVT</th>
                                        <th class="fs-table-header" style="border:1px solid #000; width:65px; text-align:center; background:#eee;">SL</th>
                                        <th class="fs-table-header" style="border:1px solid #000; width:90px; text-align:center; background:#eee;">Đơn giá</th>
                                        <th class="fs-table-header" style="border:1px solid #000; width:60px; text-align:center; background:#eee;">VAT (%)</th>
                                        <th class="fs-table-header" style="border:1px solid #000; width:90px; text-align:center; background:#eee;">Thuế VAT</th>
                                        <th class="fs-table-header" style="border:1px solid #000; width:95px; text-align:center; background:#eee;">Thành tiền</th>
                                        <th class="fs-table-header" style="border:1px solid #000; width:100px; text-align:center; background:#eee;">Kho xuất</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="idx" t-value="0"/>
                                    <t t-foreach="all_lines" t-as="l">
                                        <t t-set="qty_show" t-value="0.0"/>
                                        <t t-if="l._name == 'stock.move'">
                                            <t t-set="qty_show" t-value="l.product_uom_qty or 0.0"/>
                                        </t>
                                        <t t-elif="l._name == 'stock.move.line'">
                                            <t t-set="qty_show" t-value="(l.move_id and l.move_id.product_uom_qty) or 0.0"/>
                                            <t t-if="l.product_uom_id and l.move_id and l.move_id.product_uom and l.product_uom_id.id != l.move_id.product_uom.id">
                                                <t t-set="qty_show" t-value="l.move_id.product_uom._compute_quantity(l.move_id.product_uom_qty or 0.0, l.product_uom_id)"/>
                                            </t>
                                        </t>
                                        <t t-set="unit_price" t-value="0.0"/>
                                        <t t-set="line_tax_percent" t-value="0.0"/>
                                        <t t-if="l._name == 'stock.move'">
                                            <t t-set="unit_price" t-value="(l.sale_line_id and l.sale_line_id.price_unit) or 0.0"/>
                                            <t t-if="l.sale_line_id and l.sale_line_id.tax_id">
                                                <t t-set="line_tax_percent" t-value="l.sale_line_id.tax_id[0].amount or 0.0"/>
                                            </t>
                                        </t>
                                        <t t-elif="l._name == 'stock.move.line'">
                                            <t t-set="unit_price" t-value="(l.move_id and l.move_id.sale_line_id and l.move_id.sale_line_id.price_unit) or 0.0"/>
                                            <t t-if="l.move_id and l.move_id.sale_line_id and l.move_id.sale_line_id.tax_id">
                                                <t t-set="line_tax_percent" t-value="l.move_id.sale_line_id.tax_id[0].amount or 0.0"/>
                                            </t>
                                        </t>
                                        <t t-set="line_total" t-value="(qty_show or 0.0) * (unit_price or 0.0)"/>
                                        <t t-set="line_tax_value" t-value="(line_total * (line_tax_percent or 0.0) / 100.0)"/>
                                        <t t-if="qty_show &gt; 0">
                                            <t t-set="total_untaxed" t-value="total_untaxed + line_total"/>
                                            <t t-set="total_tax" t-value="total_tax + line_tax_value"/>
                                            <tr>
                                                <td class="fs-table-content" style="border:1px solid #000; text-align:center;"><t t-esc="idx + 1"/></td>
                                                <td class="fs-table-content" style="border:1px solid #000;">
                                                    <span t-esc="l.product_id and l.product_id.display_name or ''"/>
                                                    <t t-if="l._name == 'stock.move' and l.description_picking and (not l.product_id or l.description_picking not in (l.product_id.display_name or ''))">
                                                        <div style="color:#444;" t-esc="l.description_picking"/>
                                                    </t>
                                                </td>
                                                <td class="fs-table-content" style="border:1px solid #000; text-align:center;">
                                                    <t t-if="l._name == 'stock.move.line'">
                                                        <span t-esc="(l.product_uom_id and l.product_uom_id.name) or (l.product_id and l.product_id.uom_id and l.product_id.uom_id.name) or ''"/>
                                                    </t>
                                                    <t t-else="">
                                                        <span t-esc="(l.product_uom and l.product_uom.name) or (l.product_id and l.product_id.uom_id and l.product_id.uom_id.name) or ''"/>
                                                    </t>
                                                </td>
                                                <td class="fs-table-content" style="border:1px solid #000; text-align:center;"><span t-esc="'%0.2f' % qty_show"/></td>
                                                <td class="fs-table-content" style="border:1px solid #000; text-align:right;"><span t-esc="'{:,.0f}'.format(unit_price or 0.0).replace(',', '.')"/></td>
                                                <td class="fs-table-content" style="border:1px solid #000; text-align:center;"><span t-esc="'%s' % (line_tax_percent or 0.0)"/></td>
                                                <td class="fs-table-content" style="border:1px solid #000; text-align:right;"><span t-esc="'{:,.0f}'.format(line_tax_value or 0.0).replace(',', '.')"/></td>
                                                <td class="fs-table-content" style="border:1px solid #000; text-align:right;"><span t-esc="'{:,.0f}'.format(line_total or 0.0).replace(',', '.')"/></td>
                                                <td class="fs-table-content" style="border:1px solid #000; text-align:center;">
                                                    <t t-if="l._name == 'stock.move'">
                                                        <span t-esc="l.picking_id and l.picking_id.picking_type_id.warehouse_id.name or ''"/>
                                                    </t>
                                                    <t t-elif="l._name == 'stock.move.line'">
                                                        <span t-esc="l.move_id and l.move_id.picking_id and l.move_id.picking_id.picking_type_id.warehouse_id.name or ''"/>
                                                    </t>
                                                </td>
                                            </tr>
                                            <t t-set="idx" t-value="idx + 1"/>
                                        </t>
                                    </t>
                                    <t t-if="idx == 0">
                                        <tr>
                                            <td class="fs-table-content" colspan="9" style="border:1px solid #000; text-align:center; font-style:italic;">
                                                Không có dòng hàng.
                                            </td>
                                        </tr>
                                    </t>
                                    <tr>
                                        <td colspan="4" rowspan="3" style="border:1px solid #000; background:#eee;"/>
                                        <td class="fs-table-content" colspan="3" style="border:1px solid #000; text-align:left; font-weight:600;">
                                            Tổng tiền hàng (VNĐ)
                                        </td>
                                        <td class="fs-table-content" style="border:1px solid #000; text-align:right;">
                                            <span t-esc="'{:,.0f}'.format(total_untaxed or 0.0).replace(',', '.')"/>
                                        </td>
                                        <td rowspan="3" style="border:1px solid #000; background:#eee;"/>
                                    </tr>
                                    <tr>
                                        <td class="fs-table-content" colspan="3" style="border:1px solid #000; text-align:left; font-weight:600;">
                                            Tổng thuế VAT (VNĐ)
                                        </td>
                                        <td class="fs-table-content" style="border:1px solid #000; text-align:right;">
                                            <span t-esc="'{:,.0f}'.format(total_tax or 0.0).replace(',', '.')"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="fs-table-content" colspan="3" style="border:1px solid #000; text-align:left; font-weight:600;">
                                            Tổng tiền thanh toán (VNĐ)
                                        </td>
                                        <td class="fs-table-content" style="border:1px solid #000; text-align:right;">
                                            <span t-esc="'{:,.0f}'.format((total_untaxed + total_tax) or 0.0).replace(',', '.')"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="fs-table-content" colspan="4" style="border:1px solid #000; font-weight:600; background:#eee;">
                                            Thành tiền thanh toán (Bằng chữ):
                                        </td>
                                        <td class="fs-table-content" colspan="5" style="border:1px solid #000; background:#eee; text-align:center; font-weight:600;">
                                            <span t-esc="env['hlv.amount'].amount_to_text_vn((total_untaxed + total_tax) or 0.0)"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <div class="fs-note" style="margin-top:10px; text-align:justify; font-style:italic; font-weight:600;">
                                Lưu ý: Khách hàng vui lòng kiểm tra kỹ tình trạng và số lượng hàng hóa trước khi ký nhận
                            </div>
                            <table style="width:100%; margin-top:24px; text-align:center;">
                                <tr>
                                    <td class="fs-signature">Người nhận hàng</td>
                                    <td class="fs-signature">Người kiểm hàng</td>
                                    <td class="fs-signature">Người tạo phiếu</td>
                                </tr>
                            </table>
                            <div class="fs-footer" style="position: fixed; bottom: 20px; left: 0; width: 100%; text-align: center; margin-top: 10px;">
                                PHÂN PHỐI CHÍNH HÃNG: SKF-NSK-KOYO-NTN-ASAHI-IKO-MITSUBOSHI-LS-HANYOUNG-BOSCH-MILWAUKEE-MAKITA
                            </div>
                        </div>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
