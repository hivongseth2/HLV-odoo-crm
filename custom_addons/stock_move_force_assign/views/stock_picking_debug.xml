<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View for Debug Helper -->
        <record id="stock_picking_debug_helper_form" model="ir.ui.view">
            <field name="name">stock.picking.debug.helper.form</field>
            <field name="model">stock.picking.debug.helper</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="picking_id" />
                    </group>
                    <group>
                        <field name="debug_log" widget="text" nolabel="1" />
                    </group>
                    <footer>
                        <button string="🔍 Kiểm tra Lỗi" name="action_debug_picking" type="object" class="btn-primary"/>
                        <button string="🔧 Force Assign" name="action_force_assign" type="object" class="btn-info"/>
                        <button string="Đóng" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Action for Debug Helper -->
        <record id="action_stock_picking_debug_wizard" model="ir.actions.act_window">
            <field name="name">Debug Picking Assign</field>
            <field name="res_model">stock.picking.debug.helper</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="stock_picking_debug_helper_form"/>
        </record>

        <!-- Context Action (Button trên Picking) -->
        <record id="stock_picking_debug_button_action" model="ir.actions.server">
            <field name="name">Debug Assign Issue</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="binding_model_id" ref="stock.model_stock_picking"/>
            <field name="binding_type">action</field>
            <field name="state">code</field>
            <field name="code">
if records:
    action = {
        'type': 'ir.actions.act_window',
        'name': 'Debug Picking',
        'res_model': 'stock.picking.debug.helper',
        'view_mode': 'form',
        'target': 'new',
        'context': {'default_picking_id': records[0].id},
    }
            </field>
        </record>

        <!-- Menu Item -->
        <menuitem
            id="menu_stock_picking_debug"
            name="🔍 Debug Picking"
            parent="stock.menu_stock_root"
            action="action_stock_picking_debug_wizard"
            sequence="100"
        />
    </data>
</odoo>
