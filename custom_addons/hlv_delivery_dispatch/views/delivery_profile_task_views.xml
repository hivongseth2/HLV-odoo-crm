<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_profile_task_list" model="ir.ui.view">
        <field name="name">hlv.delivery.profile.task.list</field>
        <field name="model">hlv.delivery.profile.task</field>
        <field name="arch" type="xml">
            <list string="Việc cập nhật thói quen"
                  decoration-danger="is_overdue"
                  decoration-muted="state in ('approved', 'cancelled')">
                <field name="point_id"/>
                <field name="zone_id"/>
                <field name="assigned_user_id"/>
                <field name="deadline"/>
                <field name="completeness" widget="percentage" string="Độ đầy"/>
                <field name="missing_fields" string="Còn thiếu"/>
                <field name="origin" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'submitted'"
                       decoration-success="state == 'approved'"/>
                <field name="is_overdue" column_invisible="True"/>
                <button name="action_open_profile" type="object" string="Mở bảng thói quen"
                        icon="fa-pencil" class="btn-link"/>
                <button name="action_approve" type="object" string="Duyệt" icon="fa-check"
                        class="btn-link" invisible="state != 'submitted'"/>
                <button name="action_cancel" type="object" string="Bỏ qua" icon="fa-ban"
                        class="btn-link text-danger" invisible="state in ('approved', 'cancelled')"/>
            </list>
        </field>
    </record>

    <record id="view_profile_task_form" model="ir.ui.view">
        <field name="name">hlv.delivery.profile.task.form</field>
        <field name="model">hlv.delivery.profile.task</field>
        <field name="arch" type="xml">
            <form string="Việc cập nhật thói quen">
                <header>
                    <button name="action_submit" type="object" string="Xác nhận đã điền"
                            class="btn-primary" invisible="state != 'open'"/>
                    <button name="action_approve" type="object" string="Duyệt"
                            class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_open_profile" type="object" string="Mở bảng thói quen"/>
                    <button name="action_cancel" type="object" string="Bỏ qua"
                            invisible="state in ('approved', 'cancelled')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="point_id" options="{'no_create': True}"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="assigned_user_id"/>
                            <field name="assigned_by_id" readonly="1"/>
                            <field name="deadline"/>
                            <field name="origin" readonly="1"/>
                        </group>
                        <group>
                            <field name="zone_id" readonly="1"/>
                            <field name="profile_id" readonly="1"/>
                            <field name="completeness" widget="percentage" readonly="1"/>
                            <field name="missing_fields" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" nolabel="1" placeholder="Cần hỏi khách những gì"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_profile_task_search" model="ir.ui.view">
        <field name="name">hlv.delivery.profile.task.search</field>
        <field name="model">hlv.delivery.profile.task</field>
        <field name="arch" type="xml">
            <search>
                <field name="point_id"/>
                <field name="assigned_user_id"/>
                <filter name="open" string="Đang chờ" domain="[('state', '=', 'open')]"/>
                <filter name="submitted" string="Chờ duyệt" domain="[('state', '=', 'submitted')]"/>
                <filter name="overdue" string="Quá hạn" domain="[('is_overdue', '=', True)]"/>
                <filter name="mine" string="Của tôi" domain="[('assigned_user_id', '=', uid)]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_user" string="Sale phụ trách"
                            context="{'group_by': 'assigned_user_id'}"/>
                    <filter name="group_zone" string="Cụm tuyến" context="{'group_by': 'zone_id'}"/>
                    <filter name="group_state" string="Trạng thái" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_profile_task" model="ir.actions.act_window">
        <field name="name">Việc cập nhật thói quen</field>
        <field name="res_model">hlv.delivery.profile.task</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Không có việc nào đang chờ.</p>
            <p>Cron sinh việc cho mọi điểm có sale phụ trách mà bảng thói quen chưa được
               xác nhận. Sale điền trên trang /delivery_plan, tab "Khách tôi phụ trách".</p>
        </field>
    </record>
</odoo>
