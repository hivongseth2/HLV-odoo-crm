<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Cố tình KHÔNG inherit view của module fleet: id view của fleet đã đổi tên qua các
        bản Odoo (tree -> list), inherit sai id thì module không cài được. Ở đây khai view
        riêng cho màn "Xe điều phối"; app Đội xe vẫn dùng view gốc của nó.
    -->
    <record id="view_dispatch_vehicle_list" model="ir.ui.view">
        <field name="name">fleet.vehicle.dispatch.list</field>
        <field name="model">fleet.vehicle</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Xe điều phối">
                <field name="model_id"/>
                <field name="license_plate"/>
                <field name="x_dispatch_role"/>
                <field name="x_dispatch_warehouse_id"/>
                <field name="x_payload_kg"/>
                <field name="x_max_pieces"/>
                <field name="x_max_item_length_m"/>
                <field name="driver_id" string="Tài xế (Đội xe)"/>
                <field name="state_id"/>
                <field name="x_dispatch_enabled"/>
            </list>
        </field>
    </record>

    <record id="view_dispatch_vehicle_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.dispatch.form</field>
        <field name="model">fleet.vehicle</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Xe điều phối">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="license_plate" placeholder="Biển số"/></h1>
                    </div>
                    <group>
                        <group string="Xe">
                            <field name="model_id"/>
                            <field name="state_id"/>
                            <field name="driver_id" string="Tài xế (Đội xe)"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Tham gia điều phối">
                            <field name="x_dispatch_enabled"/>
                            <field name="x_dispatch_warehouse_id"
                                   invisible="not x_dispatch_enabled"/>
                            <field name="x_dispatch_role" invisible="not x_dispatch_enabled"/>
                        </group>
                        <group string="Chở hàng" invisible="not x_dispatch_enabled">
                            <field name="x_payload_kg"/>
                            <field name="x_max_pieces"/>
                            <field name="x_max_item_length_m"/>
                        </group>
                        <group string="Kích thước khoang (m)" invisible="not x_dispatch_enabled">
                            <field name="x_cargo_length_m"/>
                            <field name="x_cargo_width_m"/>
                            <field name="x_cargo_height_m"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="status" invisible="not x_dispatch_enabled">
                        Trường "Tài xế" của Đội xe trỏ tới <b>liên hệ</b>, còn chuyến gán tài xế
                        bằng <b>tài khoản người dùng</b> để khớp với phiếu mà tài xế quét ngoài kho.
                        Lệch nhau chỉ hiện cảnh báo trên chuyến, không chặn.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dispatch_vehicle" model="ir.actions.act_window">
        <field name="name">Xe điều phối</field>
        <field name="res_model">fleet.vehicle</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('x_dispatch_enabled', '=', True)]</field>
        <field name="context">{'default_x_dispatch_enabled': True}</field>
    </record>

    <record id="action_dispatch_vehicle_list_view" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_dispatch_vehicle_list"/>
        <field name="act_window_id" ref="action_dispatch_vehicle"/>
    </record>

    <record id="action_dispatch_vehicle_form_view" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_dispatch_vehicle_form"/>
        <field name="act_window_id" ref="action_dispatch_vehicle"/>
    </record>
</odoo>
