<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_zone_list" model="ir.ui.view">
        <field name="name">hlv.delivery.zone.list</field>
        <field name="model">hlv.delivery.zone</field>
        <field name="arch" type="xml">
            <list string="Cụm tuyến" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="warehouse_id"/>
                <field name="hub_to_first_minutes"/>
                <field name="median_leg_minutes"/>
                <field name="max_stops"/>
                <field name="map_layer_keys" optional="show"/>
                <field name="point_count" string="Số điểm"/>
            </list>
        </field>
    </record>

    <record id="view_delivery_zone_form" model="ir.ui.view">
        <field name="name">hlv.delivery.zone.form</field>
        <field name="model">hlv.delivery.zone</field>
        <field name="arch" type="xml">
            <form string="Cụm tuyến">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_points" type="object" class="oe_stat_button"
                                icon="fa-map-marker">
                            <field name="point_count" widget="statinfo" string="Điểm giao"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="VD: Nhơn Trạch"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="NT"/>
                            <field name="warehouse_id"/>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Định mức thời gian">
                            <field name="hub_to_first_minutes"/>
                            <field name="median_leg_minutes"/>
                            <field name="max_stops"/>
                            <field name="map_layer_keys"
                                   placeholder="VD: Tuyến Nhơn Trạch, ROUTER TUYẾN NHƠN TRẠCH"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="status">
                        Trần số điểm là trần <b>mềm</b>: vượt trần chỉ hiện cảnh báo trên màn xếp
                        chuyến, không chặn. Thời gian kho → điểm đầu phải khai riêng cho từng cụm.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_delivery_zone" model="ir.actions.act_window">
        <field name="name">Cụm tuyến</field>
        <field name="res_model">hlv.delivery.zone</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
