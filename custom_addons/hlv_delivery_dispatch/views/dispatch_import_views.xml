<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dispatch_import_wizard_form" model="ir.ui.view">
        <field name="name">hlv.dispatch.import.wizard.form</field>
        <field name="model">hlv.dispatch.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Nhập dữ liệu điều phối">
                <group>
                    <field name="warehouse_id"/>
                    <field name="create_missing_zone"/>
                </group>
                <group>
                    <field name="map_file" filename="map_filename"
                           string="Điểm bản đồ (map2.json)"/>
                    <field name="map_filename" invisible="1"/>
                    <field name="cust_file" filename="cust_filename"
                           string="Khách hàng (cust.json)"/>
                    <field name="cust_filename" invisible="1"/>
                </group>
                <div class="alert alert-info" role="status">
                    Chạy lại nhiều lần được. Điểm được khớp theo <b>tên đã chuẩn hoá</b> chứ không
                    theo thứ tự, vì My Maps không xuất ID ổn định. Toạ độ người đã nhập tay sẽ
                    không bị đè, và cụm đã gán tay sẽ không bị lớp bản đồ ghi đè.
                </div>
                <field name="result_log" readonly="1" invisible="not result_log"
                       widget="text" nolabel="1"/>
                <footer>
                    <button name="action_import" type="object" string="Nhập" class="btn-primary"/>
                    <button string="Đóng" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dispatch_import" model="ir.actions.act_window">
        <field name="name">Nhập dữ liệu điều phối</field>
        <field name="res_model">hlv.dispatch.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
