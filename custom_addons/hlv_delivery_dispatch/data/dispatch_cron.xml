<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_dispatch_geocode" model="ir.cron">
            <field name="name">Điều phối: tra toạ độ điểm giao</field>
            <field name="model_id" ref="model_hlv_delivery_point"/>
            <field name="state">code</field>
            <!-- Batch nhỏ vì Nominatim giới hạn 1 request/giây. -->
            <field name="code">model.cron_geocode_pending(limit=20)</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_dispatch_promote_waiting" model="ir.cron">
            <field name="name">Điều phối: đơn chờ hàng đã đủ hàng thì xếp vào chuyến</field>
            <field name="model_id" ref="model_hlv_delivery_trip_registration"/>
            <field name="state">code</field>
            <field name="code">model.cron_promote_waiting_goods(limit=200)</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_dispatch_responsible_sale" model="ir.cron">
            <field name="name">Điều phối: suy sale phụ trách điểm giao</field>
            <field name="model_id" ref="model_hlv_delivery_partner_profile"/>
            <field name="state">code</field>
            <field name="code">model.cron_compute_responsible_sale(limit=500)</field>
            <field name="interval_number">7</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_dispatch_profile_tasks" model="ir.cron">
            <field name="name">Điều phối: giao việc điền thói quen khách cho sale</field>
            <field name="model_id" ref="model_hlv_delivery_profile_task"/>
            <field name="state">code</field>
            <field name="code">model.cron_generate_tasks(limit=200)
model.cron_close_done_tasks()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_dispatch_expire_verification" model="ir.cron">
            <field name="name">Điều phối: đánh dấu thói quen khách hết hạn soát lại</field>
            <field name="model_id" ref="model_hlv_delivery_partner_profile"/>
            <field name="state">code</field>
            <field name="code">model.cron_expire_verification()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
