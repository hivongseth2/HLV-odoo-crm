<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_label_template">
        <t t-call="web.basic_layout">
            <div class="page">
                <style>
                    /* Reset Standard Odoo Report Padding/Margins */
                    body, html {
                        margin: 0 !important;
                        padding: 0 !important;
                        width: 100%;
                    }
                    .page {
                        margin: 0 !important;
                        padding: 0 !important;
                        border: none !important;
                    }
                    .container {
                        padding: 0 !important;
                        margin: 0 !important;
                    }
                    /* Custom Label Styling */
                    .label-container {
                        width: 40mm;
                        height: 29.5mm; /* Slightly less than 30mm to prevent overflow/drift */
                        margin: 0;
                        padding: 0;
                        page-break-inside: avoid;
                        page-break-after: always;
                        position: relative;
                        font-family: Arial, sans-serif;
                        text-align: center;
                        display: flex;
                        flex-direction: column;
                        align-items: center;
                        justify-content: center;
                        overflow: hidden;
                    }
                    .product-name {
                        font-weight: bold;
                        font-size: 8px; /* Reduced from 10px */
                        max-height: 10px;
                        overflow: hidden;
                        white-space: nowrap; 
                        text-overflow: ellipsis;
                        width: 95%;
                        margin-bottom: 2px;
                    }
                    .product-code {
                        font-size: 8px; /* Reduced from 9px */
                        font-weight: bold;
                    }
                </style>
                <t t-foreach="docs" t-as="wizard">
                    <t t-foreach="wizard.get_data_for_report()" t-as="product">
                        <div class="label-container">
                            <div class="product-name">
                                <span t-field="product.name"/>
                            </div>
                            
                            <!-- Barcode Section -->
                            <t t-if="wizard.print_type == 'barcode' and product.barcode">
                                <span t-field="product.barcode" t-options="{'widget': 'barcode', 'symbology': 'Code128', 'width': 600, 'height': 150, 'img_style': 'width:38mm; height:12mm; display:block; margin:0 auto;'}"/>
                                <div class="product-code">
                                    <span t-field="product.barcode"/>
                                </div>
                            </t>

                            <!-- QR Code Section -->
                            <t t-if="wizard.print_type == 'qr' and product.barcode">
                                <span t-field="product.barcode" t-options="{'widget': 'barcode', 'symbology': 'QR', 'width': 100, 'height': 100, 'img_style': 'width:15mm; height:15mm; display:block; margin:0 auto;'}"/>
                                <!-- <div class="product-code"><span t-field="product.barcode"/></div> --> 
                            </t>
                            
                            <t t-if="not product.barcode">
                                <div style="margin-top: 5px;">No Barcode</div>
                            </t>
                        </div>
                    </t>
                </t>
            </div>
        </t>
    </template>
</odoo>