<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_label_template">
        <t t-call="web.basic_layout">
            <div class="page">
                <style>
                    .label-container {
                        width: 40mm;
                        height: 30mm;
                        padding: 2px;
                        margin: 0;
                        overflow: hidden;
                        page-break-inside: avoid;
                        font-family: Arial, sans-serif;
                        font-size: 10px;
                        text-align: center;
                        border: 1px solid black; /* Remove this if you don't want a border */
                        display: flex;
                        flex-direction: column;
                        justify-content: center;
                        align-items: center;
                    }
                    .product-name {
                        font-weight: bold;
                        max-height: 12px;
                        overflow: hidden;
                        white-space: nowrap; 
                        text-overflow: ellipsis;
                        width: 100%;
                    }
                    .product-code {
                        font-size: 9px;
                    }
                </style>
                <t t-foreach="docs" t-as="wizard">
                    <t t-foreach="wizard.get_data_for_report()" t-as="product">
                        <div class="label-container">
                            <div class="product-name">
                                <span t-field="product.name"/>
                            </div>
                            <!-- Barcode Section -->
                            <t t-if="wizard.print_type == 'barcode' and product.barcode">
                                <img t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('Code128', product.barcode, 600, 150)" 
                                     style="width: 100%; height: 12mm; margin-top: 2px;"/>
                                <div class="product-code">
                                    <span t-field="product.barcode"/>
                                </div>
                            </t>

                            <!-- QR Code Section -->
                            <t t-if="wizard.print_type == 'qr' and product.barcode">
                                <img t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('QR', product.barcode, 100, 100)" 
                                     style="width: 15mm; height: 15mm; margin-top: 2px;"/>
                                <!-- Optionally show code text below QR -->
                                <!-- <div class="product-code"><span t-field="product.barcode"/></div> --> 
                            </t>
                            
                            <t t-if="not product.barcode">
                                <div style="margin-top: 5px;">No Barcode</div>
                            </t>
                        </div>
                    </t>
                </t>
            </div>
        </t>
    </template>
</odoo>