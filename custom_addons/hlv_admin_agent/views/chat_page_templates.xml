<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Trang toàn màn kiểu Claude desktop: cột trái các cuộc chat, giữa là cuộc đang mở. Dựng trên
         web.frontend_layout (không phải layout website) và tắt header / footer: trang chỉ có chat. -->
    <template id="chat_page" name="Trợ lý quản trị">
        <t t-call="web.frontend_layout">
            <t t-set="title">Trợ lý quản trị</t>
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
            <div class="hlv-aa-app" data-sidebar="1">
                <aside class="hlv-aa-sidebar">
                    <div class="hlv-aa-brand">Trợ lý quản trị</div>
                    <button type="button" class="hlv-aa-new">
                        <i class="fa fa-plus"/> Cuộc chat mới
                    </button>
                    <div class="hlv-aa-sessions"/>
                    <div class="hlv-aa-account">
                        <a href="/odoo" title="Về Odoo"><i class="fa fa-arrow-left"/></a>
                        <span t-esc="user_name"/>
                        <button type="button" class="hlv-aa-open-personal" title="Cá nhân hoá: hướng dẫn riêng, ghi nhớ">
                            <i class="fa fa-sliders"/>
                        </button>
                        <!-- Quản lý xem cuộc chat / ghi nhớ / hướng dẫn riêng của MỌI người ở backend. -->
                        <a t-if="is_manager" href="/odoo/action-hlv_admin_agent.action_hlv_admin_chat_session"
                           title="Quản lý: cuộc chat, ghi nhớ, hướng dẫn riêng của mọi người">
                            <i class="fa fa-users"/>
                        </a>
                    </div>
                    <div class="hlv-aa-resize" title="Kéo để đổi độ rộng"/>
                </aside>
                <main class="hlv-aa-main">
                    <div class="hlv-aa-top">
                        <button type="button" class="hlv-aa-toggle" title="Ẩn / hiện danh sách cuộc chat">
                            <i class="fa fa-bars"/>
                        </button>
                        <span class="hlv-aa-title"/>
                    </div>
                    <div class="hlv-aa-scroll">
                        <div class="hlv-aa-messages"/>
                    </div>
                    <div class="hlv-aa-composer">
                        <div class="hlv-aa-status"/>
                        <div class="hlv-aa-previews"/>
                        <div class="hlv-aa-input">
                            <label class="hlv-aa-attach" title="Đính kèm ảnh (hoặc dán ảnh vào ô chat)">
                                <i class="fa fa-paperclip"/>
                                <input type="file" accept="image/*" multiple="multiple" class="d-none"/>
                            </label>
                            <textarea rows="1" maxlength="4000"
                                      placeholder="Tạo báo giá, cơ hội, tra tồn, tạo mã hàng..."/>
                            <select class="hlv-aa-model" title="Model trả lời cuộc chat này">
                                <t t-foreach="models" t-as="option">
                                    <option t-att-value="option[0]" t-att-selected="option[0] == default_model"
                                            t-esc="option[1]"/>
                                </t>
                            </select>
                            <button type="button" class="hlv-aa-send" data-mode="send" title="Gửi (Enter)">
                                <i class="fa fa-arrow-up hlv-aa-send-icon"/>
                                <i class="fa fa-stop hlv-aa-stop-icon"/>
                            </button>
                        </div>
                        <div class="hlv-aa-hint">Enter để gửi · Shift+Enter xuống dòng · dán ảnh thẳng vào ô chat</div>
                    </div>
                </main>
                <!-- Cá nhân hoá (admin_personal.js): hướng dẫn riêng + ghi nhớ của chính người đang đăng nhập. -->
                <div class="hlv-aa-personal" data-open="0">
                    <div class="hlv-aa-personal-box">
                        <div class="hlv-aa-board-head">
                            <span class="hlv-aa-board-title">Cá nhân hoá</span>
                            <button type="button" class="hlv-aa-personal-close" title="Đóng"><i class="fa fa-times"/></button>
                        </div>
                        <div class="hlv-aa-personal-body">
                            <h3>Hướng dẫn riêng</h3>
                            <p class="hlv-aa-muted">Trợ lý theo ở mọi cuộc chat của anh/chị. Vd: "Trả lời ngắn; báo giá luôn kèm giá chưa VAT; khách quen phí ship 0".</p>
                            <textarea class="hlv-aa-instructions" rows="5" maxlength="4000"/>
                            <div class="hlv-aa-row-end">
                                <span class="hlv-aa-personal-msg"/>
                                <button type="button" class="hlv-aa-save-instructions">Lưu hướng dẫn</button>
                            </div>
                            <h3>Ghi nhớ</h3>
                            <p class="hlv-aa-muted">Trợ lý tự ghi khi anh/chị bảo "nhớ là...", hoặc thêm tay ở đây. Mọi cuộc chat sau đều dùng.</p>
                            <div class="hlv-aa-memory-add">
                                <select class="hlv-aa-memory-kind"/>
                                <input type="text" class="hlv-aa-memory-text" maxlength="500" placeholder="Điều trợ lý cần nhớ..."/>
                                <button type="button" class="hlv-aa-memory-add-btn">Thêm</button>
                            </div>
                            <div class="hlv-aa-memories"/>
                        </div>
                    </div>
                </div>
                <!-- Bảng trợ lý dựng (so sánh thông số): HTML trong iframe sandbox, không chạy script. -->
                <div class="hlv-aa-board" data-open="0">
                    <div class="hlv-aa-board-box">
                        <div class="hlv-aa-board-head">
                            <span class="hlv-aa-board-title"/>
                            <button type="button" class="hlv-aa-board-close" title="Đóng (Esc)">
                                <i class="fa fa-times"/>
                            </button>
                        </div>
                        <iframe class="hlv-aa-board-frame" sandbox="allow-popups allow-popups-to-escape-sandbox"
                                title="Bảng của trợ lý"/>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
