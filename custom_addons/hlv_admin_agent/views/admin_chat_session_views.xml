<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hlv_admin_chat_session_list" model="ir.ui.view">
        <field name="name">hlv.admin.chat.session.list</field>
        <field name="model">hlv.admin.chat.session</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="last_activity"/>
                <field name="user_id"/>
                <field name="name"/>
                <field name="state" widget="badge" decoration-warning="state == 'processing'"/>
                <field name="api_input_tokens" optional="show" sum="Tổng"/>
                <field name="api_cache_read_tokens" optional="hide" sum="Tổng"/>
                <field name="api_output_tokens" optional="show" sum="Tổng"/>
            </list>
        </field>
    </record>

    <record id="view_hlv_admin_chat_session_form" model="ir.ui.view">
        <field name="name">hlv.admin.chat.session.form</field>
        <field name="model">hlv.admin.chat.session</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="user_id" readonly="1"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="last_activity" readonly="1"/>
                            <field name="api_input_tokens"/>
                            <field name="api_cache_read_tokens"/>
                            <field name="api_output_tokens"/>
                        </group>
                    </group>
                    <field name="message_ids" readonly="1">
                        <list>
                            <field name="create_date" string="Lúc"/>
                            <field name="role"/>
                            <field name="content"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hlv_admin_chat_session_search" model="ir.ui.view">
        <field name="name">hlv.admin.chat.session.search</field>
        <field name="model">hlv.admin.chat.session</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id"/>
                <field name="message_ids" string="Nội dung tin" filter_domain="[('message_ids.content', 'ilike', self)]"/>
                <filter name="processing" string="Đang xử lý" domain="[('state', '=', 'processing')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_user" string="Tài khoản" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hlv_admin_chat_session" model="ir.actions.act_window">
        <field name="name">Cuộc chat trợ lý quản trị</field>
        <field name="res_model">hlv.admin.chat.session</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_hlv_admin_chat_page" model="ir.actions.act_url">
        <field name="name">Trợ lý quản trị</field>
        <field name="url">/tro-ly-quan-tri</field>
        <field name="target">self</field>
    </record>
</odoo>
