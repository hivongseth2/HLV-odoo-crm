<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hlv_admin_agent_memory_list" model="ir.ui.view">
        <field name="name">hlv.admin.agent.memory.list</field>
        <field name="model">hlv.admin.agent.memory</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="user_id"/>
                <field name="kind"/>
                <field name="content"/>
                <field name="session_id" optional="show" readonly="1"/>
                <field name="write_date" string="Sửa lần cuối" optional="show" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="view_hlv_admin_agent_memory_search" model="ir.ui.view">
        <field name="name">hlv.admin.agent.memory.search</field>
        <field name="model">hlv.admin.agent.memory</field>
        <field name="arch" type="xml">
            <search>
                <field name="content"/>
                <field name="user_id"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_user" string="Người dùng" context="{'group_by': 'user_id'}"/>
                    <filter name="group_kind" string="Loại" context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hlv_admin_agent_memory" model="ir.actions.act_window">
        <field name="name">Ghi nhớ của trợ lý</field>
        <field name="res_model">hlv.admin.agent.memory</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_user': 1}</field>
    </record>

    <record id="view_hlv_admin_agent_profile_list" model="ir.ui.view">
        <field name="name">hlv.admin.agent.profile.list</field>
        <field name="model">hlv.admin.agent.profile</field>
        <field name="arch" type="xml">
            <list>
                <field name="user_id"/>
                <field name="instructions"/>
            </list>
        </field>
    </record>

    <record id="view_hlv_admin_agent_profile_form" model="ir.ui.view">
        <field name="name">hlv.admin.agent.profile.form</field>
        <field name="model">hlv.admin.agent.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="user_id"/>
                    </group>
                    <field name="instructions" nolabel="1" placeholder="Người dùng tự viết trên trang chat (Cá nhân hoá)."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hlv_admin_agent_profile" model="ir.actions.act_window">
        <field name="name">Hướng dẫn riêng</field>
        <field name="res_model">hlv.admin.agent.profile</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
