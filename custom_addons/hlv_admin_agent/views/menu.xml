<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- App riêng, chỉ người có quyền Trợ lý quản trị thấy. -->
    <menuitem id="menu_hlv_admin_agent_root"
              name="Trợ lý quản trị"
              groups="group_admin_agent_user"
              web_icon="hlv_admin_agent,static/description/icon.png"
              sequence="95"/>

    <!-- Bấm app = mở menu con ĐẦU TIÊN người đó thấy. "Mở trang chat" đứng sau các menu quản lý: quản
         lý bấm app vào màn backend (có thanh menu tới Cuộc chat / Ghi nhớ...); người dùng thường không
         thấy menu quản lý nên vẫn vào thẳng trang chat. Đặt lên đầu là trang chat che mất backend. -->
    <menuitem id="menu_hlv_admin_agent_chat"
              name="Mở trang chat"
              parent="menu_hlv_admin_agent_root"
              action="action_hlv_admin_chat_page"
              groups="group_admin_agent_user"
              sequence="40"/>

    <menuitem id="menu_hlv_admin_agent_sessions"
              name="Cuộc chat"
              parent="menu_hlv_admin_agent_root"
              action="action_hlv_admin_chat_session"
              groups="group_admin_agent_manager"
              sequence="20"/>

    <menuitem id="menu_hlv_admin_agent_memory"
              name="Ghi nhớ"
              parent="menu_hlv_admin_agent_root"
              action="action_hlv_admin_agent_memory"
              groups="group_admin_agent_manager"
              sequence="22"/>

    <menuitem id="menu_hlv_admin_agent_profile"
              name="Hướng dẫn riêng"
              parent="menu_hlv_admin_agent_root"
              action="action_hlv_admin_agent_profile"
              groups="group_admin_agent_manager"
              sequence="24"/>

    <menuitem id="menu_hlv_admin_agent_config"
              name="Cấu hình"
              parent="menu_hlv_admin_agent_root"
              action="action_hlv_admin_agent_config"
              groups="base.group_system"
              sequence="30"/>
</odoo>
