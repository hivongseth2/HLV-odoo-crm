<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Gửi tin là Odoo chạy ngay trong luồng nền (runner.wake); cron chỉ vớt tin sót khi worker
         khởi động lại giữa chừng, và thả lượt treo. -->
    <record id="ir_cron_admin_agent_sweep" model="ir.cron">
        <field name="name">Trợ lý quản trị: vớt tin chờ, thả lượt treo</field>
        <field name="model_id" ref="model_hlv_admin_agent_runner"/>
        <field name="state">code</field>
        <field name="code">model._cron_sweep()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
