<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Server Action: Tạo tất cả phân quyền -->
    <record id="action_generate_all_permissions" model="ir.actions.server">
        <field name="name">Tạo tất cả phân quyền</field>
        <field name="model_id" ref="model_warehouse_user_permission"/>
        <field name="state">code</field>
        <field name="code">action = model.action_generate_all()</field>
    </record>

    <!-- Tree View: Danh sách phân quyền -->
    <record id="view_warehouse_permission_list" model="ir.ui.view">
        <field name="name">warehouse.user.permission.list</field>
        <field name="model">warehouse.user.permission</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="%(action_generate_all_permissions)d" type="action"
                            string="⚡ Tạo phân quyền cho tất cả"
                            class="btn-primary"
                            groups="hlv_warehouse_permission.group_warehouse_permission_manager"/>
                </header>
                <field name="user_id"/>
                <field name="warehouse_id"/>
                <field name="can_update_inventory" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View: Chi tiết phân quyền phiếu -->
    <record id="view_warehouse_permission_form" model="ir.ui.view">
        <field name="name">warehouse.user.permission.form</field>
        <field name="model">warehouse.user.permission</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Thông tin">
                            <field name="user_id"/>
                            <field name="warehouse_id"/>
                        </group>
                        <group string="Tồn kho">
                            <field name="can_update_inventory" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Phân quyền phiếu" name="picking_permissions">
                            <field name="picking_permission_ids">
                                <list editable="bottom">
                                    <field name="picking_type_code"/>
                                    <field name="can_view" widget="boolean_toggle"/>
                                    <field name="can_create" widget="boolean_toggle"/>
                                    <field name="can_edit" widget="boolean_toggle"/>
                                    <field name="can_delete" widget="boolean_toggle"/>
                                    <field name="can_confirm" widget="boolean_toggle"/>
                                    <field name="can_cancel" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_warehouse_permission_search" model="ir.ui.view">
        <field name="name">warehouse.user.permission.search</field>
        <field name="model">warehouse.user.permission</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="warehouse_id"/>
                <separator/>
                <filter name="can_inventory" string="Được cập nhật tồn kho"
                        domain="[('can_update_inventory', '=', True)]"/>
                <separator/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_user" string="Người dùng"
                            context="{'group_by': 'user_id'}"/>
                    <filter name="group_warehouse" string="Kho"
                            context="{'group_by': 'warehouse_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action Window -->
    <record id="action_warehouse_permission" model="ir.actions.act_window">
        <field name="name">Phân quyền kho</field>
        <field name="res_model">warehouse.user.permission</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_warehouse_permission_search"/>
        <field name="context">{'search_default_group_user': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có phân quyền kho nào
            </p>
            <p>
                Bấm nút <b>"Tạo phân quyền cho tất cả"</b> ở thanh công cụ
                để tự động tạo phân quyền cho tất cả người dùng nội bộ.
                <br/>Sau đó bấm vào từng dòng để cấu hình chi tiết quyền từng loại phiếu.
            </p>
        </field>
    </record>

</odoo>
