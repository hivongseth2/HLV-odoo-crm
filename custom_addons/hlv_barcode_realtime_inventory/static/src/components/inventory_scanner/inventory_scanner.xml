<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="hlv_barcode_realtime_inventory.InventoryScanner">
        <div class="hlv-inventory-scanner">
            
            <!-- Loading -->
            <div t-if="state.loading" class="hlv-loading">
                <div class="hlv-spinner"></div>
                <p class="mt-3">Đang tải...</p>
            </div>

            <!-- Main App -->
            <div t-else="">
                <!-- Header -->
                <header class="hlv-header">
                    <h1 class="hlv-title">📦 Kiểm Kê</h1>
                    <span t-if="state.syncing" class="hlv-sync-indicator">
                        <i class="fa fa-circle-o-notch fa-spin"></i>
                    </span>
                </header>

                <!-- Camera Scanner -->
                <div class="hlv-scanner-zone" t-if="state.scannerMode === 'camera'">
                    <div class="hlv-camera-container">
                        <video 
                            t-ref="cameraVideo"
                            autoplay="" 
                            playsinline="" 
                            id="hlv-camera-preview"
                            t-if="state.cameraActive">
                        </video>
                        <div t-if="state.cameraActive" class="hlv-camera-overlay">
                            <div class="hlv-scan-frame">
                                <div class="hlv-scan-corners"></div>
                            </div>
                        </div>
                        <div t-if="!state.cameraActive" class="hlv-loading" style="min-height: 200px;">
                            <div class="hlv-spinner"></div>
                        </div>
                    </div>
                    <div class="hlv-scanner-controls">
                        <button class="hlv-btn-camera active">
                            <i class="fa fa-camera"></i> Camera
                        </button>
                        <button class="hlv-btn-keyboard" t-on-click="() => this.toggleScannerMode('keyboard')">
                            <i class="fa fa-keyboard-o"></i> Keyboard
                        </button>
                    </div>
                </div>

                <!-- Keyboard Input -->
                <div class="hlv-scanner-zone" t-if="state.scannerMode === 'keyboard'">
                    <div class="hlv-scanner-controls">
                        <button class="hlv-btn-camera" t-on-click="() => this.toggleScannerMode('camera')">
                            <i class="fa fa-camera"></i> Camera
                        </button>
                        <button class="hlv-btn-keyboard active">
                            <i class="fa fa-keyboard-o"></i> Keyboard
                        </button>
                    </div>
                    <div class="hlv-keyboard-input active">
                        <input 
                            type="text"
                            class="hlv-barcode-input"
                            t-att-value="state.barcodeInput"
                            t-on-input="onBarcodeInputChange"
                            t-on-keydown="onBarcodeInputKeydown"
                            placeholder="Nhập hoặc quét barcode..."
                            autofocus="autofocus"
                        />
                    </div>
                </div>

                <!-- Location Bar -->
                <div class="hlv-location-bar" t-on-click="openLocationSelector">
                    <span class="hlv-location-icon">📍</span>
                    <span t-if="state.locationName" class="hlv-location-name">
                        <t t-esc="state.locationName"/>
                    </span>
                    <span t-else="" class="hlv-location-placeholder">
                        Chọn vị trí kho
                    </span>
                    <button class="hlv-btn-change-location">
                        Đổi
                    </button>
                </div>

                <!-- Product List -->
                <div class="hlv-product-list">
                    <div t-if="state.lines.length === 0" class="hlv-empty-state">
                        <i class="fa fa-cubes"></i>
                        <p>Chưa có sản phẩm</p>
                        <small>Quét để bắt đầu</small>
                    </div>

                    <t t-foreach="state.lines" t-as="line" t-key="line.id">
                        <div class="hlv-product-card">
                            <div class="hlv-product-main">
                                <div class="hlv-product-header">
                                    <span class="hlv-product-code" t-esc="line.product_code or '---'"/>
                                    <span t-if="line.theoretical_qty === 0" class="hlv-badge-new">Mới</span>
                                </div>
                                <div class="hlv-product-name" t-esc="line.product_name"/>
                                <div class="hlv-product-qty">
                                    <span class="hlv-qty-scanned" t-esc="line.scanned_qty"/>
                                    <span class="hlv-qty-separator">/</span>
                                    <span class="hlv-qty-theoretical" t-esc="line.theoretical_qty"/>
                                    <span class="hlv-qty-uom" t-esc="line.uom_name"/>
                                    <span t-if="line.difference !== 0" 
                                          t-attf-class="hlv-qty-diff {{ line.difference > 0 ? 'positive' : 'negative' }}">
                                        <t t-if="line.difference > 0">+</t><t t-esc="line.difference"/>
                                    </span>
                                </div>
                            </div>
                            <div class="hlv-product-actions">
                                <button class="hlv-btn-action hlv-btn-plus" t-on-click="() => this.incrementQty(line, 1)">
                                    +1
                                </button>
                                <button class="hlv-btn-action hlv-btn-plus10" t-on-click="() => this.incrementQty(line, 10)">
                                    +10
                                </button>
                                <button class="hlv-btn-action hlv-btn-delete" t-on-click="() => this.removeLine(line)">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </div>
                        </div>
                    </t>
                </div>

                <!-- Footer -->
                <footer class="hlv-footer">
                    <button class="hlv-btn-apply" t-on-click="confirmSession" t-att-disabled="state.lines.length === 0">
                        ✓ Áp dụng (<t t-esc="state.lines.length"/>)
                    </button>
                </footer>
            </div>

            <!-- Location Selector Modal -->
            <div t-if="state.showLocationSelector" class="hlv-modal-overlay" t-on-click="closeLocationSelector">
                <div class="hlv-modal" t-on-click.stop="">
                    <div class="hlv-modal-header">
                        <h2>Chọn vị trí kho</h2>
                        <button class="hlv-btn-close" t-on-click="closeLocationSelector">
                            <i class="fa fa-times"></i>
                        </button>
                    </div>
                    <div class="hlv-modal-body">
                        <div class="hlv-location-list">
                            <t t-foreach="state.locationResults" t-as="loc" t-key="loc.id">
                                <div class="hlv-location-item" t-on-click="() => this.selectLocation(loc)">
                                    <i class="fa fa-map-marker"></i>
                                    <span t-esc="loc.name"/>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </t>

</templates>
