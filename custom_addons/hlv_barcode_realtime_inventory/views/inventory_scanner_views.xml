<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Client Action for Inventory Scanner -->
    <record id="action_inventory_scanner" model="ir.actions.client">
        <field name="name">Quét Kiểm Kê</field>
        <field name="tag">hlv_inventory_scanner</field>
        <field name="target">fullscreen</field>
    </record>

    <menuitem
        id="menu_hlv_inventory_root"
        name="Kiểm Kê Barcode"
        sequence="25"/>

    <!-- Main Scanner Menu -->
    <menuitem
        id="menu_inventory_scanner_main"
        name="Bắt đầu quét"
        parent="menu_hlv_inventory_root"
        action="action_inventory_scanner"
        sequence="1"
        groups="stock.group_stock_user"/>

    <!-- Session List View -->
    <record id="view_inventory_scan_session_tree" model="ir.ui.view">
        <field name="name">inventory.scan.session.tree</field>
        <field name="model">inventory.scan.session</field>
        <field name="arch" type="xml">
            <list string="Lịch sử kiểm kê" decoration-success="state == 'confirmed'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="user_id"/>
                <field name="location_id"/>
                <field name="product_count"/>
                <field name="scan_count"/>
                <field name="start_time"/>
                <field name="last_scan_time"/>
                <field name="state" widget="badge" decoration-info="state == 'active'" decoration-success="state == 'confirmed'" decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Session Form View -->
    <record id="view_inventory_scan_session_form" model="ir.ui.view">
        <field name="name">inventory.scan.session.form</field>
        <field name="model">inventory.scan.session</field>
        <field name="arch" type="xml">
            <form string="Phiên Kiểm Kê">
                <header>
                    <button name="confirm_session" type="object" string="Xác Nhận" class="btn-primary" invisible="state != 'active'"/>
                    <button name="cancel_session" type="object" string="Hủy" class="btn-secondary" invisible="state != 'active'" confirm="Bạn có chắc muốn hủy phiên kiểm kê này?"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="device_id"/>
                            <field name="location_id"/>
                        </group>
                        <group>
                            <field name="product_count"/>
                            <field name="scan_count"/>
                            <field name="start_time"/>
                            <field name="last_scan_time"/>
                            <field name="confirmed_time" invisible="state != 'confirmed'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sản phẩm đã quét" name="lines">
                            <field name="line_ids">
                                <list editable="bottom" limit="50">
                                    <field name="product_id"/>
                                    <field name="scanned_qty"/>
                                    <field name="theoretical_qty"/>
                                    <field name="difference" decoration-danger="difference &lt; 0" decoration-success="difference &gt; 0"/>
                                    <field name="location_id"/>
                                    <field name="lot_id" optional="hide"/>
                                    <field name="package_id" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Session Search View -->
    <record id="view_inventory_scan_session_search" model="ir.ui.view">
        <field name="name">inventory.scan.session.search</field>
        <field name="model">inventory.scan.session</field>
        <field name="arch" type="xml">
            <search string="Tìm Phiên Kiểm Kê">
                <field name="name"/>
                <field name="user_id"/>
                <field name="location_id"/>
                <filter name="filter_active" string="Đang quét" domain="[('state', '=', 'active')]"/>
                <filter name="filter_confirmed" string="Đã xác nhận" domain="[('state', '=', 'confirmed')]"/>
                <filter name="filter_cancelled" string="Đã hủy" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="filter_today" string="Hôm nay" domain="[('start_time', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_user" string="Người dùng" context="{'group_by': 'user_id'}"/>
                    <filter name="group_location" string="Vị trí" context="{'group_by': 'location_id'}"/>
                    <filter name="group_state" string="Trạng thái" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action to view scan sessions -->
    <record id="action_inventory_scan_sessions" model="ir.actions.act_window">
        <field name="name">Lịch sử Sessions</field>
        <field name="res_model">inventory.scan.session</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_inventory_scan_session_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>

    <!-- Menu to view sessions history -->
    <menuitem
        id="menu_inventory_scan_sessions"
        name="Lịch sử Quét"
        parent="menu_hlv_inventory_root"
        action="action_inventory_scan_sessions"
        sequence="10"
        groups="stock.group_stock_user"/>

</odoo>
