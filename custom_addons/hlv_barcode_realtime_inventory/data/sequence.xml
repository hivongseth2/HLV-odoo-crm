<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate="1" prevents the counter from resetting on module upgrade -->
    <data noupdate="1">
        <record id="seq_inventory_check" model="ir.sequence">
            <field name="name">Inventory Check Sequence</field>
            <field name="code">inventory.check</field>
            <field name="prefix">CHECK/%(y)s/%(month)s/</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="padding">5</field>
            <field name="implementation">standard</field>
        </record>
    </data>
</odoo>
