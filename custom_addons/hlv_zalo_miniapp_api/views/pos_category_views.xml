<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View Extension -->
    <record id="view_pos_category_form_zalo" model="ir.ui.view">
        <field name="name">pos.category.form.zalo</field>
        <field name="model">pos.category</field>
        <field name="inherit_id" ref="point_of_sale.product_pos_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="x_is_featured_zalo"/>
            </xpath>
        </field>
    </record>

    <!-- Tree/List View Extension -->
    <record id="view_pos_category_tree_zalo" model="ir.ui.view">
        <field name="name">pos.category.tree.zalo</field>
        <field name="model">pos.category</field>
        <field name="inherit_id" ref="point_of_sale.product_pos_category_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="x_is_featured_zalo"/>
            </xpath>
        </field>
    </record>
</odoo>
