<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_product_zalo_search_inherit" model="ir.ui.view">
        <field name="name">product.product.zalo.search.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_search_form_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="x_active_zalo"/>
            </field>
            <xpath expr="//search" position="inside">
                <filter string="Bán trên Zalo App" name="filter_active_zalo" domain="[('x_active_zalo', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <record id="action_zalo_product_product" model="ir.actions.act_window">
        <field name="name">Sản phẩm Zalo Mini App</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('x_active_zalo', '=', True)]</field>
        <field name="context">{'default_x_active_zalo': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có sản phẩm nào được kích hoạt trên Zalo Mini App.
            </p>
            <p>
                Bật tùy chọn "Active Zalo" trên sản phẩm để cho phép hiển thị và bán trên ứng dụng Zalo.
            </p>
        </field>
    </record>
</odoo>
