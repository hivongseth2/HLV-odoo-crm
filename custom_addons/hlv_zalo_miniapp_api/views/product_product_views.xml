<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_product_zalo_form_inherit" model="ir.ui.view">
        <field name="name">product.product.zalo.form.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='inventory']" position="after">
                <group name="zalo" string="Zalo Mini App">
                    <field name="x_active_zalo"/>
                    <field name="x_zalo_price"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_product_product_zalo_search_inherit" model="ir.ui.view">
        <field name="name">product.product.zalo.search.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_search_form_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="x_active_zalo"/>
            </field>
        </field>
    </record>
</odoo>
