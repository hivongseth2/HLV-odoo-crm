<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_zalo_tree" model="ir.ui.view">
        <field name="name">sale.order.zalo.list</field>
        <field name="model">sale.order</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list string="Đơn hàng Zalo Mini App" sample="1" decoration-muted="state == 'cancel'">
                <field name="x_plan_need_cancel" string="Cần hủy" widget="boolean_toggle" optional="show"/>
                <field name="x_return_requested" string="Khách đề nghị đổi/trả" widget="boolean_toggle" optional="show"/>
                <field name="x_return_state" string="TT đổi/trả" widget="badge"
                       decoration-warning="x_return_state == 'pending'"
                       decoration-info="x_return_state == 'approved'"
                       decoration-success="x_return_state in ('processing', 'completed')"
                       decoration-danger="x_return_state == 'rejected'"
                       optional="show"/>
                <field name="x_return_type" string="Loại đổi/trả" optional="show"/>
                <field name="x_return_picking_id" string="Phiếu trả hàng" optional="show"/>
                <field name="x_return_refund_amount" string="Tiền hoàn lại" widget="monetary" optional="show"/>
                <field name="name" string="Số báo giá" readonly="1" decoration-bf="1"/>
                <field name="date_order" string="Ngày đặt hàng" readonly="1" widget="datetime" optional="show"/>
                <field name="commitment_date" string="Ngày giao hàng" widget="datetime" optional="show"/>
                <field name="partner_id" string="Khách hàng" readonly="1"/>
                <field name="user_id" string="Chuyên viên sales" widget="many2one_avatar_user" optional="show"/>
                <field name="activity_ids" string="Hoạt động" widget="list_activity" optional="show"/>
                <field name="amount_total" string="Tổng" sum="Total Tax Included" widget="monetary" decoration-bf="1"/>
                <field name="state" string="Trạng thái đơn hàng" widget="badge"
                       decoration-info="state in ('draft', 'sent')"
                       decoration-success="state == 'sale'"
                       decoration-primary="state == 'done'"
                       decoration-danger="state == 'cancel'"
                       optional="show"/>
                <field name="delivery_status" string="Trạng thái giao hàng" widget="badge"
                       decoration-info="delivery_status in ('to_delivery', 'started')"
                       decoration-warning="delivery_status == 'partial'"
                       decoration-success="delivery_status == 'full'"
                       decoration-muted="not delivery_status or delivery_status == 'clear'"
                       optional="show"/>
                <field name="invoice_status" string="Trạng thái hóa đơn" widget="badge"
                       decoration-success="invoice_status == 'invoiced'"
                       decoration-info="invoice_status == 'to invoice'"
                       decoration-muted="invoice_status == 'no'"
                       optional="show"/>
                <field name="tag_ids" string="Thẻ" widget="many2many_tags" options="{'color_field': 'color'}" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Form view riêng cho đơn Zalo - kế thừa form gốc, thêm tab Đổi trả -->
    <!-- Odoo 17: dùng invisible trực tiếp thay vì attrs -->
    <record id="view_order_zalo_form" model="ir.ui.view">
        <field name="name">sale.order.zalo.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Đổi trả Zalo" name="zalo_return"
                      invisible="not partner_id.x_is_zalo_account">
                    <group string="Thông tin yêu cầu đổi/trả" colspan="4" col="2">
                        <field name="x_return_requested" string="Khách đề nghị đổi/trả"/>
                        <field name="x_return_state" string="Trạng thái đổi/trả"
                               widget="statusbar"
                               statusbar_visible="pending,approved,processing,completed,rejected"/>
                        <field name="x_return_type" string="Loại đổi/trả"/>
                        <field name="x_return_refund_amount" string="Số tiền hoàn lại" widget="monetary"/>
                        <field name="x_return_rejected_reason" string="Lý do từ chối"
                               invisible="x_return_state != 'rejected'"/>
                    </group>
                    <group string="Phiếu giao hàng & Trả hàng" colspan="4" col="2">
                        <field name="picking_ids" string="Phiếu giao/nhận"
                               domain="[('state', '!=', 'cancel')]"
                               context="{'tree_view_ref': 'stock.vpicktree'}">
                            <tree string="Phiếu kho">
                                <field name="name"/>
                                <field name="picking_type_id"/>
                                <field name="state" widget="badge"
                                       decoration-success="state == 'done'"
                                       decoration-warning="state == 'assigned'"
                                       decoration-info="state in ('waiting', 'confirmed')"
                                       decoration-danger="state == 'cancel'"/>
                                <field name="scheduled_date"/>
                            </tree>
                        </field>
                    </group>
                    <group string="Phiếu trả hàng Zalo" colspan="4" col="2"
                           invisible="not x_return_picking_id">
                        <field name="x_return_picking_id" string="Phiếu trả hàng (WH/IN)"/>
                        <field name="x_return_completed_date" string="Ngày hoàn tất"/>
                    </group>
                    <group string="Hành động xử lý" colspan="4" col="4"
                           invisible="not x_return_requested">
                        <button name="action_approve_return" type="object" string="Phê duyệt"
                                class="btn-primary"
                                invisible="x_return_state and x_return_state != 'pending'"
                                confirm="Xác nhận phê duyệt yêu cầu đổi/trả này?"/>
                        <button name="action_reject_return" type="object" string="Từ chối"
                                class="btn-danger"
                                invisible="x_return_state and x_return_state not in ('pending', 'approved')"
                                context="{'default_reject_reason': True}"/>
                        <button name="action_complete_return" type="object" string="Hoàn tất đổi/trả"
                                class="btn-success"
                                invisible="x_return_state not in ('approved', 'processing')"
                                confirm="Xác nhận hoàn tất xử lý đổi/trả?"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_zalo_sale_order" model="ir.actions.act_window">
        <field name="name">Đơn hàng Zalo Mini App</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form,calendar,pivot,graph,activity</field>
        <field name="view_id" ref="view_order_zalo_tree"/>
        <field name="domain">[('partner_id.x_is_zalo_account', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có đơn hàng nào từ khách hàng Zalo Mini App.
            </p>
            <p>
                Danh sách các đơn hàng được tạo bởi tài khoản khách hàng Zalo Mini App sẽ xuất hiện ở đây.
            </p>
        </field>
    </record>

    <record id="action_zalo_sale_order_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_order_zalo_tree"/>
        <field name="act_window_id" ref="action_zalo_sale_order"/>
    </record>
</odoo>
