<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="view_zalo_miniapp_banner_form" model="ir.ui.view">
            <field name="name">zalo.miniapp.banner.form</field>
            <field name="model">zalo.miniapp.banner</field>
            <field name="arch" type="xml">
                <form string="Zalo Mini App Banner">
                    <sheet>
                        <field name="image" widget="image" class="oe_avatar"/>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="active"/>
                                <field name="sequence"/>
                            </group>
                            <group>
                                <field name="link"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- List View -->
        <record id="view_zalo_miniapp_banner_list" model="ir.ui.view">
            <field name="name">zalo.miniapp.banner.list</field>
            <field name="model">zalo.miniapp.banner</field>
            <field name="arch" type="xml">
                <!-- Using Odoo 18 <list> tag -->
                <list string="Zalo Mini App Banners">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="link"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <!-- Action -->
        <record id="action_zalo_miniapp_banner" model="ir.actions.act_window">
            <field name="name">Zalo Mini App Banners</field>
            <field name="res_model">zalo.miniapp.banner</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Menu Item (Assuming there is a parent menu, for now add under root or sales) -->
        <menuitem id="menu_zalo_miniapp_banner"
                  name="Banners"
                  parent="sale.sale_menu_root"
                  action="action_zalo_miniapp_banner"
                  sequence="100"/>
    </data>
</odoo>
