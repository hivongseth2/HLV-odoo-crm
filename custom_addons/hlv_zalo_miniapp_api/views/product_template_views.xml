<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_zalo_form_inherit" model="ir.ui.view">
        <field name="name">product.template.zalo.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-block">
                    <field name="x_active_zalo"/>
                    <label for="x_active_zalo"/>
                </span>
            </xpath>
            <xpath expr="//group[@name='group_standard_price']" position="inside">
                <field name="x_zalo_price"/>
            </xpath>
            <xpath expr="//page[@name='sales']" position="inside">
                <group string="Danh mục Zalo">
                    <field name="x_zalo_categ_ids" widget="many2many_tags"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_zalo_search_inherit" model="ir.ui.view">
        <field name="name">product.template.zalo.search.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="x_active_zalo"/>
            </field>
        </field>
    </record>

    <record id="action_zalo_product_template" model="ir.actions.act_window">
        <field name="name">Sản phẩm Zalo Mini App</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('x_active_zalo', '=', True)]</field>
        <field name="context">{'default_x_active_zalo': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có sản phẩm nào được kích hoạt trên Zalo Mini App.
            </p>
            <p>
                Bật tùy chọn "Hiển thị trên Zalo" trên sản phẩm để cho phép hiển thị và bán trên ứng dụng Zalo.
            </p>
        </field>
    </record>
</odoo>
