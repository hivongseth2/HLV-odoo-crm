  "item": [
    {
      "name": "1. Category API",
      "item": [
        {
          "name": "1.1 POST Categories List",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has success=true', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data).to.have.property('categories');",
                  "    pm.expect(json.data).to.have.property('total');",
                  "});",
                  "pm.test('Categories have required fields', () => {",
                  "    const cats = pm.response.json().data.categories;",
                  "    if (cats.length > 0) {",
                  "        pm.expect(cats[0]).to.have.all.keys('id', 'x_misa_id', 'name', 'sequence', 'parent_id', 'parent_name', 'image_url');",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"limit\": 10,\n  \"offset\": 0\n}" },
            "url": {
              "raw": "{{base_url}}/api/v1/zalo/categories/list",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "zalo", "categories", "list"]
            }
          }
        },
        {
          "name": "1.2 POST Products by Category",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has products', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data).to.have.property('products');",
                  "    pm.expect(json.data).to.have.property('category_id');",
                  "    pm.expect(json.data).to.have.property('category_name');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"category_id\": 1,\n  \"limit\": 10,\n  \"offset\": 0\n}" },
            "url": {
              "raw": "{{base_url}}/api/v1/zalo/categories/products",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "zalo", "categories", "products"]
            }
          }
        },
        {
          "name": "1.3 POST Category Not Found",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));",
