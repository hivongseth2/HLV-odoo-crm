<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cronjob tự động đồng bộ trạng thái các đơn hàng Zalo chờ xử lý (Pending) sang Zalo SDK Server -->
        <record id="cron_zalo_auto_sync_payment_status" model="ir.cron">
            <field name="name">Zalo Mini App: Tự động đồng bộ trạng thái thanh toán</field>
            <field name="model_id" ref="model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_pending_zalo_orders()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Cronjob tự động đồng bộ trạng thái hoàn tiền Zalo đang chờ xử lý -->
        <record id="cron_zalo_auto_sync_refund_status" model="ir.cron">
            <field name="name">Zalo Mini App: Tự động đồng bộ trạng thái hoàn tiền</field>
            <field name="model_id" ref="model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_pending_zalo_refunds()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
