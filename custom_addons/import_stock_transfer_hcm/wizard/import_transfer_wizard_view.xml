<odoo>
    <record id="view_import_transfer_wizard_form" model="ir.ui.view">
        <field name="name">import.transfer.wizard.form</field>
        <field name="model">import.transfer.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Stock Transfers for HCM">
                <group>
                    <field name="warehouse_id"/>
                    <field name="excel_hcm_keyword"/>
                    <field name="file" filename="filename"/>
                    <field name="filename"/>
                </group>
                <footer>
                    <button name="action_import" string="Import" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
