<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_hlv_pack_station_list" model="ir.ui.view">
    <field name="name">hlv.pack.station.list</field>
    <field name="model">hlv.pack.station</field>
    <field name="arch" type="xml">
      <list>
        <field name="warehouse_id"/>
        <field name="name"/>
        <field name="station_key"/>
        <field name="camera_count" string="Camera"/>
        <field name="agent_status" widget="badge"
               decoration-success="agent_status == 'alive'"
               decoration-danger="agent_status != 'alive'"/>
        <field name="camera_sync_warning" string="Camera agent chưa có URL" optional="show"/>
        <field name="agent_last_seen"/>
        <field name="agent_version"/>
      </list>
    </field>
  </record>

  <record id="view_hlv_pack_station_form" model="ir.ui.view">
    <field name="name">hlv.pack.station.form</field>
    <field name="model">hlv.pack.station</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_generate_enroll_code" type="object" string="Tạo mã cài đặt"
                  class="btn-primary"/>
          <button name="action_reset_token" type="object" string="Sinh token mới"
                  confirm="Agent đang chạy sẽ bị từ chối cho tới khi anh cập nhật token mới vào file cấu hình của nó. Tiếp tục?"/>
        </header>
        <sheet>
          <widget name="web_ribbon" title="Đã lưu trữ" bg_color="text-bg-danger"
                  invisible="active"/>
          <group>
            <group>
              <field name="name" placeholder="Bàn 1"/>
              <field name="warehouse_id"/>
              <field name="active" invisible="1"/>
            </group>
            <group>
              <field name="station_key"/>
              <field name="agent_token" password="True"/>
              <field name="agent_status"/>
              <field name="agent_last_seen"/>
              <field name="agent_version"/>
            </group>
          </group>
          <div invisible="not enroll_code">
            <div class="alert alert-success" role="alert">
              <b>Mã cài đặt:</b>
              <field name="enroll_code" readonly="1" nolabel="1" class="oe_inline"/>
              — hết hạn lúc
              <field name="enroll_code_expiry" readonly="1" nolabel="1" class="oe_inline"/>.
              Gõ mã này khi script hỏi.
            </div>

            <div class="alert alert-secondary" role="alert">
              <h5 class="mb-1">🪟 Máy đóng gói chạy Windows</h5>
              <div class="text-muted mb-2">
                Mở <b>PowerShell</b> (chuột phải &#8594; Run as administrator nếu muốn
                nhân viên không tắt được agent) rồi dán:
              </div>
              <field name="setup_command" readonly="1" nolabel="1" widget="CopyClipboardChar"/>
            </div>

            <div class="alert alert-secondary" role="alert">
              <h5 class="mb-1">🐧 Máy đóng gói chạy Linux</h5>
              <div class="text-muted mb-2">
                Mở <b>Terminal</b> rồi dán:
              </div>
              <field name="setup_command_linux" readonly="1" nolabel="1" widget="CopyClipboardChar"/>
            </div>

            <div class="alert alert-warning" role="alert">
              Hai lệnh trên <b>không thay thế nhau được</b>. Dán lệnh Linux vào
              PowerShell sẽ báo <code>The token '&amp;&amp;' is not a valid statement
              separator</code>; dán lệnh Windows vào Terminal sẽ báo
              <code>$env: command not found</code>. Lấy đúng khối theo hệ điều hành
              của máy đóng gói.
            </div>
          </div>
          <div class="alert alert-info" role="alert" invisible="enroll_code">
            Bấm <b>Tạo mã cài đặt</b> ở trên để lấy lệnh cài cho máy đóng gói.
            Hoặc nếu agent đã cài rồi, chỉ cần mở <code>/pack_recorder/set_station</code>
            trên máy đó và chọn bàn này.
          </div>
          <div class="alert alert-danger" role="alert" invisible="not camera_sync_warning">
            <b>Agent chưa biết URL của camera:</b>
            <field name="camera_sync_warning" readonly="1" nolabel="1" class="oe_inline"/>
            <br/>
            Camera này đã khai trong Odoo nhưng chưa có trong file cấu hình của agent,
            nên phiếu đóng gói ở bàn này sẽ <b>thiếu video của camera đó</b>.
            Bấm <b>Tạo mã cài đặt</b> rồi chạy lại lệnh cài trên máy đóng gói — Odoo
            cố ý không giữ URL camera nên không tự đẩy xuống được.
          </div>
          <notebook>
            <page string="Camera">
              <field name="camera_ids">
                <list editable="bottom">
                  <field name="sequence" widget="handle"/>
                  <field name="name"/>
                  <field name="code"/>
                  <field name="active"/>
                </list>
              </field>
              <p class="text-muted">
                <b>Mã camera</b> phải trùng khoá trong file cấu hình của agent. Odoo cố ý
                không lưu URL hay mật khẩu camera — agent tự giữ.
              </p>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_hlv_pack_station" model="ir.actions.act_window">
    <field name="name">Bàn đóng gói</field>
    <field name="res_model">hlv.pack.station</field>
    <field name="view_mode">list,form</field>
  </record>

</odoo>
