<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_misa_product_import_form" model="ir.ui.view">
        <field name="name">misa.product.import.form</field>
        <field name="model">misa.product.import</field>
        <field name="arch" type="xml">
            <form string="Import SP từ MISA CRM">
                <header>
                    <button string="Tìm trên CRM" name="action_search_crm"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button string="Tạo sản phẩm" name="action_create_product"
                            type="object" class="btn-primary"
                            invisible="state != 'found'"/>
                    <button string="Xem sản phẩm" name="action_open_product"
                            type="object" class="btn-success"
                            invisible="not product_id"/>
                    <button string="Làm lại" name="action_reset"
                            type="object" class="btn-secondary"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,found,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Nhập mã sản phẩm (VD: BT60G)"
                                   readonly="state != 'draft'"/>
                        </h1>
                    </div>
                    <group invisible="not result_message">
                        <field name="result_message"/>
                    </group>
                    <group string="Thông tin từ MISA CRM" invisible="not crm_product_name">
                        <group>
                            <field name="crm_product_name"/>
                            <field name="crm_product_code"/>
                            <field name="crm_product_price"/>
                            <field name="crm_misa_id"/>
                        </group>
                        <group>
                            <field name="crm_product_unit"/>
                            <field name="crm_product_category"/>
                            <field name="crm_product_tax"/>
                        </group>
                    </group>
                    <group string="Sản phẩm Odoo" invisible="not product_id">
                        <field name="product_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_misa_product_import_tree" model="ir.ui.view">
        <field name="name">misa.product.import.tree</field>
        <field name="model">misa.product.import</field>
        <field name="arch" type="xml">
            <list string="Import SP từ MISA CRM">
                <field name="name"/>
                <field name="crm_product_name"/>
                <field name="crm_product_price"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'found'"
                       decoration-success="state == 'done'"
                       decoration-danger="state in ('not_found','error')"
                       decoration-muted="state == 'exists'"/>
                <field name="product_id"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_misa_product_import" model="ir.actions.act_window">
        <field name="name">Import SP từ MISA</field>
        <field name="res_model">misa.product.import</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu: đặt dưới Inventory > Operations -->
    <menuitem id="menu_misa_product_import"
              name="Import SP từ MISA CRM"
              action="action_misa_product_import"
              parent="stock.menu_stock_warehouse_mgmt"
              sequence="99"/>
</odoo>
