<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard Form View -->
    <record id="view_misa_product_import_wizard_form" model="ir.ui.view">
        <field name="name">misa.product.import.wizard.form</field>
        <field name="model">misa.product.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import sản phẩm từ MISA CRM">
                <group invisible="state != 'draft'">
                    <field name="product_code" placeholder="Nhập mã sản phẩm (VD: BT60G)"/>
                </group>
                <group invisible="state != 'done'">
                    <field name="result_message" widget="text"/>
                    <separator string="Thông tin từ CRM" invisible="not crm_product_name"/>
                    <field name="crm_product_name" invisible="not crm_product_name"/>
                    <field name="crm_product_code" invisible="not crm_product_code"/>
                    <field name="crm_product_price" invisible="not crm_product_name"/>
                    <field name="crm_product_unit" invisible="not crm_product_unit"/>
                    <field name="crm_product_category" invisible="not crm_product_category"/>
                    <field name="crm_product_tax" invisible="not crm_product_tax"/>
                    <field name="crm_misa_id" invisible="not crm_misa_id"/>
                </group>
                <field name="state" invisible="1"/>
                <footer>
                    <button string="Tìm &amp; Tạo sản phẩm" name="action_search_and_import"
                            type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button string="Đóng" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open the wizard -->
    <record id="action_misa_product_import_wizard" model="ir.actions.act_window">
        <field name="name">Import SP từ MISA</field>
        <field name="res_model">misa.product.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu item under Inventory -->
    <menuitem id="menu_misa_product_import"
              name="Import SP từ MISA CRM"
              action="action_misa_product_import_wizard"
              parent="stock.menu_stock_config_settings"
              sequence="99"/>
</odoo>
