<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="report_package_label_document">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="o">
        <t t-set="levels" t-value="o.package_level_ids.sorted('id')" />
        <t t-set="total" t-value="len(levels)" />
        <t t-foreach="levels" t-as="pl">
          <div class="page">
            <div style="font-size:24px; font-weight:700;">
              <t t-esc="('%s/%s' % (pl.pack_sequence or 0, pl.pack_total or total))"/>
            </div>
            <div style="margin: 8px 0 2px 0;">
              <span style="font-size: 12px; color:#555;">Picking:</span>
              <span t-esc="o.name"/>
            </div>
            <div style="margin: 0 0 8px 0;">
              <span style="font-size: 12px; color:#555;">Package:</span>
              <span t-esc="pl.package_id.name"/>
            </div>
            <!-- Barcode for the package name (Code128) -->
            <div>
              <span t-field="pl.package_id.name" t-options='{"widget": "barcode", "type": "Code128", "displayValue": True, "quiet": 1}'/>
            </div>
            <div style="margin-top:10px; font-size:12px;">
              <t t-if="o.partner_id">
                <div t-esc="o.partner_id.display_name"/>
                <div t-esc="o.partner_id.contact_address"/>
              </t>
            </div>
          </div>
        </t>
      </t>
    </t>
  </template>
</odoo>