<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="report_package_label_document">
    <t t-call="web.html_container">
    <t t-call="web.report_layout">

      <t t-set="BASE"
         t-value="(web_base_url or env['ir.config_parameter'].sudo().get_param('report.url')
                   or env['ir.config_parameter'].sudo().get_param('web.base.url') or '')"/>

      <style type="text/css">
        @font-face{
          font-family:"VNFont";
          src:url("<t t-esc='BASE'/>/hlv_pack_sequence/static/fonts/NotoSans-Regular.ttf") format("truetype");
          font-weight:400; font-style:normal;
        }
        @font-face{
          font-family:"VNFont";
          src:url("<t t-esc='BASE'/>/hlv_pack_sequence/static/fonts/NotoSans-Bold.ttf") format("truetype");
          font-weight:700; font-style:normal;
        }
        .hlv, .hlv *{ font-family:"VNFont", Arial, sans-serif !important; }

        /* 1 pack / trang */
        .sheet{ padding:16px 12px 22px 12px; page-break-after: always; }
        .label{ border:1px solid #111; border-radius:6px; padding:12px 14px; box-shadow:0 0 0 1px #111 inset; }

        /* Header: trái = seq+source, giữa = barcode pack, phải = QR source */
        .top{
          display:grid;
          grid-template-columns: auto 1fr auto; /* barcode nằm cột giữa */
          column-gap:16px;
          align-items:center;
        }
        .seq{ font-size:28px; font-weight:700; line-height:1; }
        .muted{ color:#666; font-size:12px; }

        .barcode-center{
          justify-self:center; /* đẩy barcode vào giữa thật sự */
          display:flex; flex-direction:column; align-items:center; gap:4px;
          max-width:100%;
        }
        .barcode-center .caption{ font-size:12px; font-weight:700; word-break:break-all; }

        .qrcode{ justify-self:end; }

        /* Info box */
        .info{
          display:grid; grid-template-columns: 1fr 1fr; gap:8px 18px; margin-top:10px;
          border:1px solid #ddd; border-radius:4px; padding:8px; background:#fafafa; font-size:12px;
        }
        .title{ font-weight:700; margin-bottom:3px; }

        /* Items table */
        table.items{ width:100%; border-collapse:collapse; margin-top:10px; font-size:12px; }
        .items th, .items td{ border:1px solid #111; padding:4px 6px; vertical-align:top; }
        .items th{ background:#f0f0f0; font-weight:700; text-align:left; }
        .items td.qty, .items th.qty{ width:22%; text-align:right; white-space:nowrap; }
        .items tfoot td{ font-weight:700; }

        .foot{ display:flex; justify-content:space-between; gap:10px; margin-top:10px; font-size:12px;
               border-top:1px dashed #aaa; padding-top:6px; }
      </style>

      <!-- docs = stock.picking -->
      <t t-foreach="docs" t-as="o">
        <t t-set="packs" t-value="o.package_ids.sorted('id')"/>
        <t t-set="total" t-value="len(packs)"/>

        <!-- Mỗi pack = 1 trang -->
        <t t-foreach="packs" t-as="pack">
          <t t-set="lines" t-value="[ml for ml in o.move_line_ids if ml.result_package_id and ml.result_package_id.id == pack.id]"/>
          <t t-set="qty"   t-value="sum([l.qty_done for l in lines])"/>
          <t t-set="w"     t-value="(pack.shipping_weight or pack.weight or 0.0)"/>

          <div class="sheet hlv">
            <div class="label">

              <!-- HEADER -->
              <div class="top">
                <!-- Trái: số thứ tự và Source -->
                <div>
                  <div class="seq"><t t-esc="('%s/%s' % (pack.pack_sequence or 0, pack.pack_total or total))"/></div>
                  <div class="muted">Source: <t t-esc="(o.origin or o.name)"/></div>
                </div>

                <!-- Giữa: BARCODE mã kiện + caption tên kiện -->
                <div class="barcode-center">
                  <span t-field="pack.name"
                        t-options='{"widget":"barcode","type":"Code128","displayValue":False,"quiet":1}'/>
                  <div class="caption" t-esc="pack.name"/>
                </div>

                <!-- Phải: QR mã đơn nguồn (ưu tiên origin, rỗng thì name) -->
                <div class="qrcode">
                  <t t-if="o.origin">
                    <span t-field="o.origin"
                          t-options='{"widget":"barcode","type":"QR","displayValue":False, "width":96, "height":96, "quiet":1}'/>
                  </t>
                  <t t-else="">
                    <span t-field="o.name"
                          t-options='{"widget":"barcode","type":"QR","displayValue":False, "width":96, "height":96, "quiet":1}'/>
                  </t>
                </div>
              </div>

              <!-- Người gửi / Người nhận -->
              <div class="info">
                <div>
                  <div class="title">Người gửi</div>
                  <div><t t-esc="o.company_id.name or ''"/></div>
                  <div class="muted" t-if="o.company_id.phone">ĐT: <t t-esc="o.company_id.phone"/></div>
                  <div class="muted" t-if="o.company_id.partner_id"><t t-esc="o.company_id.partner_id.contact_address or ''"/></div>
                </div>
                <div>
                  <div class="title">Người nhận</div>
                  <div><t t-esc="o.partner_id.name or ''"/></div>
                  <div class="muted" t-if="o.partner_id.phone">ĐT: <t t-esc="o.partner_id.phone"/></div>
                  <div class="muted" t-if="o.partner_id.contact_address"><t t-esc="o.partner_id.contact_address"/></div>
                </div>
              </div>

              <!-- Bảng sản phẩm của kiện -->
              <table class="items" t-if="lines">
                <thead><tr><th>Sản phẩm</th><th class="qty">Số lượng</th></tr></thead>
                <tbody>
                  <t t-foreach="lines" t-as="ml">
                    <tr>
                      <td><t t-esc="ml.product_id.display_name"/></td>
                      <td class="qty"><t t-esc="ml.qty_done"/> <t t-esc="ml.product_uom_id.name"/></td>
                    </tr>
                  </t>
                </tbody>
                <tfoot><tr><td>Tổng</td><td class="qty"><t t-esc="qty"/></td></tr></tfoot>
              </table>

              <!-- Footer -->
              <div class="foot">
                <div><b>Dịch vụ:</b> Chuyển phát đường bộ</div>
                <div><b>Trọng lượng kiện (kg):</b> <t t-esc="('%.3f' % w)"/></div>
              </div>

            </div>
          </div>
        </t>
      </t>

    </t>
    </t>
  </template>
</odoo>
