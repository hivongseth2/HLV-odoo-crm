<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Labels: 2 packages per page
       - Center column: BARCODE = pack.name (Code128) + caption (pack.name)
       - Right column: ONLY QR = source (o.origin fallback o.name)
       - Clean table for items, pkg weight, sender/receiver boxes
       - Uses both web.html_container and web.report_layout as requested -->
  <template id="report_package_label_document">
    <t t-call="web.html_container">
    <t t-call="web.report_layout">

      <!-- Base URL for loading fonts -->
      <t t-set="BASE"
         t-value="(web_base_url or env['ir.config_parameter'].sudo().get_param('report.url')
                   or env['ir.config_parameter'].sudo().get_param('web.base.url') or '')"/>

      <style type="text/css">
        /* Vietnamese-safe font */
        @font-face{
          font-family:"VNFont";
          src:url("<t t-esc='BASE'/>/hlv_pack_sequence/static/fonts/NotoSans-Regular.ttf") format("truetype");
          font-weight:400; font-style:normal;
        }
        @font-face{
          font-family:"VNFont";
          src:url("<t t-esc='BASE'/>/hlv_pack_sequence/static/fonts/NotoSans-Bold.ttf") format("truetype");
          font-weight:700; font-style:normal;
        }
        .hlv, .hlv *{ font-family:"VNFont", Arial, sans-serif !important; }

        /* Page with 2 labels */
        .sheet{ display:flex; gap:18px; padding:14px 10px 22px 10px; page-break-after: always; }
        .label{
          flex:1 0 0; border:1px solid #111; border-radius:6px; padding:10px 12px;
          box-shadow: 0 0 0 1px #111 inset;
        }

        /* Header: 3 columns -> (seq) | (barcode+caption) | (QR) */
        .top{
          display:grid; grid-template-columns: 1fr auto auto; column-gap:14px; align-items:center;
        }
        .seq{ font-size:28px; font-weight:700; line-height:1; }
        .muted{ color:#666; }
        .code128, .qrcode{ display:block; }
        .code128{ margin:0; }
        .pack-caption{ font-size:12px; font-weight:700; text-align:center; }

        /* Sender/Receiver box */
        .info{
          display:grid; grid-template-columns: 1fr 1fr; gap:8px 18px; margin-top:8px;
          border:1px solid #ddd; border-radius:4px; padding:8px; background:#fafafa;
        }
        .title{ font-weight:700; margin-bottom:3px; }

        /* Items table */
        table.items{ width:100%; border-collapse:collapse; margin-top:8px; font-size:12px; }
        .items th, .items td{ border:1px solid #111; padding:4px 6px; vertical-align:top; }
        .items th{ background:#f0f0f0; font-weight:700; text-align:left; }
        .items td.qty, .items th.qty{ width:22%; text-align:right; white-space:nowrap; }
        .items tfoot td{ font-weight:700; }

        /* Footer */
        .foot{
          display:flex; justify-content:space-between; gap:10px; margin-top:8px; font-size:12px;
          border-top:1px dashed #aaa; padding-top:6px;
        }
      </style>

      <!-- docs = stock.picking -->
      <t t-foreach="docs" t-as="o">
        <t t-set="packs" t-value="o.package_ids.sorted('id')"/>
        <t t-set="total" t-value="len(packs)"/>

        <!-- i = 0,2,4,... each loop prints one page (2 labels) -->
        <t t-foreach="range(0, total, 2)" t-as="i">
          <div class="sheet hlv">

            <!-- ===== Left label ===== -->
            <t t-set="p1" t-value="packs[i]"/>
            <t t-set="lines1" t-value="[ml for ml in o.move_line_ids if ml.result_package_id and ml.result_package_id.id == p1.id]"/>
            <t t-set="qty1"   t-value="sum([l.qty_done for l in lines1])"/>
            <t t-set="w1"     t-value="(p1.shipping_weight or p1.weight or 0.0)"/>
            <t t-set="src1"   t-value="(o.origin or o.name)"/>
            <!-- URL-encode for QR -->
            <t t-set="qr1"    t-value="(src1 or '').replace('%','%25').replace(' ', '%20').replace('&','%26').replace('#','%23').replace('/','%2F').replace('+','%2B').replace('?','%3F')"/>

            <div class="label">
              <!-- Header -->
              <div class="top">
                <!-- col 1: X/Y (remove Source text to keep right column clean) -->
                <div class="seq">
                  <div><t t-esc="('%s/%s' % (p1.pack_sequence or 0, p1.pack_total or total))"/></div>
                </div>

                <!-- col 2: pack barcode + caption -->
                <div style="display:flex; flex-direction:column; align-items:center; gap:4px;">
                  <span class="code128">
                    <span t-field="p1.name"
                          t-options='{"widget":"barcode","type":"Code128","displayValue":False,"quiet":1}'/>
                  </span>
                  <div class="pack-caption" t-esc="p1.name"/>
                </div>

                <!-- col 3: ONLY QR of source -->
                <div class="qrcode">
                  <img t-att-src="'/report/barcode/?type=QR&amp;value=' + qr1 + '&amp;width=90&amp;height=90'"/>
                </div>
              </div>

              <!-- Sender / Receiver -->
              <div class="info">
                <div>
                  <div class="title">Người gửi</div>
                  <div><t t-esc="o.company_id.name or ''"/></div>
                  <div class="muted" t-if="o.company_id.phone">ĐT: <t t-esc="o.company_id.phone"/></div>
                  <div class="muted" t-if="o.company_id.partner_id">
                    <t t-esc="o.company_id.partner_id.contact_address or ''"/>
                  </div>
                </div>
                <div>
                  <div class="title">Người nhận</div>
                  <div><t t-esc="o.partner_id.name or ''"/></div>
                  <div class="muted" t-if="o.partner_id.phone">ĐT: <t t-esc="o.partner_id.phone"/></div>
                  <div class="muted" t-if="o.partner_id.contact_address"><t t-esc="o.partner_id.contact_address"/></div>
                </div>
              </div>

              <!-- Items in package -->
              <table class="items" t-if="lines1">
                <thead>
                  <tr><th>Sản phẩm</th><th class="qty">Số lượng</th></tr>
                </thead>
                <tbody>
                  <t t-foreach="lines1" t-as="ml">
                    <tr>
                      <td><t t-esc="ml.product_id.display_name"/></td>
                      <td class="qty"><t t-esc="ml.qty_done"/> <t t-esc="ml.product_uom_id.name"/></td>
                    </tr>
                  </t>
                </tbody>
                <tfoot>
                  <tr><td>Tổng</td><td class="qty"><t t-esc="qty1"/></td></tr>
                </tfoot>
              </table>

              <!-- Footer -->
              <div class="foot">
                <div><b>Dịch vụ:</b> Chuyển phát đường bộ</div>
                <div><b>Trọng lượng kiện (kg):</b> <t t-esc="('%.3f' % w1)"/></div>
              </div>
            </div>

            <!-- ===== Right label (if exists) ===== -->
            <t t-if="i + 1 &lt; total">
              <t t-set="p2" t-value="packs[i+1]"/>
              <t t-set="lines2" t-value="[ml for ml in o.move_line_ids if ml.result_package_id and ml.result_package_id.id == p2.id]"/>
              <t t-set="qty2"   t-value="sum([l.qty_done for l in lines2])"/>
              <t t-set="w2"     t-value="(p2.shipping_weight or p2.weight or 0.0)"/>
              <t t-set="src2"   t-value="(o.origin or o.name)"/>
              <t t-set="qr2"    t-value="(src2 or '').replace('%','%25').replace(' ', '%20').replace('&','%26').replace('#','%23').replace('/','%2F').replace('+','%2B').replace('?','%3F')"/>

              <div class="label">
                <div class="top">
                  <div class="seq">
                    <div><t t-esc="('%s/%s' % (p2.pack_sequence or 0, p2.pack_total or total))"/></div>
                  </div>

                  <div style="display:flex; flex-direction:column; align-items:center; gap:4px;">
                    <span class="code128">
                      <span t-field="p2.name"
                            t-options='{"widget":"barcode","type":"Code128","displayValue":False,"quiet":1}'/>
                    </span>
                    <div class="pack-caption" t-esc="p2.name"/>
                  </div>

                  <div class="qrcode">
                    <img t-att-src="'/report/barcode/?type=QR&amp;value=' + qr2 + '&amp;width=90&amp;height=90'"/>
                  </div>
                </div>

                <div class="info">
                  <div>
                    <div class="title">Người gửi</div>
                    <div><t t-esc="o.company_id.name or ''"/></div>
                    <div class="muted" t-if="o.company_id.phone">ĐT: <t t-esc="o.company_id.phone"/></div>
                    <div class="muted" t-if="o.company_id.partner_id">
                      <t t-esc="o.company_id.partner_id.contact_address or ''"/>
                    </div>
                  </div>
                  <div>
                    <div class="title">Người nhận</div>
                    <div><t t-esc="o.partner_id.name or ''"/></div>
                    <div class="muted" t-if="o.partner_id.phone">ĐT: <t t-esc="o.partner_id.phone"/></div>
                    <div class="muted" t-if="o.partner_id.contact_address"><t t-esc="o.partner_id.contact_address"/></div>
                  </div>
                </div>

                <table class="items" t-if="lines2">
                  <thead>
                    <tr><th>Sản phẩm</th><th class="qty">Số lượng</th></tr>
                  </thead>
                  <tbody>
                    <t t-foreach="lines2" t-as="ml">
                      <tr>
                        <td><t t-esc="ml.product_id.display_name"/></td>
                        <td class="qty"><t t-esc="ml.qty_done"/> <t t-esc="ml.product_uom_id.name"/></td>
                      </tr>
                    </t>
                  </tbody>
                  <tfoot>
                    <tr><td>Tổng</td><td class="qty"><t t-esc="qty2"/></td></tr>
                  </tfoot>
                </table>

                <div class="foot">
                  <div><b>Dịch vụ:</b> Chuyển phát đường bộ</div>
                  <div><b>Trọng lượng kiện (kg):</b> <t t-esc="('%.3f' % w2)"/></div>
                </div>
              </div>
            </t>

          </div>
        </t>
      </t>

    </t>
    </t>
  </template>
</odoo>
