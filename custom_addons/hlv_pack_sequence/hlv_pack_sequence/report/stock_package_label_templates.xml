<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="report_package_label_document">
    <t t-call="web.html_container">

      <style type="text/css">
        .hlv-label { font-family:"DejaVu Sans",sans-serif !important; }
        .hlv-label .header { display:flex; justify-content:space-between; align-items:flex-start; }
        .hlv-label .big-seq { font-size:32px; font-weight:700; }
        .hlv-label .barcode { margin:6px 0; }
        .hlv-label .addr { margin-top:10px; font-size:14px; font-weight:600; }
        .hlv-label .addr div { margin-bottom:2px; }
        .hlv-label .footer { margin-top:12px; font-size:12px; }
      </style>

      <t t-foreach="docs" t-as="o">
        <t t-set="packs" t-value="o.package_ids.sorted('id')"/>
        <t t-set="total" t-value="len(packs)"/>

        <t t-foreach="packs" t-as="pack">
          <div class="page hlv-label">
            
            <!-- Header: số kiện & barcode đơn hàng -->
            <div class="header">
              <div class="big-seq">
                <t t-esc="('%s/%s' % (pack.pack_sequence or 0, pack.pack_total or total))"/>
              </div>
              <div class="barcode">
                <span t-field="o.name"
                      t-options='{"widget":"barcode","type":"Code128","displayValue":True,"quiet":1}'/>
              </div>
            </div>

            <!-- Người gửi -->
            <div style="font-size:12px; margin-top:6px;">
              <div><b>Người gửi:</b> <t t-esc="o.company_id.name or ''"/></div>
              <div t-if="o.company_id.phone"><b>Điện thoại:</b> <t t-esc="o.company_id.phone"/></div>
            </div>

            <!-- Người nhận -->
            <div class="addr">
              <div><b>Người nhận:</b> <t t-esc="o.partner_id.name or ''"/></div>
              <div t-if="o.partner_id.phone"><b>Điện thoại:</b> <t t-esc="o.partner_id.phone"/></div>
              <div t-if="o.partner_id.street"><t t-esc="o.partner_id.contact_address"/></div>
            </div>

            <!-- Footer: dịch vụ + trọng lượng -->
            <div class="footer">
              <div><b>Dịch vụ:</b> Chuyển phát đường bộ</div>
              <div><b>Trọng lượng (kg):</b> 
                <t t-esc="('%.3f' % (o.weight or 0.0))"/>
              </div>
            </div>

          </div>
        </t>
      </t>

    </t>
  </template>
</odoo>
