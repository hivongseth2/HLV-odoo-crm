<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Delivery Order labels: 2 packages per page -->
  <template id="report_package_label_document">
    <!-- dùng layout chuẩn (đã có meta utf-8, margins) -->
    <t t-call="web.html_container">
    <t t-call="web.report_layout">

      <!-- URL tuyệt đối để wkhtmltopdf tải font -->
      <t t-set="BASE"
         t-value="(web_base_url or env['ir.config_parameter'].sudo().get_param('report.url')
                   or env['ir.config_parameter'].sudo().get_param('web.base.url') or '')"/>

      <style type="text/css">
        /* FONT: sửa path đúng /hlv_pack_sequence/static/... */
        @font-face{
          font-family:"VNFont";
          src:url("<t t-esc='BASE'/>/hlv_pack_sequence/static/fonts/NotoSans-Regular.ttf") format("truetype");
          font-weight:400; font-style:normal;
        }
        @font-face{
          font-family:"VNFont";
          src:url("<t t-esc='BASE'/>/hlv_pack_sequence/static/fonts/NotoSans-Bold.ttf") format("truetype");
          font-weight:700; font-style:normal;
        }
        .hlv, .hlv *{ font-family:"VNFont", sans-serif !important; }
        .hlv b, .hlv strong{ font-weight:700; }

        /* Trang: 2 nhãn / trang */
        .sheet{ display:flex; gap:20px; padding:16px 12px 24px 12px; page-break-after: always; }
        .label{ flex:1 0 0; border:0; padding:4px 8px; }
        .hdr{ display:flex; justify-content:space-between; align-items:flex-start; }
        .seq{ font-size:30px; font-weight:700; }
        .bc{ margin:4px 0 6px 0; }
        .line{ font-size:12px; color:#222; margin:2px 0; }
        .addr{ margin-top:6px; }
        .foot{ margin-top:10px; font-size:12px; }
      </style>

      <!-- docs = stock.picking -->
      <t t-foreach="docs" t-as="o">
        <t t-set="packs" t-value="o.package_ids.sorted('id')"/>
        <t t-set="total" t-value="len(packs)"/>

        <!-- duyệt theo cặp: i = 0,2,4,... -->
        <t t-foreach="range(0, total, 2)" t-as="i">
          <div class="sheet hlv">
            <!-- Nhãn bên trái -->
            <t t-set="p1" t-value="packs[i]"/>
            <div class="label">
              <div class="hdr">
                <div class="seq"><t t-esc="('%s/%s' % (p1.pack_sequence or 0, p1.pack_total or total))"/></div>
                <div class="bc">
                  <!-- barcode: số đơn hàng -->
                  <span t-field="o.name"
                        t-options='{"widget":"barcode","type":"Code128","displayValue":True,"quiet":1}'/>
                </div>
              </div>
              <div class="line"><b>Người gửi:</b> <span t-esc="o.company_id.name or ''"/></div>
              <div class="line" t-if="o.company_id.phone"><b>Điện thoại:</b> <span t-esc="o.company_id.phone"/></div>

              <div class="addr">
                <div class="line"><b>Người nhận:</b> <span style="font-weight:700;" t-esc="o.partner_id.name or ''"/></div>
                <div class="line" t-if="o.partner_id.phone"><b>Điện thoại:</b> <span t-esc="o.partner_id.phone"/></div>
                <div class="line" t-if="o.partner_id.contact_address"><span t-esc="o.partner_id.contact_address"/></div>
              </div>

              <div class="foot">
                <div><b>Dịch vụ:</b> Chuyển phát đường bộ</div>
                <div><b>Trọng lượng (kg):</b> <t t-esc="('%.3f' % (o.weight or 0.0))"/></div>
              </div>
            </div>

            <!-- Nhãn bên phải (nếu còn) -->
            <t t-if="i + 1 &lt; total">
              <t t-set="p2" t-value="packs[i+1]"/>
              <div class="label">
                <div class="hdr">
                  <div class="seq"><t t-esc="('%s/%s' % (p2.pack_sequence or 0, p2.pack_total or total))"/></div>
                  <div class="bc">
                    <span t-field="o.name"
                          t-options='{"widget":"barcode","type":"Code128","displayValue":True,"quiet":1}'/>
                  </div>
                </div>
                <div class="line"><b>Người gửi:</b> <span t-esc="o.company_id.name or ''"/></div>
                <div class="line" t-if="o.company_id.phone"><b>Điện thoại:</b> <span t-esc="o.company_id.phone"/></div>

                <div class="addr">
                  <div class="line"><b>Người nhận:</b> <span style="font-weight:700;" t-esc="o.partner_id.name or ''"/></div>
                  <div class="line" t-if="o.partner_id.phone"><b>Điện thoại:</b> <span t-esc="o.partner_id.phone"/></div>
                  <div class="line" t-if="o.partner_id.contact_address"><span t-esc="o.partner_id.contact_address"/></div>
                </div>

                <div class="foot">
                  <div><b>Dịch vụ:</b> Chuyển phát đường bộ</div>
                  <div><b>Trọng lượng (kg):</b> <t t-esc="('%.3f' % (o.weight or 0.0))"/></div>
                </div>
              </div>
            </t>
          </div>
        </t>
      </t>
    </t>
    </t>
  </template>
</odoo>
