<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="report_package_label_document">
    <t t-call="web.html_container">
    <t t-call="web.report_layout">

      <style type="text/css">
          @font-face{
          font-family:"VNFont";
          src:url("<t t-esc='BASE'/>/hlv_pack_sequence/static/fonts/NotoSans-Regular.ttf") format("truetype");
          font-weight:400; font-style:normal;
        }
        @font-face{
          font-family:"VNFont";
          src:url("<t t-esc='BASE'/>/hlv_pack_sequence/static/fonts/NotoSans-Bold.ttf") format("truetype");
          font-weight:700; font-style:normal;
        }
        .hlv, .hlv *{ font-family:"VNFont", Arial, sans-serif !important; }

        .sheet{ padding:16px 12px 22px 12px; page-break-after: always; }
        .label{ border:1px solid #111; border-radius:6px; padding:12px 14px; }

        .seq { font-size:26px; font-weight:700; margin-bottom:8px; }

      

        .barcode-pack, .qr { text-align:center; }
        .caption { margin-top:4px; font-size:12px; font-weight:700; text-align:center; word-break:break-word; }
        /* 2 cột: trái = barcode (2 phần), phải = QR (1 phần) */

        /* tỉ lệ 2:1 rõ ràng, không co rớt hàng */
      .codes-table{
            width:100%; border-collapse:collapse; table-layout:fixed;
          }
          .codes-table td{
            vertical-align:top; text-align:center;
          }

          /* barcode bên trái chiếm 70% */
          .col-barcode{ width:70%; padding:4px; }
          /* qr bên phải chiếm 30% */
          .col-qr{ width:30%; padding:4px; }

          .barcode-pack svg, .barcode-pack img{
            width:100%; height:80px;
          }
          .col-qr img{ width:100px; height:100px; }
          .caption{ margin-top:4px; font-size:12px; font-weight:700; }

        /* barcode (widget tạo SVG) chiếm full chiều ngang cột trái */
        .barcode-pack{ width:100%; display:flex; justify-content:center; }
        .barcode-pack svg, .barcode-pack img{ width:100%; max-width:560px; height:84px; display:block; }

        /* QR cố định kích thước, nằm giữa cột phải */
        .qr img{ width:110px; height:110px; display:block; }

        .caption{ margin-top:4px; font-size:12px; font-weight:700; text-align:center; word-break:break-word; }

        /* sequence ở trên cùng, cách hàng 2 cột một chút */
        .seq { font-size:26px; font-weight:700; margin-bottom:8px; }

        .info{
          margin-top:10px;
          display:grid; grid-template-columns: 1fr 1fr;
          gap:10px 18px;
          border:1px solid #ddd; border-radius:4px;
          padding:8px; background:#fafafa; font-size:12px;
        }
        .title{ font-weight:700; margin-bottom:3px; }

        table.items{ width:100%; border-collapse:collapse; margin-top:10px; font-size:12px; }
        .items th, .items td{ border:1px solid #111; padding:4px 6px; vertical-align:top; }
        .items th{ background:#f0f0f0; font-weight:700; text-align:left; }
        .items td.qty{ text-align:right; white-space:nowrap; }
        .items tfoot td{ font-weight:700; }

        .foot{ display:flex; justify-content:space-between; margin-top:10px; font-size:12px;
               border-top:1px dashed #aaa; padding-top:6px; }
      </style>

      <!-- docs = stock.picking -->
      <t t-foreach="docs" t-as="o">
        <t t-set="packs" t-value="o.package_ids.sorted('id')"/>
        <t t-set="total" t-value="len(packs)"/>

        <!-- Mỗi pack = 1 trang -->
        <t t-foreach="packs" t-as="pack">
          <t t-set="lines" t-value="[ml for ml in o.move_line_ids if ml.result_package_id and ml.result_package_id.id == pack.id]"/>
          <t t-set="qty"   t-value="sum([l.qty_done for l in lines])"/>
          <t t-set="w"     t-value="(pack.shipping_weight or pack.weight or 0.0)"/>
          <t t-set="src"   t-value="(o.origin or o.name)"/>

          <div class="sheet hlv">
            <div class="label">

              <!-- Sequence -->
              <div class="seq">
                <t t-esc="('%s/%s' % (pack.pack_sequence or 0, pack.pack_total or total))"/>
              </div>

              <!-- HÀNG TRÊN: barcode pack + qr source -->
             <table class="codes-table">
                <tr>
                  <!-- Cột trái: barcode pack -->
                  <td class="col-barcode">
                    <div class="barcode-pack">
                      <span t-field="pack.name"
                            t-options='{"widget":"barcode","type":"Code128","displayValue":False,"quiet":1}'/>
                    </div>
                    <div class="caption"><t t-esc="pack.name"/></div>
                  </td>

                  <!-- Cột phải: QR source -->
                  <td class="col-qr">
                    <img t-att-src="o._qr_data_uri(src, 4, 2)"/>
                    <div class="caption"><t t-esc="src"/></div>
                  </td>
                </tr>
              </table>

              <!-- Người gửi / Người nhận -->
              <div class="info">
                <div>
                  <div class="title">Người gửi</div>
                  <div><t t-esc="o.company_id.name or ''"/></div>
                  <div t-if="o.company_id.phone">ĐT: <t t-esc="o.company_id.phone"/></div>
                  <div t-if="o.company_id.partner_id"><t t-esc="o.company_id.partner_id.contact_address or ''"/></div>
                </div>
                <div>
                  <div class="title">Người nhận</div>
                  <div><t t-esc="o.partner_id.name or ''"/></div>
                  <div t-if="o.partner_id.phone">ĐT: <t t-esc="o.partner_id.phone"/></div>
                  <div t-if="o.partner_id.contact_address"><t t-esc="o.partner_id.contact_address"/></div>
                </div>
              </div>

              <!-- Bảng sản phẩm -->
              <table class="items" t-if="lines">
                <thead><tr><th>Sản phẩm</th><th class="qty">Số lượng</th></tr></thead>
                <tbody>
                  <t t-foreach="lines" t-as="ml">
                    <tr>
                      <td><t t-esc="ml.product_id.display_name"/></td>
                      <td class="qty"><t t-esc="ml.qty_done"/> <t t-esc="ml.product_uom_id.name"/></td>
                    </tr>
                  </t>
                </tbody>
                <tfoot><tr><td>Tổng</td><td class="qty"><t t-esc="qty"/></td></tr></tfoot>
              </table>

              <!-- Footer -->
              <div class="foot">
                <div><b>Dịch vụ:</b> Chuyển phát đường bộ</div>
                <div><b>Trọng lượng kiện (kg):</b> <t t-esc="('%.3f' % w)"/></div>
              </div>

            </div>
          </div>
        </t>
      </t>

    </t>
    </t>
  </template>
</odoo>
