<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="hlv_pack_labels_assets"
            inherit_id="web.report_assets_common"
            name="HLV Pack Labels Assets">
    <xpath expr="." position="inside">
      <style type="text/css">
        .hlv-label{
          font-family: "DejaVu Sans","Noto Sans","Liberation Sans","Arial",sans-serif !important;
        }
        .hlv-label b, .hlv-label strong{ font-weight:700; }
      </style>
    </xpath>
  </template>
</odoo>
