<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- 1) Paperformat: 100 (ngang) x 50 (dọc) mm -->
  <record id="paperformat_simple_package_label" model="report.paperformat">
    <field name="name">Label 100x50</field>
    <field name="format">custom</field>
    <field name="page_width">100</field>
    <field name="page_height">50</field>
    <field name="orientation">Portrait</field>
    <field name="margin_top">1</field>
    <field name="margin_bottom">1</field>
    <field name="margin_left">1</field>
    <field name="margin_right">1</field>
    <field name="disable_shrinking">True</field>
  </record>

  <!-- 2) Report Action -->
  <record id="action_report_simple_package_labels" model="ir.actions.report">
    <field name="name">Simple Package Labels</field>
    <field name="model">stock.picking</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">hlv_pack_sequence.report_simple_package_label_document</field>
    <field name="print_report_name">'Simple Package Labels - %s' % (object.name or "Picking")</field>
    <field name="binding_model_id" ref="stock.model_stock_picking"/>
    <field name="binding_type">report</field>
    <field name="paperformat_id" ref="hlv_pack_sequence.paperformat_simple_package_label"/>
  </record>

  <!-- 3) Template QWeb - Fixed Version -->
  <template id="report_simple_package_label_document">
    <t t-call="web.html_container">
      <t t-call="web.report_layout">

        <style type="text/css">
          @font-face{
            font-family:"VNFont";
            src:url("/hlv_pack_sequence/static/fonts/NotoSans-Regular.ttf") format("truetype");
            font-weight:400; font-style:normal;
          }
          @font-face{
            font-family:"VNFont";
            src:url("/hlv_pack_sequence/static/fonts/NotoSans-Bold.ttf") format("truetype");
            font-weight:700; font-style:normal;
          }
          
          .hlv, .hlv *{ 
            font-family:"VNFont", Arial, sans-serif !important; 
            margin: 0; padding: 0; box-sizing: border-box;
          }

          /* Mỗi page = 1 trang riêng, kích thước chính xác 100x50mm */
          .page { 
            padding: 1.5mm !important; 
            margin: 0 !important;
            width: 100mm !important;
            height: 50mm !important;
            overflow: hidden;
            page-break-after: always;
          }

          /* Container label vừa khít với trang */
          .label{ 
            width: 97mm;
            height: 47mm;
            border: 0.2mm solid #111; 
            border-radius: 1mm; 
            padding: 1mm;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
          }

          /* Header: Sequence - nhỏ hơn */
          .seq{ 
            font-size: 4mm; 
            font-weight: 700; 
            line-height: 1;
            text-align: center;
            height: 5mm;
            margin-bottom: 0.5mm;
          }

          /* Middle: Codes table - compact hơn */
          .codes-table{ 
            width: 100%; 
            border-collapse: collapse; 
            table-layout: fixed;
            height: 32mm;
          }
          .codes-table td{ 
            vertical-align: top; 
            text-align: center;
            padding: 0;
          }
          .col-barcode{ width: 68%; padding-right: 0.5mm; }
          .col-qr{ width: 32%; padding-left: 0.5mm; }

          /* Barcode - nhỏ hơn */
          .barcode-pack{ 
            width: 100%; 
            display: flex; 
            justify-content: center;
            margin-bottom: 0.3mm;
          }
          .barcode-pack svg, .barcode-pack img{ 
            width: 100%; 
            height: 14mm !important;
            max-height: 14mm;
            display: block; 
          }

          /* QR code - nhỏ hơn */
          .qr { margin-bottom: 0.3mm; }
          .qr img{ 
            width: 16mm; 
            height: 16mm; 
            display: block; 
            margin: 0 auto; 
          }

          /* Caption - nhỏ hơn */
          .caption{ 
            font-size: 1.6mm; 
            font-weight: 600; 
            text-align: center; 
            word-break: break-word;
            line-height: 1;
            max-height: 6mm;
            overflow: hidden;
          }

          /* Footer - compact */
          .foot{
            display: flex; 
            justify-content: space-between; 
            font-size: 1.6mm;
            font-weight: 600;
            border-top: 0.1mm dashed #aaa; 
            padding-top: 0.5mm;
            height: 4mm;
            align-items: center;
            margin-top: 0.5mm;
          }

          /* Đảm bảo mỗi page là 1 trang */
          .page:last-child {
            page-break-after: avoid;
          }
        </style>

        <!-- docs = stock.picking recordset -->
        <t t-foreach="docs" t-as="o">
          <t t-set="packs" t-value="o.package_ids.sorted('id')"/>
          <t t-set="total" t-value="len(packs)"/>

          <!-- Mỗi package = 1 TRANG, nhưng gọn trong 50mm -->
          <t t-foreach="packs" t-as="pack">
            <t t-set="lines" t-value="[ml for ml in o.move_line_ids if ml.result_package_id and ml.result_package_id.id == pack.id]"/>
            <t t-set="qty"   t-value="sum([l.qty_done for l in lines])"/>
            <t t-set="w"     t-value="(pack.shipping_weight or pack.weight or 0.0)"/>
            <t t-set="src"   t-value="(o.origin or o.name)"/>

            <div class="page hlv">
              <div class="label">

                <!-- Sequence -->
                <div class="seq">
                  <t t-esc="('%s/%s' % (pack.pack_sequence or 0, pack.pack_total or total))"/>
                </div>

                <!-- Codes Table -->
                <table class="codes-table">
                  <tr>
                    <td class="col-barcode">
                      <div class="barcode-pack">
                        <span t-field="pack.name"
                              t-options='{"widget":"barcode","type":"Code128","displayValue":False,"quiet":1}'/>
                      </div>
                      <div class="caption"><t t-esc="pack.name"/></div>
                    </td>

                    <td class="col-qr">
                      <div class="qr">
                        <img t-att-src="o._qr_data_uri(src, 4, 2)"/>
                      </div>
                      <div class="caption"><t t-esc="src"/></div>
                    </td>
                  </tr>
                </table>

                <!-- Footer -->
                <div class="foot">
                  <div><b>Dịch vụ:</b> Chuyển phát đường bộ</div>
                  <div><b>KL:</b> <t t-esc="('%.1f' % w)"/>kg</div>
                </div>

              </div>
            </div>

          </t>
        </t>

      </t>
    </t>
  </template>

</odoo>