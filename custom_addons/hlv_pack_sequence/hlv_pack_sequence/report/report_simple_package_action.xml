<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action report: in nhãn đơn giản cho tất cả package của picking -->
    <record id="action_report_simple_package_labels" model="ir.actions.report">
        <field name="name">Simple Package Labels</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hlv_pack_sequence.report_simple_package_label_document</field>
        <field name="print_report_name">'Simple Package Labels - %s' % (object.name)</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Template QWeb: nhãn đơn giản cho từng package -->
    <template id="report_simple_package_label_document">
        <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-set="packs" t-value="o.package_ids.sorted('id')"/>
            <t t-set="total" t-value="len(packs)"/>
            <t t-foreach="packs" t-as="pack">
                <div class="page hlv-label-simple" style="width:50mm; height:100mm; padding:0; margin:0;">
                    <div style="font-size:28px; font-weight:800; margin-bottom:10px; text-align:center;">
                        <t t-esc="('%s/%s' % (pack.pack_sequence or 0, pack.pack_total or total))"/>
                    </div>
                    <div style="margin:10px 0 10px 0; text-align:center;">
                        <span t-field="pack.name"
                              t-options='{"widget": "barcode", "type": "Code128", "displayValue": True, "quiet": 1}'/>
                    </div>
                </div>
            </t>
        </t>
        </t>
    </template>
</odoo>
