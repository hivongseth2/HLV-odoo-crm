<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="pickup_page" name="Đi nhận hàng">
        <t t-call="web.layout">
            <t t-set="head">
                <title>Đi nhận hàng</title>
                <meta name="viewport" content="width=device-width,initial-scale=1"/>
                <t t-call-assets="hlv_purchase_pickup.assets_pickup_page"/>
                <!-- Key JS nằm trong data-* chứ không ghép thẳng vào src: file JS tự quyết
                     định có nạp Google Maps hay không, nên không có key thì trang vẫn chạy
                     bình thường, chỉ là không có bản đồ. -->
                <script type="text/javascript"
                        t-attf-data-maps-key="#{maps_js_key or ''}"
                        id="pk-maps-config">/* cấu hình bản đồ đọc từ data-maps-key */</script>
            </t>
            <!-- Màn hình chia 4 bước đúng theo trình tự làm việc thật: chọn chuyến → xuất
                 phát → đi từng điểm → về kho. Gom hết vào một màn sẽ hiện nút "Đã về kho"
                 ngay khi chưa tới điểm nào, và bấm nhầm là đóng chuyến giữa chừng. -->
            <div id="pk-app" t-attf-data-run-id="#{run_id or ''}">
                <header class="pk-header">
                    <button class="pk-btn pk-btn-icon pk-hidden" id="pk-back" type="button"
                            aria-label="Chọn chuyến khác">←</button>
                    <div class="pk-header-main">
                        <span class="pk-run-name" id="pk-run-name">Đang tải…</span>
                        <span class="pk-run-meta" id="pk-run-meta"></span>
                    </div>
                    <button class="pk-btn pk-btn-ghost" id="pk-refresh" type="button">Tải lại</button>
                </header>

                <div class="pk-steps pk-hidden" id="pk-steps"></div>

                <div class="pk-alert pk-hidden" id="pk-alert" role="status"></div>
                <div class="pk-offline pk-hidden" id="pk-offline" role="status">
                    Đang mất mạng — các thao tác đã bấm sẽ tự gửi lại khi có sóng.
                </div>

                <!-- Bước 1: chọn ngày rồi chọn chuyến -->
                <section class="pk-screen pk-hidden" id="pk-screen-pick">
                    <div class="pk-field">
                        <label for="pk-date">Ngày đi</label>
                        <input type="date" id="pk-date"/>
                    </div>
                    <div id="pk-run-list"></div>
                    <p class="pk-hint">
                        Hoặc quét mã QR trên tờ lịch in để vào thẳng chuyến, khỏi phải chọn.
                    </p>
                </section>

                <!-- Bước 2: xác nhận chuyến rồi xuất phát -->
                <section class="pk-screen pk-hidden" id="pk-screen-depart">
                    <div id="pk-depart-summary"></div>
                </section>

                <!-- Bước 3: đi từng điểm -->
                <!-- Bước 3 dựng theo kiểu ứng dụng chạy xe: bản đồ chiếm trọn màn hình, mọi
                     thứ khác nằm trong tấm trượt dưới đáy. Người đi nhận đang ngồi trên xe,
                     thứ họ cần liếc là "đi đâu tiếp", không phải một danh sách dài. -->
                <section class="pk-screen pk-hidden" id="pk-screen-run">
                    <div class="pk-mapwrap">
                        <div class="pk-map" id="pk-map"></div>
                        <div class="pk-mapnote pk-hidden" id="pk-map-note"></div>
                        <div class="pk-fabs">
                            <button class="pk-fab" id="pk-optimize" type="button"
                                    title="Tối ưu lộ trình">⇅</button>
                            <button class="pk-fab" id="pk-recenter" type="button"
                                    title="Về vị trí của tôi">◎</button>
                        </div>
                    </div>
                    <div class="pk-sheet" id="pk-sheet">
                        <button class="pk-sheet-grab" id="pk-sheet-grab" type="button"
                                aria-label="Kéo để mở rộng danh sách">
                            <span class="pk-sheet-bar"></span>
                        </button>
                        <div class="pk-sheet-head" id="pk-sheet-head"></div>
                        <div class="pk-sheet-body" id="pk-sheet-body">
                            <div class="pk-stops" id="pk-stops"></div>
                            <div class="pk-finish" id="pk-finish"></div>
                        </div>
                    </div>
                </section>

                <!-- Bước 4: đã xong -->
                <section class="pk-screen pk-hidden" id="pk-screen-done">
                    <div id="pk-done-summary"></div>
                </section>

                <div class="pk-modal pk-hidden" id="pk-modal">
                    <div class="pk-modal-box">
                        <h3 class="pk-modal-title" id="pk-modal-title"></h3>
                        <p class="pk-modal-text" id="pk-modal-text"></p>
                        <textarea class="pk-modal-input" id="pk-modal-input" rows="2"></textarea>
                        <div class="pk-modal-alert pk-hidden" id="pk-modal-alert"></div>
                        <div class="pk-modal-actions">
                            <button class="pk-btn pk-btn-ghost" id="pk-modal-cancel" type="button">Huỷ</button>
                            <button class="pk-btn pk-btn-primary" id="pk-modal-ok" type="button">Xác nhận</button>
                        </div>
                    </div>
                </div>

                <div class="pk-loading pk-hidden" id="pk-loading">Đang gửi…</div>
            </div>
        </t>
    </template>
</odoo>
