<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pickup_add_po_wizard_form" model="ir.ui.view">
        <field name="name">hlv.pickup.add.po.wizard.form</field>
        <field name="model">hlv.pickup.add.po.wizard</field>
        <field name="arch" type="xml">
            <form string="Thêm đơn mua hàng vào chuyến">
                <!-- Nới rộng modal. Thẻ style này chỉ nằm trong DOM khi wizard đang mở, nên
                     nó cũng với tới được hộp thoại "Thêm: Đơn sẽ đi lấy" — vốn là một modal
                     RIÊNG, không nằm trong form này nên :has() không chạm tới được. Đóng
                     wizard là style biến mất, không ảnh hưởng phần còn lại của Odoo. -->
                <style>
                    .modal-dialog { max-width: min(1500px, 96vw) !important; }
                    /* Bảng chọn đơn: để cột tự co theo nội dung thay vì bị ép cứng rồi cắt
                       mất cột tiền ở mép phải. */
                    .o_pickup_po_picker { table-layout: auto !important; }
                    .o_pickup_po_picker th, .o_pickup_po_picker td { white-space: nowrap; }
                </style>
                <group>
                    <group string="Chuyến">
                        <field name="run_id" readonly="1"/>
                    </group>
                    <group string="Lọc đơn">
                        <field name="partner_id" options="{'no_create': True}"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <p class="text-muted">
                    Chỉ hiện đơn đã xác nhận và chưa nằm trong chuyến nào đang mở. Nhiều đơn
                    của cùng một nhà cung cấp sẽ tự gom về một điểm dừng.
                </p>
                <field name="order_ids" widget="many2many"
                       context="{'list_view_ref': 'hlv_purchase_pickup.view_purchase_order_picker_list'}">
                    <list>
                        <field name="name" string="Số đơn"/>
                        <field name="partner_id" string="Nhà cung cấp"/>
                        <field name="date_order" string="Ngày đặt"/>
                        <field name="amount_total" string="Tổng tiền" sum="Tổng"/>
                        <field name="currency_id" column_invisible="True"/>
                    </list>
                </field>
                <field name="available_order_ids" invisible="1"/>
                <group string="Điểm nhận sẽ dùng" invisible="not order_ids">
                    <field name="point_preview" nolabel="1" readonly="1"/>
                </group>
                <footer>
                    <button name="action_add" type="object" string="Thêm vào chuyến"
                            class="btn-primary"/>
                    <button string="Huỷ" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pickup_add_po_wizard" model="ir.actions.act_window">
        <field name="name">Thêm đơn mua hàng</field>
        <field name="res_model">hlv.pickup.add.po.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_hlv_pickup_run"/>
        <field name="binding_view_types">form</field>
    </record>
</odoo>
