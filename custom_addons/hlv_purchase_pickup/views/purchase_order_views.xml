<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit form đơn mua hàng bằng xmlid core purchase.purchase_order_form — id này ổn
         định qua các bản Odoo và là điểm mở rộng chính thức của module purchase. -->
    <record id="view_purchase_order_form_pickup" model="ir.ui.view">
        <field name="name">purchase.order.form.pickup</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <!-- Phân quyền đặt bằng thuộc tính groups="" TRÊN TỪNG ELEMENT, không đặt bằng
             field groups_id của record: Odoo 18 chặn thẳng groups_id trên view kế thừa
             ("Inherited view cannot have 'Groups' define on the record") vì view kế thừa
             không phải một view độc lập để bật/tắt, nó được trộn vào view gốc. -->
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_pickup_lines" type="object" class="oe_stat_button"
                        icon="fa-truck" invisible="x_pickup_count == 0"
                        groups="hlv_purchase_pickup.group_pickup_runner">
                    <field name="x_pickup_count" widget="statinfo" string="Lượt đi nhận"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="x_pickup_state" widget="badge"
                       groups="hlv_purchase_pickup.group_pickup_runner"
                       decoration-success="x_pickup_state == 'received'"
                       decoration-warning="x_pickup_state == 'not_ready'"
                       decoration-info="x_pickup_state == 'scheduled'"
                       invisible="x_pickup_state == 'none'"/>
            </xpath>
        </field>
    </record>

    <!-- Cố tình KHÔNG inherit view danh sách đơn mua hàng: xmlid của nó đã đổi tên qua các
         bản Odoo (purchase_order_tree / purchase_order_view_tree) và trong repo này chưa có
         module nào dùng để làm chứng là id nào đúng. Sai xmlid là module không cài được, đổi
         lại chỉ được thêm một cột tuỳ chọn — không đáng. Xem tình trạng đi nhận ở menu
         Đi nhận hàng → Đơn chưa lấy được. -->
</odoo>
