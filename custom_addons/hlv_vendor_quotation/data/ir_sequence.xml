<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_vendor_quote" model="ir.sequence">
        <field name="name">Yêu cầu báo giá NCC</field>
        <field name="code">hlv.vendor.quote</field>
        <field name="prefix">BGNCC/%(y)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_vendor_inquiry" model="ir.sequence">
        <field name="name">Phiếu hỏi giá NCC</field>
        <field name="code">hlv.vendor.inquiry</field>
        <field name="prefix">HG/%(y)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
