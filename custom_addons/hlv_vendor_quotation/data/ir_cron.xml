<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_inquiry_auto_close" model="ir.cron">
        <field name="name">Hỏi giá NCC: tự đóng phiếu hết hiệu lực giá</field>
        <field name="model_id" ref="model_hlv_vendor_inquiry"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_close()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_late_deliveries" model="ir.cron">
        <field name="name">Hỏi giá NCC: báo trễ hẹn giao hàng</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_hlv_late_deliveries()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
