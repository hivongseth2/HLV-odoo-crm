<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_form_vendor_quote" model="ir.ui.view">
        <field name="name">purchase.request.form.vendor.quote</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form"/>
        <field name="arch" type="xml">
            <!-- Dòng đã huỷ (sale bỏ chọn / đổi NCC ở trang hỏi giá…): đỏ + gạch ngang (scss/purchase_request_lines.scss)
                 thay vì chỉ mờ — lý do ghi ở chatter YCMH. -->
            <xpath expr="//field[@name='line_ids']/list" position="attributes">
                <attribute name="decoration-danger">cancelled</attribute>
            </xpath>
            <!-- Ngày sale điền khi lên YCMH (một ngày cho cả phiếu) — cạnh ô tự tính từ các dòng để thu mua so. -->
            <xpath expr="//field[@name='date_required'][not(ancestor::field)]" position="after">
                <field name="hlv_date_wanted" readonly="state in ('done', 'rejected')"/>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_open_vendor_quote_wizard" type="object" string="Hỏi giá NCC"
                        invisible="state in ('draft', 'done', 'rejected')"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_vendor_quotes" type="object" class="oe_stat_button"
                        icon="fa-envelope-o" invisible="vendor_quote_count == 0">
                    <field name="vendor_quote_count" widget="statinfo" string="Báo giá NCC"/>
                </button>
                <button name="action_compare_vendor_quotes" type="object" class="oe_stat_button"
                        icon="fa-balance-scale" string="So sánh giá" invisible="vendor_quote_count == 0"/>
                <button name="action_view_inquiries" type="object" class="oe_stat_button"
                        icon="fa-tags" invisible="hlv_inquiry_count == 0">
                    <field name="hlv_inquiry_count" widget="statinfo" string="Phiếu hỏi giá"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- "Người yêu cầu" (mã sale) sửa được trên YCMH lập từ trang hỏi giá — sale lên YCMH chọn mã, thu mua
         sửa khi nhầm. YCMH đi từ MISA giữ chỉ đọc: extension MISA đồng bộ đè lại. Kế thừa view của chính
         misa_purchase_request_sync (repo này), không phải view lõi. -->
    <record id="view_purchase_request_form_requester_editable" model="ir.ui.view">
        <field name="name">purchase.request.form.requester.editable</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="misa_purchase_request_sync.view_purchase_request_form_inherit_misa_sync"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='x_misa_requested_by']" position="attributes">
                <attribute name="readonly">not hlv_from_quote_page or state in ('done', 'rejected')</attribute>
            </xpath>
            <xpath expr="//field[@name='x_misa_requested_by']" position="after">
                <field name="hlv_from_quote_page" invisible="1"/>
            </xpath>
            <!-- Ghi chú dòng dùng chung misa_note (sale ghi lúc lên YCMH từ trang hỏi giá) — bỏ chữ "(MISA)". -->
            <xpath expr="//field[@name='misa_note']" position="attributes">
                <attribute name="string">Ghi chú</attribute>
            </xpath>
        </field>
    </record>

    <!-- Wizard Tạo RFQ: cùng cột ghi chú dòng YCMH — nhãn "Ghi chú" như trên form YCMH. View của misa_purchase_request_sync. -->
    <record id="view_rfq_wizard_note_label" model="ir.ui.view">
        <field name="name">purchase.request.line.make.purchase.order.note.label</field>
        <field name="model">purchase.request.line.make.purchase.order</field>
        <field name="inherit_id" ref="misa_purchase_request_sync.view_purchase_request_line_make_purchase_order_inherit_misa"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='misa_note']" position="attributes">
                <attribute name="string">Ghi chú</attribute>
            </xpath>
        </field>
    </record>

    <!-- Đơn mua: NCC báo tiến độ trên trang của họ; phiếu hỏi giá sinh ra đơn này. -->
    <record id="view_purchase_order_form_vendor_quote" model="ir.ui.view">
        <field name="name">purchase.order.form.vendor.quote</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="hlv_delivery_method"/>
                <field name="hlv_vendor_portal_password" invisible="not hlv_vendor_portal_password"/>
                <field name="hlv_vendor_status" readonly="1" invisible="not hlv_vendor_status"/>
                <field name="hlv_vendor_status_date" invisible="not hlv_vendor_status_date"/>
                <field name="hlv_ship_method" invisible="not hlv_ship_method"/>
                <field name="hlv_ship_carrier" invisible="not hlv_ship_carrier"/>
                <field name="hlv_ship_ref" invisible="not hlv_ship_ref"/>
                <field name="hlv_vendor_event" invisible="not hlv_vendor_event"/>
                <field name="hlv_inquiry_ids" widget="many2many_tags" readonly="1" invisible="not hlv_inquiry_ids"/>
                <!-- Chỉ hiện khi NCC xem được đơn (Cài đặt "Đơn mua hiện trên trang NCC") — xem _compute_hlv_vendor_portal_url. -->
                <field name="hlv_vendor_portal_url" widget="url" readonly="1" invisible="not hlv_vendor_portal_url"/>
            </xpath>
            <!-- Cạnh "Hàng về dự kiến" (theo ngày NCC giao được) để thu mua thấy ngay chỗ lệch với ngày sale cần. -->
            <xpath expr="//div[@name='date_planned_div']" position="after">
                <field name="hlv_date_wanted" invisible="not hlv_date_wanted"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='name']" position="after">
                <field name="hlv_invoice_name" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Dòng YCMH gắn với phiếu hỏi giá (models/purchase_request_line_price.py): thu mua không sửa đơn giá / thuế / chiết
         khấu / số lượng / sản phẩm — của phiếu hỏi giá; muốn giá khác thì "Đề xuất giá" trên dòng đơn mua, muốn mua thêm
         thì sale bổ sung từ phiếu hỏi giá. YCMH không
         gắn với hỏi giá giữ nguyên như cũ. Kế thừa view của misa_purchase_request_sync (module trong repo, xmlid ổn định). -->
    <record id="view_purchase_request_form_price_lock" model="ir.ui.view">
        <field name="name">purchase.request.form.hlv.price.lock</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="misa_purchase_request_sync.view_purchase_request_form_inherit_misa_sync"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']/list/field[@name='product_id']" position="after">
                <field name="hlv_price_locked" column_invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='product_id']" position="attributes">
                <attribute name="readonly">parent.state != 'draft' or hlv_price_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='product_qty']" position="attributes">
                <attribute name="readonly">parent.state != 'draft' or hlv_price_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='product_uom_id'][1]" position="attributes">
                <attribute name="readonly">parent.state != 'draft' or hlv_price_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='product_uom_id'][2]" position="attributes">
                <attribute name="readonly">parent.state != 'draft' or hlv_price_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='estimated_cost']" position="attributes">
                <attribute name="readonly">parent.state != 'draft' or hlv_price_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='misa_price_before_tax']" position="attributes">
                <attribute name="readonly">parent.state != 'draft' or hlv_price_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='misa_discount_rate']" position="attributes">
                <attribute name="readonly">parent.state != 'draft' or hlv_price_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='misa_discount_amount']" position="attributes">
                <attribute name="readonly">parent.state != 'draft' or hlv_price_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='misa_tax_rate']" position="attributes">
                <attribute name="readonly">parent.state != 'draft' or hlv_price_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='misa_tax_amount']" position="attributes">
                <attribute name="readonly">parent.state != 'draft' or hlv_price_locked</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_request_line_details_price_lock" model="ir.ui.view">
        <field name="name">purchase.request.line.details.hlv.price.lock</field>
        <field name="model">purchase.request.line</field>
        <field name="inherit_id" ref="misa_purchase_request_sync.view_purchase_request_line_details_inherit_misa"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_editable']" position="after">
                <field name="hlv_price_locked" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='estimated_cost']" position="attributes">
                <attribute name="readonly">is_editable == False or hlv_price_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='history_po_line_id']" position="attributes">
                <attribute name="readonly">is_editable == False or hlv_price_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='misa_price_before_tax']" position="attributes">
                <attribute name="readonly">is_editable == False or hlv_price_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='misa_price_before_tax_total']" position="attributes">
                <attribute name="readonly">is_editable == False or hlv_price_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='misa_discount_rate']" position="attributes">
                <attribute name="readonly">is_editable == False or hlv_price_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='misa_discount_amount']" position="attributes">
                <attribute name="readonly">is_editable == False or hlv_price_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='misa_tax_rate']" position="attributes">
                <attribute name="readonly">is_editable == False or hlv_price_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='misa_tax_amount_total']" position="attributes">
                <attribute name="readonly">is_editable == False or hlv_price_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='misa_tax_amount']" position="attributes">
                <attribute name="readonly">is_editable == False or hlv_price_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='misa_price_after_tax_total']" position="attributes">
                <attribute name="readonly">is_editable == False or hlv_price_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='misa_price_after_tax']" position="attributes">
                <attribute name="readonly">is_editable == False or hlv_price_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='misa_amount']" position="attributes">
                <attribute name="readonly">is_editable == False or hlv_price_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="readonly">is_editable == False or hlv_price_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='product_qty']" position="attributes">
                <attribute name="readonly">is_editable == False or hlv_price_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='product_uom_id']" position="attributes">
                <attribute name="readonly">is_editable == False or hlv_price_locked</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_request_line_form_price_lock" model="ir.ui.view">
        <field name="name">purchase.request.line.form.hlv.price.lock</field>
        <field name="model">purchase.request.line</field>
        <field name="inherit_id" ref="misa_purchase_request_sync.view_purchase_request_line_form_inherit_misa"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_editable']" position="after">
                <field name="hlv_price_locked" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='estimated_cost']" position="attributes">
                <attribute name="readonly">is_editable == False or hlv_price_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='history_po_line_id']" position="attributes">
                <attribute name="readonly">is_editable == False or hlv_price_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="readonly">is_editable == False or hlv_price_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='product_qty']" position="attributes">
                <attribute name="readonly">is_editable == False or hlv_price_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='product_uom_id']" position="attributes">
                <attribute name="readonly">is_editable == False or hlv_price_locked</attribute>
            </xpath>
        </field>
    </record>
</odoo>
