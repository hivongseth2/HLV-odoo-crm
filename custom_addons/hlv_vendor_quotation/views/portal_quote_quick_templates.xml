<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Xem nhanh một báo giá ngay trong danh sách (dòng ẩn dưới mỗi báo giá, bấm để mở): đúng bảng
         giá của trang báo giá (portal_grid, chỉ đọc) — trong và ngoài một kiểu, NCC không phải đọc
         hai cách trình bày. Biến vào: quote, quote_url, quote_status, requesters, line_choice (từ
         portal_quote_list), cùng các biến chung của _render. -->
    <template id="portal_quote_quick" name="Báo giá NCC - xem nhanh">
        <t t-set="disc_on" t-value="any(quote.line_ids.mapped('list_price'))"/>
        <div t-attf-class="vq-quick vq-quick-grid #{'vq-disc-on' if disc_on else ''}">
            <div class="vq-quick-scroll">
                <t t-call="hlv_vendor_quotation.portal_grid">
                    <t t-set="grid_lines" t-value="quote.line_ids"/>
                    <t t-set="editable" t-value="False"/>
                    <t t-set="references" t-value="{}"/>
                </t>
            </div>
            <div class="vq-quick-foot">
                <span t-if="requesters.get(quote.id)" class="vq-quick-requester">Người hỏi giá:
                    <b t-esc="requesters[quote.id]"/></span>
                <span t-if="quote.amount_untaxed" class="vq-quick-total">
                    Sau VAT <b t-esc="fmt(quote.amount_total)"/> · chưa VAT <t t-esc="fmt(quote.amount_untaxed)"/>
                </span>
                <a t-att-href="quote_url" class="vq-btn vq-btn-secondary"
                   t-esc="'Điền giá →' if quote_status[1] == 'waiting' else 'Mở báo giá →'"/>
            </div>
        </div>
    </template>
</odoo>
