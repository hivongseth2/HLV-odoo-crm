<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Bảng nhập giá dùng chung cho trang từng phiếu (portal_quote_form) và trang báo giá theo mặt
         hàng (portal_line_board) — một chỗ định nghĩa ô nhập, để hai trang gửi cùng tên ô và server
         đọc bằng cùng _read_quote_form. -->

    <!-- Chú thích ngắn, chỉ hiện khi có trường hợp đó — chi tiết xem bằng cách rê chuột lên chip. -->
    <template id="portal_grid_legend" name="Báo giá NCC - chú thích bảng giá">
        <p t-if="any(line_choice.values())" class="vq-small vq-choice-legend">
            Dòng nền xanh: <t t-esc="company.name"/> đã chọn giá của quý công ty.</p>
        <p t-if="references" class="vq-small vq-ref-legend">Chip "giá cũ": đã điền sẵn giá quý công ty báo
            trong <t t-esc="reference_days"/> ngày qua — đúng giá, còn hàng thì cứ gửi.</p>
    </template>

    <!-- Công cụ trên đầu bảng: bật chiết khấu, %CK / VAT cho tất cả dòng. Cần biến disc_on. -->
    <template id="portal_grid_tools" name="Báo giá NCC - công cụ bảng giá">
        <div class="vq-head-tools">
            <label class="vq-check vq-disc-toggle">
                <input type="checkbox" name="use_discount" value="1" data-vq-disc-toggle="1"
                       t-att-checked="disc_on"/>
                Có chiết khấu
            </label>
            <label class="vq-inline-field vq-disc-only">
                <span>% CK cho tất cả dòng</span>
                <input type="text" inputmode="decimal" class="vq-input vq-input-disc" data-vq-disc-all="1"
                       placeholder="VD 13"/>
            </label>
            <label class="vq-inline-field">
                <span>VAT cho tất cả dòng</span>
                <select class="vq-input" data-vq-vat-all="1">
                    <option value="">Chọn</option>
                    <option t-foreach="vat_options" t-as="opt" t-att-value="opt[0]" t-esc="opt[1]"/>
                </select>
            </label>
        </div>
    </template>

    <!-- Bảng kiểu bảng tính (giống bảng báo giá trên phần mềm bán hàng của NCC): mỗi mặt hàng một
         dòng, ô nhập phủ kín ô bảng nên mọi ô thẳng hàng. NCC chỉ gõ một ô giá "Đơn giá" (đã gồm VAT;
         bật chiết khấu thì là giá trước CK) + %CK. Server tự tính giá chưa VAT (split_unit_price); JS
         chỉ hiện giá sau CK, thành tiền, tổng. Enter / dán cột từ Excel: js/vendor_quote_grid.js.
         Cần biến: grid_lines, editable, references, line_choice, post, disc_on; show_quote = bảng theo mặt
         hàng: thêm cột "Phiếu" + "Người hỏi" (cần quote_info), mã hàng gộp vào ô tên cho đủ chỗ;
         error_line_ids = dòng tô đỏ (tuỳ chọn). -->
    <template id="portal_grid" name="Báo giá NCC - bảng giá">
        <p t-if="editable" class="vq-grid-hint">
            Đơn giá tính cho một đơn vị, đã gồm VAT<span class="vq-disc-only">, chưa trừ chiết khấu</span>.
            Bấm <kbd>Enter</kbd> để xuống dòng dưới. Có sẵn bảng giá trong Excel thì copy cả cột, dán vào ô
            đơn giá đầu tiên.
        </p>
        <div class="vq-table-scroll">
        <table t-attf-class="vq-table vq-price-table vq-grid #{'vq-grid-board' if show_quote else ''}" data-vq-grid="1">
            <thead>
                <tr>
                    <th class="vq-col-no">#</th>
                    <th t-if="show_quote" class="vq-col-quote">Phiếu</th>
                    <th t-if="show_quote" class="vq-col-requester">Người hỏi</th>
                    <th t-if="not show_quote" class="vq-col-code">Mã hàng</th>
                    <th class="vq-col-name" t-esc="'Mã · Tên hàng' if show_quote else 'Tên hàng'"/>
                    <th class="vq-num vq-col-qty">SL</th>
                    <th class="vq-col-vat">VAT</th>
                    <th class="vq-num vq-col-price">Đơn giá</th>
                    <th class="vq-num vq-col-disc vq-disc-only">%CK</th>
                    <th class="vq-num vq-col-total">Thành tiền</th>
                    <th class="vq-num vq-col-days">Giao</th>
                    <th class="vq-col-na">Hết hàng</th>
                    <th class="vq-col-text">Tên xuất HĐ</th>
                    <th class="vq-col-text">Ghi chú</th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="grid_lines" t-as="line">
                    <t t-call="hlv_vendor_quotation.portal_grid_row"/>
                </t>
            </tbody>
        </table>
        </div>
    </template>

    <template id="portal_grid_row" name="Báo giá NCC - dòng bảng giá">
        <t t-set="lid" t-value="line.id"/>
        <t t-set="line_editable" t-value="editable and not line.vendor_locked"/>
        <t t-set="ref" t-value="references.get(lid)"/>
        <t t-set="ref_disc" t-value="ref and ref.list_price"/>
        <t t-set="code" t-value="line.product_id.default_code or ''"/>
        <t t-set="product_name" t-value="code_name(line.name or line.product_id.name, code)"/>
        <t t-set="choice_class" t-value="'vq-line-chosen' if line_choice.get(lid) == 'selected' else ''"/>
        <t t-set="na_checked" t-value="('na_%s' % lid) in post if post else line.unavailable"/>
        <t t-set="vat_value" t-value="post.get('vat_%s' % lid) if post else (line.vat or (ref and ref.vat) or default_vat)"/>
        <tr data-vq-line="1"
            t-attf-class="vq-line #{choice_class} #{'vq-line-locked' if line.vendor_locked else ''} #{'vq-line-error' if error_line_ids and lid in error_line_ids else ''}"
            t-att-data-qty="line.product_qty" t-att-data-price="line.price_unit"
            t-att-data-vat="line.vat or ''">
            <td class="vq-col-no" t-esc="line_index + 1"/>
            <t t-if="show_quote">
                <t t-set="info" t-value="quote_info[line.quote_id.id]"/>
                <td t-attf-class="vq-col-quote #{'vq-quote-urgent' if info['urgent'] else ''}" data-label="Phiếu">
                    <a class="vq-quote-ref" t-att-href="info['url']" t-att-title="info['title']" t-esc="line.quote_id.name"/>
                    <!-- Hạn + chip lời nhắn chung một dòng để hàng không cao thêm. -->
                    <div t-if="info['deadline'] or info['note']" class="vq-quote-meta">
                        <span t-if="info['deadline']" class="vq-quote-date">hạn <t t-esc="info['deadline']"/></span>
                        <span t-if="info['note']" class="vq-chip vq-chip-note" t-att-title="info['note']">lời nhắn</span>
                    </div>
                </td>
                <td class="vq-col-requester" data-label="Người hỏi">
                    <t t-if="info['requester']">
                        <div class="vq-requester-name" t-esc="info['requester']['name']"/>
                        <a t-if="info['requester']['phone']" class="vq-requester-phone"
                           t-attf-href="tel:#{info['requester']['phone']}" t-esc="info['requester']['phone']"/>
                    </t>
                    <span t-else="" class="vq-muted">—</span>
                </td>
            </t>
            <td t-if="not show_quote" class="vq-col-code" data-label="Mã hàng" t-esc="code or '—'"/>
            <td class="vq-col-name" t-att-title="('%s · %s' % (code, product_name)) if show_quote and code else product_name">
                <div class="vq-name-cell">
                    <span t-if="show_quote and code" class="vq-name-code" t-esc="code"/>
                    <a t-if="line.product_id.image_128" class="vq-name-text" target="_blank"
                       t-att-href="'%s/img/%s/1024' % (portal_base, lid)" title="Xem ảnh sản phẩm"
                       t-esc="product_name"/>
                    <span t-else="" class="vq-name-text" t-esc="product_name"/>
                    <!-- Trạng thái dòng: chip nhỏ cùng dòng (rê chuột xem chi tiết) — dòng không cao thêm. -->
                    <span t-if="line.vendor_locked" class="vq-chip vq-chip-locked"
                          title="Đã lên đơn mua — không sửa được nữa">đã đặt</span>
                    <span t-if="ref and line_editable" class="vq-chip vq-chip-ref"
                          t-att-title="'Giá lần trước: %s sau VAT cho %s %s (%s) — đã điền sẵn, kiểm tra rồi gửi' % (fmt(ref.price_unit * (1 + ref.tax_rate / 100.0)), fmt(ref.product_qty), ref.product_uom_id.name, fdate(ref.quote_id.submit_date))">giá cũ</span>
                </div>
            </td>
            <td class="vq-num vq-col-qty" data-label="SL">
                <t t-esc="fmt(line.product_qty)"/> <span class="vq-uom" t-esc="line.product_uom_id.name"/>
            </td>
            <td class="vq-col-vat" data-label="VAT">
                <select t-if="line_editable" class="vq-cell-input" data-vq-vat="1" t-att-name="'vat_%s' % lid">
                    <option value="">—</option>
                    <option t-foreach="vat_options" t-as="opt" t-att-value="opt[0]"
                            t-att-selected="opt[0] == vat_value" t-esc="opt[1]"/>
                </select>
                <span t-else="" class="vq-cell-text" t-esc="dict(vat_options).get(line.vat, '—')"/>
            </td>
            <!-- Giá đã gồm VAT. Bật chiết khấu: ô là giá trước CK, dòng nhỏ dưới là giá sau CK.
                 Rê chuột xem giá chưa VAT + tiền VAT (sau CK). -->
            <t t-set="tax_factor" t-value="1 + line.tax_rate / 100.0"/>
            <t t-set="unit_saved" t-value="fmt((line.list_price or line.price_unit) * tax_factor) if line.price_unit else ''"/>
            <!-- Giá cũ có chiết khấu mà phiếu này đang tắt chiết khấu: điền giá sau CK, không phải giá gốc. -->
            <t t-set="unit_ref" t-value="fmt(((ref.list_price if disc_on and ref.list_price else ref.price_unit)) * (1 + ref.tax_rate / 100.0)) if ref else ''"/>
            <td class="vq-num vq-col-price" data-label="Đơn giá" data-vq-price-cell="1"
                t-att-title="('Chưa VAT %s · VAT %s' % (fmt(line.price_unit), fmt(line.price_unit * line.tax_rate / 100.0))) if line.price_unit else None">
                <input t-if="line_editable" type="text" inputmode="decimal" class="vq-cell-input" data-vq-unit="1"
                       t-att-name="'unit_%s' % lid" t-att-aria-label="'Đơn giá — %s' % product_name"
                       t-att-value="post.get('unit_%s' % lid) if post else (unit_saved or unit_ref)"/>
                <span t-else="" class="vq-cell-text" t-esc="unit_saved or '—'"/>
                <div class="vq-unit-sub vq-disc-only">sau CK <span data-vq-after-text="1"
                     t-esc="fmt(line.price_unit * tax_factor) if line.price_unit else '—'"/></div>
            </td>
            <td class="vq-num vq-col-disc vq-disc-only" data-label="%CK">
                <input t-if="line_editable" type="text" inputmode="decimal" class="vq-cell-input"
                       data-vq-disc="1" t-att-name="'disc_%s' % lid" placeholder="0"
                       t-att-value="post.get('disc_%s' % lid) if post else (fmt(line.discount) if line.list_price else (fmt(ref.discount) if disc_on and ref_disc else ''))"/>
                <span t-else="" class="vq-cell-text" t-esc="fmt(line.discount) if line.list_price else '—'"/>
            </td>
            <td class="vq-num vq-col-total vq-cell-calc" data-label="Thành tiền" data-vq-subtotal="1">—</td>
            <td class="vq-num vq-col-days" data-label="Giao (ngày)">
                <input t-if="line_editable" type="text" inputmode="numeric" class="vq-cell-input"
                       t-att-name="'days_%s' % lid" placeholder="ngày"
                       t-att-value="post.get('days_%s' % lid) if post else (line.delivery_days or (ref and ref.delivery_days) or '')"/>
                <span t-else="" class="vq-cell-text" t-esc="line.delivery_days or '—'"/>
            </td>
            <td class="vq-col-na" data-label="Hết hàng">
                <input type="checkbox" value="1" data-vq-na="1" t-att-name="'na_%s' % lid"
                       t-att-checked="na_checked" t-att-disabled="not line_editable"
                       t-att-aria-label="'Không có hàng — %s' % product_name"/>
            </td>
            <td class="vq-col-text" data-label="Tên xuất HĐ">
                <input t-if="line_editable" type="text" class="vq-cell-input" maxlength="255"
                       t-att-name="'inv_%s' % lid" placeholder="nếu khác tên hàng"
                       t-att-value="post.get('inv_%s' % lid) if post else (line.invoice_name or (ref and ref.invoice_name) or '')"/>
                <span t-else="" class="vq-cell-text" t-esc="line.invoice_name or ''"/>
            </td>
            <td class="vq-col-text" data-label="Ghi chú">
                <input t-if="line_editable" type="text" class="vq-cell-input" maxlength="255"
                       t-att-name="'note_%s' % lid" placeholder="hãng, xuất xứ…"
                       t-att-value="post.get('note_%s' % lid) if post else (line.vendor_note or (ref and ref.vendor_note) or '')"/>
                <span t-else="" class="vq-cell-text" t-esc="line.vendor_note or ''"/>
            </td>
        </tr>
    </template>
</odoo>
