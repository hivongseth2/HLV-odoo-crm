<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Trang /hoi-gia-ncc của sale. Tự dựng HTML như /giao-hang (hlv_vtracking), KHÔNG dùng
         web.layout + asset bundle: Odoo 18 bọc mọi file JS trong static/src thành
         odoo.define(...), mà web.layout không nạp bộ nạp module — file đầu tiên lỗi và cả
         trang đứng im. Nạp thẳng bằng <script src> thì file chạy nguyên văn. -->
    <template id="sale_page" name="Hỏi giá nhà cung cấp">
        &lt;!DOCTYPE html&gt;
        <html lang="vi">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>Hỏi giá nhà cung cấp</title>
                <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/>
                <link rel="stylesheet" t-attf-href="/hlv_vendor_quotation/static/src/sale_page/sale_page.css?v=#{asset_version}"/>
                <link rel="stylesheet" t-attf-href="/hlv_vendor_quotation/static/src/sale_page/sale_page_dialogs.css?v=#{asset_version}"/>
            </head>
            <body>
                <nav class="navbar navbar-dark hq-navbar py-2">
                    <div class="container-fluid">
                        <span class="navbar-brand mb-0">Hỏi giá nhà cung cấp</span>
                        <div class="d-flex align-items-center gap-3">
                            <a class="nav-link text-white-50" href="/sale_plan">Tình trạng đơn</a>
                            <a class="nav-link text-white-50 d-none d-md-inline" href="/giao-hang">Giao hàng</a>
                            <a class="nav-link text-white-50 d-none d-md-inline" href="/search_stock">Tồn kho</a>
                        </div>
                    </div>
                </nav>

                <div t-if="not allowed" class="container py-5">
                    <div class="hq-panel hq-pad">Tài khoản chưa được cấp quyền hỏi giá nhà cung cấp. Liên hệ
                        quản trị để được thêm vào nhóm "Hỏi giá NCC" (Thiết lập → Người dùng).</div>
                </div>

                <div t-else="" id="hq-app" class="container-fluid py-3"
                     t-att-data-initial-vendor="initial_vendor_id or ''">
                    <!-- Không xem được (chưa khai mã sale / link của sale khác) hoặc phải chọn mã sale. -->
                    <div id="hq-denied" class="hq-panel hq-pad hq-hidden"></div>

                    <div class="hq-toolbar">
                        <label class="hq-muted" for="hq-code">Mã sale</label>
                        <select id="hq-code" class="hq-input hq-code-select"></select>
                        <button type="button" class="hq-btn hq-btn-mini hq-hidden" id="hq-switch-code"
                                title="Tài khoản dùng chung nhiều mã sale — chọn lại mã của bạn">Đổi mã</button>
                        <button type="button" class="hq-btn hq-btn-mini hq-hidden" id="hq-copy-code-link"
                                title="Link riêng của mã sale này — gửi cho đúng sale đó">Copy link mã này</button>
                        <label class="hq-sr-only" for="hq-search">Tìm phiếu hỏi giá</label>
                        <input type="search" id="hq-search" class="hq-input hq-input-wide"
                               placeholder="Tìm số phiếu, sản phẩm, NCC, đơn bán, YCMH…"/>
                        <button type="button" class="hq-btn hq-btn-primary hq-push" id="hq-new">Hỏi giá NCC</button>
                    </div>

                    <!-- Ba con số sale mở trang ra là muốn biết; bấm vào để lọc. -->
                    <div class="hq-kpis" id="hq-kpis"></div>

                    <div class="row g-3">
                        <div class="col-lg-3">
                            <aside class="hq-panel hq-side">
                                <div class="hq-panel-head"><h2 class="hq-h3">Nhà cung cấp</h2></div>
                                <div class="hq-side-search">
                                    <label class="hq-sr-only" for="hq-vendor-search">Tìm nhà cung cấp</label>
                                    <input type="search" id="hq-vendor-search" class="hq-input w-100"
                                           placeholder="Tìm nhà cung cấp…"/>
                                </div>
                                <div class="hq-vendor-scroll">
                                    <button type="button" class="hq-vendor hq-vendor-all is-active" data-vendor="">
                                        <span class="hq-vendor-name">Tất cả nhà cung cấp</span>
                                    </button>
                                    <div id="hq-vendor-list"></div>
                                </div>
                            </aside>
                        </div>
                        <div class="col-lg-9">
                            <!-- Giá NCC đã báo cho sản phẩm khớp ô tìm — mọi mã sale (sale_price_history.js). -->
                            <section id="hq-price-history" class="hq-panel hq-price-history hq-hidden" aria-live="polite"></section>
                            <section class="hq-panel">
                                <div class="hq-panel-head hq-panel-head-wrap">
                                    <h2 class="hq-h2" id="hq-title">Tất cả nhà cung cấp</h2>
                                    <div id="hq-tabs" class="hq-tabs hq-push"></div>
                                </div>
                                <div id="hq-vendor-card" class="hq-vendor-card hq-hidden"></div>
                                <div id="hq-alert" class="hq-alert hq-hidden"></div>
                                <div class="hq-table-wrap">
                                    <table class="hq-quotes">
                                        <thead>
                                            <tr>
                                                <th>Số phiếu</th>
                                                <th>Sản phẩm</th>
                                                <th>NCC đã báo</th>
                                                <th>Đã chọn giá</th>
                                                <th>YCMH · Đơn mua</th>
                                                <th>Hạn</th>
                                                <th>Tình trạng</th>
                                            </tr>
                                        </thead>
                                        <tbody id="hq-quote-list">
                                            <tr><td colspan="7" class="hq-empty">Đang tải…</td></tr>
                                        </tbody>
                                    </table>
                                </div>
                                <div id="hq-pager" class="hq-pager"></div>
                            </section>
                        </div>
                    </div>

                    <!-- Chi tiết một phiếu: so giá các NCC, chọn, lên YCMH -->
                    <div id="hq-drawer" class="hq-drawer hq-hidden">
                        <div class="hq-drawer-backdrop" data-close="drawer"></div>
                        <section class="hq-drawer-panel" id="hq-drawer-panel"></section>
                    </div>

                    <!-- Hỏi giá NCC -->
                    <div id="hq-modal" class="hq-modal hq-hidden">
                        <div class="hq-modal-box">
                            <div class="hq-modal-head">
                                <h2 class="hq-h2" id="hq-modal-title">Hỏi giá nhà cung cấp</h2>
                                <button type="button" class="btn-close" data-close="modal" aria-label="Đóng"></button>
                            </div>
                            <div class="hq-modal-body" id="hq-modal-body">
                                <section class="hq-step">
                                    <h3 class="hq-h3">1. Sản phẩm cần hỏi giá</h3>
                                    <div class="row g-2">
                                        <div class="col-md-6 hq-picker">
                                            <label class="form-label small mb-1" for="hq-prod-search">Thêm sản phẩm</label>
                                            <input type="search" id="hq-prod-search" class="hq-input w-100" autocomplete="off"
                                                   placeholder="Mã hoặc tên sản phẩm…"/>
                                            <div id="hq-prod-results" class="hq-dropdown hq-hidden"></div>
                                        </div>
                                        <div class="col-md-6 hq-picker">
                                            <label class="form-label small mb-1" for="hq-so-search">
                                                Lấy hàng từ đơn bán (không bắt buộc)</label>
                                            <input type="search" id="hq-so-search" class="hq-input w-100" autocomplete="off"
                                                   placeholder="Số đơn, khách, mã sale…"/>
                                            <div id="hq-so-results" class="hq-dropdown hq-hidden"></div>
                                        </div>
                                    </div>
                                    <div id="hq-req-chip" class="hq-chip-row"></div>
                                    <div id="hq-lines"></div>
                                </section>

                                <section class="hq-step">
                                    <h3 class="hq-h3">2. Nhà cung cấp</h3>
                                    <div class="hq-picker">
                                        <label class="hq-sr-only" for="hq-partner-search">Thêm nhà cung cấp</label>
                                        <input type="search" id="hq-partner-search" class="hq-input w-100" autocomplete="off"
                                               placeholder="Thêm NCC không có trong gợi ý…"/>
                                        <div id="hq-partner-results" class="hq-dropdown hq-hidden"></div>
                                    </div>
                                    <div id="hq-chosen" class="hq-chip-row"></div>
                                    <div class="hq-muted">Gợi ý theo lịch sử mua hàng — NCC từng bán nhiều mặt hàng
                                        trong danh sách lên trước.</div>
                                    <div id="hq-suggestions" class="hq-suggestions"></div>
                                </section>

                                <section class="hq-step">
                                    <h3 class="hq-h3">3. Hạn &amp; lời nhắn</h3>
                                    <div class="row g-2">
                                        <!-- Chỉ hiện khi đang xem "Tất cả": phiếu phải gắn một mã sale cụ thể. -->
                                        <div class="col-md-4 hq-hidden" id="hq-create-code-wrap">
                                            <label class="form-label small mb-1" for="hq-create-code">Mã sale của phiếu</label>
                                            <select id="hq-create-code" class="hq-input w-100"></select>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small mb-1" for="hq-deadline">Hạn báo giá</label>
                                            <input type="date" id="hq-deadline" class="hq-input w-100"/>
                                        </div>
                                        <div class="col-md-8">
                                            <label class="form-label small mb-1" for="hq-note">Lời nhắn hiện đầu trang báo giá của NCC</label>
                                            <textarea id="hq-note" rows="2" class="hq-input hq-textarea w-100"
                                                      placeholder="Thời gian giao mong muốn, quy cách, xuất hoá đơn…"></textarea>
                                        </div>
                                    </div>
                                </section>
                                <div id="hq-modal-alert" class="hq-alert hq-hidden"></div>
                            </div>
                            <div class="hq-modal-foot" id="hq-modal-foot">
                                <span id="hq-summary" class="hq-muted"></span>
                                <button type="button" class="hq-btn hq-push" data-close="modal">Huỷ</button>
                                <button type="button" class="hq-btn hq-btn-primary" id="hq-submit">Gửi hỏi giá</button>
                            </div>
                        </div>
                    </div>

                    <!-- Trao đổi với NCC trên một báo giá / đơn mua (nổi trên ngăn chi tiết). -->
                    <div id="hq-chat" class="hq-modal hq-chat-modal hq-hidden">
                        <div class="hq-modal-box hq-chat-box">
                            <div class="hq-modal-head">
                                <h2 class="hq-h2" id="hq-chat-title">Trao đổi với NCC</h2>
                                <button type="button" class="btn-close" data-close-chat="1" aria-label="Đóng"></button>
                            </div>
                            <div class="hq-modal-body hq-chat-list" id="hq-chat-list"></div>
                            <div class="hq-modal-foot hq-chat-form">
                                <label class="hq-sr-only" for="hq-chat-input">Tin nhắn</label>
                                <textarea id="hq-chat-input" rows="2" maxlength="2000" class="hq-input hq-textarea"
                                          placeholder="Nhắn cho NCC — NCC đọc trên trang báo giá của họ. Ctrl+Enter để gửi, Ctrl+V để dán ảnh."></textarea>
                                <div class="hq-chat-side">
                                    <label class="hq-attach-btn" title="Đính kèm ảnh, PDF, Excel, Word… (tối đa 5 tệp, mỗi tệp 10MB)">
                                        <svg class="hq-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5l-8.6 8.6a5 5 0 0 1-7.1-7.1l8.6-8.6a3.3 3.3 0 0 1 4.7 4.7l-8.6 8.6a1.7 1.7 0 0 1-2.4-2.4l7.9-7.9"/></svg>
                                        <span class="hq-sr-only">Đính kèm tệp</span>
                                        <input type="file" id="hq-chat-files" multiple="multiple" class="hq-sr-only"
                                               accept="image/*,.pdf,.xls,.xlsx,.csv,.doc,.docx,.txt,.zip"/>
                                    </label>
                                    <button type="button" class="hq-btn hq-btn-primary hq-send-btn" id="hq-chat-send"><svg class="hq-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4 20-7z"/></svg>Gửi</button>
                                </div>
                                <div id="hq-chat-picked" class="hq-chat-picked"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Xem đơn mua (sale chỉ sửa được mã đơn hàng) — mở từ mục "Đơn mua" trong phiếu. -->
                    <div id="hq-po" class="hq-modal hq-chat-modal hq-hidden">
                        <div class="hq-modal-box hq-po-box">
                            <div class="hq-modal-head">
                                <h2 class="hq-h2" id="hq-po-title">Đơn mua</h2>
                                <button type="button" class="btn-close" data-close-po="1" aria-label="Đóng"></button>
                            </div>
                            <div class="hq-modal-body" id="hq-po-body"></div>
                        </div>
                    </div>

                    <!-- Thông tin NCC + link / mật khẩu để copy — mở khi bấm tên NCC trong phiếu. -->
                    <div id="hq-vendor" class="hq-modal hq-chat-modal hq-hidden">
                        <div class="hq-modal-box hq-vendor-box">
                            <div class="hq-modal-head">
                                <h2 class="hq-h2" id="hq-vendor-title">Nhà cung cấp</h2>
                                <button type="button" class="btn-close" data-close-vendor="1" aria-label="Đóng"></button>
                            </div>
                            <div class="hq-modal-body" id="hq-vendor-body"></div>
                        </div>
                    </div>

                    <div id="hq-toast" class="hq-toast hq-hidden"></div>
                </div>

                <!-- Thứ tự quan trọng: utils → ui → feature → app. -->
                <script t-attf-src="/hlv_vendor_quotation/static/src/sale_page/sale_utils.js?v=#{asset_version}"></script>
                <script t-attf-src="/hlv_vendor_quotation/static/src/sale_page/sale_ui.js?v=#{asset_version}"></script>
                <script t-attf-src="/hlv_vendor_quotation/static/src/sale_page/sale_inquiries.js?v=#{asset_version}"></script>
                <script t-attf-src="/hlv_vendor_quotation/static/src/sale_page/sale_compare.js?v=#{asset_version}"></script>
                <script t-attf-src="/hlv_vendor_quotation/static/src/sale_page/sale_price_history.js?v=#{asset_version}"></script>
                <script t-attf-src="/hlv_vendor_quotation/static/src/sale_page/sale_create.js?v=#{asset_version}"></script>
                <script t-attf-src="/hlv_vendor_quotation/static/src/sale_page/sale_chat.js?v=#{asset_version}"></script>
                <script t-attf-src="/hlv_vendor_quotation/static/src/sale_page/sale_po_origin.js?v=#{asset_version}"></script>
                <script t-attf-src="/hlv_vendor_quotation/static/src/sale_page/sale_order_view.js?v=#{asset_version}"></script>
                <script t-attf-src="/hlv_vendor_quotation/static/src/sale_page/sale_vendor_info.js?v=#{asset_version}"></script>
                <script t-attf-src="/hlv_vendor_quotation/static/src/js/odoo_bus.js?v=#{asset_version}"></script>
                <script t-attf-src="/hlv_vendor_quotation/static/src/js/chat_alert.js?v=#{asset_version}"></script>
                <script t-attf-src="/hlv_vendor_quotation/static/src/js/chat_paste.js?v=#{asset_version}"></script>
                <script t-attf-src="/hlv_vendor_quotation/static/src/sale_page/sale_bus.js?v=#{asset_version}"></script>
                <script t-attf-src="/hlv_vendor_quotation/static/src/sale_page/sale_app.js?v=#{asset_version}"></script>
            </body>
        </html>
    </template>
</odoo>
