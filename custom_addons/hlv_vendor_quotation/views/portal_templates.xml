<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Trang đứng riêng, không dùng layout website: NCC mở từ Zalo trên điện thoại,
         cần nhẹ và không lộ menu / giỏ hàng của web bán lẻ. -->
    <template id="portal_layout" name="Báo giá NCC - khung trang">
        <t t-out="doctype"/>
        <html lang="vi">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <meta name="robots" content="noindex, nofollow"/>
                <title><t t-esc="page_title or 'Báo giá'"/> · <t t-esc="company.name"/></title>
                <link rel="stylesheet" href="/hlv_vendor_quotation/static/src/css/vendor_portal.css"/>
            </head>
            <body>
                <header class="vq-header">
                    <div class="vq-wrap vq-header-row">
                        <a class="vq-brand" t-att-href="portal_base or '#'">
                            <img t-if="company.logo_web" class="vq-logo" t-att-alt="company.name"
                                 t-att-src="'/logo.png?company=%s' % company.id"/>
                            <span class="vq-brand-text">
                                <span class="vq-company" t-esc="company.name"/>
                                <span class="vq-sub">Cổng báo giá nhà cung cấp</span>
                            </span>
                        </a>
                        <div t-if="logged_in" class="vq-header-right">
                            <span class="vq-vendor-pill" t-esc="vendor.name"/>
                            <a t-att-href="'%s/logout' % portal_base" class="vq-header-link">Đăng xuất</a>
                        </div>
                    </div>
                </header>
                <main class="vq-wrap vq-main">
                    <t t-out="0"/>
                </main>
                <footer class="vq-footer">
                    <div class="vq-wrap vq-footer-row">
                        <span><b t-esc="company.name"/></span>
                        <span t-if="company.phone">ĐT: <t t-esc="company.phone"/></span>
                        <span t-if="company.email"><t t-esc="company.email"/></span>
                        <span t-if="company.website"><t t-esc="company.website"/></span>
                    </div>
                </footer>
                <script src="/hlv_vendor_quotation/static/src/js/vendor_quote_number.js"></script>
                <script src="/hlv_vendor_quotation/static/src/js/vendor_quote_form.js"></script>
            </body>
        </html>
    </template>

    <template id="portal_not_found" name="Báo giá NCC - không tìm thấy">
        <t t-call="hlv_vendor_quotation.portal_layout">
            <t t-set="page_title" t-value="'Không tìm thấy'"/>
            <section class="vq-card vq-center-card">
                <div class="vq-icon-circle">!</div>
                <h1>Link không còn hiệu lực</h1>
                <p class="vq-muted">Link báo giá này không tồn tại hoặc đã được thay bằng link mới.
                    Vui lòng liên hệ người phụ trách mua hàng để nhận link mới.</p>
            </section>
        </t>
    </template>

    <template id="portal_login" name="Báo giá NCC - đăng nhập">
        <t t-call="hlv_vendor_quotation.portal_layout">
            <t t-set="page_title" t-value="'Đăng nhập'"/>
            <section class="vq-login">
                <div class="vq-login-intro">
                    <div class="vq-login-kicker">Cổng báo giá</div>
                    <h1>Xin chào <t t-esc="vendor.name"/></h1>
                    <p><t t-esc="company.name"/> gửi yêu cầu báo giá cho quý công ty tại đây.
                        Quý công ty xem danh sách mặt hàng, điền đơn giá và gửi lại trực tuyến.</p>
                    <ul class="vq-login-points">
                        <li>Xem mọi yêu cầu báo giá đã nhận</li>
                        <li>Điền giá, VAT, thời gian giao từng mặt hàng</li>
                        <li>Sửa và gửi lại trước khi hết hạn</li>
                    </ul>
                </div>
                <div class="vq-login-form">
                    <div class="vq-lock">🔒</div>
                    <h2>Nhập mật khẩu</h2>
                    <p class="vq-muted">Mật khẩu được gửi kèm link này.</p>
                    <div t-if="error" class="vq-alert vq-alert-error" t-esc="error"/>
                    <form method="post" t-att-action="'%s/login' % portal_base">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="next_url" t-att-value="next_url"/>
                        <input type="password" name="password" class="vq-input vq-input-lg" required="required"
                               autofocus="autofocus" autocomplete="current-password" autocapitalize="characters"
                               placeholder="••••••"/>
                        <button type="submit" class="vq-btn vq-btn-primary vq-btn-block">Vào xem yêu cầu báo giá</button>
                    </form>
                    <p class="vq-muted vq-small">Chưa có mật khẩu? Vui lòng liên hệ người phụ trách mua hàng.</p>
                </div>
            </section>
        </t>
    </template>

    <template id="portal_quote_list" name="Báo giá NCC - danh sách">
        <t t-call="hlv_vendor_quotation.portal_layout">
            <t t-set="page_title" t-value="'Yêu cầu báo giá'"/>
            <t t-set="logged_in" t-value="True"/>
            <div class="vq-page-head">
                <div>
                    <h1>Yêu cầu báo giá</h1>
                    <p class="vq-muted">Chọn một yêu cầu để xem mặt hàng và điền giá.</p>
                </div>
            </div>

            <div class="vq-stats">
                <t t-foreach="tabs" t-as="tab">
                    <a t-if="tab[0] in ('waiting', 'quoted')" t-att-href="tab[3]"
                       t-attf-class="vq-stat vq-stat-#{tab[0]}">
                        <span class="vq-stat-num" t-esc="tab[2]"/>
                        <span class="vq-stat-label" t-esc="tab[1]"/>
                    </a>
                </t>
            </div>

            <div class="vq-filter-bar">
                <nav class="vq-tabs">
                    <a t-foreach="tabs" t-as="tab" t-att-href="tab[3]"
                       t-attf-class="vq-tab #{'vq-tab-active' if tab[0] == status else ''}">
                        <t t-esc="tab[1]"/> <span class="vq-tab-count" t-esc="tab[2]"/>
                    </a>
                </nav>
                <form method="get" class="vq-search" t-att-action="portal_base">
                    <input t-if="status != 'all'" type="hidden" name="status" t-att-value="status"/>
                    <span class="vq-search-icon">⌕</span>
                    <input type="search" name="q" class="vq-input" t-att-value="q"
                           placeholder="Tìm số báo giá hoặc tên hàng"/>
                </form>
            </div>

            <div t-if="not quotes" class="vq-card vq-empty">
                <div class="vq-empty-icon">📄</div>
                <t t-if="q or status != 'all'">Không có yêu cầu báo giá nào khớp bộ lọc.</t>
                <t t-else="">Hiện chưa có yêu cầu báo giá nào.</t>
            </div>
            <div class="vq-list">
                <a t-foreach="quotes" t-as="quote" t-att-href="'%s/%s' % (portal_base, quote.id)"
                   t-attf-class="vq-quote-item vq-quote-#{statuses[quote.id][1]}">
                    <t t-set="quote_status" t-value="statuses[quote.id]"/>
                    <t t-set="quote_hint" t-value="hints[quote.id]"/>
                    <div class="vq-quote-main">
                        <div class="vq-quote-head">
                            <b class="vq-quote-no" t-esc="quote.name"/>
                            <span t-attf-class="vq-badge vq-badge-#{quote_status[1]}" t-esc="quote_status[0]"/>
                        </div>
                        <div class="vq-quote-products" t-esc="', '.join(quote.line_ids[:3].mapped(lambda l: l.name or l.product_id.name)) + (' …' if len(quote.line_ids) &gt; 3 else '')"/>
                        <div class="vq-quote-meta">
                            <span><t t-esc="len(quote.line_ids)"/> mặt hàng</span>
                            <span>Gửi ngày <t t-esc="quote.create_date.strftime('%d/%m/%Y')"/></span>
                            <span t-if="quote.date_deadline">Hạn <t t-esc="quote.date_deadline.strftime('%d/%m/%Y')"/></span>
                        </div>
                    </div>
                    <div class="vq-quote-side">
                        <span t-if="quote_hint[0] and quote_status[1] != 'closed'"
                              t-attf-class="vq-hint vq-hint-#{quote_hint[1]}" t-esc="quote_hint[0]"/>
                        <span class="vq-quote-cta" t-esc="'Điền giá →' if quote_status[1] == 'waiting' else 'Xem →'"/>
                    </div>
                </a>
            </div>

            <nav t-if="pager['page_count'] &gt; 1" class="vq-pager">
                <a t-if="pager['page'] &gt; 1" t-att-href="prev_page_url" class="vq-btn vq-btn-light">← Trước</a>
                <span class="vq-muted">Trang <t t-esc="pager['page']"/> / <t t-esc="pager['page_count']"/></span>
                <a t-if="pager['page'] &lt; pager['page_count']" t-att-href="next_page_url" class="vq-btn vq-btn-light">Sau →</a>
            </nav>
        </t>
    </template>

    <template id="portal_quote_form" name="Báo giá NCC - nhập giá">
        <t t-call="hlv_vendor_quotation.portal_layout">
            <t t-set="page_title" t-value="quote.name"/>
            <t t-set="logged_in" t-value="True"/>
            <a t-att-href="portal_base" class="vq-back">← Tất cả yêu cầu báo giá</a>

            <section class="vq-card vq-quote-header">
                <div class="vq-quote-title">
                    <div>
                        <div class="vq-kicker">Yêu cầu báo giá</div>
                        <h1 t-esc="quote.name"/>
                    </div>
                    <span t-attf-class="vq-badge vq-badge-lg vq-badge-#{status[1]}" t-esc="status[0]"/>
                </div>
                <div class="vq-meta-grid">
                    <div><span class="vq-meta-label">Ngày gửi</span><t t-esc="quote.create_date.strftime('%d/%m/%Y')"/></div>
                    <div t-if="quote.date_deadline"><span class="vq-meta-label">Hạn báo giá</span>
                        <t t-esc="quote.date_deadline.strftime('%d/%m/%Y')"/>
                        <span t-if="hint[0] and editable" t-attf-class="vq-hint vq-hint-#{hint[1]}" t-esc="hint[0]"/>
                    </div>
                    <div><span class="vq-meta-label">Số mặt hàng</span><t t-esc="len(quote.line_ids)"/></div>
                    <div t-if="quote.submit_date"><span class="vq-meta-label">Đã gửi giá lúc</span>
                        <t t-esc="quote.submit_date.strftime('%d/%m/%Y')"/></div>
                    <div t-if="contact"><span class="vq-meta-label">Người phụ trách</span>
                        <t t-esc="contact.name"/>
                        <t t-set="contact_phone" t-value="contact.partner_id.mobile or contact.partner_id.phone"/>
                        <a t-if="contact_phone" class="vq-contact-link" t-att-href="'tel:%s' % contact_phone" t-esc="contact_phone"/>
                    </div>
                </div>
            </section>

            <div t-if="quote.note" class="vq-callout vq-callout-info">
                <div class="vq-callout-title">Lời nhắn từ <t t-esc="company.name"/></div>
                <div class="vq-pre" t-esc="quote.note"/>
            </div>
            <div t-if="saved" class="vq-alert vq-alert-ok">✓ Đã gửi báo giá. Cảm ơn quý công ty!
                Quý công ty vẫn có thể sửa và gửi lại trước khi hết hạn.</div>
            <div t-if="errors" class="vq-alert vq-alert-error">
                <div t-foreach="errors" t-as="error" t-esc="error"/>
            </div>
            <div t-if="not editable and quote.state != 'done'" class="vq-alert">Đã quá hạn báo giá, không sửa
                được nữa. Cần điều chỉnh giá, vui lòng liên hệ người phụ trách mua hàng.</div>
            <div t-if="quote.state == 'done'" class="vq-alert">Yêu cầu báo giá này đã đóng. Cảm ơn quý công ty
                đã báo giá.</div>

            <form method="post" class="vq-quote-form" t-att-action="'%s/%s' % (portal_base, quote.id)">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <div class="vq-table-head">
                    <div>
                        <h2>Mặt hàng cần báo giá</h2>
                        <p t-if="editable" class="vq-muted vq-small">Đơn giá là giá <b>chưa VAT</b> cho 1 đơn vị tính.
                            Mặt hàng không cung cấp được, vui lòng tích "Không có hàng".</p>
                    </div>
                    <label t-if="editable" class="vq-vat-all">VAT cho tất cả
                        <select class="vq-input vq-input-sm" data-vq-vat-all="1">
                            <option value="">—</option>
                            <option t-foreach="vat_options" t-as="opt" t-att-value="opt[0]" t-esc="opt[1]"/>
                        </select>
                    </label>
                </div>

                <div class="vq-table-wrap">
                    <table class="vq-table">
                        <thead>
                            <tr>
                                <th class="vq-col-no">#</th>
                                <th>Mặt hàng</th>
                                <th class="vq-num">Số lượng</th>
                                <th class="vq-col-price">Đơn giá chưa VAT</th>
                                <th class="vq-col-vat">VAT</th>
                                <th class="vq-col-days">Giao sau (ngày)</th>
                                <th>Ghi chú</th>
                                <th class="vq-num">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="quote.line_ids" t-as="line" class="vq-line" data-vq-line="1"
                                t-att-data-qty="line.product_qty" t-att-data-price="line.price_unit"
                                t-att-data-vat="line.vat or ''">
                                <t t-set="lid" t-value="line.id"/>
                                <t t-set="na_checked" t-value="('na_%s' % lid) in post if post else line.unavailable"/>
                                <t t-set="vat_value" t-value="post.get('vat_%s' % lid) if post else line.vat"/>
                                <td class="vq-col-no"><span class="vq-line-no" t-esc="line_index + 1"/></td>
                                <td class="vq-col-product">
                                    <div class="vq-product">
                                        <a t-if="line.product_id.image_128" class="vq-line-img" target="_blank"
                                           t-att-href="'%s/img/%s/1024' % (portal_base, lid)" title="Xem ảnh lớn">
                                            <img t-att-src="'%s/img/%s/128' % (portal_base, lid)" loading="lazy"
                                                 t-att-alt="line.product_id.name"/>
                                        </a>
                                        <div>
                                            <div class="vq-line-name" t-esc="line.name or line.product_id.display_name"/>
                                            <label class="vq-check">
                                                <input type="checkbox" value="1" data-vq-na="1" t-att-name="'na_%s' % lid"
                                                       t-att-checked="na_checked" t-att-disabled="not editable"/>
                                                Không có hàng
                                            </label>
                                        </div>
                                    </div>
                                </td>
                                <td class="vq-num" data-label="Số lượng">
                                    <b t-esc="fmt(line.product_qty)"/> <t t-esc="line.product_uom_id.name"/>
                                </td>
                                <td class="vq-col-price" data-label="Đơn giá chưa VAT">
                                    <input t-if="editable" type="text" inputmode="decimal" class="vq-input vq-input-price"
                                           data-vq-price="1" t-att-name="'price_%s' % lid" placeholder="0"
                                           t-att-value="post.get('price_%s' % lid) if post else (fmt(line.price_unit) if line.price_unit else '')"/>
                                    <span t-else="" data-vq-price-text="1" t-esc="fmt(line.price_unit) if line.price_unit else '—'"/>
                                </td>
                                <td class="vq-col-vat" data-label="VAT">
                                    <select t-if="editable" class="vq-input" data-vq-vat="1" t-att-name="'vat_%s' % lid">
                                        <option value="">—</option>
                                        <option t-foreach="vat_options" t-as="opt" t-att-value="opt[0]"
                                                t-att-selected="opt[0] == vat_value" t-esc="opt[1]"/>
                                    </select>
                                    <span t-else="" t-esc="dict(vat_options).get(line.vat, '—')"/>
                                </td>
                                <td class="vq-col-days" data-label="Giao sau (ngày)">
                                    <input t-if="editable" type="text" inputmode="numeric" class="vq-input"
                                           t-att-name="'days_%s' % lid" placeholder="—"
                                           t-att-value="post.get('days_%s' % lid) if post else (line.delivery_days or '')"/>
                                    <span t-else="" t-esc="line.delivery_days or '—'"/>
                                </td>
                                <td class="vq-col-note" data-label="Ghi chú">
                                    <input t-if="editable" type="text" class="vq-input" maxlength="255"
                                           t-att-name="'note_%s' % lid" placeholder="Hãng, xuất xứ, quy cách…"
                                           t-att-value="post.get('note_%s' % lid) if post else (line.vendor_note or '')"/>
                                    <span t-else="" t-esc="line.vendor_note or ''"/>
                                </td>
                                <td class="vq-num vq-col-total" data-label="Thành tiền">
                                    <b data-vq-subtotal="1">—</b>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <label class="vq-card vq-block">
                    <span class="vq-field-label">Ghi chú chung</span>
                    <span class="vq-muted vq-small">Điều kiện thanh toán, giao hàng, hiệu lực báo giá…</span>
                    <textarea name="vendor_note" rows="3" class="vq-input" maxlength="2000" t-att-disabled="not editable"
                              t-esc="post.get('vendor_note') if post else (quote.vendor_note or '')"/>
                </label>

                <div class="vq-submit-bar">
                    <div class="vq-wrap vq-submit-row">
                        <div class="vq-totals">
                            <div t-if="editable" class="vq-progress">
                                <span class="vq-progress-track"><span data-vq-progress-bar="1"></span></span>
                                <span class="vq-small" data-vq-progress="1"></span>
                            </div>
                            <div class="vq-total-line">Tổng chưa VAT <b data-vq-total-untaxed="1">—</b></div>
                            <div class="vq-total-line vq-total-main">Tổng sau VAT <b data-vq-total="1">—</b></div>
                        </div>
                        <button t-if="editable" type="submit" class="vq-btn vq-btn-primary vq-btn-lg">
                            <t t-esc="'Gửi lại báo giá' if quote.state == 'quoted' else 'Gửi báo giá'"/>
                        </button>
                    </div>
                </div>
            </form>
        </t>
    </template>
</odoo>
