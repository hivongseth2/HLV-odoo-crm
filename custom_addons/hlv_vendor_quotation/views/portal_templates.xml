<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Trang đứng riêng, không dùng layout website: NCC mở từ Zalo trên điện thoại,
         cần nhẹ và không lộ menu / giỏ hàng của web bán lẻ. -->
    <template id="portal_layout" name="Báo giá NCC - khung trang">
        <t t-out="doctype"/>
        <html lang="vi">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <meta name="robots" content="noindex, nofollow"/>
                <title><t t-esc="page_title or 'Báo giá'"/> · <t t-esc="company.name"/></title>
                <link rel="stylesheet" t-attf-href="/hlv_vendor_quotation/static/src/css/vendor_portal.css?v=#{asset_version}"/>
            </head>
            <body>
                <header class="vq-header">
                    <div class="vq-wrap vq-header-row">
                        <a class="vq-brand" t-att-href="portal_base or '#'">
                            <img t-if="company.logo_web" class="vq-logo" t-att-alt="company.name"
                                 t-att-src="'/logo.png?company=%s' % company.id"/>
                            <span class="vq-brand-text">
                                <span class="vq-company" t-esc="company.name"/>
                                <span class="vq-sub">Báo giá nhà cung cấp</span>
                            </span>
                        </a>
                        <div t-if="logged_in" class="vq-header-right">
                            <span class="vq-header-vendor" t-esc="vendor.name"/>
                            <a t-att-href="'%s/logout' % portal_base" class="vq-header-link">Đăng xuất</a>
                        </div>
                    </div>
                </header>
                <main class="vq-main">
                    <t t-out="0"/>
                </main>
                <footer class="vq-footer">
                    <div class="vq-wrap vq-footer-row">
                        <span t-esc="company.name"/>
                        <span t-if="company.phone" t-esc="company.phone"/>
                        <span t-if="company.email" t-esc="company.email"/>
                        <span t-if="company.website" t-esc="company.website"/>
                    </div>
                </footer>
                <script t-attf-src="/hlv_vendor_quotation/static/src/js/vendor_quote_number.js?v=#{asset_version}"></script>
                <script t-attf-src="/hlv_vendor_quotation/static/src/js/vendor_quote_form.js?v=#{asset_version}"></script>
            </body>
        </html>
    </template>

    <template id="portal_not_found" name="Báo giá NCC - không tìm thấy">
        <t t-call="hlv_vendor_quotation.portal_layout">
            <t t-set="page_title" t-value="'Không tìm thấy'"/>
            <section class="vq-wrap vq-message">
                <h1>Link không còn hiệu lực</h1>
                <p class="vq-muted">Link báo giá này không tồn tại hoặc đã được thay bằng link mới.
                    Vui lòng liên hệ người phụ trách mua hàng để nhận link mới.</p>
            </section>
        </t>
    </template>

    <!-- Hai cột chiếm hết khung trang (không phải hộp nhỏ giữa màn hình). Điện thoại: ô
         mật khẩu lên trước, phần giới thiệu xuống dưới. -->
    <template id="portal_login" name="Báo giá NCC - đăng nhập">
        <t t-call="hlv_vendor_quotation.portal_layout">
            <t t-set="page_title" t-value="'Đăng nhập'"/>
            <section class="vq-wrap vq-login">
                <div class="vq-login-intro">
                    <p class="vq-eyebrow">Gửi <t t-esc="vendor.name"/></p>
                    <h1><t t-esc="company.name"/> mời quý công ty báo giá</h1>
                    <p class="vq-lead">Danh sách mặt hàng cần báo giá nằm ở trang này. Quý công ty điền đơn
                        giá, VAT, thời gian giao cho từng mặt hàng và gửi trực tuyến — có thể sửa và gửi lại
                        cho đến khi hết hạn.</p>
                    <ol class="vq-steps">
                        <li><b>Đăng nhập</b> bằng mật khẩu được gửi kèm link.</li>
                        <li><b>Chọn yêu cầu báo giá</b> trong danh sách.</li>
                        <li><b>Điền giá</b> chưa VAT cho từng mặt hàng, chọn VAT, bấm Gửi báo giá.</li>
                    </ol>
                </div>
                <div class="vq-login-panel">
                    <h2>Đăng nhập</h2>
                    <p class="vq-muted">Nhập mật khẩu được gửi kèm link này.</p>
                    <div t-if="error" class="vq-alert vq-alert-error" t-esc="error"/>
                    <form method="post" class="vq-login-form" t-att-action="'%s/login' % portal_base">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="next_url" t-att-value="next_url"/>
                        <label class="vq-label" for="vq-password">Mật khẩu</label>
                        <input type="password" id="vq-password" name="password" class="vq-input vq-input-lg"
                               required="required" autofocus="autofocus" autocomplete="current-password"
                               autocapitalize="characters"/>
                        <button type="submit" class="vq-btn vq-btn-primary vq-btn-block">Tiếp tục</button>
                    </form>
                    <p class="vq-muted vq-small">Chưa có mật khẩu hoặc quên mật khẩu? Vui lòng liên hệ người phụ
                        trách mua hàng của <t t-esc="company.name"/>.</p>
                </div>
            </section>
        </t>
    </template>

    <!-- Hai mục của NCC: yêu cầu báo giá và đơn mua sinh ra từ báo giá. -->
    <template id="portal_tabs" name="Báo giá NCC - tab">
        <nav class="vq-section-tabs">
            <a t-att-href="portal_base"
               t-attf-class="vq-section-tab #{'vq-section-tab-active' if active_tab == 'quotes' else ''}">Yêu cầu báo giá</a>
            <a t-att-href="'%s/don-mua' % portal_base"
               t-attf-class="vq-section-tab #{'vq-section-tab-active' if active_tab == 'orders' else ''}">
                Đơn mua hàng <span class="vq-tab-count">(<t t-esc="order_count"/>)</span></a>
        </nav>
    </template>

    <!-- Trao đổi với bên mua trên một báo giá / đơn mua. Chỉ tin thuộc kênh "Trao đổi với NCC"
         (services/vendor_chat.py) — tin hệ thống không hiện ở đây. Cần biến chat, chat_url. -->
    <template id="portal_chat" name="Báo giá NCC - trao đổi">
        <section class="vq-chat" id="trao-doi">
            <h2>Trao đổi với <t t-esc="company.name"/></h2>
            <p t-if="not chat" class="vq-muted vq-small">Chưa có tin nhắn. Cần hỏi thêm về quy cách, số lượng,
                thời gian giao… quý công ty nhắn tại đây.</p>
            <div t-foreach="chat" t-as="msg" t-attf-class="vq-msg #{'vq-msg-mine' if msg['from_vendor'] else ''}">
                <div class="vq-msg-head">
                    <b t-esc="'Quý công ty' if msg['from_vendor'] else msg['author']"/>
                    <span class="vq-muted" t-esc="msg['date']"/>
                </div>
                <div class="vq-msg-body" t-esc="msg['body']"/>
            </div>
            <form method="post" class="vq-chat-form" t-att-action="chat_url">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <label class="vq-sr-only" for="vq-chat-message">Tin nhắn</label>
                <textarea id="vq-chat-message" name="message" rows="2" class="vq-input" maxlength="2000"
                          required="required" placeholder="Nhập tin nhắn…"/>
                <button type="submit" class="vq-btn vq-btn-primary">Gửi</button>
            </form>
        </section>
    </template>

    <template id="portal_quote_list" name="Báo giá NCC - danh sách">
        <t t-call="hlv_vendor_quotation.portal_layout">
            <t t-set="page_title" t-value="'Yêu cầu báo giá'"/>
            <t t-set="logged_in" t-value="True"/>
            <div class="vq-wrap">
                <t t-call="hlv_vendor_quotation.portal_tabs"/>
                <div class="vq-page-head">
                    <h1>Yêu cầu báo giá</h1>
                    <form method="get" class="vq-search" t-att-action="portal_base">
                        <input t-if="status != 'all'" type="hidden" name="status" t-att-value="status"/>
                        <input type="search" name="q" class="vq-input" t-att-value="q"
                               placeholder="Tìm số báo giá hoặc tên hàng"/>
                        <button type="submit" class="vq-btn vq-btn-secondary">Tìm</button>
                    </form>
                </div>

                <nav class="vq-tabs">
                    <a t-foreach="tabs" t-as="tab" t-att-href="tab[3]"
                       t-attf-class="vq-tab #{'vq-tab-active' if tab[0] == status else ''}">
                        <t t-esc="tab[1]"/> <span class="vq-tab-count">(<t t-esc="tab[2]"/>)</span>
                    </a>
                </nav>

                <p t-if="not quotes" class="vq-empty">
                    <t t-if="q or status != 'all'">Không có yêu cầu báo giá nào khớp bộ lọc.</t>
                    <t t-else="">Hiện chưa có yêu cầu báo giá nào.</t>
                </p>
                <table t-if="quotes" class="vq-table vq-list-table">
                    <thead>
                        <tr>
                            <th>Số báo giá</th>
                            <th>Mặt hàng</th>
                            <th>Ngày gửi</th>
                            <th>Hạn báo giá</th>
                            <th>Trạng thái</th>
                            <th>Đơn mua</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="quotes" t-as="quote">
                            <t t-set="quote_status" t-value="statuses[quote.id]"/>
                            <t t-set="quote_hint" t-value="hints[quote.id]"/>
                            <t t-set="quote_url" t-value="'%s/%s' % (portal_base, quote.id)"/>
                            <td class="vq-cell-ref"><a t-att-href="quote_url" t-esc="quote.name"/></td>
                            <td class="vq-cell-products" data-label="Mặt hàng">
                                <div class="vq-clamp" t-esc="', '.join(quote.line_ids[:3].mapped(lambda l: l.name or l.product_id.name)) + (' …' if len(quote.line_ids) &gt; 3 else '')"/>
                                <span class="vq-muted vq-small"><t t-esc="len(quote.line_ids)"/> mặt hàng</span>
                            </td>
                            <td data-label="Ngày gửi" t-esc="quote.create_date.strftime('%d/%m/%Y')"/>
                            <td data-label="Hạn báo giá">
                                <t t-if="quote.date_deadline" t-esc="quote.date_deadline.strftime('%d/%m/%Y')"/>
                                <t t-else="">—</t>
                                <div t-if="quote_hint[0] and quote_status[1] != 'closed'"
                                     t-attf-class="vq-small vq-hint-#{quote_hint[1]}" t-esc="quote_hint[0]"/>
                            </td>
                            <td data-label="Trạng thái">
                                <span t-attf-class="vq-status vq-status-#{quote_status[1]}" t-esc="quote_status[0]"/>
                            </td>
                            <td data-label="Đơn mua">
                                <t t-set="po_list" t-value="quote_orders[quote.id]"/>
                                <a t-foreach="po_list" t-as="po" class="vq-block-link"
                                   t-att-href="'%s/don-mua/%s' % (portal_base, po.id)" t-esc="po.name"/>
                                <t t-if="not po_list">—</t>
                            </td>
                            <td class="vq-cell-action">
                                <a t-att-href="quote_url" t-attf-class="vq-btn #{'vq-btn-primary' if quote_status[1] == 'waiting' else 'vq-btn-secondary'}"
                                   t-esc="'Điền giá' if quote_status[1] == 'waiting' else 'Xem'"/>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <nav t-if="pager['page_count'] &gt; 1" class="vq-pager">
                    <a t-if="pager['page'] &gt; 1" t-att-href="prev_page_url" class="vq-btn vq-btn-secondary">Trang trước</a>
                    <span class="vq-muted">Trang <t t-esc="pager['page']"/> / <t t-esc="pager['page_count']"/></span>
                    <a t-if="pager['page'] &lt; pager['page_count']" t-att-href="next_page_url" class="vq-btn vq-btn-secondary">Trang sau</a>
                </nav>
            </div>
        </t>
    </template>

    <template id="portal_quote_form" name="Báo giá NCC - nhập giá">
        <t t-call="hlv_vendor_quotation.portal_layout">
            <t t-set="page_title" t-value="quote.name"/>
            <t t-set="logged_in" t-value="True"/>
            <t t-set="active_tab" t-value="'quotes'"/>
            <div class="vq-wrap">
                <t t-call="hlv_vendor_quotation.portal_tabs"/>
                <nav class="vq-breadcrumb">
                    <a t-att-href="portal_base">Yêu cầu báo giá</a> / <span t-esc="quote.name"/>
                </nav>

                <div class="vq-page-head">
                    <h1 t-esc="quote.name"/>
                    <span t-attf-class="vq-status vq-status-#{status[1]}" t-esc="status[0]"/>
                </div>

                <dl class="vq-facts">
                    <div><dt>Ngày gửi</dt><dd t-esc="quote.create_date.strftime('%d/%m/%Y')"/></div>
                    <div t-if="quote.date_deadline"><dt>Hạn báo giá</dt>
                        <dd><t t-esc="quote.date_deadline.strftime('%d/%m/%Y')"/>
                            <span t-if="hint[0] and editable" t-attf-class="vq-small vq-hint-#{hint[1]}">
                                (<t t-esc="hint[0].lower()"/>)</span></dd></div>
                    <div><dt>Số mặt hàng</dt><dd t-esc="len(quote.line_ids)"/></div>
                    <div t-if="quote.submit_date"><dt>Gửi giá lần cuối</dt>
                        <dd t-esc="quote.submit_date.strftime('%d/%m/%Y')"/></div>
                    <div t-if="contact"><dt>Người phụ trách</dt>
                        <dd><t t-esc="contact.name"/>
                            <t t-set="contact_phone" t-value="contact.partner_id.mobile or contact.partner_id.phone"/>
                            <a t-if="contact_phone" class="vq-block-link" t-att-href="'tel:%s' % contact_phone"
                               t-esc="contact_phone"/></dd></div>
                </dl>

                <section t-if="orders" class="vq-note">
                    <h2>Đơn mua từ báo giá này</h2>
                    <p class="vq-muted vq-small">Cảm ơn quý công ty — các mặt hàng được chọn đã lên đơn mua:</p>
                    <a t-foreach="orders" t-as="po" class="vq-block-link"
                       t-att-href="'%s/don-mua/%s' % (portal_base, po.id)">
                        <t t-esc="po.name"/> · <t t-esc="fmt(po.amount_untaxed)"/> chưa VAT</a>
                </section>
                <section t-if="quote.note" class="vq-note">
                    <h2>Lời nhắn từ <t t-esc="company.name"/></h2>
                    <p class="vq-pre" t-esc="quote.note"/>
                </section>
                <div t-if="saved" class="vq-alert vq-alert-ok">Đã gửi báo giá. Cảm ơn quý công ty — quý công ty
                    vẫn có thể sửa và gửi lại trước khi hết hạn.</div>
                <div t-if="errors" class="vq-alert vq-alert-error">
                    <div t-foreach="errors" t-as="error" t-esc="error"/>
                </div>
                <div t-if="not editable and quote.state != 'done'" class="vq-alert">Đã quá hạn báo giá, không sửa
                    được nữa. Cần điều chỉnh giá, vui lòng liên hệ người phụ trách mua hàng.</div>
                <div t-if="quote.state == 'done'" class="vq-alert">Yêu cầu báo giá này đã đóng. Cảm ơn quý công ty
                    đã báo giá.</div>

                <form method="post" class="vq-quote-form" t-att-action="'%s/%s' % (portal_base, quote.id)">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="vq-section-head">
                        <div>
                            <h2>Mặt hàng cần báo giá</h2>
                            <p t-if="any(line_choice.values())" class="vq-small vq-choice-legend">
                                Dòng nền xanh: <t t-esc="company.name"/> đã chọn giá của quý công ty. Dòng gạch:
                                đã chọn nhà cung cấp khác.</p>
                            <p t-if="editable" class="vq-muted vq-small">Đơn giá là giá chưa VAT cho một đơn vị
                                tính. Mặt hàng không cung cấp được, vui lòng chọn "Không có hàng".</p>
                        </div>
                        <label t-if="editable" class="vq-inline-field">
                            <span>VAT cho tất cả dòng</span>
                            <select class="vq-input" data-vq-vat-all="1">
                                <option value="">Chọn</option>
                                <option t-foreach="vat_options" t-as="opt" t-att-value="opt[0]" t-esc="opt[1]"/>
                            </select>
                        </label>
                    </div>

                    <table class="vq-table vq-price-table">
                        <thead>
                            <tr>
                                <th class="vq-col-no">STT</th>
                                <th>Mặt hàng</th>
                                <th class="vq-num">Số lượng</th>
                                <th class="vq-col-price">Đơn giá chưa VAT</th>
                                <th class="vq-col-vat">VAT</th>
                                <th class="vq-col-days">Giao sau (ngày)</th>
                                <th class="vq-col-note">Ghi chú</th>
                                <th class="vq-num vq-col-total">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="quote.line_ids" t-as="line" data-vq-line="1"
                                t-attf-class="vq-line #{'vq-line-chosen' if line_choice.get(line.id) == 'selected' else ''} #{'vq-line-lost' if line_choice.get(line.id) == 'other' else ''}"
                                t-att-data-qty="line.product_qty" t-att-data-price="line.price_unit"
                                t-att-data-vat="line.vat or ''">
                                <t t-set="lid" t-value="line.id"/>
                                <t t-set="na_checked" t-value="('na_%s' % lid) in post if post else line.unavailable"/>
                                <t t-set="vat_value" t-value="post.get('vat_%s' % lid) if post else line.vat"/>
                                <td class="vq-col-no" t-esc="line_index + 1"/>
                                <td class="vq-col-product">
                                    <div class="vq-product">
                                        <a t-if="line.product_id.image_128" class="vq-line-img" target="_blank"
                                           t-att-href="'%s/img/%s/1024' % (portal_base, lid)" title="Xem ảnh lớn">
                                            <img t-att-src="'%s/img/%s/128' % (portal_base, lid)" loading="lazy"
                                                 t-att-alt="line.product_id.name"/>
                                        </a>
                                        <div>
                                            <div class="vq-line-name" t-esc="line.name or line.product_id.display_name"/>
                                            <div t-if="line_choice.get(line.id) == 'selected'" class="vq-choice vq-choice-won">Được chọn</div>
                                            <div t-if="line_choice.get(line.id) == 'other'" class="vq-choice">Đã chọn nhà cung cấp khác</div>
                                            <label class="vq-check">
                                                <input type="checkbox" value="1" data-vq-na="1" t-att-name="'na_%s' % lid"
                                                       t-att-checked="na_checked" t-att-disabled="not editable"/>
                                                Không có hàng
                                            </label>
                                        </div>
                                    </div>
                                </td>
                                <td class="vq-num" data-label="Số lượng">
                                    <t t-esc="fmt(line.product_qty)"/> <t t-esc="line.product_uom_id.name"/>
                                </td>
                                <td class="vq-col-price" data-label="Đơn giá chưa VAT">
                                    <input t-if="editable" type="text" inputmode="decimal" class="vq-input vq-input-price"
                                           data-vq-price="1" t-att-name="'price_%s' % lid"
                                           t-att-value="post.get('price_%s' % lid) if post else (fmt(line.price_unit) if line.price_unit else '')"/>
                                    <span t-else="" t-esc="fmt(line.price_unit) if line.price_unit else '—'"/>
                                </td>
                                <td class="vq-col-vat" data-label="VAT">
                                    <select t-if="editable" class="vq-input" data-vq-vat="1" t-att-name="'vat_%s' % lid">
                                        <option value="">Chọn</option>
                                        <option t-foreach="vat_options" t-as="opt" t-att-value="opt[0]"
                                                t-att-selected="opt[0] == vat_value" t-esc="opt[1]"/>
                                    </select>
                                    <span t-else="" t-esc="dict(vat_options).get(line.vat, '—')"/>
                                </td>
                                <td class="vq-col-days" data-label="Giao sau (ngày)">
                                    <input t-if="editable" type="text" inputmode="numeric" class="vq-input"
                                           t-att-name="'days_%s' % lid"
                                           t-att-value="post.get('days_%s' % lid) if post else (line.delivery_days or '')"/>
                                    <span t-else="" t-esc="line.delivery_days or '—'"/>
                                </td>
                                <td class="vq-col-note" data-label="Ghi chú">
                                    <input t-if="editable" type="text" class="vq-input" maxlength="255"
                                           t-att-name="'note_%s' % lid" placeholder="Hãng, xuất xứ, quy cách"
                                           t-att-value="post.get('note_%s' % lid) if post else (line.vendor_note or '')"/>
                                    <span t-else="" t-esc="line.vendor_note or ''"/>
                                </td>
                                <td class="vq-num vq-col-total" data-label="Thành tiền" data-vq-subtotal="1">—</td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="vq-form-foot">
                        <label class="vq-general-note">
                            <span class="vq-label">Ghi chú chung</span>
                            <textarea name="vendor_note" rows="4" class="vq-input" maxlength="2000"
                                      t-att-disabled="not editable"
                                      placeholder="Điều kiện thanh toán, giao hàng, hiệu lực báo giá"
                                      t-esc="post.get('vendor_note') if post else (quote.vendor_note or '')"/>
                        </label>
                        <div class="vq-summary-col">
                            <span class="vq-label">Tổng tiền</span>
                            <dl class="vq-summary">
                                <div><dt>Tổng chưa VAT</dt><dd data-vq-total-untaxed="1">—</dd></div>
                                <div class="vq-summary-total"><dt>Tổng sau VAT</dt><dd data-vq-total="1">—</dd></div>
                            </dl>
                        </div>
                    </div>

                    <div t-if="editable" class="vq-submit-bar">
                        <div class="vq-wrap vq-submit-row">
                            <span class="vq-muted" data-vq-progress="1"></span>
                            <button type="submit" class="vq-btn vq-btn-primary vq-btn-lg">
                                <t t-esc="'Gửi lại báo giá' if quote.state == 'quoted' else 'Gửi báo giá'"/>
                            </button>
                        </div>
                    </div>
                </form>
                <t t-call="hlv_vendor_quotation.portal_chat"/>
            </div>
        </t>
    </template>
</odoo>
