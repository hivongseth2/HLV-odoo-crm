<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vendor_quote_list" model="ir.ui.view">
        <field name="name">hlv.vendor.quote.list</field>
        <field name="model">hlv.vendor.quote</field>
        <field name="arch" type="xml">
            <list string="Yêu cầu báo giá NCC" decoration-muted="state in ('done', 'cancel')">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="request_id"/>
                <field name="sale_order_id" optional="show"/>
                <field name="origin" optional="hide"/>
                <field name="date_deadline"/>
                <field name="submit_date" optional="show"/>
                <field name="price_valid_until" optional="show"/>
                <field name="amount_untaxed" sum="Tổng" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="selected_line_count" string="Dòng được chọn" optional="hide"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'sent'"
                       decoration-success="state == 'quoted'"
                       decoration-muted="state in ('draft', 'done', 'cancel')"/>
            </list>
        </field>
    </record>

    <!-- Mở ra ngay sau khi wizard "Hỏi giá NCC" chạy: mỗi dòng một NCC, có sẵn link thẳng vào
         báo giá + mật khẩu để copy gửi Zalo. -->
    <record id="view_vendor_quote_share_list" model="ir.ui.view">
        <field name="name">hlv.vendor.quote.share.list</field>
        <field name="model">hlv.vendor.quote</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <list string="Gửi link cho NCC" create="0">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="portal_quote_url" widget="CopyClipboardChar"/>
                <field name="portal_password" widget="CopyClipboardChar"/>
                <field name="portal_url" widget="CopyClipboardChar" optional="hide"/>
                <field name="date_deadline"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_vendor_quote_form" model="ir.ui.view">
        <field name="name">hlv.vendor.quote.form</field>
        <field name="model">hlv.vendor.quote</field>
        <field name="arch" type="xml">
            <form string="Yêu cầu báo giá NCC">
                <header>
                    <button name="action_open_vendor_wizard" type="object" string="Gợi ý &amp; gửi NCC"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_send" type="object" string="Mở cho NCC báo giá"
                            invisible="state != 'draft' or not partner_id"/>
                    <button name="action_open_compare" type="object" string="So sánh giá" class="oe_highlight"
                            invisible="state not in ('quoted', 'done')"/>
                    <button name="action_close" type="object" string="Đóng báo giá"
                            invisible="state not in ('sent', 'quoted')"/>
                    <button name="action_reopen" type="object" string="Mở lại cho NCC sửa"
                            invisible="state != 'done'"/>
                    <button name="action_cancel" type="object" string="Huỷ"
                            invisible="state in ('cancel', 'done')"/>
                    <button name="action_draft" type="object" string="Về nháp"
                            invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,quoted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="request_id or state in ('draft', 'cancel')">
                        Báo giá chưa gắn Yêu cầu mua hàng — thu mua chưa chọn được giá.
                        Gắn YCMH ở ô bên dưới; mặt hàng sẽ tự ghép theo sản phẩm.
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'" required="state != 'draft'"
                                   placeholder="Để trống rồi bấm &quot;Gợi ý &amp; gửi NCC&quot;"
                                   context="{'res_partner_search_mode': 'supplier'}"/>
                            <field name="sale_order_id" readonly="state in ('done', 'cancel')"/>
                            <field name="request_id" readonly="state in ('done', 'cancel')"
                                   placeholder="Chưa có YCMH thì để trống, gắn sau"
                                   domain="[('sale_order_id', '=', sale_order_id)] if sale_order_id else []"/>
                            <field name="origin" invisible="not request_id"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </group>
                        <group>
                            <field name="date_deadline" readonly="state in ('done', 'cancel')"/>
                            <field name="portal_quote_url" widget="CopyClipboardChar" invisible="not access_id"/>
                            <field name="portal_password" widget="CopyClipboardChar" invisible="not access_id"/>
                            <field name="portal_url" string="Link mọi báo giá của NCC" widget="CopyClipboardChar"
                                   invisible="not access_id"/>
                            <field name="access_id" invisible="1"/>
                            <field name="submit_date" invisible="not submit_date"/>
                            <field name="price_valid_until" invisible="state not in ('quoted', 'done')"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Mặt hàng" name="lines">
                            <field name="line_ids" readonly="state in ('done', 'cancel')">
                                <list editable="bottom" decoration-success="is_best_price"
                                      decoration-bf="selected" decoration-muted="unavailable">
                                    <field name="sequence" widget="handle"/>
                                    <field name="image_128" widget="image" options="{'size': [40, 40]}" optional="show"/>
                                    <field name="product_id" readonly="request_line_id or parent.state != 'draft'"/>
                                    <field name="name" optional="show"/>
                                    <field name="product_qty" readonly="parent.state != 'draft'"/>
                                    <field name="product_uom_id" groups="uom.group_uom" readonly="parent.state != 'draft'"/>
                                    <field name="request_line_id" optional="show" column_invisible="not parent.request_id"
                                           domain="[('request_id', '=', parent.request_id)]"
                                           options="{'no_create': True}"/>
                                    <field name="price_unit"/>
                                    <field name="vat"/>
                                    <field name="delivery_days" optional="show"/>
                                    <field name="unavailable" optional="show"/>
                                    <field name="invoice_name" optional="show"/>
                                    <field name="vendor_note" optional="show"/>
                                    <field name="inherited_from_id" optional="hide" readonly="1"/>
                                    <field name="price_subtotal" sum="Tổng"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="is_best_price" column_invisible="1"/>
                                    <field name="selected" readonly="1" optional="show"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="amount_untaxed"/>
                                <field name="amount_total"/>
                            </group>
                        </page>
                        <page string="Lời nhắn &amp; ghi chú" name="notes">
                            <group>
                                <field name="note" placeholder="Hiện ở đầu trang báo giá của NCC"/>
                                <field name="vendor_note"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_vendor_quote_search" model="ir.ui.view">
        <field name="name">hlv.vendor.quote.search</field>
        <field name="model">hlv.vendor.quote</field>
        <field name="arch" type="xml">
            <search string="Yêu cầu báo giá NCC">
                <field name="name"/>
                <field name="request_id"/>
                <field name="origin"/>
                <field name="sale_order_id"/>
                <field name="partner_id"/>
                <filter name="filter_sent" string="Chờ NCC báo giá" domain="[('state', '=', 'sent')]"/>
                <filter name="filter_quoted" string="NCC đã báo giá" domain="[('state', '=', 'quoted')]"/>
                <filter name="filter_open" string="Đang mở" domain="[('state', 'in', ('draft', 'sent', 'quoted'))]"/>
                <filter name="filter_no_request" string="Chưa gắn YCMH" domain="[('request_id', '=', False)]"/>
                <separator/>
                <filter name="filter_mine" string="Tôi phụ trách" domain="[('user_id', '=', uid)]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_request" string="Yêu cầu mua hàng" context="{'group_by': 'request_id'}"/>
                    <filter name="group_partner" string="Nhà cung cấp" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_state" string="Trạng thái" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_vendor_quote" model="ir.actions.act_window">
        <field name="name">Yêu cầu báo giá NCC</field>
        <field name="res_model">hlv.vendor.quote</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_vendor_quote_search"/>
        <field name="context">{'search_default_filter_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa có yêu cầu báo giá nào</p>
            <p>Vào "Theo nhà cung cấp", chọn NCC rồi "Tạo yêu cầu báo giá" — hoặc trên Yêu cầu mua hàng
                bấm "Hỏi giá NCC" để gửi cùng lúc cho nhiều NCC.</p>
        </field>
    </record>
</odoo>
