<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Đề xuất thay đổi đơn mua của NCC (models/purchase_order_revision.py): thu mua xem cũ → mới từng dòng,
         duyệt (áp vào đơn) hoặc không duyệt (ghi lý do). NCC thấy kết quả trên khung trao đổi + lịch sử đề xuất. -->
    <record id="view_po_revision_list" model="ir.ui.view">
        <field name="name">hlv.po.revision.list</field>
        <field name="model">hlv.po.revision</field>
        <field name="arch" type="xml">
            <list string="Đề xuất thay đổi đơn mua" create="0"
                  decoration-warning="state == 'pending'" decoration-muted="state in ('rejected', 'withdrawn')">
                <field name="purchase_order_id"/>
                <field name="partner_id"/>
                <field name="number"/>
                <field name="create_date" string="Gửi lúc"/>
                <field name="summary"/>
                <field name="state" widget="badge" decoration-warning="state == 'pending'"
                       decoration-success="state in ('approved', 'applied')" decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_po_revision_form" model="ir.ui.view">
        <field name="name">hlv.po.revision.form</field>
        <field name="model">hlv.po.revision</field>
        <field name="arch" type="xml">
            <form string="Đề xuất thay đổi đơn mua" create="0">
                <header>
                    <button name="action_approve" type="object" string="Duyệt — áp vào đơn" class="btn-primary"
                            invisible="state != 'pending'" groups="purchase.group_purchase_user"
                            confirm="Áp số lượng / đơn giá / ngày giao đề xuất vào đơn mua?"/>
                    <button name="action_reject" type="object" string="Không duyệt"
                            invisible="state != 'pending'" groups="purchase.group_purchase_user"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,approved,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1>Đề xuất số <field name="number" class="oe_inline"/></h1></div>
                    <group>
                        <group>
                            <field name="purchase_order_id"/>
                            <field name="partner_id"/>
                            <field name="author_partner_id"/>
                            <field name="create_date" string="Gửi lúc"/>
                        </group>
                        <group>
                            <field name="decided_user_id" invisible="not decided_user_id"/>
                            <field name="decided_date" invisible="not decided_date"/>
                            <field name="reject_reason" readonly="state != 'pending'"
                                   placeholder="Bắt buộc khi không duyệt — NCC sẽ thấy lý do"/>
                        </group>
                    </group>
                    <field name="vendor_note" readonly="1" invisible="not vendor_note" nolabel="1"
                           placeholder="Ghi chú của NCC"/>
                    <field name="line_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="old_qty"/>
                            <field name="new_qty" decoration-bf="new_qty != old_qty"/>
                            <field name="uom_name"/>
                            <field name="old_price_unit"/>
                            <field name="new_price_unit" decoration-bf="new_price_unit != old_price_unit"/>
                            <field name="tax_rate" optional="hide"/>
                            <field name="old_date"/>
                            <field name="new_date" decoration-bf="new_date != old_date"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_po_revision_search" model="ir.ui.view">
        <field name="name">hlv.po.revision.search</field>
        <field name="model">hlv.po.revision</field>
        <field name="arch" type="xml">
            <search>
                <field name="purchase_order_id"/>
                <field name="partner_id"/>
                <filter name="filter_pending" string="Chờ duyệt" domain="[('state', '=', 'pending')]"/>
            </search>
        </field>
    </record>

    <record id="action_po_revision" model="ir.actions.act_window">
        <field name="name">Đề xuất thay đổi đơn mua của NCC</field>
        <field name="res_model">hlv.po.revision</field>
        <field name="view_mode">list,form</field>
        <field name="context">{"search_default_filter_pending": 1}</field>
    </record>

    <!-- Đơn mua: nút "Đề xuất NCC" + báo đầu đơn khi có đề xuất chờ duyệt. -->
    <record id="view_purchase_order_form_po_revision" model="ir.ui.view">
        <field name="name">purchase.order.form.po.revision</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_hlv_revisions" type="object" class="oe_stat_button" icon="fa-history"
                        invisible="not hlv_revision_ids">
                    <field name="hlv_revision_pending_count" widget="statinfo" string="Đề xuất NCC chờ duyệt"/>
                </button>
                <field name="hlv_revision_ids" invisible="1"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0" role="alert" invisible="not hlv_revision_pending_count">
                    NCC đề xuất thay đổi đơn này — bấm "Đề xuất NCC chờ duyệt" để xem và duyệt.
                </div>
            </xpath>
        </field>
    </record>
</odoo>
