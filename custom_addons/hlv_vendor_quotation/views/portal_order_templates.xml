<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tab "Đơn mua hàng" của NCC: đơn mua đã xác nhận sinh ra từ báo giá của chính NCC. -->
    <template id="portal_order_list" name="Báo giá NCC - đơn mua">
        <t t-call="hlv_vendor_quotation.portal_layout">
            <t t-set="page_title" t-value="'Đơn mua hàng'"/>
            <t t-set="logged_in" t-value="True"/>
            <div class="vq-wrap">
                <t t-call="hlv_vendor_quotation.portal_tabs"/>
                <div class="vq-page-head">
                    <h1>Đơn mua hàng</h1>
                </div>
                <p class="vq-muted">Đơn mua của <t t-esc="company.name"/> lên từ các báo giá quý công ty đã gửi.
                    Khi hàng đã đóng gói hoặc đã giao, vui lòng cập nhật ở từng đơn.</p>

                <p t-if="not orders" class="vq-empty">Chưa có đơn mua nào từ báo giá của quý công ty.</p>
                <table t-if="orders" class="vq-table vq-list-table">
                    <thead>
                        <tr>
                            <th>Số đơn</th>
                            <th>Ngày đặt</th>
                            <th>Ngày nhận dự kiến</th>
                            <th>Từ báo giá</th>
                            <th class="vq-num">Tổng chưa VAT</th>
                            <th>Tiến độ</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="orders" t-as="order">
                            <t t-set="order_url" t-value="'%s/don-mua/%s' % (portal_base, order.id)"/>
                            <td class="vq-cell-ref"><a t-att-href="order_url" t-esc="order.name"/></td>
                            <td data-label="Ngày đặt" t-esc="(order.date_approve or order.date_order).strftime('%d/%m/%Y')"/>
                            <td data-label="Ngày nhận dự kiến">
                                <t t-if="order.date_planned" t-esc="order.date_planned.strftime('%d/%m/%Y')"/>
                                <t t-else="">—</t>
                            </td>
                            <td data-label="Từ báo giá">
                                <a t-foreach="order_quotes[order.id]" t-as="quote" class="vq-block-link"
                                   t-att-href="'%s/%s' % (portal_base, quote.id)" t-esc="quote.name"/>
                            </td>
                            <td class="vq-num" data-label="Tổng chưa VAT" t-esc="fmt(order.amount_untaxed)"/>
                            <td data-label="Tiến độ">
                                <span t-if="order.hlv_vendor_status" class="vq-status vq-status-quoted"
                                      t-esc="vendor_status_labels[order.hlv_vendor_status]"/>
                                <span t-else="" class="vq-status vq-status-waiting">Chưa cập nhật</span>
                            </td>
                            <td class="vq-cell-action">
                                <a t-att-href="order_url" class="vq-btn vq-btn-secondary">Xem</a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <template id="portal_order_form" name="Báo giá NCC - chi tiết đơn mua">
        <t t-call="hlv_vendor_quotation.portal_layout">
            <t t-set="page_title" t-value="order.name"/>
            <t t-set="logged_in" t-value="True"/>
            <div class="vq-wrap">
                <t t-call="hlv_vendor_quotation.portal_tabs"/>
                <nav class="vq-breadcrumb">
                    <a t-att-href="'%s/don-mua' % portal_base">Đơn mua hàng</a> / <span t-esc="order.name"/>
                </nav>
                <div class="vq-page-head">
                    <h1 t-esc="order.name"/>
                    <span t-if="order.hlv_vendor_status" class="vq-status vq-status-quoted"
                          t-esc="vendor_status_labels[order.hlv_vendor_status]"/>
                    <span t-else="" class="vq-status vq-status-waiting">Chưa cập nhật tiến độ</span>
                </div>

                <dl class="vq-facts">
                    <div><dt>Ngày đặt</dt><dd t-esc="(order.date_approve or order.date_order).strftime('%d/%m/%Y')"/></div>
                    <div t-if="order.date_planned"><dt>Ngày nhận dự kiến</dt>
                        <dd t-esc="order.date_planned.strftime('%d/%m/%Y')"/></div>
                    <div t-if="quotes"><dt>Từ báo giá</dt>
                        <dd><a t-foreach="quotes" t-as="quote" class="vq-block-link"
                               t-att-href="'%s/%s' % (portal_base, quote.id)" t-esc="quote.name"/></dd></div>
                    <div t-if="order.user_id"><dt>Người phụ trách</dt>
                        <dd><t t-esc="order.user_id.name"/>
                            <t t-set="contact_phone" t-value="order.user_id.partner_id.mobile or order.user_id.partner_id.phone"/>
                            <a t-if="contact_phone" class="vq-block-link" t-att-href="'tel:%s' % contact_phone"
                               t-esc="contact_phone"/></dd></div>
                    <div t-if="order.hlv_vendor_status_date"><dt>Cập nhật tiến độ lúc</dt>
                        <dd t-esc="order.hlv_vendor_status_date.strftime('%d/%m/%Y')"/></div>
                </dl>

                <div t-if="saved" class="vq-alert vq-alert-ok">Đã cập nhật tiến độ đơn. Cảm ơn quý công ty!</div>

                <section class="vq-status-panel">
                    <h2>Cập nhật tiến độ</h2>
                    <p class="vq-muted vq-small">Bấm khi hàng đã đóng gói xong, và khi đã giao tới kho của
                        <t t-esc="company.name"/>.</p>
                    <form method="post" class="vq-status-actions" t-att-action="'%s/don-mua/%s' % (portal_base, order.id)">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <t t-set="current_index" t-value="[s[0] for s in vendor_status].index(order.hlv_vendor_status) if order.hlv_vendor_status else -1"/>
                        <t t-foreach="vendor_status" t-as="option">
                            <button type="submit" name="status" t-att-value="option[0]"
                                    t-att-disabled="option_index &lt;= current_index"
                                    t-attf-class="vq-btn #{'vq-btn-primary' if option_index == current_index + 1 else 'vq-btn-secondary'}"
                                    t-esc="option[1]"/>
                        </t>
                    </form>
                </section>

                <h2 class="vq-section-title">Mặt hàng</h2>
                <table class="vq-table vq-price-table">
                    <thead>
                        <tr>
                            <th class="vq-col-no">STT</th>
                            <th>Mặt hàng</th>
                            <th class="vq-num">Số lượng</th>
                            <th class="vq-num">Đã nhận</th>
                            <th class="vq-num">Đơn giá</th>
                            <th class="vq-num">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="order.order_line.filtered(lambda l: not l.display_type)" t-as="line">
                            <td class="vq-col-no" t-esc="line_index + 1"/>
                            <td class="vq-col-product"><div class="vq-line-name" t-esc="line.name"/></td>
                            <td class="vq-num" data-label="Số lượng">
                                <t t-esc="fmt(line.product_qty)"/> <t t-esc="line.product_uom.name"/></td>
                            <td class="vq-num" data-label="Đã nhận" t-esc="fmt(line.qty_received)"/>
                            <td class="vq-num" data-label="Đơn giá" t-esc="fmt(line.price_unit)"/>
                            <td class="vq-num vq-col-total" data-label="Thành tiền" t-esc="fmt(line.price_subtotal)"/>
                        </tr>
                    </tbody>
                </table>

                <dl class="vq-summary vq-summary-inline">
                    <div><dt>Tổng chưa VAT</dt><dd t-esc="fmt(order.amount_untaxed)"/></div>
                    <div><dt>Thuế</dt><dd t-esc="fmt(order.amount_tax)"/></div>
                    <div class="vq-summary-total"><dt>Tổng cộng</dt><dd t-esc="fmt(order.amount_total)"/></div>
                </dl>
                <t t-call="hlv_vendor_quotation.portal_chat"/>
            </div>
        </t>
    </template>
</odoo>
