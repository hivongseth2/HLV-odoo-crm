<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tab "Đơn mua hàng" của NCC: đơn mua đã xác nhận (kể cả đã hủy sau khi xác nhận) sinh ra từ báo
         giá của chính NCC. Chia tab theo tiến độ; bấm dòng để xem nhanh hàng + cập nhật tiến độ tại chỗ
         (js/vendor_quote_list.js — dùng chung với danh sách báo giá, cùng thuộc tính data-quote-row). -->
    <template id="portal_order_list" name="Báo giá NCC - đơn mua">
        <t t-call="hlv_vendor_quotation.portal_layout">
            <t t-set="page_title" t-value="'Đơn mua hàng'"/>
            <t t-set="logged_in" t-value="True"/>
            <div class="vq-wrap">
                <t t-call="hlv_vendor_quotation.portal_tabs"/>
                <div class="vq-page-head">
                    <h1>Đơn mua hàng</h1>
                </div>
                <p class="vq-muted">Đơn mua của <t t-esc="company.name"/> lên từ các báo giá quý công ty đã gửi. Đóng
                    gói xong bấm "Đã đóng gói"; đơn gửi CPN / gửi chành thì báo thêm thông tin gửi. Kho
                    <t t-esc="company.name"/> nhận hàng xong, đơn tự chuyển "Đã giao".</p>
                <div t-if="saved_order" class="vq-alert vq-alert-ok">Đã cập nhật tiến độ đơn <t t-esc="saved_order"/>.</div>

                <nav class="vq-tabs">
                    <a t-foreach="tabs" t-as="tab" t-att-href="tab[3]"
                       t-attf-class="vq-tab #{'vq-tab-active' if tab[0] == stage else ''}">
                        <t t-esc="tab[1]"/> <span class="vq-tab-count">(<t t-esc="tab[2]"/>)</span>
                    </a>
                </nav>

                <p t-if="not orders" class="vq-empty">Không có đơn mua nào ở mục này.</p>
                <div t-if="orders" class="vq-list-scroll">
                <table class="vq-table vq-list-table vq-order-table">
                    <thead>
                        <tr>
                            <th>Số đơn</th>
                            <th>Ngày đặt</th>
                            <th>Hàng về dự kiến</th>
                            <th>Giao hàng</th>
                            <th class="vq-num">Tổng tiền</th>
                            <th>Tiến độ</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody data-live="rows">
                        <t t-foreach="orders" t-as="order">
                        <t t-set="mark" t-value="marks[order.id]"/>
                        <t t-set="info" t-value="infos[order.id]"/>
                        <t t-set="order_url" t-value="'%s/don-mua/%s' % (portal_base, order.id)"/>
                        <tr t-attf-class="vq-quote-row #{'vq-row-new' if mark['unread'] or mark['new'] else ''}"
                            t-att-data-quote-row="order.id">
                            <td class="vq-cell-ref">
                                <button type="button" class="vq-quick-toggle" t-att-data-quick-toggle="order.id"
                                        aria-expanded="false" title="Xem nhanh hàng và cập nhật tiến độ">
                                    <svg class="vq-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
                                    <span class="vq-sr-only">Xem nhanh</span>
                                </button>
                                <a t-att-href="order_url" t-esc="order.name"/>
                                <span t-if="mark['unread']" class="vq-chip-new" t-att-title="'%s tin nhắn chưa xem' % mark['unread']"><svg class="vq-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 21l1.9-5.4A8 8 0 1 1 21 12z"/></svg><t t-esc="mark['unread']"/> tin mới</span>
                                <span t-elif="mark['new']" class="vq-chip-fresh">Mới</span>
                            </td>
                            <td data-label="Ngày đặt" t-esc="fdate(order.date_approve or order.date_order)"/>
                            <td data-label="Hàng về dự kiến" t-esc="fdate(order.date_planned) or '—'"/>
                            <td data-label="Giao hàng" class="vq-cell-term" t-esc="info['delivery_term'] or '—'"/>
                            <td class="vq-num vq-cell-amount" data-label="Tổng tiền">
                                <b t-esc="fmt(order.amount_total)"/>
                                <div class="vq-muted vq-small">chưa VAT <t t-esc="fmt(order.amount_untaxed)"/></div>
                            </td>
                            <td data-label="Tiến độ">
                                <span t-attf-class="vq-status vq-status-#{info['progress']}" t-esc="progress_labels[info['progress']]"/>
                            </td>
                            <td class="vq-cell-action">
                                <!-- Việc NCC cần làm ngay: bấm thẳng ở đây; còn lại mở xem nhanh. -->
                                <form t-if="info['progress'] == 'waiting'" method="post" t-att-action="order_url">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="next" t-att-value="next_url"/>
                                    <button type="submit" name="status" value="packed" class="vq-btn vq-btn-primary">Đã đóng gói</button>
                                </form>
                                <button t-elif="info['progress'] == 'packed'" type="button"
                                        class="vq-btn vq-btn-secondary" t-att-data-quick-toggle="order.id">Báo đã gửi hàng</button>
                                <a t-else="" t-att-href="order_url" class="vq-btn vq-btn-secondary">Xem</a>
                            </td>
                        </tr>
                        <tr class="vq-quick-row" t-att-data-quick-row="order.id" hidden="hidden">
                            <td colspan="7" class="vq-quick-cell">
                                <t t-call="hlv_vendor_quotation.portal_order_quick"/>
                            </td>
                        </tr>
                        </t>
                    </tbody>
                </table>
                </div>
            </div>
        </t>
    </template>

    <!-- Xem nhanh một đơn mua trong danh sách: hàng + tổng + tiến độ (cập nhật được tại chỗ). Biến vào:
         order, info, order_url, order_quotes, next_url. -->
    <template id="portal_order_quick" name="Báo giá NCC - xem nhanh đơn mua">
        <div class="vq-quick">
            <div class="vq-quick-scroll">
                <table class="vq-table vq-price-table vq-order-lines">
                    <thead>
                        <tr>
                            <th class="vq-col-no">#</th>
                            <th>Mặt hàng</th>
                            <th class="vq-num">Số lượng</th>
                            <th class="vq-num">Đã nhận</th>
                            <th class="vq-num">Đơn giá sau VAT</th>
                            <th class="vq-num">Thành tiền sau VAT</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-call="hlv_vendor_quotation.portal_order_line_rows"/>
                    </tbody>
                </table>
            </div>
            <div class="vq-quick-progress">
                <!-- Mở xem nhanh là để cập nhật: khung "Báo đã gửi hàng" mở sẵn. -->
                <t t-call="hlv_vendor_quotation.portal_order_progress"><t t-set="ship_open" t-value="True"/></t>
            </div>
            <div class="vq-quick-foot">
                <span class="vq-quick-requester">
                    <t t-if="info['delivery_place']">Giao tới: <b t-esc="info['delivery_place']"/> · </t>
                    Từ báo giá: <t t-foreach="order_quotes[order.id]" t-as="quote"><a t-att-href="'%s/%s' % (portal_base, quote.id)"
                        t-esc="quote.name"/><t t-if="not quote_last">, </t></t>
                </span>
                <span class="vq-quick-total">Sau VAT <b t-esc="fmt(order.amount_total)"/> · chưa VAT <t t-esc="fmt(order.amount_untaxed)"/></span>
                <a t-att-href="order_url" class="vq-btn vq-btn-secondary">Mở đơn →</a>
            </div>
        </div>
    </template>

    <!-- Dòng hàng của đơn mua (trang đơn + xem nhanh). Giá sau VAT là số chính — thói quen đọc giá của hai bên. -->
    <template id="portal_order_line_rows" name="Báo giá NCC - dòng hàng đơn mua">
        <tr t-foreach="order.order_line.filtered(lambda l: not l.display_type)" t-as="line">
            <td class="vq-col-no" t-esc="line_index + 1"/>
            <td class="vq-col-product"><div class="vq-line-name" t-esc="line.name"/>
                <div t-if="line.hlv_invoice_name" class="vq-muted vq-small">Tên xuất HĐ: <t t-esc="line.hlv_invoice_name"/></div></td>
            <td class="vq-num" data-label="Số lượng"><t t-esc="fmt(line.product_qty)"/> <t t-esc="line.product_uom.name"/></td>
            <td class="vq-num" data-label="Đã nhận" t-esc="fmt(line.qty_received)"/>
            <td class="vq-num" data-label="Đơn giá sau VAT">
                <t t-esc="fmt(line.price_total / line.product_qty) if line.product_qty else '—'"/>
                <div class="vq-muted vq-small">chưa VAT <t t-esc="fmt(line.price_unit)"/></div>
            </td>
            <td class="vq-num vq-col-total" data-label="Thành tiền sau VAT" t-esc="fmt(line.price_total)"/>
        </tr>
    </template>

    <!-- Tiến độ đơn: thanh các bước + đúng MỘT việc NCC cần làm lúc này. Báo đã gửi hàng thu gọn sau
         một nút (bấm mới hiện ô nhập): gửi CPN / chành (cần mã vận đơn / số xe) hay NCC tự vận chuyển.
         "Đã giao" tự chuyển khi kho bên mua nhận đủ hàng. Biến vào: order, info, order_url; tuỳ chọn:
         next_url (về lại danh sách), from_quote, post, ship_open (mở sẵn khung báo gửi). -->
    <template id="portal_order_progress" name="Báo giá NCC - tiến độ đơn mua">
        <t t-set="progress" t-value="info['progress']"/>
        <t t-set="steps" t-value="['waiting', 'packed'] + (['shipped'] if info['ship_mode'] or progress == 'shipped' else []) + ['delivered']"/>
        <t t-set="current" t-value="steps.index(progress) if progress in steps else len(steps)"/>
        <div t-if="progress == 'cancel'" class="vq-progress-cancel">Đơn đã hủy — quý công ty không cần đóng gói / giao hàng.</div>
        <t t-else="">
            <ol class="vq-track">
                <li t-foreach="steps" t-as="step"
                    t-attf-class="vq-track-step #{'is-done' if step_index &lt; current or progress == 'delivered' else ('is-current' if step_index == current else '')}">
                    <span class="vq-track-dot"/><span class="vq-track-label" t-esc="progress_labels[step]"/>
                </li>
            </ol>
            <div class="vq-progress-action">
                <form t-if="progress == 'waiting'" method="post" class="vq-progress-row" t-att-action="order_url">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input t-if="next_url" type="hidden" name="next" t-att-value="next_url"/>
                    <input t-if="from_quote" type="hidden" name="from" t-att-value="from_quote.id"/>
                    <button type="submit" name="status" value="packed" class="vq-btn vq-btn-primary">Đã đóng gói</button>
                    <span class="vq-muted vq-small">Bấm khi hàng đã đóng gói xong.</span>
                </form>
                <p t-elif="progress == 'delivered'" class="vq-progress-note">Kho <t t-esc="company.name"/> đã nhận hàng —
                    đơn đã giao xong. Cảm ơn quý công ty!</p>
                <t t-else="">
                    <p class="vq-progress-note">
                        <t t-if="progress == 'shipped'">Đã gửi hàng: <b t-esc="info['ship_text']"/>. </t>
                        Kho <t t-esc="company.name"/> nhận hàng xong, đơn tự chuyển "Đã giao".
                    </p>
                    <t t-set="method" t-value="(post.get('method') if post else order.hlv_ship_method) or ('cpn' if info['ship_mode'] else 'self')"/>
                    <details class="vq-ship-box" t-att-open="bool(post or ship_open) or None">
                        <summary t-attf-class="vq-btn #{'vq-btn-secondary' if progress == 'shipped' else 'vq-btn-primary'}"
                                 t-esc="'Sửa thông tin gửi' if progress == 'shipped' else 'Báo đã gửi hàng'"/>
                        <form method="post" enctype="multipart/form-data" class="vq-ship-form" t-att-action="order_url">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input t-if="next_url" type="hidden" name="next" t-att-value="next_url"/>
                            <input t-if="from_quote" type="hidden" name="from" t-att-value="from_quote.id"/>
                            <input type="hidden" name="ship" value="1"/>
                            <div class="vq-seg" role="radiogroup" aria-label="Cách gửi hàng">
                                <label><input type="radio" name="method" value="cpn" t-att-checked="method == 'cpn'"/>Gửi CPN / chành</label>
                                <label><input type="radio" name="method" value="self" t-att-checked="method == 'self'"/>NCC tự vận chuyển</label>
                            </div>
                            <div class="vq-ship-grid">
                                <label class="vq-ship-field vq-if-cpn">
                                    <span class="vq-label">Hãng CPN / chành <span class="vq-muted">(tuỳ chọn)</span></span>
                                    <input type="text" name="carrier" class="vq-input" maxlength="120" placeholder="VD Viettel Post"
                                           t-att-value="post.get('carrier') if post else (order.hlv_ship_carrier or '')"/>
                                </label>
                                <label class="vq-ship-field">
                                    <span class="vq-label"><span class="vq-if-cpn">Mã vận đơn / số xe</span><span class="vq-if-self">Người giao · SĐT · biển số <span class="vq-muted">(tuỳ chọn)</span></span></span>
                                    <input type="text" name="ref" class="vq-input" maxlength="120"
                                           t-att-value="post.get('ref') if post else (order.hlv_ship_ref or '')"/>
                                </label>
                                <label class="vq-ship-field">
                                    <span class="vq-label">Ảnh phiếu gửi <span class="vq-muted">(tuỳ chọn)</span></span>
                                    <input type="file" name="attachments" multiple="multiple" accept="image/*,.pdf" class="vq-file"/>
                                </label>
                                <button type="submit" class="vq-btn vq-btn-primary">Gửi</button>
                            </div>
                        </form>
                    </details>
                </t>
            </div>
        </t>
    </template>

    <template id="portal_order_form" name="Báo giá NCC - chi tiết đơn mua">
        <t t-call="hlv_vendor_quotation.portal_layout">
            <t t-set="page_title" t-value="order.name"/>
            <t t-set="logged_in" t-value="True"/>
            <t t-set="order_url" t-value="'%s/don-mua/%s' % (portal_base, order.id)"/>
            <div class="vq-wrap">
                <t t-call="hlv_vendor_quotation.portal_tabs"/>
                <!-- Vào từ một báo giá thì breadcrumb đi qua báo giá đó để quay lại được. -->
                <nav class="vq-breadcrumb">
                    <t t-if="from_quote">
                        <a t-att-href="portal_base">Yêu cầu báo giá</a> /
                        <a t-att-href="'%s/%s' % (portal_base, from_quote.id)" t-esc="from_quote.name"/> /
                    </t>
                    <a t-else="" t-att-href="'%s/don-mua' % portal_base">Đơn mua hàng</a><t t-if="not from_quote"> /</t>
                    <span t-esc="order.name"/>
                </nav>
                <div class="vq-page-head">
                    <h1 t-esc="order.name"/>
                    <span t-attf-class="vq-status vq-status-#{info['progress']}" t-esc="progress_labels[info['progress']]"/>
                    <a class="vq-btn vq-btn-secondary vq-push" target="_blank" t-att-href="'%s/in' % order_url">In đơn mua hàng</a>
                </div>

                <dl class="vq-facts">
                    <div><dt>Ngày đặt</dt><dd t-esc="fdate(order.date_approve or order.date_order)"/></div>
                    <!-- Datetime lưu UTC — fdate đổi sang giờ VN (00:00 ngày 08 giờ VN không bị in thành ngày 07). -->
                    <div t-if="order.date_planned"><dt>Hàng về dự kiến</dt><dd t-esc="fdate(order.date_planned)"/></div>
                    <div t-if="info['delivery_term']"><dt>Phương thức giao hàng</dt><dd t-esc="info['delivery_term']"/></div>
                    <div t-if="info['delivery_place']"><dt>Địa điểm giao hàng</dt><dd class="vq-pre" t-esc="info['delivery_place']"/></div>
                    <div t-if="quotes"><dt>Từ báo giá</dt>
                        <dd><a t-foreach="quotes" t-as="quote" class="vq-block-link"
                               t-att-href="'%s/%s' % (portal_base, quote.id)" t-esc="quote.name"/></dd></div>
                </dl>

                <div t-if="saved" class="vq-alert vq-alert-ok">Đã cập nhật tiến độ đơn. Cảm ơn quý công ty!</div>
                <div t-if="ship_error" class="vq-alert vq-alert-error" t-esc="ship_error"/>
                <section class="vq-progress-panel">
                    <h2>Tiến độ đơn</h2>
                    <t t-call="hlv_vendor_quotation.portal_order_progress"/>
                </section>

                <h2 class="vq-section-title">Mặt hàng</h2>
                <table class="vq-table vq-price-table">
                    <thead>
                        <tr>
                            <th class="vq-col-no">STT</th>
                            <th>Mặt hàng</th>
                            <th class="vq-num">Số lượng</th>
                            <th class="vq-num">Đã nhận</th>
                            <th class="vq-num">Đơn giá sau VAT</th>
                            <th class="vq-num">Thành tiền sau VAT</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-call="hlv_vendor_quotation.portal_order_line_rows"/>
                    </tbody>
                </table>

                <dl class="vq-summary vq-summary-inline">
                    <div><dt>Trước VAT</dt><dd t-esc="fmt(order.amount_untaxed)"/></div>
                    <div><dt>VAT</dt><dd t-esc="fmt(order.amount_tax)"/></div>
                    <div class="vq-summary-total"><dt>Tổng cộng</dt><dd t-esc="fmt(order.amount_total)"/></div>
                </dl>
                <t t-call="hlv_vendor_quotation.portal_chat"/>
            </div>
        </t>
    </template>

    <!-- Bản in đơn mua cho NCC: mã QR số đơn (quét để đối chiếu khi giao), danh sách hàng,
         tổng tiền. Cố ý không logo / không khung trang: in ra kẹp cùng hàng là đủ.
         HIỆN KHÔNG DÙNG: nút "In đơn mua" in mẫu chuẩn purchase.report_purchaseorder
         (controllers/vendor_portal_orders.py). Giữ lại để dùng lại sau. -->
    <template id="portal_order_print" name="Báo giá NCC - in đơn mua">
        <t t-out="doctype"/>
        <html lang="vi">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <meta name="robots" content="noindex, nofollow"/>
                <title>Đơn mua <t t-esc="order.name"/></title>
                <link rel="stylesheet" t-attf-href="/hlv_vendor_quotation/static/src/css/vendor_order_print.css?v=#{asset_version}"/>
            </head>
            <body>
                <div class="po-print-bar">
                    <button type="button" onclick="window.print()">In</button>
                </div>
                <main class="po-sheet">
                    <header class="po-head">
                        <div>
                            <h1>ĐƠN MUA HÀNG</h1>
                            <div class="po-number" t-esc="order.name"/>
                            <table class="po-info">
                                <tr><th>Ngày đặt</th><td t-esc="fdate((order.date_approve or order.date_order))"/></tr>
                                <tr t-if="order.date_planned"><th>Ngày nhận dự kiến</th>
                                    <td t-esc="fdate(order.date_planned)"/></tr>
                                <tr><th>Bên mua</th><td t-esc="company.name"/></tr>
                                <tr><th>Nhà cung cấp</th><td t-esc="vendor.name"/></tr>
                            </table>
                        </div>
                        <img class="po-qr" t-att-alt="order.name"
                             t-att-src="'/report/barcode/?barcode_type=QR&amp;value=%s&amp;width=180&amp;height=180' % order.name"/>
                    </header>
                    <table class="po-lines">
                        <thead>
                            <tr>
                                <th class="po-no">STT</th>
                                <th>Mặt hàng</th>
                                <th class="po-num">Số lượng</th>
                                <th>ĐVT</th>
                                <th class="po-num">Đơn giá</th>
                                <th class="po-num">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="order.order_line.filtered(lambda l: not l.display_type)" t-as="line">
                                <td class="po-no" t-esc="line_index + 1"/>
                                <td><t t-esc="line.name"/>
                                    <div t-if="line.hlv_invoice_name" class="po-sub">Tên xuất HĐ: <t t-esc="line.hlv_invoice_name"/></div></td>
                                <td class="po-num" t-esc="fmt(line.product_qty)"/>
                                <td t-esc="line.product_uom.name"/>
                                <td class="po-num" t-esc="fmt(line.price_unit)"/>
                                <td class="po-num" t-esc="fmt(line.price_subtotal)"/>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr><td colspan="5" class="po-num">Tổng chưa VAT</td><td class="po-num" t-esc="fmt(order.amount_untaxed)"/></tr>
