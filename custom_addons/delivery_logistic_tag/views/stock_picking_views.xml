<odoo>
    <record id="view_picking_form_logistic_tag" model="ir.ui.view">
        <field name="name">stock.picking.form.logistic.tag</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Delivery Documents">
                    <field name="delivery_note_attachment" filename="delivery_note_filename"/>
                </group>
                <button name="%(delivery_logistic_tag.report_logistic_tag)d" string="Print Logistic Tag" type="action" class="btn-primary"/>
            </xpath>
        </field>
    </record>
</odoo>