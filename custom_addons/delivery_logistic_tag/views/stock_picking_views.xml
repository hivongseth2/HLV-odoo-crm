<odoo>
    <record id="view_picking_form_logistic_tag" model="ir.ui.view">
        <field name="name">stock.picking.form.logistic.tag</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
        <xpath expr="//sheet" position="inside">
            <group string="Delivery Documents">
            <field name="delivery_note_attachment" filename="delivery_note_filename"/>
            </group>
            <button name="print_logistic_tag" type="object" string="Print Logistic Tag" class="btn-primary"/>
        </xpath>
        </field>
    </record>
</odoo>
