<odoo>
    <template id="logistic_tag_template">
        <t t-call="web.external_layout">
            <div style="border: 1px solid #000; padding: 10px;">
                <h3>Logistic Tag</h3>
                <p><strong>Delivery Date:</strong> <t t-esc="o.scheduled_date"/></p>
                <p><strong>Order No.:</strong> <t t-esc="o.name"/></p>
                <p><strong>Customer:</strong> <t t-esc="o.partner_id.name"/></p>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Qty</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.move_ids_without_package" t-as="move">
                            <td><t t-esc="move.product_id.display_name"/></td>
                            <td><t t-esc="move.product_uom_qty"/></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>
</odoo>