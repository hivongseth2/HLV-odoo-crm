<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_line_make_purchase_order_inherit_misa" model="ir.ui.view">
        <field name="name">purchase.request.line.make.purchase.order.inherit.misa</field>
        <field name="model">purchase.request.line.make.purchase.order</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_line_make_purchase_order"/>
        <field name="arch" type="xml">
            <!-- Xóa các thành phần layout cũ -->
            <xpath expr="//separator[1]" position="replace" />
            <xpath expr="//group[field[@name='purchase_order_id']]" position="replace" />
            <xpath expr="//separator[1]" position="replace" />
            
            <!-- Thay thế group chứa supplier_id thành layout mới hoàn chỉnh -->
            <xpath expr="//group[field[@name='supplier_id']]" position="replace">
                <div class="alert alert-info" role="alert" style="margin-bottom: 20px;">
                    <i class="fa fa-info-circle me-2"/> <strong>Hướng dẫn: Tạo mới hoặc gộp RFQ</strong><br/>
                    - Chọn Nhà cung cấp và để trống ô <em>Đơn mua hàng có sẵn</em> để hệ thống tự động <strong>tạo RFQ mới</strong>.<br/>
                    - Hoặc chọn một <em>Đơn mua hàng có sẵn</em> để <strong>gộp (thêm)</strong> các sản phẩm này vào đó.
                </div>
                <group>
                    <group>
                        <label for="supplier_id" string="Nhà cung cấp (Áp dụng tất cả)"/>
                        <div class="o_row">
                            <field name="supplier_id" nolabel="1"
                                   domain="[('parent_id', '=', False), ('active', '=', True)]"
                                   options="{'no_create': False, 'no_quick_create': True}"
                                   context="{'default_supplier_rank': 1, 'default_is_company': True, 'default_company_type': 'company'}"
                                   help="Chọn Nhà cung cấp ở đây sẽ lọc các đơn mua hàng có sẵn và áp dụng chung cho các sản phẩm bên dưới nếu bạn gộp đơn."/>
                        </div>
                    </group>
                    <group>
                        <field name="purchase_order_id"
                               string="Đơn mua hàng có sẵn"
                               domain="[('partner_id', '=', supplier_id)]"
                               options="{'no_create': True}"
                               placeholder="Để trống để tạo mới..."/>
                        <field name="sync_data_planned" />
                    </group>
                </group>

                <!-- Ẩn field gốc để lưu state -->
                <field name="toggle_keep_description" invisible="1"/>
                <field name="toggle_keep_estimated_cost" invisible="1"/>

                <separator string="Tùy chọn hàng loạt" invisible="1" />
                <div style="display: flex; gap: 40px; margin-bottom: 12px; padding-left: 8px;" invisible="1">
                    <!-- Toggle Giữ Mô tả -->
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <button name="action_toggle_description_on" type="object"
                                invisible="toggle_keep_description"
                                class="btn btn-link p-0 border-0"
                                title="Bấm để BẬT giữ mô tả cho tất cả dòng">
                            <i class="fa fa-toggle-off fa-2x text-muted"/>
                        </button>
                        <button name="action_toggle_description_off" type="object"
                                invisible="not toggle_keep_description"
                                class="btn btn-link p-0 border-0"
                                title="Bấm để TẮT giữ mô tả cho tất cả dòng">
                            <i class="fa fa-toggle-on fa-2x text-success"/>
                        </button>
                        <span class="fw-bold">Giữ Mô tả (Tất cả)</span>
                    </div>

                    <!-- Toggle Giữ Giá -->
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <button name="action_toggle_cost_on" type="object"
                                invisible="toggle_keep_estimated_cost"
                                class="btn btn-link p-0 border-0"
                                title="Bấm để BẬT giữ giá cho tất cả dòng">
                            <i class="fa fa-toggle-off fa-2x text-muted"/>
                        </button>
                        <button name="action_toggle_cost_off" type="object"
                                invisible="not toggle_keep_estimated_cost"
                                class="btn btn-link p-0 border-0"
                                title="Bấm để TẮT giữ giá cho tất cả dòng">
                            <i class="fa fa-toggle-on fa-2x text-success"/>
                        </button>
                        <span class="fw-bold">Giữ Giá (Tất cả)</span>
                    </div>
                </div>
            </xpath>

            <!-- Sắp xếp lại danh sách sản phẩm -->
            <xpath expr="//field[@name='item_ids']" position="replace">
                <field name="item_ids" nolabel="1" colspan="2">
                    <list name="Chi tiết" create="false" editable="bottom">
                        <field name="line_id" options="{'no_open': true}" optional="hide" force_save="1" />
                        <field name="request_id" optional="hide" force_save="1" />
                        <field name="supplier_ref" optional="hide" force_save="1" />
                        <field name="supplier_id" width="180px" force_save="1" />
                        <field name="product_id" width="200px" force_save="1" />
                        <field name="name" optional="hide" force_save="1" />
                        <field name="product_qty" column_invisible="1" force_save="1" />
                        <field name="actual_qty" width="120px" widget="float_with_proposed" options="{'proposed_field': 'product_qty'}" decoration-success="1" force_save="1" />
                        <field name="product_uom_id" optional="hide" groups="!uom.group_uom" force_save="1" />
                        <field name="product_uom_id" groups="uom.group_uom" width="80px" force_save="1" />
                        
                        <!-- Đơn giá: Sale đề xuất (ẩn) + Thực mua (widget) -->
                        <field name="misa_price_before_tax" column_invisible="1" force_save="1" />
                        <field name="actual_price_unit" string="Đơn giá thực mua" 
                               width="140px" widget="float_with_proposed" options="{'proposed_field': 'misa_price_before_tax'}"
                               force_save="1" decoration-success="1" />
                        
                        <!-- Thuế: Sale yêu cầu (ẩn) + Thu mua (widget) -->
                        <field name="misa_tax_id" column_invisible="1" force_save="1" />
                        <field name="actual_tax_id" string="Thuế (%) thu mua" 
                               width="160px" widget="many2one_with_proposed" options="{'proposed_field': 'misa_tax_id'}"
                               force_save="1" decoration-success="1" />
                        <field name="actual_tax_rate" optional="hide" force_save="1" />
                        
                        <!-- Tổng tiền: computed readonly -->
                        <field name="misa_price_before_tax_total" string="Tổng tiền trước thuế" 
                               readonly="1" force_save="1" width="120px" />
                        <field name="misa_tax_amount_total" string="Tổng tiền thuế" 
                               readonly="1" force_save="1" width="120px" />
                        <field name="misa_amount" string="Thành tiền" 
                               readonly="1" force_save="1" width="120px" decoration-info="1" />
                        
                        <!-- Chiết khấu: mặc định hide -->
                        <field name="misa_discount_rate" string="CK sale (%)" 
                               readonly="1" force_save="1" decoration-muted="1" 
                               width="80px" optional="hide" />
                        <field name="misa_discount_amount" string="Tiền CK sale" 
                               readonly="1" force_save="1" decoration-muted="1" 
                               width="100px" optional="hide" />
                        <field name="actual_discount_rate" string="CK thu mua (%)" 
                               width="100px" decoration-success="1" optional="hide" force_save="1" />
                        <field name="actual_discount_amount" string="Tiền CK thu mua" 
                               width="100px" decoration-success="1" optional="hide" force_save="1" />
                        
                        <field name="estimated_cost" optional="hide" force_save="1" />
                        <field name="keep_description" optional="hide" force_save="1" />
                        <field name="keep_estimated_cost" optional="hide" force_save="1" />
                        
                        <!-- NCC mới per-line -->
                        <field name="misa_new_supplier_json" column_invisible="1" force_save="1" />
                        <field name="misa_has_new_supplier" column_invisible="1" />
                        <button name="action_create_item_supplier" type="object"
                                string="Tạo NCC" class="btn-warning btn-sm"
                                icon="fa-plus-circle"
                                title="Tạo Nhà cung cấp mới từ dữ liệu MISA cho dòng này"
                                invisible="not misa_has_new_supplier" />
                    </list>
                </field>
            </xpath>
        </field>
    </record>
</odoo>