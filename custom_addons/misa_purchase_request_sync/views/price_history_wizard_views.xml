<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="price_history_wizard_form" model="ir.ui.view">
        <field name="name">price.history.wizard.form</field>
        <field name="model">price.history.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="product_id" string="Sản phẩm"/>
                    </group>
                    <separator string="Lịch sử giá mua"/>
                    <field name="supplierinfo_ids" nolabel="1">
                        <list>
                            <field name="partner_id" string="Nhà cung cấp"/>
                            <field name="product_code" string="Mã hàng NCC"/>
                            <field name="price" string="Đơn giá"/>
                            <field name="min_qty" string="SL tối thiểu"/>
                            <field name="delay" string="Giao (ngày)"/>
                            <button name="action_apply_price" type="object"
                                    string="Chọn giá"
                                    icon="fa-check"
                                    class="btn-primary"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button string="Đóng" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>