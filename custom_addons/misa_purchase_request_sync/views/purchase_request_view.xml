<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Thêm nút "Đẩy sang MISA CRM" vào header của form Purchase Request.
        Nút chỉ hiển thị ở state 'draft' (chưa phê duyệt) vì đó là lúc
        người dùng cần đẩy ngược về MISA trước khi duyệt.
    -->
    <record id="view_purchase_request_form_inherit_misa_sync" model="ir.ui.view">
        <field name="name">purchase.request.form.inherit.misa.sync</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_send_to_misa_crm"
                    string="Đẩy sang MISA CRM"
                    type="object"
                    class="btn-secondary"
                    invisible="1"
                    groups="purchase_request.group_purchase_request_manager"
                />
            </xpath>
            <xpath expr="//field[@name='requested_by']" position="after">
                <field name="sale_order_id" readonly="state in ('done', 'rejected')"/>
                <field name="delivery_address" readonly="state in ('done', 'rejected')"/>
                <field name="create_date" readonly="1"/>
                <field name="write_date" readonly="1"/>
            </xpath>
            <xpath expr="//button[@name='action_view_stock_picking']" position="attributes">
                <attribute name="string">Phiếu nhập kho</attribute>
            </xpath>
            <xpath expr="//button[@name='action_view_stock_picking']/field[@name='move_count']" position="attributes">
                <attribute name="string">Phiếu nhập kho</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='product_id']" position="attributes">
                <attribute name="width">250</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='estimated_cost']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <!-- Ẩn cột mô tả và ngày yêu cầu (vẫn có thể hiện lại qua optional) -->
            <xpath expr="//field[@name='line_ids']/list/field[@name='name']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='date_required']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <!-- Đổi tên cột số lượng và RFQ/PO -->
            <xpath expr="//field[@name='line_ids']/list/field[@name='product_qty']" position="attributes">
                <attribute name="string">Số lượng yêu cầu</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='purchased_qty']" position="attributes">
                <attribute name="string">Số lượng đã lên RFQ/PO</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='estimated_cost']" position="after">
                <field name="history_po_line_id" optional="hide"/>
                <field name="sale_proposed_supplier_id" optional="show" width="200"/>
                <field name="misa_supplier_id" optional="hide"/>
                <field name="misa_stock_total" optional="hide"/>
                <field name="misa_stock_selected" optional="hide"/>
                <field name="misa_stock_undelivered" optional="hide"/>
                <field name="misa_price_before_tax" optional="hide"/>
                <field name="misa_price_before_tax_total" optional="show" sum="Tổng tiền trước thuế"/>
                <field name="misa_discount_rate" optional="show"/>
                <field name="misa_discount_amount_total" optional="show" sum="Tổng chiết khấu"/>
                <field name="misa_discount_amount" optional="hide"/>
                <field name="misa_tax_rate" optional="show"/>
                <field name="misa_tax_amount_total" optional="show" sum="Tổng tiền thuế"/>
                <field name="misa_tax_amount" optional="hide"/>
                <field name="misa_price_after_tax_total" optional="show" sum="Tổng sau thuế"/>
                <field name="misa_price_after_tax" optional="hide"/>
                <field name="misa_amount" optional="show" sum="Thành tiền"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list" position="inside">
                <button name="action_view_price_history" type="object"
                        string="Lịch sử giá"
                        icon="fa-history"
                        class="btn-secondary"
                        invisible="not product_id"/>
            </xpath>
        </field>
    </record>

    <!-- Kế thừa list view để thêm cột tiến độ mua hàng -->
    <record id="view_purchase_request_tree_inherit_misa_sync" model="ir.ui.view">
        <field name="name">purchase.request.list.inherit.misa.sync</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="progress_badge" string="Tiến độ mua" optional="show"
                       widget="badge"
                       decoration-success="progress_status == 'done'"
                       decoration-info="progress_status == 'in_progress'"
                       decoration-warning="progress_status == 'partial'"
                       decoration-muted="progress_status == 'not_started'"/>
                <field name="progress_status" column_invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- Thêm field history_po_line_id vào form view của PR line -->
    <record id="view_purchase_request_line_form_inherit_misa" model="ir.ui.view">
        <field name="name">purchase.request.line.form.inherit.misa</field>
        <field name="model">purchase.request.line</field>
        <field name="inherit_id" ref="purchase_request.purchase_request_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='estimated_cost']" position="after">
                <field name="history_po_line_id" readonly="is_editable == False"/>
            </xpath>
        </field>
    </record>

    <!-- Thêm field history_po_line_id vào detail view của PR line và cải thiện giao diện -->
    <record id="view_purchase_request_line_details_inherit_misa" model="ir.ui.view">
        <field name="name">purchase.request.line.details.inherit.misa</field>
        <field name="model">purchase.request.line</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_line_details"/>
        <field name="arch" type="xml">
            <!-- Redesign: Sử dụng oe_title cho Sản phẩm & Mô tả, chia 2 cột cho thông tin chung -->
            <xpath expr="//group[@name='main']" position="replace">
                <div class="oe_title" style="margin-bottom: 20px;">
                    <label for="product_id" class="oe_edit_only" string="Sản phẩm"/>
                    <h1>
                        <field name="product_id" readonly="is_editable == False" options="{'no_create': True}"/>
                    </h1>
                    <label for="name" class="oe_edit_only" string="Mô tả"/>
                    <h3>
                        <field name="name" readonly="is_editable == False"/>
                    </h3>
                </div>
                <group name="main">
                    <group name="left_col">
                        <label for="product_qty" />
                        <div class="o_row">
                            <field name="product_qty" class="oe_inline" readonly="is_editable == False" />
                            <field name="product_uom_id" groups="uom.group_uom" class="oe_inline" readonly="is_editable == False" />
                        </div>
                        <field name="date_required" readonly="is_editable == False" />
                        <field name="analytic_distribution" widget="analytic_distribution" groups="analytic.group_analytic_accounting" options="{'product_field': 'product_id', 'business_domain': 'purchase_order'}" readonly="is_editable == False" />
                    </group>
                    <group name="right_col">
                        <field name="estimated_cost" widget="monetary" readonly="is_editable == False" />
                        <field name="history_po_line_id" readonly="is_editable == False" options="{'no_create': True}"/>
                        <field name="cancelled" widget="boolean" string="Đã hủy?"/>
                        
                        <!-- Hidden fields required by original logic -->
                        <field name="is_editable" invisible="1" />
                        <field name="currency_id" invisible="1" />
                        <field name="product_uom_category_id" invisible="1" />
                    </group>
                </group>
            </xpath>
            
            <!-- Di chuyển Specifications vào Notebook cho gọn gàng -->
            <xpath expr="//group[@name='specifications']" position="replace"/>
            
            <!-- Thêm tab Dữ liệu MISA và Specifications vào Notebook hiện có -->
            <xpath expr="//notebook" position="inside">
                <page string="Dữ liệu từ MISA CRM" name="misa_data">
                    <group>
                        <group string="Tài chính &amp; Thuế">
                            <field name="misa_price_before_tax" readonly="is_editable == False" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="misa_price_before_tax_total" readonly="is_editable == False" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="misa_discount_rate" readonly="is_editable == False"/>
                            <field name="misa_discount_amount_total" readonly="is_editable == False" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="misa_discount_amount" readonly="is_editable == False" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="misa_tax_rate" readonly="is_editable == False"/>
                            <field name="misa_tax_amount_total" readonly="is_editable == False" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="misa_tax_amount" readonly="is_editable == False" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="misa_price_after_tax_total" readonly="is_editable == False" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="misa_price_after_tax" readonly="is_editable == False" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="misa_amount" readonly="is_editable == False" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>
                        <group string="Nhà cung cấp &amp; Tồn kho">
                            <field name="sale_proposed_supplier_id" readonly="is_editable == False" options="{'no_create': True}"/>
                            <field name="misa_supplier_id" readonly="is_editable == False" options="{'no_create': True}"/>
                            <field name="misa_stock_total" readonly="is_editable == False"/>
                            <field name="misa_stock_selected" readonly="is_editable == False"/>
                            <field name="misa_stock_undelivered" readonly="is_editable == False"/>
                        </group>
                    </group>
                </page>
                <page string="Thông số kỹ thuật" name="specifications_page">
                    <field name="specifications" nolabel="1" readonly="is_editable == False" />
                </page>
            </xpath>
        </field>
    </record>
</odoo>
