<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_inherit_misa_pr_sync" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.misa.pr.sync</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="priority" eval="110"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('parent_id', '=', False), ('active', '=', True), '|', '|', ('hlv_business_role', '=', 'supplier'), ('supplier_rank', '&gt;', 0), ('misa_account_object_id', '!=', False)]</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="purchase_request_id" string="YCMH gốc"
                       options="{'no_create': True}"
                       readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_tree_inherit_misa_pr_sync" model="ir.ui.view">
        <field name="name">purchase.order.tree.inherit.misa.pr.sync</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="purchase_request_id" string="YCMH gốc" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
