<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root Menu -->
    <menuitem id="menu_milwaukee_root"
              name="Milwaukee"
              sequence="55"/>

    <!-- Native Actions -->
    <record id="action_milwaukee_native_products" model="ir.actions.act_window">
        <field name="name">Sản phẩm (Master)</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('milwaukee_id', '!=', False)]</field>
    </record>

    <record id="action_milwaukee_native_banners" model="ir.actions.act_window">
        <field name="name">Website Banners</field>
        <field name="res_model">milwaukee.banner</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_milwaukee_native_blog_posts" model="ir.actions.act_window">
        <field name="name">Website Articles</field>
        <field name="res_model">milwaukee.blog.post</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_milwaukee_blog_post_list"/>
    </record>

    <!-- Original Iframe Actions (keeping some for Dashboard/Live view) -->
    <record id="action_milwaukee_store_frontend" model="ir.actions.client">
        <field name="name">Trang chủ Store (Live)</field>
        <field name="tag">milwaukee_iframe_action</field>
        <field name="context">{'iframe_path': '/?embedded=1'}</field>
    </record>

    <record id="action_milwaukee_admin_dashboard" model="ir.actions.client">
        <field name="name">Admin Dashboard (Live)</field>
        <field name="tag">milwaukee_iframe_action</field>
        <field name="context">{'iframe_path': '/admin?embedded=1'}</field>
    </record>

    <!-- Sub Menus -->
    <menuitem id="menu_milwaukee_cms" name="Website Content" parent="menu_milwaukee_root" sequence="10"/>

    <menuitem id="menu_milwaukee_native_products"
              name="Sản phẩm"
              parent="menu_milwaukee_cms"
              action="action_milwaukee_native_products"
              sequence="10"/>

    <menuitem id="menu_milwaukee_native_banners"
              name="Banners"
              parent="menu_milwaukee_cms"
              action="action_milwaukee_native_banners"
              sequence="20"/>

    <menuitem id="menu_milwaukee_native_blog_posts"
              name="Bài viết"
              parent="menu_milwaukee_cms"
              action="action_milwaukee_native_blog_posts"
              sequence="30"/>

    <menuitem id="menu_milwaukee_live" name="Live Preview" parent="menu_milwaukee_root" sequence="20"/>

    <menuitem id="menu_milwaukee_store"
              name="Trang chủ Milwaukee"
              parent="menu_milwaukee_live"
              action="action_milwaukee_store_frontend"
              sequence="10"/>

    <menuitem id="menu_milwaukee_admin"
              name="Quản trị Hệ thống"
              parent="menu_milwaukee_live"
              action="action_milwaukee_admin_dashboard"
              sequence="20"/>

    <menuitem id="menu_milwaukee_settings_root"
              name="Cấu hình"
              parent="menu_milwaukee_root"
              sequence="99"/>

    <menuitem id="menu_milwaukee_settings"
              name="Thiết lập API"
              parent="menu_milwaukee_settings_root"
              action="action_milwaukee_embedded_config"
              sequence="10"/>
</odoo>
