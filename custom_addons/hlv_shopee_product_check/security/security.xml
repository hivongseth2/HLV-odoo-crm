<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Danh mục riêng, không nhét vào base.module_category_sales_sales: danh mục đó là ô chọn cấp bậc
         Bán hàng (Người dùng / Quản lý) — thêm nhóm lẻ vào là ô chọn vỡ thành các ô tick. -->
    <record id="module_category_shopee_product_check" model="ir.module.category">
        <field name="name">Kiểm map nhầm Shopee</field>
        <field name="sequence">60</field>
    </record>

    <!-- Kiểm (đọc Shopee, AI so thành phần) ai có quyền Quản lý bán hàng cũng chạy được. Ba việc ảnh hưởng
         thật cần thêm nhóm này: "Áp dụng" (đổi sản phẩm Odoo của liên kết shopee.item — đổi hàng kho xuất cho
         đơn Shopee và tồn đẩy lên listing), "Xoá liên kết cũ", và sửa prompt AI (prompt sai là mọi lần kiểm
         sau kết luận sai). Không ai có sẵn; người trong nhóm cũng là người nhận báo cáo tự kiểm định kỳ. -->
    <record id="group_shopee_link_editor" model="res.groups">
        <field name="name">Quản lý kiểm map nhầm Shopee</field>
        <field name="category_id" ref="module_category_shopee_product_check"/>
        <field name="comment">Được bấm "Áp dụng" (đổi sản phẩm Odoo của liên kết Sản phẩm Shopee), "Xoá liên kết cũ" và sửa prompt AI trong Kiểm map nhầm; nhận báo cáo tự kiểm định kỳ. Cần thêm quyền Quản lý bán hàng.</field>
    </record>
</odoo>
