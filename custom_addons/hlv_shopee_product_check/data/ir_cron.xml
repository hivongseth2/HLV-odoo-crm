<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Bấm "Bắt đầu kiểm" là gọi cron này ngay (_trigger); lịch 5 phút chỉ để chạy tiếp lần kiểm bị bỏ dở
         (worker khởi động lại, Shopee bắt chờ). Không có lần kiểm nào đang chạy thì chỉ là một câu search. -->
    <record id="ir_cron_shopee_product_check" model="ir.cron">
        <field name="name">Shopee: kiểm map nhầm sản phẩm Shopee ↔ Odoo</field>
        <field name="model_id" ref="model_hlv_shopee_product_check"/>
        <field name="state">code</field>
        <field name="code">model._cron_process()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
