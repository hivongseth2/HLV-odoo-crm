<odoo>
  <record id="sale_order_list_convert_all_action_btns" model="ir.ui.view">
    <field name="name">sale.order.list.convert.all.action.btns</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
    <field name="priority" eval="98"/>
    <field name="arch" type="xml">
      <xpath expr="//list//button[@type='action']" position="attributes">
        <attribute name="type">object</attribute>
        <attribute name="name">action_open_order_in_panel</attribute>
      </xpath>
    </field>
  </record>

  <record id="view_sale_order_list_quick_preview_bottom" model="ir.ui.view">
    <field name="name">sale.order.list.quick.preview.bottom</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
    <field name="priority" eval="99"/>
    <field name="arch" type="xml">
      <xpath expr="//list/field[last()]" position="after">
        <button name="action_open_order_in_panel"
                type="object"
                string="Xem nhanh (HLV)"
                class="btn-link hlv-quick-btn"/>
      </xpath>
    </field>
  </record>
</odoo>
