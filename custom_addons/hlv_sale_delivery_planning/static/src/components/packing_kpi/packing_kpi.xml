<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hlv_sale_delivery_planning.PackingKpiDashboard">
        <div class="o_action o_view_controller bg-light" style="height:100%; overflow:auto;">
            <div class="px-3 py-3">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                    <h4 class="m-0 me-auto fw-bold text-primary">
                        <i class="fa fa-bar-chart me-2"></i>KPI Đóng Hàng
                    </h4>
                    <button class="btn btn-sm btn-outline-secondary" t-on-click="() => this.setRange('today')">Hôm nay</button>
                    <button class="btn btn-sm btn-outline-secondary" t-on-click="() => this.setRange('week')">Tuần này</button>
                    <button class="btn btn-sm btn-outline-secondary" t-on-click="() => this.setRange('month')">Tháng này</button>
                </div>

                <div class="bg-white border shadow-sm p-2 mb-3 d-flex flex-wrap align-items-end gap-2">
                    <div>
                        <label class="form-label small text-muted mb-1">Từ ngày</label>
                        <input type="date" class="form-control form-control-sm" t-att-value="state.dateFrom" t-on-change="(ev) => { state.dateFrom = ev.target.value; }"/>
                    </div>
                    <div>
                        <label class="form-label small text-muted mb-1">Đến ngày</label>
                        <input type="date" class="form-control form-control-sm" t-att-value="state.dateTo" t-on-change="(ev) => { state.dateTo = ev.target.value; }"/>
                    </div>
                    <div>
                        <label class="form-label small text-muted mb-1">Người đóng</label>
                        <select class="form-select form-select-sm" t-att-value="state.packerUserId" t-on-change="(ev) => { state.packerUserId = ev.target.value; }">
                            <option value="all">Tất cả packer</option>
                            <t t-foreach="state.packers" t-as="packer" t-key="packer.id">
                                <option t-att-value="packer.id"><t t-esc="packer.packer_name"/></option>
                            </t>
                        </select>
                    </div>
                    <button class="btn btn-sm btn-primary ms-auto" t-on-click="fetchData" t-att-disabled="state.loading">
                        <i t-attf-class="fa me-1 #{state.loading ? 'fa-spinner fa-spin' : 'fa-search'}"></i>Tìm kiếm
                    </button>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-md-3"><div class="bg-white border shadow-sm p-3 text-center"><div class="small text-muted fw-bold">Tổng phiếu assign</div><div class="fs-2 fw-bold text-primary"><t t-esc="state.summary.assigned_count || 0"/></div></div></div>
                    <div class="col-md-3"><div class="bg-white border shadow-sm p-3 text-center"><div class="small text-muted fw-bold">Đang đóng</div><div class="fs-2 fw-bold text-warning"><t t-esc="state.summary.in_progress_count || 0"/></div></div></div>
                    <div class="col-md-3"><div class="bg-white border shadow-sm p-3 text-center"><div class="small text-muted fw-bold">Đã hoàn thành</div><div class="fs-2 fw-bold text-success"><t t-esc="state.summary.done_count || 0"/></div></div></div>
                    <div class="col-md-3"><div class="bg-white border shadow-sm p-3 text-center"><div class="small text-muted fw-bold">TB thời lượng</div><div class="fs-2 fw-bold text-info"><t t-esc="this.formatDuration(state.summary.avg_actual_seconds || state.summary.avg_print_to_done_seconds)"/></div></div></div>
                </div>

                <div class="bg-white border shadow-sm">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Người đóng / Phiếu</th>
                                <th>Đơn hàng</th>
                                <th>Phiếu PACK</th>
                                <th>Trạng thái</th>
                                <th>TG in</th>
                                <th>TG đóng</th>
                                <th>In → Done</th>
                                <th>Thực tế</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="state.loading">
                                <tr><td colspan="8" class="text-center text-muted py-4"><i class="fa fa-spinner fa-spin me-1"></i>Đang tải...</td></tr>
                            </t>
                            <t t-elif="!state.groups.length">
                                <tr><td colspan="8" class="text-center text-muted py-4">Không có dữ liệu</td></tr>
                            </t>
                            <t t-else="">
                                <t t-foreach="state.groups" t-as="group" t-key="group.packer_user_id">
                                    <tr class="table-primary">
                                        <td colspan="8" class="fw-bold">
                                            <i class="fa fa-user me-1"></i><t t-esc="group.packer_name"/>
                                            <span class="badge bg-secondary ms-2">Tổng: <t t-esc="group.assigned_count"/></span>
                                            <span class="badge bg-success ms-1">Xong: <t t-esc="group.done_count"/></span>
                                            <span class="badge bg-warning text-dark ms-1">Đang: <t t-esc="group.in_progress_count"/></span>
                                        </td>
                                    </tr>
                                    <t t-foreach="group.rows" t-as="row" t-key="row.pick_id">
                                        <tr>
                                            <td><i class="fa fa-file-text-o me-1 text-muted"></i><t t-esc="row.pick_name"/></td>
                                            <td><t t-esc="row.sale_order"/></td>
                                            <td><t t-esc="row.pack_name || '-'"/></td>
                                            <td><span class="badge" t-att-class="this.stateClass(row.state)"><t t-esc="this.stateLabel(row.state)"/></span></td>
                                            <td><t t-esc="row.print_start_at || '-'"/></td>
                                            <td><t t-esc="row.pack_start_at || '-'"/></td>
                                            <td><t t-esc="this.formatDuration(row.print_to_done_seconds)"/></td>
                                            <td><t t-esc="this.formatDuration(row.actual_seconds)"/></td>
                                        </tr>
                                    </t>
                                </t>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </t>
</templates>
