<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hlv_sale_delivery_planning.Dashboard">
        <div class="o_action_manager">
            <div class="h-100 overflow-auto bg-view p-4 rounded" style="background-color: #f8f9fa;">
                <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                    <h2 class="text-primary m-0 fw-bold"><i class="fa fa-truck me-2"></i> BẢNG ĐIỀU PHỐI GIAO HÀNG</h2>
                    <button class="btn btn-primary shadow-sm" t-on-click="fetchData" t-att-disabled="state.isLoading">
                        <i class="fa fa-refresh me-1" t-att-class="{'fa-spin': state.isLoading}"></i> Làm mới
                    </button>
                </div>

                <div t-if="state.isLoading" class="text-center p-5 mt-5">
                    <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <div class="mt-3 text-muted">Đang tải dữ liệu, vui lòng đợi...</div>
                </div>

                <div t-else="">
                    <!-- Thanh Công Cụ (Kho, Tìm kiếm, Lọc trạng thái) -->
                    <div class="row g-3 mb-4 bg-white p-3 rounded shadow-sm border">
                        <!-- Ô tìm kiếm -->
                        <div class="col-md-4">
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fa fa-search text-muted"></i></span>
                                <input type="text" class="form-control" placeholder="Tìm tên khách hàng, số HĐ..." 
                                       t-model="state.searchQuery" t-on-keyup="onFilterChange" />
                            </div>
                        </div>
                        
                        <!-- Lọc theo kho -->
                        <div class="col-md-4">
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fa fa-building text-muted"></i> Kho</span>
                                <select class="form-select" t-model="state.filterWarehouseId" t-on-change="onFilterChange">
                                    <option value="all">Tất cả kho</option>
                                    <t t-foreach="state.warehouses" t-as="wh" t-key="wh.id">
                                        <option t-att-value="wh.id"><t t-esc="wh.name"/></option>
                                    </t>
                                </select>
                            </div>
                        </div>
                        
                        <!-- Lọc theo trạng thái Đủ/Thiếu hàng -->
                        <div class="col-md-4">
                            <div class="btn-group w-100" role="group">
                                <input type="radio" class="btn-check" name="btnradio_status" id="btnradio1" autocomplete="off" value="all" t-model="state.filterStatus" t-on-change="onFilterChange"/>
                                <label class="btn btn-outline-primary" for="btnradio1">Tất cả</label>

                                <input type="radio" class="btn-check" name="btnradio_status" id="btnradio2" autocomplete="off" value="pending" t-model="state.filterStatus" t-on-change="onFilterChange"/>
                                <label class="btn btn-outline-warning" for="btnradio2"><i class="fa fa-clock-o"></i> Còn thiếu</label>

                                <input type="radio" class="btn-check" name="btnradio_status" id="btnradio3" autocomplete="off" value="ready" t-model="state.filterStatus" t-on-change="onFilterChange"/>
                                <label class="btn btn-outline-success" for="btnradio3"><i class="fa fa-check"></i> Đã đủ hàng</label>
                            </div>
                        </div>
                    </div>

                    <div t-if="!this.filteredOrders.length" class="alert alert-info shadow-sm d-flex align-items-center p-4" role="alert">
                        <i class="fa fa-info-circle fa-2x me-3"></i> 
                        <div>
                            <h5 class="mb-1">Không có dữ liệu!</h5>
                            <div class="mb-0">Không tìm thấy đơn hàng nào phù hợp với bộ lọc hiện tại.</div>
                        </div>
                    </div>

                    <!-- Danh sách SO -->
                    <div t-else="" class="row g-4 mt-2">
                        <t t-foreach="this.paginatedOrders" t-as="so" t-key="so.id">
                        <div class="col-12 col-xl-4 col-lg-6">
                            <div class="card h-100 shadow-sm border-0" style="border-radius: 12px; overflow: hidden; transition: transform 0.2s; cursor: default;">
                                <div class="card-header bg-white d-flex justify-content-between align-items-center py-3 border-bottom-0" style="border-top: 4px solid #00a09d;">
                                    <div>
                                        <h5 class="card-title mb-1 text-primary cursor-pointer o_form_uri" t-on-click="() => this.openSaleOrder(so.id)">
                                            <i class="fa fa-shopping-cart text-muted me-1"></i> <t t-esc="so.name"/>
                                        </h5>
                                        <div class="text-muted small fw-bold">
                                            <i class="fa fa-user text-info me-1"></i> <t t-esc="so.partner_id ? so.partner_id[1] : 'Unknown'"/>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <span class="badge rounded-pill mb-1 shadow-sm px-2 py-1" t-att-class="this.getSOStatusBadgeClass(so.delivery_status)">
                                            <t t-esc="(so.delivery_status || so.state).toUpperCase()"/>
                                        </span>
                                        <div class="small fw-bold text-nowrap mt-1" t-if="so.commitment_date">
                                            <i class="fa fa-calendar-check-o text-danger me-1"></i>
                                            Giao: <t t-esc="so.commitment_date.substring(0, 10)"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-body bg-light pt-2 pb-0">
                                    <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                                        <h6 class="text-uppercase text-secondary small fw-bold mb-0"><i class="fa fa-list me-1"></i> Đơn Mua Liên Quan</h6>
                                    </div>
                                    
                                    <div t-if="!so.pos.length" class="alert alert-warning py-2 small mb-3 border-0">
                                        <i class="fa fa-exclamation-triangle me-1"></i> Không tìm thấy Đơn Mua (PMH) nào tên khớp với <strong t-esc="so.name"/>.
                                    </div>
                                    <div t-else="" class="list-group mb-3 gap-2 border-0">
                                        <t t-foreach="so.pos" t-as="po" t-key="po.id">
                                            <button class="list-group-item list-group-item-action d-flex justify-content-between border rounded shadow-sm p-2 bg-white" 
                                                    t-on-click="() => this.openPurchaseOrder(po.id)">
                                                <div class="d-flex flex-column align-items-start">
                                                    <span class="fw-bold text-dark"><i class="fa fa-file-text-o text-muted me-1"></i> <t t-esc="po.name"/></span>
                                                    <div class="small mt-1" t-if="po.date_planned" t-att-class="this.getDatesComparisonClass(so.commitment_date, po.date_planned)">
                                                        <i class="fa fa-clock-o me-1"></i> Về cTY: <t t-esc="po.date_planned.substring(0, 10)"/>
                                                        <i t-if="so.commitment_date and po.date_planned > so.commitment_date" class="fa fa-warning ms-1 text-danger" title="Hàng về trễ so với ngày dự giao SO!"></i>
                                                    </div>
                                                </div>
                                                <div class="d-flex align-items-center">
                                                    <span class="badge" t-att-class="this.getPOStatusBadgeClass(po.state, po.receipt_status)">
                                                        <t t-esc="(po.receipt_status || po.state).toUpperCase()"/>
                                                    </span>
                                                </div>
                                            </button>
                                        </t>
                                    </div>
                                    
                                    <h6 class="text-uppercase text-secondary small fw-bold mb-2 mt-2 px-1"><i class="fa fa-cubes me-1"></i> Sản Phẩm Đang Chờ</h6>
                                    <div class="table-responsive bg-white rounded shadow-sm border mb-3">
                                        <table class="table table-sm table-borderless table-hover mb-0 small">
                                            <thead class="table-light border-bottom">
                                                <tr>
                                                    <th class="ps-3 text-muted">Sản phẩm</th>
                                                    <th class="text-end pe-3 text-muted" width="60">SL</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="so.lines" t-as="line" t-key="line.id">
                                                    <tr t-if="line.product_uom_qty > line.qty_delivered">
                                                        <td class="ps-3 text-truncate" style="max-width: 200px;" t-att-title="line.product_id ? line.product_id[1] : 'Unknown'">
                                                            <t t-esc="line.product_id ? line.product_id[1] : 'Unknown'"/>
                                                        </td>
                                                        <td class="text-end pe-3 fw-bold text-danger">
                                                            <t t-esc="this.formatQty(line.product_uom_qty - line.qty_delivered)"/>
                                                        </td>
                                                    </tr>
                                                </t>
                                                <tr t-if="so.lines.filter(l => l.product_uom_qty > l.qty_delivered).length === 0">
                                                    <td colspan="2" class="text-center text-success py-2"><i class="fa fa-check me-1"></i> Đã đủ hàng</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>

                                </div>
                                <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center p-3">
                                    <div class="text-muted small"><i class="fa fa-money me-1"></i> Tổng giá trị đơn:</div>
                                    <div class="fw-bold text-primary fs-5">
                                        <t t-esc="this.formatCurrency(so.amount_total)"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>

                <!-- Phân Trang -->
                <div t-if="this.totalPages > 1" class="d-flex justify-content-between align-items-center mt-5 mb-4 bg-white p-3 rounded shadow-sm border">
                    <div class="text-muted small">
                        Hiển thị <span class="fw-bold"><t t-esc="(state.currentPage - 1) * state.itemsPerPage + 1"/></span> - 
                        <span class="fw-bold"><t t-esc="Math.min(state.currentPage * state.itemsPerPage, this.filteredOrders.length)"/></span> 
                        trong số <span class="fw-bold text-dark"><t t-esc="this.filteredOrders.length"/></span> đơn hàng
                    </div>
                    <nav aria-label="Page navigation">
                        <ul class="pagination mb-0">
                            <li class="page-item" t-att-class="{'disabled': state.currentPage === 1}">
                                <a class="page-link cursor-pointer" t-on-click="prevPage" aria-label="Previous">
                                    <span aria-hidden="true"><i class="fa fa-chevron-left"></i> Trang trước</span>
                                </a>
                            </li>
                            <li class="page-item active"><a class="page-link" href="#"><t t-esc="state.currentPage"/> / <t t-esc="this.totalPages"/></a></li>
                            <li class="page-item" t-att-class="{'disabled': state.currentPage === this.totalPages}">
                                <a class="page-link cursor-pointer" t-on-click="nextPage" aria-label="Next">
                                    <span aria-hidden="true">Trang sau <i class="fa fa-chevron-right"></i></span>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>

                </div> <!-- End of t-else main block -->
            </div>
        </div>
    </t>
</templates>
