<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ================================================================
         Main Dashboard Template
         Sub-templates được load từ các file XML riêng biệt:
         - delivery_planner_kpi.xml      → KPIStockCards, KPIPackingCards
         - delivery_planner_filters.xml  → ActiveFiltersBar, FilterToolbar
         - delivery_planner_so_card.xml  → SOCard, PickingNodeReturn, PickingNodeOutbound
         - delivery_planner_drawer.xml   → Drawer
         - delivery_planner_modal.xml    → PackageModal
         ================================================================ -->
    <t t-name="hlv_sale_delivery_planning.Dashboard">
        <div class="o_action o_view_controller hlv_delivery_planner_dashboard"
             style="height: 100%; display: flex; flex-direction: column;">
            <div class="o_content bg-view bg-light" style="flex: 1; overflow-y: auto;">
                <!-- kanban/table mode: không padding ngang, fullscreen; card mode: container-fluid -->
                <div t-att-class="(state.viewMode === 'kanban' || state.viewMode === 'table') ? 'px-3 pt-4 pb-5' : 'container-fluid pt-4 pb-5'">

                    <!-- Header -->
                    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                        <h2 class="text-primary m-0 fw-bold">
                            <i class="fa fa-truck me-2" title="Delivery Planner Icon"></i>
                            BẢNG ĐIỀU PHỐI GIAO HÀNG
                        </h2>
                        <div class="d-flex align-items-center gap-2">
                            <!-- Toggle dạng xem: Kanban / Card / Bảng -->
                            <div class="btn-group btn-group-sm" role="group" aria-label="View mode">
                                <button class="btn"
                                        title="Dạng Kanban"
                                        t-att-class="state.viewMode === 'kanban' ? 'btn-primary' : 'btn-outline-secondary'"
                                        t-on-click="() => this.setViewMode('kanban')">
                                    <i class="fa fa-columns" title="Kanban"></i> Kanban
                                </button>
                                <button class="btn"
                                        title="Dạng Card (lưới 3 cột)"
                                        t-att-class="state.viewMode === 'list' ? 'btn-primary' : 'btn-outline-secondary'"
                                        t-on-click="() => this.setViewMode('list')">
                                    <i class="fa fa-th-large" title="Card"></i> Card
                                </button>
                                <button class="btn"
                                        title="Dạng Bảng (Excel)"
                                        t-att-class="state.viewMode === 'table' ? 'btn-primary' : 'btn-outline-secondary'"
                                        t-on-click="() => this.setViewMode('table')">
                                    <i class="fa fa-table" title="Bảng"></i> Bảng
                                </button>
                            </div>
                            <button class="btn btn-primary shadow-sm"
                                    t-on-click="fetchData"
                                    t-att-disabled="state.isLoading">
                                <i class="fa fa-refresh me-1"
                                   t-att-class="{'fa-spin': state.isLoading}"
                                   title="Làm mới"></i> Làm mới
                            </button>
                            <button class="btn btn-success shadow-sm"
                                    t-on-click="exportExcel"
                                    t-att-title="this.selectedCount > 0 ? 'Xuất Excel các đơn đã chọn' : 'Xuất Excel theo bộ lọc hiện tại'">
                                <i class="fa fa-file-excel-o me-1"></i> Xuất Excel 
                                <t t-if="this.selectedCount > 0">
                                    (<t t-esc="this.selectedCount"/>)
                                </t>
                            </button>
                            <button class="btn btn-outline-danger shadow-sm position-relative ms-2"
                                    t-on-click="() => { this.state.isMessageDrawerOpen = true; }">
                                <i class="fa fa-bell" ></i> Tin nhắn
                                <span t-if="this.unreadMessageCount > 0"
                                      class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                                      style="font-size: 0.7rem; padding: 0.35em 0.5em; color:white">
                                    <t t-esc="this.unreadMessageCount"/>
                                </span>
                            </button>
                        </div>
                    </div>

                    <!-- Loading Spinner (only on FIRST load with no data on screen) -->
                    <div t-if="state.isLoading and !state.saleOrders.length" class="text-center p-5 mt-5">
                        <div class="spinner-border text-primary" role="status"
                             style="width: 3rem; height: 3rem;">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <div class="mt-3 text-muted">Đang tải dữ liệu, vui lòng đợi...</div>
                    </div>

                    <div t-else="">
                        <!-- Thin top progress bar shown while refreshing
                             (filter change / reload) so users see existing
                             data without a full-screen overlay flash. -->
                        <div t-if="state.isLoading or state.isRefreshing"
                             class="hlv-refresh-progress"
                             title="Đang làm mới dữ liệu..."/>
                        <!-- KPI Tồn Kho -->
                        <t t-call="hlv_sale_delivery_planning.KPIStockCards"/>

                        <!-- KPI Đóng Gói -->
                        <t t-call="hlv_sale_delivery_planning.KPIPackingCards"/>

                        <!-- Packer Panel -->
                        <t t-call="hlv_sale_delivery_planning.PackerPanel"/>

                        <!-- Active Filters Bar -->
                        <t t-call="hlv_sale_delivery_planning.ActiveFiltersBar"/>

                        <!-- Thanh Công Cụ Lọc -->
                        <t t-call="hlv_sale_delivery_planning.FilterToolbar"/>

                        <!-- ============================================
                             KANBAN VIEW
                             ============================================ -->
                        <div t-if="state.viewMode === 'kanban'">
                            <t t-call="hlv_sale_delivery_planning.KanbanBoard"/>
                        </div>

                        <!-- ============================================
                             TABLE VIEW (Bảng / Excel-like)
                             ============================================ -->
                        <div t-elif="state.viewMode === 'table'">
                            <t t-call="hlv_sale_delivery_planning.TableBoard"/>
                        </div>

                        <!-- ============================================
                             CARD VIEW (3-col grid of SOCard)
                             ============================================ -->
                        <div t-else="">
                            <!-- Empty State -->
                            <div t-if="!state.saleOrders.length"
                                 class="alert alert-info shadow-sm d-flex align-items-center p-4" role="alert">
                                <i class="fa fa-info-circle fa-2x me-3" title="Thông tin"></i>
                                <div>
                                    <h5 class="mb-1">Không có dữ liệu!</h5>
                                    <div class="mb-0">Không tìm thấy đơn hàng nào phù hợp với bộ lọc hiện tại.</div>
                                </div>
                            </div>

                            <!-- Danh Sách SO Cards -->
                            <div t-else="" class="row g-4 mt-2">
                                <t t-foreach="this.paginatedOrders" t-as="so" t-key="so.id">
                                    <div class="col-12 col-xl-4 col-lg-6">
                                        <t t-call="hlv_sale_delivery_planning.SOCard"/>
                                    </div>
                                </t>
                            </div>

                            <!-- Phân Trang (Sticky) -->
                            <div t-if="this.totalPages > 1"
                                 class="position-sticky bottom-0 w-100 z-3 bg-light pt-2 pb-3 mb-0 border-top mt-4"
                                 style="margin-left: -12px; padding-left: 12px; margin-right: -12px; padding-right: 12px;">
                                <div class="d-flex justify-content-between align-items-center bg-white p-3 rounded shadow-lg border">
                                    <div class="text-muted small">
                                        Hiển thị
                                        <span class="fw-bold">
                                            <t t-esc="(state.currentPage - 1) * state.itemsPerPage + 1"/>
                                        </span> -
                                        <span class="fw-bold">
                                            <t t-esc="Math.min(state.currentPage * state.itemsPerPage, state.totalCount)"/>
                                        </span>
                                        trong số
                                        <span class="fw-bold text-dark"><t t-esc="state.totalCount"/></span> đơn hàng
                                    </div>
                                    <nav aria-label="Page navigation">
                                        <ul class="pagination mb-0">
                                            <li class="page-item"
                                                t-att-class="{'disabled': state.currentPage === 1}">
                                                <a class="page-link cursor-pointer" t-on-click="prevPage"
                                                   aria-label="Previous">
                                                    <span aria-hidden="true">
                                                        <i class="fa fa-chevron-left" title="Trước"></i> Trang trước
                                                    </span>
                                                </a>
                                            </li>
                                            <li class="page-item active">
                                                <a class="page-link" href="#">
                                                    <t t-esc="state.currentPage"/> / <t t-esc="this.totalPages"/>
                                                </a>
                                            </li>
                                            <li class="page-item"
                                                t-att-class="{'disabled': state.currentPage === this.totalPages}">
                                                <a class="page-link cursor-pointer" t-on-click="nextPage"
                                                   aria-label="Next">
                                                    <span aria-hidden="true">
                                                        Trang sau <i class="fa fa-chevron-right" title="Sau"></i>
                                                    </span>
                                                </a>
                                            </li>
                                        </ul>
                                    </nav>
                                </div>
                            </div>
                        </div> <!-- /LIST VIEW -->

                    </div> <!-- /t-else (not loading) -->
                </div>
            </div> <!-- /o_content -->

            <!-- Side Drawer -->
            <t t-call="hlv_sale_delivery_planning.Drawer"/>

            <!-- Package Modal -->
            <t t-call="hlv_sale_delivery_planning.PackageModal"/>

            <!-- Transfer Modal -->
            <t t-call="hlv_sale_delivery_planning.TransferModal"/>

            <!-- Relocation Modal -->
            <t t-call="hlv_sale_delivery_planning.RelocationModal"/>

            <!-- Packing Slip Wizard -->
            <t t-call="hlv_sale_delivery_planning.PackingWizard"/>

            <!-- Message Drawer (Left) -->
            <t t-call="hlv_sale_delivery_planning.MessageDrawer"/>

            <!-- Backdrop Drawer -->
            <div t-if="state.isDrawerOpen"
                 class="modal-backdrop fade show"
                 t-on-click="closeOverviewDrawer"
                 style="z-index: 1040;"></div>
                 
            <div t-if="state.isMessageDrawerOpen"
                 class="modal-backdrop fade show"
                 t-on-click="() => { this.state.isMessageDrawerOpen = false; }"
                 style="z-index: 1040;"></div>

        </div>
    </t>

</templates>
