<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ================================================================
         KPI Stock: Tổng Đơn / Sẵn Sàng / Hàng 1 Phần / Thiếu Hàng
         Sử dụng trong: hlv_sale_delivery_planning.Dashboard (t-call)
         ================================================================ -->
    <t t-name="hlv_sale_delivery_planning.KPIStockCards">
        <div class="row g-3 mb-4 hlv-kpi-row" t-att-class="state.statsLoading ? 'hlv-kpi-loading' : ''">
            <div class="col-md-3">
                <div class="card bg-primary text-white shadow-sm border-1 h-100"
                     style="cursor: pointer;"
                     t-on-click="() => this.setStockFilter('all')">
                    <div class="card-body d-flex align-items-center justify-content-between p-3"
                         title="Click để xem Tất cả (Bỏ lọc Kho)">
                        <div>
                            <h6 class="text-uppercase fw-bold mb-1 opacity-75 small">Đơn hàng</h6>
                            <h3 class="mb-0 fw-bold"><t t-esc="state.dashboardStats.total || 0"/></h3>
                        </div>
                        <i class="fa fa-shopping-cart fa-3x opacity-50" title="Đơn hàng"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-success text-white shadow-sm border-1 h-100"
                     style="cursor: pointer;"
                     t-on-click="() => this.setStockFilter('ready')">
                    <div class="card-body d-flex align-items-center justify-content-between p-3"
                         title="Click để xem Đủ hàng xuất">
                        <div>
                            <h6 class="text-uppercase fw-bold mb-1 opacity-75 small">Sẵn Sàng Xuất Đủ</h6>
                            <h3 class="mb-0 fw-bold"><t t-esc="state.dashboardStats.ready || 0"/></h3>
                        </div>
                        <i class="fa fa-check-circle fa-3x opacity-50" title="Sẵn sàng"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-warning text-dark shadow-sm border-1 h-100"
                     style="cursor: pointer;"
                     t-on-click="() => this.setStockFilter('partial_ready')">
                    <div class="card-body d-flex align-items-center justify-content-between p-3"
                         title="Click để xem Có hàng 1 phần">
                        <div>
                            <h6 class="text-uppercase fw-bold mb-1 opacity-75 small">Có Hàng 1 Phần</h6>
                            <h3 class="mb-0 fw-bold"><t t-esc="state.dashboardStats.partial || 0"/></h3>
                        </div>
                        <i class="fa fa-exclamation-circle fa-3x opacity-50" title="Có hàng 1 phần"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-danger text-white shadow-sm border-1 h-100"
                     style="cursor: pointer;"
                     t-on-click="() => this.setStockFilter('out_of_stock')">
                    <div class="card-body d-flex align-items-center justify-content-between p-3"
                         title="Click để xem Thiếu hàng">
                        <div>
                            <h6 class="text-uppercase fw-bold mb-1 opacity-75 small">Chưa Có Hàng / Thiếu</h6>
                            <h3 class="mb-0 fw-bold"><t t-esc="state.dashboardStats.out_of_stock || 0"/></h3>
                        </div>
                        <i class="fa fa-times-circle fa-3x opacity-50" title="Thiếu hàng"></i>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <!-- ================================================================
         KPI Đóng Gói: Không Có Hàng Đóng / Có Hàng Chưa Đóng / Đã Đóng Gói Đủ
         ================================================================ -->
    <t t-name="hlv_sale_delivery_planning.KPIPackingCards">
        <div class="row g-3 mb-4 hlv-kpi-row" t-att-class="state.statsLoading ? 'hlv-kpi-loading' : ''">
            <div class="col-md-4">
                <div class="card bg-white text-dark shadow-sm border-1 h-100 kpi-card"
                     style="cursor: pointer;"
                     t-on-click="() => this.setPackingFilter('waiting_stock')"
                     t-att-class="state.filterPackingStatus === 'waiting_stock' ? 'ring-2 ring-danger' : ''">
                    <div class="card-body d-flex align-items-center p-3" title="Chưa đủ hàng để đóng kiện">
                        <div class="rounded-circle bg-danger bg-opacity-10 p-3 me-3 text-danger">
                            <i class="fa fa-clock-o fa-fw fa-2x" title="Chờ cấp hàng"></i>
                        </div>
                        <div>
                            <h6 class="text-uppercase fw-bold text-muted mb-1 small opacity-75">Không Có Hàng Đóng</h6>
                            <h3 class="mb-0 fw-bold"><t t-esc="state.dashboardStats.packing_waiting || 0"/></h3>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card bg-white text-dark shadow-sm border-1 h-100 kpi-card"
                     style="cursor: pointer;"
                     t-on-click="() => this.setPackingFilter('unpacked')"
                     t-att-class="state.filterPackingStatus === 'unpacked' ? 'ring-2 ring-warning' : ''">
                    <div class="card-body d-flex align-items-center p-3" title="Có Hàng Nằm Chờ Đóng Gói">
                        <div class="rounded-circle bg-warning bg-opacity-10 p-3 me-3 text-warning">
                            <i class="fa fa-cubes fa-fw fa-2x" title="Hàng chờ đóng"></i>
                        </div>
                        <div>
                            <h6 class="text-uppercase fw-bold text-muted mb-1 small opacity-75">Có Hàng Chưa Đóng Gói</h6>
                            <h3 class="mb-0 fw-bold"><t t-esc="state.dashboardStats.packing_unpacked || 0"/></h3>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card bg-white text-dark shadow-sm border-1 h-100 kpi-card"
                     style="cursor: pointer;"
                     t-on-click="() => this.setPackingFilter('fully_packed')"
                     t-att-class="state.filterPackingStatus === 'fully_packed' ? 'ring-2 ring-success' : ''">
                    <div class="card-body d-flex align-items-center p-3" title="Đã đóng gói đủ toàn bộ phần có thể đóng ngay">
                        <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3 text-success">
                            <i class="fa fa-check-square-o fa-fw fa-2x" title="Đã đóng đủ"></i>
                        </div>
                        <div>
                            <h6 class="text-uppercase fw-bold text-muted mb-1 small opacity-75">Đã Đóng Gói Đủ</h6>
                            <h3 class="mb-0 fw-bold"><t t-esc="state.dashboardStats.packing_fully || 0"/></h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <!-- ================================================================
         Packer Panel: Workload + trạng thái đóng hàng theo người
         ================================================================ -->
    <t t-name="hlv_sale_delivery_planning.PackerPanel">
        <!-- Toggle button cố định góc dưới phải -->
        <button class="btn btn-primary shadow d-flex align-items-center gap-2"
                t-on-click="togglePackerPanel"
                style="position:fixed; bottom:20px; right:20px; z-index:1050; border-radius:24px; padding:8px 16px;">
            <i class="fa fa-users"></i>
            <span class="fw-bold small">Packer</span>
            <span t-if="state.packerStats.length" class="badge bg-white text-primary ms-1" style="font-size:0.65rem;">
                <t t-esc="state.packerStats.length"/>
            </span>
            <i class="fa" t-att-class="state.packerPanelOpen ? 'fa-chevron-down' : 'fa-chevron-up'"></i>
        </button>

        <!-- Bottom panel slide-up -->
        <div t-if="state.packerPanelOpen"
             style="position:fixed; bottom:0; left:0; right:0; z-index:1049; background:#fff; border-top:2px solid #dee2e6; box-shadow:0 -4px 16px rgba(0,0,0,0.12); max-height:60vh; display:flex; flex-direction:column;">

            <!-- Panel header -->
            <div class="d-flex align-items-center gap-2 px-3 py-2 border-bottom bg-light flex-shrink-0">
                <i class="fa fa-users text-primary"></i>
                <span class="fw-bold text-uppercase small">Tiến Độ Đóng Hàng Hôm Nay</span>
                <button class="btn btn-sm btn-link p-0 ms-1 text-muted" title="Làm mới"
                        t-on-click="refreshPackerStats">
                    <i class="fa fa-refresh" t-att-class="state.packerStatsLoading ? 'fa-spin' : ''"></i>
                </button>
                <button class="btn btn-sm btn-link p-0 ms-auto text-muted" title="Đóng"
                        t-on-click="togglePackerPanel">
                    <i class="fa fa-times fa-lg"></i>
                </button>
            </div>

            <!-- Panel body (scrollable) -->
            <div class="flex-grow-1 overflow-auto p-3">
                <div t-if="state.packerStatsLoading" class="text-center text-muted py-3">
                    <i class="fa fa-spinner fa-spin me-1"></i> Đang tải...
                </div>
                <div t-elif="!state.packerStats.length" class="text-muted fst-italic">
                    Chưa có packer nào được assign hôm nay.
                </div>
                <div t-else="" class="d-flex gap-4 flex-wrap align-items-start">
                    <t t-foreach="state.packerStats" t-as="packer" t-key="packer.id">
                        <div style="min-width:360px; flex:1;">
                            <!-- Packer header (clickable collapse) -->
                            <div class="d-flex align-items-center gap-2 mb-2"
                                 style="cursor:pointer;"
                                 t-on-click="() => this.togglePackerCollapse(packer.id)">
                                <i t-att-class="'fa fa-fw ' + (state.packerCollapsed[packer.id] ? 'fa-chevron-right' : 'fa-chevron-down') + ' text-muted'"></i>
                                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold flex-shrink-0"
                                     style="width:28px;height:28px;font-size:0.75rem;">
                                    <t t-esc="packer.name.charAt(0).toUpperCase()"/>
                                </div>
                                <span class="fw-bold"><t t-esc="packer.name"/></span>
                                <span t-if="packer.packing.length" class="badge bg-warning text-dark">
                                    <i class="fa fa-spinner fa-spin me-1"></i>Đang: <t t-esc="packer.packing.length"/>
                                </span>
                                <span class="badge bg-success">
                                    <i class="fa fa-check me-1"></i>Xong: <t t-esc="packer.packed_today.length"/>
                                </span>
                                <span t-if="packer.avg_minutes !== null" class="text-muted small">
                                    <i class="fa fa-clock-o me-1"></i>TB: <t t-esc="packer.avg_minutes"/> phút
                                </span>
                                <span t-if="packer.num_so" class="badge bg-light text-dark border" title="Số đơn hàng">
                                    <i class="fa fa-file-text-o me-1"></i>SO: <t t-esc="packer.num_so"/>
                                </span>
                                <span t-if="packer.num_pick" class="badge bg-info text-dark" title="Phiếu PICK">
                                    PICK: <t t-esc="packer.num_pick"/>
                                </span>
                                <span t-if="packer.num_pack" class="badge bg-secondary" title="Phiếu PACK">
                                    PACK: <t t-esc="packer.num_pack"/>
                                </span>
                            </div>
                            <!-- Detail table (collapsible) -->
                            <table t-if="!state.packerCollapsed[packer.id]" class="table table-sm table-bordered mb-0" style="font-size:0.78rem;">
                                <thead class="table-light">
                                    <tr>
                                        <th>Phiếu</th>
                                        <th style="width:80px;">Người đóng</th>
                                        <th class="text-center" style="width:80px;">TG In</th>
                                        <th class="text-center" style="width:80px;">TG Xong</th>
                                        <th class="text-center" style="width:55px;">Thời lượng</th>
                                        <th style="width:90px;">Trạng thái</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="packer.packing" t-as="pk" t-key="pk.picking_id">
                                        <tr class="table-warning">
                                            <td class="fw-bold">
                                                <i class="fa fa-barcode me-1 text-muted"></i><t t-esc="pk.picking_name"/>
                                                <div t-if="pk.pack_name" class="text-muted small fw-normal">
                                                    <i class="fa fa-cube me-1"></i><t t-esc="pk.pack_name"/>
                                                </div>
                                                <div t-if="pk.sale_name" class="text-muted small fw-normal">
                                                    <i class="fa fa-file-text-o me-1"></i><t t-esc="pk.sale_name"/>
                                                </div>
                                            </td>
                                            <td class="text-muted small">
                                                <t t-esc="pk.packer_name"/>
                                                <div class="mt-1">
                                                    <button class="btn btn-outline-secondary"
                                                            style="font-size:0.65rem;padding:1px 6px;line-height:1.4;"
                                                            t-on-click="() => this.openDashboardPackerModal(pk)">
                                                        <i class="fa fa-pencil me-1"></i>Đổi
                                                    </button>
                                                </div>
                                            </td>
                                            <td class="text-center"><t t-esc="pk.print_time or '—'"/></td>
                                            <td class="text-center text-muted">—</td>
                                            <td class="text-center text-muted">—</td>
                                            <td><span class="badge bg-warning text-dark"><i class="fa fa-spinner fa-spin me-1"></i>Đang đóng</span></td>
                                        </tr>
                                    </t>
                                    <t t-foreach="packer.packed_today" t-as="pk" t-key="pk.picking_id">
                                        <tr>
                                            <td class="fw-bold">
                                                <i class="fa fa-barcode me-1 text-muted"></i><t t-esc="pk.picking_name"/>
                                                <div t-if="pk.pack_name" class="text-muted small fw-normal">
                                                    <i class="fa fa-cube me-1"></i><t t-esc="pk.pack_name"/>
                                                </div>
                                                <div t-if="pk.sale_name" class="text-muted small fw-normal">
                                                    <i class="fa fa-file-text-o me-1"></i><t t-esc="pk.sale_name"/>
                                                </div>
                                            </td>
                                            <td class="text-muted small">
                                                <t t-esc="pk.packer_name"/>
                                                <div class="mt-1">
                                                    <button class="btn btn-outline-secondary"
                                                            style="font-size:0.65rem;padding:1px 6px;line-height:1.4;"
                                                            t-on-click="() => this.openDashboardPackerModal(pk)">
                                                        <i class="fa fa-pencil me-1"></i>Đổi
                                                    </button>
                                                </div>
                                            </td>
                                            <td class="text-center text-muted"><t t-esc="pk.print_time or '—'"/></td>
                                            <td class="text-center text-success fw-bold"><t t-esc="pk.finish_time or '—'"/></td>
                                            <td class="text-center">
                                                <span t-if="pk.duration_min !== null" class="badge bg-light text-dark border">
                                                    <t t-esc="pk.duration_min"/> ph
                                                </span>
                                                <span t-else="">—</span>
                                            </td>
                                            <td><span class="badge bg-success"><i class="fa fa-check me-1"></i>Xong</span></td>
                                        </tr>
                                    </t>
                                    <tr t-if="!packer.packing.length and !packer.packed_today.length">
                                        <td colspan="6" class="text-center text-muted fst-italic">Chưa có phiếu nào hôm nay</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </t>
                </div>
            </div>
        </div>

        <!-- Packer change modal -->
        <div t-if="state.dashboardPackerModal.open"
             class="modal d-block"
             style="background:rgba(0,0,0,0.5);z-index:1060;"
             t-on-click.self="closeDashboardPackerModal">
            <div class="modal-dialog modal-sm modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header py-2 px-3">
                        <h6 class="modal-title fw-bold">
                            <i class="fa fa-user-circle me-2 text-primary"></i>Đổi Người Đóng Gói
                        </h6>
                        <button class="btn-close" t-on-click="closeDashboardPackerModal"></button>
                    </div>
                    <div class="modal-body px-3 py-3">
                        <div class="small text-muted mb-3">
                            Phiếu: <strong><t t-esc="state.dashboardPackerModal.pickingName"/></strong>
                        </div>
                        <select class="form-select form-select-sm"
                                t-on-change="onDashboardPackerChange">
                            <option value="">— Bỏ assign —</option>
                            <t t-foreach="state.allPackersList" t-as="p" t-key="p.id">
                                <option t-att-value="p.id">
                                    <t t-esc="p.name"/>
                                </option>
                            </t>
                        </select>
                    </div>
                    <div class="modal-footer py-2 px-3">
                        <button class="btn btn-sm btn-secondary" t-on-click="closeDashboardPackerModal">Hủy</button>
                        <button class="btn btn-sm btn-primary" t-on-click="confirmDashboardChangePacker">
                            <i class="fa fa-check me-1"></i>Xác nhận
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
