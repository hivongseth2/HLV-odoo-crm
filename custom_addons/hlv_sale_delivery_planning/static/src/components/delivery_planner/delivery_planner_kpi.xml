<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ================================================================
         KPI Stock: Tổng Đơn / Sẵn Sàng / Hàng 1 Phần / Thiếu Hàng
         Sử dụng trong: hlv_sale_delivery_planning.Dashboard (t-call)
         ================================================================ -->
    <t t-name="hlv_sale_delivery_planning.KPIStockCards">
        <div class="row g-3 mb-4 hlv-kpi-row" t-att-class="state.statsLoading ? 'hlv-kpi-loading' : ''">
            <div class="col-md-3">
                <div class="card bg-primary text-white shadow-sm border-1 h-100"
                     style="cursor: pointer;"
                     t-on-click="() => this.setStockFilter('all')">
                    <div class="card-body d-flex align-items-center justify-content-between p-3"
                         title="Click để xem Tất cả (Bỏ lọc Kho)">
                        <div>
                            <h6 class="text-uppercase fw-bold mb-1 opacity-75 small">Đơn hàng</h6>
                            <h3 class="mb-0 fw-bold"><t t-esc="state.dashboardStats.total || 0"/></h3>
                        </div>
                        <i class="fa fa-shopping-cart fa-3x opacity-50" title="Đơn hàng"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-success text-white shadow-sm border-1 h-100"
                     style="cursor: pointer;"
                     t-on-click="() => this.setStockFilter('ready')">
                    <div class="card-body d-flex align-items-center justify-content-between p-3"
                         title="Click để xem Đủ hàng xuất">
                        <div>
                            <h6 class="text-uppercase fw-bold mb-1 opacity-75 small">Sẵn Sàng Xuất Đủ</h6>
                            <h3 class="mb-0 fw-bold"><t t-esc="state.dashboardStats.ready || 0"/></h3>
                        </div>
                        <i class="fa fa-check-circle fa-3x opacity-50" title="Sẵn sàng"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-warning text-dark shadow-sm border-1 h-100"
                     style="cursor: pointer;"
                     t-on-click="() => this.setStockFilter('partial_ready')">
                    <div class="card-body d-flex align-items-center justify-content-between p-3"
                         title="Click để xem Có hàng 1 phần">
                        <div>
                            <h6 class="text-uppercase fw-bold mb-1 opacity-75 small">Có Hàng 1 Phần</h6>
                            <h3 class="mb-0 fw-bold"><t t-esc="state.dashboardStats.partial || 0"/></h3>
                        </div>
                        <i class="fa fa-exclamation-circle fa-3x opacity-50" title="Có hàng 1 phần"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-danger text-white shadow-sm border-1 h-100"
                     style="cursor: pointer;"
                     t-on-click="() => this.setStockFilter('out_of_stock')">
                    <div class="card-body d-flex align-items-center justify-content-between p-3"
                         title="Click để xem Thiếu hàng">
                        <div>
                            <h6 class="text-uppercase fw-bold mb-1 opacity-75 small">Chưa Có Hàng / Thiếu</h6>
                            <h3 class="mb-0 fw-bold"><t t-esc="state.dashboardStats.out_of_stock || 0"/></h3>
                        </div>
                        <i class="fa fa-times-circle fa-3x opacity-50" title="Thiếu hàng"></i>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <!-- ================================================================
         KPI Đóng Gói: Không Có Hàng Đóng / Có Hàng Chưa Đóng / Đã Đóng Gói Đủ
         ================================================================ -->
    <t t-name="hlv_sale_delivery_planning.KPIPackingCards">
        <div class="row g-3 mb-4 hlv-kpi-row" t-att-class="state.statsLoading ? 'hlv-kpi-loading' : ''">
            <div class="col-md-4">
                <div class="card bg-white text-dark shadow-sm border-1 h-100 kpi-card"
                     style="cursor: pointer;"
                     t-on-click="() => this.setPackingFilter('waiting_stock')"
                     t-att-class="state.filterPackingStatus === 'waiting_stock' ? 'ring-2 ring-danger' : ''">
                    <div class="card-body d-flex align-items-center p-3" title="Chưa đủ hàng để đóng kiện">
                        <div class="rounded-circle bg-danger bg-opacity-10 p-3 me-3 text-danger">
                            <i class="fa fa-clock-o fa-fw fa-2x" title="Chờ cấp hàng"></i>
                        </div>
                        <div>
                            <h6 class="text-uppercase fw-bold text-muted mb-1 small opacity-75">Không Có Hàng Đóng</h6>
                            <h3 class="mb-0 fw-bold"><t t-esc="state.dashboardStats.packing_waiting || 0"/></h3>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card bg-white text-dark shadow-sm border-1 h-100 kpi-card"
                     style="cursor: pointer;"
                     t-on-click="() => this.setPackingFilter('unpacked')"
                     t-att-class="state.filterPackingStatus === 'unpacked' ? 'ring-2 ring-warning' : ''">
                    <div class="card-body d-flex align-items-center p-3" title="Có Hàng Nằm Chờ Đóng Gói">
                        <div class="rounded-circle bg-warning bg-opacity-10 p-3 me-3 text-warning">
                            <i class="fa fa-cubes fa-fw fa-2x" title="Hàng chờ đóng"></i>
                        </div>
                        <div>
                            <h6 class="text-uppercase fw-bold text-muted mb-1 small opacity-75">Có Hàng Chưa Đóng Gói</h6>
                            <h3 class="mb-0 fw-bold"><t t-esc="state.dashboardStats.packing_unpacked || 0"/></h3>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card bg-white text-dark shadow-sm border-1 h-100 kpi-card"
                     style="cursor: pointer;"
                     t-on-click="() => this.setPackingFilter('fully_packed')"
                     t-att-class="state.filterPackingStatus === 'fully_packed' ? 'ring-2 ring-success' : ''">
                    <div class="card-body d-flex align-items-center p-3" title="Đã đóng gói đủ toàn bộ phần có thể đóng ngay">
                        <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3 text-success">
                            <i class="fa fa-check-square-o fa-fw fa-2x" title="Đã đóng đủ"></i>
                        </div>
                        <div>
                            <h6 class="text-uppercase fw-bold text-muted mb-1 small opacity-75">Đã Đóng Gói Đủ</h6>
                            <h3 class="mb-0 fw-bold"><t t-esc="state.dashboardStats.packing_fully || 0"/></h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <!-- ================================================================
         Packer Panel: Workload + trạng thái đóng hàng theo người
         ================================================================ -->
    <t t-name="hlv_sale_delivery_planning.PackerPanel">
        <div class="mb-3">
            <!-- Header toggle -->
            <div class="d-flex align-items-center gap-2 mb-2 px-1 cursor-pointer user-select-none"
                 t-on-click="() => { state.packerPanelOpen = !state.packerPanelOpen; if(state.packerPanelOpen) this.loadPackerStats(); }">
                <i class="fa fa-users text-primary"></i>
                <span class="fw-bold text-dark small text-uppercase">Packer Hôm Nay</span>
                <span t-if="state.packerStats.length"
                      class="badge bg-primary ms-1" style="font-size:0.65rem;">
                    <t t-esc="state.packerStats.length"/> người
                </span>
                <button class="btn btn-sm btn-link p-0 ms-1 text-muted" title="Làm mới"
                        t-on-click.stop="() => this.loadPackerStats()">
                    <i class="fa fa-refresh" t-att-class="state.packerStatsLoading ? 'fa-spin' : ''"></i>
                </button>
                <i class="fa ms-auto text-muted"
                   t-att-class="state.packerPanelOpen ? 'fa-chevron-up' : 'fa-chevron-down'"></i>
            </div>

            <!-- Panel body -->
            <div t-if="state.packerPanelOpen">
                <div t-if="state.packerStatsLoading" class="text-center text-muted py-2 small">
                    <i class="fa fa-spinner fa-spin me-1"></i> Đang tải...
                </div>
                <div t-elif="!state.packerStats.length" class="text-muted small px-1 fst-italic">
                    Chưa có packer nào được assign hôm nay.
                </div>
                <div t-else="" class="d-flex flex-wrap gap-2">
                    <t t-foreach="state.packerStats" t-as="packer" t-key="packer.id">
                        <div class="card border-0 shadow-sm flex-shrink-0" style="min-width:200px; max-width:260px;">
                            <div class="card-body p-2">
                                <!-- Tên packer + trạng thái -->
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold"
                                         style="width:30px;height:30px;font-size:0.75rem;flex-shrink:0;">
                                        <t t-esc="packer.name.charAt(0).toUpperCase()"/>
                                    </div>
                                    <div class="fw-bold text-dark" style="font-size:0.85rem; line-height:1.2;">
                                        <t t-esc="packer.name"/>
                                    </div>
                                </div>

                                <!-- Đang đóng -->
                                <div t-if="packer.packing.length" class="mb-1">
                                    <span class="badge bg-warning text-dark me-1">
                                        <i class="fa fa-spinner fa-spin me-1"></i>Đang: <t t-esc="packer.packing.length"/>
                                    </span>
                                    <t t-foreach="packer.packing" t-as="pk" t-key="pk.picking_id">
                                        <div class="small text-muted ms-1">
                                            <i class="fa fa-barcode me-1"></i><t t-esc="pk.picking_name"/>
                                            <span t-if="pk.print_time" class="text-secondary ms-1">(<t t-esc="pk.print_time"/>)</span>
                                        </div>
                                    </t>
                                </div>
                                <div t-else="" class="small text-muted mb-1 fst-italic">Không có phiếu đang đóng</div>

                                <!-- Đã xong hôm nay -->
                                <div class="d-flex align-items-center gap-2 mt-1 pt-1 border-top">
                                    <span class="badge bg-success">
                                        <i class="fa fa-check me-1"></i>Xong: <t t-esc="packer.packed_today.length"/>
                                    </span>
                                    <span t-if="packer.avg_minutes !== null" class="small text-muted">
                                        <i class="fa fa-clock-o me-1"></i>TB: <t t-esc="packer.avg_minutes"/> phút
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </div>
    </t>

</templates>
