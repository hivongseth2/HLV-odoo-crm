<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ================================================================
         TABLE (BẢNG) VIEW – Excel-like table for the Delivery Planner
         ================================================================
         Features:
           • Sticky header (thead)
           • Sortable columns (click header)
           • Resizable columns (drag handle on right border)
           • Frozen first column (Mã đơn + checkbox)
           • Compact rows
           • Color rows by status (delivery + packing)
           • Click row → openOverviewDrawer(so)
           • Expandable sub-row → list PICK pickings + PO liên quan
         ================================================================ -->
    <t t-name="hlv_sale_delivery_planning.TableBoard">
        <div class="hlv-table-view mt-2">

            <!-- Empty State -->
            <div t-if="!state.saleOrders.length"
                 class="alert alert-info shadow-sm d-flex align-items-center p-4"
                 role="alert">
                <i class="fa fa-info-circle fa-2x me-3" title="Thông tin"/>
                <div>
                    <h5 class="mb-1">Không có dữ liệu!</h5>
                    <div class="mb-0">Không tìm thấy đơn hàng nào phù hợp với bộ lọc hiện tại.</div>
                </div>
            </div>

            <div t-else="" class="hlv-table-wrap shadow-sm border rounded bg-white">
                <table class="hlv-dp-table table table-sm table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <!-- Frozen first column: checkbox + Mã đơn -->
                            <th class="hlv-col-frozen" style="width: 200px;">
                                <div class="d-flex align-items-center gap-2">
                                    <input type="checkbox"
                                           class="form-check-input m-0"
                                           t-att-checked="this.allTableRowsSelected"
                                           t-on-click.stop="() => this.toggleSelectAllVisibleSO()"
                                           title="Chọn tất cả đơn trên trang"/>
                                    <span class="hlv-th-label cursor-pointer"
                                          t-on-click="() => this.toggleTableSort('name')">
                                        Mã đơn
                                        <t t-call="hlv_sale_delivery_planning.TableSortIcon">
                                            <t t-set="field" t-value="'name'"/>
                                        </t>
                                    </span>
                                </div>
                                <span class="hlv-col-resizer"
                                      t-on-mousedown="(ev) => this.onColResizeStart(ev, 'name')"/>
                            </th>

                            <th t-on-click="() => this.toggleTableSort('misa_order_date')">
                                <span class="hlv-th-label cursor-pointer">
                                    Ngày MISA
                                    <t t-call="hlv_sale_delivery_planning.TableSortIcon">
                                        <t t-set="field" t-value="'misa_order_date'"/>
                                    </t>
                                </span>
                            </th>

                            <th t-on-click="() => this.toggleTableSort('partner')">
                                <span class="hlv-th-label cursor-pointer">
                                    Khách hàng
                                    <t t-call="hlv_sale_delivery_planning.TableSortIcon">
                                        <t t-set="field" t-value="'partner'"/>
                                    </t>
                                </span>
                            </th>

                            <th t-on-click="() => this.toggleTableSort('warehouse')">
                                <span class="hlv-th-label cursor-pointer">
                                    Kho
                                    <t t-call="hlv_sale_delivery_planning.TableSortIcon">
                                        <t t-set="field" t-value="'warehouse'"/>
                                    </t>
                                </span>
                            </th>

                            <th t-on-click="() => this.toggleTableSort('delivery_status')">
                                <span class="hlv-th-label cursor-pointer">
                                    Tiến độ giao
                                    <t t-call="hlv_sale_delivery_planning.TableSortIcon">
                                        <t t-set="field" t-value="'delivery_status'"/>
                                    </t>
                                </span>
                            </th>

                            <th t-on-click="() => this.toggleTableSort('stock_status')">
                                <span class="hlv-th-label cursor-pointer">
                                    Tình trạng kho
                                    <t t-call="hlv_sale_delivery_planning.TableSortIcon">
                                        <t t-set="field" t-value="'stock_status'"/>
                                    </t>
                                </span>
                            </th>

                            <th t-on-click="() => this.toggleTableSort('packing_status')">
                                <span class="hlv-th-label cursor-pointer">
                                    Đóng gói
                                    <t t-call="hlv_sale_delivery_planning.TableSortIcon">
                                        <t t-set="field" t-value="'packing_status'"/>
                                    </t>
                                </span>
                            </th>

                            <th t-on-click="() => this.toggleTableSort('commitment_date')">
                                <span class="hlv-th-label cursor-pointer">
                                    Ngày hẹn giao
                                    <t t-call="hlv_sale_delivery_planning.TableSortIcon">
                                        <t t-set="field" t-value="'commitment_date'"/>
                                    </t>
                                </span>
                            </th>

                            <th class="text-end" t-on-click="() => this.toggleTableSort('amount_total')">
                                <span class="hlv-th-label cursor-pointer">
                                    Tổng tiền
                                    <t t-call="hlv_sale_delivery_planning.TableSortIcon">
                                        <t t-set="field" t-value="'amount_total'"/>
                                    </t>
                                </span>
                            </th>

                            <th>HTGH</th>
                            <th>Hình thức giao</th>
                            <th>Mã NV bán</th>
                            <th>Shipper</th>
                            <th>Địa chỉ giao</th>
                            <th>Tags</th>
                            <th class="text-center" style="width: 110px;">Hành động</th>
                        </tr>
                    </thead>

                    <tbody>
                        <t t-foreach="this.tableSortedOrders" t-as="so" t-key="so.id">
                            <!-- ===== MAIN ROW ===== -->
                            <tr class="hlv-row-main"
                                t-att-class="this.getTableRowClass(so)"
                                t-on-click="() => this.openOverviewDrawer(so)">

                                <!-- Frozen: checkbox + Mã đơn + expand toggle -->
                                <td class="hlv-col-frozen">
                                    <div class="d-flex align-items-center gap-2">
                                        <input type="checkbox"
                                               class="form-check-input m-0"
                                               t-att-checked="this.isSOSelected(so.id)"
                                               t-on-click.stop="() => this.toggleSOSelection(so.id)"
                                               t-att-title="'Chọn đơn ' + so.name"/>
                                        <button class="btn btn-link btn-sm p-0 text-secondary"
                                                t-on-click.stop="() => this.toggleTableRowExpand(so.id)"
                                                t-att-title="this.isTableRowExpanded(so.id) ? 'Thu gọn' : 'Mở rộng PICK + PO'">
                                            <i class="fa"
                                               t-att-class="this.isTableRowExpanded(so.id) ? 'fa-caret-down' : 'fa-caret-right'"/>
                                        </button>
                                        <a href="#"
                                           class="fw-bold text-primary text-decoration-none"
                                           t-on-click.stop.prevent="() => this.openSaleOrder(so.id)"
                                           t-att-title="'Mở SO ' + so.name">
                                            <t t-esc="so.name"/>
                                        </a>
                                        <span t-if="so.has_unread_message"
                                              class="badge bg-danger"
                                              title="Có tin nhắn chưa đọc">
                                            <i class="fa fa-envelope"/>
                                        </span>
                                    </div>
                                </td>

                                <td>
                                    <t t-if="so.misa_order_date"><t t-esc="so.misa_order_date"/></t>
                                    <span t-else="" class="text-muted">—</span>
                                </td>

                                <td>
                                    <t t-if="so.partner_id"><t t-esc="so.partner_id[1]"/></t>
                                    <span t-else="" class="text-muted">—</span>
                                </td>

                                <td>
                                    <t t-if="so.warehouse_id"><t t-esc="so.warehouse_id[1]"/></t>
                                    <span t-else="" class="text-muted">—</span>
                                </td>

                                <td>
                                    <span class="badge"
                                          t-att-class="this.getDeliveryStatusBadgeClass(so.real_delivery_status || so.delivery_status)">
                                        <t t-esc="this.translateDeliveryStatus(so.real_delivery_status || so.delivery_status)"/>
                                    </span>
                                </td>

                                <td>
                                    <span class="badge"
                                          t-att-class="this.getStockStatusBadgeClass(so.stock_status)">
                                        <t t-esc="this.translateStockStatus(so.stock_status)"/>
                                    </span>
                                </td>

                                <td>
                                    <span class="badge"
                                          t-att-class="this.getPackingStatusBadgeClass(so.packing_status)">
                                        <t t-esc="this.translatePackingStatus(so.packing_status)"/>
                                    </span>
                                    <small t-if="so.total_packages_count" class="text-muted ms-1">
                                        (<t t-esc="so.total_packages_count"/>)
                                    </small>
                                </td>

                                <td>
                                    <t t-if="so.commitment_date">
                                        <t t-esc="so.commitment_date.substring(0, 10)"/>
                                    </t>
                                    <span t-else="" class="text-muted">—</span>
                                </td>

                                <td class="text-end fw-bold">
                                    <t t-esc="this.formatCurrency(so.amount_total)"/>
                                </td>

                                <td>
                                    <span t-if="so.x_studio_htgh" t-esc="so.x_studio_htgh"/>
                                    <span t-else="" class="text-muted">—</span>
                                </td>

                                <td>
                                    <span t-if="so.x_studio_delivery_type" t-esc="so.x_studio_delivery_type"/>
                                    <span t-else="" class="text-muted">—</span>
                                </td>

                                <td>
                                    <span t-if="so.x_studio_misa_saler_code" t-esc="so.x_studio_misa_saler_code"/>
                                    <span t-else="" class="text-muted">—</span>
                                </td>

                                <td>
                                    <t t-set="shippers" t-value="this.getShippersForSO(so)"/>
                                    <t t-if="shippers.length">
                                        <span t-foreach="shippers" t-as="sh" t-key="sh_index"
                                              class="badge bg-info text-dark me-1">
                                            <t t-esc="sh"/>
                                        </span>
                                    </t>
                                    <span t-else="" class="text-muted">—</span>
                                </td>

                                <td class="hlv-col-address" t-att-title="so.misa_shipping_address">
                                    <t t-if="so.misa_shipping_address">
                                        <t t-esc="so.misa_shipping_address"/>
                                    </t>
                                    <span t-else="" class="text-muted">—</span>
                                </td>

                                <td>
                                    <t t-if="so.tag_ids and so.tag_ids.length">
                                        <span t-foreach="so.tag_ids" t-as="tag" t-key="tag[0]"
                                              class="badge me-1"
                                              t-attf-style="background-color: var(--bs-primary, #1abc9c); color: white;">
                                            <t t-esc="tag[1]"/>
                                        </span>
                                    </t>
                                    <span t-else="" class="text-muted">—</span>
                                </td>

                                <td class="text-center" t-on-click.stop="">
                                    <button class="btn btn-sm btn-outline-primary"
                                            title="Xem chi tiết"
                                            t-on-click.stop="() => this.openOverviewDrawer(so)">
                                        <i class="fa fa-eye"/>
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary ms-1"
                                            title="Mở Sale Order"
                                            t-on-click.stop="() => this.openSaleOrder(so.id)">
                                        <i class="fa fa-external-link"/>
                                    </button>
                                </td>
                            </tr>

                            <!-- ===== EXPAND ROW: PICK pickings + PO liên quan ===== -->
                            <tr t-if="this.isTableRowExpanded(so.id)" class="hlv-row-expand">
                                <td colspan="16" class="bg-light p-3">
                                    <div class="row g-3">
                                        <!-- PICK / Pickings -->
                                        <div class="col-md-7">
                                            <h6 class="text-uppercase text-muted small mb-2">
                                                <i class="fa fa-truck me-1"/>
                                                Số phiếu PICK / Pickings
                                                <span t-if="so.pickings and so.pickings.length"
                                                      class="badge bg-secondary ms-1">
                                                    <t t-esc="so.pickings.length"/>
                                                </span>
                                            </h6>
                                            <div t-if="!so.pickings or !so.pickings.length"
                                                 class="text-muted small">Không có phiếu PICK nào.</div>
                                            <table t-else=""
                                                   class="table table-sm table-bordered mb-0 bg-white">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>Tên phiếu</th>
                                                        <th>Loại</th>
                                                        <th>Trạng thái</th>
                                                        <th>Shipper</th>
                                                        <th class="text-center" style="width: 50px;"></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr t-foreach="so.pickings" t-as="pk" t-key="pk.id">
                                                        <td>
                                                            <a href="#"
                                                               class="fw-semibold text-decoration-none"
                                                               t-on-click.stop.prevent="() => this.openPicking(pk.id)">
                                                                <t t-esc="pk.name"/>
                                                            </a>
                                                        </td>
                                                        <td>
                                                            <span class="badge bg-light text-dark">
                                                                <t t-esc="pk.picking_type or pk.picking_code"/>
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <span class="badge"
                                                                  t-att-class="this.getPickingStateBadgeClass(pk.state)">
                                                                <t t-esc="pk.state"/>
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <span t-if="pk.shipper_user" t-esc="pk.shipper_user"/>
                                                            <span t-else="" class="text-muted">—</span>
                                                        </td>
                                                        <td class="text-center">
                                                            <button class="btn btn-sm btn-link p-0"
                                                                    title="Mở phiếu"
                                                                    t-on-click.stop="() => this.openPicking(pk.id)">
                                                                <i class="fa fa-external-link"/>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>

                                        <!-- PO liên quan -->
                                        <div class="col-md-5">
                                            <h6 class="text-uppercase text-muted small mb-2">
                                                <i class="fa fa-shopping-cart me-1"/>
                                                PO liên quan
                                                <span t-if="so.pos and so.pos.length"
                                                      class="badge bg-secondary ms-1">
                                                    <t t-esc="so.pos.length"/>
                                                </span>
                                            </h6>
                                            <div t-if="!so.pos or !so.pos.length"
                                                 class="text-muted small">Không có PO liên quan.</div>
                                            <table t-else=""
                                                   class="table table-sm table-bordered mb-0 bg-white">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>PO</th>
                                                        <th>NCC</th>
                                                        <th>Hẹn về</th>
                                                        <th>Trạng thái</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr t-foreach="so.pos" t-as="po" t-key="po.id">
                                                        <td>
                                                            <a href="#"
                                                               class="fw-semibold text-decoration-none"
                                                               t-on-click.stop.prevent="() => this.openPurchaseOrder(po.id)">
                                                                <t t-esc="po.name"/>
                                                            </a>
                                                        </td>
                                                        <td>
                                                            <t t-if="po.partner_id">
                                                                <t t-esc="po.partner_id[1]"/>
                                                            </t>
                                                            <span t-else="" class="text-muted">—</span>
                                                        </td>
                                                        <td>
                                                            <t t-if="po.date_planned">
                                                                <t t-esc="po.date_planned.substring(0, 10)"/>
                                                            </t>
                                                            <span t-else="" class="text-muted">—</span>
                                                        </td>
                                                        <td>
                                                            <span class="badge"
                                                                  t-att-class="this.getPOStatusBadgeClass(po.receipt_status || po.state)">
                                                                <t t-esc="po.receipt_status or po.state"/>
                                                            </span>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div t-if="this.totalPages > 1"
                 class="position-sticky bottom-0 w-100 z-3 bg-light pt-2 pb-3 mb-0 border-top mt-3">
                <div class="d-flex justify-content-between align-items-center bg-white p-3 rounded shadow-lg border">
                    <div class="text-muted small">
                        Hiển thị
                        <span class="fw-bold">
                            <t t-esc="(state.currentPage - 1) * state.itemsPerPage + 1"/>
                        </span> -
                        <span class="fw-bold">
                            <t t-esc="Math.min(state.currentPage * state.itemsPerPage, state.totalCount)"/>
                        </span>
                        trong số
                        <span class="fw-bold text-dark"><t t-esc="state.totalCount"/></span> đơn hàng
                    </div>
                    <nav>
                        <ul class="pagination mb-0">
                            <li class="page-item"
                                t-att-class="{'disabled': state.currentPage === 1}">
                                <a class="page-link cursor-pointer" t-on-click="prevPage">
                                    <i class="fa fa-chevron-left"/> Trang trước
                                </a>
                            </li>
                            <li class="page-item active">
                                <a class="page-link" href="#">
                                    <t t-esc="state.currentPage"/> / <t t-esc="this.totalPages"/>
                                </a>
                            </li>
                            <li class="page-item"
                                t-att-class="{'disabled': state.currentPage === this.totalPages}">
                                <a class="page-link cursor-pointer" t-on-click="nextPage">
                                    Trang sau <i class="fa fa-chevron-right"/>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </t>

    <!-- Sort indicator helper -->
    <t t-name="hlv_sale_delivery_planning.TableSortIcon">
        <i t-if="state.tableSortField === field and state.tableSortDir === 'asc'"
           class="fa fa-sort-up ms-1"/>
        <i t-elif="state.tableSortField === field and state.tableSortDir === 'desc'"
           class="fa fa-sort-down ms-1"/>
        <i t-else="" class="fa fa-sort ms-1 text-muted opacity-50"/>
    </t>

</templates>
