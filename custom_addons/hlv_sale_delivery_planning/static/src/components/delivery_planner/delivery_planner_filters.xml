<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ================================================================
         Thanh bộ lọc đang kích hoạt (Active Filters Bar)
         ================================================================ -->
    <t t-name="hlv_sale_delivery_planning.ActiveFiltersBar">
        <div t-if="this.hasActiveFilters or state.hasDefaultFilters"
             class="mb-4 d-flex flex-wrap align-items-center gap-2 px-3 py-2 bg-light rounded border border-info border-opacity-25 w-100 shadow-sm mx-auto"
             style="max-width: 98%;">
            <span class="text-secondary small fw-bold me-2">
                <i class="fa fa-filter me-1" title="Bộ lọc"></i> Bộ lọc đang chọn:
            </span>

            <span t-if="state.searchQuery"
                  class="badge text-bg-info d-flex align-items-center gap-2 p-2 rounded-pill">
                Tìm: "<t t-esc="state.searchQuery"/>"
                <i class="fa fa-times cursor-pointer ms-1" title="Xóa"
                   t-on-click="() => this.clearSearchAndFetch()"></i>
            </span>

            <span t-if="state.filterWarehouseId !== 'all'"
                  class="badge text-bg-info d-flex align-items-center gap-2 p-2 rounded-pill">
                Kho: <t t-esc="state.warehouses.find(w => w.id == state.filterWarehouseId)?.name"/>
                <i class="fa fa-times cursor-pointer ms-1" title="Xóa"
                   t-on-click="() => { state.filterWarehouseId = 'all'; this.fetchData(); }"></i>
            </span>

            <span t-if="state.filterPackingStatus !== 'all'"
                  class="badge text-bg-info d-flex align-items-center gap-2 p-2 rounded-pill">
                Đóng gói: <t t-esc="this.translatePackingStatus(state.filterPackingStatus)"/>
                <i class="fa fa-times cursor-pointer ms-1" title="Xóa"
                   t-on-click="() => { state.filterPackingStatus = 'all'; this.fetchData(); }"></i>
            </span>

            <span t-if="state.filterSalerCode"
                  class="badge text-bg-info d-flex align-items-center gap-2 p-2 rounded-pill">
                NV MISA: <t t-esc="state.filterSalerCode"/>
                <i class="fa fa-times cursor-pointer ms-1" title="Xóa"
                   t-on-click="() => { state.filterSalerCode = ''; this.fetchData(); }"></i>
            </span>

            <span t-if="state.filterHtgh"
                  class="badge text-bg-info d-flex align-items-center gap-2 p-2 rounded-pill">
                HTGH: <t t-esc="state.filterHtgh"/>
                <i class="fa fa-times cursor-pointer ms-1" title="Xóa"
                   t-on-click="() => { state.filterHtgh = ''; this.fetchData(); }"></i>
            </span>

            <span t-if="state.filterDeliveryType !== 'all'"
                  class="badge text-bg-info d-flex align-items-center gap-2 p-2 rounded-pill">
                Vận chuyển: <t t-esc="state.filterDeliveryType"/>
                <i class="fa fa-times cursor-pointer ms-1" title="Xóa"
                   t-on-click="() => { state.filterDeliveryType = 'all'; this.fetchData(); }"></i>
            </span>

            <t t-foreach="state.filterTagIds" t-as="tagId" t-key="tagId">
                <span class="badge text-bg-info d-flex align-items-center gap-2 p-2 rounded-pill">
                    Tag: <t t-esc="state.tags.find(t => t.id === tagId)?.name || tagId"/>
                    <i class="fa fa-times cursor-pointer ms-1" title="Xóa"
                       t-on-click="() => { state.filterTagIds = state.filterTagIds.filter(id => id !== tagId); this.fetchData(); }"></i>
                </span>
            </t>

            <span t-if="state.filterDeliveryStatus !== 'all'"
                  class="badge text-bg-info d-flex align-items-center gap-2 p-2 rounded-pill">
                Giao hàng: <t t-esc="this.translateDeliveryStatus(state.filterDeliveryStatus)"/>
                <i class="fa fa-times cursor-pointer ms-1" title="Xóa"
                   t-on-click="() => { state.filterDeliveryStatus = 'all'; this.fetchData(); }"></i>
            </span>

            <span t-if="state.filterStockStatus !== 'all'"
                  class="badge text-bg-info d-flex align-items-center gap-2 p-2 rounded-pill">
                Tồn kho: <t t-esc="this.translateStockStatus(state.filterStockStatus)"/>
                <i class="fa fa-times cursor-pointer ms-1" title="Xóa"
                   t-on-click="() => { state.filterStockStatus = 'all'; this.fetchData(); }"></i>
            </span>

                        <span t-if="state.filterDoneDateFrom"
                                    class="badge text-bg-info d-flex align-items-center gap-2 p-2 rounded-pill">
                                Hoàn thành từ: <t t-esc="state.filterDoneDateFrom"/>
                                <i class="fa fa-times cursor-pointer ms-1" title="Xóa"
                                     t-on-click="() => { state.filterDoneDateFrom = ''; this.onFilterChange(); }"></i>
                        </span>

                        <span t-if="state.filterDoneDateTo"
                                    class="badge text-bg-info d-flex align-items-center gap-2 p-2 rounded-pill">
                                Hoàn thành đến: <t t-esc="state.filterDoneDateTo"/>
                                <i class="fa fa-times cursor-pointer ms-1" title="Xóa"
                                     t-on-click="() => { state.filterDoneDateTo = ''; this.onFilterChange(); }"></i>
                        </span>

            <span t-if="state.showCompleted"
                  class="badge text-bg-success d-flex align-items-center gap-2 p-2 rounded-pill">
                Hiện đơn đã giao
                <i class="fa fa-times cursor-pointer ms-1" title="Xóa"
                   t-on-click="() => { state.showCompleted = false; this.onFilterChange(); }"></i>
            </span>

            <span t-if="state.filterNeedTransfer"
                  class="badge text-bg-danger d-flex align-items-center gap-2 p-2 rounded-pill">
                <i class="fa fa-exchange me-1"></i>Cần chuyển kho
                <i class="fa fa-times cursor-pointer ms-1" title="Xóa"
                   t-on-click="() => { state.filterNeedTransfer = false; this.onFilterChange(); }"></i>
            </span>

            <span t-if="state.filterNewOrders"
                  class="badge d-flex align-items-center gap-2 p-2 rounded-pill" style="background:#d63384;color:#fff;">
                <i class="fa fa-star me-1"></i>Đơn hàng mới
                <i class="fa fa-times cursor-pointer ms-1" title="Xóa"
                   t-on-click="() => { state.filterNewOrders = false; this.onFilterChange(); }"></i>
            </span>

            <button class="btn btn-sm btn-outline-danger border-0 fw-bold ms-auto" t-on-click="resetFilters" t-if="this.hasActiveFilters">
                <i class="fa fa-trash-o me-1" title="Xóa tất cả"></i> Xóa tất cả bộ lọc
            </button>
            <button class="btn btn-sm btn-outline-primary fw-bold"
                    t-att-class="this.hasActiveFilters ? '' : 'ms-auto'"
                    t-on-click="saveCurrentFiltersAsDefault"
                    title="Lưu bộ lọc hiện tại làm mặc định mỗi khi mở dashboard">
                <i class="fa fa-bookmark me-1"></i> Lưu mặc định
            </button>
            <button t-if="state.hasDefaultFilters"
                    class="btn btn-sm btn-outline-secondary fw-bold"
                    t-on-click="clearDefaultFilters"
                    title="Xoá bộ lọc mặc định đã lưu">
                <i class="fa fa-bookmark-o me-1"></i> Xoá mặc định
            </button>
        </div>
    </t>

    <!-- ================================================================
         Thanh công cụ lọc (Filter Toolbar)
         ================================================================ -->
    <t t-name="hlv_sale_delivery_planning.FilterToolbar">
        <div class="row g-3 mb-4 bg-white p-3 rounded shadow-sm border align-items-end"
             style="padding-bottom: 40px !important;">
            <!-- Tìm kiếm -->
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted mb-1"
                       style="min-height:34px; display:flex; align-items:flex-end;">Tìm Kiếm</label>
                <div class="input-group">
                    <span class="input-group-text bg-light px-2 cursor-pointer" t-on-click="onFilterChange">
                        <i class="fa fa-search text-primary" title="Tìm kiếm"></i>
                    </span>
                    <input type="text" class="form-control px-2 border-1 fw-bold"
                           placeholder="Tìm tên/mã Khách, SO, Sản phẩm, Tham chiếu Shopee..."
                           t-model="state.searchQuery"
                           t-on-keyup="onSearchKeyup"/>
                </div>
            </div>

            <!-- Kho Cung Cấp -->
            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted mb-1"
                       style="min-height:34px; display:flex; align-items:flex-end;">Kho Cung Cấp</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="fa fa-building text-muted" title="Kho"></i></span>
                    <select class="form-select"
                            t-on-change="(ev) => { this.state.filterWarehouseId = ev.target.value; this.onFilterChange(); }">
                        <option value="all" t-att-selected="state.filterWarehouseId === 'all'">Tất cả</option>
                        <t t-foreach="state.warehouses" t-as="wh" t-key="wh.id">
                            <option t-att-value="wh.id" t-att-selected="state.filterWarehouseId == wh.id">
                                <t t-esc="wh.name"/>
                            </option>
                        </t>
                    </select>
                </div>
            </div>

      
            <!-- Tiến Độ Giao -->
            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted mb-1"
                       style="min-height:34px; display:flex; align-items:flex-end;">Tiến Độ Giao</label>
                <div class="input-group">
                    <span class="input-group-text bg-light px-2">
                        <i class="fa fa-truck text-primary" title="Tiến độ giao"></i>
                    </span>
                    <select class="form-select px-1 fw-bold" t-model="state.filterDeliveryStatus"
                            t-on-change="onFilterChange">
                        <option value="all">Tất cả</option>
                        <option value="pending_partial">Chưa giao &amp; Giao 1 phần</option>
                        <option value="unshipped">Chưa giao</option>
                        <option value="partial">Giao 1 phần</option>
                        <option value="full">Hoàn thành</option>
                    </select>
                </div>
            </div>

            <!-- Tình Trạng Kho -->
            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted mb-1"
                       style="min-height:34px; display:flex; align-items:flex-end;">Tình Trạng Kho</label>
                <div class="input-group">
                    <span class="input-group-text bg-light px-2">
                        <i class="fa fa-cubes text-warning" title="Tình trạng kho"></i>
                    </span>
                    <select class="form-select px-1 fw-bold" t-model="state.filterStockStatus"
                            t-on-change="onFilterChange">
                        <option value="all">Tất cả</option>
                        <option value="out_of_stock">Không có hàng</option>
                        <option value="partial_ready">Có hàng 1 phần</option>
                        <option value="ready">Đủ hàng xuất</option>
                    </select>
                </div>
            </div>

            <!-- Đóng Gói -->
            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted mb-1"
                       style="min-height:34px; display:flex; align-items:flex-end;">Đóng Gói</label>
                <div class="input-group">
                    <span class="input-group-text bg-light px-2">
                        <i class="fa fa-cube text-info" title="Đóng gói"></i>
                    </span>
                    <select class="form-select px-1 fw-bold" t-model="state.filterPackingStatus"
                            t-on-change="onFilterChange">
                        <option value="all">Tất cả</option>
                        <option value="waiting_stock">Không Có Hàng Đóng</option>
                        <option value="unpacked">Có Hàng Chưa Đóng Gói</option>
                        <option value="printed_waiting">Đã In, Chờ Đóng Gói</option>
                        <option value="fully_packed">Đã Đóng Gói Đủ</option>
                        <option value="packed_waiting_ship">Đã Gói, Chờ Nhận Giao</option>
                        <option value="shipping">Đang Giao</option>
                    </select>
                </div>
            </div>

                  <!-- Ngày Hẹn Giao SO -->
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted mb-1"
                       style="min-height:34px; display:flex; align-items:flex-end;">Ngày Hẹn Giao (Bán hàng)</label>
                <div class="input-group">
                    <span class="input-group-text bg-light px-2" title="Từ Ngày">
                        <i class="fa fa-calendar text-primary"></i>
                    </span>
                    <input type="date" class="form-control px-1" title="Từ Ngày"
                           t-model="state.filterDateFrom" t-on-change="onFilterChange"/>
                    <span class="input-group-text bg-light px-2 border-start-0 border-end-0">~</span>
                    <input type="date" class="form-control px-1" title="Đến Ngày"
                           t-model="state.filterDateTo" t-on-change="onFilterChange"/>
                </div>
            </div>

            <!-- Hoàn Thành (Theo ngày giao thực tế) -->
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted mb-1"
                       style="min-height:34px; display:flex; align-items:flex-end;">Hoàn thành</label>
                <div class="input-group">
                    <span class="input-group-text bg-light px-2" title="Hoàn thành từ">
                        <i class="fa fa-check-circle text-success"></i>
                    </span>
                    <input type="date" class="form-control px-1" title="Hoàn thành từ"
                           t-model="state.filterDoneDateFrom" t-on-change="onFilterChange"/>
                    <span class="input-group-text bg-light px-2 border-start-0 border-end-0">~</span>
                    <input type="date" class="form-control px-1" title="Hoàn thành đến"
                           t-model="state.filterDoneDateTo" t-on-change="onFilterChange"/>
                </div>
            </div>


            <!-- Ngày Hẹn Nhận PO -->
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted mb-1"
                       style="min-height:34px; display:flex; align-items:flex-end;">Ngày Hẹn Nhận (Mua hàng)</label>
                <div class="input-group">
                    <span class="input-group-text bg-light px-2" title="Từ Ngày">
                        <i class="fa fa-calendar-o text-info"></i>
                    </span>
                    <input type="date" class="form-control px-1" title="Từ Ngày"
                           t-model="state.filterPODateFrom" t-on-change="onFilterChange"/>
                    <span class="input-group-text bg-light px-2 border-start-0 border-end-0">~</span>
                    <input type="date" class="form-control px-1" title="Đến Ngày"
                           t-model="state.filterPODateTo" t-on-change="onFilterChange"/>
                </div>
            </div>

            <!-- Trạng Thái PO -->
            <div class="col-md-3 mt-md-0 mt-3">
                <label class="form-label small fw-bold text-muted mb-1"
                       style="min-height:34px; display:flex; align-items:flex-end;">Trạng Thái (Mua hàng)</label>
                <div class="input-group">
                    <span class="input-group-text bg-light px-2">
                        <i class="fa fa-file-text-o text-info" title="Hồ sơ"></i>
                    </span>
                    <select class="form-select px-1 fw-bold" t-model="state.filterPOStatus"
                            t-on-change="onFilterChange">
                        <option value="all">Tất cả</option>
                        <option value="pending">Chưa nhận hàng</option>
                        <option value="partial">Nhận 1 phần</option>
                        <option value="full">Đã nhận đủ</option>
                    </select>
                </div>
            </div>

            <!-- Mã NV MISA -->
            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted mb-1"
                       style="min-height:34px; display:flex; align-items:flex-end;">Mã NV MISA</label>
                <div class="input-group">
                    <span class="input-group-text bg-light px-2">
                        <i class="fa fa-id-badge text-info" title="Mã nhân viên"></i>
                    </span>
                    <input type="text" class="form-control px-2 fw-bold"
                           placeholder="VD: NV001"
                           t-model="state.filterSalerCode"
                           t-on-keyup="onSearchKeyup"/>
                </div>
            </div>

            <!-- HTGH — chips dùng position:absolute để không làm cao cột -->
            <div class="col-md-3" style="position: relative;">
                <label class="form-label small fw-bold text-muted mb-1"
                       style="min-height:34px; display:flex; align-items:flex-end;">HTGH
                    <small class="fw-normal text-secondary ms-1">(phẩy=OR, !=loại trừ)</small>
                </label>
                <div class="d-flex flex-wrap gap-1"
                     style="top:100%; left:0; right:0; padding-top:4px; z-index:20;">
                    <t t-foreach="state.htghPresets" t-as="preset" t-key="preset_index">
                        <span class="badge border d-inline-flex align-items-center gap-1 px-2 py-1"
                              style="font-size:.72rem; background:#f8f9fa; color:#495057; border-color:#dee2e6!important; cursor:default; white-space:nowrap;">
                            <span class="cursor-pointer"
                                  t-on-click="() => { this.state.filterHtgh = preset.value; this.onFilterChange(); }"
                                  t-att-title="preset.value">
                                <t t-esc="preset.label"/>
                            </span>
                            <i class="fa fa-times ms-1"
                               style="cursor:pointer; opacity:.5"
                               title="Xóa gợi ý này"
                               t-on-click="() => this.removeHtghPreset(preset_index)"></i>
                        </span>
                    </t>
                </div>
                <div class="input-group">
                    <span class="input-group-text bg-light px-2">
                        <i class="fa fa-info-circle text-secondary"></i>
                    </span>
                    <input type="text" class="form-control px-2"
                           placeholder="VD: ghn,cpn hoặc !ghn,!j&amp;t"
                           t-model="state.filterHtgh"
                           t-on-keyup="onSearchKeyup"/>
                    <button class="btn btn-outline-secondary px-2" type="button"
                            title="Lưu giá trị hiện tại làm gợi ý"
                            t-on-click="saveHtghPreset">
                        <i class="fa fa-plus"></i>
                    </button>
                </div>
                <!-- chips nằm ngoài flow, không ảnh hưởng chiều cao cột -->
                
            </div>

            <!-- Loại vận chuyển -->
            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted mb-1"
                       style="min-height:34px; display:flex; align-items:flex-end;">Loại vận chuyển</label>
                <div class="input-group">
                    <span class="input-group-text bg-light px-2">
                        <i class="fa fa-car text-secondary"></i>
                    </span>
                    <select class="form-select px-1" t-model="state.filterDeliveryType" t-on-change="fetchData">
                        <option value="all">Tất cả</option>
                        <option value="HLV vận chuyển">HLV vận chuyển</option>
                        <option value="GHN">GHN</option>
                        <option value="J&amp;T">J&amp;T</option>
                    </select>
                </div>
            </div>

            <!-- Tags multi-select -->
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted mb-1"
                       style="min-height:34px; display:flex; align-items:flex-end;">
                    <i class="fa fa-tags me-1"></i> Tags
                    <small class="text-muted fw-normal ms-1">(Ctrl/⌘ chọn nhiều)</small>
                </label>
                <select multiple="multiple" class="form-select"
                        style="min-height:38px; max-height:110px;"
                        t-on-change="onTagFilterChange">
                    <t t-foreach="state.tags" t-as="tag" t-key="tag.id">
                        <option t-att-value="tag.id"
                                t-att-selected="state.filterTagIds.includes(tag.id)">
                            <t t-esc="tag.name"/>
                        </option>
                    </t>
                </select>
            </div>

            <!-- Cần chuyển kho -->
            <div class="col-md-2 d-flex align-items-end">
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" role="switch"
                           id="filterNeedTransfer"
                           t-att-checked="state.filterNeedTransfer"
                           t-on-change="(ev) => { this.state.filterNeedTransfer = ev.target.checked; this.onFilterChange(); }"/>
                    <label class="form-check-label small fw-bold" for="filterNeedTransfer">
                        <i class="fa fa-exchange text-danger me-1"></i>Cần chuyển kho
                    </label>
                </div>
            </div>

              <!-- Đơn hàng mới hôm nay -->
            <div class="col-md-2 d-flex align-items-end">
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" role="switch"
                           id="filterNewOrders"
                           t-att-checked="state.filterNewOrders"
                           t-on-change="(ev) => { this.state.filterNewOrders = ev.target.checked; this.onFilterChange(); }"/>
                    <label class="form-check-label small fw-bold" for="filterNewOrders">
                        <i class="fa fa-star me-1" style="color:#d63384;"></i>Đơn hàng mới
                    </label>
                </div>
            </div>
          

            <!-- Hiện đơn đã giao -->
            <div class="col-md-2 d-flex align-items-end">
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" role="switch"
                           id="filterShowCompleted"
                           t-att-checked="state.showCompleted"
                           t-on-change="(ev) => { this.state.showCompleted = ev.target.checked; this.onFilterChange(); }"/>
                    <label class="form-check-label small fw-bold" for="filterShowCompleted">
                        <i class="fa fa-check-circle text-success me-1"></i>Hiện đơn đã giao
                    </label>
                </div>
            </div>
        </div>
    </t>

</templates>
