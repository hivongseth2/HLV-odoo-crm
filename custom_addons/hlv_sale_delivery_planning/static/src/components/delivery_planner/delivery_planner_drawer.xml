<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ================================================================
         Side Drawer - Tổng Quan Đơn Hàng (Offcanvas)
         Sử dụng state.selectedOrder và state.isDrawerOpen
         ================================================================ -->
    <t t-name="hlv_sale_delivery_planning.Drawer">
        <div t-if="state.isDrawerOpen"
             class="offcanvas offcanvas-end show shadow-lg" tabindex="-1"
             style="visibility: visible; width: 680px; z-index: 1050; position: fixed; top: 0; bottom: 0; right: 0; background: white;">

            <div class="offcanvas-header bg-primary text-bg-primary p-3">
                <h5 class="offcanvas-title m-0 text-bg-primary">
                    <i class="fa fa-list-alt me-2" title="Danh sách"></i>
                    <t t-esc="state.selectedOrder.name"/>
                </h5>
                <button type="button" class="btn-close btn-close-white ms-auto"
                        aria-label="Close" t-on-click="closeOverviewDrawer"></button>
            </div>

            <div class="offcanvas-body p-4 text-start bg-light overflow-auto"
                 style="height: calc(100vh - 150px);">

                <!-- Thông tin SO -->
                <div class="row bg-white p-3 rounded shadow-sm border mb-4 mx-0">
                    <div class="col-md-6 mb-2">
                        <h6 class="text-muted text-uppercase small mb-2">Khách Hàng</h6>
                        <div class="fs-6 fw-bold">
                            <i class="fa fa-user me-2 text-primary" title="Khách hàng"></i>
                            <t t-esc="state.selectedOrder.partner_id ? state.selectedOrder.partner_id[1] : 'Unknown'"/>
                        </div>
                    </div>
                    <div class="col-md-6 mb-2">
                        <h6 class="text-muted text-uppercase small mb-2">Kho Hàng</h6>
                        <div class="fs-6 fw-bold">
                            <i class="fa fa-building me-2 text-info" title="Kho"></i>
                            <t t-esc="state.selectedOrder.warehouse_id ? state.selectedOrder.warehouse_id[1] : 'Chưa định thông tin'"/>
                        </div>
                    </div>
                </div>

                <!-- Chi tiết sản phẩm -->
                <h6 class="text-muted text-uppercase small mb-3">
                    <i class="fa fa-cubes me-1" title="Chi tiết sản phẩm"></i> Tình trạng Chi Tiết Sản Phẩm
                </h6>
                <table class="table table-bordered table-sm table-hover text-center align-middle bg-white shadow-sm mb-4">
                    <thead class="table-light">
                        <tr>
                            <th class="text-start">Sản phẩm</th>
                            <th width="70">Chốt Bán</th>
                            <th width="70">Đóng Gói</th>
                            <th width="70">Tồn Kho</th>
                            <th width="70">Đã Giao</th>
                            <th width="70">Thiếu</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="this.groupedLines(state.selectedOrder.lines)" t-as="line" t-key="line.product_id ? line.product_id[0] : line_index">
                            <tr t-att-class="(line.product_uom_qty - line.qty_delivered) > 0 ? 'table-warning' : 'table-success'">
                                <td class="text-start">
                                    <div class="d-flex flex-column">
                                        <span><t t-esc="line.product_id ? line.product_id[1] : 'Unknown'"/></span>
                                        <t t-if="line.is_kit">
                                            <span class="badge bg-warning bg-opacity-25 text-warning-emphasis border border-warning border-opacity-50 align-self-start mt-1"
                                                  style="font-size: 10px;">
                                                <i class="fa fa-gift me-1" title="Sản phẩm bộ"></i> Combo (Kit)
                                            </span>
                                        </t>
                                    </div>
                                </td>
                                <td class="fw-bold"><t t-esc="this.formatQty(line.product_uom_qty)"/></td>
                                <td t-att-class="line.qty_packed >= line.product_uom_qty ? 'text-success fw-bold' : (line.qty_packed > 0 ? 'text-info fw-bold' : 'text-muted')">
                                    <t t-if="line.qty_packed > 0">
                                        <i class="fa fa-cube me-1" title="Số lượng đóng gói"></i>
                                        <t t-esc="this.formatQty(line.qty_packed)"/>
                                        <i t-if="line.qty_packed >= line.product_uom_qty"
                                           class="fa fa-check-circle ms-1" title="Đã đóng gói đủ"></i>
                                    </t>
                                    <t t-else="">0</t>
                                </td>
                                <t t-set="eff_stock" t-value="(line.qty_warehouse_free || 0) + (line.qty_reserved_here || 0)"/>
                                <td t-att-class="eff_stock > 0 ? 'text-success fw-bold' : 'text-danger'">
                                    <t t-esc="this.formatQty(eff_stock)"/>
                                </td>
                                <td class="text-primary"><t t-esc="this.formatQty(line.qty_delivered)"/></td>
                                <td t-att-class="'fw-bold ' + (Math.max(line.product_uom_qty - line.qty_delivered - (line.qty_packed || 0) - eff_stock, 0) > 0 ? 'text-danger' : 'text-muted opacity-50')">
                                    <t t-if="line.is_kit"><span class="small">-</span></t>
                                    <t t-else=""><t t-esc="this.formatQty(Math.max(line.product_uom_qty - line.qty_delivered - (line.qty_packed || 0) - eff_stock, 0))"/></t>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <!-- Đơn Mua (PO) trong drawer -->
                <div t-if="state.selectedOrder.pos and state.selectedOrder.pos.length > 0">
                    <h6 class="text-muted text-uppercase small mb-3">
                        <i class="fa fa-shopping-cart me-1" title="Lệnh mua"></i> ĐƠN MUA HÀNG
                    </h6>
                    <div class="list-group shadow-sm border mb-4">
                        <t t-foreach="state.selectedOrder.pos" t-as="po" t-key="po.id">
                            <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-3 cursor-pointer"
                                 t-on-click="() => this.openPurchaseOrder(po.id)">
                                <div>
                                    <div class="fw-bold"><t t-esc="po.name"/></div>
                                    <div class="small text-muted">
                                        <i class="fa fa-user me-1" title="Nhà cung cấp"></i>
                                        <t t-esc="po.partner_id ? po.partner_id[1] : 'Unknown'"/>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <span class="badge" t-att-class="this.getPOStatusBadgeClass(po.state, po.receipt_status)">
                                        <t t-esc="this.translatePOStatus(po.receipt_status || po.state)"/>
                                    </span>
                                    <div class="small mt-1 fw-bold" t-if="po.date_planned">
                                        <i class="fa fa-clock-o" title="Lịch nhận"></i>
                                        Dự kiến: <t t-esc="po.date_planned.substring(0, 10)"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- Luồng Phiếu Xuất Kho trong drawer (timeline) -->
                <div t-if="state.selectedOrder.pickings and state.selectedOrder.pickings.length > 0">
                    <h6 class="text-muted text-uppercase small mb-3">
                        <i class="fa fa-sitemap me-1" title="Luồng phiếu"></i> Luồng Phiếu Xuất Kho
                    </h6>
                    <div class="position-relative ms-3 border-start border-2 border-primary pb-1 mb-4">
                        <t t-foreach="state.selectedOrder.pickings" t-as="picking" t-key="picking.id">
                            <div class="position-relative mb-3 ms-4 cursor-pointer"
                                 t-on-click="() => this.openPicking(picking.id)">
                                <span class="position-absolute rounded-circle"
                                      t-att-class="picking.state == 'done' ? 'bg-success' : 'bg-primary'"
                                      style="width: 14px; height: 14px; left: -32px; top: 6px; border: 2px solid white;"></span>
                                <div class="card shadow-sm border-1"
                                     t-att-class="picking.state == 'done' ? 'bg-light opacity-75' : 'bg-white border border-primary'">
                                    <div class="card-body p-3 d-flex justify-content-between align-items-center">
                                        <div>
                                            <div class="small fw-bold mb-1"
                                                 t-att-class="picking.state == 'done' ? 'text-secondary' : 'text-primary'">
                                                <t t-esc="picking.type_name"/>
                                            </div>
                                            <div class="fw-bold"
                                                 t-att-class="picking.state == 'done' ? 'text-muted' : 'text-dark'">
                                                <i class="fa fa-barcode text-muted me-1" title="Mã phiếu"></i>
                                                <t t-esc="picking.name"/>
                                            </div>
                                            <div t-if="picking.return_of" class="small mt-1 text-danger">
                                                <i class="fa fa-undo me-1" title="Trả hàng"></i>
                                                Trả cho lệnh: <t t-esc="picking.return_of"/>
                                            </div>
                                            <div t-if="picking.backorder_of" class="small mt-1 text-muted">
                                                <i class="fa fa-files-o me-1" title="Tách phiếu"></i>
                                                Phiếu cắt ngang từ: <t t-esc="picking.backorder_of"/>
                                            </div>
                                            <div class="small text-muted mt-1" t-if="picking.scheduled_date">
                                                <i class="fa fa-clock-o me-1" title="Lịch giao"></i>
                                                Lịch giao: <t t-esc="picking.scheduled_date"/>
                                            </div>
                                            <div t-if="picking.videos and picking.videos.length > 0" class="mt-2 text-start">
                                                <t t-foreach="picking.videos" t-as="video" t-key="video.id">
                                                    <span class="badge bg-danger cursor-pointer d-inline-flex align-items-center mb-1 me-1 px-2 py-1"
                                                          t-on-click.stop="() => this.openVideo(video.url)">
                                                        <i class="fa fa-play-circle me-1"></i> Video Đóng Gói
                                                    </span>
                                                </t>
                                            </div>
                                        </div>
                                        <div class="text-end">
                                            <span class="badge"
                                                  t-att-class="this.getPickingStatusBadgeClass(picking.state)">
                                                <t t-esc="this.translatePickingStatus(picking.state)"/>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>

            <!-- Footer drawer -->
            <div class="p-3 bg-white border-top d-flex justify-content-between align-items-center"
                 style="position: absolute; bottom: 0; width: 100%;">
                <div class="text-muted small">
                    <strong>Trị giá: </strong>
                    <span class="text-primary fs-6 fw-bold">
                        <t t-esc="this.formatCurrency(state.selectedOrder.amount_total)"/>
                    </span>
                </div>
                <button type="button" class="btn btn-primary"
                        t-on-click="() => { this.openSaleOrder(state.selectedOrder.id); this.closeOverviewDrawer(); }">
                    Mở Đơn Bán
                </button>
            </div>
        </div>
    </t>

</templates>
