<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ================================================================
         Thẻ Sale Order (SO Card) - sử dụng biến `so` từ t-foreach cha
         ================================================================ -->
    <t t-name="hlv_sale_delivery_planning.SOCard">
        <div class="card h-100 border-1" t-att-class="this.getSOCardColorClass(so)">

            <!-- Header thẻ -->
            <div class="card-header d-flex justify-content-between align-items-center py-3 border-bottom-1">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                        <span class="badge" t-att-class="this.getDeliveryStatusBadgeClass(so.real_delivery_status)">
                            <t t-esc="this.translateDeliveryStatus(so.real_delivery_status)"/>
                        </span>
                        <span class="badge" t-att-class="this.getStockStatusBadgeClass(so.stock_status)"
                              t-if="so.real_delivery_status != 'full'">
                            <t t-esc="this.translateStockStatus(so.stock_status)"/>
                        </span>
                        <span class="badge"
                              t-att-class="this.getPackingStatusBadgeClass(so.packing_status)"
                              t-if="so.real_delivery_status != 'full' and so.packing_status != 'unknown'">
                            <i class="fa fa-cube me-1" title="Kiện hàng"></i>
                            <t t-esc="this.translatePackingStatus(so.packing_status)"/>
                        </span>
                    </div>
                    <h5 class="card-title mb-1 text-primary cursor-pointer o_form_uri"
                        t-on-click="() => this.openSaleOrder(so.id)">
                        <i class="fa fa-shopping-cart text-muted me-1" title="Đơn hàng"></i>
                        <t t-esc="so.name"/>
                    </h5>
                    <div class="text-muted small fw-bold">
                        <i class="fa fa-user text-info me-1" title="Khách hàng"></i>
                        <t t-esc="so.partner_id ? so.partner_id[1] : 'Unknown'"/>
                    </div>
                </div>
                <div class="text-end">
                    <button class="btn btn-sm btn-outline-secondary mb-1"
                            t-on-click="() => this.openOverviewDrawer(so)">
                        <i class="fa fa-eye" title="Xem nhanh"></i> Tổng Quan
                    </button>
                    <div class="small fw-bold text-nowrap mt-1" t-if="so.commitment_date">
                        <i class="fa fa-calendar-check-o text-danger me-1" title="Ngày hẹn giao"></i>
                        Giao: <t t-esc="so.commitment_date.substring(0, 10)"/>
                    </div>
                </div>
            </div>

            <!-- Body thẻ -->
            <div class="card-body pt-2 pb-0">

                <!-- Đơn Mua Liên Quan (POs) -->
                <div>
                    <div class="d-flex align-items-center justify-content-between mb-2 mt-2 px-1 cursor-pointer toggle-section-header"
                         t-on-click="() => this.toggleSection('pos')">
                        <h6 class="text-uppercase text-secondary small fw-bold mb-0">
                            <i class="fa fa-list me-1" title="Danh sách"></i> Đơn Mua Liên Quan
                        </h6>
                        <i t-attf-class="fa #{this.isSectionCollapsed('pos') ? 'fa-chevron-right' : 'fa-chevron-down'} text-muted small"></i>
                    </div>
                </div>

                <div t-if="so.pos.length"
                     t-attf-class="list-group mb-3 gap-2 border-1 #{this.isSectionCollapsed('pos') ? 'd-none' : ''}">
                    <t t-foreach="so.pos" t-as="po" t-key="po.id">
                        <button class="list-group-item list-group-item-action d-flex justify-content-between border rounded shadow-sm p-2 bg-white"
                                t-on-click="() => this.openPurchaseOrder(po.id)">
                            <div class="d-flex flex-column align-items-start">
                                <span class="fw-bold text-dark">
                                    <i class="fa fa-file-text-o text-muted me-1" title="Phiếu mua"></i>
                                    <t t-esc="po.name"/>
                                </span>
                                <div class="small mt-1" t-if="po.date_planned"
                                     t-att-class="this.getDatesComparisonClass(so.commitment_date, po.date_planned)">
                                    <i class="fa fa-clock-o me-1" title="Thời gian"></i>
                                    Dự kiến về: <t t-esc="po.date_planned.substring(0, 10)"/>
                                    <i t-if="so.commitment_date and po.date_planned > so.commitment_date"
                                       class="fa fa-warning ms-1 text-danger"
                                       title="Hàng về trễ so với ngày dự giao SO!"></i>
                                </div>
                            </div>
                            <div class="d-flex align-items-center">
                                <span class="badge" t-att-class="this.getPOStatusBadgeClass(po.state, po.receipt_status)">
                                    <t t-esc="this.translatePOStatus(po.receipt_status || po.state)"/>
                                </span>
                            </div>
                        </button>
                    </t>
                </div>
                <div t-if="!so.pos.length"
                     t-attf-class="alert alert-warning py-2 small mb-3 border-1 #{this.isSectionCollapsed('pos') ? 'd-none' : ''}">
                    <i class="fa fa-exclamation-triangle me-1" title="Cảnh báo"></i> Không có đơn mua hàng
                </div>

                <!-- Kiện Hàng (Packages) -->
                <div t-if="so.packages and so.packages.length > 0" class="mb-3 px-1">
                    <div class="d-flex align-items-center justify-content-between mb-3 cursor-pointer toggle-section-header"
                         t-on-click="() => this.toggleSection('packages')">
                        <h6 class="text-uppercase text-secondary small fw-bold mb-0">
                            <i class="fa fa-cubes me-1" title="Thông tin kiện"></i>
                            Thông Tin Kiện Hàng (<t t-esc="so.total_packages_count"/>)
                        </h6>
                        <i t-attf-class="fa #{this.isSectionCollapsed('packages') ? 'fa-chevron-right' : 'fa-chevron-down'} text-muted small"></i>
                    </div>
                    <div t-attf-class="package-groups #{this.isSectionCollapsed('packages') ? 'd-none' : ''}">
                        <t t-foreach="so.packages" t-as="group" t-key="group.picking_id">
                            <div class="picking-package-group mb-3 pb-3 border-bottom">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div class="d-flex align-items-center flex-grow-1">
                                        <span class="badge bg-secondary bg-opacity-10 text-primary border border-secondary border-opacity-25 py-1 px-2 small">
                                            <i class="fa fa-file-text-o me-1" title="Phiếu xuất"></i>
                                            <t t-esc="group.picking_name"/>
                                        </span>
                                        <span t-attf-class="ms-2 badge rounded-pill #{this.getPackageGroupBadgeClass(so, group)}"
                                              style="font-size: 0.65rem;">
                                            <t t-esc="this.formatPackageGroupStatus(so, group)"/>
                                        </span>
                                        <hr class="flex-grow-1 ms-2 my-0 opacity-25"/>
                                    </div>
                                </div>
                                <div class="d-flex flex-wrap gap-2 package-grid">
                                    <t t-foreach="group.packages" t-as="pack" t-key="pack.id">
                                        <div class="package-box-container position-relative"
                                             t-att-title="'Bấm để xem chi tiết: ' + pack.name"
                                             t-on-click="() => this.openPackageDetails(pack)">
                                            <div class="package-box d-flex flex-column align-items-center justify-content-center border rounded shadow-sm bg-white p-1"
                                                 style="min-width: 85px;">
                                                <i class="fa fa-archive fa-2x text-primary mb-1" title="Kiện hàng"></i>
                                                <span class="small text-truncate w-100 px-1 text-center"
                                                      style="font-size: 0.60rem;">
                                                    <t t-esc="pack.name"/>
                                                </span>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- Luồng Xử Lý Kho -->
                <div t-if="so.flows and so.flows.length > 0">
                    <div class="d-flex align-items-center justify-content-between mb-2 mt-2 px-1 cursor-pointer toggle-section-header"
                         t-on-click="() => this.toggleSection('flows')">
                        <h6 class="text-uppercase text-secondary small fw-bold mb-0">
                            <i class="fa fa-sitemap me-1" title="Sơ đồ"></i> Luồng Xử Lý Kho
                        </h6>
                        <i t-attf-class="fa #{this.isSectionCollapsed('flows') ? 'fa-chevron-right' : 'fa-chevron-down'} text-muted small"></i>
                    </div>

                    <div t-attf-class="#{this.isSectionCollapsed('flows') ? 'd-none' : ''}">
                        <t t-foreach="so.flows" t-as="flow" t-key="flow.id">
                            <div class="d-flex align-items-center overflow-auto pb-3 pt-1 gap-2 px-1 border-1"
                                 style="white-space: nowrap;">

                                <t t-if="flow.is_return">
                                    <!-- Luồng TRẢ HÀNG: Khách → Kho -->
                                    <div class="d-flex flex-column justify-content-start align-items-center text-danger px-2 border border-danger rounded p-2 bg-light">
                                        <i class="fa fa-user fa-2x mb-1"></i>
                                        <small class="fw-bold text-truncate" style="max-width: 100px;"
                                               t-att-title="so.partner_id ? so.partner_id[1] : 'Khách hàng'">
                                            <t t-esc="so.partner_id ? so.partner_id[1] : 'Khách hàng'"/>
                                        </small>
                                    </div>
                                    <div class="text-danger mx-1"><i class="fa fa-long-arrow-right fa-lg" title="Tiếp theo"></i></div>

                                    <t t-foreach="flow.nodes" t-as="picking" t-key="picking.id">
                                        <t t-call="hlv_sale_delivery_planning.PickingNodeReturn"/>
                                        <div class="mx-1"
                                             t-att-class="picking.state == 'cancel' ? 'text-secondary' : 'text-danger'">
                                            <i class="fa fa-long-arrow-right fa-lg"></i>
                                        </div>
                                    </t>

                                    <div class="d-flex position-relative flex-column justify-content-start align-items-center text-muted px-2 border rounded p-2 bg-light">
                                        <span t-if="flow.nodes.length > 0 and flow.nodes[flow.nodes.length - 1].state == 'done'"
                                              class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-success">
                                            <i class="fa fa-check"></i>
                                        </span>
                                        <i class="fa fa-building fa-2x mb-1"></i>
                                        <small class="fw-bold text-truncate" style="max-width: 100px;"
                                               t-att-title="'Kho ' + (so.warehouse_id ? so.warehouse_id[1] : '')">Kho</small>
                                    </div>
                                </t>

                                <t t-else="">
                                    <!-- Luồng XUẤT HÀNG: Kho → Khách -->
                                    <div class="d-flex flex-column justify-content-start align-items-center text-muted px-2 border rounded p-2 bg-light">
                                        <i class="fa fa-building fa-2x mb-1"></i>
                                        <small class="fw-bold text-truncate" style="max-width: 100px;"
                                               t-att-title="'Kho ' + (so.warehouse_id ? so.warehouse_id[1] : '')">Kho</small>
                                    </div>
                                    <div class="text-muted mx-1"><i class="fa fa-long-arrow-right fa-lg" title="Tiếp theo"></i></div>

                                    <t t-foreach="flow.nodes" t-as="picking" t-key="picking.id">
                                        <t t-call="hlv_sale_delivery_planning.PickingNodeOutbound"/>
                                        <div class="mx-1"
                                             t-att-class="picking.state == 'cancel' ? 'text-secondary' : 'text-muted'">
                                            <i class="fa fa-long-arrow-right fa-lg"></i>
                                        </div>
                                    </t>

                                    <div class="d-flex position-relative flex-column justify-content-start align-items-center text-primary px-2 border border-primary rounded p-2 bg-light">
                                        <span t-if="flow.nodes.length > 0 and flow.nodes[flow.nodes.length - 1].state == 'done'"
                                              class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-success">
                                            <i class="fa fa-check"></i>
                                        </span>
                                        <span t-if="flow.nodes.length > 0 and flow.nodes[flow.nodes.length - 1].state == 'cancel'"
                                              class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                            <i class="fa fa-times" title="Hủy"></i>
                                        </span>
                                        <i class="fa fa-user fa-2x mb-1"></i>
                                        <small class="fw-bold text-truncate" style="max-width: 100px;"
                                               t-att-title="so.partner_id ? so.partner_id[1] : 'Khách hàng'">
                                            <t t-esc="so.partner_id ? so.partner_id[1] : 'Khách hàng'"/>
                                        </small>
                                    </div>
                                </t>

                            </div>
                        </t>
                    </div>
                </div>

                <!-- Sản Phẩm Đang Chờ -->
                <div class="d-flex align-items-center justify-content-between mb-2 mt-2 px-1 cursor-pointer toggle-section-header"
                     t-on-click="() => this.toggleSection('pending_products')">
                    <h6 class="text-uppercase text-secondary small fw-bold mb-0">
                        <i class="fa fa-cubes me-1" title="Chờ hàng"></i> Sản Phẩm Đang Chờ
                    </h6>
                    <i t-attf-class="fa #{this.isSectionCollapsed('pending_products') ? 'fa-chevron-right' : 'fa-chevron-down'} text-muted small"></i>
                </div>
                <div t-attf-class="#{this.isSectionCollapsed('pending_products') ? 'd-none' : ''}">
                    <div class="table-responsive bg-white rounded shadow-sm border mb-3">
                        <table class="table table-sm table-borderless table-hover mb-0 small">
                            <thead class="table-light border-bottom">
                                <tr>
                                    <th class="ps-3 text-muted">Sản phẩm</th>
                                    <th class="text-end pe-3 text-muted" width="60">SL</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="so.lines and so.lines.length > 0">
                                    <t t-foreach="so.lines" t-as="line" t-key="line.id">
                                        <tr t-if="line.product_uom_qty > line.qty_delivered">
                                            <td class="ps-3 text-truncate" style="max-width: 200px;"
                                                t-att-title="line.product_id ? line.product_id[1] : 'Unknown'">
                                                <t t-esc="line.product_id ? line.product_id[1] : 'Unknown'"/>
                                            </td>
                                            <td class="text-end pe-3 fw-bold">
                                                <div t-att-class="line.qty_available >= (line.product_uom_qty - line.qty_delivered) ? 'text-success' : 'text-danger'">
                                                    <t t-esc="this.formatQty(line.product_uom_qty - line.qty_delivered)"/>
                                                    <i t-if="line.qty_available >= (line.product_uom_qty - line.qty_delivered)"
                                                       class="fa fa-check ms-1" title="Kho đã có đủ"></i>
                                                </div>
                                                <div t-if="line.qty_packed > 0" class="mt-1">
                                                    <span class="badge rounded-pill bg-info text-dark"
                                                          style="font-size: 0.65rem;"
                                                          t-att-title="'Đã đóng gói: ' + line.qty_packed">
                                                        <i class="fa fa-cube me-1" title="Đóng gói"></i>
                                                        Đóng: <t t-esc="this.formatQty(line.qty_packed)"/>
                                                    </span>
                                                </div>
                                                <div t-else="" class="mt-1">
                                                    <span class="badge rounded-pill bg-light text-muted border"
                                                          style="font-size: 0.65rem;">
                                                        <i class="fa fa-cube me-1 opacity-50" title="Chưa đóng"></i>Chưa đóng
                                                    </span>
                                                </div>
                                            </td>
                                        </tr>
                                    </t>
                                </t>

                                <t t-if="so.real_delivery_status == 'full'">
                                    <tr><td colspan="2" class="text-center text-success py-2 fw-bold">
                                        <i class="fa fa-star me-1"></i> Đã giao đủ toàn bộ
                                    </td></tr>
                                </t>
                                <t t-elif="so.stock_status == 'ready'">
                                    <tr><td colspan="2" class="text-center text-primary py-2 fw-bold">
                                        <i class="fa fa-check-circle me-1"></i> Sẵn sàng xuất kho đủ hàng
                                    </td></tr>
                                </t>
                                <t t-elif="so.stock_status == 'partial_ready'">
                                    <tr><td colspan="2" class="text-center text-warning py-2 fw-bold">
                                        <i class="fa fa-exclamation-circle me-1"></i> Đã có hàng 1 phần
                                    </td></tr>
                                </t>
                                <t t-elif="so.stock_status == 'out_of_stock'">
                                    <tr><td colspan="2" class="text-center text-danger py-2 fw-bold">
                                        <i class="fa fa-times-circle me-1"></i> Hết hàng
                                    </td></tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div><!-- /card-body -->

            <!-- Footer thẻ -->
            <div class="card-footer border-top d-flex justify-content-between align-items-center p-3 text-bg-light">
                <div class="text-muted small"><i class="fa fa-money me-1"></i> Tổng giá trị đơn:</div>
                <div class="fw-bold text-primary fs-5">
                    <t t-esc="this.formatCurrency(so.amount_total)"/>
                </div>
            </div>
        </div>
    </t>

    <!-- ================================================================
         Picking Node - Luồng TRẢ HÀNG (biến `picking` từ t-foreach cha)
         ================================================================ -->
    <t t-name="hlv_sale_delivery_planning.PickingNodeReturn">
        <div class="card shadow-sm border border-2 cursor-pointer text-center p-2 rounded picking-node"
             style="min-width: 140px; transition: all 0.3s ease;"
             t-attf-class="{{ picking.state == 'done' ? 'bg-light opacity-75 border-secondary' : 'bg-white border-danger' }} {{ picking.return_of ? 'linked-return-' + picking.return_of.split('/').join('-') : '' }}"
             t-att-data-picking-name="picking.name.split('/').join('-')"
             t-on-mouseenter="() => this.onPickingHover(picking.name)"
             t-on-mouseleave="() => this.onPickingLeave()"
             t-on-click="() => this.openPicking(picking.id)">

            <span t-if="picking.link_color"
                  class="position-absolute top-0 start-0 translate-middle badge rounded-pill border border-light shadow-sm"
                  t-attf-class="bg-{{picking.link_color}}" style="font-size: 0.65rem; z-index: 5;">
                <t t-if="picking.return_of or picking.backorder_of">
                    <i class="fa fa-link" title="Liên kết"></i>
                    Trả của: <t t-if="picking.parent_seq">[<t t-esc="picking.parent_seq"/>]</t>
                </t>
                <t t-else=""><i class="fa fa-link" title="Gốc"></i> Gốc</t>
            </span>

            <div class="small fw-bold text-truncate mb-1"
                 t-att-class="picking.state == 'done' ? 'text-secondary' : 'text-danger'">
                <span t-if="picking.global_seq > 0" class="badge bg-secondary me-1"
                      title="Thứ tự thời gian"><t t-esc="picking.global_seq"/></span>
                <t t-esc="picking.type_name"/>
            </div>
            <span class="badge w-100 mb-1" t-att-class="this.getPickingStatusBadgeClass(picking.state)">
                <t t-esc="this.translatePickingStatus(picking.state)"/>
            </span>
            <div class="small fw-bold"
                 t-att-class="picking.state == 'done' ? 'text-muted' : 'text-dark'">
                <t t-esc="picking.name"/>
            </div>

            <div t-if="picking.return_of" class="text-danger mt-1 text-truncate"
                 style="font-size: 0.70rem;"
                 t-att-title="'Lấy lại từ: ' + picking.return_of">
                <i class="fa fa-undo" title="Lấy lại"></i> Từ: <t t-esc="picking.return_of"/>
            </div>
            <div t-if="picking.backorder_of" class="text-muted mt-1 text-truncate"
                 style="font-size: 0.70rem;"
                 t-att-title="'Cắt từ: ' + picking.backorder_of">
                <i class="fa fa-files-o"></i> Cắt từ: <t t-esc="picking.backorder_of"/>
            </div>

            <div t-if="picking.videos and picking.videos.length > 0"
                 class="mt-1 d-flex flex-wrap justify-content-center gap-1">
                <t t-foreach="picking.videos" t-as="video" t-key="video.id">
                    <span class="badge bg-danger rounded-pill cursor-pointer"
                          t-on-click.stop="() => this.openVideo(video.url)"
                          title="Xem Camera Đóng Gói / Trả hàng">
                        <i class="fa fa-play-circle"></i> Cam
                    </span>
                </t>
            </div>
        </div>
    </t>

    <!-- ================================================================
         Picking Node - Luồng XUẤT HÀNG (biến `picking` từ t-foreach cha)
         ================================================================ -->
    <t t-name="hlv_sale_delivery_planning.PickingNodeOutbound">
        <div class="card shadow-sm border border-2 cursor-pointer text-center p-2 rounded picking-node"
             style="min-width: 140px; transition: all 0.3s ease;"
             t-attf-class="{{ picking.state == 'done' ? 'bg-light opacity-75 border-secondary' : 'bg-white border-primary' }} {{ 'original-picking-' + picking.name.split('/').join('-') }}"
             t-att-data-picking-name="picking.name.split('/').join('-')"
             t-on-mouseenter="() => this.onPickingHover(picking.name)"
             t-on-mouseleave="() => this.onPickingLeave()"
             t-on-click="() => this.openPicking(picking.id)">

            <span t-if="picking.link_color"
                  class="position-absolute top-0 start-0 translate-middle badge rounded-pill border border-light shadow-sm"
                  t-attf-class="bg-{{picking.link_color}}" style="font-size: 0.65rem; z-index: 5;">
                <t t-if="picking.return_of or picking.backorder_of">
                    <i class="fa fa-link" title="Liên kết"></i>
                    <t t-if="picking.parent_seq">[<t t-esc="picking.parent_seq"/>]</t>
                </t>
                <t t-else=""><i class="fa fa-link" title="Trả hàng"></i> Trả</t>
            </span>

            <div class="small fw-bold text-truncate mb-1"
                 t-att-class="{
                     'text-secondary': picking.state == 'done',
                     'text-primary': picking.state != 'done'
                 }">
                <span t-if="picking.global_seq > 0" class="badge bg-info text-white me-1"
                      title="Thứ tự thời gian"><t t-esc="picking.global_seq"/></span>
                <t t-esc="picking.type_name"/>
            </div>
            <span class="badge w-100 mb-1" t-att-class="this.getPickingStatusBadgeClass(picking.state)">
                <t t-esc="this.translatePickingStatus(picking.state)"/>
            </span>
            <div class="small fw-bold"
                 t-att-class="picking.state == 'done' ? 'text-muted' : 'text-dark'">
                <t t-esc="picking.name"/>
            </div>

            <div t-if="picking.backorder_of" class="text-muted mt-1 text-truncate"
                 style="font-size: 0.70rem;"
                 t-att-title="'Cắt từ: ' + picking.backorder_of">
                <i class="fa fa-files-o"></i> Cắt từ: <t t-esc="picking.backorder_of"/>
            </div>

            <div t-if="picking.videos and picking.videos.length > 0"
                 class="mt-1 d-flex flex-wrap justify-content-center gap-1">
                <t t-foreach="picking.videos" t-as="video" t-key="video.id">
                    <span class="badge bg-danger rounded-pill cursor-pointer"
                          t-on-click.stop="() => this.openVideo(video.url)"
                          title="Xem Camera Đóng Gói">
                        <i class="fa fa-play-circle"></i> Cam
                    </span>
                </t>
