<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ================================================================
         Kanban Board Template
         - Hiển thị đơn hàng theo dạng cột phân nhóm (kanban)
         - Có thể kéo thả (DnD) để sắp xếp ưu tiên hoặc chuyển trạng thái
         - Chuyển phân nhóm: tiến độ giao / tình trạng kho / đóng gói
         ================================================================ -->
    <t t-name="hlv_sale_delivery_planning.KanbanBoard">

        <!-- ── Thanh chọn phân nhóm ───────────────────────────────────── -->
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3 p-3 bg-white rounded shadow-sm border">
            <div class="d-flex align-items-center gap-2">
                <i class="fa fa-th-large text-primary" title="Kanban"></i>
                <span class="text-muted small fw-bold text-uppercase">Phân nhóm theo:</span>
            </div>

            <div class="btn-group btn-group-sm ms-1" role="group" aria-label="Kanban group by">
                <button class="btn"
                        t-att-class="state.kanbanGroupBy === 'packing_status' ? 'btn-info' : 'btn-outline-info'"
                        t-on-click="() => this.setKanbanGroupBy('packing_status')">
                    <i class="fa fa-cube me-1" title="Đóng gói"/>
                    Đóng gói
                </button>
                <button class="btn"
                        t-att-class="state.kanbanGroupBy === 'delivery_status' ? 'btn-primary' : 'btn-outline-primary'"
                        t-on-click="() => this.setKanbanGroupBy('delivery_status')">
                    <i class="fa fa-truck me-1" title="Tiến độ giao"/>
                    Tiến độ giao
                </button>
                <button class="btn"
                        t-att-class="state.kanbanGroupBy === 'stock_status' ? 'btn-warning' : 'btn-outline-warning'"
                        t-on-click="() => this.setKanbanGroupBy('stock_status')">
                    <i class="fa fa-cubes me-1" title="Tình trạng kho"/>
                    Tình trạng kho
                </button>
            </div>

            <div class="ms-auto d-flex align-items-center gap-3"
                 t-on-click="() => { this.closeSelectedPickingPrintMenu(); }">
                <!-- Print Button -->
                <button class="btn btn-sm"
                        t-att-class="this.selectedCount > 0 ? 'btn-success' : 'btn-outline-secondary'"
                        t-att-disabled="this.selectedCount === 0 || state.isLoading"
                        t-on-click="(ev) => this.toggleSelectedPickingPrintMenu(ev)"
                        title="In phiếu lấy hàng cho các đơn đã chọn">
                    <i class="fa fa-print me-1" title="In phiếu"></i>
                    In phiếu lấy hàng
                    <span t-if="this.selectedCount > 0" class="badge bg-white text-success ms-1">
                        <t t-esc="this.selectedCount"/>
                    </span>
                </button>
                <div t-if="state.selectedPrintMenuPos"
                     class="bg-white border rounded shadow-lg"
                     style="position:fixed; z-index:2000; min-width:260px; max-height:340px; overflow-y:auto;"
                     t-att-style="'position:fixed; z-index:2000; min-width:260px; max-height:340px; overflow-y:auto; top:' + state.selectedPrintMenuPos.top + 'px; right:' + state.selectedPrintMenuPos.right + 'px;'"
                     t-on-click.stop="">
                    <div class="px-3 py-2 bg-light border-bottom small fw-bold text-muted">
                        <i class="fa fa-print me-1"></i> Chọn mẫu in
                    </div>
                    <t t-foreach="state.pickingReports" t-as="report" t-key="report.id">
                        <div class="px-3 py-2 small cursor-pointer"
                             style="border-bottom:1px solid #f3f3f3;"
                             t-on-click="(ev) => this.printSelectedPickingSlips(report.id, report.report_type)">
                            <i class="fa fa-file-pdf-o me-2 text-danger"
                               t-if="report.report_type === 'qweb-pdf'"></i>
                            <i class="fa fa-file-excel-o me-2 text-success"
                               t-elif="report.report_type === 'xlsx'"></i>
                            <i class="fa fa-file-o me-2 text-muted" t-else=""></i>
                            <t t-esc="report.name"/>
                        </div>
                    </t>
                    <div t-if="!state.pickingReports.length"
                         class="px-3 py-2 text-muted small">Không có mẫu in</div>
                </div>
                <!-- Tạo phiếu luân chuyển -->
                <button class="btn btn-sm"
                        t-att-class="this.selectedCount > 0 ? 'btn-warning' : 'btn-outline-secondary'"
                        t-att-disabled="this.selectedCount === 0 || state.isLoading"
                        t-on-click="openTransferModal"
                        title="Tạo phiếu luân chuyển từ các đơn đã chọn">
                    <i class="fa fa-exchange me-1" title="Luân chuyển"></i>
                    Tạo phiếu luân chuyển
                    <span t-if="this.selectedCount > 0" class="badge bg-white text-warning ms-1">
                        <t t-esc="this.selectedCount"/>
                    </span>
                </button>
                <!-- Chuyển vị trí -->
                <button class="btn btn-sm"
                        t-att-class="this.selectedCount > 0 ? 'btn-info' : 'btn-outline-secondary'"
                        t-att-disabled="this.selectedCount === 0 || state.isLoading"
                        t-on-click="openRelocationModal"
                        title="Chuyển vị trí sản phẩm gần khu đóng gói">
                    <i class="fa fa-arrows me-1" title="Chuyển vị trí"></i>
                    Chuyển vị trí
                    <span t-if="this.selectedCount > 0" class="badge bg-white text-info ms-1">
                        <t t-esc="this.selectedCount"/>
                    </span>
                </button>
                <button t-if="this.hasMoreKanbanData"
                        class="btn btn-sm btn-outline-primary"
                        t-on-click="loadMoreKanbanBatch"
                        t-att-disabled="state.isLoading">
                    <i class="fa fa-plus me-1" title="Tải thêm"></i>
                    Tải thêm 100
                </button>
                <span class="text-muted small">
                    <i class="fa fa-arrows text-secondary me-1" title="Kéo thả"/>
                    Màu sắc: Đã giao (Xanh dương) - đủ hàng (Xanh lá) - Mới (đỏ Cam)
                </span>
                <span class="badge bg-secondary rounded-pill" title="Số đơn đang tải / tổng số đơn">
                    <i class="fa fa-database me-1"></i>
                    <t t-esc="state.saleOrders.length"/> / <t t-esc="state.totalCount"/> đơn hàng
                    <t t-if="state.saleOrders.length &lt; state.totalCount">
                        <span class="ms-1 text-warning fw-bold">(chưa tải hết)</span>
                    </t>
                </span>
            </div>
        </div>

        <!-- ── Bảng Kanban (cuộn ngang) ───────────────────────────────── -->
        <div class="hlv-kanban-board d-flex gap-3 overflow-auto pb-4 pt-1 pe-2">
            <t t-foreach="this.kanbanColumnDefs" t-as="col" t-key="col.value">

                <div class="hlv-kanban-column kanban-custom-width d-flex flex-column flex-grow-1"
                    style="width: 350px;"
                     t-att-data-col="col.value"
                     t-on-dragover="(ev) => this.onDragOver(ev, col.value)"
                     t-on-dragleave="(ev) => this.onDragLeave(ev)"
                     t-on-drop="(ev) => this.onDrop(ev, col.value)"
                     t-att-class="state.dragOverColumn === col.value ? 'drag-over' : ''">

                    <!-- Column Header -->
                    <div class="hlv-kanban-col-header rounded-top px-3 py-2 mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <!-- Select All Checkbox -->
                            <input type="checkbox"
                                   class="form-check-input"
                                   style="cursor: pointer;"
                                   t-att-checked="this.allSelectedInColumn[col.value]"
                                   t-on-click.stop="() => this.allSelectedInColumn[col.value] ? this.deselectAllInColumn(col.value) : this.selectAllInColumn(col.value)"
                                   title="Chọn/Bỏ chọn tất cả trong cột này"/>
                            <span class="badge rounded-pill fs-6 fw-bold"
                                  t-att-class="col.badgeClass">
                                <t t-esc="this.totalInColumn(col.value)"/>
                            </span>
                            <span class="fw-bold small text-uppercase"
                                  t-att-class="col.textClass">
                                <t t-esc="col.label"/>
                            </span>
                            <i t-att-class="col.iconClass + ' ms-auto opacity-50'"
                               t-att-title="col.label"></i>
                        </div>
                        <div class="progress mt-2" style="height: 3px;" t-if="state.totalCount > 0">
                            <div class="progress-bar"
                                 t-att-class="col.progressClass"
                                 role="progressbar"
                                 t-att-style="'width:' + (this.totalInColumn(col.value) / state.totalCount * 100) + '%'">
                            </div>
                        </div>
                    </div>

                    <!-- Cards container -->
                    <div class="hlv-kanban-col-body flex-grow-1 rounded-bottom px-2 py-2">

                        <!-- Empty state -->
                        <div t-if="!this.totalInColumn(col.value)"
                             class="hlv-kanban-empty text-center text-muted py-5">
                            <i class="fa fa-inbox fa-2x d-block mb-2 opacity-25" title="Không có đơn hàng"></i>
                            <small>Không có đơn hàng</small>
                        </div>

                        <!-- SO Cards -->
                        <t t-foreach="this.ordersForColumn(col.value)" t-as="so" t-key="so.id">
                            <div class="hlv-kanban-card mb-2"
                                 draggable="true"
                                 t-att-data-so-id="so.id"
                                 t-att-class="{'is-dragging': state.draggedSoId === so.id}"
                                 t-on-dragstart="(ev) => this.onDragStart(ev, so.id)"
                                 t-on-dragend="() => this.onDragEnd()">
                                <t t-call="hlv_sale_delivery_planning.KanbanSOCard"/>
                            </div>
                        </t>

                        <!-- Tải thêm -->
                        <div t-if="this.hasMoreInColumn(col.value)" class="text-center pt-1 pb-2">
                            <button class="btn btn-sm btn-outline-secondary w-100"
                                    style="border-style: dashed; font-size: 0.75rem;"
                                    t-on-click="() => this.loadMoreColumn(col.value)">
                                <i class="fa fa-chevron-down me-1" title="Tải thêm"></i>
                                Tải thêm
                                (<t t-esc="this.totalInColumn(col.value) - (state.kanbanColPageSize[col.value] || 15)"/> còn lại)
                            </button>
                        </div>

                    </div>
                </div>

            </t>
        </div>

        <!-- ── Cột "Trả hàng / Dừng" (chỉ hiện khi bật "Hiện đơn đã giao") ─────── -->
        <t t-if="state.showCompleted and this.returnedOrders.length > 0">
        <div class="hlv-kanban-board d-flex gap-3 overflow-auto pb-4 pt-1 pe-2">
            <div class="hlv-kanban-column d-flex flex-column flex-grow-1 flex-shrink-1">

                <!-- Column Header -->
                <div class="hlv-kanban-col-header rounded-top px-3 py-2 mb-2" style="background: #fff0f0; border-color: #dc3545;">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge rounded-pill fs-6 fw-bold bg-danger">
                            <t t-esc="this.returnedOrders.length"/>
                        </span>
                        <span class="fw-bold small text-uppercase text-danger">
                            Trả hàng / Dừng
                        </span>
                        <i class="fa fa-undo ms-auto opacity-50 text-danger" title="Trả hàng / Dừng"></i>
                    </div>
                    <div class="text-muted mt-1" style="font-size:0.7rem;">
                        Đơn đã trả hàng hoặc đã dừng xử lý, không còn phiếu lấy/đóng/xuất nào active
                    </div>
                </div>

                <!-- Cards -->
                <div class="hlv-kanban-col-body flex-grow-1 rounded-bottom px-2 py-2">
                    <t t-foreach="this.returnedOrdersPaged" t-as="so" t-key="so.id">
                        <div class="hlv-kanban-card mb-2">
                            <t t-call="hlv_sale_delivery_planning.KanbanSOCard"/>
                        </div>
                    </t>

                    <div t-if="this.hasMoreReturnedOrders" class="text-center pt-1 pb-2">
                        <button class="btn btn-sm btn-outline-danger w-100"
                                style="border-style: dashed; font-size: 0.75rem;"
                                t-on-click="loadMoreReturnedOrders">
                            <i class="fa fa-chevron-down me-1" title="Tải thêm"></i>
                            Tải thêm
                            (<t t-esc="this.returnedOrders.length - state.returnedColPageSize"/> còn lại)
                        </button>
                    </div>
                </div>

            </div>
        </div>
        </t>

    </t>

    <!-- ================================================================
         KanbanSOCard – thẻ SO nhỏ gọn dùng trong Kanban
         Nhận biến `so` từ t-foreach cha (context được chia sẻ qua t-call)
         ================================================================ -->
    <t t-name="hlv_sale_delivery_planning.KanbanSOCard">
        <div class="card border-1 shadow-sm hlv-kanban-card-inner position-relative overflow-hidden"
             t-att-class="this.getSOCardColorClass(so)"
             t-att-style="so.has_delivered_today ? 'background:#62b1ff30;' : so.stock_status === 'ready' ? 'background:#21c22f17;' : so.is_new_order ? 'background:#e77d191c;' : ''">

            <!-- Ribbon "Đã in phiếu" / "Có phiếu chưa in" -->
            <div t-if="so.has_new_unprinted_pickings"
                 class="position-absolute bg-danger text-center fw-bold"
                 style="font-size:0.55rem; padding:1px 20px; color: #fff ;top:8px; right:-22px; transform:rotate(45deg); z-index:2; letter-spacing:0.5px; box-shadow: 0 1px 3px rgba(0,0,0,.2);">
                <i class="fa fa-exclamation-circle me-1"></i>Chưa in
            </div>
            <div t-elif="so.picking_slip_printed"
                 class="position-absolute bg-success  text-center fw-bold"
                 style="font-size:0.55rem; padding:1px 20px; top:8px; color: #fff ;right:-22px; transform:rotate(45deg); z-index:2; letter-spacing:0.5px; box-shadow: 0 1px 3px rgba(0,0,0,.2);">
                <i class="fa fa-print me-1"></i>Đã in
            </div>

            <div class="card-body p-2">

                <!-- Checkbox for selection -->
                <div class="d-flex align-items-center mb-2">
                    <input type="checkbox"
                           class="form-check-input me-2"
                           style="cursor: pointer;"
                           t-att-checked="this.isSOSelected(so.id)"
                           t-on-click.stop="() => this.toggleSOSelection(so.id)"
                           title="Chọn để in phiếu lấy hàng"/>
                    <span class="text-muted small" style="font-size: 0.7rem;">
                        Chọn để in
                    </span>
                </div>

                <!-- Row 1: SO Name + Quick View -->
                <div class="d-flex justify-content-between align-items-start mb-1 gap-1">
                    <h6 class="card-title mb-0 cursor-pointer o_form_uri fw-bold lh-sm"
                        t-att-style="'font-size: 0.82rem;' + (so.is_new_order ? 'color:#d63384;' : '')"
                        t-att-class="so.is_new_order ? 'text-decoration-none' : 'text-primary'"
                        t-on-click.stop="() => this.openSaleOrder(so.id)">
                        <i class="fa fa-shopping-cart me-1" style="font-size:0.7rem;"
                           t-att-class="so.is_new_order ? 'text-danger' : 'text-muted'" title="Đơn hàng"></i>
                        <t t-esc="so.name"/>
                        <small t-if="so.misa_order_date" class="text-muted fw-normal" style="font-size:0.65rem;">
                            (<t t-esc="so.misa_order_date"/>)
                        </small>
                        <span t-if="so.is_new_order" class="badge bg-danger ms-1 animate__animated animate__pulse" style="font-size:0.58rem; vertical-align:middle; padding:2px 6px; letter-spacing:0.5px;">★ MỚI</span>
                        
                        <!-- Notification badge (lớn hơn) -->
                        <span t-if="so.has_unread_message" 
                              class="badge bg-danger ms-1 animate__animated animate__pulse animate__infinite"
                              style="vertical-align: middle; padding: 3px 6px; font-size: 0.65rem;" 
                              title="Có tin nhắn mới từ khách hàng/shipper">
                              <i class="fa fa-envelope me-1"></i> TIN MỚI
                        </span>
                    </h6>
                    <button class="btn btn-link btn-sm p-0 ms-1 text-secondary flex-shrink-0"
                            style="font-size: 0.75rem; line-height:1;"
                            title="Xem tổng quan"
                            t-on-click.stop="() => this.openOverviewDrawer(so)">
                        <i class="fa fa-eye" title="Tổng quan"></i>
                    </button>
                </div>

                <!-- Row 2: Customer -->
                <div class="text-muted mb-1" style="font-size: 0.74rem;">
                    <i class="fa fa-user me-1 text-info" title="Khách hàng"></i>
                    <t t-esc="so.partner_id ? so.partner_id[1] : ''"/>
                </div>

                <!-- Row 3: Status Badges -->
                <div class="d-flex flex-wrap gap-1 mb-1">
                    <span class="badge"
                          style="font-size: 0.62rem; padding: 2px 5px;"
                          t-att-class="this.getDeliveryStatusBadgeClass(so.real_delivery_status)">
                        <t t-esc="this.translateDeliveryStatus(so.real_delivery_status)"/>
                    </span>
                    <span class="badge"
                          style="font-size: 0.62rem; padding: 2px 5px;"
                          t-att-class="this.getStockStatusBadgeClass(so.stock_status)"
                          t-if="so.stock_status and so.real_delivery_status !== 'full'">
                        <t t-esc="this.translateStockStatus(so.stock_status)"/>
                    </span>
                    <span class="badge"
                          style="font-size: 0.62rem; padding: 2px 5px;"
                          t-att-class="this.getPackingStatusBadgeClass(so.packing_status)"
                          t-if="so.packing_status and so.packing_status !== 'unknown' and so.real_delivery_status !== 'full'">
                        <i class="fa fa-cube" style="font-size:0.6rem;" title="Đóng gói"></i>
                        <t t-esc="this.translatePackingStatus(so.packing_status)"/>
                    </span>
                </div>

                <!-- Row 4: Date + Amount -->
                <div class="d-flex justify-content-between align-items-center mt-1"
                     style="font-size: 0.72rem;">
                    <div class="d-flex flex-column">
                        <span t-if="so.commitment_date" class="text-danger">
                            <i class="fa fa-calendar me-1" title="Ngày hẹn giao"></i>
                            <t t-esc="so.commitment_date.substring(0, 10)"/>
                        </span>
                        <span t-else="" class="text-muted">
                            <i class="fa fa-calendar-o me-1 opacity-50" title="Không có ngày hẹn"></i>
                            <small>Chưa hẹn</small>
                        </span>
                    </div>
                    <span class="fw-bold text-success">
                        <t t-esc="this.formatCurrency(so.amount_total)"/>
                    </span>
                </div>

                <!-- Row 5: Delivery type + HTGH + Saler code -->
                <div t-if="so.x_studio_delivery_type or so.x_studio_htgh"
                     class="mt-1 pt-1 border-top" style="font-size: 0.68rem;">
                    <span t-if="so.x_studio_delivery_type" class="badge bg-info bg-opacity-25 text-dark me-1" style="font-size:0.62rem;">
                        <i class="fa fa-truck me-1"></i><t t-esc="so.x_studio_delivery_type"/>
                    </span>
                    <span t-if="so.x_studio_htgh" class="text-muted me-1">
                        <i class="fa fa-info-circle me-1"></i><t t-esc="so.x_studio_htgh"/>
                    </span>
                   
                </div>

                  <div t-if="so.x_studio_misa_saler_code" class="mt-1 text-muted" style="font-size:0.68rem; line-height:1.3;">
                   
                    <i class="fa fa-id-badge me-1"></i><t t-esc="so.x_studio_misa_saler_code"/>
                    
                </div>


                <!-- Row 5b: Ghi chú (origin / chứng từ gốc) -->
                <!-- <div t-if="so.origin" class="mt-1 text-muted" style="font-size:0.68rem; line-height:1.3;">
                    <i class="fa fa-sticky-note-o me-1 text-warning"></i><span class="fw-semibold">Ghi chú:</span> <t t-esc="so.origin"/>
                </div> -->

                <!-- Row 6: Shipping address -->
                <div t-if="so.misa_shipping_address" class="mt-1 text-muted" style="font-size:0.68rem; line-height:1.3;">
                    <i class="fa fa-map-marker me-1 text-danger"></i><t t-esc="so.misa_shipping_address"/>
                </div>

                <!-- Row 7: Tags -->
                <div t-if="so.tag_ids and so.tag_ids.length" class="d-flex flex-wrap gap-1 mt-1">
                    <t t-foreach="so.tag_ids" t-as="tag" t-key="tag[0]">
                        <span class="badge" style="font-size:0.58rem;"
                              t-att-style="'font-size:0.58rem;background-color:' + this.getTagColor(tag[2]) + ';color:' + this.getTagTextColor(tag[2])">
                            <t t-esc="tag[1]"/>
                        </span>
                    </t>
                </div>

                <!-- Row 8: Pick pickings + print status -->
                <t t-set="pickPickings" t-value="(so.pickings || []).filter(p =&gt; p.sequence_code &amp;&amp; p.sequence_code.indexOf('PICK') &gt;= 0 &amp;&amp; !p.return_of_id &amp;&amp; p.state !== 'cancel')"/>
                <div t-if="pickPickings.length" class="mt-1 pt-1 border-top" style="font-size:0.62rem;">
                    <div class="text-muted fw-bold mb-1" style="font-size:0.58rem;"><i class="fa fa-print me-1"></i>Phiếu lấy hàng</div>
                    <div class="d-flex flex-wrap gap-1">
                        <t t-foreach="pickPickings" t-as="pk" t-key="pk.id">
                            <span class="badge d-inline-flex align-items-center gap-1"
                                  t-att-class="pk.printed ? 'bg-success text-white' : 'bg-danger text-white'"
                                  style="font-size:0.6rem; padding:2px 5px;"
                                  t-att-title="pk.name + ' — ' + (pk.printed ? 'Đã in' : 'Chưa in')">
                                <i t-att-class="pk.printed ? 'fa fa-check-circle' : 'fa fa-exclamation-circle'"></i>
                                <t t-esc="pk.name"/>
                            </span>
                        </t>
                    </div>
                </div>

                <!-- Row 8a: Shipper status (outgoing pickings) -->
                <t t-set="outPickings" t-value="(so.pickings || []).filter(p =&gt; p.code === 'outgoing' &amp;&amp; !p.return_of_id &amp;&amp; p.state !== 'cancel')"/>
                <t t-set="receivedOuts" t-value="outPickings.filter(p =&gt; p.shipper_received)"/>
                <div t-if="receivedOuts.length" class="mt-1" style="font-size:0.62rem;">
                    <div class="text-muted fw-bold mb-1" style="font-size:0.58rem;"><i class="fa fa-motorcycle me-1"></i>Phiếu giao hàng</div>
                    <div class="d-flex flex-wrap gap-1">
                        <t t-foreach="receivedOuts" t-as="op" t-key="op.id">
                            <span class="badge bg-success bg-opacity-75 text-white d-inline-flex align-items-center gap-1"
                                  style="font-size:0.6rem; padding:2px 5px;"
                                  t-att-title="op.name + ' — Shipper: ' + (op.shipper_user ? op.shipper_user[1] : '?')">
                                <i class="fa fa-motorcycle"></i>
                                <t t-esc="op.name"/>
                                <t t-if="op.shipper_user"> · <t t-esc="op.shipper_user[1]"/></t>
                            </span>
                        </t>
                    </div>
                </div>

                <!-- Row 8b: Transfer suggestion badge -->
                <div t-if="so.transfer_suggestions and so.transfer_suggestions.length"
                     class="mt-1" style="font-size: 0.68rem;">
                    <span class="badge bg-danger bg-opacity-75 text-white" style="font-size:0.62rem;">
                        <i class="fa fa-exchange me-1"></i>Cần chuyển
                        <t t-esc="so.transfer_suggestions.length"/> SP từ <t t-esc="this.countTransferWarehouses(so)"/> kho khác
                    </span>
                </div>

                <!-- Row 9: POs count + warehouse -->
                <div class="d-flex justify-content-between align-items-center mt-1 pt-1 border-top"
                     style="font-size: 0.68rem;" t-if="so.pos and so.pos.length">
                    <span class="text-muted">
                        <i class="fa fa-cart-arrow-down me-1" title="Đơn mua"></i>
                        <t t-esc="so.pos.length"/> PO liên quan
                    </span>
                    <span class="badge bg-light text-dark border" style="font-size: 0.62rem;"
                          t-if="so.warehouse_name">
                        <i class="fa fa-building-o me-1" title="Kho"></i>
                        <t t-esc="so.warehouse_name"/>
                    </span>
                </div>

            </div>
        </div>
    </t>

</templates>
