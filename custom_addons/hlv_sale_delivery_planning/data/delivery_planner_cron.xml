<?xml version="1.0" encoding="utf-8"?>
<!-- Purpose: scheduled jobs that keep delivery planner snapshots warm outside user requests. -->
<odoo>
    <record id="ir_cron_hlv_delivery_planner_snapshot_refresh" model="ir.cron">
        <field name="name">Delivery Planner: Refresh Dirty Snapshots</field>
        <field name="model_id" ref="model_hlv_delivery_planner_snapshot"/>
        <field name="state">code</field>
        <field name="code">model.cron_refresh_dirty_snapshots(limit=50)</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active">True</field>
    </record>

    <!-- Tự động gửi in phiếu lấy hàng đã giữ đủ hàng. Phải là cron (không phải hook lúc phiếu
         chuyển 'assigned') vì stock.picking.state là field compute+store — ORM ghi nó qua đường
         flush recompute (_write), không qua write(), nên hook ở write() chưa từng chạy. Xem
         models/stock_picking.py:cron_auto_queue_print_when_full. Chỉ quét phiếu của kho ĐÃ gán
         máy in IoT và chưa in, nên kho chưa cấu hình sẽ không bị đẩy rác vào hàng chờ. -->
    <record id="ir_cron_hlv_auto_queue_print_when_full" model="ir.cron">
        <field name="name">Delivery Planner: Tự động gửi in phiếu lấy hàng đủ hàng</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="state">code</field>
        <field name="code">model.cron_auto_queue_print_when_full(limit=50)</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active">True</field>
    </record>

    <!-- Soát máy chủ kho / máy in IoT: gửi cảnh báo khi service ở kho tắt, máy kho mất kết nối,
         hoặc Odoo không kết nối được hộp IoT. Nguồn tín hiệu là heartbeat do script watchdog
         trên chính máy kho gửi về (xem bin/iot_watchdog_windows.ps1 + controllers/iot_watchdog_controller.py). -->
    <record id="ir_cron_hlv_iot_watchdog_check" model="ir.cron">
        <field name="name">Delivery Planner: Giám sát máy chủ kho / máy in IoT</field>
        <field name="model_id" ref="stock.model_stock_warehouse"/>
        <field name="state">code</field>
        <field name="code">model.cron_check_iot_watchdog()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active">True</field>
    </record>
</odoo>
