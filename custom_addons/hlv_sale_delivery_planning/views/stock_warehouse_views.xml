<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_warehouse_form_iot_printer" model="ir.ui.view">
        <field name="name">stock.warehouse.form.iot.printer</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="x_iot_printer_device_id"
                       options="{'no_create': True}"
                       placeholder="Chưa gán máy in IoT cho kho này"/>
            </xpath>
        </field>
    </record>
</odoo>
