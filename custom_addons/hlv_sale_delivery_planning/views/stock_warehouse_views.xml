<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_warehouse_form_iot_printer" model="ir.ui.view">
        <field name="name">stock.warehouse.form.iot.printer</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="x_iot_printer_device_id"
                       options="{'no_create': True}"
                       placeholder="Chưa gán máy in IoT cho kho này"/>
                <field name="x_iot_report_id"
                       options="{'no_create': True}"
                       placeholder="Mặc định (Hoạt động lấy hàng TSN)"/>
                <field name="x_iot_queue_limit" placeholder="0 = không giới hạn"/>
                <!-- Chỉ đọc: do script watchdog trên máy chủ kho ghi về qua
                     /api/iot_watchdog/heartbeat (xem bin/iot_watchdog_windows.ps1). Hiện ở đây
                     để admin/kho tự kiểm tra được máy kho còn sống hay không, không phải mò log. -->
                <field name="x_iot_watchdog_last_seen" readonly="1"
                       placeholder="Chưa cài watchdog cho kho này"/>
                <field name="x_iot_watchdog_service_ok" readonly="1"
                       invisible="not x_iot_watchdog_last_seen"/>
                <field name="x_iot_watchdog_note" readonly="1"
                       invisible="not x_iot_watchdog_last_seen"/>
            </xpath>
        </field>
    </record>
</odoo>
