<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_delivery_planner_dashboard" model="ir.actions.client">
        <field name="name">Delivery Planner</field>
        <field name="tag">hlv_sale_delivery_planning.dashboard</field>
        <field name="target">main</field>
    </record>

    <record id="action_packing_kpi_dashboard" model="ir.actions.client">
        <field name="name">KPI Đóng Hàng</field>
        <field name="tag">hlv_sale_delivery_planning.packing_kpi</field>
        <field name="target">main</field>
    </record>

    <menuitem id="menu_delivery_planner_root"
              name="Điều phối Giao hàng"
              parent="sale.sale_order_menu"
              sequence="15"/>

    <menuitem id="menu_delivery_planner"
              name="Dashboard Giao Hàng"
              action="action_delivery_planner_dashboard"
              parent="menu_delivery_planner_root"
              sequence="10"/>

    <menuitem id="menu_packing_kpi"
              name="KPI Đóng Hàng"
              action="action_packing_kpi_dashboard"
              parent="menu_delivery_planner_root"
              sequence="20"/>

    <!-- Thêm cột + filter "Cần hủy" vào danh sách đơn bán -->
    <record id="view_sale_order_tree_need_cancel" model="ir.ui.view">
        <field name="name">sale.order.tree.need.cancel</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="x_plan_need_cancel" string="Cần hủy" widget="boolean_toggle" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_sale_order_search_need_cancel" model="ir.ui.view">
        <field name="name">sale.order.search.need.cancel</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[last()]" position="after">
                <separator/>
                <filter string="Cần hủy (báo cáo)" name="need_cancel"
                        domain="[('x_plan_need_cancel', '=', True)]"/>
                <separator/>
                <field name="tag_ids" string="Tags"/>
            </xpath>
        </field>
    </record>
</odoo>
