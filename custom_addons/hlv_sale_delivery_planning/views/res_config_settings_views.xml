<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_delivery_planner_pack" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.delivery.planner.pack</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="HLV Delivery Planner" string="HLV Delivery Planner" name="hlv_sale_delivery_planning">
                    <block title="Đóng gói" name="hlv_delivery_planner_pack_settings">
                        <setting string="Chỉ người được assign mới được đóng gói"
                                 help="Khi bật, người không được chọn lúc in phiếu lấy hàng sẽ không vào/validate được phiếu PACK. Quản lý kho và admin được bỏ qua.">
                            <field name="restrict_pack_to_assigned_user"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
