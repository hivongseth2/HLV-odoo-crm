<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_delivery_procedure_partner_list" model="ir.ui.view">
        <field name="name">hlv.delivery.procedure.partner.list</field>
        <field name="model">hlv.delivery.procedure.partner</field>
        <field name="arch" type="xml">
            <list string="Khách cần xác nhận thủ tục" editable="bottom">
                <field name="partner_id"/>
                <field name="note"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_delivery_procedure_partner_form" model="ir.ui.view">
        <field name="name">hlv.delivery.procedure.partner.form</field>
        <field name="model">hlv.delivery.procedure.partner</field>
        <field name="arch" type="xml">
            <form string="Khách cần xác nhận thủ tục">
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="note"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_delivery_procedure_partner_search" model="ir.ui.view">
        <field name="name">hlv.delivery.procedure.partner.search</field>
        <field name="model">hlv.delivery.procedure.partner</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <filter string="Đang áp dụng" name="active" domain="[('active', '=', True)]"/>
                <filter string="Đã tắt" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_delivery_procedure_partner" model="ir.actions.act_window">
        <field name="name">Khách cần xác nhận thủ tục trước khi giao</field>
        <field name="res_model">hlv.delivery.procedure.partner</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_delivery_procedure_partner_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Thêm khách hàng cần xác nhận thủ tục</p>
            <p>
                Đơn của những khách trong danh sách này sẽ hiện ô tick
                "Đã hoàn tất thủ tục sẵn sàng giao" trên trang /sale_plan và trang
                Điều phối Giao hàng. Chọn liên hệ gốc (công ty) — mọi liên hệ con
                thuộc công ty đó đều được áp dụng.
            </p>
        </field>
    </record>

    <menuitem id="menu_delivery_procedure_partner"
              name="Khách cần xác nhận thủ tục"
              action="action_delivery_procedure_partner"
              parent="sale.sale_order_menu"
              sequence="18"/>

    <!-- Cột theo dõi trên danh sách đơn bán -->
    <record id="view_sale_order_tree_procedure_done" model="ir.ui.view">
        <field name="name">sale.order.tree.procedure.done</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="x_plan_procedure_done" string="Xong thủ tục"
                       widget="boolean_toggle" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
