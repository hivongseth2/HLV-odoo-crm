<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_delivery_planner_packer" model="ir.ui.view">
        <field name="name">res.users.form.delivery.planner.packer</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="x_packer_name" string="Tên người đóng"/>
                <field name="x_sale_plan_mention_names" string="Sale Plan mention aliases" placeholder="thanhnhan, thanhluan"/>
                <field name="x_handle_unassigned_saler_orders" string="Xử lý đơn không có mã sale MISA (VD: Shopee)"/>
            </xpath>
        </field>
    </record>
</odoo>
