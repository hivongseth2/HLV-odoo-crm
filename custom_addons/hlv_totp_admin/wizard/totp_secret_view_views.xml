<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hlv_totp_secret_view_form" model="ir.ui.view">
        <field name="name">hlv.totp.secret.view.form</field>
        <field name="model">hlv.totp.secret.view</field>
        <field name="arch" type="xml">
            <form string="Khoá 2FA" create="false" edit="false">
                <group>
                    <field name="user_id"/>
                    <field name="code" class="fs-3 fw-bold"/>
                    <field name="secret"/>
                    <field name="qrcode" widget="image" options="{'size': [220, 220]}"/>
                </group>
                <div class="text-muted">
                    Quét QR (hoặc nhập khoá) vào app authenticator. Khoá này đăng nhập thay được nhân viên:
                    mỗi lần xem đều được ghi vào chatter của tài khoản.
                </div>
                <footer>
                    <button string="Đọc lại mã" name="action_refresh_code" type="object" class="btn-secondary"/>
                    <button string="Đóng" special="cancel" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
