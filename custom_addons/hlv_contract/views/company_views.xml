<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View riêng trên res.company (mode primary), không inherit form công ty của core -->
    <record id="view_hlv_contract_company_seller_form" model="ir.ui.view">
        <field name="name">res.company.hlv.contract.seller</field>
        <field name="model">res.company</field>
        <field name="mode">primary</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Thông tin bên bán" create="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <span class="text-muted small">Công ty</span>
                        <h2><field name="name" readonly="1"/></h2>
                    </div>
                    <group>
                        <group string="Bên bán in trên hợp đồng">
                            <field name="contract_seller_name" placeholder="Để trống sẽ dùng tên công ty"/>
                            <field name="contract_seller_address"/>
                            <field name="contract_seller_phone"/>
                            <field name="contract_seller_vat"/>
                            <field name="contract_seller_representative"/>
                            <field name="contract_seller_position"/>
                        </group>
                        <group string="Thanh toán &amp; mặc định">
                            <field name="contract_seller_bank_account"/>
                            <field name="contract_seller_bank_name"/>
                            <field name="contract_court"/>
                            <field name="contract_vat_rate"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Server action để mở đúng công ty đang chọn (act_window tĩnh không gán res_id động được) -->
    <record id="action_hlv_contract_company_seller" model="ir.actions.server">
        <field name="name">Thông tin bên bán</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="state">code</field>
        <field name="groups_id" eval="[(4, ref('group_contract_manager'))]"/>
        <field name="code">action = {
    'type': 'ir.actions.act_window',
    'name': 'Thông tin bên bán',
    'res_model': 'res.company',
    'res_id': env.company.id,
    'view_mode': 'form',
    'views': [(env.ref('hlv_contract.view_hlv_contract_company_seller_form').id, 'form')],
    'target': 'current',
}</field>
    </record>
</odoo>
