<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hlv_contract_list" model="ir.ui.view">
        <field name="name">hlv.contract.list</field>
        <field name="model">hlv.contract</field>
        <field name="arch" type="xml">
            <list string="Hợp đồng" class="o_hlv_contract_list"
                  decoration-muted="state == 'cancel'" decoration-success="state == 'signed'"
                  decoration-info="state == 'confirmed'">
                <field name="name" class="fw-bold"/>
                <field name="contract_date"/>
                <field name="contract_type"/>
                <field name="buyer_name"/>
                <field name="buyer_vat" optional="hide"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="template_id" optional="hide"/>
                <field name="expiry_date" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount_total" sum="Tổng" widget="monetary"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'confirmed'" decoration-success="state == 'signed'"
                       decoration-muted="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_hlv_contract_form" model="ir.ui.view">
        <field name="name">hlv.contract.form</field>
        <field name="model">hlv.contract</field>
        <field name="arch" type="xml">
            <form string="Hợp đồng" class="o_hlv_contract_form">
                <header>
                    <button name="action_preview" type="object" string="Xem nhanh" class="btn-primary" icon="fa-eye"/>
                    <button name="action_open_export" type="object" string="Xuất / In" icon="fa-download"/>
                    <button name="action_confirm" type="object" string="Xác nhận" invisible="state != 'draft'"/>
                    <button name="action_sign" type="object" string="Đã ký" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" type="object" string="Huỷ" invisible="state == 'cancel'"
                            groups="hlv_contract.group_contract_manager"
                            confirm="Huỷ hợp đồng này?"/>
                    <button name="action_draft" type="object" string="Về nháp" invisible="state != 'cancel'"
                            groups="hlv_contract.group_contract_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,signed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="text-muted small">Số hợp đồng</span>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Hợp đồng">
                            <field name="contract_type" readonly="state != 'draft'"/>
                            <field name="template_id" readonly="state != 'draft'"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="contract_date" readonly="state != 'draft'"/>
                            <field name="expiry_date" invisible="contract_type != 'principle'"
                                   readonly="state != 'draft'"/>
                            <field name="user_id" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Bên mua">
                            <field name="partner_id" readonly="state != 'draft'"
                                   options="{'no_create': True}"
                                   placeholder="Chọn khách để điền nhanh..."/>
                            <field name="buyer_name" readonly="state != 'draft'"/>
                            <field name="buyer_address" readonly="state != 'draft'"/>
                            <field name="buyer_vat" readonly="state != 'draft'"/>
                            <field name="buyer_phone" readonly="state != 'draft'"/>
                            <field name="buyer_fax" readonly="state != 'draft'"/>
                            <field name="buyer_representative" readonly="state != 'draft'"/>
                            <field name="buyer_position" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Hàng hoá" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_name"/>
                                    <field name="uom"/>
                                    <field name="quantity"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="price_unit" widget="monetary"/>
                                    <field name="subtotal" widget="monetary"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="currency_id" invisible="1"/>
                                <field name="amount_untaxed"/>
                                <label for="vat_rate" string="Thuế VAT (%)"/>
                                <div class="o_row">
                                    <field name="vat_rate" readonly="state != 'draft'" class="oe_inline"/>
                                    <field name="amount_vat" class="oe_inline"/>
                                </div>
                                <field name="amount_total" class="oe_subtotal_footer_separator"/>
                            </group>
                            <div class="o_hlv_contract_words">
                                <span class="text-muted">Bằng chữ: </span><field name="amount_words" class="fst-italic"/>
                            </div>
                        </page>
                        <page string="Điều khoản" name="terms">
                            <group>
                                <group string="Giao hàng &amp; thanh toán">
                                    <field name="delivery_time" readonly="state != 'draft'"/>
                                    <field name="delivery_place" readonly="state != 'draft'"/>
                                    <field name="payment_terms" readonly="state != 'draft'"/>
                                </group>
                                <group string="Khác">
                                    <field name="main_product" readonly="state != 'draft'"
                                           invisible="contract_type != 'principle'"/>
                                    <field name="court" readonly="state != 'draft'"/>
                                </group>
                            </group>
                        </page>
                        <page string="Ghi chú" name="note">
                            <field name="note" placeholder="Ghi chú nội bộ, không in ra hợp đồng"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hlv_contract_search" model="ir.ui.view">
        <field name="name">hlv.contract.search</field>
        <field name="model">hlv.contract</field>
        <field name="arch" type="xml">
            <search string="Tìm hợp đồng">
                <field name="name"/>
                <field name="buyer_name"/>
                <field name="buyer_vat"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <filter name="my" string="Của tôi" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="draft" string="Nháp" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Đã xác nhận" domain="[('state', '=', 'confirmed')]"/>
                <filter name="signed" string="Đã ký" domain="[('state', '=', 'signed')]"/>
                <filter name="cancel" string="Đã huỷ" domain="[('state', '=', 'cancel')]"/>
                <separator/>
                <filter name="sale" string="Mua bán" domain="[('contract_type', '=', 'sale')]"/>
                <filter name="principle" string="Nguyên tắc" domain="[('contract_type', '=', 'principle')]"/>
                <separator/>
                <filter name="contract_date" string="Ngày ký" date="contract_date"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_type" string="Loại" context="{'group_by': 'contract_type'}"/>
                    <filter name="group_state" string="Trạng thái" context="{'group_by': 'state'}"/>
                    <filter name="group_user" string="Nhân viên" context="{'group_by': 'user_id'}"/>
                    <filter name="group_month" string="Tháng ký" context="{'group_by': 'contract_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hlv_contract" model="ir.actions.act_window">
        <field name="name">Hợp đồng</field>
        <field name="res_model">hlv.contract</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_hlv_contract_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_hlv_contract_form')})]"/>
        <field name="search_view_id" ref="view_hlv_contract_search"/>
        <field name="context">{'search_default_my': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Tạo hợp đồng đầu tiên</p>
            <p>Chọn mẫu, điền bên mua và hàng hoá. Số hợp đồng và số tiền bằng chữ tự sinh.</p>
        </field>
    </record>

    <!-- In / xuất hàng loạt từ danh sách: chọn nhiều dòng rồi Hành động > Xuất / In hợp đồng -->
    <record id="action_hlv_contract_export_multi" model="ir.actions.act_window">
        <field name="name">Xuất / In hợp đồng</field>
        <field name="res_model">hlv.contract.export</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_hlv_contract"/>
        <field name="binding_view_types">list,form</field>
    </record>

    <record id="view_hlv_contract_preview_form" model="ir.ui.view">
        <field name="name">hlv.contract.preview.form</field>
        <field name="model">hlv.contract.preview</field>
        <field name="arch" type="xml">
            <form string="Xem nhanh" create="false" edit="false">
                <div class="o_hlv_contract_paper">
                    <field name="html" nolabel="1" readonly="1"/>
                </div>
                <footer>
                    <button name="action_export_pdf" type="object" string="Xuất / In" class="btn-primary" icon="fa-download"/>
                    <button string="Đóng" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_hlv_contract_export_form" model="ir.ui.view">
        <field name="name">hlv.contract.export.form</field>
        <field name="model">hlv.contract.export</field>
        <field name="arch" type="xml">
            <form string="Xuất hợp đồng">
                <group>
                    <field name="export_format" widget="radio"/>
                    <field name="contract_count"/>
                </group>
                <div class="text-muted small" invisible="export_format != 'docx'">
                    Nhiều hợp đồng sẽ được gói thành một file .zip, mỗi hợp đồng một file Word.
                </div>
                <div class="text-muted small" invisible="export_format != 'pdf'">
                    Tất cả hợp đồng gộp vào một file PDF, mỗi hợp đồng bắt đầu trang mới — mở ra là in được ngay.
                </div>
                <div class="text-muted small" invisible="export_format != 'xlsx'">
                    Một dòng một hợp đồng, cột giống form Excel cũ (tối thiểu 10 dòng hàng, nhiều hơn nếu có).
                </div>
                <field name="contract_ids" invisible="1"/>
                <footer>
                    <button name="action_export" type="object" string="Xuất file" class="btn-primary"/>
                    <button string="Huỷ" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
