<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hlv_contract_template_list" model="ir.ui.view">
        <field name="name">hlv.contract.template.list</field>
        <field name="model">hlv.contract.template</field>
        <field name="arch" type="xml">
            <list string="Mẫu hợp đồng">
                <field name="name" class="fw-bold"/>
                <field name="contract_type"/>
                <field name="source" widget="badge"/>
                <field name="docx_filename" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_hlv_contract_template_form" model="ir.ui.view">
        <field name="name">hlv.contract.template.form</field>
        <field name="model">hlv.contract.template</field>
        <field name="arch" type="xml">
            <form string="Mẫu hợp đồng" class="o_hlv_contract_template_form">
                <header>
                    <button name="action_convert_to_builder" type="object" string="Chuyển sang soạn trên Odoo"
                            invisible="source != 'docx' or not docx_file"
                            confirm="Mẫu sẽ chuyển sang soạn trên Odoo. Khổ giấy, lề, đầu/chân trang của file Word không giữ lại được. Tiếp tục?"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Đã lưu trữ" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="VD: Hợp đồng mua bán - chuẩn"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="contract_type"/>
                            <field name="source" widget="radio" options="{'horizontal': true}"/>
                        </group>
                        <group>
                            <!-- Mẫu soạn trên Odoo: file Word tự sinh khi lưu, chỉ cho tải về -->
                            <field name="docx_file" filename="docx_filename" readonly="source == 'builder'"/>
                            <field name="docx_filename" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Soạn nội dung" name="builder" invisible="source != 'builder'">
                            <div class="row">
                                <div class="col-lg-9">
                                    <div class="alert alert-info py-2 mb-2" role="status">
                                        Gõ biến dạng <code>{{Ten_Bien}}</code> (copy từ cột bên phải).
                                        Bảng hàng: chỉ cần một dòng chứa <code>{{Ten_Hang_1}}</code>, <code>{{DVT_1}}</code>...;
                                        hợp đồng nhiều dòng hơn sẽ tự nhân bản dòng cuối, dòng thừa tự xoá.
                                    </div>
                                    <field name="body_html" nolabel="1" class="o_hlv_contract_editor"
                                           options="{'codeview': true}"/>
                                </div>
                                <div class="col-lg-3 o_hlv_contract_palette">
                                    <field name="variable_palette" nolabel="1" readonly="1"/>
                                </div>
                            </div>
                        </page>
                        <page string="Biến trong mẫu" name="fields">
                            <field name="field_info" nolabel="1" readonly="1"/>
                        </page>
                        <page string="Ghi chú" name="note">
                            <field name="note" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hlv_contract_template_search" model="ir.ui.view">
        <field name="name">hlv.contract.template.search</field>
        <field name="model">hlv.contract.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="sale" string="Mua bán" domain="[('contract_type', '=', 'sale')]"/>
                <filter name="principle" string="Nguyên tắc" domain="[('contract_type', '=', 'principle')]"/>
                <separator/>
                <filter name="archived" string="Đã lưu trữ" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_hlv_contract_template" model="ir.actions.act_window">
        <field name="name">Mẫu hợp đồng</field>
        <field name="res_model">hlv.contract.template</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_hlv_contract_template_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_hlv_contract_template_form')})]"/>
        <field name="search_view_id" ref="view_hlv_contract_template_search"/>
    </record>

    <record id="view_hlv_contract_template_import_form" model="ir.ui.view">
        <field name="name">hlv.contract.template.import.form</field>
        <field name="model">hlv.contract.template.import</field>
        <field name="arch" type="xml">
            <form string="Import mẫu hợp đồng">
                <group>
                    <field name="name"/>
                    <field name="contract_type"/>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="mode" widget="radio"/>
                </group>
                <div class="text-muted small">
                    File .docx giữ nguyên định dạng và trường trộn (MERGEFIELD) có sẵn.
                    File .doc (Word cũ) chỉ đọc được chữ và trường trộn, sẽ mở trong trình soạn để chỉnh lại.
                </div>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary"/>
                    <button string="Huỷ" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hlv_contract_template_import" model="ir.actions.act_window">
        <field name="name">Import mẫu từ Word</field>
        <field name="res_model">hlv.contract.template.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
