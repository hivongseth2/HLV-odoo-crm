<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Đánh số lại từ 001 mỗi năm nhờ use_date_range; năm lấy theo ngày ký, không theo ngày tạo -->
    <record id="seq_hlv_contract_sale" model="ir.sequence">
        <field name="name">Hợp đồng mua bán</field>
        <field name="code">hlv.contract.sale</field>
        <field name="prefix">HĐMB-</field>
        <field name="suffix">/%(range_year)s</field>
        <field name="padding">3</field>
        <field name="use_date_range" eval="True"/>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_hlv_contract_principle" model="ir.sequence">
        <field name="name">Hợp đồng nguyên tắc</field>
        <field name="code">hlv.contract.principle</field>
        <field name="prefix">HĐNT-</field>
        <field name="suffix">/%(range_year)s</field>
        <field name="padding">3</field>
        <field name="use_date_range" eval="True"/>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
