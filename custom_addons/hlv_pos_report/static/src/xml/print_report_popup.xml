<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Popup Template để chọn và in biên bản -->
    <t t-name="hlv_pos_report.PrintReportPopup">
        <Dialog title="'In Biên Bản'" size="'md'">
            <div class="hlv-print-report-popup p-3">
                <!-- Loading state -->
                <t t-if="state.loading">
                    <div class="text-center py-4">
                        <i class="fa fa-spinner fa-spin fa-2x text-primary"></i>
                        <p class="mt-2 text-muted">Đang tải danh sách biên bản...</p>
                    </div>
                </t>

                <!-- No pickings warning -->
                <t t-elif="!state.hasPickings">
                    <div class="alert alert-warning">
                        <i class="fa fa-exclamation-triangle me-2"></i>
                        <strong>Không có phiếu xuất kho</strong>
                        <p class="mb-0 mt-2">Đơn hàng này chưa được xác nhận hoàn tất hoặc chưa có phiếu xuất kho liên kết.</p>
                    </div>
                </t>

                <!-- No reports available -->
                <t t-elif="state.reports.length === 0">
                    <div class="alert alert-info">
                        <i class="fa fa-info-circle me-2"></i>
                        Không tìm thấy mẫu biên bản nào.
                    </div>
                </t>

                <!-- Report selection -->
                <t t-else="">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Chọn mẫu biên bản:</label>
                        <select class="form-select form-select-lg" 
                                t-on-change="onReportChange"
                                t-att-disabled="state.printing">
                            <t t-foreach="state.reports" t-as="report" t-key="report.id">
                                <option t-att-value="report.id" 
                                        t-att-selected="report.id === state.selectedReportId">
                                    <t t-esc="report.name"/>
                                </option>
                            </t>
                        </select>
                    </div>

                    <div class="alert alert-light border">
                        <small class="text-muted">
                            <i class="fa fa-info-circle me-1"></i>
                            Biên bản sẽ được mở trong tab mới để in.
                        </small>
                    </div>
                </t>
            </div>

            <!-- Footer buttons -->
            <t t-set-slot="footer">
                <div class="d-flex justify-content-end gap-2 w-100">
                    <button class="btn btn-secondary" 
                            t-on-click="onClose"
                            t-att-disabled="state.printing">
                        <i class="fa fa-times me-1"></i> Đóng
                    </button>
                    <button class="btn btn-primary" 
                            t-on-click="onPrint"
                            t-att-disabled="state.printing or !state.hasPickings or state.reports.length === 0">
                        <t t-if="state.printing">
                            <i class="fa fa-spinner fa-spin me-1"></i> Đang xử lý...
                        </t>
                        <t t-else="">
                            <i class="fa fa-print me-1"></i> In Biên Bản
                        </t>
                    </button>
                </div>
            </t>
        </Dialog>
    </t>

</templates>
