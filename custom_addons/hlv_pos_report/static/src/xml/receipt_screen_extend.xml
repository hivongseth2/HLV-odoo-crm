<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Extend ReceiptScreen để thêm nút In Biên Bản -->
    <t t-name="hlv_pos_report.ReceiptScreenButtons" t-inherit="point_of_sale.ReceiptScreen" t-inherit-mode="extension">
        <!-- Thêm nút In Biên Bản vào khu vực buttons -->
        <xpath expr="//div[hasclass('receipt-screen')]//div[hasclass('buttons')]" position="inside">
            <button class="button btn btn-lg btn-info hlv-print-report-btn"
                    t-on-click="openHlvReportPopup">
                <i class="fa fa-file-pdf-o me-2"></i>
                In Biên Bản
            </button>
        </xpath>
    </t>

</templates>
