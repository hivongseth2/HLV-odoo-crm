<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Extend ReceiptScreen để thêm nút In Biên Bản -->
    <t t-name="hlv_pos_report.ReceiptScreenButtons" t-inherit="point_of_sale.ReceiptScreen" t-inherit-mode="extension">
        <!-- Thêm nút In Biên Bản vào khu vực receipt-options, sau các buttons print -->
        <xpath expr="//div[hasclass('receipt-options')]/div[hasclass('d-flex')][hasclass('gap-1')][1]" position="after">
            <div class="d-flex gap-1 mt-2">
                <button class="button btn btn-lg btn-info w-100 py-3 hlv-print-report-btn"
                        t-on-click="openHlvReportPopup">
                    <i class="fa fa-file-pdf-o me-1"></i>
                    In Biên Bản PDF
                </button>
            </div>
        </xpath>
    </t>

</templates>
