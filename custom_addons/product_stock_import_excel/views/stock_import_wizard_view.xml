<odoo>
    <record id="view_product_stock_import_wizard" model="ir.ui.view">
        <field name="name">product.stock.import.wizard</field>
        <field name="model">product.stock.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Stock from Excel">
                <group>
                    <field name="file"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_product_stock_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Product Stock</field>
        <field name="res_model">product.stock.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>