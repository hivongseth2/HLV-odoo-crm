<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View cho stock.batch.planning -->
    
    <!-- Tree View -->
    <record id="view_start_batch_planning_tree" model="ir.ui.view">
        <field name="name">stock.batch.planning.tree</field>
        <field name="model">stock.batch.planning</field>
        <field name="arch" type="xml">
            <list string="Kế hoạch Gom Lô (Dự kiến)">
                <field name="name"/>
                <field name="scheduled_date"/>
                <field name="user_id"/>
                <field name="vehicle_id"/>
                <field name="route_name"/>
                <field name="state" widget="badge" decoration-success="state == 'in_progress'" decoration-info="state == 'draft'"/>
                <field name="batch_id" widget="many2one"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_start_batch_planning_form" model="ir.ui.view">
        <field name="name">stock.batch.planning.form</field>
        <field name="model">stock.batch.planning</field>
        <field name="arch" type="xml">
            <form string="Kế hoạch Gom Lô">
                <header>
                    <button name="action_confirm" type="object" string="Xác nhận" class="oe_highlight" 
                            invisible="state != 'draft'"/>
                    <button name="action_create_real_batch" type="object" string="Tạo Lô (Batch) Thật" 
                            class="oe_highlight" invisible="state == 'done'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <!-- Smart Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_add_sale_orders" icon="fa-shopping-cart"
                                invisible="state == 'done'">
                            <field name="sale_order_count" widget="statinfo" string="Đơn hàng"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_open_picking_selector" icon="fa-truck"
                                invisible="state == 'done'">
                            <field name="picking_count" widget="statinfo" string="Phiếu"/>
                        </button>
                    </div>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Thông tin chung">
                            <field name="scheduled_date"/>
                            <field name="user_id"/>
                            <field name="vehicle_id"/>
                            <field name="route_name"/>
                        </group>
                        <group string="Bộ lọc (Gợi ý cho chọn SO)">
                            <field name="tag_ids" widget="many2many_tags" placeholder="Tuyến..."/>
                            <field name="filter_parent_partner_id" placeholder="Công ty mẹ..."/>
                            <field name="commitment_date_from"/>
                            <field name="commitment_date_to"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="batch_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <!-- Tab Đơn hàng (SO) -->
                        <page string="Đơn hàng (Sale Order)">
                            <button name="action_add_sale_orders" type="object" string="Thêm Đơn Hàng (SO)" 
                                    class="btn-primary" invisible="state == 'done'" style="margin-bottom: 10px;"/>
                            
                            <field name="sale_order_ids" readonly="1">
                                <list create="0" delete="1" 
                                      decoration-info="state in ('draft', 'sent')" 
                                      decoration-success="state == 'sale'">
                                    <field name="name" string="Mã ĐH"/>
                                    <field name="partner_id" string="Khách hàng"/>
                                    <field name="tag_ids" widget="many2many_tags" string="Tuyến"/>
                                    <field name="commitment_date" string="Ngày giao"/>
                                    <field name="amount_total" string="Tổng tiền"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        
                        <!-- Tab Phiếu (Picking) -->
                        <page string="Phiếu Xuất Kho (Picking)">
                            <button name="action_open_picking_selector" type="object" string="Chọn Phiếu (Add Pickings)" class="btn-primary" 
                                    invisible="state == 'done'" style="margin-bottom: 10px;"/>
                            
                            <field name="picking_ids" context="{'default_batch_plan_id': id}" readonly="1">
                                <list create="0" delete="1" decoration-info="state == 'assigned'" decoration-success="state == 'done'">
                                    <field name="name" string="Số phiếu"/>
                                    <field name="partner_id"/>
                                    <field name="picking_type_id" string="Loại"/>
                                    <field name="scheduled_date" string="Ngày hẹn"/>
                                    <field name="state" widget="badge" decoration-success="state == 'done'"/>
                                    <field name="batch_id" string="Lô Thật" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_start_batch_planning" model="ir.actions.act_window">
        <field name="name">Kế hoạch Gom Lô (Planning)</field>
        <field name="res_model">stock.batch.planning</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

    <!-- Menu Item (Thay thế menu cũ) -->
    <menuitem id="menu_batch_planning_new"
              name="Kế hoạch Gom Lô (Planning)"
              parent="stock.menu_stock_warehouse_mgmt"
              action="action_start_batch_planning"
              sequence="50"/>
</odoo>
