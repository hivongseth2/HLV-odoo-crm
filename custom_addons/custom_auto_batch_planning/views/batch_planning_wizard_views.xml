<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_batch_planning_wizard_form" model="ir.ui.view">
        <field name="name">stock.batch.planning.wizard.form</field>
        <field name="model">stock.batch.planning.wizard</field>
        <field name="arch" type="xml">
            <form string="Chọn Kế hoạch Gom Lô">
                <group>
                    <field name="batch_plan_id"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Xác nhận" type="object" class="btn-primary"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
