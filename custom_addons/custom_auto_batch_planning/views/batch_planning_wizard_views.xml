<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_batch_planning_wizard_form" model="ir.ui.view">
        <field name="name">stock.batch.planning.wizard.form</field>
        <field name="model">stock.batch.planning.wizard</field>
        <field name="arch" type="xml">
            <form string="Chọn Kế hoạch Gom Lô">
                <field name="mode" invisible="1"/>
                <group invisible="mode != 'add_to_plan'">
                    <div class="alert alert-info" role="alert">
                        Chọn Kế hoạch để gán các phiếu đã chọn vào.
                    </div>
                    <field name="batch_plan_id" required="mode == 'add_to_plan'"/>
                </group>
                <group invisible="mode != 'select_pickings'">
                    <group col="4">
                        <field name="search_date"/>
                        <field name="search_partner_id"/>
                    </group>
                    
                    <separator string="Danh sách phiếu theo Kế hoạch (Ngày dự kiến)"/>
                    <field name="picking_ids" widget="many2many" nolabel="1">
                        <list>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="origin"/>
                            <field name="state" widget="badge" decoration-success="state == 'assigned'" decoration-info="state == 'confirmed'"/>
                            <field name="scheduled_date"/>
                        </list>
                    </field>
                    
                    <!-- Separate list for suggestions -->
                    <separator string="Gợi ý: Các phiếu cũ/tồn đọng cùng Khách Hàng (được chọn ở trên)" 
                               invisible="not additional_picking_ids"/>
                    <field name="additional_picking_ids" widget="many2many" nolabel="1" 
                           invisible="not additional_picking_ids">
                         <list>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="state" widget="badge" />
                            <field name="scheduled_date"/>
                            <!-- Show age in days could be nice but requires field -->
                        </list>
                    </field>
                </group>
                <footer>
                    <button name="action_confirm" string="Xác nhận" type="object" class="btn-primary"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
