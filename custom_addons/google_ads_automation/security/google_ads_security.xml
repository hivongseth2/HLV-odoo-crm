<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Module Category -->
        <record model="ir.module.category" id="module_category_google_ads_automation">
            <field name="name">Google Ads Automation</field>
            <field name="description">Helps you manage your Google Ads integration.</field>
            <field name="sequence">100</field>
        </record>

        <!-- User Group -->
        <record id="group_google_ads_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_google_ads_automation"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Manager Group -->
        <record id="group_google_ads_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_google_ads_automation"/>
            <field name="implied_ids" eval="[(4, ref('group_google_ads_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
