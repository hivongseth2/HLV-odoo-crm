<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- Strategy – List View                             -->
    <!-- ═══════════════════════════════════════════════ -->
    <record id="view_google_ads_strategy_list" model="ir.ui.view">
        <field name="name">google.ads.strategy.list</field>
        <field name="model">google.ads.strategy</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="strategy_type"/>
                <field name="feed_id"/>
                <field name="account_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'draft'"
                       decoration-danger="state == 'paused'"/>
                <field name="is_live" widget="boolean_toggle"/>
                <field name="rule_count"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- Strategy – Form View                             -->
    <!-- ═══════════════════════════════════════════════ -->
    <record id="view_google_ads_strategy_form" model="ir.ui.view">
        <field name="name">google.ads.strategy.form</field>
        <field name="model">google.ads.strategy</field>
        <field name="arch" type="xml">
            <form string="Chiến Lược Tự Động" class="o_google_ads_premium_form">
                <header>
                    <button name="action_generate_rules" string="Sinh Rules Tự Động" type="object"
                            class="btn-primary" invisible="state == 'active'"/>
                    <button name="action_activate" string="Kích Hoạt Chiến Lược" type="object"
                            class="btn-success" invisible="state == 'active'"/>
                    <button name="action_pause" string="Tạm Dừng" type="object"
                            invisible="state != 'active'" class="btn-warning" icon="fa-pause"/>
                     <button name="action_draft" string="Về Nháp" type="object"
                            invisible="state == 'draft'" class="btn-secondary" icon="fa-undo"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active"/>
                </header>
                <sheet>
                    <field name="hero_header_html" widget="html" readonly="1"/>

                    <div class="oe_title mb-3 border-bottom pb-2">
                        <h1 class="d-flex align-items-center">
                            <field name="name" placeholder="Tên chiến lược..." class="oe_inline"/>
                        </h1>
                    </div>

                    <div class="o_kpi_dashboard">
                         <div class="o_kpi_tile shadow-lg border-0 bg-white">
                            <span class="o_kpi_label">RULES HIỆN CÓ</span>
                            <span class="o_kpi_value text-info"><field name="rule_count"/></span>
                        </div>
                        <div class="o_kpi_tile shadow-lg border-0 bg-white">
                            <span class="o_kpi_label">TRẠNG THÁI</span>
                            <span class="o_kpi_value text-secondary" style="font-size: 14px; padding-top: 10px;">
                                <field name="state" invisible="1"/>
                                <span invisible="state != 'draft'" class="badge text-bg-secondary">Bản Nháp</span>
                                <span invisible="state != 'active'" class="badge text-bg-success">Đang Chạy</span>
                                <span invisible="state != 'paused'" class="badge text-bg-warning">Tạm Dừng</span>
                            </span>
                        </div>
                    </div>

                    <div class="o_premium_card mb-4 mt-3">
                        <h5 class="text-primary fw-bold mb-3 border-bottom pb-2">
                            <i class="fa fa-info-circle me-2"></i>Thông Tin Cấu Hình
                        </h5>
                        <group>
                            <group>
                                <field name="account_id" options="{'no_create': True}"/>
                                <field name="feed_id" options="{'no_create': True}"/>
                            </group>
                            <group>
                                <field name="strategy_type"/>
                                <field name="sequence" groups="base.group_no_one"/>
                            </group>
                        </group>
                    </div>

                    <notebook>
                        <page string="Cấu Hình Thông Minh" icon="fa-sliders">
                            <div class="row mt-3">
                                <div class="col-md-6">
                                    <div class="o_premium_card h-100">
                                        <h5 class="text-primary fw-bold mb-4 border-bottom pb-2"><i class="fa fa-archive me-2"></i>Ngưỡng Tồn Kho</h5>
                                        <group>
                                            <field name="stock_low_threshold"/>
                                            <field name="stock_high_threshold"/>
                                            <field name="days_stock_critical"/>
                                        </group>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="o_premium_card h-100">
                                        <h5 class="text-success fw-bold mb-4 border-bottom pb-2"><i class="fa fa-line-chart me-2"></i>Chỉ Số Hiệu Suất</h5>
                                        <group>
                                            <field name="min_margin_percent"/>
                                            <field name="max_cpa"/>
                                            <field name="target_roas"/>
                                        </group>
                                    </div>
                                </div>
                            </div>
                            <div class="row mt-4">
                                <div class="col-md-6">
                                    <div class="o_premium_card h-100 bg-light border-0">
                                        <h5 class="text-indigo fw-bold mb-4 border-bottom pb-2"><i class="fa fa-money me-2"></i>Thay Đổi Budget</h5>
                                        <group>
                                            <field name="budget_increase_percent"/>
                                            <field name="budget_decrease_percent"/>
                                        </group>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="o_premium_card h-100 bg-light border-0">
                                        <h5 class="text-warning fw-bold mb-4 border-bottom pb-2"><i class="fa fa-star me-2"></i>Ưu Tiên Sản Phẩm</h5>
                                        <group>
                                            <field name="new_product_days"/>
                                            <field name="is_live" widget="boolean_toggle"/>
                                        </group>
                                    </div>
                                </div>
                            </div>
                        </page>
                        <page string="Danh Sách Rules" icon="fa-terminal">
                            <div class="o_premium_card mt-3 p-0 overflow-hidden border-0">
                                <field name="rule_ids" mode="list" readonly="1" 
                                       domain="['|', ('active', '=', True), ('active', '=', False)]"
                                       context="{'active_test': False}">
                                    <list decoration-muted="not active">
                                        <field name="name" class="fw-bold"/>
                                        <field name="condition_field"/>
                                        <field name="condition_operator"/>
                                        <field name="condition_value" class="badge text-bg-light"/>
                                        <field name="action_type" class="text-success"/>
                                        <field name="active" widget="boolean_toggle"/>
                                    </list>
                                </field>
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_google_ads_strategy_kanban" model="ir.ui.view">
        <field name="name">google.ads.strategy.kanban</field>
        <field name="model">google.ads.strategy</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_mobile" records_draggable="false" quick_create="false">
                <field name="name"/>
                <field name="strategy_type"/>
                <field name="feed_id"/>
                <field name="account_id"/>
                <field name="state"/>
                <field name="is_live"/>
                <field name="rule_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click oe_kanban_card">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title fs-5">
                                        <i class="fa fa-cogs text-primary me-2"/>
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <div class="o_kanban_record_state">
                                    <span t-if="record.is_live.raw_value" class="badge text-bg-danger">LIVE</span>
                                    <span t-else="" class="badge text-bg-secondary">Thử/Nháp</span>
                                </div>
                            </div>
                            <div class="o_kanban_record_body mt-3 text-muted">
                                <div><i class="fa fa-cubes me-1"/> Feed: <field name="feed_id"/></div>
                                <div><i class="fa fa-google me-1"/> Tài Khoản: <field name="account_id"/></div>
                                <div><i class="fa fa-tasks me-1"/> Kiểu: <field name="strategy_type"/></div>
                            </div>
                            <div class="o_kanban_record_bottom mt-3">
                                <div class="oe_kanban_bottom_left">
                                    <span class="badge rounded-pill text-bg-info">
                                        <t t-esc="record.rule_count.value"/> rules
                                    </span>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'active'"
                                           decoration-warning="state == 'draft'"
                                           decoration-danger="state == 'paused'"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- Strategy – Action                                -->
    <!-- ═══════════════════════════════════════════════ -->
    <record id="action_google_ads_strategy" model="ir.actions.act_window">
        <field name="name">Chiến Lược Tự Động</field>
        <field name="res_model">google.ads.strategy</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

</odoo>
