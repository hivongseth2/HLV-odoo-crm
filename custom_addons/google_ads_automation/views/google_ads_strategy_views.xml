<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- Strategy – List View                             -->
    <!-- ═══════════════════════════════════════════════ -->
    <record id="view_google_ads_strategy_list" model="ir.ui.view">
        <field name="name">google.ads.strategy.list</field>
        <field name="model">google.ads.strategy</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="strategy_type"/>
                <field name="feed_id"/>
                <field name="account_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'draft'"
                       decoration-danger="state == 'paused'"/>
                <field name="is_live" widget="boolean_toggle"/>
                <field name="rule_count"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- Strategy – Form View                             -->
    <!-- ═══════════════════════════════════════════════ -->
    <record id="view_google_ads_strategy_form" model="ir.ui.view">
        <field name="name">google.ads.strategy.form</field>
        <field name="model">google.ads.strategy</field>
        <field name="arch" type="xml">
            <form string="Chiến Lược Tự Động" class="o_google_ads_premium_form">
                <header>
                    <button name="action_generate_rules" string="⚡ Sinh Rules Tự Động" type="object"
                            class="btn-primary" invisible="state == 'active'"/>
                    <button name="action_activate" string="🚀 Kích Hoạt Chiến Lược" type="object"
                            class="btn-success" invisible="state == 'active'"/>
                    <button name="action_pause" string="⏸ Tạm Dừng" type="object"
                            invisible="state != 'active'" class="btn-warning"/>
                     <button name="action_draft" string="↩ Về Nháp" type="object"
                            invisible="state == 'draft'" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active"/>
                </header>
                <sheet>
                    <field name="hero_header_html" widget="html" readonly="1"/>

                    <div class="oe_title mb-3 border-bottom pb-2">
                        <h1 class="d-flex align-items-center">
                            <field name="name" placeholder="Tên chiến lược..." class="oe_inline"/>
                        </h1>
                    </div>

                    <div class="o_kpi_dashboard">
                         <div class="o_kpi_tile border-0 bg-white">
                            <span class="o_kpi_label">RULES HIỆN CÓ</span>
                            <span class="o_kpi_value text-info"><field name="rule_count"/></span>
                        </div>
                        <div class="o_kpi_tile border-0 bg-white">
                            <span class="o_kpi_label">TRẠNG THÁI</span>
                            <span class="o_kpi_value text-secondary" style="font-size: 14px; padding-top: 10px;">
                                <field name="state" invisible="1"/>
                                <span invisible="state != 'draft'" class="badge text-bg-secondary">Bản Nháp</span>
                                <span invisible="state != 'active'" class="badge text-bg-success">Đang Chạy</span>
                                <span invisible="state != 'paused'" class="badge text-bg-warning">Tạm Dừng</span>
                            </span>
                        </div>
                    </div>

                    <div class="o_premium_card mb-4 mt-3">
                        <h5 class="text-primary fw-bold mb-3 border-bottom pb-2">
                            <i class="fa fa-info-circle me-2"/>Thông Tin Cấu Hình
                        </h5>
                        <group>
                            <group>
                                <field name="account_id" options="{'no_create': True}"/>
                                <field name="feed_id" options="{'no_create': True}"/>
                            </group>
                            <group>
                                <field name="strategy_type"/>
                                <field name="sequence" groups="base.group_no_one"/>
                            </group>
                        </group>

                        <!-- Giải thích ngắn gọn loại chiến lược -->
                        <field name="strategy_type" invisible="1"/>
                        <div class="alert alert-info border-0 mt-2 mb-0 py-2 small" invisible="strategy_type != 'protect_low'">
                            <i class="fa fa-shield me-1"/>
                            Tồn kho giảm dưới ngưỡng → <b>Tự động DỪNG</b> chiến dịch QC để tránh bán quá tay.
                        </div>
                        <div class="alert alert-success border-0 mt-2 mb-0 py-2 small" invisible="strategy_type != 'push_stock'">
                            <i class="fa fa-rocket me-1"/>
                            Tồn kho vượt ngưỡng cao → <b>BẬT chiến dịch + TĂNG ngân sách</b> để đẩy bán nhanh.
                        </div>
                        <div class="alert alert-warning border-0 mt-2 mb-0 py-2 small" invisible="strategy_type != 'optimize_profit'">
                            <i class="fa fa-line-chart me-1"/>
                            CPA quá cao hoặc biên lợi nhuận thấp → <b>DỪNG chiến dịch</b> để cắt lỗ.
                        </div>
                        <div class="alert alert-info border-0 mt-2 mb-0 py-2 small" invisible="strategy_type != 'push_new'">
                            <i class="fa fa-star me-1"/>
                            Sản phẩm mới nhập trong N ngày gần nhất → <b>Tự động BẬT</b> chiến dịch QC.
                        </div>
                        <div class="alert alert-primary border-0 mt-2 mb-0 py-2 small" invisible="strategy_type != 'auto_balance'">
                            <i class="fa fa-balance-scale me-1"/>
                            Kết hợp: Bảo vệ hàng hết + Đẩy hàng tồn + Tối ưu lợi nhuận. <b>Đề xuất cho hầu hết doanh nghiệp.</b>
                        </div>
                        <div class="alert alert-secondary border-0 mt-2 mb-0 py-2 small" invisible="strategy_type != 'custom'">
                            <i class="fa fa-wrench me-1"/>
                            Tự thiết lập điều kiện NẾU → THÌ theo ý muốn (cấu hình ở tab bên dưới).
                        </div>
                    </div>

                    <notebook>
                        <page string="⚙ Cấu Hình Thông Minh" invisible="strategy_type == 'custom'">
                            <div class="row mt-3">
                                <div class="col-md-6">
                                    <div class="o_premium_card h-100">
                                        <h5 class="text-primary fw-bold mb-4 border-bottom pb-2"><i class="fa fa-archive me-2"/>Ngưỡng Tồn Kho</h5>
                                        <group>
                                            <field name="stock_low_threshold" string="Tồn dưới ngưỡng → Dừng QC"
                                                   help="Khi tồn kho sản phẩm giảm dưới con số này, chiến dịch QC sẽ bị tạm dừng"/>
                                            <field name="stock_high_threshold" string="Tồn trên ngưỡng → Đẩy QC"
                                                   help="Khi tồn kho vượt con số này, hệ thống sẽ bật chiến dịch và tăng ngân sách"/>
                                            <field name="days_stock_critical" string="Số ngày tồn nguy hiểm"
                                                   help="Nếu tính ra chỉ đủ bán trong X ngày nữa → kích hoạt khẩn cấp"/>
                                        </group>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="o_premium_card h-100">
                                        <h5 class="text-success fw-bold mb-4 border-bottom pb-2"><i class="fa fa-line-chart me-2"/>Chỉ Số Hiệu Suất</h5>
                                        <group>
                                            <field name="min_margin_percent" string="Biên LN tối thiểu (%)"
                                                   help="Dừng QC nếu sản phẩm lãi ít hơn giá trị này"/>
                                            <field name="max_cpa" string="CPA tối đa (VNĐ/đơn)"
                                                   help="Chi phí quảng cáo cho mỗi đơn hàng. Vượt ngưỡng → dừng QC"/>
                                            <field name="target_roas" string="ROAS mục tiêu (lần)"
                                                   help="VD: 3 = mỗi 1đ chi QC phải thu 3đ doanh thu"/>
                                        </group>
                                    </div>
                                </div>
                            </div>
                            <div class="row mt-4">
                                <div class="col-md-6">
                                    <div class="o_premium_card h-100 bg-light border-0">
                                        <h5 class="fw-bold mb-4 border-bottom pb-2" style="color: #6366f1;"><i class="fa fa-money me-2"/>Thay Đổi Ngân Sách</h5>
                                        <group>
                                            <field name="budget_increase_percent" string="% Tăng khi đẩy bán"
                                                   help="Tăng ngân sách bao nhiêu % khi sản phẩm cần đẩy mạnh"/>
                                            <field name="budget_decrease_percent" string="% Giảm khi tiết kiệm"
                                                   help="Giảm ngân sách bao nhiêu % khi cần thu hẹp chi tiêu"/>
                                        </group>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="o_premium_card h-100 bg-light border-0">
                                        <h5 class="text-warning fw-bold mb-4 border-bottom pb-2"><i class="fa fa-star me-2"/>Ưu Tiên Sản Phẩm</h5>
                                        <group>
                                            <field name="new_product_days" string="SP mới trong (ngày)"
                                                   help="SP được nhập kho trong vòng N ngày gần nhất = hàng mới → bật QC"/>
                                            <field name="is_live" widget="boolean_toggle" string="Chế độ Live"
                                                   help="TẮT = chỉ ghi log (an toàn). BẬT = gửi lệnh thật lên Google Ads!"/>
                                        </group>
                                    </div>
                                </div>
                            </div>
                        </page>
                        <page string="🔧 Cấu Hình Tùy Chỉnh" invisible="strategy_type != 'custom'">
                            <div class="row mt-3">
                                <div class="col-md-12">
                                    <div class="o_premium_card h-100 bg-light border-0">
                                        <h5 class="fw-bold mb-4 border-bottom pb-2" style="color: #6366f1;"><i class="fa fa-wrench me-2"/>Rule Tùy Chỉnh</h5>
                                        <p class="text-muted mb-3"><i class="fa fa-info-circle me-1"/>Hệ thống sẽ quét tất cả sản phẩm trong Feed và tạo Rule cho mỗi sản phẩm có chiến dịch liên kết.</p>
                                        <group>
                                            <group string="NẾU — Điều kiện">
                                                <field name="custom_condition_field" required="strategy_type == 'custom'" string="Kiểm tra chỉ số"/>
                                                <field name="custom_condition_operator" required="strategy_type == 'custom'" string="So sánh"/>
                                                <field name="custom_condition_value" required="strategy_type == 'custom'" string="Giá trị"/>
                                            </group>
                                            <group string="THÌ — Hành động">
                                                <field name="custom_action_type" required="strategy_type == 'custom'" string="Thực hiện"/>
                                                <field name="custom_action_value" invisible="custom_action_type not in ('increase_budget', 'decrease_budget')" string="Giá trị (%)"/>
                                                <field name="is_live" widget="boolean_toggle" string="Chế độ Live"
                                                       help="TẮT = chỉ ghi log. BẬT = gửi lệnh thật lên Google Ads!"/>
                                            </group>
                                        </group>
                                    </div>
                                </div>
                            </div>
                        </page>
                        <page string="📋 Danh Sách Rules">
                            <div class="o_premium_card mt-3 p-0 overflow-hidden border-0">
                                <field name="rule_ids" mode="list" readonly="1" 
                                       domain="['|', ('active', '=', True), ('active', '=', False)]"
                                       context="{'active_test': False}">
                                    <list decoration-muted="not active">
                                        <field name="name" class="fw-bold"/>
                                        <field name="condition_field" string="Điều kiện"/>
                                        <field name="condition_operator" string="So sánh"/>
                                        <field name="condition_value" string="Ngưỡng" class="badge text-bg-light"/>
                                        <field name="action_type" string="Hành động"
                                               decoration-danger="action_type == 'pause'"
                                               decoration-success="action_type == 'enable'"
                                               decoration-warning="action_type in ('increase_budget', 'decrease_budget')"
                                               widget="badge"/>
                                        <field name="active" widget="boolean_toggle"/>
                                    </list>
                                </field>
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- Strategy – Kanban View                           -->
    <!-- ═══════════════════════════════════════════════ -->
    <record id="view_google_ads_strategy_kanban" model="ir.ui.view">
        <field name="name">google.ads.strategy.kanban</field>
        <field name="model">google.ads.strategy</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_mobile" records_draggable="false" quick_create="false">
                <field name="name"/>
                <field name="strategy_type"/>
                <field name="feed_id"/>
                <field name="account_id"/>
                <field name="state"/>
                <field name="is_live"/>
                <field name="rule_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click o_premium_kanban_card">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="d-flex flex-column">
                                    <span class="o_kanban_header_title mb-1">
                                        <field name="name"/>
                                    </span>
                                    <div class="d-flex gap-1">
                                        <span class="o_kanban_tech_pill">
                                            <field name="strategy_type"/>
                                        </span>
                                        <span t-if="record.is_live.raw_value" class="badge text-bg-danger rounded-pill" style="font-size: 9px; padding: 2px 6px;">LIVE</span>
                                        <span t-else="" class="badge text-bg-secondary rounded-pill" style="font-size: 9px; padding: 2px 6px;">TEST</span>
                                    </div>
                                </div>
                                <div class="bg-light p-2 rounded-3 border">
                                    <i class="fa fa-cogs text-primary"/>
                                </div>
                            </div>

                            <div class="o_kanban_main_content">
                                <div class="o_kanban_info_row">
                                    <i class="fa fa-cubes"/>
                                    <span>Feed: <b><field name="feed_id"/></b></span>
                                </div>
                                <div class="o_kanban_info_row">
                                    <i class="fa fa-google"/>
                                    <span>Account: <field name="account_id"/></span>
                                </div>
                            </div>

                            <div class="o_kanban_footer">
                                <span class="badge rounded-pill text-bg-info shadow-sm" style="font-size: 11px; padding: 4px 10px;">
                                    <t t-esc="record.rule_count.value"/> rules active
                                </span>
                                <field name="state" widget="badge" 
                                       decoration-success="state == 'active'" 
                                       decoration-warning="state == 'draft'" 
                                       decoration-danger="state == 'paused'"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- Strategy – Action                                -->
    <!-- ═══════════════════════════════════════════════ -->
    <record id="action_google_ads_strategy" model="ir.actions.act_window">
        <field name="name">Chiến Lược Tự Động</field>
        <field name="res_model">google.ads.strategy</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

</odoo>
