<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- Strategy – List View                             -->
    <!-- ═══════════════════════════════════════════════ -->
    <record id="view_google_ads_strategy_list" model="ir.ui.view">
        <field name="name">google.ads.strategy.list</field>
        <field name="model">google.ads.strategy</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="strategy_type"/>
                <field name="feed_id"/>
                <field name="account_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'draft'"
                       decoration-danger="state == 'paused'"/>
                <field name="is_live" widget="boolean_toggle"/>
                <field name="rule_count"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- Strategy – Form View                             -->
    <!-- ═══════════════════════════════════════════════ -->
    <record id="view_google_ads_strategy_form" model="ir.ui.view">
        <field name="name">google.ads.strategy.form</field>
        <field name="model">google.ads.strategy</field>
        <field name="arch" type="xml">
            <form string="Chiến Lược Tự Động" class="o_google_ads_premium_form">
                <header>
                    <button name="action_generate_rules" string="⚡ Sinh Rules" type="object"
                            class="btn-primary" invisible="state == 'active'"/>
                    <button name="action_activate" string="🚀 Kích Hoạt" type="object"
                            class="btn-success" invisible="state == 'active'"/>
                    <button name="action_pause" string="⏸ Tạm Dừng" type="object"
                            invisible="state != 'active'" class="btn-warning"/>
                    <button name="action_draft" string="↩ Về Nháp" type="object"
                            invisible="state == 'draft'" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active"/>
                </header>
                <sheet>
                    <field name="state" invisible="1"/>
                    <field name="strategy_type" invisible="1"/>

                    <!-- ═══ Cảnh báo LIVE ═══ -->
                    <div class="alert alert-danger mb-3 d-flex align-items-center gap-3" invisible="not is_live">
                        <i class="fa fa-exclamation-triangle fa-2x"/>
                        <div>
                            <strong>⚠ Chế độ LIVE đang BẬT</strong> — Hệ thống sẽ gửi lệnh thay đổi
                            <b>trực tiếp lên Google Ads thật</b> khi rule được kích hoạt.
                        </div>
                    </div>

                    <!-- ═══════════════════════════════════════ -->
                    <!-- PHẦN 1: Thông tin chung                 -->
                    <!-- ═══════════════════════════════════════ -->
                    <group string="Thông tin chung">
                        <group>
                            <field name="name" string="Tên chiến lược" placeholder="VD: Tự động dừng khi hết hàng"/>
                            <field name="account_id" string="Tài khoản Google Ads" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="feed_id" string="Nguồn sản phẩm (Feed)" options="{'no_create': True}"/>
                            <field name="strategy_type" string="Loại chiến lược" widget="selection"/>
                            <field name="sequence" groups="base.group_no_one"/>
                        </group>
                    </group>

                    <!-- Giải thích loại chiến lược đang chọn -->
                    <div class="alert alert-info border-0 shadow-sm mb-4" invisible="strategy_type != 'protect_low'">
                        <i class="fa fa-shield me-2"/>
                        <b>Bảo Vệ Hàng Sắp Hết:</b> Khi tồn kho giảm xuống dưới ngưỡng bạn đặt → hệ thống sẽ
                        <span class="badge text-bg-danger">TỰ ĐỘNG DỪNG</span> chiến dịch quảng cáo của sản phẩm đó để tránh bán quá tay.
                    </div>
                    <div class="alert alert-success border-0 shadow-sm mb-4" invisible="strategy_type != 'push_stock'">
                        <i class="fa fa-rocket me-2"/>
                        <b>Đẩy Hàng Tồn Kho Cao:</b> Khi tồn kho vượt ngưỡng cao → hệ thống sẽ
                        <span class="badge text-bg-success">BẬT CHIẾN DỊCH</span> +
                        <span class="badge text-bg-warning">TĂNG NGÂN SÁCH</span> để đẩy bán nhanh hơn.
                    </div>
                    <div class="alert alert-warning border-0 shadow-sm mb-4" invisible="strategy_type != 'optimize_profit'">
                        <i class="fa fa-line-chart me-2"/>
                        <b>Tối Ưu Lợi Nhuận:</b> Nếu chi phí quảng cáo mỗi đơn (CPA) quá cao hoặc biên lợi nhuận quá thấp →
                        <span class="badge text-bg-danger">DỪNG CHIẾN DỊCH</span> để cắt lỗ.
                    </div>
                    <div class="alert alert-info border-0 shadow-sm mb-4" invisible="strategy_type != 'push_new'">
                        <i class="fa fa-star me-2"/>
                        <b>Đẩy Hàng Mới:</b> Sản phẩm mới nhập kho gần đây sẽ được
                        <span class="badge text-bg-success">TỰ ĐỘNG BẬT</span> chiến dịch quảng cáo.
                    </div>
                    <div class="alert alert-primary border-0 shadow-sm mb-4" invisible="strategy_type != 'auto_balance'">
                        <i class="fa fa-balance-scale me-2"/>
                        <b>Cân Bằng Tự Động (Đề xuất):</b> Kết hợp 3 chiến lược: Bảo vệ hàng hết + Đẩy hàng tồn + Tối ưu lợi nhuận.
                        Phù hợp cho hầu hết doanh nghiệp.
                    </div>
                    <div class="alert alert-secondary border-0 shadow-sm mb-4" invisible="strategy_type != 'custom'">
                        <i class="fa fa-wrench me-2"/>
                        <b>Tùy Chỉnh:</b> Bạn tự thiết lập điều kiện và hành động theo ý muốn (xem bên dưới).
                    </div>

                    <notebook>
                        <!-- ═══════════════════════════════════════ -->
                        <!-- TAB: Cài đặt ngưỡng (có sẵn)           -->
                        <!-- ═══════════════════════════════════════ -->
                        <page string="⚙ Cài đặt ngưỡng" invisible="strategy_type == 'custom'">

                            <!-- Tồn kho -->
                            <group string="📦 Ngưỡng Tồn Kho — Bao nhiêu sản phẩm thì dừng/đẩy quảng cáo?"
                                   invisible="strategy_type not in ('protect_low', 'push_stock', 'auto_balance')">
                                <group>
                                    <field name="stock_low_threshold"
                                           string="Dưới bao nhiêu thì DỪNG quảng cáo?"
                                           help="VD: Đặt 20 → khi tồn kho giảm dưới 20 cái → dừng QC"/>
                                    <field name="days_stock_critical"
                                           string="Còn bao nhiêu ngày hàng thì KHẨN CẤP?"
                                           help="VD: Đặt 7 → nếu tính ra chỉ còn đủ bán 7 ngày → cảnh báo"/>
                                </group>
                                <group>
                                    <field name="stock_high_threshold"
                                           string="Vượt bao nhiêu thì ĐẨY MẠNH quảng cáo?"
                                           help="VD: Đặt 200 → khi tồn kho trên 200 cái → bật QC và tăng ngân sách"
                                           invisible="strategy_type not in ('push_stock', 'auto_balance')"/>
                                </group>
                            </group>

                            <!-- Hiệu suất -->
                            <group string="📊 Chỉ Số Hiệu Suất — Khi nào thì chiến dịch lỗ?"
                                   invisible="strategy_type not in ('optimize_profit', 'auto_balance')">
                                <group>
                                    <field name="min_margin_percent"
                                           string="Biên lợi nhuận tối thiểu (%)"
                                           help="VD: 15 → nếu lãi ít hơn 15% thì dừng QC sản phẩm đó"/>
                                    <field name="max_cpa"
                                           string="Chi phí tối đa cho mỗi đơn hàng (VNĐ)"
                                           help="VD: 100.000 → Nếu quảng cáo tốn hơn 100k để có 1 đơn → dừng"/>
                                </group>
                                <group>
                                    <field name="target_roas"
                                           string="Mục tiêu ROAS (lần)"
                                           help="VD: 3 = mỗi 1đ chi quảng cáo phải thu được 3đ doanh thu"/>
                                </group>
                            </group>

                            <!-- Ngân sách -->
                            <group string="💰 Thay Đổi Ngân Sách — Tăng/giảm bao nhiêu %?"
                                   invisible="strategy_type not in ('push_stock', 'auto_balance')">
                                <group>
                                    <field name="budget_increase_percent"
                                           string="Tăng ngân sách bao nhiêu % khi đẩy hàng?"
                                           help="VD: 30 → Tăng ngân sách thêm 30% cho chiến dịch cần đẩy"/>
                                </group>
                                <group>
                                    <field name="budget_decrease_percent"
                                           string="Giảm ngân sách bao nhiêu % khi tiết kiệm?"
                                           help="VD: 30 → Giảm ngân sách 30% cho chiến dịch cần hạn chế"/>
                                </group>
                            </group>

                            <!-- SP mới -->
                            <group string="🆕 Sản Phẩm Mới — Mới trong bao nhiêu ngày?"
                                   invisible="strategy_type not in ('push_new', 'auto_balance')">
                                <group>
                                    <field name="new_product_days"
                                           string="Sản phẩm nhập trong vòng bao nhiêu ngày được coi là MỚI?"
                                           help="VD: 30 → SP được tạo trong vòng 30 ngày gần nhất = hàng mới → tự động bật QC"/>
                                </group>
                            </group>
                        </page>

                        <!-- ═══════════════════════════════════════ -->
                        <!-- TAB: Cấu hình tùy chỉnh (Custom)       -->
                        <!-- ═══════════════════════════════════════ -->
                        <page string="🔧 Cấu hình tùy chỉnh" invisible="strategy_type != 'custom'">
                            <div class="alert alert-light border mb-3">
                                <i class="fa fa-info-circle me-1"/>
                                Thiết lập quy tắc <b>"NẾU ... THÌ ..."</b> bên dưới. Hệ thống sẽ tạo 1 Rule cho mỗi sản phẩm có chiến dịch liên kết trong Feed.
                            </div>
                            <group string="NẾU — Điều kiện kích hoạt">
                                <group>
                                    <field name="custom_condition_field"
                                           string="Kiểm tra chỉ số nào?"
                                           required="strategy_type == 'custom'"/>
                                    <field name="custom_condition_operator"
                                           string="So sánh thế nào?"
                                           required="strategy_type == 'custom'"/>
                                    <field name="custom_condition_value"
                                           string="Với giá trị bao nhiêu?"
                                           required="strategy_type == 'custom'"/>
                                </group>
                            </group>
                            <group string="THÌ — Hệ thống sẽ làm gì?">
                                <group>
                                    <field name="custom_action_type"
                                           string="Hành động"
                                           required="strategy_type == 'custom'"/>
                                    <field name="custom_action_value"
                                           string="Thay đổi bao nhiêu %?"
                                           invisible="custom_action_type not in ('increase_budget', 'decrease_budget')"/>
                                </group>
                            </group>
                        </page>

                        <!-- ═══════════════════════════════════════ -->
                        <!-- TAB: Chế độ &amp; Rules                     -->
                        <!-- ═══════════════════════════════════════ -->
                        <page string="📋 Rules đã sinh">
                            <group string="Chế độ hoạt động">
                                <group>
                                    <field name="is_live" widget="boolean_toggle"
                                           string="Gửi lệnh thật lên Google Ads (Live)"
                                           help="TẮT = chỉ ghi log, không ảnh hưởng Google Ads (an toàn để test). BẬT = gửi lệnh thật!"/>
                                </group>
                                <group>
                                    <field name="rule_count" string="Tổng số rules hiện có" readonly="1"/>
                                </group>
                            </group>

                            <separator string="Danh sách Rules"/>
                            <div class="alert alert-light border mb-2" invisible="rule_count > 0">
                                <i class="fa fa-info-circle me-1 text-muted"/>
                                Chưa có rule nào. Bấm <b>"⚡ Sinh Rules"</b> ở phía trên để hệ thống tự động tạo.
                            </div>
                            <field name="rule_ids" mode="list" readonly="1"
                                   domain="['|', ('active', '=', True), ('active', '=', False)]"
                                   context="{'active_test': False}">
                                <list decoration-muted="not active">
                                    <field name="name" string="Tên Rule"/>
                                    <field name="condition_field" string="Kiểm tra"/>
                                    <field name="condition_operator" string="So sánh"/>
                                    <field name="condition_value" string="Ngưỡng"/>
                                    <field name="action_type" string="Hành động"
                                           decoration-danger="action_type == 'pause'"
                                           decoration-success="action_type == 'enable'"
                                           decoration-warning="action_type in ('increase_budget', 'decrease_budget')"
                                           widget="badge"/>
                                    <field name="active" widget="boolean_toggle" string="Bật"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- Strategy – Kanban View                           -->
    <!-- ═══════════════════════════════════════════════ -->
    <record id="view_google_ads_strategy_kanban" model="ir.ui.view">
        <field name="name">google.ads.strategy.kanban</field>
        <field name="model">google.ads.strategy</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_mobile" records_draggable="false" quick_create="false">
                <field name="name"/>
                <field name="strategy_type"/>
                <field name="feed_id"/>
                <field name="account_id"/>
                <field name="state"/>
                <field name="is_live"/>
                <field name="rule_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click o_premium_kanban_card">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="d-flex flex-column">
                                    <span class="o_kanban_header_title mb-1">
                                        <field name="name"/>
                                    </span>
                                    <div class="d-flex gap-1 flex-wrap">
                                        <span class="o_kanban_tech_pill">
                                            <field name="strategy_type"/>
                                        </span>
                                        <span t-if="record.is_live.raw_value" class="badge text-bg-danger rounded-pill" style="font-size: 9px; padding: 2px 6px;">🔴 LIVE</span>
                                        <span t-else="" class="badge text-bg-secondary rounded-pill" style="font-size: 9px; padding: 2px 6px;">🧪 TEST</span>
                                    </div>
                                </div>
                                <div class="bg-light p-2 rounded-3 border">
                                    <i class="fa fa-cogs text-primary"/>
                                </div>
                            </div>

                            <div class="o_kanban_main_content">
                                <div class="o_kanban_info_row">
                                    <i class="fa fa-cubes"/>
                                    <span>Feed: <b><field name="feed_id"/></b></span>
                                </div>
                                <div class="o_kanban_info_row">
                                    <i class="fa fa-google"/>
                                    <span>Account: <field name="account_id"/></span>
                                </div>
                            </div>

                            <div class="o_kanban_footer">
                                <span class="badge rounded-pill text-bg-info shadow-sm" style="font-size: 11px; padding: 4px 10px;">
                                    <t t-esc="record.rule_count.value"/> rules
                                </span>
                                <field name="state" widget="badge" 
                                       decoration-success="state == 'active'" 
                                       decoration-warning="state == 'draft'" 
                                       decoration-danger="state == 'paused'"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- Strategy – Action                                -->
    <!-- ═══════════════════════════════════════════════ -->
    <record id="action_google_ads_strategy" model="ir.actions.act_window">
        <field name="name">Chiến Lược Tự Động</field>
        <field name="res_model">google.ads.strategy</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

</odoo>
