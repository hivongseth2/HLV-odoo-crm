<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ══════════  List View  ══════════ -->
    <record id="view_google_ads_conversion_list" model="ir.ui.view">
        <field name="name">google.ads.conversion.list</field>
        <field name="model">google.ads.conversion</field>
        <field name="arch" type="xml">
            <list string="Lượt Chuyển Đổi" create="false" edit="false">
                <field name="order_date"/>
                <field name="order_ref"/>
                <field name="campaign_id"/>
                <field name="customer_name"/>
                <field name="product_names"/>
                <field name="revenue" widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="order_status" widget="badge"
                       decoration-success="order_status == 'completed'"
                       decoration-warning="order_status == 'processing'"
                       decoration-danger="order_status == 'cancelled'"/>
                <field name="source" widget="badge"/>
                <field name="gclid" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ══════════  Form View  ══════════ -->
    <record id="view_google_ads_conversion_form" model="ir.ui.view">
        <field name="name">google.ads.conversion.form</field>
        <field name="model">google.ads.conversion</field>
        <field name="arch" type="xml">
            <form string="Lượt Chuyển Đổi" create="false" edit="false">
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <group>
                        <group string="Thông Tin Đơn Hàng">
                            <field name="order_ref" readonly="1"/>
                            <field name="order_date" readonly="1"/>
                            <field name="customer_name" readonly="1"/>
                            <field name="product_names" readonly="1"/>
                            <field name="revenue" readonly="1"/>
                            <field name="order_status" readonly="1"/>
                        </group>
                        <group string="Liên Kết Google Ads">
                            <field name="account_id" readonly="1"/>
                            <field name="campaign_id" readonly="1"/>
                            <field name="gclid" readonly="1"/>
                            <field name="source" readonly="1"/>
                            <field name="roas" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ══════════  Action  ══════════ -->
    <record id="action_google_ads_conversion" model="ir.actions.act_window">
        <field name="name">Lượt Chuyển Đổi</field>
        <field name="res_model">google.ads.conversion</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_completed': 1}</field>
    </record>
</odoo>
