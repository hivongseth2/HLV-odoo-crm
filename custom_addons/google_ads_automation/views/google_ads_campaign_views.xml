<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_google_ads_campaign_list" model="ir.ui.view">
        <field name="name">google.ads.campaign.list</field>
        <field name="model">google.ads.campaign</field>
        <field name="arch" type="xml">
            <list string="Chiến Dịch Google Ads">
                <field name="name" readonly="state == 'synced'"/>
                <field name="account_id"/>
                <field name="channel_type"/>
                <field name="clicks" sum="Tổng Click" optional="show"/>
                <field name="cost" sum="Tổng Chi Phí" optional="show"/>
                <field name="conversions" sum="Tổng Đơn" optional="show"/>
                <field name="conversion_rate" widget="progressbar" string="Tỷ Lệ CĐ (%)" optional="show"/>
                <field name="roas" string="ROAS" widget="badge" 
                       decoration-success="roas &gt;= 3" 
                       decoration-danger="roas &lt; 1" 
                       decoration-warning="roas &gt;= 1 and roas &lt; 3"
                       optional="show"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'enabled'"
                       decoration-muted="status == 'paused'"
                       decoration-danger="status == 'removed'"/>
            </list>
        </field>
    </record>

    <record id="view_google_ads_campaign_form" model="ir.ui.view">
        <field name="name">google.ads.campaign.form</field>
        <field name="model">google.ads.campaign</field>
        <field name="arch" type="xml">
            <form string="Chiến Dịch Google Ads" class="o_google_ads_premium_form">
                <header>
                    <button name="action_sync_to_google" string="Đồng bộ lên Google" 
                            type="object" class="btn-primary" 
                            invisible="state == 'synced'"/>
                    <button name="action_ask_adsroid" string="🪄 Phân tích bằng Adsroid"
                            type="object" class="btn-info"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,synced"/>
                </header>
                <sheet>
                    <field name="hero_header_html" widget="html" readonly="1"/>
                    
                    <div class="o_kpi_dashboard mt-n4">
                        <div class="o_kpi_tile shadow-sm border-0">
                            <span class="o_kpi_label">LƯỢT NHẤP</span>
                            <span class="o_kpi_value text-primary"><field name="clicks" readonly="1"/></span>
                        </div>
                        <div class="o_kpi_tile shadow-sm border-0">
                            <span class="o_kpi_label">CHI PHÍ</span>
                            <span class="o_kpi_value text-danger"><field name="cost" widget="monetary" readonly="1"/></span>
                        </div>
                        <div class="o_kpi_tile shadow-sm border-0">
                            <span class="o_kpi_label">CHUYỂN ĐỔI</span>
                            <span class="o_kpi_value text-success"><field name="conversions" readonly="1"/></span>
                        </div>
                        <div class="o_kpi_tile shadow-sm border-0">
                            <span class="o_kpi_label">ROAS</span>
                            <span class="o_kpi_value text-info"><field name="roas" widget="badge" decoration-success="roas &gt;= 3"/></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-lg-7">
                            <div class="o_premium_card h-100">
                                <h4 class="mb-4 text-success fw-bold"><i class="fa fa-line-chart me-2"></i>Chi Tiết Hiệu Suất</h4>
                                <div class="alert alert-info border-0 shadow-sm rounded-3 mb-4">
                                    <i class="fa fa-info-circle me-1"></i> Sản phẩm được tự động liệt kê dựa trên các dòng trong <b>Product Feed</b> có chọn chiến dịch này.
                                </div>
                                <group>
                                    <field name="product_ids" widget="many2many_tags" readonly="1"/>
                                    <field name="impressions" readonly="1"/>
                                    <field name="conversion_rate" widget="progressbar" readonly="1"/>
                                    <field name="channel_type" readonly="state == 'synced'"/>
                                    <field name="google_campaign_id" readonly="1" invisible="state == 'draft'"/>
                                </group>
                            </div>
                        </div>
                        <div class="col-lg-5">
                            <div class="o_premium_card h-100 bg-light border-0">
                                <h4 class="mb-4 text-secondary fw-bold"><i class="fa fa-info-circle me-2"></i>Trạng Thái Đồng Bộ</h4>
                                <div class="alert alert-info border-0 shadow-sm rounded-3">
                                    <i class="fa fa-refresh me-1"></i> Dữ liệu này được đồng bộ tự động từ Google Ads.
                                </div>
                                <group>
                                    <field name="status" widget="badge"
                                           readonly="1"
                                           decoration-success="status == 'enabled'"
                                           decoration-warning="status == 'paused'"
                                           decoration-danger="status == 'removed'"/>
                                </group>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-4" invisible="not adsroid_last_insight">
                        <div class="col-12">
                            <div class="o_premium_card border-0 bg-light">
                                <h4 class="mb-3 text-info fw-bold"><i class="fa fa-magic me-2"></i>Nhận định từ Adsroid AI</h4>
                                <field name="adsroid_last_insight" widget="html" nolabel="1"/>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_google_ads_campaign" model="ir.actions.act_window">
        <field name="name">Chiến Dịch</field>
        <field name="res_model">google.ads.campaign</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
