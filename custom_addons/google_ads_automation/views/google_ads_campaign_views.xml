<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_google_ads_campaign_tree" model="ir.ui.view">
        <field name="name">google.ads.campaign.tree</field>
        <field name="model">google.ads.campaign</field>
        <field name="arch" type="xml">
            <tree string="Google Ads Campaigns" create="false" edit="false">
                <field name="name"/>
                <field name="account_id"/>
                <field name="google_campaign_id"/>
                <field name="channel_type"/>
                <field name="status" widget="badge" decoration-success="status == 'enabled'" decoration-info="status == 'paused'" decoration-danger="status == 'removed'"/>
            </tree>
        </field>
    </record>

    <record id="action_google_ads_campaign" model="ir.actions.act_window">
        <field name="name">Google Campaigns</field>
        <field name="res_model">google.ads.campaign</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
