<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_google_ads_campaign_list" model="ir.ui.view">
        <field name="name">google.ads.campaign.list</field>
        <field name="model">google.ads.campaign</field>
        <field name="arch" type="xml">
            <list string="Chiến Dịch Google Ads">
                <field name="name"/>
                <field name="account_id"/>
                <field name="channel_type"/>
                <field name="clicks" sum="Tổng Click" optional="show"/>
                <field name="cost" sum="Tổng Chi Phí" optional="show"/>
                <field name="conversions" sum="Tổng Đơn" optional="show"/>
                <field name="conversion_rate" widget="progressbar" string="Tỷ Lệ CĐ (%)" optional="show"/>
                <field name="roas" string="ROAS" widget="badge" 
                       decoration-success="roas &gt;= 3" 
                       decoration-danger="roas &lt; 1" 
                       decoration-warning="roas &gt;= 1 and roas &lt; 3"
                       optional="show"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'enabled'"
                       decoration-muted="status == 'paused'"
                       decoration-danger="status == 'removed'"/>
            </list>
        </field>
    </record>

    <record id="view_google_ads_campaign_form" model="ir.ui.view">
        <field name="name">google.ads.campaign.form</field>
        <field name="model">google.ads.campaign</field>
        <field name="arch" type="xml">
            <form string="Chiến Dịch Google Ads" class="o_google_ads_premium_form">
                <header>
                    <button name="action_sync_to_google" string="Đồng bộ Google" 
                            type="object" class="btn-primary" 
                            invisible="state == 'synced'"/>
                    
                    <button name="action_pause_on_google" string="⏸️ Tạm dừng trên Google"
                            type="object" class="btn-secondary"
                            invisible="state != 'synced' or status == 'paused'"/>
                            
                    <button name="action_enable_on_google" string="▶️ Kích hoạt trên Google"
                            type="object" class="btn-success"
                            invisible="state != 'synced' or status == 'enabled'"/>

                    <button name="action_remove_from_google_only" string="🗑️ Xóa khỏi Google Ads"
                            type="object" class="btn-danger"
                            invisible="state != 'synced'"
                            confirm="⚠️ Bạn có chắc chắn muốn XÓA chiến dịch này trên Google Ads?\n\n- Chiến dịch sẽ bị gỡ bỏ vĩnh viễn trên nền tảng Google.\n- Bản ghi Odoo sẽ được GIỮ LẠI và chuyển về trạng thái 'Nháp' để bạn có thể đồng bộ lại sau này."/>

                    <button name="action_ask_adsroid" string="🪄 Phân tích bằng Adsroid"
                            type="object" class="btn-info"
                            invisible="state != 'synced'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,synced"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Tên chiến dịch... VD: Campaign Mùa Hè"/></h1>
                    </div>
                    <div class="o_premium_card mb-4 mt-3">
                        <h5 class="text-primary fw-bold mb-3 border-bottom pb-2">
                            <i class="fa fa-cubes me-2"></i>Nguồn Cấp Dữ Liệu
                        </h5>
                        <group>
                            <field name="product_feed_id" options="{'no_create': True}" placeholder="Chọn Feed để nạp sản phẩm nhanh..."/>
                        </group>
                    </div>
                    <group>
                        <group>
                            <field name="account_id" readonly="state != 'draft'"/>
                            <field name="channel_type" readonly="state != 'draft'"/>
                            <field name="video_sub_type" 
                                   invisible="channel_type != 'VIDEO'"
                                   required="channel_type == 'VIDEO'"
                                   readonly="state != 'draft'"/>
                            <field name="app_sub_type" 
                                   invisible="channel_type != 'MULTI_CHANNEL'"
                                   required="channel_type == 'MULTI_CHANNEL'"
                                   readonly="state != 'draft'"/>
                            <field name="google_campaign_id" readonly="1" invisible="state == 'draft'"/>
                        </group>
                        <group string="Cấu hình Google Ads">
                            <field name="budget_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="final_url" placeholder="https://example.com" required="channel_type in ['VIDEO', 'PERFORMANCE_MAX']"/>
                            <field name="business_name" invisible="channel_type != 'PERFORMANCE_MAX'" required="channel_type == 'PERFORMANCE_MAX'"/>
                            <field name="logo_image" widget="image" invisible="channel_type != 'PERFORMANCE_MAX'" 
                                   required="channel_type == 'PERFORMANCE_MAX'"
                                   class="oe_avatar" options="{'size': [96, 96]}"/>
                            <field name="marketing_image" widget="image" invisible="channel_type != 'PERFORMANCE_MAX'"
                                   required="channel_type == 'PERFORMANCE_MAX'"
                                   class="o_google_ads_landscape_img"/>
                            <field name="status" widget="badge" readonly="1" invisible="state == 'draft'"
                                   decoration-success="status == 'enabled'"
                                   decoration-warning="status == 'paused'"
                                   decoration-danger="status == 'removed'"/>
                        </group>
                    </group>
                    
                    <!-- PMax Assets Configuration -->
                    <notebook invisible="channel_type != 'PERFORMANCE_MAX'">
                        <page name="pmax_assets" string="Thành phần PMax (Tùy chọn/Mặc định)">
                            <div class="alert alert-warning border-0 shadow-sm" invisible="state == 'synced'">
                                <i class="fa fa-magic me-2"></i><b>Gợi ý:</b> Nếu để trống, hệ thống sẽ tự động dùng "Tên chiến dịch" để tạo các tiêu đề và mô tả cơ bản.
                            </div>
                            <group>
                                <group string="Tiêu đề &amp; Mô tả">
                                    <field name="pmax_headline_1" placeholder="VD: Khuyến mãi cuối năm"/>
                                    <field name="pmax_headline_2" placeholder="VD: Giảm giá 50% toàn tập"/>
                                    <field name="pmax_headline_3" placeholder="VD: Giao hàng hỏa tốc"/>
                                    <field name="pmax_long_headline" placeholder="VD: Mua sắm thả ga không lo về giá - Độc quyền tại hệ thống"/>
                                    <field name="pmax_description_1" placeholder="VD: Cam kết chất lượng dịch vụ hàng đầu thị trường."/>
                                    <field name="pmax_description_2" placeholder="VD: Miễn phí đổi trả trong vòng 7 ngày nếu không hài lòng."/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                    
                    <field name="hero_header_html" widget="html" readonly="1" invisible="not id"/>
                    
                    <field name="performance_dashboard_html" widget="html" readonly="1" invisible="not id"/>

                    <div class="row">
                        <div class="col-12">
                            <div class="o_premium_card">
                                <h4 class="mb-4 text-success fw-bold"><i class="fa fa-line-chart me-2"></i>Danh Sách Sản Phẩm Trong Chiến Dịch</h4>
                                <div class="alert alert-info border-0 shadow-sm rounded-3 mb-4">
                                    <i class="fa fa-info-circle me-1"></i> Sản phẩm được tự động liệt kê dựa trên các dòng trong <b>Product Feed</b> có chọn chiến dịch này.
                                </div>
                                <field name="feed_line_ids" nolabel="1">
                                    <list>
                                        <field name="product_id"/>
                                        <field name="product_default_code" string="SKU" optional="show"/>
                                        <field name="qty_available" string="Tồn Thực"/>
                                        <field name="avg_daily_sales" string="Bán/Ngày" optional="show"/>
                                        <field name="stock_status" string="Tình Trạng" widget="badge"
                                               decoration-danger="stock_status == 'critical'"
                                               decoration-warning="stock_status == 'low'"
                                               decoration-success="stock_status == 'normal'"/>
                                    </list>
                                </field>
                                <group class="mt-3">
                                    <group>
                                        <field name="impressions" readonly="1" string="Tổng Lượt Hiển Thị"/>
                                        <field name="conversion_rate" widget="progressbar" readonly="1"/>
                                    </group>
                                </group>
                            </div>
                        </div>
                    </div>

                    <notebook>
                        <page name="app_settings" string="📱 Cấu hình Ứng dụng" invisible="channel_type != 'MULTI_CHANNEL'">
                            <div class="o_premium_card border-0 bg-light">
                                <h4 class="mb-4 text-primary fw-bold"><i class="fa fa-mobile me-2"></i>Thông Tin Ứng dụng</h4>
                                <div class="alert alert-warning border-0 shadow-sm rounded-3 mb-4">
                                    <i class="fa fa-info-circle me-1"></i> Đối với chiến dịch <b>Đa kênh (App)</b>, ID ứng dụng là trường thông tin bắt buộc.
                                </div>
                                <group>
                                    <group>
                                        <field name="app_id" placeholder="VD: com.myapp.android" required="channel_type == 'MULTI_CHANNEL'"/>
                                        <field name="app_store" required="channel_type == 'MULTI_CHANNEL'"/>
                                    </group>
                                    <group>
                                        <field name="app_bidding_goal" required="channel_type == 'MULTI_CHANNEL'"/>
                                    </group>
                                </group>
                            </div>
                        </page>
                        <page name="adsroid_history" string="🪄 Lịch sử AI Adsroid">
                            <div class="row mt-2 mb-4" invisible="not adsroid_last_insight">
                                <div class="col-12">
                                    <div class="o_premium_card border-0 bg-light">
                                        <h4 class="mb-3 text-info fw-bold"><i class="fa fa-magic me-2"></i>Nhận định gần nhất</h4>
                                        <field name="adsroid_last_insight" widget="html" nolabel="1"/>
                                    </div>
                                </div>
                            </div>
                            <field name="adsroid_log_ids">
                                <list default_order="create_date desc">
                                    <field name="create_date" string="Thời gian"/>
                                    <field name="score" string="Score"/>
                                    <field name="suggested_action" widget="badge" 
                                           decoration-danger="suggested_action == 'PAUSE'"
                                           decoration-warning="suggested_action == 'DECREASE_BUDGET'"
                                           decoration-success="suggested_action == 'MAINTAIN'"/>
                                    <field name="insight"/>
                                    <field name="is_applied" widget="boolean_invisible" string="Tự Xử Lý"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_google_ads_campaign" model="ir.actions.act_window">
        <field name="name">Chiến Dịch</field>
        <field name="res_model">google.ads.campaign</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
