<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_google_ads_campaign_tree" model="ir.ui.view">
        <field name="name">google.ads.campaign.list</field>
        <field name="model">google.ads.campaign</field>
        <field name="arch" type="xml">
            <list string="Chiến Dịch Google Ads" create="false" edit="false">
                <field name="name"/>
                <field name="account_id"/>
                <field name="channel_type"/>
                <field name="clicks"/>
                <field name="impressions"/>
                <field name="cost"/>
                <field name="conversions"/>
                <field name="status" widget="badge" decoration-success="status == 'enabled'" decoration-info="status == 'paused'" decoration-danger="status == 'removed'"/>
            </list>
        </field>
    </record>

    <record id="action_google_ads_campaign" model="ir.actions.act_window">
        <field name="name">Chiến Dịch</field>
        <field name="res_model">google.ads.campaign</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
