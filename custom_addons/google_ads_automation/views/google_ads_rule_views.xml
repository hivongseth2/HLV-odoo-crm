<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_google_ads_rule_form" model="ir.ui.view">
        <field name="name">google.ads.rule.form</field>
        <field name="model">google.ads.rule</field>
        <field name="arch" type="xml">
            <form string="Quy Tắc Google Ads" class="o_google_ads_premium_form">
                <header>
                    <button name="run_rule" string="Kích Hoạt Quy Tắc Ngay" type="object" class="btn-primary"/>
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <field name="hero_header_html" widget="html" readonly="1"/>

                    <div class="oe_title mb-3 border-bottom pb-2">
                        <h1 class="d-flex align-items-center">
                            <field name="name" placeholder="Tên quy tắc..." class="oe_inline"/>
                        </h1>
                    </div>

                    <div class="o_premium_card mb-4 mt-n4 shadow-lg border-0">
                        <div class="row align-items-center">
                            <div class="col-md-5">
                                <div class="o_logic_builder">
                                    <span class="o_logic_tag">IF</span>
                                    <div class="d-flex flex-column flex-grow-1">
                                        <field name="condition_field" class="fw-bold text-primary"/>
                                        <div class="d-flex align-items-center gap-2 mt-1">
                                            <field name="condition_operator" class="text-muted small"/>
                                            <field name="condition_value" class="badge text-bg-light border"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-2 text-center text-muted">
                                <i class="fa fa-long-arrow-right fa-2x"></i>
                            </div>
                            <div class="col-md-5">
                                <div class="o_logic_builder" style="border-left-color: #10B981;">
                                    <span class="o_logic_tag bg-success">THEN</span>
                                    <div class="d-flex flex-column flex-grow-1">
                                        <field name="action_type" class="fw-bold text-success"/>
                                        <field name="action_value" class="text-muted small mt-1" 
                                               invisible="action_type not in ('increase_budget', 'decrease_budget')"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-lg-6">
                            <div class="o_premium_card">
                                <h5 class="text-secondary fw-bold mb-3"><i class="fa fa-cog me-2"></i>Liên Kết Hệ Thống</h5>
                                <group>
                                    <field name="account_id" options="{'no_create': True}" readonly="auto_generated"/>
                                    <field name="target_type"/>
                                    <field name="strategy_id" readonly="1" invisible="not strategy_id"/>
                                    <field name="product_feed_line_id" readonly="1" invisible="not product_feed_line_id"/>
                                </group>
                            </div>
                        </div>
                        <div class="col-lg-6">
                             <div class="o_premium_card bg-light border-0">
                                <h5 class="text-secondary fw-bold mb-3"><i class="fa fa-terminal me-2"></i>Thông Tin Kỹ Thuật</h5>
                                <p class="text-muted small">Quy tắc này được thực thi tự động qua Cron Job hoặc kích hoạt thủ công. Trạng thái hoạt động quyết định việc áp dụng lên Google Ads.</p>
                                <field name="auto_generated" readonly="1"/>
                             </div>
                        </div>
                    </div>

                    <div class="o_premium_card mt-4 p-0 overflow-hidden">
                        <div class="bg-light p-3 border-bottom d-flex justify-content-between align-items-center">
                            <h5 class="m-0 fw-bold"><i class="fa fa-history me-2"></i>Lịch Sử Thực Thi</h5>
                        </div>
                        <field name="log_ids" readonly="1">
                            <list class="table-hover">
                                <field name="run_date"/>
                                <field name="target_name"/>
                                <field name="status" widget="badge"
                                       decoration-success="status == 'success'"
                                       decoration-warning="status == 'action_taken'"
                                       decoration-danger="status == 'error'"/>
                                <field name="message"/>
                            </list>
                        </field>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_google_ads_rule_list" model="ir.ui.view">
        <field name="name">google.ads.rule.list</field>
        <field name="model">google.ads.rule</field>
        <field name="arch" type="xml">
            <list string="Quy Tắc Tự Động Hóa">
                <field name="name"/>
                <field name="auto_generated" widget="boolean"/>
                <field name="account_id"/>
                <field name="target_type"/>
                <field name="condition_field"/>
                <field name="condition_operator"/>
                <field name="condition_value"/>
                <field name="action_type"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_google_ads_rule_kanban" model="ir.ui.view">
        <field name="name">google.ads.rule.kanban</field>
        <field name="model">google.ads.rule</field>
        <field name="arch" type="xml">
            <kanban default_group_by="action_type" class="o_kanban_mobile" records_draggable="false" quick_create="false">
                <field name="name"/>
                <field name="active"/>
                <field name="action_type"/>
                <field name="condition_field"/>
                <field name="condition_operator"/>
                <field name="condition_value"/>
                <field name="auto_generated"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click oe_kanban_card">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title fs-5">
                                        <field name="name"/>
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body mt-2 mb-2">
                                <span class="badge text-bg-info" t-if="record.auto_generated.raw_value">
                                    <i class="fa fa-robot me-1"/> Tự Sinh
                                </span>
                                <div class="mt-2 text-muted" style="font-size: 0.9em;">
                                    <strong>IF:</strong> <field name="condition_field"/> <field name="condition_operator"/> <field name="condition_value"/>
                                </div>
                                <div class="text-success" style="font-size: 0.9em;">
                                    <strong>THEN:</strong> <field name="action_type"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom mt-auto">
                                <div class="oe_kanban_bottom_left">
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="active" widget="boolean_toggle"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_google_ads_rule" model="ir.actions.act_window">
        <field name="name">Quy Tắc Tự Động</field>
        <field name="res_model">google.ads.rule</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="view_google_ads_rule_log_list" model="ir.ui.view">
        <field name="name">google.ads.rule.log.list</field>
        <field name="model">google.ads.rule.log</field>
        <field name="arch" type="xml">
            <list string="Lịch Sử Chạy Quy Tắc" 
                  decoration-danger="status == 'error'" 
                  decoration-warning="status == 'action_taken'" 
                  decoration-success="status == 'success'">
                <field name="create_date" string="Thời Gian"/>
                <field name="rule_id"/>
                <field name="target_name"/>
                <field name="status" widget="badge" 
                       decoration-danger="status == 'error'" 
                       decoration-warning="status == 'action_taken'" 
                       decoration-success="status == 'success'"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="action_google_ads_rule_log" model="ir.actions.act_window">
        <field name="name">Lịch Sử Chạy Quy Tắc</field>
        <field name="res_model">google.ads.rule.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
