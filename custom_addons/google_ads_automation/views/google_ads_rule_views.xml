<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- Rule – Form View (Redesigned)                    -->
    <!-- ═══════════════════════════════════════════════ -->
    <record id="view_google_ads_rule_form" model="ir.ui.view">
        <field name="name">google.ads.rule.form</field>
        <field name="model">google.ads.rule</field>
        <field name="arch" type="xml">
            <form string="Quy Tắc Tự Động" class="o_google_ads_premium_form">
                <header>
                    <button name="run_rule" string="▶ Chạy Ngay" type="object" class="btn-primary"
                            help="Kiểm tra điều kiện và thực thi hành động ngay lập tức (không cần đợi cron)"/>
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <field name="auto_generated" invisible="1"/>

                    <!-- Banner cho rule tự sinh -->
                    <div class="alert alert-info border-0 d-flex align-items-center gap-2 mb-3" invisible="not auto_generated">
                        <i class="fa fa-magic fa-lg"/>
                        <div>
                            Rule này được <b>tự động sinh</b> từ chiến lược.
                            <field name="strategy_id" readonly="1" class="d-inline fw-bold"/>
                        </div>
                    </div>

                    <div class="oe_title mb-3">
                        <label for="name" string="Tên quy tắc"/>
                        <h1><field name="name" placeholder="VD: Dừng QC khi hết hàng SP ABC"/></h1>
                    </div>

                    <!-- ══ Logic Builder: IF → THEN ══ -->
                    <div class="o_premium_card mb-4 shadow-sm">
                        <h5 class="text-primary fw-bold mb-3 border-bottom pb-2">
                            <i class="fa fa-code-fork me-2"/>Logic Quy Tắc
                        </h5>
                        <div class="row align-items-center">
                            <div class="col-md-5">
                                <div class="o_logic_builder">
                                    <span class="o_logic_tag">NẾU</span>
                                    <div class="d-flex flex-column flex-grow-1">
                                        <field name="condition_field" class="fw-bold text-primary" string="Trường kiểm tra"/>
                                        <div class="d-flex align-items-center gap-2 mt-2">
                                            <field name="condition_operator" class="text-muted"/>
                                            <field name="condition_value" class="badge text-bg-light border fs-6" string="Giá trị"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-2 text-center text-muted py-3">
                                <i class="fa fa-long-arrow-right fa-2x"/>
                            </div>
                            <div class="col-md-5">
                                <div class="o_logic_builder" style="border-left-color: #10B981;">
                                    <span class="o_logic_tag bg-success">THÌ</span>
                                    <div class="d-flex flex-column flex-grow-1">
                                        <field name="action_type" class="fw-bold text-success" string="Hành động"/>
                                        <field name="action_value" class="text-muted small mt-1" 
                                               invisible="action_type not in ('increase_budget', 'decrease_budget')"
                                               string="Thay đổi (%)"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Giải thích tóm tắt logic -->
                        <div class="alert alert-light border mt-3 mb-0 text-muted small">
                            <i class="fa fa-lightbulb-o me-1 text-warning"/>
                            <b>Ví dụ:</b> Nếu chọn <em>Tồn Kho Thực Tế</em> — <em>Nhỏ hơn</em> — <em>20</em> → <em>Tạm Dừng</em>: 
                            hệ thống sẽ tự động dừng chiến dịch khi sản phẩm liên quan có ít hơn 20 cái trong kho.
                        </div>
                    </div>

                    <!-- ══ Cấu hình áp dụng ══ -->
                    <div class="o_premium_card mb-4">
                        <h5 class="text-secondary fw-bold mb-3 border-bottom pb-2">
                            <i class="fa fa-bullseye me-2"/>Phạm vi áp dụng
                        </h5>
                        <group>
                            <group>
                                <field name="account_id" options="{'no_create': True}" readonly="auto_generated"
                                       string="Tài khoản Google Ads"/>
                                <field name="target_type" string="Áp dụng cho"
                                       help="Chiến dịch = toàn bộ campaign. Nhóm QC = ad group cụ thể."/>
                            </group>
                            <group>
                                <field name="product_feed_line_id" readonly="1" invisible="not product_feed_line_id"
                                       string="Sản phẩm liên kết"/>
                            </group>
                        </group>
                    </div>

                    <!-- ══ Lịch sử thực thi ══ -->
                    <div class="o_premium_card p-0 overflow-hidden">
                        <div class="bg-light p-3 border-bottom d-flex justify-content-between align-items-center">
                            <h5 class="m-0 fw-bold"><i class="fa fa-history me-2"/>Lịch Sử Thực Thi</h5>
                        </div>
                        <field name="log_ids" readonly="1" create="0" edit="0" delete="0">
                            <list class="table-hover" default_order="run_date desc">
                                <field name="run_date" string="Thời gian"/>
                                <field name="target_name" string="Đối tượng"/>
                                <field name="status" widget="badge" string="Kết quả"
                                       decoration-success="status == 'success'"
                                       decoration-warning="status == 'action_taken'"
                                       decoration-danger="status == 'error'"/>
                                <field name="message" string="Chi tiết"/>
                            </list>
                        </field>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- Rule – List View                                 -->
    <!-- ═══════════════════════════════════════════════ -->
    <record id="view_google_ads_rule_list" model="ir.ui.view">
        <field name="name">google.ads.rule.list</field>
        <field name="model">google.ads.rule</field>
        <field name="arch" type="xml">
            <list string="Quy Tắc Tự Động Hóa" decoration-muted="not active">
                <field name="name" string="Tên quy tắc"/>
                <field name="auto_generated" widget="boolean" string="Tự sinh"/>
                <field name="account_id" string="Tài khoản" optional="hide"/>
                <field name="target_type" string="Áp dụng cho"/>
                <field name="condition_field" string="NẾU"/>
                <field name="condition_operator" string="So sánh"/>
                <field name="condition_value" string="Ngưỡng"/>
                <field name="action_type" string="THÌ" widget="badge"
                       decoration-danger="action_type == 'pause'"
                       decoration-success="action_type == 'enable'"
                       decoration-warning="action_type in ('increase_budget', 'decrease_budget')"/>
                <field name="active" widget="boolean_toggle" string="Bật"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- Rule – Kanban View                               -->
    <!-- ═══════════════════════════════════════════════ -->
    <record id="view_google_ads_rule_kanban" model="ir.ui.view">
        <field name="name">google.ads.rule.kanban</field>
        <field name="model">google.ads.rule</field>
        <field name="arch" type="xml">
            <kanban default_group_by="action_type" class="o_kanban_mobile" records_draggable="false" quick_create="false">
                <field name="name"/>
                <field name="active"/>
                <field name="action_type"/>
                <field name="condition_field"/>
                <field name="condition_operator"/>
                <field name="condition_value"/>
                <field name="auto_generated"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click oe_kanban_card">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body mt-2 mb-2">
                                <span class="badge text-bg-info me-1" t-if="record.auto_generated.raw_value">
                                    <i class="fa fa-magic me-1"/>Tự sinh
                                </span>
                                <div class="mt-2 text-muted" style="font-size: 0.9em;">
                                    <strong class="text-primary">NẾU</strong> <field name="condition_field"/> <field name="condition_operator"/> <field name="condition_value"/>
                                </div>
                                <div class="text-success" style="font-size: 0.9em;">
                                    <strong class="text-success">THÌ</strong> <field name="action_type"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom mt-auto">
                                <div class="oe_kanban_bottom_left">
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="active" widget="boolean_toggle"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- Rule – Action                                    -->
    <!-- ═══════════════════════════════════════════════ -->
    <record id="action_google_ads_rule" model="ir.actions.act_window">
        <field name="name">Quy Tắc Tự Động</field>
        <field name="res_model">google.ads.rule</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- Rule Log – Views                                 -->
    <!-- ═══════════════════════════════════════════════ -->
    <record id="view_google_ads_rule_log_list" model="ir.ui.view">
        <field name="name">google.ads.rule.log.list</field>
        <field name="model">google.ads.rule.log</field>
        <field name="arch" type="xml">
            <list string="Lịch Sử Chạy Quy Tắc" 
                  create="0" edit="0" delete="0"
                  decoration-danger="status == 'error'" 
                  decoration-warning="status == 'action_taken'" 
                  decoration-success="status == 'success'">
                <field name="create_date" string="Thời Gian"/>
                <field name="rule_id" string="Quy tắc"/>
                <field name="target_name" string="Đối tượng"/>
                <field name="status" widget="badge" string="Kết quả"
                       decoration-danger="status == 'error'" 
                       decoration-warning="status == 'action_taken'" 
                       decoration-success="status == 'success'"/>
                <field name="message" string="Chi tiết"/>
            </list>
        </field>
    </record>
 
    <record id="view_google_ads_rule_log_form" model="ir.ui.view">
        <field name="name">google.ads.rule.log.form</field>
        <field name="model">google.ads.rule.log</field>
        <field name="arch" type="xml">
            <form string="Chi Tiết Lịch Sử" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="rule_id" readonly="1"/>
                            <field name="target_name" readonly="1"/>
                        </group>
                        <group>
                            <field name="run_date" readonly="1"/>
                            <field name="status" readonly="1"/>
                        </group>
                    </group>
                    <group string="Nội Dung Chi Tiết">
                        <field name="message" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_google_ads_rule_log" model="ir.actions.act_window">
        <field name="name">Lịch Sử Chạy Quy Tắc</field>
        <field name="res_model">google.ads.rule.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False, 'delete': False}</field>
    </record>
</odoo>
