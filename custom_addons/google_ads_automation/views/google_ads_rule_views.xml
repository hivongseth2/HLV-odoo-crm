<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_google_ads_rule_form" model="ir.ui.view">
        <field name="name">google.ads.rule.form</field>
        <field name="model">google.ads.rule</field>
        <field name="arch" type="xml">
            <form string="Quy Tắc Google Ads">
                <header>
                    <button name="run_rule" string="▶ Chạy Thử Ngay" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Tự Sinh" bg_color="text-bg-info"
                            invisible="not auto_generated"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Tên quy tắc..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Cấu Hình Cơ Bản">
                            <field name="active" widget="boolean_toggle"/>
                            <field name="account_id"/>
                            <field name="target_type"/>
                            <field name="auto_generated" readonly="1"/>
                            <field name="strategy_id" readonly="1"
                                   invisible="not auto_generated"/>
                            <field name="product_feed_line_id" readonly="1"
                                   invisible="not auto_generated"/>
                        </group>
                        <group string="Điều Kiện">
                            <field name="condition_field"/>
                            <field name="condition_operator"/>
                            <field name="condition_value"/>
                        </group>
                    </group>
                    <group>
                        <group string="Hành Động">
                            <field name="action_type"/>
                            <field name="action_value"
                                   invisible="action_type not in ('increase_budget', 'decrease_budget')"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lịch Sử Chạy" icon="fa-history">
                            <field name="log_ids" readonly="1">
                                <list>
                                    <field name="run_date"/>
                                    <field name="target_name"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'success'"
                                           decoration-warning="status == 'action_taken'"
                                           decoration-danger="status == 'error'"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_google_ads_rule_list" model="ir.ui.view">
        <field name="name">google.ads.rule.list</field>
        <field name="model">google.ads.rule</field>
        <field name="arch" type="xml">
            <list string="Quy Tắc Tự Động Hóa">
                <field name="name"/>
                <field name="auto_generated" widget="boolean"/>
                <field name="account_id"/>
                <field name="target_type"/>
                <field name="condition_field"/>
                <field name="condition_operator"/>
                <field name="condition_value"/>
                <field name="action_type"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_google_ads_rule" model="ir.actions.act_window">
        <field name="name">Quy Tắc Tự Động</field>
        <field name="res_model">google.ads.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_google_ads_rule_log" model="ir.actions.act_window">
        <field name="name">Lịch Sử Chạy Quy Tắc</field>
        <field name="res_model">google.ads.rule.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
