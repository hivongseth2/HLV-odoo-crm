<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_google_ads_ad_group_list" model="ir.ui.view">
        <field name="name">google.ads.ad.group.list</field>
        <field name="model">google.ads.ad.group</field>
        <field name="arch" type="xml">
            <list string="Nhóm Quảng Cáo Google Ads">
                <field name="name"/>
                <field name="campaign_id"/>
                <field name="type_id"/>
                <field name="clicks" sum="Tổng Click" optional="show"/>
                <field name="cost" sum="Tổng Chi Phí" optional="show"/>
                <field name="conversions" sum="Tổng Đơn" optional="show"/>
                <field name="conversion_rate" widget="progressbar" string="Tỷ Lệ CĐ (%)" optional="show"/>
                <field name="roas" string="ROAS" widget="badge" 
                       decoration-success="roas &gt;= 3" 
                       decoration-danger="roas &lt; 1" 
                       decoration-warning="roas &gt;= 1 and roas &lt; 3"
                       optional="show"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'enabled'"
                       decoration-muted="status == 'paused'"
                       decoration-danger="status == 'removed'"/>
            </list>
        </field>
    </record>

    <record id="view_google_ads_ad_group_form" model="ir.ui.view">
        <field name="name">google.ads.ad.group.form</field>
        <field name="model">google.ads.ad.group</field>
        <field name="arch" type="xml">
            <form string="Nhóm Quảng Cáo Google Ads" class="o_google_ads_premium_form">
                <header>
                    <button name="action_sync_to_google" string="Đồng bộ lên Google" 
                            type="object" class="btn-primary" 
                            invisible="state == 'synced'"/>
                    
                    <button name="action_pause_on_google" string="⏸️ Tạm dừng trên Google"
                            type="object" class="btn-secondary"
                            invisible="state != 'synced' or status == 'paused'"/>
                            
                    <button name="action_enable_on_google" string="▶️ Kích hoạt trên Google"
                            type="object" class="btn-success"
                            invisible="state != 'synced' or status == 'enabled'"/>

                    <button name="action_remove_from_google_only" string="🗑️ Xóa khỏi Google Ads"
                            type="object" class="btn-danger"
                            invisible="state != 'synced'"
                            confirm="⚠️ Bạn có chắc chắn muốn XÓA nhóm quảng cáo này trên Google Ads?&#10;&#10;- Nhóm sẽ bị gỡ bỏ vĩnh viễn trên nền tảng Google.&#10;- Bản ghi Odoo sẽ được GIỮ LẠI và chuyển về trạng thái 'Nháp' để bạn có thể đồng bộ lại sau này."/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,synced"/>
                </header>
                <sheet>
                    <field name="hero_header_html" widget="html" readonly="1"/>
                    
                    <div class="o_premium_card border-0 bg-light-subtle mb-4" >
                        <group string="Thông Tin Kỹ Thuật">
                            <field name="name" class="oe_inline fw-bold" placeholder="Tên Nhóm..." readonly="state == 'synced'"/>
                            <field name="campaign_id" options="{'no_create': True}" 
                                   domain="[('channel_type', 'not in', ['PERFORMANCE_MAX', 'MULTI_CHANNEL', 'SMART'])]"
                                   readonly="state == 'synced'"/>
                            <field name="campaign_channel_type" invisible="1"/>
                            <field name="is_campaign_dsa" invisible="1"/>
                            <field name="type_id" 
                                   options="{'no_create': True, 'no_open': True}"
                                   domain="[('compatible_channel_types', 'ilike', campaign_channel_type), ('is_dsa_only', '=', is_campaign_dsa)]"
                                   readonly="state == 'synced'"/>
                            <field name="type" invisible="1"/>
                            <field name="status" readonly="state == 'synced'"/>
                            <field name="campaign_product_ids" invisible="1"/>
                            <label for="product_ids" string="Sản Phẩm"/>
                            <div class="d-flex align-items-center">
                                <field name="product_ids" widget="many2many_tags" 
                                       options="{'no_create': True}"
                                       class="flex-grow-1"/>
                                <button name="action_pull_products_from_campaign" 
                                        string=" Lấy SP từ chiến dịch" 
                                        type="object" 
                                        class="btn-link p-0 ms-2" 
                                        icon="fa-download"
                                        title="Tự động lấy toàn bộ sản phẩm từ chiến dịch cha"
                                        invisible="state == 'synced' or not campaign_id"/>
                            </div>
                            <field name="google_ad_group_id" readonly="1" invisible="state == 'draft'"/>
                        </group>
                    </div>

                    <field name="performance_dashboard_html" widget="html" readonly="1" invisible="not id"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_google_ads_ad_group" model="ir.actions.act_window">
        <field name="name">Nhóm Quảng Cáo</field>
        <field name="res_model">google.ads.ad.group</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
