<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_google_ads_ad_group_list" model="ir.ui.view">
        <field name="name">google.ads.ad.group.list</field>
        <field name="model">google.ads.ad.group</field>
        <field name="arch" type="xml">
            <list string="Nhóm Quảng Cáo Google Ads">
                <field name="name"/>
                <field name="campaign_id"/>
                <field name="type"/>
                <field name="clicks" sum="Tổng Click" optional="show"/>
                <field name="cost" sum="Tổng Chi Phí" optional="show"/>
                <field name="conversions" sum="Tổng Đơn" optional="show"/>
                <field name="conversion_rate" widget="progressbar" string="Tỷ Lệ CĐ (%)" optional="show"/>
                <field name="roas" string="ROAS" widget="badge" 
                       decoration-success="roas &gt;= 3" 
                       decoration-danger="roas &lt; 1" 
                       decoration-warning="roas &gt;= 1 and roas &lt; 3"
                       optional="show"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'enabled'"
                       decoration-muted="status == 'paused'"
                       decoration-danger="status == 'removed'"/>
            </list>
        </field>
    </record>

    <record id="view_google_ads_ad_group_form" model="ir.ui.view">
        <field name="name">google.ads.ad.group.form</field>
        <field name="model">google.ads.ad.group</field>
        <field name="arch" type="xml">
            <form string="Nhóm Quảng Cáo Google Ads" class="o_google_ads_premium_form">
                <header>
                    <button name="action_sync_to_google" string="Đồng bộ lên Google" 
                            type="object" class="btn-primary" 
                            invisible="state == 'synced'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,synced"/>
                </header>
                <sheet>
                    <field name="hero_header_html" widget="html" readonly="1"/>
                    
                    <div class="o_premium_card border-0 bg-light-subtle mb-4" >
                        <group string="Thông Tin Kỹ Thuật">
                            <field name="name" class="oe_inline fw-bold" placeholder="Tên Nhóm..." readonly="state == 'synced'"/>
                            <field name="campaign_id" options="{'no_create': True}" readonly="state == 'synced'"/>
                            <field name="type" readonly="state == 'synced'"/>
                            <field name="status" readonly="state == 'synced'"/>
                            <field name="product_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="google_ad_group_id" readonly="1" invisible="state == 'draft'"/>
                        </group>
                    </div>

                    <group>
                        <group string="Hiệu Suất Quảng Cáo">
                            <field name="clicks" readonly="1"/>
                            <field name="impressions" readonly="1"/>
                            <field name="cost" readonly="1"/>
                            <field name="conversions" readonly="1"/>
                            <field name="conversion_rate" widget="progressbar" readonly="1"/>
                            <field name="roas" readonly="1" widget="badge"
                                   decoration-success="roas &gt;= 3" 
                                   decoration-danger="roas &lt; 1" 
                                   decoration-warning="roas &gt;= 1 and roas &lt; 3"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_google_ads_ad_group" model="ir.actions.act_window">
        <field name="name">Nhóm Quảng Cáo</field>
        <field name="res_model">google.ads.ad.group</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
