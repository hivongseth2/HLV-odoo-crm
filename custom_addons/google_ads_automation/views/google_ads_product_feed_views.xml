<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- Product Feed – List View                        -->
    <!-- ═══════════════════════════════════════════════ -->
    <record id="view_google_ads_product_feed_list" model="ir.ui.view">
        <field name="name">google.ads.product.feed.list</field>
        <field name="model">google.ads.product.feed</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="account_id"/>
                <field name="line_count"/>
                <field name="strategy_count"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- Product Feed – Form View                        -->
    <!-- ═══════════════════════════════════════════════ -->
    <record id="view_google_ads_product_feed_form" model="ir.ui.view">
        <field name="name">google.ads.product.feed.form</field>
        <field name="model">google.ads.product.feed</field>
        <field name="arch" type="xml">
            <form string="Product Feed" class="o_google_ads_premium_form">
                <header>
                    <button name="action_refresh_stock" string="Cập Nhật Tồn Kho" type="object" class="btn-primary"/>
                    <button name="action_add_products_wizard" string="Thêm Sản Phẩm" type="object" class="btn-success"/>
                    <button name="action_view_strategies" string="Cấu Hình Chiến Lược" type="object" class="btn-secondary"/>
                    <field name="active" widget="statusbar" statusbar_visible="True,False"/>
                </header>
                <sheet>
                    <field name="hero_header_html" widget="html" readonly="1"/>

                    <div class="row align-items-center mb-4 px-3" style="margin-top: -80px; position: relative; z-index: 10;">
                        <div class="col-lg-6">
                             <h1 class="text-white">
                                <field name="name" placeholder="Tên Feed sản phẩm..." class="oe_inline"/>
                            </h1>
                        </div>
                    </div>

                    <div class="o_kpi_dashboard">
                        <div class="o_kpi_tile shadow-lg border-0 bg-white">
                            <span class="o_kpi_label">CHIẾN LƯỢC ĐANG CHẠY</span>
                            <span class="o_kpi_value text-amber"><field name="strategy_count"/></span>
                        </div>
                        <div class="o_kpi_tile shadow-lg border-0 bg-white">
                            <span class="o_kpi_label">TRẠNG THÁI FEED</span>
                            <span class="o_kpi_value text-success" style="font-size: 14px; padding-top: 10px;">
                                <i class="fa fa-check-circle me-1"></i> Hoạt Động
                            </span>
                        </div>
                    </div>

                    <notebook>
                        <page string="Danh Mục Sản Phẩm" icon="fa-th-list">
                            <div class="o_premium_card p-0 mt-3 border-0 shadow-sm overflow-hidden">
                                <field name="line_ids" mode="list">
                                    <list editable="bottom" limit="50" class="table-hover">
                                        <field name="product_default_code" optional="show" class="fw-bold"/>
                                        <field name="product_id"/>
                                        <field name="qty_available" string="Tồn Thực" 
                                               decoration-danger="qty_available &lt;= 0"
                                               decoration-warning="qty_available &gt; 0 and qty_available &lt; 10"
                                               sum="Tổng Tồn" class="text-end"/>
                                        <field name="avg_daily_sales" string="Vận Tốc"
                                               decoration-info="avg_daily_sales &gt; 5"
                                               sum="Tổng Vận Tốc" class="text-end"/>
                                        <field name="stock_status" string="Tình Trạng" widget="badge"
                                               decoration-danger="stock_status == 'critical'"
                                               decoration-warning="stock_status == 'low'"
                                               decoration-success="stock_status == 'normal'"
                                               decoration-info="stock_status == 'high'"/>
                                        <field name="days_of_stock" string="Dự Kiến Tồn"
                                               decoration-danger="days_of_stock &lt; 7"
                                               decoration-warning="days_of_stock &gt;= 7 and days_of_stock &lt; 20"
                                               optional="show" class="text-end"/>
                                        <field name="margin_percent" string="LN (%)" widget="badge"
                                               decoration-danger="margin_percent &lt; 15"
                                               decoration-warning="margin_percent &gt;= 15 and margin_percent &lt; 25"
                                               decoration-success="margin_percent &gt;= 25"
                                               optional="show"/>
                                        <field name="campaign_ids" widget="many2many_tags" optional="show"/>
                                    </list>
                                </field>
                            </div>
                        </page>
                        <page string="Ghi Chú &amp; Lịch Sử" icon="fa-file-text-o">
                            <div class="o_premium_card border-0 bg-light">
                                <h5 class="text-secondary fw-bold mb-3">Ghi chú quản lý</h5>
                                <field name="note" placeholder="Nhập ghi chú quan trọng về Feed sản phẩm này..." class="border-0 bg-transparent"/>
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- Product Feed – Action                           -->
    <!-- ═══════════════════════════════════════════════ -->
    <record id="action_google_ads_product_feed" model="ir.actions.act_window">
        <field name="name">Product Feed</field>
        <field name="res_model">google.ads.product.feed</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
