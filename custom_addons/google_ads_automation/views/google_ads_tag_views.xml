<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ══════════  List View  ══════════ -->
    <record id="view_google_ads_tag_list" model="ir.ui.view">
        <field name="name">google.ads.tag.list</field>
        <field name="model">google.ads.tag</field>
        <field name="arch" type="xml">
            <list string="Google Tag / GTM">
                <field name="name"/>
                <field name="account_id"/>
                <field name="tag_type"/>
                <field name="gtm_container_id"/>
                <field name="measurement_id"/>
                <field name="gtm_tag_count"/>
                <field name="gtm_trigger_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ══════════  Form View  ══════════ -->
    <record id="view_google_ads_tag_form" model="ir.ui.view">
        <field name="name">google.ads.tag.form</field>
        <field name="model">google.ads.tag</field>
        <field name="arch" type="xml">
            <form string="Cấu Hình Google Tag">
                <header>
                    <button name="action_sync_from_gtm"
                            string="Đồng Bộ Từ GTM"
                            type="object"
                            class="oe_highlight"
                            invisible="tag_type != 'gtm'"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-tags"
                                invisible="gtm_tag_count == 0">
                            <field name="gtm_tag_count" string="Tags" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-bolt"
                                invisible="gtm_trigger_count == 0">
                            <field name="gtm_trigger_count" string="Triggers" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-cube"
                                invisible="gtm_variable_count == 0">
                            <field name="gtm_variable_count" string="Bien" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="VD: GTM Production"/></h1>
                    </div>
                    <group>
                        <group string="Cai Dat Chung">
                            <field name="account_id"/>
                            <field name="tag_type" widget="radio"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="ID Dinh Danh">
                            <field name="gtm_container_id"
                                   placeholder="GTM-XXXXXXX"
                                   invisible="tag_type != 'gtm'"/>
                            <field name="gtm_account_id"
                                   placeholder="123456789"
                                   invisible="tag_type != 'gtm'"/>
                            <field name="gtm_api_token"
                                   placeholder="OAuth2 Access Token"
                                   password="True"
                                   invisible="tag_type != 'gtm'"/>
                            <field name="measurement_id"
                                   placeholder="AW-XXXXXXXXX hoac G-XXXXXXXXXX"
                                   invisible="tag_type != 'gtag'"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Tab: Thanh Phan GTM da dong bo -->
                        <page string="Thanh Phan GTM" icon="fa-list"
                              invisible="tag_type != 'gtm'">
                            <div class="alert alert-info" invisible="gtm_tag_count > 0">
                                Nhan nut "Dong Bo Tu GTM" o tren de keo du lieu Tags, Triggers va Variables tu Google Tag Manager ve Odoo.
                            </div>
                            <field name="gtm_item_ids" readonly="1">
                                <list string="Thanh Phan GTM" create="false" edit="false" delete="false">
                                    <field name="item_type" widget="badge"
                                           decoration-info="item_type == 'tag'"
                                           decoration-success="item_type == 'trigger'"
                                           decoration-warning="item_type == 'variable'"/>
                                    <field name="name"/>
                                    <field name="tag_subtype"
                                           invisible="item_type != 'tag'"/>
                                    <field name="trigger_subtype"
                                           invisible="item_type != 'trigger'"/>
                                    <field name="firing_trigger_names"
                                           invisible="item_type != 'tag'"/>
                                    <field name="is_paused" widget="boolean_toggle"/>
                                    <field name="notes" optional="hide"/>
                                    <field name="last_synced"/>
                                </list>
                            </field>
                        </page>

                        <!-- Tab: Conversion Actions -->
                        <page string="Conversion Actions" icon="fa-bullseye">
                            <field name="conversion_action_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="action_type"/>
                                    <field name="conversion_id" placeholder="123456789"/>
                                    <field name="conversion_label" placeholder="AbCdEfGhIjK"/>
                                </list>
                            </field>
                        </page>

                        <!-- Tab: Code cho <head> -->
                        <page string="Code Dan Vao head" icon="fa-code">
                            <div class="alert alert-info">
                                Copy doan code ben duoi va dan vao <code>&lt;head&gt;</code> cua tat ca trang WordPress
                                (hoac dung plugin <b>WPCode</b>).
                            </div>
                            <field name="snippet_head" widget="code" readonly="1"
                                   options="{'mode': 'html'}"/>
                        </page>

                        <!-- Tab: Code cho <body> (GTM only) -->
                        <page string="Code Dan Sau body" icon="fa-code"
                              invisible="tag_type != 'gtm'">
                            <div class="alert alert-info">
                                Copy doan code ben duoi va dan ngay sau the <code>&lt;body&gt;</code> cua WordPress.
                            </div>
                            <field name="snippet_body" widget="code" readonly="1"
                                   options="{'mode': 'html'}"/>
                        </page>

                        <!-- Tab: WooCommerce Purchase Tracking -->
                        <page string="Theo Doi Don Hang (WooCommerce)" icon="fa-shopping-cart">
                            <div class="alert alert-warning">
                                Dan doan PHP nay vao file <code>functions.php</code> cua theme WordPress
                                hoac dung plugin <b>Code Snippets</b>.
                                Doan code nay tu dong ban su kien mua hang khi co don thanh cong.
                            </div>
                            <field name="snippet_purchase" widget="code" readonly="1"
                                   options="{'mode': 'php'}"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ══════════  GTM Item Form View  ══════════ -->
    <record id="view_google_ads_gtm_item_form" model="ir.ui.view">
        <field name="name">google.ads.gtm.item.form</field>
        <field name="model">google.ads.gtm.item</field>
        <field name="arch" type="xml">
            <form string="Thanh Phan GTM" create="false" edit="false">
                <sheet>
                    <group>
                        <group string="Thong Tin Chung">
                            <field name="name"/>
                            <field name="item_type"/>
                            <field name="gtm_item_id"/>
                            <field name="tag_config_id"/>
                            <field name="is_paused"/>
                        </group>
                        <group string="Chi Tiet">
                            <field name="tag_subtype" invisible="item_type != 'tag'"/>
                            <field name="trigger_subtype" invisible="item_type != 'trigger'"/>
                            <field name="firing_trigger_names" invisible="item_type != 'tag'"/>
                            <field name="last_synced"/>
                        </group>
                    </group>
                    <group string="Ghi Chu / Tham So">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ══════════  Action  ══════════ -->
    <record id="action_google_ads_tag" model="ir.actions.act_window">
        <field name="name">Google Tag / GTM</field>
        <field name="res_model">google.ads.tag</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
