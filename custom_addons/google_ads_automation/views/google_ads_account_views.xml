<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_google_ads_account_form" model="ir.ui.view">
        <field name="name">google.ads.account.form</field>
        <field name="model">google.ads.account</field>
        <field name="arch" type="xml">
            <form string="Tài Khoản Google Ads">
                <header>
                    <button name="action_test_connection" string="Kiểm tra kết nối" type="object" class="oe_highlight" invisible="is_demo"/>
                    <button name="action_generate_demo_data" string="🛠 Tạo Dữ Liệu Demo" type="object" class="oe_highlight" invisible="not is_demo"/>
                    <button name="action_sync_all_data" string="Đồng bộ toàn bộ" type="object" invisible="state != 'connected' or is_demo"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,connected,error"/>
                </header>
                <sheet>
                    <group>
                        <group string="Cấu Hình API">
                            <field name="name"/>
                            <field name="is_demo" widget="boolean_toggle"/>
                            <field name="operating_customer_id" placeholder="vd: 1234567890"/>
                            <field name="login_customer_id" placeholder="vd: 0987654321"/>
                            <field name="refresh_token" password="True"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_google_ads_account_tree" model="ir.ui.view">
        <field name="name">google.ads.account.list</field>
        <field name="model">google.ads.account</field>
        <field name="arch" type="xml">
            <list string="Tài Khoản Google Ads">
                <field name="name"/>
                <field name="operating_customer_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_google_ads_account" model="ir.actions.act_window">
        <field name="name">Tài Khoản Google Ads</field>
        <field name="res_model">google.ads.account</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
