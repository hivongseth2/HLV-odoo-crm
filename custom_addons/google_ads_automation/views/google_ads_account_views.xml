<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_google_ads_account_form" model="ir.ui.view">
        <field name="name">google.ads.account.form</field>
        <field name="model">google.ads.account</field>
        <field name="arch" type="xml">
            <form string="Tài Khoản Google Ads" class="o_google_ads_premium_form">
                <header>
                    <button name="action_test_connection" string="Kết Nối API" type="object"
                            class="btn-primary" invisible="state == 'connected' or is_demo"/>
                    <button name="action_list_accessible_customers" string="Kiểm Tra Quyền Truy Cập" type="object"
                            class="btn-secondary" invisible="is_demo"/>
                    <button name="action_sync_all_data" string="Đồng Bộ Ngay" type="object"
                            class="btn-success" invisible="state != 'connected'"/>
                    <button name="action_adsroid_audit_all" string="AI Audit Toàn Bộ" type="object"
                            class="btn-info" icon="fa-magic" invisible="not use_adsroid or state != 'connected'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,connected,error"/>
                </header>
                <sheet>
                    <field name="hero_header_html" widget="html" readonly="1"/>
                    
                    <div class="oe_title mb-3 border-bottom pb-2">
                        <h1 class="d-flex align-items-center">
                            <field name="name" placeholder="Tên Tài Khoản..." class="oe_inline"/>
                        </h1>
                    </div>

                    <div class="o_kpi_dashboard">
                        <div class="o_kpi_tile shadow-sm border-0">
                            <span class="o_kpi_label">SỐ CHIẾN DỊCH</span>
                            <span class="o_kpi_value text-primary"><field name="total_campaigns" readonly="1"/></span>
                        </div>
                        <div class="o_kpi_tile shadow-sm border-0">
                            <span class="o_kpi_label">TỔNG CHI PHÍ</span>
                            <span class="o_kpi_value text-danger"><field name="total_spend" widget="monetary" readonly="1"/></span>
                        </div>
                        <div class="o_kpi_tile shadow-sm border-0">
                            <span class="o_kpi_label">CHUYỂN ĐỔI</span>
                            <span class="o_kpi_value text-success"><field name="total_conversions" readonly="1"/></span>
                        </div>
                        <div class="o_kpi_tile shadow-sm border-0">
                            <span class="o_kpi_label">ROAS TB</span>
                            <span class="o_kpi_value text-info"><field name="account_roas" widget="badge" decoration-success="account_roas &gt;= 3"/></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-lg-8">
                            <div class="o_premium_card h-100">
                                <h4 class="mb-4 text-primary fw-bold"><i class="fa fa-key me-2"></i>Cài Đặt Xác Thực (Credentials)</h4>
                                <group>
                                    <group string="OAuth 2.0" class="border-0">
                                        <field name="client_id" password="True"/>
                                        <field name="client_secret" password="True"/>
                                        <field name="developer_token" password="True" invisible="is_demo"/>
                                        <field name="refresh_token" password="True"/>
                                    </group>
                                </group>
                                
                                <div class="alert alert-info border-0 shadow-sm" role="alert" invisible="is_demo">
                                    <div class="d-flex align-items-center mb-2">
                                        <i class="fa fa-google fa-2x me-3"></i>
                                        <div>
                                            <strong>Ủy Quyền Tự Động (Khuyên dùng)</strong><br/>
                                            Nhấn nút bên dưới để đăng nhập bằng tài khoản Google MCC của bạn. 
                                            Hệ thống sẽ tự động điền <i>Refresh Token</i> sau khi bạn cấp quyền.
                                        </div>
                                    </div>
                                    <hr/>
                                    <p class="mb-2"><small><i>Lưu ý:</i> Phải thêm URIs chuyển hướng này vào <b>Authorized redirect URIs</b> của Client ID trên Google Cloud:</small></p>
                                    <code class="d-block p-2 bg-white text-dark rounded border mb-3">https://[your-odoo-domain]/google_ads/auth_callback</code>
                                    
                                    <button name="action_generate_auth_url" string="1. Đăng Nhập Với Google" type="object" 
                                            class="btn btn-outline-primary fw-bold" icon="fa-sign-in" invisible="is_demo"/>
                                </div>
                                
                                <group>
                                    <group string="Service Account" class="border-0">
                                        <field name="service_account_json" placeholder='{"type": "service_account", ...}'/>
                                        <button name="action_test_service_account" string="Kiểm Tra JSON" type="object" 
                                            class="btn btn-secondary mt-2 w-100" icon="fa-check-square-o"/>
                                    </group>
                                </group>

                                <group>
                                    <group string="Adsroid AI Integration" class="border-0">
                                        <field name="use_adsroid" widget="boolean_toggle"/>
                                        <field name="auto_apply_adsroid_action" widget="boolean_toggle" invisible="not use_adsroid"/>
                                        <field name="adsroid_api_key" password="True" invisible="not use_adsroid" required="use_adsroid"/>
                                        <field name="adsroid_organisation_id" invisible="not use_adsroid" required="use_adsroid"/>
                                        <field name="adsroid_project_id" invisible="not use_adsroid" required="use_adsroid"/>
                                    </group>
                                </group>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="o_premium_card h-100 bg-light border-0">
                                <h4 class="mb-4 text-secondary fw-bold"><i class="fa fa-sliders me-2"></i>Chế Độ &amp; ID</h4>
                                <group>
                                    <field name="is_demo" widget="boolean_toggle"/>
                                    <field name="active" widget="boolean_toggle"/>
                                    <field name="login_customer_id" placeholder="MCC ID" invisible="is_demo" readonly="state == 'connected'"/>
                                    <field name="operating_customer_id" placeholder="1234567890" invisible="is_demo" readonly="state == 'connected'"/>
                                    <field name="merchant_center_id" placeholder="ID (vd: 1234567)" invisible="is_demo"/>
                                </group>
                                <div invisible="not is_demo" class="alert alert-warning mt-4 border-0 shadow-sm rounded-3">
                                    <i class="fa fa-info-circle me-1"></i> <b>Chế độ Demo đang bật.</b> Tài khoản này sẽ sử dụng dữ liệu giả lập để thử nghiệm.
                                </div>
                            </div>
                        </div>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_google_ads_account_tree" model="ir.ui.view">
        <field name="name">google.ads.account.list</field>
        <field name="model">google.ads.account</field>
        <field name="arch" type="xml">
            <list string="Tài Khoản Google Ads">
                <field name="name"/>
                <field name="is_demo" widget="boolean"/>
                <field name="operating_customer_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'connected'"
                       decoration-warning="state == 'draft'"
                       decoration-danger="state == 'error'"/>
            </list>
        </field>
    </record>

    <record id="view_google_ads_account_kanban" model="ir.ui.view">
        <field name="name">google.ads.account.kanban</field>
        <field name="model">google.ads.account</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="name"/>
                <field name="operating_customer_id"/>
                <field name="state"/>
                <field name="is_demo"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click oe_kanban_card">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title fs-4">
                                        <i class="fa fa-briefcase text-primary me-2"/>
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <div class="o_kanban_record_state">
                                    <field name="state" widget="badge" 
                                           decoration-success="state == 'connected'"
                                           decoration-warning="state == 'draft'"
                                           decoration-danger="state == 'error'"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom mt-3">
                                <div class="oe_kanban_bottom_left text-muted">
                                    <span t-if="record.operating_customer_id.raw_value" title="Mã Khách Hàng (Customer ID)">
                                        <i class="fa fa-google text-danger me-1"/> <field name="operating_customer_id"/>
                                    </span>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <span t-if="record.is_demo.raw_value" class="badge text-bg-warning">DEMO</span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_google_ads_account" model="ir.actions.act_window">
        <field name="name">Tài Khoản Google Ads</field>
        <field name="res_model">google.ads.account</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo một Tài Khoản Google Ads mới
            </p>
            <p>
                Module quản lý và tự động hóa toàn bộ dữ liệu từ Google Ads. 
                Bạn cũng có thể bật chế độ DEMO để trải nghiệm an toàn.
            </p>
        </field>
    </record>
</odoo>
