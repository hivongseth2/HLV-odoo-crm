<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_google_ads_account_form" model="ir.ui.view">
        <field name="name">google.ads.account.form</field>
        <field name="model">google.ads.account</field>
        <field name="arch" type="xml">
            <form string="Tài Khoản Google Ads">
                <header>
                    <button name="action_test_connection" string="Kiểm Tra Kết Nối" type="object"
                            class="oe_highlight" invisible="state == 'connected'"/>
                    <button name="action_sync_all_data" string="Đồng Bộ Dữ Liệu" type="object"
                            class="oe_highlight" invisible="state != 'connected'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,connected,error"/>
                </header>
                <sheet>
                    <!-- Ribbon DEMO -->
                    <widget name="web_ribbon" title="DEMO MODE" bg_color="text-bg-warning"
                            invisible="not is_demo"/>

                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Mô tả tài khoản..."/>
                        </h1>
                    </div>

                    <group>
                        <group string="Cài Đặt Chung">
                            <field name="active" widget="boolean_toggle"/>
                            <field name="is_demo" widget="boolean_toggle"/>
                        </group>
                        <group string="ID Tài Khoản" invisible="is_demo">
                            <field name="operating_customer_id" placeholder="vd: 1234567890"/>
                            <field name="login_customer_id" placeholder="vd: 0987654321"/>
                        </group>
                    </group>

                    <!-- Credentials — luôn hiện một phần để GTM có thể truy cập -->
                    <group string="Thông Tin Xác Thực">
                        <group string="OAuth 2.0 (Dành cho Google Ads &amp; GTM Test)">
                            <field name="developer_token" password="True" invisible="is_demo"/>
                            <field name="client_id" password="True"/>
                            <field name="client_secret" password="True"/>
                            <field name="refresh_token" password="True"/>
                        </group>
                        <group string="Service Account (Dành cho GTM/GA4 Production)">
                            <field name="service_account_json" placeholder='{"type": "service_account", "project_id": ...}'/>
                        </group>
                    </group>

                    <!-- Demo info box -->
                    <div class="alert alert-info" invisible="not is_demo">
                        <strong>Chế Độ Demo đang bật</strong><br/>
                        Không cần điền API credentials. Nhấn <strong>Kiểm Tra Kết Nối</strong>
                        rồi <strong>Đồng Bộ Dữ Liệu</strong> để tạo 4 Campaigns mẫu với metrics ngẫu nhiên.
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_google_ads_account_tree" model="ir.ui.view">
        <field name="name">google.ads.account.list</field>
        <field name="model">google.ads.account</field>
        <field name="arch" type="xml">
            <list string="Tài Khoản Google Ads">
                <field name="name"/>
                <field name="is_demo" widget="boolean"/>
                <field name="operating_customer_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'connected'"
                       decoration-warning="state == 'draft'"
                       decoration-danger="state == 'error'"/>
            </list>
        </field>
    </record>

    <record id="view_google_ads_account_kanban" model="ir.ui.view">
        <field name="name">google.ads.account.kanban</field>
        <field name="model">google.ads.account</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="name"/>
                <field name="operating_customer_id"/>
                <field name="state"/>
                <field name="is_demo"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click oe_kanban_card">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title fs-4">
                                        <i class="fa fa-briefcase text-primary me-2"/>
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <div class="o_kanban_record_state">
                                    <field name="state" widget="badge" 
                                           decoration-success="state == 'connected'"
                                           decoration-warning="state == 'draft'"
                                           decoration-danger="state == 'error'"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom mt-3">
                                <div class="oe_kanban_bottom_left text-muted">
                                    <span t-if="record.operating_customer_id.raw_value" title="Mã Khách Hàng (Customer ID)">
                                        <i class="fa fa-google text-danger me-1"/> <field name="operating_customer_id"/>
                                    </span>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <span t-if="record.is_demo.raw_value" class="badge text-bg-warning">DEMO</span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_google_ads_account" model="ir.actions.act_window">
        <field name="name">Tài Khoản Google Ads</field>
        <field name="res_model">google.ads.account</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo một Tài Khoản Google Ads mới
            </p>
            <p>
                Module quản lý và tự động hóa toàn bộ dữ liệu từ Google Ads. 
                Bạn cũng có thể bật chế độ DEMO để trải nghiệm an toàn.
            </p>
        </field>
    </record>
</odoo>
