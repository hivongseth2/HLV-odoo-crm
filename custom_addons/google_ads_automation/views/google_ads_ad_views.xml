<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_google_ads_ad_list" model="ir.ui.view">
        <field name="name">google.ads.ad.list</field>
        <field name="model">google.ads.ad</field>
        <field name="arch" type="xml">
            <list string="Mẫu Quảng Cáo Google Ads">
                <field name="name"/>
                <field name="ad_group_id"/>
                <field name="type_id"/>
                <field name="clicks" sum="Tổng Click" optional="show"/>
                <field name="cost" sum="Tổng Chi Phí" optional="show"/>
                <field name="conversions" sum="Tổng Đơn" optional="show"/>
                <field name="conversion_rate" widget="progressbar" string="Tỷ Lệ CĐ (%)" optional="show"/>
                <field name="roas" string="ROAS" widget="badge" 
                       decoration-success="roas &gt;= 3" 
                       decoration-danger="roas &lt; 1" 
                       decoration-warning="roas &gt;= 1 and roas &lt; 3"
                       optional="show"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'enabled'"
                       decoration-muted="status == 'paused'"
                       decoration-danger="status == 'removed'"/>
            </list>
        </field>
    </record>

    <record id="view_google_ads_ad_form" model="ir.ui.view">
        <field name="name">google.ads.ad.form</field>
        <field name="model">google.ads.ad</field>
        <field name="arch" type="xml">
            <form string="Mẫu Quảng Cáo Google Ads" class="o_google_ads_premium_form">
                <header>
                    <button name="action_sync_to_google" string="🚀 Đồng bộ (Lần đầu)" 
                            type="object" class="btn-primary" 
                            invisible="state == 'synced'"/>
                    
                    <button name="action_sync_to_google" string="🔄 Cập nhật nội dung" 
                            type="object" class="btn-info" 
                            invisible="state != 'synced'"/>

                    <button name="action_pause_on_google" string="⏸️ Tạm dừng trên Google"
                            type="object" class="btn-secondary"
                            invisible="state != 'synced' or status == 'paused'"/>
                            
                    <button name="action_enable_on_google" string="▶️ Kích hoạt trên Google"
                            type="object" class="btn-success"
                            invisible="state != 'synced' or status == 'enabled'"/>

                    <button name="action_remove_from_google_only" string="🗑️ Xóa khỏi Google Ads"
                            type="object" class="btn-danger"
                            invisible="state != 'synced'"
                            confirm="⚠️ Bạn có chắc chắn muốn XÓA mẫu quảng cáo này trên Google Ads?&#10;&#10;- Mẫu quảng cáo sẽ bị gỡ bỏ vĩnh viễn trên nền tảng Google.&#10;- Bản ghi Odoo sẽ được GIỮ LẠI và chuyển về trạng thái 'Nháp' để bạn có thể đồng bộ lại sau này."/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,synced"/>
                </header>
                <sheet>
                    <field name="hero_header_html" widget="html" readonly="1"/>
                    <field name="type" readonly="state == 'synced'"/>
                    
                    <div class="alert alert-warning mb-3" role="alert" 
                         invisible="not is_ad_content_invalid">
                        <i class="fa fa-exclamation-triangle me-2"></i>
                        <strong>Kiểm tra nội dung:</strong> 
                        <span invisible="type != 'RESPONSIVE_SEARCH_AD'">Cần ít nhất 3 tiêu đề (max 30kt) và 2 mô tả (max 90kt).</span>
                        <span invisible="type != 'DISCOVERY_RESPONSIVE_AD'">Cần ít nhất 1 tiêu đề (max 40kt) và 1 mô tả (max 160kt) + Hình ảnh trong Chiến dịch.</span>
                        Giao thức <code>https://</code> sẽ được tự động thêm vào URL nếu thiếu.
                    </div>

                    <div class="o_premium_card border-0 bg-light-subtle mb-4" >
                        <div class="row">
                            <div class="col-md-6">
                                <group string="Thông Tin Kỹ Thuật">
                                    <field name="name" class="oe_inline fw-bold" placeholder="Tên Quảng Cáo..."/>
                                    <field name="ad_group_id" options="{'no_create': True}" readonly="state == 'synced'"/>
                                    <field name="type_id" options="{'no_create': True}" readonly="state == 'synced'"/>
                                    <field name="status"/>
                                    <field name="product_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                    <field name="google_ad_id" readonly="1" invisible="state == 'draft'"/>

                                    <field name="headline" placeholder="Mỗi tiêu đề 1 dòng. RSA: max 30kt. Khám phá: max 40kt." 
                                           invisible="type not in ['RESPONSIVE_SEARCH_AD', 'DISCOVERY_RESPONSIVE_AD', 'DEMAND_GEN_RESPONSIVE_AD', 'RESPONSIVE_DISPLAY_AD']"/>
                                    <field name="description" placeholder="Mỗi mô tả 1 dòng. RSA: max 90kt. Khám phá: max 160kt." 
                                           invisible="type not in ['RESPONSIVE_SEARCH_AD', 'DISCOVERY_RESPONSIVE_AD', 'DEMAND_GEN_RESPONSIVE_AD', 'RESPONSIVE_DISPLAY_AD']"/>

                                    <field name="is_ad_content_invalid" invisible="1"/>
                                    <field name="is_final_url_invalid" invisible="1"/>
                                    
                                    <field name="final_urls" widget="url" placeholder="https://example.com"
                                           decoration-danger="is_final_url_invalid"/>
                                </group>
                            </div>
                            <div class="col-md-6 text-end">
                                <div class="p-3">
                                    <span class="text-muted small d-block mb-1">Dữ liệu đồng bộ từ Google Ads</span>
                                    <i class="fa fa-refresh me-1 text-primary"></i> <span class="fw-bold">Auto-sync Active</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <field name="performance_dashboard_html" widget="html" readonly="1" invisible="not id"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_google_ads_ad" model="ir.actions.act_window">
        <field name="name">Mẫu Quảng Cáo</field>
        <field name="res_model">google.ads.ad</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
