<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_google_ads_ad_list" model="ir.ui.view">
        <field name="name">google.ads.ad.list</field>
        <field name="model">google.ads.ad</field>
        <field name="arch" type="xml">
            <list string="Mẫu Quảng Cáo Google Ads" create="false" edit="false">
                <field name="name"/>
                <field name="ad_group_id"/>
                <field name="type"/>
                <field name="clicks"/>
                <field name="impressions"/>
                <field name="cost"/>
                <field name="conversions"/>
                <field name="status" widget="badge" decoration-success="status == 'enabled'" decoration-info="status == 'paused'" decoration-danger="status == 'removed'"/>
            </list>
        </field>
    </record>

    <record id="action_google_ads_ad" model="ir.actions.act_window">
        <field name="name">Mẫu Quảng Cáo</field>
        <field name="res_model">google.ads.ad</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
