<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_google_ads_evaluate_rules" model="ir.cron">
            <field name="name">Google Ads: Đánh Giá Quy Tắc Tự Động Hóa</field>
            <field name="model_id" eval="ref('google_ads_automation.model_google_ads_rule')"/>
            <field name="state">code</field>
            <field name="code">model.cron_evaluate_all_rules()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <!-- active=False để module load được, enable thủ công qua UI (Odoo 18 rule) -->
            <field name="active" eval="False"/>
        </record>
        <record id="ir_cron_google_ads_adsroid_sync" model="ir.cron">
            <field name="name">Google Ads: Tự động xin Insight Adsroid</field>
            <field name="model_id" search="[('model', '=', 'google.ads.account')]"/>
            <field name="state">code</field>
            <field name="code">model.cron_fetch_adsroid_insights()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
