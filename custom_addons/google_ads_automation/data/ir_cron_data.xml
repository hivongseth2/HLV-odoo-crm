<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_google_ads_evaluate_rules" model="ir.cron">
            <field name="name">Google Ads: Đánh Giá Quy Tắc Tự Động Hóa</field>
            <!-- Sử dụng cú pháp search thay vì ref theo khuyến nghị Odoo 18 odoo-rule.md -->
            <field name="model_id" search="[('model', '=', 'google.ads.rule')]"/>
            <field name="state">code</field>
            <field name="code">model.cron_evaluate_all_rules()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <!-- BẮT BUỘC để False để tránh ParseError lúc cài module -->
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
