<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_google_ads_adsroid_chat_form" model="ir.ui.view">
        <field name="name">google.ads.adsroid.chat.form</field>
        <field name="model">google.ads.adsroid.chat</field>
        <field name="arch" type="xml">
            <form string="Trò chuyện với Adsroid AI Assistant">
                <field name="campaign_id" invisible="1"/>
                
                <div class="o_adsroid_chat_container" style="background-color: #f8f9fa; border-radius: 8px; padding: 15px; margin-bottom: 15px; border: 1px solid #dee2e6;">
                    <div style="max-height: 400px; overflow-y: auto; padding-right: 10px;">
                        <field name="chat_history" widget="html" nolabel="1"/>
                        <div invisible="chat_history" class="text-center text-muted py-5">
                            <i class="fa fa-comments-o fa-3x mb-3 text-light"></i><br/>
                            <span>Bắt đầu trò chuyện với Adsroid về chiến dịch này...</span>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 align-items-start mt-3">
                    <div class="flex-grow-1">
                        <field name="user_query" placeholder="Nhập câu hỏi tại đây (vd: Tôi nên điều chỉnh ngân sách thế nào?)" nolabel="1" class="border-primary"/>
                    </div>
                    <button name="action_send_message" string="Gửi" type="object" class="btn-primary" icon="fa-paper-plane" 
                            style="padding: 6px 20px;"/>
                </div>

                <footer>
                    <button string="Đóng Chat" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
