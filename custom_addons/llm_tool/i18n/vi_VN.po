#. module: llm_tool
#: model:llm.tool,_description
msgid "LLM Tool"
msgstr "Công cụ AI"

#. module: llm_tool
#: model:llm.tool,help:llm_tool.field_llm_tool__name
msgid "The name of the tool. This will be used by the LLM to call the tool."
msgstr "Tên của công cụ. LLM sẽ dùng tên này để gọi công cụ."

#. module: llm_tool
#: model:llm.tool,help:llm_tool.field_llm_tool__description
msgid "A human-readable description of what the tool does. This will be sent to the LLM."
msgstr "Mô tả dễ hiểu về chức năng của công cụ. Nội dung này sẽ được gửi đến LLM."

#. module: llm_tool
#: model:llm.tool,help:llm_tool.field_llm_tool__implementation
msgid "The implementation that provides this tool's functionality"
msgstr "Triển khai cung cấp chức năng cho công cụ này"

#. module: llm_tool
#: model:llm.tool,field_description:llm_tool.field_llm_tool__input_schema
msgid "Input Schema"
msgstr "Lược đồ đầu vào"

#. module: llm_tool
#: model:llm.tool,help:llm_tool.field_llm_tool__input_schema
msgid "JSON Schema defining the expected parameters for the tool"
msgstr "Lược đồ JSON định nghĩa các tham số mong đợi của công cụ"

#. module: llm_tool
#: model:llm.tool,field_description:llm_tool.field_llm_tool__title
msgid "Title"
msgstr "Tiêu đề"

#. module: llm_tool
#: model:llm.tool,help:llm_tool.field_llm_tool__title
msgid "A human-readable title for the tool"
msgstr "Tiêu đề dễ đọc cho công cụ"

#. module: llm_tool
#: model:llm.tool,field_description:llm_tool.field_llm_tool__read_only_hint
msgid "Read Only"
msgstr "Chỉ đọc"

#. module: llm_tool
#: model:llm.tool,help:llm_tool.field_llm_tool__read_only_hint
msgid "If true, the tool does not modify its environment"
msgstr "Nếu đúng, công cụ không thay đổi môi trường"

#. module: llm_tool
#: model:llm.tool,field_description:llm_tool.field_llm_tool__idempotent_hint
msgid "Idempotent"
msgstr "Lũy đẳng"

#. module: llm_tool
#: model:llm.tool,help:llm_tool.field_llm_tool__idempotent_hint
msgid "If true, calling the tool repeatedly with the same arguments will have no additional effect"
msgstr "Nếu đúng, gọi công cụ nhiều lần với cùng tham số sẽ không tạo thêm hiệu ứng"

#. module: llm_tool
#: model:llm.tool,field_description:llm_tool.field_llm_tool__destructive_hint
msgid "Destructive"
msgstr "Phá hủy"

#. module: llm_tool
#: model:llm.tool,help:llm_tool.field_llm_tool__destructive_hint
msgid "If true, the tool may perform destructive updates to its environment"
msgstr "Nếu đúng, công cụ có thể thực hiện thay đổi phá hủy trên môi trường"

#. module: llm_tool
#: model:llm.tool,field_description:llm_tool.field_llm_tool__open_world_hint
msgid "Open World"
msgstr "Thế giới mở"

#. module: llm_tool
#: model:llm.tool,help:llm_tool.field_llm_tool__open_world_hint
msgid "If true, this tool may interact with an 'open world' of external entities"
msgstr "Nếu đúng, công cụ này có thể tương tác với 'thế giới mở' của các thực thể bên ngoài"

#. module: llm_tool
#: model:llm.tool,field_description:llm_tool.field_llm_tool__server_action_id
msgid "Related Server Action"
msgstr "Hành động máy chủ liên quan"

#. module: llm_tool
#: model:llm.tool,help:llm_tool.field_llm_tool__server_action_id
msgid "The specific server action this tool will execute"
msgstr "Hành động máy chủ cụ thể mà công cụ này sẽ thực thi"

#. module: llm_tool
#: model:llm.tool,field_description:llm_tool.field_llm_tool__decorator_model
msgid "Decorator Model"
msgstr "Mô hình decorator"

#. module: llm_tool
#: model:llm.tool,help:llm_tool.field_llm_tool__decorator_model
msgid "Model name where the decorated method lives (e.g., 'sale.order'). Set automatically during registration."
msgstr "Tên mô hình chứa phương thức decorator (vd: 'sale.order'). Được đặt tự động khi đăng ký."

#. module: llm_tool
#: model:llm.tool,field_description:llm_tool.field_llm_tool__decorator_method
msgid "Decorator Method"
msgstr "Phương thức decorator"

#. module: llm_tool
#: model:llm.tool,help:llm_tool.field_llm_tool__decorator_method
msgid "Method name of the decorated tool (e.g., 'create_sales_quote'). Set automatically during registration."
msgstr "Tên phương thức decorator (vd: 'create_sales_quote'). Được đặt tự động khi đăng ký."

#. module: llm_tool
#: model:llm.tool,help:llm_tool.field_llm_tool__requires_user_consent
msgid "If true, the user must consent to the execution of this tool"
msgstr "Nếu đúng, người dùng phải đồng ý trước khi thực thi công cụ này"

#. module: llm_tool
#: model:llm.tool,help:llm_tool.field_llm_tool__default
msgid "Set to true if this is a default tool to be included in all LLM requests"
msgstr "Đặt là đúng nếu đây là công cụ mặc định áp dụng cho tất cả yêu cầu LLM"

#. module: llm_tool
#: model:llm.tool,help:llm_tool.field_llm_tool__auto_update
msgid "If true, tool metadata will be automatically updated from decorator on Odoo restart. Set to false to manually manage this tool's configuration."
msgstr "Nếu đúng, thông tin công cụ sẽ tự động cập nhật từ decorator khi Odoo khởi động lại. Đặt sai để quản lý thủ công."

#. module: llm_tool
#: sql_constraint:llm.tool:
msgid "A tool for this model and method combination already exists!"
msgstr "Đã tồn tại công cụ cho tổ hợp mô hình và phương thức này!"

#. module: llm_tool
#: sql_constraint:llm.tool:
msgid "A tool with this name already exists! Tool names must be unique."
msgstr "Đã tồn tại công cụ với tên này! Tên công cụ phải là duy nhất."

