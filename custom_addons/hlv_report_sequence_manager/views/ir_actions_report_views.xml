<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Kế thừa form view để thêm trường thứ tự -->
        <record id="report_view_form_sequence" model="ir.ui.view">
            <field name="name">ir.actions.report.form.sequence</field>
            <field name="model">ir.actions.report</field>
            <field name="inherit_id" ref="base.act_report_xml_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="sequence" col="2"/>
                </xpath>
            </field>
        </record>

        <!-- Form view chỉnh sửa nhanh thứ tự -->
        <record id="report_view_form_quick_edit" model="ir.ui.view">
            <field name="name">ir.actions.report.form.quick.sequence</field>
            <field name="model">ir.actions.report</field>
            <field name="arch" type="xml">
                <form string="Thứ tự mẫu in">
                    <group>
                        <field name="name" string="Tên mẫu in" readonly="1"/>
                        <field name="model_id" string="Loại tài liệu" readonly="1"/>
                        <field name="sequence" string="Thứ tự (số nhỏ hơn = lên trên)"/>
                    </group>
                </form>
            </field>
        </record>

        <!-- List view quản lý thứ tự mẫu in -->
        <record id="report_view_list_sequence" model="ir.ui.view">
            <field name="name">ir.actions.report.tree.sequence</field>
            <field name="model">ir.actions.report</field>
            <field name="arch" type="xml">
                <list string="Mẫu in" editable="top">
                    <field name="sequence" widget="handle"/>
                    <field name="name" string="Tên mẫu in"/>
                    <field name="model_id" string="Loại tài liệu"/>
                    <field name="report_type" string="Định dạng" optional="show"/>
                </list>
            </field>
        </record>

        <!-- Search view cho mẫu in -->
        <record id="report_view_search_sequence" model="ir.ui.view">
            <field name="name">ir.actions.report.search.sequence</field>
            <field name="model">ir.actions.report</field>
            <field name="arch" type="xml">
                <search string="Mẫu in">
                    <field name="name" string="Tên mẫu in"/>
                    <field name="model_id" string="Loại tài liệu"/>
                    <separator/>
                    <filter name="filter_picking" string="Phiếu kho"
                            domain="[('model', '=', 'stock.picking')]"/>
                    <filter name="filter_sale" string="Đơn bán hàng"
                            domain="[('model', '=', 'sale.order')]"/>
                    <filter name="filter_invoice" string="Hóa đơn"
                            domain="[('model', 'in', ['account.move', 'account.invoice'])]"/>
                    <filter name="filter_purchase" string="Đơn mua hàng"
                            domain="[('model', '=', 'purchase.order')]"/>
                    <separator/>
                    <filter name="filter_qweb" string="PDF"
                            domain="[('report_type', '=', 'qweb-pdf')]"/>
                    <group string="Nhóm theo">
                        <filter name="group_type" string="Định dạng"
                                context="{'group_by': 'report_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action mở danh sách mẫu in, mặc định nhóm theo mô hình -->
        <record id="action_report_sequence_view" model="ir.actions.act_window">
            <field name="name">Thứ tự mẫu in</field>
            <field name="res_model">ir.actions.report</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="report_view_list_sequence"/>
            <field name="search_view_id" ref="report_view_search_sequence"/>
            <field name="context">{'default_sequence': 10}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Chưa có mẫu in nào!
                </p>
                <p>
                    Kéo thả biểu tượng ☰ để sắp xếp thứ tự mẫu in trong từng mô hình.
                    Số thứ tự càng nhỏ thì xuất hiện càng cao trong menu in.
                </p>
            </field>
        </record>

        <!-- Menu -->
        <menuitem
            id="menu_report_sequence_manager"
            name="Thứ tự mẫu in"
            action="action_report_sequence_view"
            parent="stock.menu_stock_config_settings"
            sequence="30"/>

    </data>
</odoo>
