<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hlv_undelivered_report_tree" model="ir.ui.view">
        <field name="name">hlv.undelivered.report.list</field>
        <field name="model">hlv.undelivered.report</field>
        <field name="arch" type="xml">
            <list string="Đơn hàng chưa giao" create="false" edit="false" delete="false">
                <field name="move_date"/>
                <field name="warehouse_id" optional="hide"/>
                <field name="partner_id"/>
                <field name="order_id"/>
                <field name="picking_id" optional="show"/>
                <field name="product_id"/>
                <field name="product_uom_qty" sum="Tổng nhu cầu"/>
                <field name="qty_reserved" sum="Tổng giữ"/>
                <field name="qty_delivered_line" optional="hide"/>
                <field name="qty_on_hand"/>
                <field name="product_uom" groups="uom.group_uom"/>
                <field name="state" widget="badge" decoration-success="state == 'assigned'" decoration-info="state == 'confirmed'" decoration-warning="state == 'waiting'"/>
            </list>
        </field>
    </record>

    <record id="view_hlv_undelivered_report_search" model="ir.ui.view">
        <field name="name">hlv.undelivered.report.search</field>
        <field name="model">hlv.undelivered.report</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm đơn chưa giao">
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="order_id"/>
                <field name="picking_id"/>
                <filter string="Sẵn sàng" name="ready" domain="[('state', '=', 'assigned')]"/>
                <filter string="Đang chờ" name="waiting" domain="[('state', 'in', ('confirmed', 'waiting'))]"/>
                <group expand="1" string="Nhóm theo">
                    <filter string="Khách hàng" name="groupby_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Sản phẩm" name="groupby_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Trạng thái" name="groupby_state" context="{'group_by': 'state'}"/>
                    <filter string="Kho" name="groupby_warehouse" context="{'group_by': 'warehouse_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hlv_undelivered_report" model="ir.actions.act_window">
        <field name="name">Báo cáo đơn hàng chưa giao</field>
        <field name="res_model">hlv.undelivered.report</field>
        <field name="view_mode">list,pivot</field>
        <field name="view_id" ref="view_hlv_undelivered_report_tree"/>
        <field name="search_view_id" ref="view_hlv_undelivered_report_search"/>
        <field name="context">{'search_default_groupby_partner': 1}</field>
    </record>

    <menuitem id="menu_hlv_undelivered_report"
              name="Đơn hàng chưa giao"
              parent="stock.menu_warehouse_report"
              action="action_hlv_undelivered_report"
              sequence="150"/>
</odoo>
