<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- FORM /track -->
    <template id="website_track_form" name="Public Tracking Form" inherit_id="website.layout">
      <xpath expr="//main" position="inside">
        <section class="s_text_block container my-5">
          <h2>Theo dõi đơn hàng</h2>
          <form action="/track/search" method="post" class="o_website_form row g-3">
            <!-- CSRF token -->
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

            <div class="col-md-6">
              <label class="form-label">Mã đơn hoặc mã vận đơn</label>
              <input name="tracking_number" type="text" class="form-control"
                     placeholder="VD: KBC/OUT/01931 hoặc SPXVN..." required="required"/>
            </div>
            <div class="col-md-4">
              <label class="form-label">(Tuỳ chọn) Hãng vận chuyển</label>
              <input name="slug" type="text" class="form-control" placeholder="VD: jtexpress-vn, spx-vn"/>
            </div>
            <div class="col-md-2 d-flex align-items-end">
              <button type="submit" class="btn btn-primary w-100">Tra cứu</button>
            </div>
          </form>
        </section>
      </xpath>
    </template>

    <!-- KẾT QUẢ /track/search -->
    <template id="website_track_result" name="Public Tracking Result" inherit_id="website.layout">
      <xpath expr="//main" position="inside">
        <section class="container my-5">
          <h2>Kết quả tra cứu</h2>

          <t t-if="error">
            <div class="alert alert-danger" role="alert"><t t-esc="error"/></div>
          </t>

          <!-- Map VN cho tag -->
          <t t-set="VI_TAG" t-value="{
            'InfoReceived':'Đã tạo đơn',
            'InTransit':'Đang vận chuyển',
            'OutForDelivery':'Đang giao',
            'Delivered':'Đã giao',
            'Exception':'Ngoại lệ',
            'FailedAttempt':'Giao thất bại',
            'ReturnToSender':'Hoàn hàng'
          }"/>

          <t t-set="tr" t-value="data or {}"/>

          <t t-if="not error and tr">
            <div class="card mb-3 p-3">
              <div><strong>Hãng:</strong> <t t-esc="tr.get('slug') or '-'"/></div>
              <div><strong>Mã vận đơn:</strong> <t t-esc="tr.get('tracking_number') or '-'"/></div>
              <div><strong>Trạng thái:</strong>
                <t t-esc="VI_TAG.get(tr.get('tag')) or tr.get('subtag_message') or tr.get('tag') or tr.get('status') or '-'"/>
              </div>
              <div t-if="tr.get('courier_tracking_link')">
                <a t-att-href="tr.get('courier_tracking_link')" target="_blank">Xem trên trang hãng</a>
              </div>
            </div>

            <!-- Timeline -->
            <t t-set="cps" t-value="(tr.get('checkpoints') or [])"/>
            <t t-if="not cps">
              <em>Chưa có dữ liệu hành trình.</em>
            </t>
            <t t-if="cps">
              <div class="timeline">
                <!-- <t t-foreach="list(reversed(cps))" t-as="cp"> -->
                <t t-foreach="(cps or [])[::-1]" t-as="cp">

                  <div class="tl-item">
                    <div class="tl-dot"></div>
                    <div class="tl-content">
                      <div class="tl-title">
                        <strong>
                          <t t-esc="cp.get('subtag_message') or VI_TAG.get(cp.get('tag')) or cp.get('tag') or ''"/>
                        </strong>
                        <small class="text-muted ms-2">
                          <t t-esc="cp.get('checkpoint_time') or ''"/>
                        </small>
                      </div>
                      <!-- Ưu tiên message (đa phần đã là tiếng Việt từ carrier) -->
                      <div class="tl-msg"><t t-esc="cp.get('message') or ''"/></div>
                    </div>
                  </div>
                </t>
              </div>
            </t>
          </t>

          <div class="mt-4">
            <a href="/track" class="btn btn-secondary">Tra cứu khác</a>
          </div>
        </section>

        <!-- CSS gọn cho timeline -->
        <style>
          .timeline{position:relative;margin:1rem 0;padding-left:1.25rem;border-left:2px solid #e5e7eb}
          .tl-item{position:relative;margin:0 0 1rem 0}
          .tl-dot{position:absolute;left:-8px;top:.45rem;width:.75rem;height:.75rem;border-radius:999px;background:#3b82f6}
          .tl-title{display:flex;align-items:center;gap:.5rem;margin-bottom:.25rem}
          .tl-msg{color:#374151}
        </style>
      </xpath>
    </template>

  </data>
</odoo>
