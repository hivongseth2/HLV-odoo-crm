<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- TRANG TRACKING: Form + Kết quả -->
    <template id="website_track_page" name="AfterShip Tracking Page">
      <t t-call="website.layout">
        <t t-set="no_header" t-value="False"/>
        <t t-set="no_footer" t-value="False"/>
        
        <div id="wrap" class="oe_structure">
          
          <!-- PHẦN 1: FORM TÌM KIẾM (luôn hiển thị) -->
          <section class="s_cover parallax s_parallax_is_fixed bg-black-50 pt96 pb96" data-snippet="s_cover">
            <span class="s_parallax_bg oe_img_bg" style="background-image: url('/web/image/website.s_cover_default_image'); background-position: 50% 0;"/>
            <div class="o_we_bg_filter bg-black-50"/>
            <div class="container">
              <div class="row s_nb_column_fixed">
                <div class="col-lg-8 offset-lg-2">
                  <div class="hlv-track-card bg-white rounded p-4 shadow">
                    <h1 class="text-center mb-3">Theo dõi đơn hàng</h1>
                    <p class="text-muted text-center mb-4">Nhập mã vận đơn hoặc mã đơn nội bộ để kiểm tra trạng thái giao hàng.</p>

                    <form action="/track/search" method="get" class="hlv-track-form">
                      <div class="mb-3">
                        <label for="tracking_number" class="form-label">Mã vận đơn hoặc mã đơn</label>
                        <input type="text" class="form-control" id="tracking_number" name="tracking_number" 
                               t-att-value="number or ''"
                               placeholder="VD: SPXVN05508643516A hoặc KBC/OUT/01931" required="required"/>
                      </div>

                      <div class="mb-3">
                        <label for="slug" class="form-label">Hãng vận chuyển (nếu biết)</label>
                        <input type="text" class="form-control" id="slug" name="slug" 
                               t-att-value="slug or ''"
                               placeholder="VD: spx-vn, jtexpress-vn"/>
                      </div>

                      <div class="text-center">
                        <button type="submit" class="btn btn-primary btn-lg">Tra cứu</button>
                      </div>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- PHẦN 2: KẾT QUẢ (chỉ hiển thị khi có dữ liệu) -->
          <t t-if="data or error">
            <section class="pt-5 pb-5">
              <div class="container">
                <div class="row">
                  <div class="col-lg-10 offset-lg-1">
                    <div class="hlv-track-card bg-white rounded p-4 shadow">

                      <t t-if="error">
                        <div class="hlv-track-alert hlv-track-alert--error alert alert-danger" role="alert">
                          <span t-esc="error"/>
                        </div>
                      </t>

                      <!-- Map tiếng Việt cho tag -->
                      <t t-set="VI_TAG" t-value="{
                        'InfoReceived':'Đã tạo đơn',
                        'InTransit':'Đang vận chuyển',
                        'OutForDelivery':'Đang giao',
                        'Delivered':'Đã giao',
                        'Exception':'Ngoại lệ',
                        'FailedAttempt':'Giao thất bại',
                        'ReturnToSender':'Hoàn hàng'
                      }"/>

                      <t t-set="tr" t-value="data or {}"/>

                      <!-- Hiển thị kết quả tracking -->
                      <t t-if="not error and (tr.get('tracking_number') or checkpoints)">

                        <h3 class="mb-4 text-center">Kết quả tra cứu</h3>

                        <div class="hlv-track-summary mb-4">
                          <div class="row text-center">
                            <div class="col-md-4 mb-3">
                              <h5>Mã vận đơn</h5>
                              <p class="hlv-track-number fs-5"><t t-esc="tr.get('tracking_number') or number or '-'"/></p>
                            </div>
                            <div class="col-md-4 mb-3">
                              <h5>Hãng vận chuyển</h5>
                              <p class="hlv-track-number fs-5"><t t-esc="tr.get('slug') or slug or '-'"/></p>
                            </div>
                            <div class="col-md-4 mb-3">
                              <h5>Trạng thái hiện tại</h5>
                              <p class="hlv-track-status fs-5 text-success">
                                <t t-esc="VI_TAG.get(tr.get('tag')) or tr.get('subtag_message') or tr.get('tag') or 'Đang cập nhật'"/>
                              </p>
                            </div>
                          </div>
                        </div>

                        <t t-set="cp_list" t-value="checkpoints or []"/>

                        <div class="hlv-track-timeline mt-4">
                          <h4 class="mb-3">Hành trình giao hàng</h4>

                          <t t-if="cp_list">
                            <ul class="hlv-timeline-list">
                              <t t-foreach="cp_list" t-as="cp">
                                <li t-attf-class="hlv-timeline-item {{ 'is-latest' if cp_index == 0 else '' }}">
                                  <div class="hlv-timeline-item__time">
                                    <span t-esc="cp.get('checkpoint_time')"/>
                                  </div>
                                  <div class="hlv-timeline-item__body">
                                    <h5>
                                      <t t-esc="cp.get('subtag_message') or VI_TAG.get(cp.get('tag')) or cp.get('tag') or ''"/>
                                    </h5>
                                    <p t-esc="cp.get('message')"/>
                                  </div>
                                </li>
                              </t>
                            </ul>
                          </t>
                          <t t-else="">
                            <p class="hlv-track-empty text-muted">Chưa có dữ liệu hành trình từ hãng vận chuyển.</p>
                          </t>
                        </div>
                      </t>

                    </div>
                  </div>
                </div>
              </div>
            </section>
          </t>

        </div>
        
        <style>
          .hlv-track-card{background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:24px}
          .hlv-track-number{font-weight:600}
          .hlv-track-status{font-weight:600}
          .hlv-track-alert{padding:12px;border-radius:8px;margin-bottom:12px}
          .hlv-track-alert--error{background:#fee2e2;color:#991b1b}
          .hlv-track-timeline{margin-top:16px}
          .hlv-timeline-list{list-style:none;margin:0;padding:0;border-left:2px solid #e5e7eb}
          .hlv-timeline-item{position:relative;padding:12px 12px 12px 20px}
          .hlv-timeline-item.is-latest{background:#eff6ff;border-left:2px solid #3b82f6;margin-left:-2px}
          .hlv-timeline-item.is-latest h5{color:#2563eb}
          .hlv-timeline-item::before{content:"";position:absolute;left:-6px;top:18px;width:10px;height:10px;border-radius:999px;background:#3b82f6;border:2px solid #fff}
          .hlv-timeline-item.is-latest::before{background:#2563eb;width:12px;height:12px;left:-7px}
          .hlv-timeline-item__time{font-size:.85rem;color:#6b7280;margin-bottom:2px}
          .hlv-timeline-item__body h5{margin:0 0 4px 0;font-size:1rem;font-weight:600}
          .hlv-timeline-item__body p{margin:0;color:#374151;line-height:1.5}
        </style>
      </t>
    </template>

  </data>
</odoo>