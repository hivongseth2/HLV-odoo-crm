<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- FORM /track -->
    <template id="website_track_form" name="AfterShip Tracking Form" inherit_id="website.layout">
      <xpath expr="//main" position="replace">
        <main id="wrap" class="oe_structure">
          <div class="hlv-track-wrapper">
            <div class="hlv-track-card">
              <h1>Theo dõi đơn hàng</h1>
              <p class="hlv-track-desc">Nhập mã vận đơn hoặc mã đơn nội bộ để kiểm tra trạng thái giao hàng.</p>

              <form action="/track/search" method="get" class="hlv-track-form">

                <div class="form-group">
                  <label for="tracking_number">Mã vận đơn hoặc mã đơn</label>
                  <input type="text" id="tracking_number" name="tracking_number" placeholder="VD: SPXVN05508643516A hoặc KBC/OUT/01931" required="required"/>
                </div>

                <div class="form-group">
                  <label for="slug">Hãng vận chuyển (nếu biết)</label>
                  <input type="text" id="slug" name="slug" placeholder="VD: spx-vn, jtexpress-vn"/>
                </div>

                <button type="submit" class="btn btn-primary">Tra cứu</button>
              </form>
            </div>
          </div>

          <!-- CSS tối giản -->
          <style>
            .hlv-track-wrapper{max-width:960px;margin:2rem auto;padding:0 1rem}
            .hlv-track-card{background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:24px}
            .hlv-track-back{display:inline-block;margin-bottom:12px;text-decoration:none}
            .hlv-track-desc{color:#6b7280}
            .hlv-track-form .form-group{margin-bottom:12px}
            .hlv-track-summary{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;margin:16px 0}
            .hlv-track-number{font-weight:600}
            .hlv-track-status{font-weight:600}
            .hlv-track-alert{padding:12px;border-radius:8px;margin-bottom:12px}
            .hlv-track-alert--error{background:#fee2e2;color:#991b1b}
            .hlv-track-timeline{margin-top:16px}
            .hlv-timeline-list{list-style:none;margin:0;padding:0;border-left:2px solid #e5e7eb}
            .hlv-timeline-item{position:relative;padding:12px 12px 12px 20px}
            .hlv-timeline-item.is-latest h4{color:#2563eb}
            .hlv-timeline-item::before{content:"";position:absolute;left:-6px;top:18px;width:10px;height:10px;border-radius:999px;background:#3b82f6}
            .hlv-timeline-item__time{font-size:.85rem;color:#6b7280;margin-bottom:2px}
            .hlv-timeline-item__body h4{margin:0 0 2px 0;font-size:1rem}
            .hlv-timeline-item__body p{margin:0;color:#374151}
          </style>
        </main>
      </xpath>
    </template>

    <!-- KẾT QUẢ /track/search -->
    <template id="website_track_result" name="AfterShip Tracking Result" inherit_id="website.layout">
      <xpath expr="//main" position="replace">
        <main id="wrap" class="oe_structure">
          <div class="hlv-track-wrapper">
            <div class="hlv-track-card">

              <a href="/track" class="hlv-track-back">&#8592; Quay lại tra cứu khác</a>

              <t t-if="error">
                <div class="hlv-track-alert hlv-track-alert--error" role="alert">
                  <span t-esc="error"/>
                </div>
              </t>

              <!-- Map tiếng Việt cho tag -->
              <t t-set="VI_TAG" t-value="{
                'InfoReceived':'Đã tạo đơn',
                'InTransit':'Đang vận chuyển',
                'OutForDelivery':'Đang giao',
                'Delivered':'Đã giao',
                'Exception':'Ngoại lệ',
                'FailedAttempt':'Giao thất bại',
                'ReturnToSender':'Hoàn hàng'
              }"/>

              <!-- data là dict truyền từ controller -->
              <t t-set="tr" t-value="data or {}"/>
              
              <!-- Hiển thị kết quả nếu không có lỗi và có tracking_number hoặc checkpoints -->
              <t t-if="not error and (tr.get('tracking_number') or checkpoints)">

                <div class="hlv-track-summary">
                  <div>
                    <h2>Mã vận đơn</h2>
                    <p class="hlv-track-number"><t t-esc="tr.get('tracking_number') or number or '-'"/></p>
                  </div>
                  <div>
                    <h2>Hãng vận chuyển</h2>
                    <p class="hlv-track-number"><t t-esc="tr.get('slug') or slug or '-'"/></p>
                  </div>
                  <div>
                    <h2>Trạng thái hiện tại</h2>
                    <p class="hlv-track-status">
                      <t t-esc="VI_TAG.get(tr.get('tag')) or tr.get('subtag_message') or tr.get('tag') or tr.get('status') or 'Đang cập nhật'"/>
                    </p>
                  </div>
                </div>

                <!-- Lấy checkpoints (đã được sắp xếp từ controller) -->
                <t t-set="cp_list" t-value="checkpoints or []"/>

                <div class="hlv-track-timeline">
                  <h3>Hành trình giao hàng</h3>

                  <t t-if="cp_list">
                    <ul class="hlv-timeline-list">
                      <t t-foreach="cp_list" t-as="cp" t-foreach-index="idx">
                        <li t-attf-class="hlv-timeline-item {{ 'is-latest' if idx == 0 else '' }}">
                          <div class="hlv-timeline-item__time">
                            <span t-esc="cp.get('checkpoint_time') or cp.get('date_time')"/>
                          </div>
                          <div class="hlv-timeline-item__body">
                            <h4>
                              <t t-esc="cp.get('subtag_message') or VI_TAG.get(cp.get('tag')) or cp.get('tag') or ''"/>
                            </h4>
                            <p t-esc="cp.get('message')"/>
                          </div>
                        </li>
                      </t>
                    </ul>
                  </t>
                  <t t-else="">
                    <p class="hlv-track-empty">Chưa có dữ liệu hành trình từ hãng vận chuyển.</p>
                  </t>
                </div>
              </t>

            </div>
          </div>
        </main>
      </xpath>
    </template>

  </data>
</odoo>
