<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_aftership" model="ir.ui.view">
        <field name="name">sale.order.form.aftership.tracking</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Tracking AfterShip">
                    <group>
                        <field name="tracking_slug"/>
                        <field name="tracking_number"/>
                        <field name="tracking_status" readonly="1"/>
                        <field name="tracking_last_checkpoint" readonly="1"/>
                        <field name="tracking_payload" readonly="1" widget="json"/>
                    </group>
                    <group>
                        <button name="action_register_tracking_aftership" type="object" string="Đăng ký trên AfterShip" class="oe_highlight" invisible="not tracking_number"/>
                        <button name="action_refresh_tracking_aftership" type="object" string="Làm mới trạng thái"/>
                    </group>
                    <field name="tracking_timeline_html" readonly="1" widget="html"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
