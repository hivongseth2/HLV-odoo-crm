<odoo>
  <record id="view_picking_form_aftership" model="ir.ui.view">
    <field name="name">stock.picking.form.aftership</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
      <!-- Nút đăng ký tracking: ẩn khi đã có aftership_id hoặc chưa có tracking_number -->
      <button name="action_register_tracking_aftership"
              type="object" string="Register Tracking (AfterShip)"
              class="oe_highlight"
              invisible="aftership_id != False or tracking_number == False"/>

      <!-- Nút refresh: ẩn khi chưa có tracking_number -->
      <button name="action_refresh_tracking_aftership"
              type="object" string="Refresh Tracking"
              invisible="tracking_number == False"/>
    </xpath>

      <xpath expr="//sheet/notebook" position="inside">
        <page string="Tracking">
          <group>
            <field name="tracking_slug"/>
            <field name="tracking_number"/>
            <field name="aftership_id" readonly="1"/>
            <field name="tracking_status" readonly="1"/>
            <field name="tracking_last_checkpoint" readonly="1"/>
            <field name="tracking_payload" widget="json"/>
          </group>
        </page>
      </xpath>
    </field>
  </record>
</odoo>