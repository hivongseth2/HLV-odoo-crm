<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="ai_delivery_coordinator.DeliveryKanbanButtons">
        <button t-if="props.create" type="button"
                class="btn btn-primary o-kanban-button-new"
                t-on-click="() =&gt; this.create()">
            Tạo mới
        </button>
        <button class="btn btn-outline-primary ms-1"
                t-on-click="onRefreshCleanup"
                title="Cập nhật stock + xóa đơn đã giao xong">
            <i class="fa fa-refresh"/> Tải Lại
        </button>
        <button class="btn btn-outline-success ms-1"
                t-on-click="onTagAssign"
                title="Phân tuyến theo tags đơn hàng">
            <i class="fa fa-tags"/> Tags
        </button>
        <button class="btn btn-outline-info ms-1"
                t-on-click="onAiAssign"
                title="AI phân tuyến tự động">
            <i class="fa fa-robot"/> AI Phân Tuyến
        </button>
        <button class="btn btn-outline-warning ms-1"
                t-on-click="onCreateTrip"
                title="Tạo chuyến giao hàng">
            <i class="fa fa-truck"/> Tạo Chuyến
        </button>
    </t>

</templates>
