<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ai_delivery_coordinator</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="100"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="AI Vận Chuyển" name="ai_delivery_coordinator">
                    <block title="OpenAI API" name="openai_api_config">
                        <setting string="OpenAI API Key" help="Nhập OpenAI API key để sử dụng GPT.">
                            <field name="openai_api_key" password="True"/>
                        </setting>
                        <setting string="Model" help="VD: gpt-4o">
                            <field name="openai_model_delivery"/>
                        </setting>
                    </block>
                    <block title="Google Maps" name="google_maps_config">
                        <setting string="Google Maps API Key" help="API Key cho Geocoding và hiển thị bản đồ">
                            <field name="google_maps_api_key" password="True"/>
                        </setting>
                        <setting string="Kho xuất phát" help="Kho dùng để tính khoảng cách giao hàng">
                            <field name="delivery_warehouse_id"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
