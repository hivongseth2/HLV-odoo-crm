<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_schedule_list" model="ir.ui.view">
        <field name="name">delivery.schedule.list</field>
        <field name="model">delivery.schedule</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="route"/>
                <field name="vehicle_type"/>
                <field name="driver_name"/>
                <field name="session" widget="badge" decoration-info="session == 'morning'" decoration-warning="session == 'afternoon'" decoration-primary="session == 'evening'"/>
            </list>
        </field>
    </record>

    <record id="view_delivery_schedule_form" model="ir.ui.view">
        <field name="name">delivery.schedule.form</field>
        <field name="model">delivery.schedule</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_batch_picking" string="Tạo Batch Giao Hàng" type="object" class="oe_highlight"/>
                    <button name="action_view_google_map" string="Xem Bản Đồ (Google Maps)" type="object" icon="fa-map-marker" class="btn-info"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="session"/>
                            <field name="warehouse_code"/>
                            <field name="route"/>
                            <field name="vehicle_type"/>
                        </group>
                        <group>
                            <field name="driver_name"/>
                            <field name="note" widget="text" placeholder="Lý do điều phối từ AI..."/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Đơn hàng" name="orders">
                            <field name="line_ids" mode="list">
                                <list>
                                    <field name="order_id" widget="many2one"/>
                                    <field name="partner_id"/>
                                    <field name="commitment_date" widget="date"/>
                                    <field name="stock_status" widget="badge" 
                                           decoration-success="stock_status == 'ready'" 
                                           decoration-warning="stock_status == 'waiting'" 
                                           decoration-danger="stock_status == 'shortage'"/>
                                    <field name="ai_strategy"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_delivery_schedule_kanban" model="ir.ui.view">
        <field name="name">delivery.schedule.kanban</field>
        <field name="model">delivery.schedule</field>
        <field name="arch" type="xml">
            <kanban default_group_by="session" sample="1">
                <field name="name"/>
                <field name="date"/>
                <field name="route"/>
                <field name="vehicle_type"/>
                <field name="driver_name"/>
                <field name="session"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <span><field name="name"/></span>
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body mt-2">
                                <div><i class="fa fa-calendar" title="Ngày"/> <field name="date"/></div>
                                <div><i class="fa fa-map-marker" title="Tuyến"/> <field name="route"/></div>
                                <div><i class="fa fa-user" title="Tài xế"/> <field name="driver_name"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_delivery_schedule_calendar" model="ir.ui.view">
        <field name="name">delivery.schedule.calendar</field>
        <field name="model">delivery.schedule</field>
        <field name="arch" type="xml">
            <calendar string="Lịch Giao Hàng" date_start="date" color="route" mode="month" quick_create="0">
                <field name="name"/>
                <field name="driver_name"/>
                <field name="vehicle_type"/>
            </calendar>
        </field>
    </record>

    <record id="action_delivery_schedule" model="ir.actions.act_window">
        <field name="name">Lịch trình Giao Hàng</field>
        <field name="res_model">delivery.schedule</field>
        <field name="view_mode">kanban,list,calendar,form</field>
    </record>

    <!-- VIEWS CHO BẢNG ĐIỀU PHỐI (KÉO THẢ LINE) -->
    <record id="view_delivery_schedule_line_kanban" model="ir.ui.view">
        <field name="name">delivery.schedule.line.kanban</field>
        <field name="model">delivery.schedule.line</field>
        <field name="arch" type="xml">
            <kanban default_group_by="schedule_id" sample="1" class="o_kanban_small_column">
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="stock_status"/>
                <field name="ai_strategy"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-1">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <span><field name="order_id"/></span>
                                    </strong>
                                </div>
                                <div class="o_dropdown_kanban dropdown">
                                    <a class="dropdown-toggle o-no-caret btn" role="button" data-bs-toggle="dropdown" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                        <span class="fa fa-ellipsis-v"/>
                                    </a>
                                    <div class="dropdown-menu" role="menu">
                                        <a role="menuitem" type="edit" class="dropdown-item">Sửa</a>
                                        <a role="menuitem" type="delete" class="dropdown-item">Xóa</a>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div><i class="fa fa-user" title="Khách hàng"/> <field name="partner_id"/></div>
                                <div class="mt-1">
                                    <field name="stock_status" widget="badge" 
                                           decoration-success="stock_status == 'ready'" 
                                           decoration-warning="stock_status == 'waiting'" 
                                           decoration-danger="stock_status == 'shortage'"/>
                                </div>
                                <div t-if="record.ai_strategy.raw_value" class="mt-1 text-muted">
                                    <i class="fa fa-info-circle" title="AI Note"/> <field name="ai_strategy"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_delivery_schedule_line_form" model="ir.ui.view">
        <field name="name">delivery.schedule.line.form</field>
        <field name="model">delivery.schedule.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="schedule_id"/>
                        <field name="order_id"/>
                        <field name="partner_id"/>
                        <field name="stock_status"/>
                        <field name="ai_strategy"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_delivery_schedule_board" model="ir.actions.act_window">
        <field name="name">Bảng Điều Phối Lắp Ghép</field>
        <field name="res_model">delivery.schedule.line</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_group_by_schedule': 1}</field>
    </record>

</odoo>
