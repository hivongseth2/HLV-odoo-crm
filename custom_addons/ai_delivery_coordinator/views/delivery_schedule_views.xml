<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_schedule_list" model="ir.ui.view">
        <field name="name">delivery.schedule.list</field>
        <field name="model">delivery.schedule</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="route"/>
                <field name="vehicle_type"/>
                <field name="driver_name"/>
                <field name="session" widget="badge" decoration-info="session == 'morning'" decoration-warning="session == 'afternoon'" decoration-primary="session == 'evening'"/>
            </list>
        </field>
    </record>

    <record id="view_delivery_schedule_form" model="ir.ui.view">
        <field name="name">delivery.schedule.form</field>
        <field name="model">delivery.schedule</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_batch_picking" string="Tạo Batch Giao Hàng" type="object" class="oe_highlight"/>
                    <button name="action_view_google_map" string="Xem Bản Đồ (Google Maps)" type="object" icon="fa-map-marker" class="btn-info"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_kanban_board" type="object" class="oe_stat_button" icon="fa-tasks" string="Bảng Kéo Thả"/>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="session"/>
                            <field name="warehouse_code"/>
                            <field name="route"/>
                            <field name="vehicle_type"/>
                        </group>
                        <group>
                            <field name="driver_name"/>
                            <field name="note" widget="text" placeholder="Lý do điều phối từ AI..."/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Đơn hàng" name="orders">
                            <field name="line_ids" mode="list">
                                <list>
                                    <field name="order_id" widget="many2one"/>
                                    <field name="partner_id"/>
                                    <field name="commitment_date" widget="date"/>
                                    <field name="stock_status" widget="badge" 
                                           decoration-success="stock_status == 'ready'" 
                                           decoration-warning="stock_status == 'waiting'" 
                                           decoration-danger="stock_status == 'shortage'"/>
                                    <field name="ai_strategy"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_delivery_schedule_kanban" model="ir.ui.view">
        <field name="name">delivery.schedule.kanban</field>
        <field name="model">delivery.schedule</field>
        <field name="arch" type="xml">
            <kanban default_group_by="session" sample="1">
                <field name="name"/>
                <field name="date"/>
                <field name="route"/>
                <field name="vehicle_type"/>
                <field name="driver_name"/>
                <field name="session"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <span><field name="name"/></span>
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body mt-2">
                                <div><i class="fa fa-calendar" title="Ngày"/> <field name="date"/></div>
                                <div><i class="fa fa-map-marker" title="Tuyến"/> <field name="route"/></div>
                                <div><i class="fa fa-user" title="Tài xế"/> <field name="driver_name"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_delivery_schedule_calendar" model="ir.ui.view">
        <field name="name">delivery.schedule.calendar</field>
        <field name="model">delivery.schedule</field>
        <field name="arch" type="xml">
            <calendar string="Lịch Giao Hàng" date_start="date" color="route" mode="month" quick_create="0">
                <field name="name"/>
                <field name="driver_name"/>
                <field name="vehicle_type"/>
            </calendar>
        </field>
    </record>

    <record id="action_delivery_schedule" model="ir.actions.act_window">
        <field name="name">Lịch trình Giao Hàng</field>
        <field name="res_model">delivery.schedule</field>
        <field name="view_mode">kanban,list,calendar,form</field>
    </record>

    <!-- VIEWS CHO TUYẾN GIAO HÀNG (DELIVERY ROUTE) -->
    <record id="view_delivery_route_tree" model="ir.ui.view">
        <field name="name">delivery.route.tree</field>
        <field name="model">delivery.route</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_delivery_route" model="ir.actions.act_window">
        <field name="name">Cấu Hình Tuyến Giao Hàng</field>
        <field name="res_model">delivery.route</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- VIEWS CHO BẢNG ĐIỀU PHỐI (KÉO THẢ LINE) -->
    <record id="view_delivery_schedule_line_kanban" model="ir.ui.view">
        <field name="name">delivery.schedule.line.kanban</field>
        <field name="model">delivery.schedule.line</field>
        <field name="arch" type="xml">
            <kanban default_group_by="route_id" sample="1" class="o_kanban_small_column" js_class="delivery_kanban">
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="stock_status"/>
                <field name="ai_strategy"/>
                <field name="delivery_address"/>
                <field name="po_expected_date"/>
                <field name="commitment_date"/>
                <field name="ai_suggested_route"/>
                <field name="order_tag_ids"/>
                <field name="order_origin"/>
                <field name="order_htgh"/>
                <field name="distance_km"/>
                <field name="is_selected"/>
                <field name="kho_xuat"/>
                <field name="picking_status"/>
                <progressbar field="stock_status" colors='{"ready": "success", "partial": "warning", "waiting": "info", "shortage": "danger"}'/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <!-- Ribbon quá hạn giao -->
                        <t t-if="record.commitment_date.raw_value and new Date(record.commitment_date.raw_value) &lt;= new Date()">
                            <div class="delivery_overdue_ribbon">⚠ QUÁ HẠN</div>
                        </t>
                        <div class="d-flex align-items-center gap-1 mb-1">
                            <field name="is_selected" widget="boolean"/>
                            <strong><field name="order_id"/></strong>
                        </div>
                        <div><i class="fa fa-user"/> <field name="partner_id"/></div>
                        <div t-if="record.delivery_address.raw_value" class="text-muted small">
                            <i class="fa fa-map-marker"/> <field name="delivery_address"/>
                        </div>
                        <div t-if="record.commitment_date.raw_value" class="text-muted small" style="color: #ff9800;">
                            <i class="fa fa-calendar-check-o"/> Hẹn: <field name="commitment_date"/>
                        </div>
                        <!-- Tags -->
                        <div class="mt-1">
                            <field name="order_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </div>
                        <!-- HTGH, Origin -->
                        <div t-if="record.order_htgh.raw_value" class="mt-1 small">
                            <i class="fa fa-truck"/> <strong>HTGH:</strong> <field name="order_htgh"/>
                        </div>
                        <div t-if="record.order_origin.raw_value" class="text-muted small">
                            <i class="fa fa-info-circle"/> <field name="order_origin"/>
                        </div>
                        <!-- Stock + Picking status -->
                        <div class="mt-1">
                            <field name="stock_status" widget="badge"
                                   decoration-success="stock_status == 'ready'"
                                   decoration-warning="stock_status == 'partial'"
                                   decoration-info="stock_status == 'waiting'"
                                   decoration-danger="stock_status == 'shortage'"/>
                            <t t-if="record.picking_status.raw_value">
                                <span class="badge" style="background-color: #ff9800; color: white; margin-left: 4px;">
                                    <i class="fa fa-cubes"/> <field name="picking_status"/>
                                </span>
                            </t>
                        </div>
                        <div t-if="record.po_expected_date.raw_value and record.stock_status.raw_value != 'ready'" class="mt-1 small" style="color: #d32f2f;">
                            <i class="fa fa-truck"/> PO Về: <field name="po_expected_date"/>
                        </div>
                        <div t-if="record.distance_km.raw_value" class="mt-1 small">
                            <i class="fa fa-road"/> <strong><field name="distance_km"/> km</strong>
                        </div>
                        <div t-if="record.ai_suggested_route.raw_value" class="mt-1">
                            <span class="badge" style="background-color: #00bcd4; color: white;">AI Gợi ý: <field name="ai_suggested_route"/></span>
                        </div>
                        <div t-if="record.kho_xuat.raw_value" class="mt-1 small">
                            <i class="fa fa-building"/> <span class="badge text-bg-secondary"><field name="kho_xuat"/></span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_delivery_schedule_line_form" model="ir.ui.view">
        <field name="name">delivery.schedule.line.form</field>
        <field name="model">delivery.schedule.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="schedule_id"/>
                        <field name="assigned_date" invisible="1"/>
                        <field name="order_id"/>
                        <field name="partner_id"/>
                        <field name="delivery_address"/>
                        <field name="po_expected_date" invisible="po_expected_date == False"/>
                        <field name="stock_status"/>
                        <field name="ai_strategy"/>
                    </group>
                    <notebook>
                        <page string="Chi tiết sản phẩm" name="order_lines">
                            <field name="order_line_ids" readonly="1">
                                <list>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="product_uom_qty" string="SL Đặt"/>
                                    <field name="qty_delivered" string="SL Đã Giao"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_delivery_schedule_line_tree" model="ir.ui.view">
        <field name="name">delivery.schedule.line.tree</field>
        <field name="model">delivery.schedule.line</field>
        <field name="arch" type="xml">
            <list default_order="assigned_date desc, session, schedule_id">
                <field name="assigned_date"/>
                <field name="session"/>
                <field name="schedule_id"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="stock_status" widget="badge" 
                       decoration-success="stock_status == 'ready'" 
                       decoration-warning="stock_status == 'waiting'" 
                       decoration-danger="stock_status == 'shortage'"/>
                <field name="ai_strategy"/>
            </list>
        </field>
    </record>

    <record id="view_delivery_schedule_line_search" model="ir.ui.view">
        <field name="name">delivery.schedule.line.search</field>
        <field name="model">delivery.schedule.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="order_tag_ids"/>
                <field name="kho_xuat"/>
                <filter string="Hôm nay" name="filter_today" domain="[('assigned_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Chưa phân tuyến" name="filter_unassigned" domain="[('route_id', '=', False)]"/>
                <filter string="Chưa có chuyến" name="filter_no_trip" domain="[('trip_id', '=', False)]"/>
                <filter string="Đã chọn" name="filter_selected" domain="[('is_selected', '=', True)]"/>
                <separator/>
                <filter string="Đủ hàng" name="filter_ready" domain="[('stock_status', '=', 'ready')]"/>
                <filter string="Có 1 phần" name="filter_partial" domain="[('stock_status', '=', 'partial')]"/>
                <filter string="Chờ hàng" name="filter_waiting" domain="[('stock_status', '=', 'waiting')]"/>
                <filter string="Thiếu hàng" name="filter_shortage" domain="[('stock_status', '=', 'shortage')]"/>
                <group expand="0" string="Group By">
                    <filter string="Tuyến Giao" name="group_by_route" context="{'group_by':'route_id'}"/>
                    <filter string="Ngày giao" name="group_by_date" context="{'group_by':'assigned_date'}"/>
                    <filter string="Tình trạng hàng" name="group_by_stock_status" context="{'group_by':'stock_status'}"/>
                    <filter string="Kho xuất" name="group_by_kho_xuat" context="{'group_by':'kho_xuat'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_delivery_schedule_board" model="ir.actions.act_window">
        <field name="name">Bảng Điều Phối Lắp Ghép (Kanban)</field>
        <field name="res_model">delivery.schedule.line</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{}</field>
    </record>

    <!-- SERVER ACTIONS: AI Phân Tuyến & Tải Lại -->
    <record id="action_server_ai_assign_routes" model="ir.actions.server">
        <field name="name">🤖 AI Phân Tuyến</field>
        <field name="model_id" search="[('model', '=', 'delivery.schedule.line')]"/>
        <field name="binding_model_id" search="[('model', '=', 'delivery.schedule.line')]"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="state">code</field>
        <field name="code">action = records.action_ai_assign_routes()</field>
    </record>

    <record id="action_server_refresh_unassigned" model="ir.actions.server">
        <field name="name">🔄 Tải Lại và Dọn Đơn Xong</field>
        <field name="model_id" search="[('model', '=', 'delivery.schedule.line')]"/>
        <field name="binding_model_id" search="[('model', '=', 'delivery.schedule.line')]"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="state">code</field>
        <field name="code">action = records.action_refresh_unassigned()</field>
    </record>

    <record id="action_server_auto_assign_tags" model="ir.actions.server">
        <field name="name">🏷️ Phân Tuyến Theo Tags</field>
        <field name="model_id" search="[('model', '=', 'delivery.schedule.line')]"/>
        <field name="binding_model_id" search="[('model', '=', 'delivery.schedule.line')]"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="state">code</field>
        <field name="code">action = records.action_auto_assign_by_tags()</field>
    </record>

</odoo>
