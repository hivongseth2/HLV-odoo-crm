<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_coordinator_report_form" model="ir.ui.view">
        <field name="name">delivery.coordinator.report.form</field>
        <field name="model">delivery.coordinator.report</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Báo cáo tình hình đơn hàng tính đến ngày: <field name="date" readonly="1" class="fw-bold"/>
                    </div>
                    <group>
                        <group>
                            <field name="total_pending_orders" readonly="1"/>
                            <field name="orders_ready_to_ship" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Đơn nợ đọng (Từ ngày trước)" name="backlog">
                            <field name="orders_backlog_text" readonly="1" widget="text"/>
                        </page>
                        <page string="Đơn không đủ hàng (Bỏ qua)" name="insufficient">
                            <field name="orders_insufficient_stock_text" readonly="1" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button string="Đóng" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
