<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- SEQUENCE -->
    <record id="seq_delivery_trip" model="ir.sequence">
        <field name="name">Delivery Trip Sequence</field>
        <field name="code">delivery.trip</field>
        <field name="prefix">TRIP/%(year)s/</field>
        <field name="padding">4</field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_delivery_trip_form" model="ir.ui.view">
        <field name="name">delivery.trip.form</field>
        <field name="model">delivery.trip</field>
        <field name="arch" type="xml">
            <form string="Chuyến Giao Hàng">
                <header>
                    <button name="action_create_batch" type="object" string="📦 Tạo Batch Picking"
                            class="btn-primary" invisible="batch_id"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Thông tin chuyến">
                            <field name="date"/>
                            <field name="route_id"/>
                            <field name="departure_time"/>
                            <field name="priority" widget="badge"
                                   decoration-danger="priority == 'high'"
                                   decoration-warning="priority == 'normal'"
                                   decoration-info="priority == 'low'"/>
                        </group>
                        <group string="Phương tiện">
                            <field name="driver_id"/>
                            <field name="vehicle_type"/>
                            <field name="total_orders"/>
                            <field name="total_km"/>
                            <field name="batch_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Đơn hàng" name="orders">
                            <field name="line_ids" nolabel="1">
                                <list>
                                    <field name="order_id"/>
                                    <field name="partner_id"/>
                                    <field name="delivery_address"/>
                                    <field name="distance_km"/>
                                    <field name="stock_status" widget="badge"
                                           decoration-success="stock_status == 'ready'"
                                           decoration-warning="stock_status == 'partial'"
                                           decoration-info="stock_status == 'waiting'"
                                           decoration-danger="stock_status == 'shortage'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Ghi chú" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- LIST VIEW -->
    <record id="view_delivery_trip_list" model="ir.ui.view">
        <field name="name">delivery.trip.list</field>
        <field name="model">delivery.trip</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="route_id"/>
                <field name="driver_id"/>
                <field name="vehicle_type"/>
                <field name="departure_time"/>
                <field name="total_orders"/>
                <field name="total_km"/>
                <field name="priority" widget="badge"
                       decoration-danger="priority == 'high'"
                       decoration-warning="priority == 'normal'"
                       decoration-info="priority == 'low'"/>
                <field name="batch_id"/>
            </list>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_delivery_trip_search" model="ir.ui.view">
        <field name="name">delivery.trip.search</field>
        <field name="model">delivery.trip</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="route_id"/>
                <field name="driver_id"/>
                <filter string="Hôm nay" name="filter_today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Ưu tiên cao" name="filter_high" domain="[('priority', '=', 'high')]"/>
                <filter string="Chưa tạo batch" name="filter_no_batch" domain="[('batch_id', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Tuyến" name="group_route" context="{'group_by': 'route_id'}"/>
                    <filter string="Ngày" name="group_date" context="{'group_by': 'date'}"/>
                    <filter string="Tài xế" name="group_driver" context="{'group_by': 'driver_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_delivery_trip" model="ir.actions.act_window">
        <field name="name">Chuyến Giao Hàng</field>
        <field name="res_model">delivery.trip</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
