<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_delivery_trip_wizard_form" model="ir.ui.view">
        <field name="name">delivery.trip.wizard.form</field>
        <field name="model">delivery.trip.wizard</field>
        <field name="arch" type="xml">
            <form string="Tạo Chuyến Giao Hàng">
                <group>
                    <group string="Thông tin chuyến">
                        <field name="route_id"/>
                        <field name="date"/>
                        <field name="driver_id"/>
                        <field name="vehicle_id"/>
                        <field name="departure_time"/>
                    </group>
                    <group string="Thống kê">
                        <field name="total_orders"/>
                        <field name="total_km"/>
                        <field name="priority_label" widget="char"/>
                    </group>
                </group>
                <group>
                    <field name="suggestion_text" widget="text" readonly="1"
                           style="background: #f0f0f0; padding: 8px; border-radius: 4px; white-space: pre-wrap;"/>
                </group>
                <notebook>
                    <page string="Đơn hàng" name="orders">
                        <field name="line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="selected" widget="boolean_toggle"/>
                                <field name="schedule_line_id" column_invisible="1"/>
                                <field name="order_id"/>
                                <field name="partner_id"/>
                                <field name="delivery_address"/>
                                <field name="distance_km"/>
                                <field name="stock_status" widget="badge"
                                       decoration-success="stock_status == 'ready'"
                                       decoration-warning="stock_status == 'partial'"
                                       decoration-info="stock_status == 'waiting'"
                                       decoration-danger="stock_status == 'shortage'"/>
                                <field name="picking_status"/>
                                <field name="order_htgh" optional="show"/>
                                <field name="ai_group" optional="show"/>
                            </list>
                        </field>
                    </page>
                    <page string="Ghi chú" name="notes">
                        <field name="notes" placeholder="Ghi chú cho chuyến giao..."/>
                    </page>
                </notebook>
                <footer>
                    <button name="action_create_trip" type="object" string="📦 Tạo Chuyến" class="btn-primary"/>
                    <button name="action_ai_suggest_groups" type="object" string="🤖 AI Gợi Ý Nhóm" class="btn-success"/>
                    <button name="action_select_group" type="object" string="↪ Nhóm Tiếp" class="btn-warning"/>
                    <button name="action_suggest_early_morning" type="object" string="🌅 3 đơn gần nhất" class="btn-info"/>
                    <button name="action_select_ready_only" type="object" string="✅ Chỉ đủ hàng" class="btn-info"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
