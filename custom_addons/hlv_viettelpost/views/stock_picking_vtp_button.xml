<odoo>
  <record id="view_picking_form_vtp" model="ir.ui.view">
    <field name="name">stock.picking.form.vtp</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button name="action_vtp_create_order"
                string="Tạo vận đơn Viettel Post"
                type="object"
                class="btn-primary"
                groups="stock.group_stock_user"
                invisible="(carrier_id == False) or (carrier_id.delivery_type != 'vtp')"/>
      </xpath>
    </field>
  </record>
</odoo>
