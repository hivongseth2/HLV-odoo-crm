<odoo>
  <!-- Action mở wizard -->
  <record id="action_vtp_sync_wizard" model="ir.actions.act_window">
    <field name="name">Đồng bộ địa giới Viettel Post</field>
    <field name="res_model">vtp.sync.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

  <!-- Menu (đặt parent theo menu bạn muốn, ví dụ dưới đặt ở gốc cấu hình kho) -->
  <menuitem id="menu_vtp_root" name="Viettel Post" parent="stock.menu_stock_warehouse_mgmt" sequence="95"/>
  <menuitem id="menu_vtp_sync_wizard"
            name="Đồng bộ địa giới"
            parent="menu_vtp_root"
            action="action_vtp_sync_wizard"
            sequence="1"/>

  <!-- Form wizard -->
  <record id="view_vtp_sync_wizard_form" model="ir.ui.view">
    <field name="name">vtp.sync.wizard.form</field>
    <field name="model">vtp.sync.wizard</field>
    <field name="arch" type="xml">
      <form string="Đồng bộ địa giới Viettel Post">
        <group>
          <!-- Dùng class='o_form_label' vì không có 'for' -->
          <label class="o_form_label"
                 string="Thao tác này sẽ tải lại toàn bộ danh sách Tỉnh/Thành, Quận/Huyện, Phường/Xã từ API Viettel Post."/>
          <label class="o_form_label"
                 string="(Quá trình có thể mất vài phút)"/>
        </group>
        <footer>
          <button name="action_sync_geo"
                  type="object"
                  string="Đồng bộ ngay"
                  class="btn-primary"/>
          <button string="Hủy" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
