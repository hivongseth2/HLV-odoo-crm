<odoo>
  <!-- MENU -->
  <menuitem id="menu_vtp_root" name="Viettel Post" sequence="95"/>

  <record id="action_vtp_sync_wizard" model="ir.actions.act_window">
    <field name="name">Đồng bộ địa giới Viettel Post</field>
    <field name="res_model">vtp.sync.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

  <menuitem id="menu_vtp_sync_wizard"
            name="Đồng bộ địa giới"
            parent="menu_vtp_root"
            action="action_vtp_sync_wizard"
            sequence="1"/>

  <!-- FORM VIEW -->
  <record id="view_vtp_sync_wizard_form" model="ir.ui.view">
    <field name="name">vtp.sync.wizard.form</field>
    <field name="model">vtp.sync.wizard</field>
    <field name="arch" type="xml">
      <form string="Đồng bộ địa giới Viettel Post">
        <group>
          <label string="Thao tác này sẽ tải lại toàn bộ danh sách Tỉnh/Thành, Quận/Huyện, Phường/Xã từ API Viettel Post."/>
          <label string="(Quá trình có thể mất vài phút)"/>
        </group>
        <footer>
          <button name="action_sync_geo"
                  string="Đồng bộ ngay"
                  type="object"
                  class="btn-primary"/>
          <button string="Hủy" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
