<odoo>
  <record id="view_vtp_sync_wizard" model="ir.ui.view">
    <field name="name">vtp.sync.wizard.form</field>
    <field name="model">vtp.sync.wizard</field>
    <field name="arch" type="xml">
      <form string="Sync Viettel Post Address">
        <group>
          <p>Ấn nút bên dưới để đồng bộ Tỉnh/Quận/Phường từ Viettel Post.</p>
        </group>
        <footer>
          <button string="Đồng bộ ngay" type="object" name="action_sync_geo" class="btn-primary"/>
          <button string="Đóng" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_vtp_sync_wizard" model="ir.actions.act_window">
    <field name="name">Sync Địa giới</field>
    <field name="res_model">vtp.sync.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

  <menuitem id="menu_vtp_sync" name="Đồng bộ địa giới" parent="menu_vtp_root" action="action_vtp_sync_wizard" sequence="1"/>
</odoo>
