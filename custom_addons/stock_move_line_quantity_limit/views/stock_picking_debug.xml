<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View for Debug Helper -->
        <record id="stock_quantity_limit_debug_form" model="ir.ui.view">
            <field name="name">stock.quantity.limit.debug.form</field>
            <field name="model">stock.quantity.limit.debug</field>
            <field name="arch" type="xml">
                <form>
                    <h2>🔍 Debug Picking Assign</h2>
                    <group>
                        <field name="picking_id" />
                    </group>
                    <group>
                        <field name="debug_log" widget="text" nolabel="1" />
                    </group>
                    <footer>
                        <button string="🔍 Phân tích Lỗi" name="action_debug_picking" type="object" class="btn-primary"/>
                        <button string="🔧 Sửa Ghost Reservation" name="action_fix_ghost_reservations" type="object" class="btn-warning"/>
                        <button string="Đóng" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Action for Debug Helper -->
        <record id="action_stock_quantity_limit_debug" model="ir.actions.act_window">
            <field name="name">Debug Picking Assign</field>
            <field name="res_model">stock.quantity.limit.debug</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="stock_quantity_limit_debug_form"/>
        </record>

        <!-- Menu Item -->
        <menuitem
            id="menu_stock_quantity_limit_debug"
            name="🔍 Debug Picking"
            parent="stock.menu_stock_root"
            action="action_stock_quantity_limit_debug"
            sequence="100"
        />
    </data>
</odoo>
