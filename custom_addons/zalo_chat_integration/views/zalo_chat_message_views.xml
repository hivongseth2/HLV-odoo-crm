<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Message List View -->
    <record id="view_zalo_chat_message_list" model="ir.ui.view">
        <field name="name">zalo.chat.message.list</field>
        <field name="model">zalo.chat.message</field>
        <field name="arch" type="xml">
            <list string="Zalo Messages" create="false">
                <field name="sent_date"/>
                <field name="conversation_id"/>
                <field name="direction"/>
                <field name="message_type"/>
                <field name="content"/>
                <field name="state"/>
                <field name="is_read" invisible="direction == 'outbound'"/>
            </list>
        </field>
    </record>

    <!-- Message Form View -->
    <record id="view_zalo_chat_message_form" model="ir.ui.view">
        <field name="name">zalo.chat.message.form</field>
        <field name="model">zalo.chat.message</field>
        <field name="arch" type="xml">
            <form string="Zalo Message" create="false" delete="false">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="conversation_id"/>
                            <field name="partner_id"/>
                            <field name="message_id"/>
                            <field name="direction"/>
                        </group>
                        <group>
                            <field name="message_type"/>
                            <field name="sent_date"/>
                            <field name="is_read" invisible="direction == 'outbound'"/>
                        </group>
                    </group>
                    <group>
                        <field name="content" invisible="message_type != 'text'"/>
                        <field name="attachment_url" widget="url" invisible="not attachment_url"/>
                        <field name="error_message" invisible="state != 'failed'"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Message Search View -->
    <record id="view_zalo_chat_message_search" model="ir.ui.view">
        <field name="name">zalo.chat.message.search</field>
        <field name="model">zalo.chat.message</field>
        <field name="arch" type="xml">
            <search string="Search Messages">
                <field name="conversation_id"/>
                <field name="content"/>
                <filter string="Inbound" name="inbound" domain="[('direction', '=', 'inbound')]"/>
                <filter string="Outbound" name="outbound" domain="[('direction', '=', 'outbound')]"/>
                <separator/>
                <filter string="Text" name="text" domain="[('message_type', '=', 'text')]"/>
                <filter string="Image" name="image" domain="[('message_type', '=', 'image')]"/>
                <filter string="Failed" name="failed" domain="[('state', '=', 'failed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Conversation" name="group_conversation" context="{'group_by': 'conversation_id'}"/>
                    <filter string="Direction" name="group_direction" context="{'group_by': 'direction'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'message_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Message Action -->
    <record id="action_zalo_chat_message" model="ir.actions.act_window">
        <field name="name">Messages</field>
        <field name="res_model">zalo.chat.message</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No messages yet
            </p>
        </field>
    </record>
</odoo>
