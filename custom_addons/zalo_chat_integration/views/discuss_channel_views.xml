<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add GPT Buttons to Live Chat Session Form -->
    <record id="discuss_channel_view_form_inherit_zalo_gpt" model="ir.ui.view">
        <field name="name">discuss.channel.view.form.inherit.zalo.gpt</field>
        <field name="model">discuss.channel</field>
        <field name="inherit_id" ref="im_livechat.discuss_channel_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_gpt_create_quote" string="🤖 AI Tạo Báo Giá" type="object" class="btn-primary"/>
                    <button name="action_gpt_summarize" string="📝 Tóm tắt hội thoại" type="object" class="btn-secondary"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
