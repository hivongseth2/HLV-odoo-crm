<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_zalo_assistant" model="ir.ui.view">
        <field name="name">res.partner.form.zalo.assistant</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Zalo Assistant">
                    <group>
                        <field name="zalo_summary_html" nolabel="1"/>
                        <field name="zalo_last_assistant_run" readonly="1"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
