<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kanban View -->
    <record id="view_zalo_customer_profile_kanban" model="ir.ui.view">
        <field name="name">zalo.customer.profile.kanban</field>
        <field name="model">zalo.customer.profile</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="partner_id"/>
                <field name="evaluation_count"/>
                <field name="display_tag_ids"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="partner_id"/>
                                </strong>
                                <div class="o_kanban_tags_section">
                                    <span t-foreach="record.display_tag_ids.value" t-as="tag" class="badge badge-info mr-1">
                                        <t t-esc="tag.name"/>
                                    </span>
                                </div>
                                <div class="mt-2">
                                    <span class="badge badge-secondary">
                                        <i class="fa fa-file-text-o" title="Số phiếu"/> <field name="evaluation_count"/> Phiếu
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- List View -->
    <record id="view_zalo_customer_profile_list" model="ir.ui.view">
        <field name="name">zalo.customer.profile.list</field>
        <field name="model">zalo.customer.profile</field>
        <field name="arch" type="xml">
            <list string="Hồ sơ khách hàng">
                <field name="partner_id"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="evaluation_count"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_zalo_customer_profile_form" model="ir.ui.view">
        <field name="name">zalo.customer.profile.form</field>
        <field name="model">zalo.customer.profile</field>
        <field name="arch" type="xml">
            <form string="Hồ sơ khách hàng Zalo">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="partner_id" placeholder="Tên khách hàng"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': False}"/>
                        </group>
                        <group>
                            <field name="evaluation_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tóm tắt tổng hợp (AI)">
                            <div class="alert alert-info">
                                Thông tin này được AI tự động tổng hợp từ các phiên đánh giá. Bạn có thể chỉnh sửa thủ công.
                            </div>
                            <field name="summary_cumulative" placeholder="Chưa có tóm tắt..."/>
                        </page>
                        <page string="Lịch sử đánh giá">
                            <field name="evaluation_ids">
                                <list string="Phiếu đánh giá">
                                    <field name="create_date"/>
                                    <field name="name"/>
                                    <field name="gpt_sentiment" widget="badge"/>
                                    <field name="gpt_suggestion" widget="badge"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_zalo_customer_profile_search" model="ir.ui.view">
        <field name="name">zalo.customer.profile.search</field>
        <field name="model">zalo.customer.profile</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="tag_ids"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_zalo_customer_profile" model="ir.actions.act_window">
        <field name="name">Hồ sơ khách hàng</field>
        <field name="res_model">zalo.customer.profile</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có hồ sơ khách hàng nào.
            </p>
        </field>
    </record>
</odoo>
