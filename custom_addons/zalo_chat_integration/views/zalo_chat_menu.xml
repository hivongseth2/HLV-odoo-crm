<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Main Menu -->
    <menuitem id="menu_zalo_chat_root"
              name="Zalo Chat"
              sequence="100"
              web_icon="zalo_chat_integration,static/description/icon.png"/>

    <!-- Zalo Chat - Opens Discuss with all Zalo channels -->
    <record id="action_open_zalo_discuss" model="ir.actions.server">
        <field name="name">Zalo Chat</field>
        <field name="model_id" ref="model_zalo_chat_conversation"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_all_zalo_chats()</field>
    </record>

    <menuitem id="menu_zalo_chat_conversations"
              name="Zalo Chat"
              parent="menu_zalo_chat_root"
              action="action_open_zalo_discuss"
              sequence="5"/>

    <!-- Conversations List (for managing) -->
    <menuitem id="menu_zalo_chat_conversations_list"
              name="Conversations"
              parent="menu_zalo_chat_root"
              action="action_zalo_chat_conversation"
              sequence="10"/>

    <!-- Messages Menu (Technical) -->
    <menuitem id="menu_zalo_chat_messages"
              name="Messages"
              parent="menu_zalo_chat_root"
              action="action_zalo_chat_message"
              sequence="20"
              groups="base.group_no_one"/>

    <!-- Configuration Menu -->
    <menuitem id="menu_zalo_chat_config"
              name="Configuration"
              parent="menu_zalo_chat_root"
              sequence="90"/>

    <!-- Zalo OA Settings -->
    <menuitem id="menu_zalo_oa_config"
              name="Zalo OA Settings"
              parent="menu_zalo_chat_config"
              action="action_zalo_oa_config"
              sequence="10"/>
</odoo>
