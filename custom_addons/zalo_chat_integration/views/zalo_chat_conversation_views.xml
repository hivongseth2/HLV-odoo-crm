<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Conversation List View -->
    <record id="view_zalo_chat_conversation_list" model="ir.ui.view">
        <field name="name">zalo.chat.conversation.list</field>
        <field name="model">zalo.chat.conversation</field>
        <field name="arch" type="xml">
            <list string="Zalo Conversations">
                <field name="name"/>
                <field name="zalo_user_name"/>
                <field name="partner_id"/>
                <field name="last_message_date"/>
                <field name="unread_count" string="Unread"/>
                <field name="state" decoration-success="state == 'open'" decoration-muted="state == 'closed'"/>
            </list>
        </field>
    </record>

    <!-- Conversation Form View -->
        <record id="view_zalo_chat_conversation_form" model="ir.ui.view">
            <field name="name">zalo.chat.conversation.form</field>
            <field name="model">zalo.chat.conversation</field>
            <field name="arch" type="xml">
                <form string="Hội thoại Zalo">
                    <header>
                        <button name="action_open_chat" string="Mở Live Chat" type="object" 
                                class="oe_highlight" icon="fa-comments"/>
                        <button name="action_gpt_summarize" string="✨ Tóm tắt (GPT)" type="object" 
                                class="btn-secondary"/>
                        <button name="action_gpt_create_quote" string="📝 Tạo Báo Giá (GPT)" type="object" 
                                class="btn-primary"/>
                        <button name="action_send_message" string="Gửi tin nhắn" type="object" 
                                icon="fa-paper-plane"
                                invisible="state == 'archived'"/>
                        <button name="action_close" string="Đóng" type="object" 
                                invisible="state != 'open'" icon="fa-times"/>
                        <button name="action_reopen" string="Mở lại" type="object" 
                                invisible="state != 'closed'" icon="fa-folder-open"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" icon="fa-envelope" 
                                    invisible="unread_count == 0">
                                <field name="unread_count" widget="statinfo" string="Chưa đọc"/>
                            </button>
                        </div>
                        
                        <div class="oe_title">
                            <h1>
                                <field name="zalo_user_name" placeholder="Tên người dùng Zalo" 
                                       class="o_text_overflow" style="max-width: 90%;"/>
                            </h1>
                            <h3 class="text-muted">
                                <field name="zalo_user_id" readonly="1"/>
                            </h3>
                        </div>
                        
                        <group>
                            <group>
                                <field name="partner_id" options="{'no_create': True}"/>
                                <field name="last_message_date" readonly="1"/>
                            </group>
                            <group>
                                <field name="zalo_avatar" widget="url" readonly="1"/>
                            </group>
                        </group>
                        
                        <separator string="Tin nhắn"/>
                        
                        <!-- Chat-like message display -->
                        <field name="message_ids" mode="list" nolabel="1">
                            <list string="Tin nhắn" create="false" delete="false" 
                                  decoration-info="direction == 'inbound'" 
                                  decoration-success="direction == 'outbound'">
                                <field name="sent_date" string="Thời gian"/>
                                <field name="direction" string="Chiều" 
                                       decoration-bf="1"/>
                                <field name="message_type" string="Loại"/>
                                <field name="content" string="Nội dung" 
                                       widget="text" class="o_field_text"/>
                                <field name="state" string="Trạng thái"
                                       decoration-success="state == 'delivered'" 
                                       decoration-danger="state == 'failed'"/>
                            </list>
                        </field>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

    <!-- Conversation Kanban View -->
        <record id="view_zalo_chat_conversation_kanban" model="ir.ui.view">
            <field name="name">zalo.chat.conversation.kanban</field>
            <field name="model">zalo.chat.conversation</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" sample="1">
                    <field name="zalo_user_id"/>
                    <field name="zalo_user_name"/>
                    <field name="partner_id"/>
                    <field name="last_message_date"/>
                    <field name="state"/>
                    <field name="unread_count"/>
                    <field name="discuss_channel_id"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click" style="position: relative;">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="zalo_user_name"/>
                                        </strong>
                                        <div class="o_kanban_record_subtitle text-muted">
                                            <field name="partner_id"/>
                                        </div>
                                    </div>
                                    <span t-if="record.unread_count.value > 0" 
                                          class="badge badge-pill badge-danger" 
                                          style="position: absolute; top: 5px; right: 5px;">
                                        <t t-esc="record.unread_count.value"/>
                                    </span>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="last_message_date" widget="relative"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="state" widget="label_selection" 
                                               options="{'classes': {'open': 'success', 'closed': 'default', 'archived': 'warning'}}"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

    <!-- Conversation Search View -->
    <record id="view_zalo_chat_conversation_search" model="ir.ui.view">
        <field name="name">zalo.chat.conversation.search</field>
        <field name="model">zalo.chat.conversation</field>
        <field name="arch" type="xml">
            <search string="Search Conversations">
                <field name="name"/>
                <field name="zalo_user_name"/>
                <field name="zalo_user_id"/>
                <field name="partner_id"/>
                <filter string="Open" name="open" domain="[('state', '=', 'open')]"/>
                <filter string="Closed" name="closed" domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter string="Today" name="today" domain="[('last_message_date', '>=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="This Week" name="this_week" domain="[('last_message_date', '>=', (context_today() - relativedelta(weeks=1)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Contact" name="group_partner" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Conversation Action -->
    <record id="action_zalo_chat_conversation" model="ir.actions.act_window">
        <field name="name">Conversations</field>
        <field name="res_model">zalo.chat.conversation</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Zalo conversations yet
            </p>
            <p>
                Conversations will appear here when customers send messages to your Zalo OA.
            </p>
        </field>
    </record>
</odoo>
