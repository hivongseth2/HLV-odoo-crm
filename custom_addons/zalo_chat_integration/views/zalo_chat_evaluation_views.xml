<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zalo_chat_evaluation_search" model="ir.ui.view">
        <field name="name">zalo.chat.evaluation.search</field>
        <field name="model">zalo.chat.evaluation</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm Đánh giá">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="conversation_id"/>
                <field name="gpt_sentiment"/>
                <field name="gpt_suggestion"/>
                <field name="state"/>
                <filter string="Tích cực" name="positive" domain="[('gpt_sentiment', '=', 'positive')]"/>
                <filter string="Tiêu cực" name="negative" domain="[('gpt_sentiment', '=', 'negative')]"/>
                <filter string="Cần Báo giá" name="quote" domain="[('gpt_suggestion', '=', 'create_quote')]"/>
                <group expand="1" string="Group By">
                    <filter string="Khách hàng" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Thái độ" name="group_sentiment" context="{'group_by': 'gpt_sentiment'}"/>
                    <filter string="Đề xuất" name="group_suggestion" context="{'group_by': 'gpt_suggestion'}"/>
                    <filter string="Ngày tạo" name="group_date" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_zalo_chat_evaluation_form" model="ir.ui.view">
        <field name="name">zalo.chat.evaluation.form</field>
        <field name="model">zalo.chat.evaluation</field>
        <field name="arch" type="xml">
            <form string="Đánh giá hội thoại">
                <header>
                    <button name="action_analyze_gpt" string="🔎 Phân tích ngay (AI)" type="object" class="btn-primary" invisible="state == 'analyzed'"/>
                    <button name="action_analyze_gpt" string="Phân tích lại" type="object" invisible="state == 'draft'"/>
                    <button name="action_create_quote" string="📝 Tạo Báo Giá" type="object" class="btn-success" invisible="gpt_suggestion != 'create_quote'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="create_date"/>
                            <field name="conversation_id"/>
                            <!-- <field name="livechat_channel_id"/> -->
                        </group>
                        <group>
                            <field name="gpt_sentiment" widget="badge" decoration-success="gpt_sentiment == 'positive'" decoration-danger="gpt_sentiment == 'negative'"/>
                            <field name="gpt_suggestion" widget="badge" decoration-info="gpt_suggestion == 'create_quote'"/>
                            <field name="sale_order_id" invisible="not sale_order_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Kết quả phân tích (AI)">
                            <group>
                                <field name="gpt_summary"/>
                                <field name="gpt_issues"/>
                            </group>
                        </page>
                        <page string="Nội dung hội thoại">
                            <field name="chat_content"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_zalo_chat_evaluation_tree" model="ir.ui.view">
        <field name="name">zalo.chat.evaluation.tree</field>
        <field name="model">zalo.chat.evaluation</field>
        <field name="arch" type="xml">
            <list string="Đánh giá hội thoại">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="create_date"/>
                <field name="gpt_sentiment" widget="badge" decoration-success="gpt_sentiment == 'positive'" decoration-danger="gpt_sentiment == 'negative'"/>
                <field name="gpt_suggestion" widget="badge" decoration-info="gpt_suggestion == 'create_quote'"/>
                <field name="state" widget="badge" decoration-success="state == 'analyzed'"/>
            </list>
        </field>
    </record>

    <record id="view_zalo_chat_evaluation_graph" model="ir.ui.view">
        <field name="name">zalo.chat.evaluation.graph</field>
        <field name="model">zalo.chat.evaluation</field>
        <field name="arch" type="xml">
            <graph string="Phân tích hội thoại" sample="1">
                <field name="create_date" interval="day"/>
                <field name="gpt_sentiment"/>
                <field name="gpt_suggestion"/>
            </graph>
        </field>
    </record>

    <record id="view_zalo_chat_evaluation_pivot" model="ir.ui.view">
        <field name="name">zalo.chat.evaluation.pivot</field>
        <field name="model">zalo.chat.evaluation</field>
        <field name="arch" type="xml">
            <pivot string="Phân tích hội thoại" sample="1">
                <field name="create_date" type="row" interval="day"/>
                <field name="gpt_sentiment" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="action_zalo_chat_evaluation" model="ir.actions.act_window">
        <field name="name">Đánh giá hội thoại</field>
        <field name="res_model">zalo.chat.evaluation</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có đánh giá nào.
            </p>
            <p>
                Sử dụng tính năng này để phân tích chất lượng cuộc gọi và tự động đề xuất hành động.
            </p>
        </field>
    </record>
</odoo>
