<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_alias_list" model="ir.ui.view">
        <field name="name">product.alias.list</field>
        <field name="model">product.alias</field>
        <field name="arch" type="xml">
            <list string="Product Aliases">
                <field name="alias"/>
                <field name="product_id"/>
                <field name="weight"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_product_alias_form" model="ir.ui.view">
        <field name="name">product.alias.form</field>
        <field name="model">product.alias</field>
        <field name="arch" type="xml">
            <form string="Product Alias">
                <sheet>
                    <group>
                        <field name="alias"/>
                        <field name="product_id"/>
                        <field name="weight"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_product_alias" model="ir.actions.act_window">
        <field name="name">Product Aliases</field>
        <field name="res_model">product.alias</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Dedicated menu can be removed if aliases are managed in product form -->
</odoo>
