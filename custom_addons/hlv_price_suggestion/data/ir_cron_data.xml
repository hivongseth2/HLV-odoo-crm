<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Cron: Tự động tạo đề xuất giá hàng tuần -->
    <record id="ir_cron_price_suggestion" model="ir.cron">
        <field name="name">Đề xuất giá bán: Tự động phân tích</field>
        <field name="model_id" ref="model_price_suggestion"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_suggestions()</field>
        <field name="interval_number">7</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">False</field>
    </record>

</odoo>
