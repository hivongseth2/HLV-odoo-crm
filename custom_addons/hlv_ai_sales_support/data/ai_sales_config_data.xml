<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default AI Sales Configuration -->
        <record id="default_ai_sales_config" model="hlv.ai.sales.config">
            <field name="name">Default AI Sales Configuration</field>
            <field name="active">True</field>
            <field name="openai_model">gpt-3.5-turbo</field>
            <field name="max_tokens">1000</field>
            <field name="temperature">0.3</field>
            <field name="auto_send_quotation">True</field>
            <field name="quotation_validity_days">7</field>
            <field name="stock_buffer_percentage">10.0</field>
            <field name="check_all_warehouses">True</field>
        </record>

        <!-- Sequences -->
        <record id="seq_sales_request" model="ir.sequence">
            <field name="name">AI Sales Request</field>
            <field name="code">hlv.ai.sales.request</field>
            <field name="prefix">SR</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_product_inquiry" model="ir.sequence">
            <field name="name">AI Product Inquiry</field>
            <field name="code">hlv.ai.product.inquiry</field>
            <field name="prefix">PI</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_sales_response" model="ir.sequence">
            <field name="name">AI Sales Response</field>
            <field name="code">hlv.ai.sales.response</field>
            <field name="prefix">RSP</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- System Parameters -->
        <record id="param_zalo_verify_token" model="ir.config_parameter">
            <field name="key">hlv_ai_sales.zalo_verify_token</field>
            <field name="value">hlv_ai_sales_webhook_2024</field>
        </record>

        <!-- Cron Job for checking inquiry timeouts -->
        <record id="cron_check_inquiry_timeouts" model="ir.cron">
            <field name="name">AI Sales: Check Inquiry Timeouts</field>
            <field name="model_id" ref="model_hlv_ai_product_inquiry"/>
            <field name="state">code</field>
            <field name="code">model.check_timeouts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>