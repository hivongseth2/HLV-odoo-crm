<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Inquiry Form View -->
    <record id="view_product_inquiry_form" model="ir.ui.view">
        <field name="name">hlv.ai.product.inquiry.form</field>
        <field name="model">hlv.ai.product.inquiry</field>
        <field name="arch" type="xml">
            <form string="Product Inquiry">
                <header>
                    <button name="action_send_inquiry" type="object" string="Send Inquiry" 
                            class="btn-primary" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_retry_inquiry" type="object" string="Retry" 
                            class="btn-warning" attrs="{'invisible': [('state', 'not in', ['error', 'timeout'])]}"/>
                    <button name="action_mark_timeout" type="object" string="Mark as Timeout" 
                            class="btn-secondary" attrs="{'invisible': [('state', '!=', 'sent')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,responded"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="inquiry_id" readonly="1"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Related Records">
                            <field name="sales_request_id" readonly="1"/>
                            <field name="supplier_id" readonly="1"/>
                        </group>
                        <group string="Timing">
                            <field name="sent_date" readonly="1"/>
                            <field name="expected_response_date" readonly="1"/>
                            <field name="response_received_date" readonly="1"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Product Information" name="product_info">
                            <group>
                                <group>
                                    <field name="product_name"/>
                                    <field name="quantity"/>
                                    <field name="unit"/>
                                </group>
                            </group>
                            <group>
                                <field name="description" widget="text"/>
                            </group>
                        </page>
                        
                        <page string="Inquiry Message" name="inquiry_message">
                            <group>
                                <field name="inquiry_message" widget="text" readonly="1"/>
                            </group>
                        </page>
                        
                        <page string="Supplier Response" name="supplier_response" attrs="{'invisible': [('state', 'not in', ['responded'])]}">
                            <group>
                                <group string="Pricing Information">
                                    <field name="quoted_price"/>
                                    <field name="quoted_currency"/>
                                    <field name="minimum_order_qty"/>
                                    <field name="delivery_time"/>
                                </group>
                            </group>
                            <group>
                                <field name="supplier_response" widget="text" readonly="1"/>
                            </group>
                            <group>
                                <field name="supplier_notes" widget="text"/>
                            </group>
                        </page>
                        
                        <page string="Communication Log" name="communication_log">
                            <group>
                                <group string="Technical Details">
                                    <field name="zalo_message_id" readonly="1"/>
                                    <field name="retry_count" readonly="1"/>
                                    <field name="last_retry_date" readonly="1"/>
                                </group>
                            </group>
                            <group>
                                <field name="communication_log" widget="text" readonly="1"/>
                            </group>
                            <group>
                                <field name="internal_notes" widget="text"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Product Inquiry Tree View -->
    <record id="view_product_inquiry_tree" model="ir.ui.view">
        <field name="name">hlv.ai.product.inquiry.tree</field>
        <field name="model">hlv.ai.product.inquiry</field>
        <field name="arch" type="xml">
            <tree string="Product Inquiries" decoration-success="state=='responded'" 
                  decoration-danger="state=='error'" decoration-warning="state=='timeout'">
                <field name="inquiry_id"/>
                <field name="supplier_id"/>
                <field name="product_name"/>
                <field name="quantity"/>
                <field name="unit"/>
                <field name="state"/>
                <field name="sent_date"/>
                <field name="quoted_price"/>
                <field name="delivery_time"/>
                <field name="sales_request_id"/>
            </tree>
        </field>
    </record>

    <!-- Product Inquiry Kanban View -->
    <record id="view_product_inquiry_kanban" model="ir.ui.view">
        <field name="name">hlv.ai.product.inquiry.kanban</field>
        <field name="model">hlv.ai.product.inquiry</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="inquiry_id"/>
                <field name="supplier_id"/>
                <field name="product_name"/>
                <field name="quoted_price"/>
                <field name="delivery_time"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="inquiry_id"/>
                                        </strong>
                                        <br/>
                                        <span class="o_kanban_record_subtitle">
                                            <field name="supplier_id"/>
                                        </span>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div>
                                        <strong>Product:</strong> <field name="product_name"/>
                                    </div>
                                    <div t-if="record.quoted_price.value">
                                        <strong>Price:</strong> <field name="quoted_price"/> <field name="quoted_currency"/>
                                    </div>
                                    <div t-if="record.delivery_time.value">
                                        <strong>Delivery:</strong> <field name="delivery_time"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Product Inquiry Search View -->
    <record id="view_product_inquiry_search" model="ir.ui.view">
        <field name="name">hlv.ai.product.inquiry.search</field>
        <field name="model">hlv.ai.product.inquiry</field>
        <field name="arch" type="xml">
            <search string="Search Product Inquiries">
                <field name="inquiry_id"/>
                <field name="supplier_id"/>
                <field name="product_name"/>
                <field name="sales_request_id"/>
                
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Sent" name="sent" domain="[('state', '=', 'sent')]"/>
                <filter string="Responded" name="responded" domain="[('state', '=', 'responded')]"/>
                <filter string="Timeout" name="timeout" domain="[('state', '=', 'timeout')]"/>
                <filter string="Error" name="error" domain="[('state', '=', 'error')]"/>
                
                <separator/>
                <filter string="With Quote" name="with_quote" domain="[('quoted_price', '>', 0)]"/>
                <filter string="Today" name="today" domain="[('create_date', '>=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Supplier" name="group_supplier" context="{'group_by': 'supplier_id'}"/>
                    <filter string="Sales Request" name="group_sales_request" context="{'group_by': 'sales_request_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Product Inquiry Action -->
    <record id="action_product_inquiry" model="ir.actions.act_window">
        <field name="name">Product Inquiries</field>
        <field name="res_model">hlv.ai.product.inquiry</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No product inquiries yet
            </p>
            <p>
                Product inquiries to suppliers will appear here when the system
                needs to contact suppliers for pricing and availability information.
            </p>
        </field>
    </record>
</odoo>