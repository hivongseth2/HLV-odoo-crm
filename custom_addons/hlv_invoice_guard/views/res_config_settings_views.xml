<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_invoice_guard" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.invoice.guard</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="HLV Invoice Guard" string="HLV Invoice Guard" name="hlv_invoice_guard">
                    <block title="AMIS invoice check API">
                        <setting string="API Token" help="Token used by the browser extension when calling Odoo from AMIS CRM.">
                            <field name="hlv_invoice_guard_api_token" password="True"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
