<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kế thừa Form View Phiếu nhập kho (stock.picking) -->
    <record id="view_picking_form_inherit_line_custom" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.line.custom</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- Thêm cột MISA org_ref_detail_id, Năm sản xuất, Xuất xứ trong danh sách move_ids_without_package -->
            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='product_id']" position="after">
                <field name="misa_purchase_order_org_ref_detail_id" string="MISA org_ref_detail_id" optional="show" readonly="1"/>
                <field name="production_year" string="Năm sản xuất" optional="show"/>
                <field name="country_of_origin" string="Xuất xứ" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Kế thừa Detailed Operations Tree View của Chi tiết dịch chuyển (stock.move.line) -->
    <record id="view_stock_move_line_detailed_operation_tree_inherit_line_custom" model="ir.ui.view">
        <field name="name">stock.move.line.detailed.operation.tree.inherit.line.custom</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="misa_purchase_order_org_ref_detail_id" string="MISA org_ref_detail_id" optional="show" readonly="1"/>
                <field name="production_year" string="Năm sản xuất" optional="show"/>
                <field name="country_of_origin" string="Xuất xứ" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
