<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hlv_chatgpt_message_kanban" model="ir.ui.view">
        <field name="name">hlv.chatgpt.message.kanban</field>
        <field name="model">hlv.chatgpt.message</field>
        <field name="arch" type="xml">
            <kanban create="0" delete="0" group_create="0">
                <field name="role"/>
                <field name="content"/>
                <field name="create_date"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="w-100 ps-2 pe-2">
                            <div t-attf-class="d-flex w-100 #{record.role.raw_value == 'user' ? 'flex-row-reverse' : 'flex-row'} mb-2">
                                
                                <div t-attf-class="flex-shrink-0 #{record.role.raw_value == 'user' ? 'ms-2' : 'me-2'} align-self-end">
                                    <div class="d-flex align-items-center justify-content-center rounded-circle shadow-sm" 
                                         t-attf-style="width: 32px; height: 32px; background-color: #{record.role.raw_value == 'user' ? '#0084ff' : '#e4e6eb'}; color: #{record.role.raw_value == 'user' ? '#fff' : '#050505'};">
                                        <i t-attf-class="fa #{record.role.raw_value == 'user' ? 'fa-user' : 'fa-robot'} small"></i>
                                    </div>
                                </div>

                                <div t-attf-class="p-3 shadow-sm position-relative text-break" 
                                     t-attf-style="
                                        max-width: 70%; 
                                        border-radius: 18px; 
                                        font-size: 14px;
                                        line-height: 1.5;
                                        background-color: #{record.role.raw_value == 'user' ? '#0084ff' : '#f0f2f5'};
                                        color: #{record.role.raw_value == 'user' ? '#ffffff' : '#050505'};
                                        border-bottom-#{record.role.raw_value == 'user' ? 'right' : 'left'}-radius: 4px;
                                     ">
                                    <div style="white-space: pre-wrap;"><field name="content"/></div>
                                    
                                    <div class="text-end mt-1" 
                                         t-attf-style="font-size: 10px; opacity: 0.6; color: inherit;">
                                        <field name="create_date" widget="relative_time"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_hlv_chatgpt_session_form" model="ir.ui.view">
        <field name="name">hlv.chatgpt.session.form</field>
        <field name="model">hlv.chatgpt.session</field>
        <field name="arch" type="xml">
            <form string="Hội thoại AI" class="o_chat_form" js_class="hlv_chat_form">
                <header>
                    <field name="state" widget="statusbar" invisible="1"/> 
                </header>
                <sheet class="p-0"> <div class="p-3 border-bottom d-flex align-items-center bg-white sticky-top" style="z-index: 100;">
                        <div class="flex-grow-1">
                            <field name="name" class="h4 mb-0 text-primary fw-bold" placeholder="Chủ đề hội thoại..."/>
                            <div class="small text-muted">
                                <i class="fa fa-clock-o me-1"></i>Hoạt động: <field name="last_activity" widget="relative_time"/>
                            </div>
                        </div>
                        <div>
                             <field name="user_id" widget="many2one_avatar_user"/>
                        </div>
                    </div>
                    
                    <div class="o_chat_history p-3" 
                         style="background-color: #ffffff; height: 65vh; overflow-y: auto; overflow-x: hidden; scroll-behavior: smooth;">
                        
                        <field name="message_ids" mode="kanban" nolabel="1">
                            <kanban create="0" delete="0">
                                <field name="role"/>
                                <field name="content"/>
                            </kanban>
                        </field>
                        
                    </div>

                    <div class="p-3 bg-white border-top sticky-bottom">
                        <div class="d-flex gap-2 align-items-end bg-light rounded-3 p-2 border">
                            <field name="input_text" 
                                   placeholder="Nhập tin nhắn... (Enter để Gửi)" 
                                   class="border-0 bg-transparent flex-grow-1"
                                   style="resize: none; outline: none; font-size: 15px; max-height: 100px; overflow-y: auto;"
                                   nolabel="1"/>
                                   
                            <button name="action_send_message" 
                                    string="" 
                                    type="object" 
                                    class="btn btn-link text-primary p-2 rounded-circle hover-bg-gray" 
                                    icon="fa-paper-plane fa-lg"/>
                        </div>
                        <div class="text-muted text-end mt-1" style="font-size: 11px;">
                            <i>Enter để gửi, Shift+Enter để xuống dòng</i>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hlv_chatgpt_session_list" model="ir.ui.view">
        <field name="name">hlv.chatgpt.session.list</field>
        <field name="model">hlv.chatgpt.session</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="Chủ đề"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="last_activity" widget="remaining_days"/>
                <field name="state" widget="badge" decoration-success="state == 'active'"/>
            </list>
        </field>
    </record>

    <record id="action_hlv_chatgpt_session" model="ir.actions.act_window">
        <field name="name">Chat AI</field>
        <field name="res_model">hlv.chatgpt.session</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hlv_chatgpt_session" parent="menu_hlv_chatgpt_root" action="action_hlv_chatgpt_session" sequence="10"/>
</odoo>