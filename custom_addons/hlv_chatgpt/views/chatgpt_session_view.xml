<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hlv_chatgpt_message_kanban" model="ir.ui.view">
        <field name="name">hlv.chatgpt.message.kanban</field>
        <field name="model">hlv.chatgpt.message</field>
        <field name="arch" type="xml">
            <kanban create="0" delete="0" group_create="0">
                <field name="role"/>
                <field name="content"/>
                <field name="create_date"/>
                <templates>
                    <t t-name="card">
                        <div class="w-100 ps-2 pe-2">
                            <div t-attf-class="d-flex w-100 #{record.role.raw_value == 'user' ? 'flex-row-reverse' : 'flex-row'} mb-2">
                                
                                <div t-attf-class="flex-shrink-0 #{record.role.raw_value == 'user' ? 'ms-2' : 'me-2'} align-self-end">
                                    <div t-if="record.role.raw_value == 'assistant'" 
                                         class="d-flex align-items-center justify-content-center rounded-circle shadow-sm" 
                                         style="width: 28px; height: 28px; background-color: #10a37f; color: white;">
                                        <i class="fa fa-bolt fa-sm"></i>
                                    </div>
                                    <div t-if="record.role.raw_value == 'user'" 
                                         class="d-flex align-items-center justify-content-center rounded-circle shadow-sm" 
                                         style="width: 28px; height: 28px; background-color: #5d5d5d; color: white;">
                                        <i class="fa fa-user fa-sm"></i>
                                    </div>
                                </div>

                                <div t-attf-class="px-3 py-2 shadow-sm position-relative text-break" 
                                     t-attf-style="
                                        max-width: 85%; 
                                        border-radius: 12px; 
                                        font-size: 13.5px; 
                                        line-height: 1.4;
                                        box-shadow: 0 1px 2px rgba(0,0,0,0.05) !important;
                                        background-color: #{record.role.raw_value == 'user' ? '#ffffff' : '#f7f7f8'};
                                        border: #{record.role.raw_value == 'user' ? '1px solid #e5e5e5' : 'none'};
                                        color: #343541;
                                     ">
                                    <div style="white-space: pre-wrap;"><field name="content"/></div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_hlv_chatgpt_session_form" model="ir.ui.view">
        <field name="name">hlv.chatgpt.session.form</field>
        <field name="model">hlv.chatgpt.session</field>
        <field name="arch" type="xml">
            <form string="Hội thoại AI" class="o_chat_form" js_class="hlv_chat_form">
                <header>
                    <field name="state" widget="statusbar" invisible="1"/> 
                </header>
                <sheet class="p-0">
                    <div class="px-3 py-2 border-bottom d-flex align-items-center bg-white sticky-top shadow-sm" style="z-index: 100; height: 50px;">
                        <div class="flex-grow-1 d-flex align-items-center">
                            <i class="fa fa-comments-o text-primary me-2"></i>
                            <field name="name" class="fw-bold text-dark mb-0" placeholder="Chủ đề..." style="border:none; font-size: 14px; width: 100%;"/>
                        </div>
                        <div class="small text-muted ms-2">
                             <field name="last_activity" widget="relative_time"/>
                        </div>
                    </div>
                    
                    <div class="o_chat_history px-3 py-2" 
                         style="background-color: #ffffff; height: 82vh; overflow-y: auto; overflow-x: hidden; scroll-behavior: smooth;">
                        <field name="message_ids" mode="kanban" nolabel="1"/>
                    </div>

                    <div class="p-2 bg-white border-top sticky-bottom shadow-lg">
                        <div class="d-flex gap-2 align-items-end position-relative">
                            <div class="flex-grow-1 bg-light rounded-3 border px-2 py-1 focus-shadow transition-all">
                                <field name="input_text" 
                                       placeholder="Nhập tin nhắn..." 
                                       class="border-0 bg-transparent w-100"
                                       style="resize: none; outline: none; font-size: 14px; min-height: 40px; max-height: 120px; overflow-y: auto;"
                                       nolabel="1"/>
                            </div>
                                   
                            <button name="action_send_message" 
                                    string="" 
                                    type="object" 
                                    class="btn btn-primary rounded-3 btn-send-chat shadow-sm d-flex align-items-center justify-content-center" 
                                    style="background-color: #10a37f; border-color: #10a37f; width: 42px; height: 42px;"
                                    icon="fa-paper-plane"/>
                        </div>
                        <div class="text-end mt-1 me-1" style="font-size: 10px; color: #aaa;">
                            <span>Enter để gửi</span>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hlv_chatgpt_session_list" model="ir.ui.view">
        <field name="name">hlv.chatgpt.session.list</field>
        <field name="model">hlv.chatgpt.session</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="Chủ đề"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="last_activity" widget="remaining_days"/>
                <field name="state" widget="badge" decoration-success="state == 'active'"/>
            </list>
        </field>
    </record>

    <record id="action_hlv_chatgpt_session" model="ir.actions.act_window">
        <field name="name">Chat AI</field>
        <field name="res_model">hlv.chatgpt.session</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hlv_chatgpt_session" parent="menu_hlv_chatgpt_root" action="action_hlv_chatgpt_session" sequence="10"/>
</odoo>