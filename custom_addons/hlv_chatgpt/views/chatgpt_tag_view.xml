<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hlv_chatgpt_tag_list" model="ir.ui.view">
        <field name="name">hlv.chatgpt.tag.list</field>
        <field name="model">hlv.chatgpt.tag</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="color" widget="color"/>
            </list>
        </field>
    </record>

    <record id="view_hlv_chatgpt_tag_form" model="ir.ui.view">
        <field name="name">hlv.chatgpt.tag.form</field>
        <field name="model">hlv.chatgpt.tag</field>
        <field name="arch" type="xml">
            <form string="Chat Tag">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hlv_chatgpt_tag" model="ir.actions.act_window">
        <field name="name">Chat Tags</field>
        <field name="res_model">hlv.chatgpt.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hlv_chatgpt_tag" parent="menu_hlv_chatgpt_root" action="action_hlv_chatgpt_tag" sequence="20"/>
</odoo>
