<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hlv_chatgpt_config_form" model="ir.ui.view">
        <field name="name">hlv.chatgpt.config.form</field>
        <field name="model">hlv.chatgpt.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Xác thực">
                            <field name="active"/>
                            <field name="api_key" password="True"/>
                        </group>
                        <group string="Tham số Prompt">
                            <field name="prompt_id"/>
                            <field name="prompt_version"/>
                            <field name="vector_store_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hlv_chatgpt_config" model="ir.actions.act_window">
        <field name="name">Cấu hình OpenAI</field>
        <field name="res_model">hlv.chatgpt.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hlv_chatgpt_root" name="HLV ChatGPT" sequence="10"/>
    <menuitem id="menu_hlv_chatgpt_config" parent="menu_hlv_chatgpt_root" action="action_hlv_chatgpt_config" sequence="20"/>
</odoo>