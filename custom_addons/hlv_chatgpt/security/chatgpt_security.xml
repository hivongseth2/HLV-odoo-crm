<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_hlv_chatgpt" model="ir.module.category">
        <field name="name">HLV Chat AI</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_hlv_chatgpt_manager" model="res.groups">
        <field name="name">Quản lý Chat AI</field>
        <field name="category_id" ref="module_category_hlv_chatgpt"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Xem và quản lý mọi hội thoại Chat AI, kể cả hội thoại Zalo của khách.</field>
    </record>

    <!-- Admin hệ thống mặc định là quản lý Chat AI. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_hlv_chatgpt_manager'))]"/>
    </record>

    <!--
        Hội thoại Zalo do webhook tạo bằng SUPERUSER nên user_id là OdooBot: chỉ nhóm
        quản lý mới thấy. Nhân viên thường chỉ thấy hội thoại của chính mình.
    -->
    <record id="rule_hlv_chatgpt_session_own" model="ir.rule">
        <field name="name">Chat AI: chỉ hội thoại của mình</field>
        <field name="model_id" ref="model_hlv_chatgpt_session"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_hlv_chatgpt_session_manager" model="ir.rule">
        <field name="name">Chat AI: quản lý xem tất cả</field>
        <field name="model_id" ref="model_hlv_chatgpt_session"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_hlv_chatgpt_manager'))]"/>
    </record>

    <record id="rule_hlv_chatgpt_message_own" model="ir.rule">
        <field name="name">Tin nhắn Chat AI: theo hội thoại của mình</field>
        <field name="model_id" ref="model_hlv_chatgpt_message"/>
        <field name="domain_force">[('session_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_hlv_chatgpt_message_manager" model="ir.rule">
        <field name="name">Tin nhắn Chat AI: quản lý xem tất cả</field>
        <field name="model_id" ref="model_hlv_chatgpt_message"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_hlv_chatgpt_manager'))]"/>
    </record>
</odoo>
