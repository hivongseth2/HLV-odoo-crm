<odoo>
  <data>
    <record id="view_order_form_misa_hard_sync_inherit" model="ir.ui.view">
      <field name="name">sale.order.form.misa.hard.sync.button</field>
      <field name="model">sale.order</field>
      <field name="inherit_id" ref="sale.view_order_form"/>
      <field name="arch" type="xml">
        <xpath expr="//header" position="inside">
          <button name="action_resync_from_misa_hard"
                  type="object"
                  string="Đồng bộ MISA"
                  class="btn-danger"
                  help="Chỉ chạy khi không có phiếu giao done và không có hoá đơn posted."
                  invisible="misa_id == False"/>
        </xpath>

        <!-- Sửa domain của partner_shipping_id để cho phép chọn contact -->
        <xpath expr="//field[@name='partner_shipping_id']" position="attributes">
          <attribute name="domain">[
            ('type', 'in', ['contact', 'delivery']),
            ('is_company', '=', False),
            '|',
            ('parent_id', '=', partner_id),
            ('id', '=', partner_id)
          ]</attribute>
        </xpath>

        <!-- Sửa domain của partner_invoice_id để cho phép chọn contact -->
        <xpath expr="//field[@name='partner_invoice_id']" position="attributes">
          <attribute name="domain">[
            ('type', 'in', ['contact', 'delivery']),
            ('is_company', '=', False),
            '|',
            ('parent_id', '=', partner_id),
            ('id', '=', partner_id)
          ]</attribute>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
