<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_misa_crm_contact_sync_run_list" model="ir.ui.view">
        <field name="name">misa.crm.contact.sync.run.list</field>
        <field name="model">misa.crm.contact.sync.run</field>
        <field name="arch" type="xml">
            <list string="MISA CRM Contact Sync Runs" decoration-danger="state == 'failed'" decoration-success="state == 'done'">
                <field name="start_at"/>
                <field name="service_date"/>
                <field name="state"/>
                <field name="total_count"/>
                <field name="success_count"/>
                <field name="created_count"/>
                <field name="updated_count"/>
                <field name="unchanged_count"/>
                <field name="failed_count"/>
                <field name="page_count"/>
                <field name="duration_seconds"/>
            </list>
        </field>
    </record>

    <record id="view_misa_crm_contact_sync_run_form" model="ir.ui.view">
        <field name="name">misa.crm.contact.sync.run.form</field>
        <field name="model">misa.crm.contact.sync.run</field>
        <field name="arch" type="xml">
            <form string="MISA CRM Contact Sync Run">
                <header>
                    <button name="action_run_now" type="object" string="Chạy ngay" class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="running,done,failed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="service_date"/>
                            <field name="start_at"/>
                            <field name="end_at"/>
                            <field name="duration_seconds"/>
                        </group>
                        <group>
                            <field name="total_count"/>
                            <field name="success_count"/>
                            <field name="created_count"/>
                            <field name="updated_count"/>
                            <field name="unchanged_count"/>
                            <field name="failed_count"/>
                            <field name="page_count"/>
                        </group>
                    </group>
                    <group>
                        <field name="message"/>
                    </group>
                    <notebook>
                        <page string="Chi tiết">
                            <field name="line_ids" readonly="1">
                                <list decoration-danger="state == 'failed'" decoration-success="action == 'created'" decoration-info="action == 'updated'">
                                    <field name="state"/>
                                    <field name="action"/>
                                    <field name="partner_id"/>
                                    <field name="misa_id"/>
                                    <field name="account_number"/>
                                    <field name="tax_code"/>
                                    <field name="account_name"/>
                                    <field name="change_summary"/>
                                    <field name="error_message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_misa_crm_contact_sync_line_search" model="ir.ui.view">
        <field name="name">misa.crm.contact.sync.line.search</field>
        <field name="model">misa.crm.contact.sync.line</field>
        <field name="arch" type="xml">
            <search string="MISA CRM Contact Sync Lines">
                <field name="partner_id"/>
                <field name="account_number"/>
                <field name="tax_code"/>
                <field name="account_name"/>
                <filter name="failed" string="Thất bại" domain="[('state','=','failed')]"/>
                <filter name="updated" string="Có cập nhật" domain="[('action','in',['created','updated'])]"/>
                <group expand="0" string="Nhóm">
                    <filter name="group_run" string="Lần chạy" context="{'group_by':'run_id'}"/>
                    <filter name="group_action" string="Kết quả" context="{'group_by':'action'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_misa_crm_contact_sync_runs" model="ir.actions.act_window">
        <field name="name">Đồng bộ CRM Contacts</field>
        <field name="res_model">misa.crm.contact.sync.run</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_misa_crm_contact_sync_runs"
              name="Log đồng bộ CRM"
              parent="contacts.res_partner_menu_config"
              action="action_misa_crm_contact_sync_runs"
              sequence="60"/>
</odoo>
