<odoo>
    <!-- Định nghĩa model misa.cron.fetch -->
    <record id="model_misa_cron_fetch" model="ir.model">
        <field name="name">misa.cron.fetch</field>
        <field name="model">misa.cron.fetch</field>
        <field name="state">manual</field>
    </record>

    <!-- Cron job cho PO -->
    <record id="ir_cron_misa_fetch_po" model="ir.cron">
        <field name="name">Lấy PO từ MISA định kỳ</field>
        <field name="model_id" ref="model_misa_cron_fetch"/>
        <field name="state">code</field>
        <field name="code">self.env['misa.cron.fetch']._fetch_po_periodically()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="doall">0</field>
        <field name="active">1</field>
    </record>

    <!-- Cron job cho Internal Transfer -->
    <record id="ir_cron_misa_fetch_transfer" model="ir.cron">
        <field name="name">Lấy Internal Transfer từ MISA định kỳ</field>
        <field name="model_id" ref="model_misa_cron_fetch"/>
        <field name="state">code</field>
        <field name="code">self.env['misa.cron.fetch']._fetch_transfer_periodically()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="doall">0</field>
        <field name="active">1</field>
    </record>
</odoo>