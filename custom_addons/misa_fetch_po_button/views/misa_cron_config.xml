<odoo>
    <record id="ir_cron_misa_fetch_po" model="ir.cron">
        <field name="name">Lấy PO từ MISA định kỳ</field>
        <field name="model">misa.cron.fetch</field> <!-- Thay ref bằng model -->
        <field name="state">code</field>
        <field name="code">model._fetch_po_periodically()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="doall">0</field>
        <field name="active">1</field>
    </record>

    <record id="ir_cron_misa_fetch_transfer" model="ir.cron">
        <field name="name">Lấy Internal Transfer từ MISA định kỳ</field>
        <field name="model">misa.cron.fetch</field> <!-- Thay ref bằng model -->
        <field name="state">code</field>
        <field name="code">model._fetch_transfer_periodically()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="doall">0</field>
        <field name="active">1</field>
    </record>
</odoo>