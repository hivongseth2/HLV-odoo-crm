<odoo>
    <!-- Action mở form dạng dialog -->
    <record id="action_misa_po_fetch_main" model="ir.actions.act_window">
        <field name="name">Lấy PO từ MISA</field>
        <field name="res_model">misa.po.fetch</field>
        <field name="view_mode">form</field>
        <field name="target">new</field> <!-- ✅ Đây là thay đổi chính: mở dialog -->
    </record>

    <!-- Giao diện form chứa nút gọi -->
    <record id="view_misa_po_fetch_form" model="ir.ui.view">
        <field name="name">misa.po.fetch.form</field>
        <field name="model">misa.po.fetch</field>
        <field name="arch" type="xml">
            <form string="Lấy PO từ MISA">
                <group>
                    <field name="date_from" required="1"/>
                    <field name="date_to" required="1"/>
                </group>
                <footer>
                    <button name="action_fetch_po"
                            string="Lấy PO từ MISA"
                            type="object"
                            class="btn-primary"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Menu trong Mua hàng (Purchase) -->
    <menuitem id="menu_import_misa_po"
              name="Lấy PO theo ngày"
              parent="purchase.menu_purchase_root"
              action="action_misa_po_fetch_main"
              sequence="98"/>
</odoo>
