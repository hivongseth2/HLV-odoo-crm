<odoo>
    <record id="view_misa_po_fetch_form" model="ir.ui.view">
        <field name="name">misa.po.fetch.form</field>
        <field name="model">misa.po.fetch</field>
        <field name="arch" type="xml">
            <form string="MISA PO Fetch">
                <sheet>
                    <group>
                        <field name="name"/>
                        <button name="action_fetch_po" string="Fetch PO từ MISA" type="object" class="btn-primary"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_misa_po_fetch" model="ir.actions.act_window">
        <field name="name">Lấy PO từ MISA</field>
        <field name="res_model">misa.po.fetch</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_misa_po_fetch_root" name="MISA"/>
    <menuitem id="menu_misa_po_fetch" name="Lấy PO" parent="menu_misa_po_fetch_root" action="action_misa_po_fetch"/>
</odoo>