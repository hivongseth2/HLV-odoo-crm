<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_tag_view_form_inherit_misa" model="ir.ui.view">
        <field name="name">crm.tag.form.inherit.misa</field>
        <field name="model">crm.tag</field>
        <field name="inherit_id" ref="sales_team.sales_team_crm_tag_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="after">
                <group string="MISA Sync Configuration">
                    <field name="misa_keywords" placeholder="Ví dụ: long thành, tam phước (phân cách dấu phẩy)"/>
                    <field name="misa_ignore_htgh_patterns" placeholder="Mỗi dòng 1 regex. Ví dụ:&#10;tự vận chuyển&#10;pick.up&#10;^nội thành"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="crm_tag_view_tree_inherit_misa" model="ir.ui.view">
        <field name="name">crm.tag.tree.inherit.misa</field>
        <field name="model">crm.tag</field>
        <field name="inherit_id" ref="sales_team.sales_team_crm_tag_view_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="misa_keywords" optional="show"/>
                <field name="misa_ignore_htgh_patterns" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
