<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Khối "MISA CRM" trong Cài đặt > Tồn kho. Kế thừa view cài đặt của stock (xmlid
         gốc ổn định qua các bản Odoo, module đã phụ thuộc stock). -->
    <record id="res_config_settings_view_form_misa_crm" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.misa.crm</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='stock']" position="inside">
                <block title="MISA CRM" name="misa_crm_settings">
                    <setting id="misa_crm_auto_sync_product"
                             help="Sửa tên / mã sản phẩm trên Odoo thì tự cập nhật hàng tương ứng trên MISA CRM. Kết quả ghi ở chatter sản phẩm.">
                        <field name="misa_crm_auto_sync_product"/>
                    </setting>
                    <setting id="misa_amis_sync_product_name"
                             help="MISA đổi tên hàng thì sản phẩm Odoo đổi tên theo (qua AMIS callback). Chỉ khi MISA ĐỔI tên; chỉ tên, không đổi mã.">
                        <field name="misa_amis_sync_product_name"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
