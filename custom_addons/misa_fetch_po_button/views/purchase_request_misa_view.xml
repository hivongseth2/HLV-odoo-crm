<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit form view để thêm misa_requester_text -->
    <record id="view_purchase_request_form_misa" model="ir.ui.view">
        <field name="name">purchase.request.form.misa</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form"/>
        <field name="arch" type="xml">
            <!-- Thêm misa_requester_text sau requested_by -->
            <field name="requested_by" position="after">
                <field name="misa_requester_text" readonly="1"/>
            </field>
        </field>
    </record>

    <!-- Inherit tree view để thêm misa_requester_text -->
    <record id="view_purchase_request_tree_misa" model="ir.ui.view">
        <field name="name">purchase.request.tree.misa</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_tree"/>
        <field name="arch" type="xml">
            <field name="requested_by" position="after">
                <field name="misa_requester_text" optional="show"/>
            </field>
        </field>
    </record>
    <!-- Override action để bỏ filter mặc định -->
    <record id="purchase_request.purchase_request_form_action" model="ir.actions.act_window">
        <field name="context">{}</field>
    </record>
</odoo>


