<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Server Action: Phê duyệt hàng loạt -->
    <record id="action_purchase_request_approve_bulk" model="ir.actions.server">
        <field name="name">Phê duyệt hàng loạt</field>
        <field name="model_id" ref="purchase_request.model_purchase_request"/>
        <field name="binding_model_id" ref="purchase_request.model_purchase_request"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
for rec in records:
    if rec.state == 'to_approve':
        rec.button_approved()
        </field>
    </record>

    <!-- Server Action: Từ chối hàng loạt -->
    <record id="action_purchase_request_reject_bulk" model="ir.actions.server">
        <field name="name">Từ chối hàng loạt</field>
        <field name="model_id" ref="purchase_request.model_purchase_request"/>
        <field name="binding_model_id" ref="purchase_request.model_purchase_request"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
for rec in records:
    if rec.state in ['to_approve', 'approved', 'in_progress']:
        rec.button_rejected()
        </field>
    </record>

    <!-- Server Action: Gửi phê duyệt hàng loạt -->
    <record id="action_purchase_request_to_approve_bulk" model="ir.actions.server">
        <field name="name">Gửi phê duyệt hàng loạt</field>
        <field name="model_id" ref="purchase_request.model_purchase_request"/>
        <field name="binding_model_id" ref="purchase_request.model_purchase_request"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
for rec in records:
    if rec.state == 'draft':
        rec.button_to_approve()
        </field>
    </record>

    <!-- Server Action: Thiết lập về nháp hàng loạt -->
    <record id="action_purchase_request_draft_bulk" model="ir.actions.server">
        <field name="name">Thiết lập về nháp hàng loạt</field>
        <field name="model_id" ref="purchase_request.model_purchase_request"/>
        <field name="binding_model_id" ref="purchase_request.model_purchase_request"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
for rec in records:
    if rec.state in ['to_approve', 'rejected', 'approved']:
        rec.button_draft()
        </field>
    </record>
</odoo>
