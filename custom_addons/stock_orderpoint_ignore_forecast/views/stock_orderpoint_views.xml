<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- FORM: hiển thị số 'Cần đặt (Min)' và nút Order (Min) -->
  <record id="view_orderpoint_form_min_only" model="ir.ui.view">
    <field name="name">stock.warehouse.orderpoint.form.min.only</field>
    <field name="model">stock.warehouse.orderpoint</field>
    <field name="inherit_id" ref="stock.view_warehouse_orderpoint_form"/>
    <field name="arch" type="xml">
      <!-- Chèn sau qty_multiple cho chắc -->
      <xpath expr="//field[@name='qty_multiple']" position="after">
        <label for="qty_to_order_min_only"/>
        <div class="o_row">
          <field name="qty_to_order_min_only" readonly="1"/>
          <field name="product_uom_name"/>
          <button name="action_replenish_min_only" string="Order (Min)" type="object"
                  class="o_replenish_buttons"
                  icon="fa-truck"
                  attrs="{'invisible': ['|', ('qty_to_order_min_only','<=',0.0), ('trigger','!=','auto')]}"/>
        </div>
      </xpath>
    </field>
  </record>

  <!-- LIST: thêm cột 'Cần đặt (Min)' ngay sau cột qty_to_order, và nút Order (Min) sau nút Order -->
  <record id="view_orderpoint_list_min_only" model="ir.ui.view">
    <field name="name">stock.warehouse.orderpoint.list.min.only</field>
    <field name="model">stock.warehouse.orderpoint</field>
    <field name="inherit_id" ref="stock.view_warehouse_orderpoint_tree_editable"/>
    <field name="arch" type="xml">

      <!-- Thêm cột mới -->
      <xpath expr="//field[@name='qty_to_order']" position="after">
        <field name="qty_to_order_min_only" string="Cần đặt (Min)" optional="show"/>
      </xpath>

      <!-- Thêm nút Order (Min) cạnh nút Order thường -->
      <xpath expr="//button[@name='action_replenish']" position="after">
        <button name="action_replenish_min_only" string="Order (Min)" type="object"
                class="o_replenish_buttons"
                icon="fa-truck"
                attrs="{'invisible': ['|', ('qty_to_order_min_only','<=',0.0), ('trigger','!=','auto')]}"/>
      </xpath>

    </field>
  </record>
</odoo>
