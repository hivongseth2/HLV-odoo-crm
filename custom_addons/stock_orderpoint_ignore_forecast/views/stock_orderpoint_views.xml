<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_orderpoint_form_ignore_forecast" model="ir.ui.view">
    <field name="name">stock.warehouse.orderpoint.form.ignore.forecast</field>
    <field name="model">stock.warehouse.orderpoint</field>
    <field name="inherit_id" ref="stock.view_orderpoint_form"/>
    <field name="arch" type="xml">
      <xpath expr="//group[hasclass('oe_title')]/following-sibling::group[1]" position="inside">
        <group string="Behavior">
          <field name="ignore_forecast"/>
        </group>
      </xpath>
    </field>
  </record>

  <record id="view_orderpoint_tree_ignore_forecast" model="ir.ui.view">
    <field name="name">stock.warehouse.orderpoint.tree.ignore.forecast</field>
    <field name="model">stock.warehouse.orderpoint</field>
    <field name="inherit_id" ref="stock.view_orderpoint_tree"/>
    <field name="arch" type="xml">
      <xpath expr="//tree/field[@name='product_min_qty']" position="after">
        <field name="ignore_forecast" optional="show"/>
      </xpath>
    </field>
  </record>
</odoo>
