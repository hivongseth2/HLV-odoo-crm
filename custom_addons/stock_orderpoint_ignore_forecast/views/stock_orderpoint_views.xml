<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_orderpoint_form_ignore_forecast" model="ir.ui.view">
    <field name="name">stock.warehouse.orderpoint.form.ignore.forecast</field>
    <field name="model">stock.warehouse.orderpoint</field>
    <!-- XML ID form của bạn -->
    <field name="inherit_id" ref="stock.view_warehouse_orderpoint_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='product_max_qty']" position="after">
        <field name="ignore_forecast"/>
      </xpath>
    </field>
  </record>
</odoo>
