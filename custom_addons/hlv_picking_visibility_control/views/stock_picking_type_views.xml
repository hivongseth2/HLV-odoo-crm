<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form view cho Loại phiếu -->
        <record id="view_picking_type_form_inherit_visibility" model="ir.ui.view">
            <field name="name">stock.picking.type.form.inherit.visibility</field>
            <field name="model">stock.picking.type</field>
            <field name="inherit_id" ref="stock.view_picking_type_form"/>
            <field name="arch" type="xml">
                <field name="return_picking_type_id" position="after">
                    <group string="Kiểm soát Hiển thị" name="visibility_control">
                        <field name="is_hidden_from_menu"/>
                        <field name="is_delivery_note_type"/>
                    </group>
                </field>
            </field>
        </record>

        <!-- Tree view cho Loại phiếu -->
        <record id="view_picking_type_tree_inherit_visibility" model="ir.ui.view">
            <field name="name">stock.picking.type.tree.inherit.visibility</field>
            <field name="model">stock.picking.type</field>
            <field name="inherit_id" ref="stock.view_picking_type_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//tree | //list" position="attributes">
                    <attribute name="decoration-warning">is_hidden_from_menu == True</attribute>
                </xpath>
                <xpath expr="//field[@name='name']" position="after">
                    <field name="is_hidden_from_menu" optional="hide"/>
                    <field name="is_delivery_note_type" optional="hide"/>
                </xpath>
            </field>
        </record>

        <!-- Search view cho Loại phiếu -->
        <record id="view_picking_type_search_inherit_visibility" model="ir.ui.view">
            <field name="name">stock.picking.type.search.inherit.visibility</field>
            <field name="model">stock.picking.type</field>
            <field name="inherit_id" ref="stock.view_picking_type_search"/>
            <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                    <filter name="is_hidden" string="Phiếu bị ẩn" 
                            domain="[('is_hidden_from_menu', '=', True)]"/>
                    <filter name="is_delivery_note" string="Loại phiếu bàn giao" 
                            domain="[('is_delivery_note_type', '=', True)]"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
