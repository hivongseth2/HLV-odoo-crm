<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form view cho Loại phiếu -->
        <record id="view_picking_type_form_inherit_visibility" model="ir.ui.view">
            <field name="name">stock.picking.type.form.inherit.visibility</field>
            <field name="model">stock.picking.type</field>
            <field name="inherit_id" ref="stock.view_picking_type_form"/>
            <field name="arch" type="xml">
                <field name="return_picking_type_id" position="after">
                    <group string="Kiểm soát Hiển thị" name="visibility_control">
                        <field name="is_hidden_from_menu"/>
                        <field name="is_delivery_note_type"/>
                    </group>
                </field>
            </field>
        </record>

    </data>
</odoo>
