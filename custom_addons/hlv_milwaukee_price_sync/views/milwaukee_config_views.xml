<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_milwaukee_config_form" model="ir.ui.view">
        <field name="name">milwaukee.config.form</field>
        <field name="model">milwaukee.config</field>
        <field name="arch" type="xml">
            <form string="Milwaukee Pricing Configuration">
                <header>
                    <button name="action_fetch_products" string="1. Lấy danh sách sản phẩm" type="object" class="btn-primary" icon="fa-download"/>
                    <button name="action_push_prices" string="2. Đẩy giá lên Website" type="object" class="btn-secondary" icon="fa-upload"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Tên cấu hình..."/>
                        </h1>
                    </div>
                    <group>
                        <group name="api_settings" string="Kết nối API">
                            <field name="api_url" placeholder="http://localhost:3000"/>
                            <field name="api_key" password="True"/>
                            <field name="active"/>
                        </group>
                        <group name="info" string="Hướng dẫn">
                            <p class="text-muted">
                                <strong>Bước 1:</strong> Kết nối API và click "Lấy danh sách sản phẩm" để Odoo nhận diện ID của sản phẩm trên website thông qua SKU.
                                <br/>
                                <strong>Bước 2:</strong> Sau khi map ID thành công, bạn có thể thiết lập "Giá giảm Milwaukee" trên từng sản phẩm.
                                <br/>
                                <strong>Bước 3:</strong> Click "Đẩy giá lên Website" để cập nhật giá hàng loạt.
                            </p>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_milwaukee_config_list" model="ir.ui.view">
        <field name="name">milwaukee.config.list</field>
        <field name="model">milwaukee.config</field>
        <field name="arch" type="xml">
            <list string="Milwaukee Pricing Configuration">
                <field name="name"/>
                <field name="api_url"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_milwaukee_config" model="ir.actions.act_window">
        <field name="name">Cấu hình Milwaukee Pricing</field>
        <field name="res_model">milwaukee.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Item in Inventory/Configuration -->
    <menuitem id="menu_milwaukee_config"
              name="Milwaukee Pricing Sync"
              parent="stock.menu_stock_config_settings"
              action="action_milwaukee_config"
              sequence="100"/>
</odoo>
