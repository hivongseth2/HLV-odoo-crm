<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_milwaukee" model="ir.ui.view">
        <field name="name">product.template.form.milwaukee</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inventory']" position="after">
                <page string="Milwaukee Pricing" name="milwaukee_pricing">
                    <group>
                        <group name="milwaukee_sync_fields" string="Đồng bộ Website: Các trường được liên kết">
                            <field name="milwaukee_id" readonly="1"/>
                            <field name="x_studio_ga_hng_nim_yt" string="Giá Niêm Yết" readonly="1"/>
                            <field name="x_studio_gi_web" string="Giá Web" readonly="1"/>
                        </group>
                        <group name="milwaukee_info" string="Thông tin mapping">
                            <p class="text-muted">
                                <strong>Milwaukee ID:</strong> Lấy tự động thông qua SKU khi nhấn Đồng Bộ Sản Phẩm Về.
                                <br/>
                                <strong>Giá Niêm Yết (x_studio_ga_hng_nim_yt):</strong> Trị giá trên Web là <i>regularPrice</i>.
                                <br/>
                                <strong>Giá Web (x_studio_gi_web):</strong> Trị giá trên Web là <i>salePrice</i>.
                            </p>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
