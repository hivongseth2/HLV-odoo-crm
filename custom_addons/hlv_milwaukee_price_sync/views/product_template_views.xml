<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_milwaukee" model="ir.ui.view">
        <field name="name">product.template.form.milwaukee</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inventory']" position="after">
                <page string="Milwaukee Pricing" name="milwaukee_pricing">
                    <group>
                        <group name="milwaukee_sync_fields" string="Đồng bộ Website">
                            <field name="milwaukee_id" readonly="1"/>
                            <field name="milwaukee_sale_price" widget="monetary"/>
                        </group>
                        <group name="milwaukee_info" string="Thông tin mapping">
                            <p class="text-muted">
                                <strong>Milwaukee ID:</strong> ID được lấy tự động từ website thông qua SKU.
                                <br/>
                                <strong>Giá Web (x_studio_ga_web):</strong> Sẽ được gửi làm <i>regularPrice</i>.
                                <br/>
                                <strong>Giá giảm Milwaukee:</strong> Sẽ được gửi làm <i>salePrice</i>.
                            </p>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
