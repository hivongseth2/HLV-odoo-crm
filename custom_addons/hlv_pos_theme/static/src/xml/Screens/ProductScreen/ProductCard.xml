<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="hlv_pos_theme.ProductCard" t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-content')]" position="inside">
            <div class="product-price hlv-price-forced">
                <t t-esc="props.formattedPrice" />
            </div>
        </xpath>
    </t>
</templates>
