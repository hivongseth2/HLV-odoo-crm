<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Trang /huong-dan — HTML tự dựng như /sale_plan, /hoi-gia-ncc (không qua web.layout + asset
         bundle), CSS/JS nạp bằng link thường kèm ?v=version để trình duyệt tải lại sau nâng cấp.
         Máy tính: cây thư mục bên trái, khung xem bên phải. Điện thoại: chỉ cây, bấm là mở trang. -->
    <template id="guide_index" name="Hướng dẫn — cây thư mục">
        &lt;!DOCTYPE html&gt;
        <html lang="vi">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>Hướng dẫn</title>
                <link rel="icon" type="image/png" href="/hlv_sale_guide/static/description/icon.png"/>
                <link rel="stylesheet" t-attf-href="/hlv_sale_guide/static/src/guide_index.css?v=#{asset_version}"/>
            </head>
            <body>
                <nav class="bar">
                    <b>Hướng dẫn</b>
                    <t t-if="is_manager">
                        <a class="bar-btn" t-attf-href="#{backend_guides}/new">+ Thêm hướng dẫn</a>
                        <a t-att-href="backend_guides">Quản lý</a>
                        <a t-att-href="backend_folders">Thư mục</a>
                    </t>
                    <a href="/sale_plan">Tình trạng đơn</a>
                    <a href="/odoo">Odoo</a>
                </nav>
                <div class="layout">
                    <aside class="tree">
                        <input type="search" id="guide-search" class="tree-search" placeholder="Tìm hướng dẫn…"
                               aria-label="Tìm hướng dẫn" t-if="tree['count']"/>
                        <div t-if="not tree['count']" class="empty">
                            Chưa có hướng dẫn nào.
                            <t t-if="is_manager">Bấm <b>+ Thêm hướng dẫn</b> ở trên để tải file .html, .zip hoặc .pdf lên.</t>
                        </div>
                        <t t-foreach="tree['folders']" t-as="child">
                            <t t-call="hlv_sale_guide.guide_tree_folder"><t t-set="node" t-value="child"/></t>
                        </t>
                        <t t-foreach="tree['guides']" t-as="guide">
                            <t t-call="hlv_sale_guide.guide_tree_leaf"/>
                        </t>
                    </aside>
                    <section class="viewer" t-if="tree['count']">
                        <div class="viewer-head">
                            <b id="guide-view-title"/>
                            <a id="guide-view-full" target="_blank" rel="noopener">Mở toàn trang ↗</a>
                        </div>
                        <iframe id="guide-view" name="guide-view" title="Nội dung hướng dẫn"/>
                    </section>
                </div>
                <script t-attf-src="/hlv_sale_guide/static/src/guide_index.js?v=#{asset_version}"/>
            </body>
        </html>
    </template>

    <!-- Một thư mục, gọi đệ quy cho thư mục con. Biến vào: node (xem build_tree). -->
    <template id="guide_tree_folder" name="Hướng dẫn — thư mục">
        <details class="folder" open="open">
            <summary><span class="folder-name" t-out="node['name']"/><small t-out="node['count']"/></summary>
            <div class="folder-body">
                <t t-foreach="node['folders']" t-as="child">
                    <t t-call="hlv_sale_guide.guide_tree_folder"><t t-set="node" t-value="child"/></t>
                </t>
                <t t-foreach="node['guides']" t-as="guide">
                    <t t-call="hlv_sale_guide.guide_tree_leaf"/>
                </t>
            </div>
        </details>
    </template>

    <!-- Một hướng dẫn. Biến vào: guide (dict từ GuidePage._guide_item). -->
    <template id="guide_tree_leaf" name="Hướng dẫn — mục">
        <a class="leaf" t-att-href="guide['url']" t-att-data-slug="guide['slug']" t-att-data-name="guide['name']"
           t-att-title="guide['summary'] or None">
            <span t-attf-class="kind kind-#{guide['kind']}" t-out="'PDF' if guide['kind'] == 'pdf' else 'Trang'"/>
            <span class="leaf-name" t-out="guide['name']"/>
        </a>
    </template>
</odoo>
