<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Trang /huong-dan và /huong-dan/<slug>/ — HTML tự dựng như /sale_plan, /hoi-gia-ncc (không qua
         web.layout + asset bundle), CSS/JS nạp bằng link thường kèm ?v=version để trình duyệt tải lại
         sau nâng cấp. -->
    <template id="guide_page_head" name="Hướng dẫn — phần head chung">
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <link rel="icon" type="image/png" href="/hlv_sale_guide/static/description/icon.png"/>
        <link rel="stylesheet" t-attf-href="/hlv_sale_guide/static/src/guide_index.css?v=#{asset_version}"/>
        <link rel="stylesheet" t-attf-href="/hlv_sale_guide/static/src/guide_ticket.css?v=#{asset_version}"/>
    </template>

    <!-- Nút nổi trích đoạn + script ngăn ticket. Biến vào: viewer_script — file khai HlvGuide.viewer
         cho trang đó (guide_index.js: cây thư mục; guide_viewer_single.js: một hướng dẫn).
         Thứ tự nạp quan trọng: file sau dùng window.HlvGuide.* do file trước khai. -->
    <template id="guide_ticket_scripts" name="Hướng dẫn — script ticket">
        <button type="button" id="quote-pick" class="quote-pick" hidden="hidden">Hỏi / yêu cầu sửa đoạn này</button>
        <script t-attf-src="/hlv_sale_guide/static/src/guide_text_utils.js?v=#{asset_version}"/>
        <script t-attf-src="/hlv_sale_guide/static/src/guide_ticket_core.js?v=#{asset_version}"/>
        <script t-attf-src="/hlv_sale_guide/static/src/#{viewer_script}?v=#{asset_version}"/>
        <script t-attf-src="/hlv_sale_guide/static/src/guide_quote.js?v=#{asset_version}"/>
        <script t-attf-src="/hlv_sale_guide/static/src/guide_ticket_composer.js?v=#{asset_version}"/>
        <script t-attf-src="/hlv_sale_guide/static/src/guide_ticket_form.js?v=#{asset_version}"/>
        <script t-attf-src="/hlv_sale_guide/static/src/guide_ticket.js?v=#{asset_version}"/>
    </template>

    <!-- /huong-dan. Máy tính: ngăn trái (tab cây thư mục / tab hỏi đáp), khung xem bên phải.
         Điện thoại: chỉ ngăn trái, bấm hướng dẫn là mở trang guide_full. -->
    <template id="guide_index" name="Hướng dẫn — cây thư mục">
        &lt;!DOCTYPE html&gt;
        <html lang="vi">
            <head>
                <t t-call="hlv_sale_guide.guide_page_head"/>
                <title>Hướng dẫn</title>
            </head>
            <body t-att-data-csrf="request.csrf_token()" t-att-data-limits="upload_limits">
                <nav class="bar">
                    <b>Hướng dẫn</b>
                    <t t-if="is_manager">
                        <a class="bar-btn" t-attf-href="#{backend_guides}/new">+ Thêm hướng dẫn</a>
                        <a t-att-href="backend_guides">Quản lý</a>
                        <a t-att-href="backend_folders">Thư mục</a>
                    </t>
                    <a href="/sale_plan">Tình trạng đơn</a>
                    <a href="/odoo">Odoo</a>
                </nav>
                <div class="layout">
                    <aside class="side">
                        <div class="side-tabs" role="tablist">
                            <button type="button" class="side-tab" role="tab" data-tab="tree" aria-selected="true">Hướng dẫn</button>
                            <button type="button" class="side-tab" role="tab" data-tab="tickets" aria-selected="false">
                                Hỏi đáp &amp; yêu cầu <span id="ticket-badge" class="side-badge" title="Ticket chưa xử lý" hidden="hidden"/>
                            </button>
                        </div>
                        <div class="tree" id="side-tree">
                            <input type="search" id="guide-search" class="tree-search" placeholder="Tìm hướng dẫn…"
                                   aria-label="Tìm hướng dẫn" t-if="tree['count']"/>
                            <div t-if="not tree['count']" class="empty">
                                Chưa có hướng dẫn nào.
                                <t t-if="is_manager">Bấm <b>+ Thêm hướng dẫn</b> ở trên để tải file .html, .zip hoặc .pdf lên.</t>
                            </div>
                            <t t-foreach="tree['folders']" t-as="child">
                                <t t-call="hlv_sale_guide.guide_tree_folder"><t t-set="node" t-value="child"/></t>
                            </t>
                            <t t-foreach="tree['guides']" t-as="guide">
                                <t t-call="hlv_sale_guide.guide_tree_leaf"/>
                            </t>
                        </div>
                        <div class="tickets" id="side-tickets" hidden="hidden"/>
                    </aside>
                    <section class="viewer" t-if="tree['count']">
                        <div class="viewer-head">
                            <b id="guide-view-title"/>
                            <button type="button" id="guide-tickets" class="head-chip" title="Ticket về hướng dẫn này" hidden="hidden"/>
                            <button type="button" id="guide-ask" class="head-btn"
                                    title="Hỏi hoặc yêu cầu sửa hướng dẫn này. Mẹo: bôi đen một đoạn để trích đoạn đó.">
                                Hỏi / yêu cầu sửa
                            </button>
                            <a id="guide-view-full" target="_blank" rel="noopener">Mở toàn trang ↗</a>
                        </div>
                        <iframe id="guide-view" name="guide-view" title="Nội dung hướng dẫn"/>
                    </section>
                </div>
                <t t-call="hlv_sale_guide.guide_ticket_scripts"><t t-set="viewer_script" t-value="'guide_index.js'"/></t>
            </body>
        </html>
    </template>

    <!-- /huong-dan/<slug>/: một hướng dẫn chiếm cả trang, ngăn hỏi đáp / yêu cầu sửa bên phải (máy
         tính mở sẵn; điện thoại phủ lên trang, bật bằng nút trên thanh). Biến vào: guide
         (GuidePage._guide_item), index_href. -->
    <template id="guide_full" name="Hướng dẫn — một hướng dẫn">
        &lt;!DOCTYPE html&gt;
        <html lang="vi">
            <head>
                <t t-call="hlv_sale_guide.guide_page_head"/>
                <title t-out="guide['name']"/>
            </head>
            <body class="full" t-att-data-csrf="request.csrf_token()" t-att-data-limits="upload_limits"
                  t-att-data-guide-id="guide['id']" t-att-data-guide-slug="guide['slug']" t-att-data-guide-name="guide['name']">
                <nav class="bar">
                    <a t-att-href="index_href">← Tất cả hướng dẫn</a>
                    <b t-out="guide['name']"/>
                    <button type="button" id="guide-ask" class="head-btn"
                            title="Hỏi hoặc yêu cầu sửa hướng dẫn này. Mẹo: bôi đen một đoạn để trích đoạn đó.">
                        Hỏi / yêu cầu sửa
                    </button>
                    <button type="button" id="side-toggle" class="bar-toggle" aria-expanded="false" aria-controls="side-tickets">
                        Hỏi đáp <span id="ticket-badge" class="side-badge" title="Ticket chưa xử lý của hướng dẫn này" hidden="hidden"/>
                    </button>
                </nav>
                <div class="layout">
                    <section class="viewer">
                        <iframe id="guide-view" name="guide-view" t-att-title="guide['name']"
                                t-attf-src="#{guide['url']}?embed=1"/>
                    </section>
                    <aside class="side">
                        <div class="tickets" id="side-tickets" hidden="hidden"/>
                    </aside>
                </div>
                <t t-call="hlv_sale_guide.guide_ticket_scripts"><t t-set="viewer_script" t-value="'guide_viewer_single.js'"/></t>
            </body>
        </html>
    </template>

    <!-- Một thư mục, gọi đệ quy cho thư mục con. Biến vào: node (xem build_tree). -->
    <template id="guide_tree_folder" name="Hướng dẫn — thư mục">
        <details class="folder" open="open">
            <summary><span class="folder-name" t-out="node['name']"/><small t-out="node['count']"/></summary>
            <div class="folder-body">
                <t t-foreach="node['folders']" t-as="child">
                    <t t-call="hlv_sale_guide.guide_tree_folder"><t t-set="node" t-value="child"/></t>
                </t>
                <t t-foreach="node['guides']" t-as="guide">
                    <t t-call="hlv_sale_guide.guide_tree_leaf"/>
                </t>
            </div>
        </details>
    </template>

    <!-- Một hướng dẫn. Biến vào: guide (dict từ GuidePage._guide_item). -->
    <template id="guide_tree_leaf" name="Hướng dẫn — mục">
        <a class="leaf" t-att-href="guide['url']" t-att-data-id="guide['id']" t-att-data-slug="guide['slug']" t-att-data-name="guide['name']"
           t-att-title="guide['summary'] or None">
            <span t-attf-class="kind kind-#{guide['kind']}" t-out="'PDF' if guide['kind'] == 'pdf' else 'Trang'"/>
            <span class="leaf-name" t-out="guide['name']"/>
        </a>
    </template>
</odoo>
