<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Trang chờ: phiên đã đúng mật khẩu nhưng chưa hoàn tất (giống bước nhập mã 2FA). -->
    <template id="login_wait" name="Chờ duyệt thiết bị đăng nhập">
        <t t-call="web.login_layout">
            <t t-set="disable_footer">1</t>
            <div class="oe_login_form o_hlv_login_wait"
                 t-att-data-channel="device.bus_channel"
                 t-att-data-status-url="'/web/login/approval/status'"
                 t-att-data-continue-url="continue_url">
                <t t-if="waiting_state == 'rejected'">
                    <h5 class="card-title text-danger">Đăng nhập bị từ chối</h5>
                    <p class="text-muted">
                        Người duyệt đã từ chối đăng nhập từ thiết bị này. Liên hệ quản trị viên nếu cần.
                    </p>
                </t>
                <t t-elif="waiting_state == 'expired'">
                    <h5 class="card-title text-warning">Yêu cầu duyệt đã hết hạn</h5>
                    <p class="text-muted">
                        Chưa có ai duyệt trong <t t-out="request_minutes"/> phút.
                        Đăng nhập lại để gửi yêu cầu mới tới người duyệt.
                    </p>
                    <a class="btn btn-primary w-100" href="/web/session/logout?redirect=/web/login">Đăng nhập lại</a>
                </t>
                <t t-elif="waiting_state == 'cancelled'">
                    <h5 class="card-title text-warning">Yêu cầu duyệt đã bị huỷ</h5>
                    <p class="text-muted">
                        Người duyệt chọn không đúng số. Đăng nhập lại để lấy số mới, rồi đọc đúng số đó
                        cho người duyệt.
                    </p>
                    <a class="btn btn-primary w-100" href="/web/session/logout?redirect=/web/login">Đăng nhập lại</a>
                </t>
                <t t-else="">
                    <h5 class="card-title">Đang chờ duyệt thiết bị</h5>
                    <p class="text-muted mb-1">Nhắn số này cho người duyệt (quản lý):</p>
                    <div class="text-center my-3">
                        <span class="display-3 fw-bold text-primary" t-out="match_code"/>
                    </div>
                    <p class="text-muted">
                        Người duyệt phải chọn đúng số này thì bạn mới vào được. Khi được duyệt trang sẽ tự vào
                        hệ thống, không cần nhập lại mật khẩu. Yêu cầu chờ tối đa
                        <t t-out="request_minutes"/> phút.
                    </p>
                    <div class="text-center mb-3">
                        <span class="spinner-border spinner-border-sm text-primary" role="status"/>
                    </div>
                    <p class="small text-muted mb-0">
                        Thiết bị: <t t-out="' / '.join(filter(None, [device.platform, device.browser])) or 'Không rõ'"/><br/>
                        IP: <t t-out="device.ip_address or 'Không rõ'"/>
                    </p>
                </t>
                <div class="text-center small mt-4 pt-3 border-top">
                    <a href="/web/session/logout?redirect=/web/login">Đăng nhập tài khoản khác</a>
                </div>
            </div>
        </t>
    </template>
</odoo>
