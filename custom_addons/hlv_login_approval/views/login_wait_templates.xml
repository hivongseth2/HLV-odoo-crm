<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Trang chờ: phiên đã đúng mật khẩu nhưng chưa hoàn tất (giống bước nhập mã 2FA). -->
    <template id="login_wait" name="Chờ duyệt thiết bị đăng nhập">
        <t t-call="web.login_layout">
            <t t-set="disable_footer">1</t>
            <div class="oe_login_form o_hlv_login_wait"
                 t-att-data-channel="device.bus_channel"
                 t-att-data-status-url="'/web/login/approval/status'"
                 t-att-data-continue-url="continue_url">
                <t t-if="device.state == 'rejected'">
                    <h5 class="card-title text-danger">Đăng nhập bị từ chối</h5>
                    <p class="text-muted">
                        Người duyệt đã từ chối đăng nhập từ thiết bị này. Liên hệ quản trị viên nếu cần.
                    </p>
                </t>
                <t t-else="">
                    <h5 class="card-title">Đang chờ duyệt thiết bị</h5>
                    <div class="text-center my-4">
                        <span class="spinner-border text-primary" role="status"/>
                    </div>
                    <p class="text-muted">
                        Đây là lần đầu bạn đăng nhập từ thiết bị này. Yêu cầu đã gửi tới người duyệt;
                        khi được duyệt trang sẽ tự vào hệ thống, không cần nhập lại mật khẩu.
                    </p>
                    <p class="small text-muted mb-0">
                        Thiết bị: <t t-out="' / '.join(filter(None, [device.platform, device.browser])) or 'Không rõ'"/><br/>
                        IP: <t t-out="device.ip_address or 'Không rõ'"/>
                    </p>
                </t>
                <div class="text-center small mt-4 pt-3 border-top">
                    <a href="/web/session/logout?redirect=/web/login">Đăng nhập tài khoản khác</a>
                </div>
            </div>
        </t>
    </template>
</odoo>
