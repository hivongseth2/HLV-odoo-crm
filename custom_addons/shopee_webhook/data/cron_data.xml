<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_poll_shopee_order_status" model="ir.cron">
        <field name="name">Shopee: Poll trạng thái đơn hàng chưa kết thúc (mỗi 3 tiếng)</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_poll_shopee_order_status()</field>
        <field name="interval_number">3</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_process_webhook_events" model="ir.cron">
        <field name="name">Shopee: Xử lý hàng đợi webhook</field>
        <field name="model_id" ref="model_shopee_webhook_event"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_pending()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
</odoo>
