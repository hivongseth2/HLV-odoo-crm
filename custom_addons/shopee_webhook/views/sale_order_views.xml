<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_shopee" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.shopee</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="shopee_order_status" widget="badge" readonly="1"
                       decoration-danger="shopee_order_status in ('Đã hủy', 'CANCELLED')"
                       decoration-success="shopee_order_status == 'Hoàn thành'"
                       decoration-info="shopee_order_status in ('Chờ lấy hàng', 'Đã xử lý', 'Đang giao')"
                       decoration-warning="shopee_order_status in ('Chưa thanh toán', 'Chờ xác nhận hủy', 'Chờ xuất HĐ', 'Giao lại')"
                       decoration-muted="shopee_order_status == 'Tạm chờ'" />
            </xpath>
        </field>
    </record>
</odoo>
