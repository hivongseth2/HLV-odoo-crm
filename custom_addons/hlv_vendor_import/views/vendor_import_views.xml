<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vendor_import_form" model="ir.ui.view">
        <field name="name">hlv.vendor.import.form</field>
        <field name="model">hlv.vendor.import</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_read_file" type="object" string="Đọc file" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_confirm_columns" type="object" string="Đọc theo mẫu này" class="btn-primary"
                            invisible="state != 'mapping'"/>
                    <button name="action_refresh_columns" type="object" string="Đề xuất lại cột"
                            invisible="state != 'mapping'"/>
                    <button name="action_ai_suggest_columns" type="object" string="AI đề xuất lại" icon="fa-magic"
                            invisible="state != 'mapping'"
                            confirm="AI đọc lại đầu file và đề xuất lại cả mẫu (dòng tiêu đề, các cột) — cột đã chọn tay có thể bị đổi. Tiếp tục?"/>
                    <button name="action_open_lines" type="object" string="Xác nhận từng dòng" class="btn-primary"
                            invisible="state != 'review'"/>
                    <button name="action_accept_matches" type="object" string="Nhận hết dòng AI khớp"
                            invisible="state != 'review' or match_count == 0"/>
                    <button name="action_run_ai" type="object" string="Chạy lại AI"
                            invisible="state != 'review' or ai_state not in ('failed', 'done', 'none') or ai_pending_count == 0"/>
                    <button name="action_read_file" type="object" string="Đọc lại file"
                            invisible="state != 'review' or ai_state in ('queued', 'running')"
                            confirm="Đọc lại file sẽ xoá các dòng và xác nhận hiện có của lần nhập này. Tiếp tục?"/>
                    <button name="action_apply" type="object" string="Áp dụng tồn kho" class="btn-success"
                            invisible="state != 'review' or ai_state in ('queued', 'running') or not has_stock or has_price"
                            confirm="Thay toàn bộ tồn kho của NCC này bằng file này? Dòng chưa xác nhận vẫn vào bảng tồn theo mã NCC (chưa gắn sản phẩm)."/>
                    <button name="action_apply" type="object" string="Áp dụng bảng giá" class="btn-success"
                            invisible="state != 'review' or ai_state in ('queued', 'running') or not has_price"
                            confirm="Ghi giá các mã trong file từ ngày &quot;Giá áp dụng từ&quot;? Giá cũ của các mã đó dừng ở ngày này (vẫn giữ để tra); mã không có trong file giữ nguyên giá. File có cả cột tồn thì tồn kho NCC cũng được thay bằng file này."/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_lines" type="object" class="oe_stat_button" icon="fa-list"
                                invisible="line_count == 0">
                            <field name="line_count" widget="statinfo" string="Dòng"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="file" filename="file_name" readonly="state == 'done'"/>
                            <field name="file_name" invisible="1"/>
                            <field name="profile_id" readonly="state != 'draft'" options="{'no_create': True}"
                                   placeholder="Lần đầu của NCC: để trống, Odoo đề xuất"/>
                            <field name="price_date" invisible="not has_price" readonly="state == 'done'"
                                   required="has_price and state == 'review'"/>
                            <field name="has_stock" invisible="1"/>
                            <field name="has_price" invisible="1"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="ai_state" invisible="state == 'draft'" widget="badge"
                                   decoration-info="ai_state in ('queued', 'running')"
                                   decoration-success="ai_state == 'done'"
                                   decoration-danger="ai_state == 'failed'"/>
                            <field name="ai_error" invisible="not ai_error" class="text-danger"/>
                            <field name="applied_at" invisible="state != 'done'"/>
                            <field name="applied_by" invisible="state != 'done'"/>
                        </group>
                    </group>

                    <div class="alert alert-info" role="alert" invisible="ai_state not in ('queued', 'running')">
                        AI đang duyệt <field name="ai_pending_count" class="oe_inline"/> dòng trong nền — tải lại trang sau ít phút.
                        Trong lúc chờ vẫn xác nhận được các dòng đã duyệt.
                    </div>

                    <group string="Kết quả" invisible="state not in ('review', 'done')">
                        <group>
                            <field name="alias_count"/>
                            <field name="match_count"/>
                            <field name="probable_count"/>
                            <field name="none_count"/>
                        </group>
                        <group>
                            <field name="confirmed_count"/>
                            <field name="todo_count"/>
                        </group>
                    </group>

                    <div invisible="state != 'mapping'">
                        <div class="alert alert-info" role="alert" invisible="not profile_ai_note">
                            <b>AI:</b> <field name="profile_ai_note" class="oe_inline"/>
                        </div>
                        <div class="alert alert-warning" role="alert">
                            Xem lại mẫu file của NCC này: cột nào là mã / tên / đơn vị tính / tồn từng kho / giá. Sai dòng
                            tiêu đề thì sửa rồi bấm "Đề xuất lại cột". Chỉ làm một lần — các file sau của NCC đọc theo mẫu này.
                        </div>
                        <group>
                            <group>
                                <field name="profile_sheet_name"/>
                                <field name="profile_header_row"/>
                                <field name="profile_header_rows"/>
                            </group>
                            <group>
                                <field name="profile_code_prefixes" placeholder="vd SC"/>
                                <field name="profile_brand" placeholder="vd SATA"/>
                                <field name="profile_our_code_patterns" placeholder="vd {ma}-SATA"/>
                                <field name="profile_price_in_thousands"/>
                                <field name="profile_skip_group_rows"/>
                            </group>
                        </group>
                        <field name="profile_column_ids">
                            <list editable="bottom" create="0" delete="0">
                                <field name="letter"/>
                                <field name="header"/>
                                <field name="sample"/>
                                <field name="role"/>
                                <field name="warehouse" invisible="role != 'stock'"/>
                            </list>
                        </field>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_vendor_import_list" model="ir.ui.view">
        <field name="name">hlv.vendor.import.list</field>
        <field name="model">hlv.vendor.import</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="file_name"/>
                <field name="user_id" optional="show"/>
                <field name="create_date" string="Ngày tải"/>
                <field name="ai_state" widget="badge"
                       decoration-info="ai_state in ('queued', 'running')"
                       decoration-success="ai_state == 'done'"
                       decoration-danger="ai_state == 'failed'"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-warning="state == 'mapping'"
                       decoration-info="state == 'review'"/>
            </list>
        </field>
    </record>

    <record id="view_vendor_import_search" model="ir.ui.view">
        <field name="name">hlv.vendor.import.search</field>
        <field name="model">hlv.vendor.import</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="open" string="Chưa áp dụng" domain="[('state', '!=', 'done')]"/>
                <group>
                    <filter name="group_partner" string="Nhà cung cấp" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_vendor_import" model="ir.actions.act_window">
        <field name="name">Nhập file NCC</field>
        <field name="res_model">hlv.vendor.import</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_vendor_import_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Tải file Excel tồn kho hoặc bảng giá của NCC lên</p>
            <p>Odoo đọc theo mẫu của từng NCC, Claude ghép mã NCC với sản phẩm bên mình, bạn xác nhận rồi áp dụng.</p>
        </field>
    </record>
</odoo>
