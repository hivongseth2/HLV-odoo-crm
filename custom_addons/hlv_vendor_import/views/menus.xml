<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Một mục riêng trong menu "Báo giá NCC" của hlv_vendor_quotation (app Yêu cầu mua hàng), như mục "Zalo nhóm NCC".
         Việc hằng ngày trước (nhập file, xem giá / tồn, xác nhận khớp mã), thiết lập sau. Việc của thu mua. -->
    <menuitem id="menu_vendor_file_root"
              name="Bảng giá &amp; tồn kho NCC"
              parent="hlv_vendor_quotation.menu_vendor_quote_root"
              sequence="50"
              groups="purchase.group_purchase_user"/>
    <menuitem id="menu_vendor_import"
              name="Nhập file NCC"
              parent="menu_vendor_file_root"
              action="action_vendor_import"
              sequence="10"
              groups="purchase.group_purchase_user"/>
    <menuitem id="menu_vendor_price"
              name="Bảng giá NCC"
              parent="menu_vendor_file_root"
              action="action_vendor_price"
              sequence="20"
              groups="purchase.group_purchase_user"/>
    <menuitem id="menu_vendor_stock"
              name="Tồn kho NCC"
              parent="menu_vendor_file_root"
              action="action_vendor_stock"
              sequence="30"
              groups="purchase.group_purchase_user"/>
    <menuitem id="menu_vendor_code_suggestion"
              name="Gợi ý khớp mã"
              parent="menu_vendor_file_root"
              action="action_vendor_code_suggestion"
              sequence="40"
              groups="purchase.group_purchase_user"/>
    <menuitem id="menu_vendor_import_profile"
              name="Mẫu file NCC"
              parent="menu_vendor_file_root"
              action="action_vendor_import_profile"
              sequence="50"
              groups="purchase.group_purchase_user"/>
    <menuitem id="menu_vendor_product_alias"
              name="Mã NCC đã khớp"
              parent="menu_vendor_file_root"
              action="action_vendor_product_alias"
              sequence="60"
              groups="purchase.group_purchase_user"/>
</odoo>
