<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate: giữ trạng thái active/nextcall khi upgrade module -->
    <data noupdate="1">
        <record id="ir_cron_po_reconcile_daily" model="ir.cron">
            <field name="name">MISA: Gửi mail đối chiếu Đơn mua hàng (19h GMT+7)</field>
            <field name="model_id" search="[('model', '=', 'hlv.po.reconcile.report')]"/>
            <field name="state">code</field>
            <field name="code">model.cron_send_daily_reconcile()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <!-- nextcall lưu theo UTC: 12:00 UTC = 19:00 GMT+7 -->
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 12:00:00')"/>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
