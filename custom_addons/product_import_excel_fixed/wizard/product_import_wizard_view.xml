<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_product_import_wizard" model="ir.ui.view">
    <field name="name">product.import.wizard.form</field>
    <field name="model">product.import.wizard</field>
    <field name="arch" type="xml">
      <form string="Import sản phẩm từ Excel">
        <group>
          <field name="import_type" widget="radio"/>
          <field name="file" filename="filename"/>
          <field name="filename" invisible="1"/>
          <field name="update_existing"/>
          <field name="batch_size" invisible="import_type != 'product'"/>
        </group>

        <!-- Hướng dẫn cho Import Sản phẩm -->
        <group string="Hướng dẫn" invisible="import_type != 'product'">
          <div>
            <p><strong>File Excel cần có các cột:</strong></p>
            <ul>
              <li><strong>Mã</strong>: Mã tham chiếu nội bộ (bắt buộc)</li>
              <li><strong>Tên</strong>: Tên sản phẩm</li>
              <li><strong>ĐVT</strong>: Đơn vị tính (mặc định: Cái)</li>
            </ul>
            <p><em>Sản phẩm mới sẽ được tạo với: Có thể bán, Có thể mua, Theo dõi tồn kho = Có</em></p>
          </div>
        </group>

        <!-- Hướng dẫn cho Import Combo -->
        <group string="Hướng dẫn" invisible="import_type != 'combo'">
          <div>
            <p><strong>File Excel cần có các cột:</strong></p>
            <ul>
              <li><strong>Mã Combo</strong>: Mã của sản phẩm combo (bắt buộc)</li>
              <li><strong>Tên Combo</strong>: Tên sản phẩm combo</li>
              <li><strong>Mã Hàng Con</strong>: Mã của sản phẩm con (bắt buộc)</li>
              <li><strong>Tên Hàng Con</strong>: Tên sản phẩm con</li>
              <li><strong>ĐVT</strong>: Đơn vị tính</li>
              <li><strong>Số Lượng</strong>: Số lượng sản phẩm con trong combo</li>
            </ul>
          </div>
        </group>

        <footer>
          <button name="action_import" string="Import" type="object" class="btn-primary"/>
          <button string="Huỷ" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
