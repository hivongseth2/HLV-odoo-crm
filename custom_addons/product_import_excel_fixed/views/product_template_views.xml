<odoo>
    <!-- Wizard View đã có (giả sử là product.import.wizard) -->

    <!-- Action mở Wizard -->
    <record id="action_product_import_wizard" model="ir.actions.act_window">
        <field name="name">Import prd MISA</field>
        <field name="res_model">product.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu mới dưới Tồn kho (gốc), không phải menu sản phẩm gốc -->
    <menuitem id="menu_import_product_from_misa"
              name="Import prd MISA"
              parent="stock.menu_stock_root"
              action="action_product_import_wizard"
              sequence="99"/>
</odoo>
