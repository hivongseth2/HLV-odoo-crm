<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="delivery_sender_address_view_form_inherit_ghn" model="ir.ui.view">
        <field name="name">delivery.sender.address.form.inherit.ghn</field>
        <field name="model">delivery.sender.address</field>
        <field name="inherit_id" ref="hlv_delivery_jt.delivery_sender_address_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <group string="Cấu hình GHN">
                    <field name="ghn_shop_id"/>
                    <field name="ghn_province_id" options="{'no_open': True, 'no_create': True}"/>
                    <field name="ghn_district_id" options="{'no_open': True, 'no_create': True}"/>
                    <field name="ghn_ward_id" options="{'no_open': True, 'no_create': True}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
