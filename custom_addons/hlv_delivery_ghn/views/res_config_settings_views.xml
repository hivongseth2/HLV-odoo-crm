<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ghn" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ghn</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='operations_setting_container']" position="after">
                <block title="Giao Hàng Nhanh (GHN)" name="ghn_setting_container">
                    <setting id="ghn_api_token_setting" string="GHN API Token" help="Token provided by GHN">
                        <field name="ghn_api_token" password="True"/>
                    </setting>
                    <setting id="ghn_shop_id_setting" string="GHN Shop ID" help="Manage information for shop/seller">
                        <field name="ghn_shop_id"/>
                    </setting>
                    <setting id="ghn_environment_setting" string="GHN Environment">
                        <field name="ghn_environment" widget="radio"/>
                    </setting>
                    <setting id="ghn_sync_location_setting">
                        <button name="action_check_ghn_connection" 
                                type="object" 
                                string="Kiểm tra kết nối" 
                                class="btn-secondary mr-2"/>
                        <button name="action_sync_ghn_locations" 
                                type="object" 
                                string="Sync Provinces &amp; Districts" 
                                class="btn-primary"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
