<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ghn" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ghn</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='delivery_setting_container']" position="after">
                <h2>Giao Hàng Nhanh (GHN)</h2>
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="ghn_api_token"/>
                            <div class="text-muted">
                                Token provided by GHN
                            </div>
                            <div class="content-group">
                                <field name="ghn_api_token" password="True"/>
                            </div>
                            <div class="mt8">
                                <label for="ghn_shop_id"/>
                                <field name="ghn_shop_id"/>
                            </div>
                            <div class="mt8">
                                <label for="ghn_environment"/>
                                <field name="ghn_environment" widget="radio"/>
                            </div>
                            <div class="mt16">
                                <button name="action_sync_ghn_locations" 
                                        type="object" 
                                        string="Sync Provinces &amp; Districts" 
                                        class="btn-primary"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
