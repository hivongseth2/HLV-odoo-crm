<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="my_holds_page" name="Yêu cầu giữ hàng của tôi">
    <t t-call="website.layout">
      <style>
        .hold-badge {
          display:inline-block; padding:4px 12px; border-radius:999px;
          font-size:.76rem; font-weight:700; white-space:nowrap; line-height:1.3;
        }
        #my-holds-table th {
          white-space:nowrap; font-size:.76rem; text-transform:uppercase; letter-spacing:.4px;
          color:#6b7280; font-weight:700; padding:.75rem .9rem; border-bottom-width:1px;
        }
        #my-holds-table td { padding:.65rem .9rem; vertical-align:middle; font-size:.9rem; }
        #my-holds-table td.text-nowrap { white-space:nowrap; }
        #my-holds-table td.product-cell { min-width:220px; }
        #my-holds-table td.location-cell { color:#374151; font-size:.82rem; }
        #my-holds-table tbody tr:last-child td { border-bottom:none; }
      </style>
      <main id="wrap" class="oe_structure">
        <section>
          <div class="container-fluid mt-3 mb-6" style="max-width: 1300px;">
            <div style="border-bottom: 2px solid #e9ecef; padding-bottom: 16px; margin-bottom: 1.5rem;">
              <ul class="nav nav-pills justify-content-center flex-wrap gap-2">
                <li class="nav-item">
                  <a class="nav-link text-dark px-3 py-2" href="/search_stock" style="font-weight:500;font-size:.9rem;background:#f8f9fa;">
                    <i class="fa fa-cubes me-1"></i><span>Tồn kho</span>
                  </a>
                </li>
                <li class="nav-item">
                  <a class="nav-link text-dark px-3 py-2" href="/misa/purchase/lookup" style="font-weight:500;font-size:.9rem;background:#f8f9fa;">
                    <i class="fa fa-shopping-cart me-1"></i><span>Chứng từ mua</span>
                  </a>
                </li>
                <li class="nav-item">
                  <a class="nav-link text-dark px-3 py-2" href="/search_invoice" style="font-weight:500;font-size:.9rem;background:#f8f9fa;">
                    <i class="fa fa-file-text me-1"></i><span>Hóa đơn MISA</span>
                  </a>
                </li>
                <li class="nav-item">
                  <a class="nav-link text-dark px-3 py-2" href="/sale_plan" style="font-weight:500;font-size:.9rem;background:#f8f9fa;">
                    <i class="fa fa-truck me-1"></i><span>Tình trạng đơn</span>
                  </a>
                </li>
                <li class="nav-item">
                  <a class="nav-link active bg-primary text-white px-3 py-2" href="/search_stock/my_holds" style="font-weight:600;font-size:.9rem;">
                    <i class="fa fa-lock me-1"></i><span>Yêu cầu của tôi</span>
                  </a>
                </li>
              </ul>
            </div>

            <t t-set="state_labels" t-value="{
                'draft': ('Nháp', '#eff6ff', '#2563eb'),
                'pending_approval': ('Chờ duyệt', '#fffbeb', '#b45309'),
                'approved': ('Đang giữ', '#f0fdf4', '#16a34a'),
                'rejected': ('Từ chối', '#fef2f2', '#dc2626'),
                'completed': ('Hoàn thành', '#ecfeff', '#0e7490'),
                'cancelled': ('Đã hủy', '#f3f4f6', '#6b7280'),
                'expired': ('Hết hạn', '#f5f3ff', '#7c3aed'),
            }"/>

            <form method="get" t-att-action="request.httprequest.path" class="row g-2 mb-3">
              <div class="col-md-3">
                <select name="state" class="form-select">
                  <option value="">-- Tất cả trạng thái --</option>
                  <t t-foreach="state_labels.items()" t-as="item">
                    <option t-att-value="item[0]" t-att-selected="filter_state == item[0]">
                      <t t-esc="item[1][0]"/>
                    </option>
                  </t>
                </select>
              </div>
              <div class="col-md-3">
                <select name="warehouse_id" class="form-select">
                  <option value="">-- Tất cả kho --</option>
                  <t t-foreach="warehouse_options" t-as="w">
                    <option t-att-value="w.id" t-att-selected="filter_warehouse_id == w.id">
                      <t t-esc="w.name"/>
                    </option>
                  </t>
                </select>
              </div>
              <div class="col-md-3">
                <select name="sale_name" class="form-select">
                  <option value="">-- Tất cả sale --</option>
                  <t t-foreach="sale_name_options_filter" t-as="sn">
                    <option t-att-value="sn" t-att-selected="filter_sale_name == sn">
                      <t t-esc="sn"/>
                    </option>
                  </t>
                </select>
              </div>
              <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill"><i class="fa fa-filter me-1"></i>Lọc</button>
                <a href="/search_stock/my_holds" class="btn btn-outline-secondary">Xóa lọc</a>
              </div>
            </form>

            <t t-if="holds">
              <div class="card shadow-sm border-0">
                <div class="table-responsive">
                  <table class="table table-sm table-hover align-middle mb-0" id="my-holds-table">
                    <thead class="bg-light">
                      <tr>
                        <th>Mã</th>
                        <th>Sản phẩm</th>
                        <th>Kho</th>
                        <th>Vị trí đang giữ</th>
                        <th class="text-end">SL giữ</th>
                        <th>Dự án</th>
                        <th>Tên sale</th>
                        <th>Ngày tạo</th>
                        <th>Giữ đến ngày</th>
                        <th>Trạng thái</th>
                        <th></th>
                      </tr>
                    </thead>
                    <tbody>
                      <t t-foreach="holds" t-as="h">
                        <t t-set="lbl" t-value="state_labels.get(h.state, (h.state, '#eee', '#333'))"/>
                        <tr t-att-data-hold-id="h.id">
                          <td class="fw-bold text-primary text-nowrap"><t t-esc="h.name"/></td>
                          <td class="product-cell"><t t-esc="h.product_id.display_name"/></td>
                          <td class="text-nowrap"><t t-esc="h.warehouse_id.name"/></td>
                          <td class="location-cell">
                            <t t-if="h.hold_location_names"><i class="fa fa-map-marker text-muted me-1"></i><t t-esc="h.hold_location_names"/></t>
                            <t t-else="">—</t>
                          </td>
                          <td class="text-end text-nowrap"><t t-esc="'{:,.0f}'.format(h.quantity)"/></td>
                          <td><t t-esc="h.project_name"/></td>
                          <td class="text-nowrap"><t t-esc="h.sale_name"/></td>
                          <td class="text-nowrap"><t t-esc="h.create_date.strftime('%d/%m/%Y')"/></td>
                          <td class="text-nowrap"><t t-esc="h.hold_until_date"/></td>
                          <td class="text-nowrap">
                            <span class="hold-badge" t-attf-style="background:#{lbl[1]};color:#{lbl[2]};">
                              <t t-esc="lbl[0]"/>
                            </span>
                          </td>
                          <td class="text-nowrap">
                            <button t-if="h.state in ('draft', 'pending_approval', 'approved')"
                                    type="button" class="btn btn-sm btn-outline-danger btn-cancel-hold"
                                    t-att-data-hold-id="h.id">
                              Hủy
                            </button>
                          </td>
                        </tr>
                      </t>
                    </tbody>
                  </table>
                </div>
              </div>
            </t>
            <t t-else="">
              <div class="text-center py-5">
                <img src="/web/static/img/smiling_face.svg" style="width:64px; opacity:0.5;"/>
                <p class="mt-3 text-muted">Không có yêu cầu giữ hàng nào khớp bộ lọc.</p>
              </div>
            </t>
          </div>
        </section>

        <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
        <script type="text/javascript"><![CDATA[
          $(document).ready(function () {
            $(document).on('click', '.btn-cancel-hold', function () {
              var $btn = $(this);
              var holdId = $btn.data('hold-id');
              if (!window.confirm('Hủy yêu cầu giữ hàng này?')) return;
              $btn.prop('disabled', true).text('Đang hủy...');
              $.ajax({
                url: "/search_stock/hold/cancel",
                type: "POST", dataType: "json", contentType: "application/json",
                data: JSON.stringify({ jsonrpc: "2.0", method: "call", params: { hold_id: holdId }, id: new Date().getTime() }),
                success: function (resp) {
                  var res = (resp && resp.result) ? resp.result : {};
                  if (res.ok) {
                    window.location.reload();
                  } else {
                    alert('Lỗi: ' + (res.error || 'Không thể hủy yêu cầu.'));
                    $btn.prop('disabled', false).text('Hủy');
                  }
                },
                error: function () {
                  alert('Lỗi kết nối. Vui lòng thử lại.');
                  $btn.prop('disabled', false).text('Hủy');
                }
              });
            });
          });
        ]]></script>
      </main>
    </t>
  </template>
</odoo>
