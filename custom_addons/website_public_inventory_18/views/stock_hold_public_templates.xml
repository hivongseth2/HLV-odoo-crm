<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="my_holds_page" name="Yêu cầu giữ hàng của tôi">
    <t t-call="website.layout">
      <style>
        .hold-badge { display:inline-block; padding:3px 10px; border-radius:999px; font-size:.78rem; font-weight:700; }
      </style>
      <main id="wrap" class="oe_structure">
        <section>
          <div class="container-fluid mt-3 mb-6" style="max-width: 1200px;">
            <div style="border-bottom: 2px solid #e9ecef; padding-bottom: 16px; margin-bottom: 1.5rem;">
              <ul class="nav nav-pills justify-content-center flex-wrap gap-2">
                <li class="nav-item">
                  <a class="nav-link text-dark px-3 py-2" href="/search_stock" style="font-weight:500;font-size:.9rem;background:#f8f9fa;">
                    <i class="fa fa-cubes me-1"></i><span>Tồn kho</span>
                  </a>
                </li>
                <li class="nav-item">
                  <a class="nav-link text-dark px-3 py-2" href="/misa/purchase/lookup" style="font-weight:500;font-size:.9rem;background:#f8f9fa;">
                    <i class="fa fa-shopping-cart me-1"></i><span>Chứng từ mua</span>
                  </a>
                </li>
                <li class="nav-item">
                  <a class="nav-link text-dark px-3 py-2" href="/search_invoice" style="font-weight:500;font-size:.9rem;background:#f8f9fa;">
                    <i class="fa fa-file-text me-1"></i><span>Hóa đơn MISA</span>
                  </a>
                </li>
                <li class="nav-item">
                  <a class="nav-link text-dark px-3 py-2" href="/sale_plan" style="font-weight:500;font-size:.9rem;background:#f8f9fa;">
                    <i class="fa fa-truck me-1"></i><span>Tình trạng đơn</span>
                  </a>
                </li>
                <li class="nav-item">
                  <a class="nav-link active bg-primary text-white px-3 py-2" href="/search_stock/my_holds" style="font-weight:600;font-size:.9rem;">
                    <i class="fa fa-lock me-1"></i><span>Yêu cầu của tôi</span>
                  </a>
                </li>
              </ul>
            </div>

            <t t-set="state_labels" t-value="{
                'draft': ('Nháp', '#eff6ff', '#2563eb'),
                'pending_approval': ('Chờ duyệt', '#fffbeb', '#b45309'),
                'approved': ('Đang giữ', '#f0fdf4', '#16a34a'),
                'rejected': ('Từ chối', '#fef2f2', '#dc2626'),
                'completed': ('Hoàn thành', '#f3f4f6', '#374151'),
                'cancelled': ('Đã hủy', '#f3f4f6', '#6b7280'),
                'expired': ('Hết hạn', '#fef2f2', '#b91c1c'),
            }"/>

            <t t-if="holds">
              <div class="card shadow-sm border-0">
                <div class="table-responsive">
                  <table class="table table-sm table-hover align-middle mb-0" id="my-holds-table">
                    <thead class="bg-light">
                      <tr>
                        <th>Mã</th>
                        <th>Sản phẩm</th>
                        <th>Kho</th>
                        <th class="text-end">SL giữ</th>
                        <th>Dự án</th>
                        <th>Tên sale</th>
                        <th>Giữ đến ngày</th>
                        <th>Trạng thái</th>
                        <th></th>
                      </tr>
                    </thead>
                    <tbody>
                      <t t-foreach="holds" t-as="h">
                        <t t-set="lbl" t-value="state_labels.get(h.state, (h.state, '#eee', '#333'))"/>
                        <tr t-att-data-hold-id="h.id">
                          <td class="fw-bold text-primary"><t t-esc="h.name"/></td>
                          <td><t t-esc="h.product_id.display_name"/></td>
                          <td><t t-esc="h.warehouse_id.name"/></td>
                          <td class="text-end"><t t-esc="'{:,.0f}'.format(h.quantity)"/></td>
                          <td><t t-esc="h.project_name"/></td>
                          <td><t t-esc="h.sale_name"/></td>
                          <td><t t-esc="h.hold_until_date"/></td>
                          <td>
                            <span class="hold-badge" t-attf-style="background:#{lbl[1]};color:#{lbl[2]};">
                              <t t-esc="lbl[0]"/>
                            </span>
                          </td>
                          <td>
                            <button t-if="h.state in ('draft', 'pending_approval', 'approved')"
                                    type="button" class="btn btn-sm btn-outline-danger btn-cancel-hold"
                                    t-att-data-hold-id="h.id">
                              Hủy
                            </button>
                          </td>
                        </tr>
                      </t>
                    </tbody>
                  </table>
                </div>
              </div>
            </t>
            <t t-else="">
              <div class="text-center py-5">
                <img src="/web/static/img/smiling_face.svg" style="width:64px; opacity:0.5;"/>
                <p class="mt-3 text-muted">Bạn chưa có yêu cầu giữ hàng nào.</p>
              </div>
            </t>
          </div>
        </section>

        <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
        <script type="text/javascript"><![CDATA[
          $(document).ready(function () {
            $(document).on('click', '.btn-cancel-hold', function () {
              var $btn = $(this);
              var holdId = $btn.data('hold-id');
              if (!window.confirm('Hủy yêu cầu giữ hàng này?')) return;
              $btn.prop('disabled', true).text('Đang hủy...');
              $.ajax({
                url: "/search_stock/hold/cancel",
                type: "POST", dataType: "json", contentType: "application/json",
                data: JSON.stringify({ jsonrpc: "2.0", method: "call", params: { hold_id: holdId }, id: new Date().getTime() }),
                success: function (resp) {
                  var res = (resp && resp.result) ? resp.result : {};
                  if (res.ok) {
                    window.location.reload();
                  } else {
                    alert('Lỗi: ' + (res.error || 'Không thể hủy yêu cầu.'));
                    $btn.prop('disabled', false).text('Hủy');
                  }
                },
                error: function () {
                  alert('Lỗi kết nối. Vui lòng thử lại.');
                  $btn.prop('disabled', false).text('Hủy');
                }
              });
            });
          });
        ]]></script>
      </main>
    </t>
  </template>
</odoo>
