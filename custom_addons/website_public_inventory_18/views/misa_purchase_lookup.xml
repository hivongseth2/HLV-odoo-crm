<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template trang tra cứu chứng từ MISA -->
    <template id="misa_purchase_lookup" name="MISA Purchase Voucher Lookup">
        <t t-call="website.layout">
            <div class="misa-lookup-container">
                <!-- Header -->
                <div class="misa-lookup-header">
                    <div class="container">
                        <h1>Tra cứu Chứng từ Mua hàng MISA</h1>
                    </div>
                </div>

                <div class="container-fluid py-4 m-0"> <!-- Full width container -->
                    <!-- Search Form -->
                    <div class="misa-search-card mb-5">
                        <form method="get" action="/misa/purchase/lookup" class="misa-search-form">
                            <div class="input-group">
                                <input type="text" 
                                       name="journal_memo" 
                                       class="form-control form-control-lg" 
                                       placeholder="Nhập mã diễn giải (VD: DH125524949225720). Tìm nhiều mã cách nhau dấu phẩy."
                                       t-att-value="journal_memo"/>
                                <button type="submit" class="btn btn-primary btn-lg">
                                    Tìm kiếm
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- Error Message -->
                    <t t-if="error">
                        <div class="alert alert-danger mt-4" role="alert">
                            <strong>Lỗi:</strong> <t t-esc="error"/>
                        </div>
                    </t>

                    <!-- Results Table -->
                    <t t-if="searched and not error">
                       
                        <h4 class="mb-4 px-3" style="font-weight: 600; font-size: 1.1rem; color: #374151;">
                             <t t-if="voucher_count > 0">
                                <span class="text-success">Tìm thấy <t t-esc="voucher_count"/> chứng từ</span>
                            </t>
                            <t t-else="">
                                <span class="text-warning">Không tìm thấy chứng từ nào</span>
                            </t>
                        </h4>

                        <t t-if="voucher_count > 0">
                            <div class="table-responsive">
                                <table class="table misa-lookup-table">
                                    <thead>
                                        <tr>
                                            <th class="text-left" style="width: 120px;">Ngày hạch toán</th>
                                            <th class="text-left" style="width: 140px;">Số chứng từ</th>
                                            <th class="text-left" style="width: 140px;">Số hóa đơn</th>
                                            <th class="text-left" style="min-width: 250px;">Nhà cung cấp</th>
                                            <th class="text-left" style="min-width: 250px;">Diễn giải</th>
                                            <th class="text-left" style="width: 150px;">TT nhận hóa đơn</th>
                                            <th class="text-left" style="width: 150px;">TT thanh toán</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="vouchers" t-as="v">
                                            <tr>
                                                <td class="text-left"><t t-esc="v['posted_date']"/></td>
                                                <td class="text-left"><span class="refno"><t t-esc="v['refno_finance']"/></span></td>
                                                <td class="text-left"><span class="refno" style="background:none; padding:0; font-weight:400;"><t t-esc="v['inv_no']"/></span></td>
                                                <td>
                                                    <span class="vendor-name"><t t-esc="v['account_object_name']"/></span>
                                                    <span class="vendor-code" t-if="v['account_object_code']"><t t-esc="v['account_object_code']"/></span>
                                                </td>
                                                <td class="text-dark"><t t-esc="v['journal_memo']"/></td>
                                                <td class="text-left">
                                                    <span t-attf-class="badge #{v['include_invoice']['class']}" t-esc="v['include_invoice']['label']"/>
                                                </td>
                                                <td class="text-left">
                                                    <span t-attf-class="badge #{v['paid_status']['class']}" t-esc="v['paid_status']['label']"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </t>
                    </t>

                    <!-- Instructions when no search -->
                    <t t-if="not searched">
                        <div class="misa-instructions mt-5 text-center text-muted">
                            <p class="lead">Vui lòng nhập mã để tìm kiếm</p>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>
</odoo>
