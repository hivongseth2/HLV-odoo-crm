<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Thêm cột "Đã giữ (Giữ hàng theo Sale)" vào màn "Cập nhật số lượng" (stock.quant editable
         list, mở từ nút On Hand/Vị trí trên sản phẩm) để kho biết phần nào trong số dự trữ là
         do sale giữ chỗ qua trang /search_stock, không phải đơn bán thông thường. -->
    <record id="view_stock_quant_tree_editable_hold_inherit" model="ir.ui.view">
        <field name="name">stock.quant.list.editable.hold.inherit</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='reserved_quantity']" position="after">
                <field name="hold_request_qty" string="Đã giữ (Sale)" optional="show" sum="Tổng đã giữ (Sale)"/>
            </xpath>
            <xpath expr="//button[@name='action_view_orderpoints']" position="after">
                <button name="action_view_hold_requests" string="Giữ hàng" type="object"
                        class="btn-link" icon="fa-lock" invisible="not hold_request_qty"/>
            </xpath>
        </field>
    </record>
</odoo>
