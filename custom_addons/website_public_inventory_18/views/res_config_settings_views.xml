<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_website_public_inventory_settings" model="ir.ui.view">
    <field name="name">website.public.inventory.settings</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="website.res_config_settings_view_form"/>
    <field name="arch" type="xml">

      <!-- Chèn thẳng vào app Website (theo snippet bạn cung cấp) -->
      <xpath expr="//form/app[@name='website']" position="inside">
        <block title="Public Inventory" id="website_public_inventory_settings">
          <setting id="public_inventory_whitelist" string="Public Warehouses" help="Choose which warehouses are shown on the public /inventory page.">
            <!-- Field Many2many đã khai báo trong res.config.settings (models/res_config_settings.py) -->
            <field name="allowed_warehouse_ids" widget="many2many_tags" options="{'no_create': True, 'no_open': True}"/>
            <div class="content-group mt8">
              <small class="text-muted">
                Trang công khai: <code>/search_stock</code> — hiển thị tồn khả dụng (quantity - reserved) theo các kho được chọn.
              </small>
            </div>
          </setting>
          
          <!-- AI Chatbot Configuration -->
          <setting id="chatbot_ai_settings" string="AI Chatbot" help="Configure AI chatbot for product search assistance">
            <field name="chatbot_enabled"/>
            <div class="content-group" invisible="not chatbot_enabled">
              <div class="row mt16">
                <label for="openai_api_key" class="col-3 o_light_label"/>
                <field name="openai_api_key" password="True" placeholder="sk-..."/>
                <button name="test_openai_connection" type="object" string="Test Connection" class="btn-link"/>
              </div>
              <div class="row">
                <label for="openai_model" class="col-3 o_light_label"/>
                <field name="openai_model"/>
              </div>
              <div class="row">
                <label for="chatbot_max_tokens" class="col-3 o_light_label"/>
                <field name="chatbot_max_tokens"/>
              </div>
              <div class="row">
                <label for="chatbot_temperature" class="col-3 o_light_label"/>
                <field name="chatbot_temperature"/>
              </div>
              <div class="row">
                <label for="web_search_enabled" class="col-3 o_light_label"/>
                <field name="web_search_enabled"/>
              </div>
              <div class="content-group mt8">
                <small class="text-muted">
                  Chatbot sẽ tìm kiếm sản phẩm trong kho và web search khi không tìm thấy.
                </small>
              </div>
            </div>
          </setting>
        </block>
      </xpath>

    </field>
  </record>
</odoo>
