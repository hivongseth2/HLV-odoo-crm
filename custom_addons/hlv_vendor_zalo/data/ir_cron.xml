<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- AI đọc nhóm Zalo → đề xuất báo giá. Chạy cả khi tắt AI trong Cài đặt (hàm tự thoát ngay, không gọi API) —
         bật / tắt chỉ cần một chỗ là công tắc trong Cài đặt. -->
    <record id="cron_zalo_ai_read" model="ir.cron">
        <field name="name">Zalo NCC: AI đọc nhóm, soạn đề xuất báo giá</field>
        <field name="model_id" ref="model_hlv_zalo_ai"/>
        <field name="state">code</field>
        <field name="code">model._cron_read_groups()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
