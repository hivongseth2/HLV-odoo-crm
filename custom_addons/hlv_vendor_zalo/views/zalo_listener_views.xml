<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zalo_listener_list" model="ir.ui.view">
        <field name="name">hlv.zalo.listener.list</field>
        <field name="model">hlv.zalo.listener</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false"
                  decoration-danger="is_stale or state == 'kicked'" decoration-warning="state in ('reconnecting', 'login_wait')">
                <field name="name"/>
                <field name="state"/>
                <field name="is_stale"/>
                <field name="last_seen_at"/>
                <field name="connected_since"/>
                <field name="drops_today"/>
                <field name="last_close_code"/>
                <field name="last_close_at"/>
                <field name="outbox"/>
                <field name="last_error" optional="show"/>
                <field name="version" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_zalo_listener" model="ir.actions.act_window">
        <field name="name">Máy nghe Zalo</field>
        <field name="res_model">hlv.zalo.listener</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Máy nghe chưa báo về lần nào</p>
            <p>Kiểm khoá máy nghe (Cài đặt → Hỏi giá NCC) và file .env của máy nghe.</p>
        </field>
    </record>
</odoo>
