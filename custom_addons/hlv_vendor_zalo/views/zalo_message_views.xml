<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zalo_message_list" model="ir.ui.view">
        <field name="name">hlv.zalo.message.list</field>
        <field name="model">hlv.zalo.message</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" decoration-info="member_kind == 'vendor'" decoration-muted="is_self">
                <field name="sent_at"/>
                <field name="group_id"/>
                <field name="member_id"/>
                <field name="member_kind" optional="hide"/>
                <field name="kind"/>
                <field name="quote_text" string="Trả lời" optional="show"/>
                <field name="body"/>
                <field name="media_title" optional="show"/>
                <field name="media_state" optional="hide"/>
                <field name="partner_id" optional="hide"/>
                <field name="ai_read" optional="show"/>
                <field name="is_self" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_zalo_message_form" model="ir.ui.view">
        <field name="name">hlv.zalo.message.form</field>
        <field name="model">hlv.zalo.message</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="group_id"/>
                            <field name="partner_id"/>
                            <field name="member_id"/>
                            <field name="member_kind"/>
                            <field name="sent_at"/>
                        </group>
                        <group>
                            <field name="kind"/>
                            <field name="msg_type"/>
                            <field name="msg_id"/>
                            <field name="is_self"/>
                        </group>
                    </group>
                    <group string="Trả lời tin" invisible="not quote_msg_id">
                        <field name="quote_sender"/>
                        <field name="quote_text"/>
                        <field name="quote_message_id"/>
                        <field name="quote_msg_id" invisible="1"/>
                    </group>
                    <group string="Nội dung">
                        <field name="body" nolabel="1" colspan="2"/>
                        <field name="mention_ids" widget="many2many_tags" invisible="not mention_ids"/>
                    </group>
                    <group string="File / ảnh" invisible="media_state == 'none'">
                        <field name="media_title"/>
                        <field name="media_state"/>
                        <field name="attachment_ids" widget="many2many_binary"/>
                        <field name="media_url" widget="url"/>
                    </group>
                    <group string="Thả cảm xúc" invisible="not reaction_ids">
                        <field name="reaction_ids" nolabel="1" colspan="2">
                            <list>
                                <field name="reacted_at"/>
                                <field name="member_id"/>
                                <field name="label"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_zalo_message_search" model="ir.ui.view">
        <field name="name">hlv.zalo.message.search</field>
        <field name="model">hlv.zalo.message</field>
        <field name="arch" type="xml">
            <search>
                <field name="body"/>
                <field name="group_id"/>
                <field name="partner_id"/>
                <field name="member_id"/>
                <filter name="from_vendor" string="Người của NCC gửi" domain="[('member_kind', '=', 'vendor')]"/>
                <filter name="from_staff" string="Nhân viên mình gửi" domain="[('member_kind', '=', 'staff')]"/>
                <filter name="with_media" string="Có ảnh / file" domain="[('media_state', '!=', 'none')]"/>
                <filter name="media_missing" string="File chưa về" domain="[('media_state', 'in', ('waiting', 'failed'))]"/>
                <filter name="ai_unread" string="AI chưa đọc" domain="[('ai_read', '=', False)]"/>
                <separator/>
                <filter name="today" string="Hôm nay" domain="[('sent_at', '&gt;=', (context_today()).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="by_group" string="Nhóm" context="{'group_by': 'group_id'}"/>
                    <filter name="by_member" string="Người gửi" context="{'group_by': 'member_id'}"/>
                    <filter name="by_day" string="Ngày" context="{'group_by': 'sent_at:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_zalo_message" model="ir.actions.act_window">
        <field name="name">Tin Zalo nhóm NCC</field>
        <field name="res_model">hlv.zalo.message</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_zalo_message_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa có tin nào</p>
            <p>Máy nghe gửi tin về đây. Nhóm mới hiện ở menu "Nhóm Zalo" — gắn NCC rồi bật "Ghi tin" thì tin mới được lưu.</p>
        </field>
    </record>
</odoo>
