<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.product.crawler</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Product Crawler" string="Product Crawler" data-key="hlv_product_crawler">
                    <h2>AI Quality Control (Mr. GPT)</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">OpenAI Integration</span>
                                <div class="text-muted">
                                    Configure OpenAI API to enable AI Verification.
                                </div>
                                <div class="content-group mt16">
                                    <label for="product_crawler_openai_api_key" class="o_light_label"/>
                                    <field name="product_crawler_openai_api_key" password="True"/>
                                </div>
                                <div class="content-group mt16">
                                    <label for="product_crawler_openai_model" class="o_light_label"/>
                                    <field name="product_crawler_openai_model"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
