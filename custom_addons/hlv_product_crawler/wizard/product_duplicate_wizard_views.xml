<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_duplicate_wizard_form" model="ir.ui.view">
        <field name="name">product.duplicate.wizard.form</field>
        <field name="model">product.duplicate.wizard</field>
        <field name="arch" type="xml">
            <form string="Tìm sản phẩm trùng lặp">
                <sheet>
                    <group>
                        <field name="product_id" readonly="1"/>
                    </group>
                    <label for="duplicate_line_ids" string="Sản phẩm có khả năng trùng lặp"/>
                    <field name="duplicate_line_ids">
                        <tree create="false" delete="false" editable="bottom">
                            <field name="score" widget="progressbar"/>
                            <field name="candidate_product_id"/>
                            <field name="reason"/>
                            <button name="action_view_product" string="Xem" type="object" icon="fa-external-link"/>
                        </tree>
                    </field>
                </sheet>
                <footer>
                    <button string="Đóng" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_check_duplicates" model="ir.actions.act_window">
        <field name="name">🔍 Kiểm tra trùng lặp</field>
        <field name="res_model">product.duplicate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">form</field>
    </record>
</odoo>
