<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree view for duplicate lines -->
    <record id="view_product_duplicate_line_tree" model="ir.ui.view">
        <field name="name">product.duplicate.line.tree</field>
        <field name="model">product.duplicate.line</field>
        <field name="arch" type="xml">
            <list create="false" delete="false" edit="false" 
                  decoration-success="ai_verdict == 'different'" 
                  decoration-danger="ai_verdict == 'duplicate'">
                <field name="score" widget="progressbar"/>
                <field name="candidate_product_id"/>
                <field name="ai_verdict" widget="badge" 
                       decoration-success="ai_verdict == 'different'"
                       decoration-danger="ai_verdict == 'duplicate'"
                       decoration-muted="ai_verdict == 'not_checked'"/>
                <field name="reason"/>
                <button name="action_view_product" string="Xem" type="object" icon="fa-external-link"/>
                <button name="action_archive_wizard_product" string="Lưu trữ" type="object" icon="fa-archive" 
                    confirm="Bạn có chắc muốn lưu trữ sản phẩm GỐC (đang mở) không?"
                    class="btn-warning"/>
            </list>
        </field>
    </record>

    <!-- Form view for wizard -->
    <record id="view_product_duplicate_wizard_form" model="ir.ui.view">
        <field name="name">product.duplicate.wizard.form</field>
        <field name="model">product.duplicate.wizard</field>
        <field name="arch" type="xml">
            <form string="Tìm sản phẩm trùng lặp">
                <sheet>
                    <group>
                        <field name="product_id" readonly="1"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <strong>💡 Gợi ý:</strong> Danh sách chỉ hiển thị tối đa 15 sản phẩm giống nhất (≥70%). 
                        Bấm "🤖 AI Check Tất Cả" để phân biệt chính xác hơn.
                    </div>
                    <label for="duplicate_line_ids" string="Sản phẩm có khả năng trùng lặp"/>
                    <field name="duplicate_line_ids" readonly="1"/>
                    <div class="mt-3">
                        <button name="action_batch_ai_verify" string="🤖 AI Check Tất Cả" type="object" class="btn-primary" help="Dùng AI kiểm tra tất cả sản phẩm trong danh sách"/>
                        <button name="action_archive_selected" string="🗑️ Lưu trữ SP TRÙNG (theo AI)" type="object" class="btn-warning ml-2" help="Lưu trữ tất cả sản phẩm mà AI đánh giá là TRÙNG"/>
                    </div>
                </sheet>
                <footer>
                    <button string="Đóng" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Clean up old act_window if exists (to avoid Duplicate Action or ParseError) -->
    <delete model="ir.actions.act_window" search="[('res_model', '=', 'product.duplicate.wizard')]"/>

    <record id="action_check_duplicates_server" model="ir.actions.server">
        <field name="name">🔍 Kiểm tra trùng lặp</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">action = record.action_check_duplicates()</field>
    </record>
</odoo>
