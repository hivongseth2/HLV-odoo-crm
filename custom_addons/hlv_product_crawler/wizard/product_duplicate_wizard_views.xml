<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree view for duplicate lines -->
    <record id="view_product_duplicate_line_tree" model="ir.ui.view">
        <field name="name">product.duplicate.line.tree</field>
        <field name="model">product.duplicate.line</field>
        <field name="arch" type="xml">
            <list create="false" delete="false" edit="false">
                <field name="score" widget="progressbar"/>
                <field name="candidate_product_id"/>
                <field name="reason"/>
                <button name="action_view_product" string="Xem" type="object" icon="fa-external-link"/>
                <button name="action_copy_specs_from_candidate" string="Lấy thông số" type="object" icon="fa-copy" 
                    confirm="Bạn có chắc muốn chép đè thông số từ sản phẩm này sang sản phẩm đang mở không?"
                    class="btn-primary"/>
                <button name="action_archive_wizard_product" string="Lưu trữ SP gốc" type="object" icon="fa-archive" 
                    confirm="Bạn có chắc muốn lưu trữ sản phẩm GỐC (đang mở) không?"
                    class="btn-warning"/>
            </list>
        </field>
    </record>

    <!-- Form view for wizard -->
    <record id="view_product_duplicate_wizard_form" model="ir.ui.view">
        <field name="name">product.duplicate.wizard.form</field>
        <field name="model">product.duplicate.wizard</field>
        <field name="arch" type="xml">
            <form string="Tìm sản phẩm trùng lặp">
                <sheet>
                    <group>
                        <field name="product_id" readonly="1"/>
                    </group>
                    <label for="duplicate_line_ids" string="Sản phẩm có khả năng trùng lặp"/>
                    <field name="duplicate_line_ids" readonly="1"/>
                </sheet>
                <footer>
                    <button string="Đóng" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Clean up old act_window if exists (to avoid Duplicate Action or ParseError) -->
    <delete model="ir.actions.act_window" search="[('res_model', '=', 'product.duplicate.wizard')]"/>

    <record id="action_check_duplicates_server" model="ir.actions.server">
        <field name="name">🔍 Kiểm tra trùng lặp</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">action = record.action_check_duplicates()</field>
    </record>
</odoo>
