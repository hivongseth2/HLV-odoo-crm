<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_restrict_warehouse_view" model="res.groups">
            <field name="name">Limit Warehouse Access (Giới hạn xem kho)</field>
            <field name="category_id" ref="base.module_category_inventory_inventory"/>
        </record>

        <record id="rule_restrict_warehouse_view" model="ir.rule">
            <field name="name">Stock Warehouse: Restrict by User Config</field>
            <field name="model_id" ref="stock.model_stock_warehouse"/>
            <field name="domain_force">['|', ('id', 'in', user.allowed_warehouse_ids.ids), ('id', '!=', False) if not user.allowed_warehouse_ids else ('id', '=', -1)]</field>
            <field name="domain_force">[('id', 'in', user.allowed_warehouse_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_restrict_warehouse_view'))]"/>
        </record>
    </data>
</odoo>