<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_warehouse_dashboard_kanban" model="ir.ui.view">
        <field name="name">stock.warehouse.dashboard.kanban</field>
        <field name="model">stock.warehouse</field>
        <field name="arch" type="xml">
            <kanban create="0" class="o_kanban_dashboard">
                <field name="id"/>
                <field name="name"/>
                <field name="warehouse_dashboard_data"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="d-flex flex-column h-100 shadow-sm border rounded">
                            
                            <div class="o_kanban_card_header p-3 bg-light border-bottom">
                                <a type="object" name="open_warehouse_operations" 
                                   class="fw-bold text-uppercase text-dark text-decoration-none d-block">
                                    <h5 class="mb-0 text-primary"><i class="fa fa-building-o me-2"/> <field name="name"/></h5>
                                </a>
                            </div>

                            <div class="p-0 flex-grow-1 bg-white">
                                <t t-set="raw_data" t-value="JSON.parse(record.warehouse_dashboard_data.value || '{}')"/>
                                <t t-set="ops_data" t-value="raw_data.operations || []"/>
                                <t t-set="misa_data" t-value="raw_data.misa || {total: 0, full: 0, partial: 0, not_full: 0}"/>
                                
                                <div class="list-group list-group-flush" style="max-height: 350px; overflow-y: auto;">
                                    <t t-foreach="ops_data" t-as="op">
                                        <div class="list-group-item p-2 border-bottom-0 border-top">
                                            
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <a type="object" name="open_picking_type_view" 
                                                   t-att-context="'{&quot;picking_type_id&quot;: ' + op.id + ', &quot;view_type&quot;: &quot;all&quot;}'"
                                                   class="fw-bold text-dark text-decoration-none text-truncate" 
                                                   style="font-size: 1rem; max-width: 60%;">
                                                    <t t-esc="op.name"/>
                                                </a>

                                                <a t-if="op.count_ready > 0" 
                                                   type="object" name="open_picking_type_view"
                                                   t-att-context="'{&quot;picking_type_id&quot;: ' + op.id + ', &quot;view_type&quot;: &quot;ready&quot;}'" 
                                                   t-attf-class="btn btn-sm #{op.btn_color} text-white fw-bold rounded-pill px-3 shadow-sm d-flex align-items-center">
                                                    <span class="me-1 opacity-75 small" style="font-size: 0.75rem;">Cần làm:</span> 
                                                    <span><t t-esc="op.count_ready"/></span>
                                                </a>
                                            </div>

                                            <div class="d-flex flex-wrap align-items-center gap-2">
                                                <a t-if="op.count_late > 0" 
                                                   type="object" name="open_picking_type_view"
                                                   t-att-context="'{&quot;picking_type_id&quot;: ' + op.id + ', &quot;view_type&quot;: &quot;late&quot;}'"
                                                   class="badge rounded-pill text-bg-danger text-decoration-none border border-danger fw-normal px-2">
                                                    Trễ: <t t-esc="op.count_late"/>
                                                </a>
                                                <a t-if="op.count_waiting > 0" 
                                                   type="object" name="open_picking_type_view"
                                                   t-att-context="'{&quot;picking_type_id&quot;: ' + op.id + ', &quot;view_type&quot;: &quot;waiting&quot;}'"
                                                   class="badge rounded-pill text-bg-warning text-decoration-none border border-warning fw-normal px-2">
                                                    Chờ: <t t-esc="op.count_waiting"/>
                                                </a>
                                                <a t-if="op.count_draft > 0" 
                                                   type="object" name="open_picking_type_view"
                                                   t-att-context="'{&quot;picking_type_id&quot;: ' + op.id + ', &quot;view_type&quot;: &quot;draft&quot;}'"
                                                   class="badge rounded-pill bg-light text-dark border text-decoration-none fw-normal px-2">
                                                    Nháp: <t t-esc="op.count_draft"/>
                                                </a>
                                                <a type="object" name="open_picking_type_view"
                                                   t-att-context="'{&quot;picking_type_id&quot;: ' + op.id + ', &quot;view_type&quot;: &quot;done&quot;}'"
                                                   class="text-success text-decoration-none ms-auto small">
                                                    <i class="fa fa-check"/> Xong
                                                </a>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                                
                                <div t-if="ops_data.length === 0" class="text-center text-muted py-3 small">
                                    Chưa có cấu hình hoạt động
                                </div>

                                <div class="bg-primary bg-opacity-10 border-top p-2 mt-auto">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="fw-bold text-primary small text-uppercase">
                                            <i class="fa fa-calendar-check-o me-1"/>Đơn MISA hôm nay
                                        </span>
                                        <a type="object" name="open_misa_sale_orders"
                                           context="{'misa_filter': 'all'}"
                                           class="badge bg-primary text-decoration-none" title="Xem tất cả đơn hôm nay">
                                            Tổng: <t t-esc="misa_data.total"/>
                                        </a>
                                    </div>

                                    <div class="row g-2 text-center" style="font-size: 0.8rem;">
                                        <div class="col-4">
                                            <a type="object" name="open_misa_sale_orders"
                                               context="{'misa_filter': 'full'}"
                                               class="d-block p-1 rounded bg-success text-white text-decoration-none fw-bold shadow-sm opacity-75 hover-opacity-100">
                                                <div class="small fw-normal">Đã xong</div>
                                                <div class="fs-6"><t t-esc="misa_data.full"/></div>
                                            </a>
                                        </div>
                                        <div class="col-4">
                                            <a type="object" name="open_misa_sale_orders"
                                               context="{'misa_filter': 'partial'}"
                                               class="d-block p-1 rounded bg-warning text-dark text-decoration-none fw-bold shadow-sm opacity-75 hover-opacity-100">
                                                <div class="small fw-normal">1 Phần</div>
                                                <div class="fs-6"><t t-esc="misa_data.partial"/></div>
                                            </a>
                                        </div>
                                        <div class="col-4">
                                            <a type="object" name="open_misa_sale_orders"
                                               context="{'misa_filter': 'not_full'}"
                                               class="d-block p-1 rounded bg-danger text-white text-decoration-none fw-bold shadow-sm opacity-75 hover-opacity-100">
                                                <div class="small fw-normal">Tồn</div>
                                                <div class="fs-6"><t t-esc="misa_data.not_full"/></div>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                                
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_warehouse_dashboard" model="ir.actions.act_window">
        <field name="name">Tổng quan Kho (Mới)</field>
        <field name="res_model">stock.warehouse</field>
        <field name="view_mode">kanban,form</field>
        <field name="view_id" ref="view_warehouse_dashboard_kanban"/>
    </record>

    <menuitem id="menu_warehouse_dashboard_combined"
              name="Tổng quan kho (Mới)"
              parent="stock.menu_stock_root"
              action="action_warehouse_dashboard"
              sequence="0"/>
</odoo>