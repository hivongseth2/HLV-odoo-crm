<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_warehouse_dashboard_kanban" model="ir.ui.view">
        <field name="name">stock.warehouse.dashboard.kanban</field>
        <field name="model">stock.warehouse</field>
        <field name="arch" type="xml">
            <kanban create="0" class="o_kanban_dashboard" 
                    action="open_warehouse_operations" type="object" 
                    default_order="name asc">
                
                <field name="id"/>
                <field name="name"/>
                <field name="warehouse_dashboard_data"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="d-flex flex-column h-100 shadow-sm border rounded overflow-hidden bg-white hover-shadow transition-base">
                            
                            <div class="p-3 bg-light border-bottom text-center">
                                <h4 class="mb-0 fw-bold text-dark text-uppercase" style="letter-spacing: 0.5px;">
                                    <i class="fa fa-building-o me-2 text-muted"/>
                                    <field name="name"/>
                                </h4>
                            </div>

                            <div class="flex-grow-1 d-flex flex-column justify-content-center p-3">
                                <t t-set="raw_data" t-value="JSON.parse(record.warehouse_dashboard_data.value || '{}')"/>
                                <t t-set="misa_data" t-value="raw_data.misa || {total: 0, not_printed: 0, printed: 0}"/>

                                <div class="d-flex justify-content-center align-items-center mb-3">
                                    <span class="text-uppercase fs-6 text-muted fw-bold small">
                                        Phiếu xuất hôm nay
                                    </span>
                                    <a type="object" name="open_misa_pickings" context="{'misa_filter': 'all'}"
                                       class="badge bg-secondary ms-2 rounded-pill px-2 text-decoration-none">
                                        <t t-esc="misa_data.total"/>
                                    </a>
                                </div>

                                <div class="row g-0 text-center">
                                    
                                    <div class="col-6 border-end">
                                        <a type="object" name="open_misa_pickings" context="{'misa_filter': 'not_printed'}"
                                           class="d-block text-decoration-none py-2 px-1 hover-zoom">
                                            <div class="display-6 fw-bold text-danger mb-0" style="line-height: 1;">
                                                <t t-esc="misa_data.not_printed"/>
                                            </div>
                                            <small class="text-muted fw-bold text-uppercase" style="font-size: 0.7rem;">
                                                <i class="fa fa-print me-1"/>Chưa in
                                            </small>
                                        </a>
                                    </div>

                                    <div class="col-6">
                                        <a type="object" name="open_misa_pickings" context="{'misa_filter': 'printed'}"
                                           class="d-block text-decoration-none py-2 px-1 hover-zoom">
                                            <div class="display-6 fw-bold text-success mb-0" style="line-height: 1;">
                                                <t t-esc="misa_data.printed"/>
                                            </div>
                                            <small class="text-muted fw-bold text-uppercase" style="font-size: 0.7rem;">
                                                <i class="fa fa-check me-1"/>Đã in
                                            </small>
                                        </a>
                                    </div>

                                </div>
                            </div>
                            <div class="bg-light p-1 border-top"></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <record id="action_warehouse_dashboard" model="ir.actions.act_window">
        <field name="name">Tổng quan Kho (Mới)</field>
        <field name="res_model">stock.warehouse</field>
        <field name="view_mode">kanban,form</field>
        <field name="view_id" ref="view_warehouse_dashboard_kanban"/>
    </record>

    <menuitem id="menu_warehouse_dashboard_combined"
              name="Tổng quan (Mới)"
              parent="stock.menu_stock_root"
              action="action_warehouse_dashboard"
              sequence="1"/>
</odoo>
</odoo>