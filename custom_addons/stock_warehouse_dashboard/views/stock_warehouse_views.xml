<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_warehouse_dashboard_kanban" model="ir.ui.view">
        <field name="name">stock.warehouse.dashboard.kanban</field>
        <field name="model">stock.warehouse</field>
        <field name="arch" type="xml">
            <kanban create="0" class="o_kanban_dashboard">
                <field name="id"/>
                <field name="name"/>
                <field name="warehouse_dashboard_data"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="d-flex flex-column h-100 shadow-sm border rounded">
                            
                            <div class="o_kanban_card_header p-3 bg-light border-bottom">
                                <a type="object" name="open_warehouse_operations" 
                                   class="fw-bold text-uppercase text-dark text-decoration-none d-block">
                                    <h5 class="mb-0 text-primary"><field name="name"/></h5>
                                </a>
                            </div>

                            <div class="p-0 flex-grow-1 bg-white">
                                <t t-set="dashboard_data" t-value="JSON.parse(record.warehouse_dashboard_data.value || '[]')"/>
                                
                                <div class="list-group list-group-flush">
                                    <t t-foreach="dashboard_data" t-as="op">
                                        <div class="list-group-item p-2">
                                            
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <a type="object" name="open_picking_type_view" 
                                                   t-att-context="'{&quot;picking_type_id&quot;: ' + op.id + ', &quot;view_type&quot;: &quot;all&quot;}'"
                                                   class="fw-bold text-dark text-decoration-none text-truncate" 
                                                   style="font-size: 1.05rem; max-width: 65%;">
                                                    <t t-esc="op.name"/>
                                                </a>

                                                <a t-if="op.count_ready > 0" 
                                                   type="object" name="open_picking_type_view"
                                                   t-att-context="'{&quot;picking_type_id&quot;: ' + op.id + ', &quot;view_type&quot;: &quot;ready&quot;}'" 
                                                   t-attf-class="btn btn-sm #{op.btn_color} text-white fw-bold rounded-pill px-3 shadow-sm d-flex align-items-center"
                                                   style="font-size: 0.85rem;">
                                                    <span class="me-1 opacity-75 small">Cần làm:</span> 
                                                    <span class="fs-6"><t t-esc="op.count_ready"/></span>
                                                </a>
                                            </div>

                                            <div class="d-flex flex-wrap align-items-center gap-2">
                                                
                                                <a t-if="op.count_late > 0" 
                                                   type="object" name="open_picking_type_view"
                                                   t-att-context="'{&quot;picking_type_id&quot;: ' + op.id + ', &quot;view_type&quot;: &quot;late&quot;}'"
                                                   class="badge rounded-pill text-bg-danger text-decoration-none py-2 px-3 border border-danger">
                                                    <i class="fa fa-clock-o me-1"/>Trễ: <t t-esc="op.count_late"/>
                                                </a>

                                                <a t-if="op.count_waiting > 0" 
                                                   type="object" name="open_picking_type_view"
                                                   t-att-context="'{&quot;picking_type_id&quot;: ' + op.id + ', &quot;view_type&quot;: &quot;waiting&quot;}'"
                                                   class="badge rounded-pill text-bg-warning text-decoration-none py-2 px-3 border border-warning">
                                                    Chờ: <t t-esc="op.count_waiting"/>
                                                </a>

                                                <a t-if="op.count_draft > 0" 
                                                   type="object" name="open_picking_type_view"
                                                   t-att-context="'{&quot;picking_type_id&quot;: ' + op.id + ', &quot;view_type&quot;: &quot;draft&quot;}'"
                                                   class="badge rounded-pill bg-light text-dark border text-decoration-none py-2 px-3">
                                                    Nháp: <t t-esc="op.count_draft"/>
                                                </a>

                                                <a type="object" name="open_picking_type_view"
                                                   t-att-context="'{&quot;picking_type_id&quot;: ' + op.id + ', &quot;view_type&quot;: &quot;done&quot;}'"
                                                   class="text-success text-decoration-none ms-auto small fw-bold">
                                                    <i class="fa fa-check"/> Xong
                                                </a>
                                            </div>

                                        </div>
                                    </t>
                                </div>
                                
                                <div t-if="dashboard_data.length === 0" class="text-center text-muted py-4">
                                    <span class="small">Chưa có hoạt động nào</span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_warehouse_dashboard" model="ir.actions.act_window">
        <field name="name">Tổng quan Kho</field>
        <field name="res_model">stock.warehouse</field>
        <field name="view_mode">kanban,form</field>
        <field name="view_id" ref="view_warehouse_dashboard_kanban"/>
    </record>

    <menuitem id="menu_warehouse_dashboard_combined"
              name="Tổng quan kho (Mới)"
              parent="stock.menu_stock_root"
              action="action_warehouse_dashboard"
              sequence="0"/>
</odoo>