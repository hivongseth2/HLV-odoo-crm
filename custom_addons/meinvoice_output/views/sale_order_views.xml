<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Smart button trên Sale Order form -->
    <record id="view_sale_order_form_meinvoice" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.meinvoice.output</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Smart button -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_meinvoice_invoices"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="meinvoice_invoice_count == 0">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="meinvoice_invoice_count"/>
                        </span>
                        <span class="o_stat_text">HĐ MISA</span>
                    </div>
                </button>
            </xpath>

            <!-- Badge trạng thái trên form -->
            <xpath expr="//field[@name='state']" position="after">
                <field name="meinvoice_invoiced"
                       widget="boolean_toggle"
                       invisible="meinvoice_invoice_count == 0"/>
            </xpath>

            <!-- Tab thông tin HĐ MISA trong notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="Hóa đơn MISA" name="meinvoice_page"
                      invisible="meinvoice_invoice_count == 0">
                    <group>
                        <group>
                            <field name="meinvoice_invoiced" readonly="1"/>
                            <field name="meinvoice_invoiced_date" readonly="1"
                                   invisible="not meinvoice_invoiced"/>
                        </group>
                    </group>
                    <field name="meinvoice_invoice_ids" readonly="1">
                        <list>
                            <field name="inv_date"    string="Ngày"/>
                            <field name="inv_no"      string="Số HĐ"/>
                            <field name="total_amount" string="Tổng tiền"/>
                            <field name="accounting_status" string="Hạch toán"
                                   widget="badge"
                                   decoration-success="accounting_status == '1'"
                                   decoration-muted="accounting_status == '0'"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

    <!-- Thêm cột vào Sale Order list view -->
    <record id="view_sale_order_list_meinvoice" model="ir.ui.view">
        <field name="name">sale.order.list.inherit.meinvoice.output</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_status']" position="after">
                <field name="meinvoice_invoiced"
                       string="HĐ MISA"
                       optional="show"
                       widget="boolean"/>
            </xpath>
        </field>
    </record>
</odoo>
