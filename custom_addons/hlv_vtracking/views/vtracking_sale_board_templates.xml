<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Trang tự dựng HTML thay vì dùng layout website: /sale_plan (trang sale đang dùng
         hằng ngày) cũng làm vậy, nên hai trang nhìn giống nhau và không kéo theo cả bộ
         asset của website cho một trang chỉ có bảng và bản đồ. -->
    <template id="sale_board_page" name="Kế hoạch giao hàng (sale)">
        &lt;!DOCTYPE html&gt;
        <html lang="vi">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>Kế hoạch giao hàng</title>
                <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/>
                <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/font-awesome@4.7.0/css/font-awesome.min.css"/>
                <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
                <link rel="stylesheet" href="/hlv_vtracking/static/src/sale_board/sale_board.css"/>
            </head>
            <body>
                <nav class="navbar navbar-expand-lg navbar-dark vt-navbar">
                    <div class="container-fluid">
                        <span class="navbar-brand"><i class="fa fa-truck me-2"/>Kế hoạch giao hàng</span>
                        <ul class="navbar-nav ms-auto flex-row gap-3">
                            <li class="nav-item"><a class="nav-link" href="/sale_plan">Tình trạng đơn</a></li>
                            <li class="nav-item"><a class="nav-link" href="/search_stock">Tồn kho</a></li>
                            <li class="nav-item">
                                <span class="nav-link text-white-50">
                                    <i class="fa fa-user me-1"/><t t-esc="user_name"/>
                                </span>
                            </li>
                        </ul>
                    </div>
                </nav>

                <div class="container-fluid py-3">
                    <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-vt-day="-1">
                            <i class="fa fa-chevron-left"/>
                        </button>
                        <input type="date" id="vt-date" class="form-control form-control-sm" style="width: 11rem"/>
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-vt-day="1">
                            <i class="fa fa-chevron-right"/>
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="vt-today">Hôm nay</button>
                        <span id="vt-summary" class="text-muted small ms-2"/>
                        <span id="vt-updated" class="text-muted small ms-auto"/>
                    </div>

                    <div class="row g-3">
                        <div class="col-lg-7">
                            <div id="vt-plans" class="vt-plans">
                                <div class="text-muted">Đang tải…</div>
                            </div>
                        </div>
                        <div class="col-lg-5">
                            <div id="vt-map" class="vt-map mb-3"/>
                            <div class="card mb-3">
                                <div class="card-header py-2 fw-bold">
                                    Đơn của tôi chưa được xếp chuyến
                                </div>
                                <div class="card-body p-0">
                                    <div id="vt-unplanned" class="vt-list"/>
                                </div>
                            </div>
                            <div class="card">
                                <div class="card-header py-2 fw-bold">Tôi đã nhờ AI</div>
                                <div class="card-body p-0">
                                    <div id="vt-requests" class="vt-list"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Hộp thoại gửi yêu cầu. Dựng sẵn trong trang, JS chỉ điền dữ liệu. -->
                <div class="modal fade" id="vt-request-modal" tabindex="-1">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Nhờ AI xếp lịch</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"/>
                            </div>
                            <div class="modal-body">
                                <div class="mb-2 small text-muted" id="vt-request-target"/>
                                <div class="mb-2">
                                    <label class="form-label small mb-1">Loại yêu cầu</label>
                                    <select id="vt-request-type" class="form-select form-select-sm">
                                        <option value="earlier">Xin giao sớm hơn</option>
                                        <option value="reschedule">Xin dời ngày / buổi khác</option>
                                        <option value="add">Xin xếp vào chuyến</option>
                                        <option value="remove">Xin gỡ khỏi chuyến</option>
                                        <option value="question">Hỏi ý kiến</option>
                                    </select>
                                </div>
                                <div class="row g-2 mb-2">
                                    <div class="col-7">
                                        <label class="form-label small mb-1">Ngày mong muốn</label>
                                        <input type="date" id="vt-request-date" class="form-control form-control-sm"/>
                                    </div>
                                    <div class="col-5">
                                        <label class="form-label small mb-1">Buổi</label>
                                        <select id="vt-request-session" class="form-select form-select-sm">
                                            <option value="">Không quan trọng</option>
                                            <option value="morning">Sáng</option>
                                            <option value="afternoon">Chiều</option>
                                        </select>
                                    </div>
                                </div>
                                <label class="form-label small mb-1">Nói rõ cho AI</label>
                                <textarea id="vt-request-message" class="form-control form-control-sm" rows="4"
                                          placeholder="Ví dụ: khách xin nhận sáng mai trước 10h, hàng đã đóng gói xong."/>
                                <div class="form-text">
                                    AI sẽ kiểm hàng, thủ tục và chỗ trống trên xe rồi trả lời ngay tại
                                    trang này. Kế hoạch đã chốt thì AI chỉ đề xuất, điều phối duyệt mới áp.
                                </div>
                                <div id="vt-request-error" class="text-danger small mt-2"/>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Thôi</button>
                                <button type="button" class="btn btn-primary btn-sm" id="vt-request-send">Gửi cho AI</button>
                            </div>
                        </div>
                    </div>
                </div>

                <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"/>
                <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"/>
                <script src="/hlv_vtracking/static/src/sale_board/sale_board_map.js"/>
                <script src="/hlv_vtracking/static/src/sale_board/sale_board.js"/>
            </body>
        </html>
    </template>

</odoo>
