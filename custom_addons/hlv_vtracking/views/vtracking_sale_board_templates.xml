<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Trang tự dựng HTML thay vì dùng layout website: /sale_plan (trang sale đang dùng
         hằng ngày) cũng làm vậy, nên hai trang nhìn giống nhau và không kéo theo cả bộ
         asset của website cho một trang chỉ có danh sách và bản đồ. -->
    <template id="sale_board_page" name="Kế hoạch giao hàng (sale)">
        &lt;!DOCTYPE html&gt;
        <html lang="vi">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>Kế hoạch giao hàng</title>
                <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/>
                <!-- Be Vietnam Pro vì nó vẽ riêng cho dấu tiếng Việt: ở cỡ 12-13px dấu không
                     chạm nhau như các font sans thông dụng. Lora chỉ dùng cho tiêu đề. -->
                <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"/>
                <link rel="stylesheet"
                      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&amp;family=Lora:wght@600&amp;display=swap"/>
                <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
                <link rel="stylesheet" href="/hlv_vtracking/static/src/sale_board/sale_board.css"/>
                <link rel="stylesheet" href="/hlv_vtracking/static/src/sale_board/sale_board_plans.css"/>
                <link rel="stylesheet" href="/hlv_vtracking/static/src/sale_board/sale_board_side.css"/>
            </head>
            <body>
                <nav class="navbar navbar-dark vt-navbar py-2">
                    <div class="container-fluid">
                        <span class="navbar-brand mb-0">Kế hoạch giao hàng</span>
                        <div class="d-flex align-items-center gap-3">
                            <a class="nav-link text-white-50" href="/sale_plan">Tình trạng đơn</a>
                            <a class="nav-link text-white-50" href="/search_stock">Tồn kho</a>
                            <span class="text-white-50 small"><t t-esc="user_name"/></span>
                        </div>
                    </div>
                </nav>

                <div class="container-fluid py-3">
                    <div class="vt-toolbar">
                        <button type="button" class="vt-btn" data-vt-day="-1" title="Ngày trước">‹</button>
                        <input type="date" id="vt-date" class="form-control form-control-sm"
                               style="width: 10.5rem"/>
                        <button type="button" class="vt-btn" data-vt-day="1" title="Ngày sau">›</button>
                        <button type="button" class="vt-btn" id="vt-today">Hôm nay</button>

                        <span class="vt-muted ms-2">Tôi là</span>
                        <select id="vt-saler" class="form-select form-select-sm" style="width: 11rem"
                                title="Cả phòng dùng chung một tài khoản, nên chọn mã sale MISA của bạn ở đây">
                            <option value="">— chọn mã sale —</option>
                        </select>

                        <div class="form-check form-switch mb-0 ms-1">
                            <input class="form-check-input" type="checkbox" id="vt-mine-only"/>
                            <label class="form-check-label vt-muted" for="vt-mine-only">
                                Chỉ chuyến có đơn của tôi
                            </label>
                        </div>

                        <button type="button" class="vt-btn vt-push" id="vt-open-drawer">
                            Tôi đã nhờ AI
                            <span class="vt-tag vt-tag-mine is-zero" id="vt-request-count">0</span>
                        </button>
                        <span id="vt-updated" class="vt-muted"/>
                    </div>

                    <!-- Ba con số của ngày. Trước đây nằm gọn trong một dòng chữ xám giữa
                         thanh công cụ, đọc phải dừng lại tìm — đây là thứ mở trang ra là muốn
                         thấy ngay. -->
                    <div class="vt-kpis">
                        <div class="vt-kpi">
                            <span class="vt-kpi-mark">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="1.7" stroke-linecap="round"
                                     stroke-linejoin="round" aria-hidden="true">
                                    <path d="M3 7h11v8H3z"/><path d="M14 10h4l3 3v2h-7z"/>
                                    <circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/>
                                </svg>
                            </span>
                            <span class="vt-kpi-text">
                                <span class="vt-kpi-num" id="vt-kpi-plans">0</span>
                                <small>chuyến giao trong ngày</small>
                            </span>
                        </div>
                        <div class="vt-kpi">
                            <span class="vt-kpi-mark">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="1.7" stroke-linecap="round"
                                     stroke-linejoin="round" aria-hidden="true">
                                    <path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11z"/>
                                    <circle cx="12" cy="10" r="2.5"/>
                                </svg>
                            </span>
                            <span class="vt-kpi-text">
                                <span class="vt-kpi-num" id="vt-kpi-stops">0</span>
                                <small>điểm giao, tổng các chuyến</small>
                            </span>
                        </div>
                        <div class="vt-kpi is-warn">
                            <span class="vt-kpi-mark">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="1.7" stroke-linecap="round"
                                     stroke-linejoin="round" aria-hidden="true">
                                    <path d="M6 3h9l4 4v14H6z"/><path d="M15 3v4h4"/>
                                    <path d="M9 13h6M9 17h4"/>
                                </svg>
                            </span>
                            <span class="vt-kpi-text">
                                <span class="vt-kpi-num" id="vt-kpi-unplanned">0</span>
                                <small>đơn của tôi chưa xếp chuyến</small>
                            </span>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-lg-7">
                            <h2 class="vt-h2">Các chuyến giao hàng</h2>
                            <div id="vt-plans" class="vt-plans">
                                <div class="vt-empty">Đang tải…</div>
                            </div>

                            <div class="vt-panel mt-3">
                                <div class="vt-panel-head">
                                    <h2 class="vt-h3">Đơn của tôi chưa xếp chuyến</h2>
                                    <span class="vt-count" id="vt-unplanned-count">0</span>
                                    <label class="vt-sr-only" for="vt-search">Tìm đơn</label>
                                    <input type="search" id="vt-search" class="vt-input vt-push"
                                           placeholder="Tìm số đơn, số phiếu, khách…"/>
                                </div>
                                <div class="vt-table-wrap">
                                    <table class="vt-orders">
                                        <thead>
                                            <tr>
                                                <th>Mã đơn</th>
                                                <th>Khách hàng</th>
                                                <th>Nơi giao</th>
                                                <th class="vt-nowrap">Hạn giao</th>
                                                <th/>
                                            </tr>
                                        </thead>
                                        <tbody id="vt-unplanned"/>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-5">
                            <div class="vt-side">
                                <!-- Bản đồ chỉ dựng khi đã chọn một chuyến: chưa chọn thì nó
                                     chỉ là một ô trống chiếm nửa màn hình, mà vẫn tải tile và
                                     vẽ lại mỗi 30 giây. Khung #vt-map phải nằm sẵn trong trang
                                     (Leaflet cần một thẻ có thật) nhưng được giữ ẩn. -->
                                <!-- Chưa chọn chuyến thì cột này KHÔNG bỏ trống: nó trả lời câu
                                     hỏi thường trực "xe đang ở đâu". Một ô trống nửa màn hình là
                                     thứ làm trang trông như hỏng. -->
                                <div id="vt-detail-empty" class="vt-detail-empty">
                                    <div class="vt-hint">
                                        <span class="vt-hint-mark">
                                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                                                 stroke="currentColor" stroke-width="1.6"
                                                 stroke-linecap="round" stroke-linejoin="round"
                                                 aria-hidden="true">
                                                <path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2z"/>
                                                <path d="M9 4v14M15 6v14"/>
                                            </svg>
                                        </span>
                                        <span class="vt-hint-title">Chưa chọn chuyến</span>
                                        <span class="vt-muted">Bấm một chuyến bên trái để xem lộ trình
                                            trên bản đồ và danh sách điểm giao.</span>
                                    </div>
                                    <div class="vt-panel">
                                        <div class="vt-panel-head">
                                            <h2 class="vt-h3">Đội xe hôm nay</h2>
                                            <span class="vt-muted">cập nhật mỗi 30 giây</span>
                                        </div>
                                        <div id="vt-fleet" class="vt-list"/>
                                    </div>
                                </div>
                                <div id="vt-detail" class="vt-detail is-hidden">
                                    <div id="vt-map" class="vt-map"/>
                                    <div class="vt-panel" id="vt-detail-panel"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Ngăn kéo "Tôi đã nhờ AI": câu trả lời của AI dài, để trong cột bên phải
                     thì chiếm hết chỗ của bản đồ. Mở khi cần đọc, đóng lại khi xong. -->
                <div class="offcanvas offcanvas-end vt-drawer" tabindex="-1" id="vt-drawer">
                    <div class="offcanvas-header">
                        <h5 class="offcanvas-title">Tôi đã nhờ AI</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"/>
                    </div>
                    <div class="offcanvas-body p-0">
                        <div id="vt-requests"/>
                    </div>
                </div>

                <!-- Xem nhanh một đơn bán / phiếu kho, bấm từ danh sách điểm. -->
                <div class="modal fade" id="vt-doc-modal" tabindex="-1">
                    <div class="modal-dialog modal-lg modal-dialog-scrollable">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="vt-doc-title">Chứng từ</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"/>
                            </div>
                            <div class="modal-body" id="vt-doc-body"/>
                        </div>
                    </div>
                </div>

                <!-- Hộp thoại gửi yêu cầu. Dựng sẵn trong trang, JS chỉ điền dữ liệu. -->
                <div class="modal fade" id="vt-request-modal" tabindex="-1">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Nhờ AI xem giúp</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"/>
                            </div>
                            <div class="modal-body">
                                <div class="vt-muted mb-2" id="vt-request-target"/>
                                <div class="mb-2">
                                    <label class="form-label small mb-1">Tôi muốn</label>
                                    <select id="vt-request-type" class="form-select form-select-sm">
                                        <option value="earlier">Xin giao sớm hơn</option>
                                        <option value="reschedule">Xin dời ngày / buổi khác</option>
                                        <option value="add">Xin xếp vào chuyến</option>
                                        <option value="remove">Xin gỡ khỏi chuyến</option>
                                        <option value="question">Hỏi ý kiến</option>
                                    </select>
                                </div>
                                <div class="row g-2 mb-2">
                                    <div class="col-7">
                                        <label class="form-label small mb-1">Ngày mong muốn</label>
                                        <input type="date" id="vt-request-date"
                                               class="form-control form-control-sm"/>
                                    </div>
                                    <div class="col-5">
                                        <label class="form-label small mb-1">Buổi</label>
                                        <select id="vt-request-session" class="form-select form-select-sm">
                                            <option value="">Không quan trọng</option>
                                            <option value="morning">Sáng</option>
                                            <option value="afternoon">Chiều</option>
                                        </select>
                                    </div>
                                </div>
                                <label class="form-label small mb-1">Nói rõ cho AI</label>
                                <textarea id="vt-request-message" class="form-control form-control-sm" rows="4"
                                          placeholder="Ví dụ: khách xin nhận sáng mai trước 10h, hàng đã đóng gói xong."/>
                                <div class="form-text">
                                    AI kiểm hàng, thủ tục và chỗ trống trên xe rồi trả lời ngay tại
                                    trang này. Quyết định cuối vẫn là của người điều phối.
                                </div>
                                <div id="vt-request-error" class="text-danger small mt-2"/>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="vt-btn" data-bs-dismiss="modal">Thôi</button>
                                <button type="button" class="vt-btn vt-btn-primary" id="vt-request-send">
                                    Gửi cho AI
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"/>
                <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"/>
                <script src="/hlv_vtracking/static/src/map/vtracking_polyline_codec.js"/>
                <script src="/hlv_vtracking/static/src/sale_board/sale_board_map.js"/>
                <script src="/hlv_vtracking/static/src/sale_board/sale_board.js"/>
            </body>
        </html>
    </template>

</odoo>
