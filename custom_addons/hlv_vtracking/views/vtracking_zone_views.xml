<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_vtracking_zone_list" model="ir.ui.view">
        <field name="name">hlv.vtracking.zone.list</field>
        <field name="model">hlv.vtracking.zone</field>
        <field name="arch" type="xml">
            <list string="Cụm tuyến" editable="bottom" decoration-info="calib_has_suggestion">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="warehouse_id"/>
                <field name="hub_to_first_minutes" string="Kho → điểm đầu"/>
                <field name="calib_hub_suggest" string="→ đề xuất" optional="show"/>
                <field name="median_leg_minutes" string="Điểm → điểm"/>
                <field name="calib_leg_suggest" string="→ đề xuất" optional="show"/>
                <field name="return_minutes" string="Về kho"/>
                <field name="calib_return_suggest" string="→ đề xuất" optional="show"/>
                <field name="calib_has_suggestion" column_invisible="True"/>
                <button name="action_apply_calibration" type="object" string="Áp dụng"
                        icon="fa-check" class="btn-link" invisible="not calib_has_suggestion"
                        confirm="Ghi các con số đề xuất vào định mức của cụm này?"/>
                <field name="max_stops" string="Trần điểm"/>
                <field name="min_stops_worth_trip" string="Tối thiểu"/>
                <field name="place_count" string="Số điểm"/>
                <field name="color" optional="hide"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_vtracking_zone_form" model="ir.ui.view">
        <field name="name">hlv.vtracking.zone.form</field>
        <field name="model">hlv.vtracking.zone</field>
        <field name="arch" type="xml">
            <form string="Cụm tuyến">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_places" type="object" class="oe_stat_button"
                                icon="fa-map-marker">
                            <field name="place_count" widget="statinfo" string="Điểm giao"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Nhơn Trạch"/></h1>
                    </div>
                    <group>
                        <group string="Nhận dạng">
                            <field name="code" placeholder="NT"/>
                            <field name="warehouse_id"/>
                            <field name="color" placeholder="#2563eb"/>
                            <field name="active"/>
                        </group>
                        <group string="Định mức thời gian">
                            <field name="hub_to_first_minutes"/>
                            <field name="median_leg_minutes"/>
                            <field name="return_minutes"/>
                            <field name="max_stops"/>
                            <field name="min_stops_worth_trip"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Định mức ở đây <strong>đè lên</strong> tốc độ trung bình chung của công
                        ty khi kế hoạch thuộc cụm này. Đó là chủ ý: đo từ chuyến thật chính xác
                        hơn hẳn suy ngược từ km — <em>kho → điểm đầu</em> đo được 40 phút với
                        Nhơn Trạch nhưng 57 phút với Long Thành, dùng một con số chung cho cả
                        hai là sai cả hai.
                        <br/>
                        Hệ thống tự đo lại các ô này mỗi ngày từ chuyến đã chạy — xem phần
                        <em>Học từ thực tế</em> bên dưới.
                    </div>

                    <group string="Học từ thực tế">
                        <div colspan="2" class="text-muted small">
                            Cron hằng ngày đọc các chuyến có số thực tế trong 60 ngày gần nhất
                            (giờ quét nhận hàng, giờ giao xong từng phiếu, GPS lúc xe về kho) và
                            tính trung vị. Chỉ ĐỀ XUẤT khi đủ 10 mẫu và lệch từ 2 phút trở lên —
                            không tự sửa định mức.
                        </div>
                        <group>
                            <field name="calib_hub_median" string="Kho → điểm đầu đo được"/>
                            <field name="calib_hub_count" string="Số mẫu"/>
                            <field name="calib_hub_suggest" string="Đề xuất"
                                   decoration-bf="calib_hub_suggest"/>
                        </group>
                        <group>
                            <field name="calib_leg_median" string="Điểm → điểm đo được"/>
                            <field name="calib_leg_count" string="Số mẫu"/>
                            <field name="calib_leg_suggest" string="Đề xuất"
                                   decoration-bf="calib_leg_suggest"/>
                        </group>
                        <group>
                            <field name="calib_return_median" string="Về kho đo được"/>
                            <field name="calib_return_count" string="Số mẫu"/>
                            <field name="calib_return_suggest" string="Đề xuất"
                                   decoration-bf="calib_return_suggest"/>
                        </group>
                        <group>
                            <field name="calib_plan_count"/>
                            <field name="calib_computed_at"/>
                            <field name="calib_applied_at"/>
                            <field name="calib_applied_by_id"/>
                            <field name="calib_applied_note"/>
                        </group>
                        <div colspan="2">
                            <field name="calib_has_suggestion" invisible="1"/>
                            <button name="action_apply_calibration" type="object"
                                    string="Áp dụng đề xuất" class="btn-primary"
                                    invisible="not calib_has_suggestion"
                                    confirm="Ghi các con số đề xuất vào định mức của cụm? Mọi kế hoạch nháp dùng cụm này sẽ tính lại giờ."/>
                            <button name="action_recalibrate_now" type="object"
                                    string="Tính lại ngay" class="btn-secondary ms-2"/>
                        </div>
                    </group>
                    <group>
                        <field name="note" placeholder="Ghi chú về cụm: đường khó, giờ kẹt xe…"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vtracking_zone" model="ir.actions.act_window">
        <field name="name">Cụm tuyến</field>
        <field name="res_model">hlv.vtracking.zone</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Khai cụm tuyến</p>
            <p>
                Cụm tuyến là nơi ở của định mức thời gian: kho → điểm đầu, điểm → điểm, về
                kho, trần điểm mỗi chuyến. Gán điểm giao vào cụm thì kế hoạch đi qua điểm đó
                sẽ tính theo định mức của cụm thay vì tốc độ trung bình chung.
            </p>
        </field>
    </record>

</odoo>
