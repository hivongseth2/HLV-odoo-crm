<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_vtracking_api_key_list" model="ir.ui.view">
        <field name="name">hlv.vtracking.api.key.list</field>
        <field name="model">hlv.vtracking.api.key</field>
        <field name="arch" type="xml">
            <list string="Khoá API">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="allow_write" widget="boolean_toggle"/>
                <field name="request_count"/>
                <field name="last_used_at"/>
                <field name="last_used_ip" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_vtracking_api_key_form" model="ir.ui.view">
        <field name="name">hlv.vtracking.api.key.form</field>
        <field name="model">hlv.vtracking.api.key</field>
        <field name="arch" type="xml">
            <form string="Khoá API">
                <header>
                    <button name="action_regenerate" type="object" string="Cấp lại khoá"
                            confirm="Ứng dụng đang dùng khoá cũ sẽ mất quyền ngay lập tức. Tiếp tục?"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Đã thu hồi" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Ví dụ: App giám sát đội xe (Android)"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="key" widget="CopyClipboardChar"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="allow_write"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="request_count"/>
                            <field name="last_used_at"/>
                            <field name="last_used_ip"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" placeholder="Ai giữ khoá này, dùng vào việc gì."/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <p class="mb-1"><strong>Cách gọi:</strong> gửi khoá ở header <code>X-API-Key</code>.</p>
                        <p class="mb-1"><code>GET /api/v1/fleet/vehicles</code> — danh sách xe đang theo dõi kèm vị trí gần nhất.</p>
                        <p class="mb-1"><code>GET /api/v1/fleet/vehicles/&lt;id&gt;/journey?date=YYYY-MM-DD</code> — hành trình một ngày.</p>
                        <p class="mb-0"><code>GET /api/v1/fleet/map-config</code> — nguồn tile để ứng dụng vẽ cùng nền bản đồ.</p>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vtracking_api_key" model="ir.actions.act_window">
        <field name="name">Khoá API</field>
        <field name="res_model">hlv.vtracking.api.key</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Tạo khoá cho ứng dụng đầu tiên</p>
            <p>
                Mỗi ứng dụng một khoá riêng. Ứng dụng nào rò rỉ thì thu hồi đúng khoá đó,
                không phải đổi khoá cho mọi nơi đang dùng.
            </p>
        </field>
    </record>

</odoo>
