<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_vtracking_position_list" model="ir.ui.view">
        <field name="name">hlv.vtracking.position.list</field>
        <field name="model">hlv.vtracking.position</field>
        <field name="arch" type="xml">
            <list string="Bản tin vị trí" create="0" edit="0">
                <field name="vehicle_id"/>
                <field name="ts"/>
                <field name="status"/>
                <field name="speed"/>
                <field name="geocoding"/>
                <field name="latitude" optional="hide"/>
                <field name="longitude" optional="hide"/>
                <field name="direction" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_vtracking_position_search" model="ir.ui.view">
        <field name="name">hlv.vtracking.position.search</field>
        <field name="model">hlv.vtracking.position</field>
        <field name="arch" type="xml">
            <search string="Bản tin vị trí">
                <field name="vehicle_id"/>
                <field name="geocoding"/>
                <filter name="today" string="Hôm nay"
                        domain="[('ts', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter name="moving" string="Đang chạy" domain="[('status', '=', 'run')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_vehicle" string="Xe" context="{'group_by': 'vehicle_id'}"/>
                    <filter name="group_day" string="Ngày" context="{'group_by': 'ts:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_vtracking_position" model="ir.actions.act_window">
        <field name="name">Lịch sử vị trí</field>
        <field name="res_model">hlv.vtracking.position</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_vtracking_position_search"/>
        <field name="context">{'search_default_group_vehicle': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa có bản tin nào</p>
            <p>
                Lịch sử được tác vụ nền kéo về mỗi đêm cho ngày hôm trước. Bảng này chỉ giữ
                dữ liệu trong thời hạn khai ở Cấu hình (mặc định 30 ngày).
            </p>
        </field>
    </record>

</odoo>
