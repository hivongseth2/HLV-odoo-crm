<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form RIÊNG cho res.company, chỉ có phần vTracking. Không inherit form công ty
         gốc: form đó là của module base, chèn thêm vào đấy sẽ hiện cấu hình vTracking
         cho mọi người mở thông tin công ty, kể cả người không liên quan đội xe. -->
    <record id="view_res_company_vtracking_form" model="ir.ui.view">
        <field name="name">res.company.vtracking.form</field>
        <field name="model">res.company</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Kết nối vTracking" create="0" delete="0">
                <header>
                    <button name="action_vtracking_test_connection" type="object"
                            string="Kiểm tra kết nối" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Kết nối vTracking">
                            <field name="vtracking_base_url" placeholder="https://171.229.16.202:8443"/>
                            <field name="vtracking_api_key" password="True"/>
                            <field name="vtracking_verify_ssl"/>
                            <field name="vtracking_expand_children"/>
                            <field name="vtracking_timeout"/>
                        </group>
                        <group string="Lưu trữ và bản đồ">
                            <field name="vtracking_retention_days"/>
                            <field name="vtracking_map_tile_url"/>
                            <field name="vtracking_map_attribution"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Chỉ xe bật <strong>"Theo dõi vTracking"</strong> mới được đồng bộ, mới
                        hiện trên bản đồ và mới trả ra API. Bật cờ đó ở
                        <em>V-Tracking &gt; Xe theo dõi</em>.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Server action vì res_id phải là công ty ĐANG đăng nhập, không cố định được
         trong XML. -->
    <record id="action_vtracking_settings" model="ir.actions.server">
        <field name="name">Kết nối vTracking</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_vtracking_settings()</field>
    </record>

</odoo>
