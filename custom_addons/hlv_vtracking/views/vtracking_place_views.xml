<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ Loại địa điểm ============ -->
    <record id="view_vtracking_place_type_list" model="ir.ui.view">
        <field name="name">hlv.vtracking.place.type.list</field>
        <field name="model">hlv.vtracking.place.type</field>
        <field name="arch" type="xml">
            <list string="Loại địa điểm" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="color" placeholder="#7c3aed"/>
                <field name="size"/>
                <field name="show_label"/>
                <field name="visible_by_default"/>
                <field name="place_count" string="Số địa điểm"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_vtracking_place_type" model="ir.actions.act_window">
        <field name="name">Loại địa điểm</field>
        <field name="res_model">hlv.vtracking.place.type</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Khai loại địa điểm</p>
            <p>
                Loại quyết định ghim hiện thế nào: màu, cỡ, có luôn hiện tên hay không.
                Đặt cỡ <strong>Lớn</strong> cho loại phải nhìn thấy ngay giữa hàng trăm
                ghim khác — thường là kho.
            </p>
        </field>
    </record>

    <!-- ============ Địa điểm ============ -->
    <record id="view_vtracking_place_list" model="ir.ui.view">
        <field name="name">hlv.vtracking.place.list</field>
        <field name="model">hlv.vtracking.place</field>
        <field name="arch" type="xml">
            <list string="Địa điểm" decoration-warning="geo_state == 'pending_review'"
                  decoration-danger="geo_state == 'failed'"
                  decoration-muted="geo_state == 'none'">
                <field name="name"/>
                <field name="type_id"/>
                <field name="zone_id" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="address_used" string="Địa chỉ tra" optional="show"/>
                <field name="geo_state"/>
                <field name="geo_source" optional="hide"/>
                <field name="latitude" optional="hide"/>
                <field name="longitude" optional="hide"/>
                <field name="has_coords" string="Có toạ độ" optional="hide"/>
                <button name="action_geocode_now" type="object" icon="fa-search-plus"
                        title="Tra lại toạ độ"/>
                <button name="action_confirm_geo" type="object" icon="fa-check"
                        title="Duyệt toạ độ" invisible="geo_state != 'pending_review'"/>
                <button name="action_open_gmaps" type="object" icon="fa-map-marker"
                        title="Mở Google Maps" invisible="not has_coords"/>
            </list>
        </field>
    </record>

    <record id="view_vtracking_place_form" model="ir.ui.view">
        <field name="name">hlv.vtracking.place.form</field>
        <field name="model">hlv.vtracking.place</field>
        <field name="arch" type="xml">
            <form string="Địa điểm">
                <header>
                    <button name="action_geocode_now" type="object" string="Tra toạ độ"
                            class="btn-primary" invisible="geo_state == 'manual'"/>
                    <button name="action_confirm_geo" type="object" string="Duyệt toạ độ"
                            class="btn-primary" invisible="geo_state != 'pending_review'"/>
                    <button name="action_open_gmaps" type="object" string="Mở Google Maps"
                            invisible="not has_coords"/>
                    <button name="action_seed_address_cache" type="object"
                            string="Mồi kho toạ độ"
                            invisible="geo_state not in ('confirmed', 'manual')"/>
                    <field name="geo_state" widget="statusbar"
                           statusbar_visible="none,pending_review,confirmed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Đã lưu trữ" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Tên hiện trên bản đồ"/></h1>
                    </div>
                    <group>
                        <group string="Phân loại">
                            <field name="type_id"/>
                            <field name="profile_id" invisible="1"/>
                            <field name="zone_id" options="{'no_create': True}"/>
                            <field name="partner_id" domain="[('is_company', '=', True)]"/>
                            <field name="partner_ref" readonly="1"/>
                            <field name="phone"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                        <group string="Toạ độ">
                            <field name="geo_source" readonly="1"/>
                            <field name="latitude" readonly="1"/>
                            <field name="longitude" readonly="1"/>
                            <field name="has_coords" readonly="1"/>
                            <field name="geo_checked_by_id" readonly="1"/>
                            <field name="geo_checked_at" readonly="1"/>
                        </group>
                    </group>
                    <group string="Thói quen giao hàng">
                        <field name="profile_ids" nolabel="1" colspan="2">
                            <list editable="bottom">
                                <field name="procedure_required"/>
                                <field name="delivery_method"/>
                                <field name="extra_service_minutes"/>
                                <field name="receiving_from" widget="float_time"/>
                                <field name="receiving_to" widget="float_time"/>
                                <field name="payment_method" optional="hide"/>
                                <field name="default_vehicle_id" optional="hide"
                                       options="{'no_create': True}"/>
                                <field name="free_note"/>
                            </list>
                        </field>
                        <div class="text-muted" colspan="2">
                            Một điểm chỉ khai được MỘT bộ thói quen. Khai "Thủ tục trước khi
                            giao" ở đây là kế hoạch chứa điểm này sẽ bị chặn cho tới khi người
                            điều phối xác nhận đã làm xong thủ tục.
                        </div>
                    </group>

                    <group string="Địa chỉ dùng để tra toạ độ">
                        <field name="address"
                               placeholder="Để trống thì ghép từ tên địa điểm và địa chỉ đối tác"/>
                        <field name="address_used" readonly="1"/>
                    </group>
                    <group string="Nhập toạ độ tay">
                        <div class="text-muted mb-2" colspan="2">
                            Máy tra trượt thì mở Google Maps, bấm chuột phải vào đúng chỗ,
                            copy cặp số rồi dán vào đây. Toạ độ nhập tay không bị máy đè lên.
                        </div>
                        <field name="geo_input" placeholder="10.78950, 106.99179"/>
                        <button name="action_save_manual_geo" type="object"
                                string="Lưu toạ độ đã dán" class="btn-secondary"/>
                    </group>
                    <group string="Kết quả máy trả về" invisible="not geo_raw_result">
                        <field name="geo_raw_result" nolabel="1" readonly="1"/>
                    </group>
                    <group>
                        <field name="note" placeholder="Ghi chú"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_vtracking_place_search" model="ir.ui.view">
        <field name="name">hlv.vtracking.place.search</field>
        <field name="model">hlv.vtracking.place</field>
        <field name="arch" type="xml">
            <search string="Địa điểm">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="type_id"/>
                <field name="zone_id"/>
                <filter name="no_zone" string="Chưa gán cụm" domain="[('zone_id', '=', False)]"/>
                <filter name="pending" string="Chờ duyệt toạ độ"
                        domain="[('geo_state', '=', 'pending_review')]"/>
                <filter name="failed" string="Máy không tìm được"
                        domain="[('geo_state', '=', 'failed')]"/>
                <filter name="no_geo" string="Chưa tra" domain="[('geo_state', '=', 'none')]"/>
                <separator/>
                <filter name="has_coords" string="Đã có toạ độ" domain="[('has_coords', '=', True)]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_type" string="Loại" context="{'group_by': 'type_id'}"/>
                    <filter name="group_zone" string="Cụm tuyến" context="{'group_by': 'zone_id'}"/>
                    <filter name="group_geo" string="Tình trạng toạ độ"
                            context="{'group_by': 'geo_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Thao tác hàng loạt: chọn nhiều điểm rồi mồi một lượt. Dùng sau khi nhập bản đồ,
         hoặc sau khi duyệt một loạt toạ độ. -->
    <record id="action_vtracking_place_seed_cache" model="ir.actions.server">
        <field name="name">Mồi kho toạ độ</field>
        <field name="model_id" ref="model_hlv_vtracking_place"/>
        <field name="binding_model_id" ref="model_hlv_vtracking_place"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_seed_address_cache()</field>
    </record>

    <record id="action_vtracking_place" model="ir.actions.act_window">
        <field name="name">Địa điểm</field>
        <field name="res_model">hlv.vtracking.place</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_vtracking_place_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa có địa điểm nào</p>
            <p>
                Tạo tay, hoặc dùng <em>Tạo địa điểm từ đối tác</em> để đưa hàng loạt công ty
                đối tác lên bản đồ một lần. Toạ độ do máy tra phải được <strong>duyệt</strong>
                trước khi tin dùng.
            </p>
        </field>
    </record>

    <!-- ============ Wizard tạo từ đối tác ============ -->
    <record id="view_vtracking_place_from_partner_form" model="ir.ui.view">
        <field name="name">hlv.vtracking.place.from.partner.form</field>
        <field name="model">hlv.vtracking.place.from.partner</field>
        <field name="arch" type="xml">
            <form string="Tạo địa điểm từ đối tác">
                <group>
                    <field name="type_id"/>
                    <field name="geocode_now"/>
                </group>
                <group>
                    <field name="partner_ids" widget="many2many_tags"
                           options="{'no_create': True}"
                           domain="[('is_company', '=', True)]"/>
                </group>
                <group>
                    <field name="to_create_count"/>
                    <field name="skip_existing_count"/>
                </group>
                <div class="alert alert-info" role="alert">
                    Đối tác đã có địa điểm thì bỏ qua, không tạo trùng. Toạ độ máy tra được
                    đánh dấu <strong>chờ duyệt</strong> — soát lại rồi mới dùng, vì địa chỉ
                    trong Odoo thường chỉ tới cấp phường.
                </div>
                <footer>
                    <button name="action_create_places" type="object" string="Tạo địa điểm"
                            class="btn-primary"/>
                    <button string="Huỷ" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_vtracking_place_from_partner" model="ir.actions.act_window">
        <field name="name">Tạo địa điểm từ đối tác</field>
        <field name="res_model">hlv.vtracking.place.from.partner</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
