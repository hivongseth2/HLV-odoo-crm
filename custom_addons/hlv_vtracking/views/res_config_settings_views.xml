<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Màn cấu hình riêng của module, không chèn vào trang Cài đặt chung: trang đó thuộc
         module khác và vị trí các khối trong đó đổi theo bản Odoo. -->
    <record id="view_vtracking_config_settings" model="ir.ui.view">
        <field name="name">hlv.vtracking.config.settings</field>
        <field name="model">res.config.settings</field>
        <field name="arch" type="xml">
            <form string="Cấu hình V-Tracking" class="oe_form_configuration">
                <header>
                    <button string="Lưu" type="object" name="execute" class="btn-primary"/>
                    <button string="Huỷ" type="object" name="cancel" class="btn-secondary"/>
                    <button string="Kiểm tra kết nối" type="object"
                            name="action_vtracking_test_connection"/>
                </header>
                <sheet>
                    <group string="Kết nối vTracking">
                        <field name="vtracking_base_url"/>
                        <field name="vtracking_api_key" password="True"/>
                        <field name="vtracking_verify_ssl"/>
                        <field name="vtracking_expand_children"/>
                        <field name="vtracking_timeout"/>
                    </group>
                    <group string="Lưu trữ">
                        <field name="vtracking_retention_days"/>
                    </group>
                    <group string="Bản đồ">
                        <field name="vtracking_map_tile_url"/>
                        <field name="vtracking_map_attribution"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Chỉ xe bật <strong>"Theo dõi vTracking"</strong> mới được đồng bộ, mới
                        hiện trên bản đồ và mới trả ra API. Bật cờ đó ở
                        <em>V-Tracking &gt; Xe theo dõi</em>.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vtracking_config_settings" model="ir.actions.act_window">
        <field name="name">Cấu hình V-Tracking</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="view_id" ref="view_vtracking_config_settings"/>
    </record>

</odoo>
