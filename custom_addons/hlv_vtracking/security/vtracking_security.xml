<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_vtracking" model="ir.module.category">
        <field name="name">V-Tracking</field>
        <field name="description">Theo dõi định vị đội xe qua vTracking Open API.</field>
        <field name="sequence">40</field>
    </record>

    <record id="group_vtracking_user" model="res.groups">
        <field name="name">Xem bản đồ đội xe</field>
        <field name="category_id" ref="module_category_vtracking"/>
        <field name="comment">Xem vị trí xe và lịch sử vị trí. Không sửa được cấu hình.</field>
    </record>

    <record id="group_vtracking_manager" model="res.groups">
        <field name="name">Quản trị V-Tracking</field>
        <field name="category_id" ref="module_category_vtracking"/>
        <field name="implied_ids" eval="[(4, ref('group_vtracking_user'))]"/>
        <field name="comment">Cấu hình kết nối vTracking, bật/tắt theo dõi xe, cấp khoá API.</field>
    </record>

    <!-- Gán quản trị viên vào nhóm quản trị ngay lúc cài, nếu không thì cài xong không ai
         thấy menu V-Tracking và không rõ vì sao. noupdate="1" để lần nâng cấp module sau
         không gán lại nhóm mà người ta đã cố ý bỏ. -->
    <data noupdate="1">
        <record id="base.user_admin" model="res.users">
            <field name="groups_id" eval="[(4, ref('hlv_vtracking.group_vtracking_manager'))]"/>
        </record>
    </data>

    <record id="rule_vtracking_position_company" model="ir.rule">
        <field name="name">Bản tin vị trí theo công ty</field>
        <field name="model_id" ref="model_hlv_vtracking_position"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record id="rule_vtracking_calibration_log_company" model="ir.rule">
        <field name="name">Nhật ký hiệu chỉnh theo công ty</field>
        <field name="model_id" ref="model_hlv_vtracking_calibration_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Người bán hàng chỉ thấy phiếu CỦA MÌNH; người điều phối thấy mọi phiếu của công
         ty. Ai ở cả hai nhóm thì thấy hợp của hai luật (Odoo OR các rule theo nhóm). -->
    <record id="rule_vtracking_ai_request_own" model="ir.rule">
        <field name="name">Yêu cầu AI: của tôi</field>
        <field name="model_id" ref="model_hlv_vtracking_ai_request"/>
        <field name="domain_force">[('requester_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="rule_vtracking_ai_request_company" model="ir.rule">
        <field name="name">Yêu cầu AI theo công ty</field>
        <field name="model_id" ref="model_hlv_vtracking_ai_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hlv_vtracking.group_vtracking_user'))]"/>
    </record>

    <record id="rule_vtracking_api_key_company" model="ir.rule">
        <field name="name">Khoá API theo công ty</field>
        <field name="model_id" ref="model_hlv_vtracking_api_key"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
