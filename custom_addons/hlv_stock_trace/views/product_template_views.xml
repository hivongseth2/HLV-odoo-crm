<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_stock_trace" model="ir.ui.view">
        <field name="name">product.template.form.stock.trace</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button class="oe_stat_button" type="object"
                        name="action_open_stock_trace" icon="fa-clock-o">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Trace tồn kho</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
