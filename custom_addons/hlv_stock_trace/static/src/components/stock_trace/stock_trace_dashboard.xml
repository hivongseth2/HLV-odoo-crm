<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="hlv_stock_trace.Dashboard" owl="1">
    <div class="o_hst_root">

      <div class="o_hst_topbar">
        <div>
          <h2 class="o_hst_title">Theo dõi tồn kho theo thời gian</h2>
          <div class="o_hst_product" t-if="productName" t-esc="productName"/>
        </div>
      </div>

      <div class="o_hst_controls">
        <span class="o_hst_label">Trace từ ngày</span>
        <input type="date" class="o_hst_date_input"
               t-att-value="state.dateFromInput"
               t-on-change="onDateInput"/>
        <span class="o_hst_muted">→ đến hiện tại</span>

        <span class="o_hst_sep"/>

        <div class="o_hst_chips">
          <button class="o_hst_chip" t-att-class="{ o_hst_chip_active: state.activeRangeMonths === 1 }"
                  t-on-click="() => this.setQuickRange(1)">1 tháng</button>
          <button class="o_hst_chip" t-att-class="{ o_hst_chip_active: state.activeRangeMonths === 3 }"
                  t-on-click="() => this.setQuickRange(3)">3 tháng</button>
          <button class="o_hst_chip" t-att-class="{ o_hst_chip_active: state.activeRangeMonths === 6 }"
                  t-on-click="() => this.setQuickRange(6)">6 tháng</button>
        </div>

        <span class="o_hst_sep"/>

        <span class="o_hst_label">Phạm vi</span>
        <button class="o_hst_scope_btn" t-att-class="{ o_hst_scope_active: state.scopeType === 'company' }"
                t-on-click="() => this.setScope('company', null, 'Toàn công ty')">
          Toàn công ty
        </button>

        <div class="o_hst_scope_wrap">
          <button class="o_hst_scope_btn" t-att-class="{ o_hst_scope_active: state.scopeType === 'warehouse' }"
                  t-on-click="() => this.togglePicker('warehouse')">
            <t t-if="state.scopeType === 'warehouse'" t-esc="state.scopeLabel"/>
            <t t-else="">Chọn 1 kho...</t>
          </button>
          <div class="o_hst_picker" t-if="state.pickerOpen === 'warehouse'">
            <div class="o_hst_picker_item" t-foreach="state.scopeOptions.warehouses" t-as="wh" t-key="wh.warehouse_id"
                 t-on-click="() => this.setScope('warehouse', wh.warehouse_id, wh.warehouse_name)">
              <t t-esc="wh.warehouse_name"/>
            </div>
            <div class="o_hst_picker_empty" t-if="!state.scopeOptions.warehouses.length">Không có kho nào</div>
          </div>
        </div>

        <div class="o_hst_scope_wrap">
          <button class="o_hst_scope_btn" t-att-class="{ o_hst_scope_active: state.scopeType === 'location' }"
                  t-on-click="() => this.togglePicker('location')">
            <t t-if="state.scopeType === 'location'" t-esc="state.scopeLabel"/>
            <t t-else="">Chọn 1 vị trí...</t>
          </button>
          <div class="o_hst_picker o_hst_picker_wide" t-if="state.pickerOpen === 'location'">
            <div class="o_hst_picker_item" t-foreach="state.scopeOptions.locations" t-as="loc" t-key="loc.location_id"
                 t-on-click="() => this.setScope('location', loc.location_id, loc.location_name)">
              <span t-esc="loc.location_name"/>
              <span class="o_hst_muted"> · <t t-esc="loc.warehouse_name"/></span>
            </div>
            <div class="o_hst_picker_empty" t-if="!state.scopeOptions.locations.length">Không có vị trí nào</div>
          </div>
        </div>

        <button class="o_hst_btn_primary" style="margin-left:auto;" t-on-click="reload">Trace</button>
      </div>

      <div class="o_hst_tabs">
        <div class="o_hst_tab" t-att-class="{ o_hst_tab_active: state.activeTab === 'daily' }"
             t-on-click="() => this.setTab('daily')">Theo ngày</div>
        <div class="o_hst_tab" t-att-class="{ o_hst_tab_active: state.activeTab === 'structure' }"
             t-on-click="() => this.setTab('structure')">Theo cơ cấu (kho &amp; vị trí)</div>
      </div>

      <div class="o_hst_error" t-if="state.error" t-esc="state.error"/>
      <div class="o_hst_loading" t-if="state.loading">
        <span class="o_hst_spinner"/> Đang tải dữ liệu...
      </div>

      <t t-if="!state.loading">

        <!-- ======================= TAB: THEO NGÀY ======================= -->
        <t t-if="state.activeTab === 'daily' and state.dailyData">
          <div class="o_hst_kpis">
            <div class="o_hst_kpi">
              <div class="o_hst_kpi_lbl">Tồn ngày <t t-esc="formatVN(state.dailyData.date_from)"/></div>
              <div class="o_hst_kpi_val" t-esc="formatQty(state.dailyData.opening)"/>
            </div>
            <div class="o_hst_kpi o_hst_kpi_accent">
              <div class="o_hst_kpi_lbl">Tồn hiện tại</div>
              <div class="o_hst_kpi_val" t-esc="formatQty(state.dailyData.closing)"/>
            </div>
            <div class="o_hst_kpi">
              <div class="o_hst_kpi_lbl">Số ngày có biến động</div>
              <div class="o_hst_kpi_val">
                <t t-esc="state.dailyData.days.length"/>
                <span style="font-size:13px;font-weight:500;color:#9aa0a8;">
                  / <t t-esc="daysBetween(state.dailyData.date_to, state.dailyData.date_from) + 1"/> ngày
                </span>
              </div>
            </div>
          </div>

          <div class="o_hst_section">
            <div class="o_hst_sec_title">Xu hướng số dư cuối ngày</div>
            <div class="o_hst_card" style="padding:20px 24px 12px;">
              <svg width="100%" height="176" viewBox="0 0 860 176" preserveAspectRatio="none" style="overflow:visible;"
                   t-if="chartGeometry">
                <line t-foreach="chartGeometry.gridLines" t-as="gy" t-key="gy_index"
                      x1="0" t-att-y1="gy" x2="820" t-att-y2="gy" stroke="#f0f1f3" stroke-width="1"/>
                <path t-att-d="chartGeometry.areaD" fill="#714B67" fill-opacity="0.06" stroke="none"/>
                <path t-att-d="chartGeometry.pathD" fill="none" stroke="#714B67" stroke-width="2.2" stroke-linejoin="round"/>
                <circle cx="0" t-att-cy="chartGeometry.startY" r="3.5" fill="#714B67"/>
                <circle t-foreach="chartGeometry.dots" t-as="dot" t-key="dot_index"
                        t-att-cx="dot.x" t-att-cy="dot.y" r="3.5"
                        t-attf-fill="{{dot.cls === 'o_hst_dot_up' ? '#1f9d5c' : (dot.cls === 'o_hst_dot_down' ? '#e0393e' : '#2559c9')}}"/>
                <circle cx="820" t-att-cy="chartGeometry.endY" r="4.5" fill="#fff" stroke="#714B67" stroke-width="2.5"/>
                <text x="0" y="162" font-size="11" fill="#9aa0a8" font-family="-apple-system,sans-serif" t-esc="formatVN(state.dailyData.date_from)"/>
                <text x="820" y="162" font-size="11" fill="#714B67" font-family="-apple-system,sans-serif" font-weight="700" text-anchor="end">Hôm nay</text>
              </svg>
            </div>
          </div>

          <div class="o_hst_section">
            <div class="o_hst_sec_title">Sổ cái theo ngày</div>
            <div class="o_hst_card">
              <div class="o_hst_ledger_grid o_hst_ledger_head">
                <div>Ngày</div>
                <div>Chuyển vào</div>
                <div>Chuyển ra</div>
                <div>Mua vào</div>
                <div>Bán ra</div>
                <div>Điều chỉnh</div>
                <div>Biến động</div>
                <div>Tồn cuối ngày</div>
                <div></div>
                <div></div>
              </div>

              <t t-foreach="ledgerEntries" t-as="entry" t-key="entry_index">

                <div class="o_hst_gap_row" t-if="entry.type === 'gap'">
                  <span>… <t t-esc="entry.count"/> ngày không biến động (<t t-esc="formatVN(entry.from)"/> – <t t-esc="formatVN(entry.to)"/>) …</span>
                </div>

                <div class="o_hst_ledger_grid o_hst_day_row" t-if="entry.type === 'opening'">
                  <div class="o_hst_day_date"><t t-esc="formatVN(entry.date)"/></div>
                  <div></div><div></div><div></div><div></div><div></div><div></div>
                  <div class="o_hst_day_bal"><t t-esc="formatQty(entry.balance)"/> Cái</div>
                  <div class="o_hst_day_badge">tồn đầu kỳ</div>
                  <div></div>
                </div>

                <t t-if="entry.type === 'day'">
                  <div class="o_hst_ledger_grid o_hst_day_row o_hst_row_clickable"
                       t-att-class="{ o_hst_day_expanded: state.expandedDay === entry.date }"
                       t-on-click="() => this.toggleDayExpand(entry.date)">
                    <div class="o_hst_day_date"><t t-esc="formatVN(entry.date)"/></div>
                    <div class="o_hst_day_num" t-att-class="entry.chuyen_vao ? 'o_hst_blue' : 'o_hst_dim'" t-esc="formatSigned(entry.chuyen_vao)"/>
                    <div class="o_hst_day_num" t-att-class="entry.chuyen_ra ? 'o_hst_blue' : 'o_hst_dim'" t-esc="formatSigned(-entry.chuyen_ra)"/>
                    <div class="o_hst_day_num" t-att-class="entry.mua ? 'o_hst_pos' : 'o_hst_dim'" t-esc="formatSigned(entry.mua)"/>
                    <div class="o_hst_day_num" t-att-class="entry.ban ? 'o_hst_neg' : 'o_hst_dim'" t-esc="formatSigned(-entry.ban)"/>
                    <div class="o_hst_day_num" t-att-class="entry.dieu_chinh > 0 ? 'o_hst_pos' : (entry.dieu_chinh &lt; 0 ? 'o_hst_neg' : 'o_hst_dim')" t-esc="formatSigned(entry.dieu_chinh)"/>
                    <div class="o_hst_day_net" t-att-class="entry.net > 0 ? 'o_hst_pos' : (entry.net &lt; 0 ? 'o_hst_neg' : 'o_hst_dim')"
                         t-esc="entry.net === 0 ? '± 0' : formatSigned(entry.net)"/>
                    <div class="o_hst_day_bal"><t t-esc="formatQty(entry.balance)"/> Cái</div>
                    <div class="o_hst_day_badge"><t t-esc="entry.ref_count"/> phiếu</div>
                    <div class="o_hst_day_chev" t-att-class="{ o_hst_chev_open: state.expandedDay === entry.date }">
                      <t t-if="state.expandedDay === entry.date">⌄</t><t t-else="">›</t>
                    </div>
                  </div>

                  <div class="o_hst_expand_panel" t-if="state.expandedDay === entry.date">
                    <div class="o_hst_dd_loading" t-if="state.dayDetailLoading">Đang tải...</div>
                    <t t-if="!state.dayDetailLoading and state.dayDetail">

                      <div class="o_hst_subtabs" t-if="state.dayDetail.locations_snapshot.length">
                        <div class="o_hst_subtab" t-att-class="{ o_hst_subtab_active: state.dayDetailTab === 'transactions' }"
                             t-on-click="() => this.setDayDetailTab('transactions')">Biến động từng vị trí</div>
                        <div class="o_hst_subtab" t-att-class="{ o_hst_subtab_active: state.dayDetailTab === 'snapshot' }"
                             t-on-click="() => this.setDayDetailTab('snapshot')">Tồn kho từng vị trí cuối ngày</div>
                      </div>

                      <table class="o_hst_loc_table"
                             t-if="!state.dayDetail.locations_snapshot.length or state.dayDetailTab === 'transactions'">
                        <thead>
                          <tr>
                            <th>Vị trí</th><th t-if="state.dailyData.scope_type === 'company'">Kho</th>
                            <th class="o_hst_num">Biến động</th><th>Phiếu</th>
                          </tr>
                        </thead>
                        <tbody>
                          <tr t-foreach="state.dayDetail.transactions" t-as="tx" t-key="tx_index">
                            <td><t t-esc="tx.location_name"/></td>
                            <td t-if="state.dailyData.scope_type === 'company'" t-esc="tx.warehouse_name"/>
                            <td class="o_hst_num" t-att-class="tx.qty > 0 ? 'o_hst_pos' : 'o_hst_neg'" t-esc="formatSigned(tx.qty)"/>
                            <td>
                              <t t-esc="tx.reference"/> · <t t-esc="categoryLabel(tx.category)"/>
                              <t t-if="tx.time"> (<t t-esc="tx.time"/>)</t>
                              <t t-if="tx.partner_name"> → <t t-esc="tx.partner_name"/></t>
                              <t t-elif="tx.other_location"> → <t t-esc="tx.other_location"/></t>
                            </td>
                          </tr>
                          <tr t-if="!state.dayDetail.transactions.length"><td colspan="4" class="o_hst_muted">Không có giao dịch</td></tr>
                        </tbody>
                      </table>

                      <table class="o_hst_loc_table" t-if="state.dayDetail.locations_snapshot.length and state.dayDetailTab === 'snapshot'">
                        <thead><tr><th>Vị trí</th><th>Kho</th><th class="o_hst_num">Tồn cuối ngày <t t-esc="formatVN(entry.date)"/></th></tr></thead>
                        <tbody>
                          <tr t-foreach="state.dayDetail.locations_snapshot" t-as="snap" t-key="snap.location_id or 'total'"
                              t-att-class="snap.is_total ? 'o_hst_total_row' : ''">
                            <td><t t-esc="snap.location_name"/></td>
                            <td t-esc="snap.warehouse_name"/>
                            <td class="o_hst_num" style="font-weight:700;"><t t-esc="formatQty(snap.balance)"/> Cái</td>
                          </tr>
                        </tbody>
                      </table>
                    </t>
                  </div>
                </t>
              </t>
            </div>
            <div class="o_hst_hint">Chỉ hiển thị ngày có biến động; các khoảng lặng được gộp lại. Bấm mũi tên để mở rộng.</div>
          </div>
        </t>

        <!-- ======================= TAB: THEO CƠ CẤU ======================= -->
        <t t-if="state.activeTab === 'structure' and state.structureData">

          <!-- .... company .... -->
          <t t-if="state.scopeType === 'company'">
            <div class="o_hst_kpis">
              <div class="o_hst_kpi">
                <div class="o_hst_kpi_lbl">Tồn ngày <t t-esc="formatVN(state.structureData.date_from)"/></div>
                <div class="o_hst_kpi_val" t-esc="formatQty(state.structureData.opening)"/>
                <div class="o_hst_kpi_warn" t-if="state.structureData.negative_opening">⚠ xem ghi chú bên dưới</div>
              </div>
              <div class="o_hst_kpi o_hst_kpi_accent">
                <div class="o_hst_kpi_lbl">Tồn hiện tại</div>
                <div class="o_hst_kpi_val" t-esc="formatQty(state.structureData.closing)"/>
              </div>
              <div class="o_hst_kpi">
                <div class="o_hst_kpi_lbl">Số kho đang giữ hàng</div>
                <div class="o_hst_kpi_val" t-esc="state.structureData.warehouses.length"/>
              </div>
            </div>

            <div class="o_hst_section">
              <div class="o_hst_sec_title">Luồng dịch chuyển trong kỳ</div>
              <div class="o_hst_card">
                <table class="o_hst_table">
                  <thead><tr><th>Loại</th><th class="o_hst_num">Tổng số lượng</th><th>Chi tiết</th></tr></thead>
                  <tbody>
                    <tr>
                      <td><span class="o_hst_pill o_hst_pill_green">Nhập kho</span></td>
                      <td class="o_hst_num o_hst_pos">+<t t-esc="formatQty(state.structureData.flow.received)"/></td>
                      <td class="o_hst_muted">
                        <t t-foreach="state.structureData.flow.receipt_lines" t-as="l" t-key="l_index">
                          <span t-esc="l.from"/> → <span t-esc="l.to"/>: <t t-esc="formatQty(l.qty)"/><t t-if="!l_last"> · </t>
                        </t>
                        <t t-if="!state.structureData.flow.receipt_lines.length">—</t>
                      </td>
                    </tr>
                    <tr>
                      <td><span class="o_hst_pill o_hst_pill_red">Bán hàng (xuất)</span></td>
                      <td class="o_hst_num o_hst_neg">-<t t-esc="formatQty(state.structureData.flow.sold)"/></td>
                      <td class="o_hst_muted">
                        <t t-foreach="state.structureData.flow.sale_lines" t-as="l" t-key="l_index">
                          <span t-esc="l.from"/> → <span t-esc="l.to"/>: <t t-esc="formatQty(l.qty)"/><t t-if="!l_last"> · </t>
                        </t>
                        <t t-if="!state.structureData.flow.sale_lines.length">—</t>
                      </td>
                    </tr>
                    <tr>
                      <td><span class="o_hst_pill o_hst_pill_blue">Chuyển kho nội bộ</span></td>
                      <td class="o_hst_num o_hst_muted">± 0 (net)</td>
                      <td class="o_hst_muted">
                        <t t-foreach="state.structureData.flow.transfer_lines" t-as="l" t-key="l_index">
                          <span t-esc="l.from"/> → <span t-esc="l.to"/>: <t t-esc="formatQty(l.qty)"/><t t-if="!l_last"> · </t>
                        </t>
                        <t t-if="!state.structureData.flow.transfer_lines.length">—</t>
                      </td>
                    </tr>
                    <tr t-if="state.structureData.flow.adjustment">
                      <td><span class="o_hst_pill" style="background:#fef3e2;color:#a15c07;">Điều chỉnh kiểm kho</span></td>
                      <td class="o_hst_num" t-att-class="state.structureData.flow.adjustment > 0 ? 'o_hst_pos' : 'o_hst_neg'"
                          t-esc="formatSigned(state.structureData.flow.adjustment)"/>
                      <td class="o_hst_muted">
                        <t t-foreach="state.structureData.flow.adjustment_lines" t-as="l" t-key="l_index">
                          <span t-esc="l.location"/>: <t t-esc="formatSigned(l.qty)"/><t t-if="!l_last"> · </t>
                        </t>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>

            <div class="o_hst_section">
              <div class="o_hst_sec_title">Theo từng kho</div>
              <div class="o_hst_card">
                <table class="o_hst_table o_hst_table_click">
                  <thead><tr><th>Kho</th><th class="o_hst_num">Tồn đầu kỳ</th><th class="o_hst_num">Tồn hiện tại</th><th></th></tr></thead>
                  <tbody>
                    <tr t-foreach="state.structureData.warehouses" t-as="wh" t-key="wh.warehouse_id or wh.warehouse_name"
                        t-att-class="wh.warehouse_id ? 'o_hst_row_clickable' : ''"
                        t-on-click="() => this.onStructureWarehouseClick(wh.warehouse_id, wh.warehouse_name)">
                      <td>
                        <strong t-esc="wh.warehouse_name"/>
                        <span class="o_hst_muted" t-if="wh.warehouse_id"> · <t t-esc="wh.location_count"/> vị trí</span>
                      </td>
                      <td class="o_hst_num">
                        <t t-esc="formatQty(wh.opening)"/>
                        <span class="o_hst_warn_dot" t-if="wh.negative_opening" title="Số âm — xem ghi chú">⚠</span>
                      </td>
                      <td class="o_hst_num"><strong t-esc="formatQty(wh.closing)"/></td>
                      <td class="o_hst_chevron" t-if="wh.warehouse_id">›</td>
                      <td t-else=""></td>
                    </tr>
                  </tbody>
                </table>
              </div>
              <div class="o_hst_hint">Bấm vào 1 kho để xem luồng ra/vào và luân chuyển nội bộ trong kho đó.</div>
            </div>

            <div class="o_hst_section">
              <div class="o_hst_sec_title">Phân bổ theo vị trí</div>
              <div class="o_hst_card">
                <table class="o_hst_table o_hst_table_click">
                  <thead>
                    <tr>
                      <th>Vị trí</th><th>Kho</th>
                      <th class="o_hst_num">Đầu kỳ</th>
                      <th class="o_hst_num">Nhập/nhận</th>
                      <th class="o_hst_num">Xuất/chuyển</th>
                      <th class="o_hst_num">Hiện tại</th>
                      <th></th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr t-foreach="state.structureData.locations" t-as="loc" t-key="loc.location_id"
                        class="o_hst_row_clickable"
                        t-on-click="() => this.onStructureLocationClick(loc.location_id, loc.location_name)">
                      <td><strong t-esc="loc.location_name"/></td>
                      <td class="o_hst_muted" t-esc="loc.warehouse_name"/>
                      <td class="o_hst_num">
                        <t t-esc="formatQty(loc.opening)"/>
                        <span class="o_hst_warn_dot" t-if="loc.negative_opening" title="Số âm — xem ghi chú">⚠</span>
                      </td>
                      <td class="o_hst_num o_hst_pos" t-esc="loc.inflow ? '+' + formatQty(loc.inflow) : '—'"/>
                      <td class="o_hst_num o_hst_neg" t-esc="loc.outflow ? '-' + formatQty(loc.outflow) : '—'"/>
                      <td class="o_hst_num"><strong t-esc="formatQty(loc.closing)"/></td>
                      <td class="o_hst_chevron">›</td>
                    </tr>
                  </tbody>
                </table>
              </div>
              <div class="o_hst_hint">Đầu kỳ + Nhập/nhận − Xuất/chuyển = Hiện tại. Bấm vào 1 vị trí để xem timeline chi tiết.</div>
            </div>

            <div class="o_hst_note" t-if="state.structureData.locations.some(l => l.negative_opening)">
              ⚠ <strong>Vị trí có tồn đầu kỳ âm</strong> không phải lỗi dữ liệu: đó là kết quả suy ra từ (tồn hiện tại − biến động trong kỳ).
              Số âm nghĩa là tại thời điểm đó, vị trí đang ở trạng thái "âm kho" — thường gặp ở vị trí trung chuyển/đóng gói tạm,
              nơi hàng được đặt trước/lấy ra trước khi có đủ hàng nhập vào.
            </div>
          </t>

          <!-- .... warehouse .... -->
          <t t-if="state.scopeType === 'warehouse'">
            <div class="o_hst_kpis">
              <div class="o_hst_kpi">
                <div class="o_hst_kpi_lbl">Tồn tại kho · <t t-esc="formatVN(state.structureData.date_from)"/></div>
                <div class="o_hst_kpi_val" t-esc="formatQty(state.structureData.opening)"/>
                <div class="o_hst_kpi_warn" t-if="state.structureData.negative_opening">⚠ xem ghi chú bên dưới</div>
              </div>
              <div class="o_hst_kpi o_hst_kpi_accent">
                <div class="o_hst_kpi_lbl">Tồn tại kho · hiện tại</div>
                <div class="o_hst_kpi_val" t-esc="formatQty(state.structureData.closing)"/>
              </div>
              <div class="o_hst_kpi">
                <div class="o_hst_kpi_lbl">Số vị trí trong kho</div>
                <div class="o_hst_kpi_val" t-esc="state.structureData.locations.length"/>
              </div>
            </div>

            <div class="o_hst_section">
              <div class="o_hst_sec_title">Luồng qua lại ranh giới kho (với bên ngoài)</div>
              <div class="o_hst_card">
                <table class="o_hst_table">
                  <thead><tr><th>Loại</th><th class="o_hst_num">Số lượng</th><th>Chi tiết</th></tr></thead>
                  <tbody>
                    <tr>
                      <td><span class="o_hst_pill o_hst_pill_blue">Nhận từ kho khác / NCC</span></td>
                      <td class="o_hst_num o_hst_pos">+<t t-esc="formatQty(state.structureData.boundary_flow.received + state.structureData.boundary_flow.transfer_in)"/></td>
                      <td class="o_hst_muted">
                        <t t-foreach="state.structureData.boundary_flow.receipt_lines.concat(state.structureData.boundary_flow.transfer_lines)" t-as="l" t-key="l_index">
                          <span t-esc="l.from"/> → <span t-esc="l.to"/>: <t t-esc="formatQty(l.qty)"/><t t-if="!l_last"> · </t>
                        </t>
                      </td>
                    </tr>
                    <tr>
                      <td><span class="o_hst_pill o_hst_pill_red">Bán ra khỏi kho</span></td>
                      <td class="o_hst_num o_hst_neg">-<t t-esc="formatQty(state.structureData.boundary_flow.sold)"/></td>
                      <td class="o_hst_muted">
                        <t t-foreach="state.structureData.boundary_flow.sale_lines" t-as="l" t-key="l_index">
                          <span t-esc="l.from"/> → <span t-esc="l.to"/>: <t t-esc="formatQty(l.qty)"/><t t-if="!l_last"> · </t>
                        </t>
                      </td>
                    </tr>
                    <tr>
                      <td><span class="o_hst_pill o_hst_pill_blue">Chuyển đi kho khác</span></td>
                      <td class="o_hst_num o_hst_neg">-<t t-esc="formatQty(state.structureData.boundary_flow.transfer_out)"/></td>
                      <td></td>
                    </tr>
                    <tr t-if="state.structureData.boundary_flow.adjustment">
                      <td><span class="o_hst_pill" style="background:#fef3e2;color:#a15c07;">Điều chỉnh kiểm kho</span></td>
                      <td class="o_hst_num" t-att-class="state.structureData.boundary_flow.adjustment > 0 ? 'o_hst_pos' : 'o_hst_neg'"
                          t-esc="formatSigned(state.structureData.boundary_flow.adjustment)"/>
                      <td class="o_hst_muted">
                        <t t-foreach="state.structureData.boundary_flow.adjustment_lines" t-as="l" t-key="l_index">
                          <span t-esc="l.location"/>: <t t-esc="formatSigned(l.qty)"/><t t-if="!l_last"> · </t>
                        </t>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
              <div class="o_hst_hint">
                Cân đối: <t t-esc="formatQty(state.structureData.opening)"/> (đầu kỳ)
                + <t t-esc="formatQty(state.structureData.boundary_flow.received + state.structureData.boundary_flow.transfer_in)"/> (nhận về)
                − <t t-esc="formatQty(state.structureData.boundary_flow.sold)"/> (bán)
                − <t t-esc="formatQty(state.structureData.boundary_flow.transfer_out)"/> (chuyển đi)
                <t t-if="state.structureData.boundary_flow.adjustment">
                  <t t-esc="state.structureData.boundary_flow.adjustment > 0 ? '+' : '−'"/> <t t-esc="formatQty(Math.abs(state.structureData.boundary_flow.adjustment))"/> (điều chỉnh kiểm kho)
                </t>
                = <t t-esc="formatQty(state.structureData.closing)"/> (hiện tại)
              </div>
            </div>

            <div class="o_hst_section" t-if="state.structureData.internal_throughput.length">
              <div class="o_hst_sec_title">Luân chuyển nội bộ trong kho</div>
              <div class="o_hst_card">
                <table class="o_hst_table">
                  <thead><tr><th>Vị trí</th><th class="o_hst_num">Đã nhận (nội bộ)</th><th class="o_hst_num">Đã chuyển đi (nội bộ)</th></tr></thead>
                  <tbody>
                    <tr t-foreach="state.structureData.internal_throughput" t-as="t_row" t-key="t_row.location_id">
                      <td t-esc="t_row.location_name"/>
                      <td class="o_hst_num o_hst_pos" t-esc="'+' + formatQty(t_row.in)"/>
                      <td class="o_hst_num o_hst_neg" t-esc="'-' + formatQty(t_row.out)"/>
                    </tr>
                  </tbody>
                </table>
              </div>
              <div class="o_hst_hint">Dòng hàng đi qua nội bộ giữa các vị trí trong kho (VD: lấy hàng → đóng gói → xuất) — không đổi tổng tồn của kho.</div>
            </div>

            <div class="o_hst_section">
              <div class="o_hst_sec_title">Phân bổ theo vị trí trong kho</div>
              <div class="o_hst_card">
                <table class="o_hst_table o_hst_table_click">
                  <thead>
                    <tr>
                      <th>Vị trí</th>
                      <th class="o_hst_num">Đầu kỳ</th>
                      <th class="o_hst_num">Nhập/nhận</th>
                      <th class="o_hst_num">Xuất/chuyển</th>
                      <th class="o_hst_num">Hiện tại</th>
                      <th></th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr t-foreach="state.structureData.locations" t-as="loc" t-key="loc.location_id"
                        class="o_hst_row_clickable"
                        t-on-click="() => this.onStructureLocationClick(loc.location_id, loc.location_name)">
                      <td><strong t-esc="loc.location_name"/></td>
                      <td class="o_hst_num">
                        <t t-esc="formatQty(loc.opening)"/>
                        <span class="o_hst_warn_dot" t-if="loc.negative_opening" title="Số âm — xem ghi chú">⚠</span>
                      </td>
                      <td class="o_hst_num o_hst_pos" t-esc="loc.inflow ? '+' + formatQty(loc.inflow) : '—'"/>
                      <td class="o_hst_num o_hst_neg" t-esc="loc.outflow ? '-' + formatQty(loc.outflow) : '—'"/>
                      <td class="o_hst_num"><strong t-esc="formatQty(loc.closing)"/></td>
                      <td class="o_hst_chevron">›</td>
                    </tr>
                  </tbody>
                </table>
              </div>
              <div class="o_hst_hint">"Nhập/nhận" gồm cả nhận nội bộ trong kho; "Xuất/chuyển" gồm cả chuyển nội bộ trong kho. Đầu kỳ + Nhập/nhận − Xuất/chuyển = Hiện tại.</div>
            </div>

            <div class="o_hst_note" t-if="state.structureData.locations.some(l => l.negative_opening)">
              ⚠ <strong>Vị trí có tồn đầu kỳ âm</strong> không phải lỗi dữ liệu: đó là kết quả suy ra từ (tồn hiện tại − biến động trong kỳ).
              Số âm nghĩa là tại thời điểm đó, vị trí đang ở trạng thái "âm kho" — thường gặp ở vị trí trung chuyển/đóng gói tạm,
              nơi hàng được đặt trước/lấy ra trước khi có đủ hàng nhập vào.
            </div>
          </t>

          <!-- .... location .... -->
          <t t-if="state.scopeType === 'location'">
            <div class="o_hst_note" t-if="state.structureData.opening_negative">
              ⚠ Tồn đầu kỳ tại vị trí này ra số âm — suy ra từ (tồn hiện tại − biến động trong kỳ), không phải lỗi dữ liệu.
              Thường gặp ở vị trí trung chuyển/đóng gói tạm.
            </div>
            <div class="o_hst_section">
              <div class="o_hst_sec_title">Dòng lịch sử tại vị trí này</div>
              <div class="o_hst_timeline">
                <div class="o_hst_tl_item" t-foreach="state.structureData.lines" t-as="line" t-key="line_index"
                     t-att-class="'o_hst_tl_' + line.type">
                  <div class="o_hst_tl_dot"/>
                  <div class="o_hst_tl_card">
                    <div class="o_hst_tl_main">
                      <div class="o_hst_tl_title" t-esc="line.title"/>
                      <div class="o_hst_tl_sub">
                        <t t-esc="formatVN(line.date)"/>
                        <t t-if="line.reference"> · <t t-esc="line.reference"/></t>
                        <t t-if="line.other_location"> · <t t-esc="line.other_location"/></t>
                        <t t-if="line.partner_name"> · <t t-esc="line.partner_name"/></t>
                      </div>
                    </div>
                    <div class="o_hst_tl_right">
                      <div t-if="line.qty !== null"
                           t-att-class="line.qty > 0 ? 'o_hst_tl_qty o_hst_pos' : 'o_hst_tl_qty o_hst_neg'">
                        <t t-if="line.qty > 0">+</t><t t-esc="formatQty(line.qty)"/> <t t-esc="line.uom"/>
                      </div>
                      <div class="o_hst_tl_balance">Số dư: <t t-esc="formatQty(line.balance)"/></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </t>
        </t>

      </t>
    </div>
  </t>
</templates>
