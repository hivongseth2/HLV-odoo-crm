<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View (Odoo 18 <list>) -->
    <record id="view_hlv_loyalty_banner_list" model="ir.ui.view">
        <field name="name">hlv.loyalty.banner.list</field>
        <field name="model">hlv.loyalty.banner</field>
        <field name="arch" type="xml">
            <list string="Banner Loyalty Mobile App">
                <field name="sequence" widget="handle"/>
                <field name="image" widget="image" options="{"size": [80, 40]}" string="Ảnh"/>
                <field name="name" string="Tên Banner"/>
                <field name="tag" string="Nhãn / Tag"/>
                <field name="link" string="Trang đích (Link)"/>
                <field name="date_start" string="Bắt đầu"/>
                <field name="date_end" string="Kết thúc"/>
                <field name="active" widget="boolean_toggle" string="Hiển thị"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hlv_loyalty_banner_form" model="ir.ui.view">
        <field name="name">hlv.loyalty.banner.form</field>
        <field name="model">hlv.loyalty.banner</field>
        <field name="arch" type="xml">
            <form string="Banner Loyalty Mobile App">
                <sheet>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Tên chương trình / Banner"/>
                        <h1>
                            <field name="name" placeholder="vd: Super Event Đổi Quà 0Đ..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Cấu hình hiển thị">
                            <field name="tag" placeholder="vd: HOT, ĐỔI QUÀ 0Đ, VOUCHER 100K"/>
                            <field name="subtitle" placeholder="vd: Đổi phụ kiện & quà tặng công cụ chỉ từ 200 điểm"/>
                            <field name="link" placeholder="redeem | vouchers | tiers | hoặc URL website"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Thời gian áp dụng">
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                    <group string="Hình ảnh Banner (Tỉ lệ ~16:9 hoặc 2:1)">
                        <field name="image" widget="image" class="oe_avatar" options="{"preview_image": "image"}" style="width: 360px; height: 160px; object-fit: cover;"/>
                    </group>
                    <notebook>
                        <page string="Mô tả chi tiết" name="description">
                            <field name="description" placeholder="Nội dung ghi chú hoặc thể lệ chi tiết của chương trình..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hlv_loyalty_banner" model="ir.actions.act_window">
        <field name="name">Banner App Mobile</field>
        <field name="res_model">hlv.loyalty.banner</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo banner ưu đãi mới cho Loyalty Mobile App!
            </p>
            <p>
                Banner này sẽ tự động đồng bộ và hiển thị trên thanh trượt ưu đãi của ứng dụng React Native.
            </p>
        </field>
    </record>

    <!-- Menu Item (gắn dưới menu Cấu hình Loyalty của hlv_loyalty nếu có, hoặc tạo menu riêng) -->
    <menuitem id="menu_hlv_loyalty_banner"
              name="Banner App Mobile"
              action="action_hlv_loyalty_banner"
              sequence="30"/>
</odoo>

