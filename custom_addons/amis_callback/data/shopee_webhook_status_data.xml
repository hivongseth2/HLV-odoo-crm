<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="shopee_status_completed" model="amis.shopee.webhook.status">
        <field name="sequence">10</field>
        <field name="name">Hoàn thành</field>
        <field name="shopee_code">COMPLETED</field>
    </record>
    <record id="shopee_status_to_confirm_receive" model="amis.shopee.webhook.status">
        <field name="sequence">20</field>
        <field name="name">Đã nhận hàng</field>
        <field name="shopee_code">TO_CONFIRM_RECEIVE</field>
    </record>
    <record id="shopee_status_shipped" model="amis.shopee.webhook.status">
        <field name="sequence">30</field>
        <field name="name">Đang giao</field>
        <field name="shopee_code">SHIPPED</field>
    </record>
    <record id="shopee_status_ready_to_ship" model="amis.shopee.webhook.status">
        <field name="sequence">40</field>
        <field name="name">Chờ lấy hàng</field>
        <field name="shopee_code">READY_TO_SHIP</field>
    </record>
    <record id="shopee_status_processed" model="amis.shopee.webhook.status">
        <field name="sequence">50</field>
        <field name="name">Đã xử lý</field>
        <field name="shopee_code">PROCESSED</field>
    </record>
    <record id="shopee_status_cancelled" model="amis.shopee.webhook.status">
        <field name="sequence">60</field>
        <field name="name">Đã hủy</field>
        <field name="shopee_code">CANCELLED</field>
    </record>
    <record id="shopee_status_in_cancel" model="amis.shopee.webhook.status">
        <field name="sequence">70</field>
        <field name="name">Chờ xác nhận hủy</field>
        <field name="shopee_code">IN_CANCEL</field>
    </record>
    <record id="shopee_status_retry_ship" model="amis.shopee.webhook.status">
        <field name="sequence">80</field>
        <field name="name">Giao lại</field>
        <field name="shopee_code">RETRY_SHIP</field>
    </record>
    <record id="shopee_status_to_return" model="amis.shopee.webhook.status">
        <field name="sequence">90</field>
        <field name="name">Đang trả hàng</field>
        <field name="shopee_code">TO_RETURN</field>
    </record>
    <record id="shopee_status_unpaid" model="amis.shopee.webhook.status">
        <field name="sequence">100</field>
        <field name="name">Chưa thanh toán</field>
        <field name="shopee_code">UNPAID</field>
    </record>
</odoo>
