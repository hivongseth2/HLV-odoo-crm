<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="seq_amis_callback_log" model="ir.sequence">
        <field name="name">AMIS Callback Log</field>
        <field name="code">amis.callback.log</field>
        <field name="prefix">MISA-CB/</field>
        <field name="padding">5</field>
    </record>

    <record id="seq_amis_payment_request" model="ir.sequence">
        <field name="name">AMIS Payment Request</field>
        <field name="code">amis.payment.request</field>
        <field name="prefix">DNC/</field>
        <field name="padding">5</field>
    </record>

    <!-- noupdate="1": record này PHẢI luôn tồn tại trong XML (nếu xóa, Odoo sẽ coi
         xmlid là mồ côi và unlink() record thật khi module update -> cascade xóa
         toàn bộ amis.misa.vendor/inventory/unit.cache trỏ vào nó, xem commit 94e9e643e).
         noupdate="1" đảm bảo field app_id không bị ghi đè về rỗng ở các lần update sau. -->
    <data noupdate="1">
        <record id="amis_callback_config_singleton" model="amis.callback.config">
            <field name="name">AMIS Callback</field>
            <field name="app_id"></field>
        </record>
    </data>
</odoo>
