<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="ir_cron_amis_sync_catalog_unmapped" model="ir.cron">
        <field name="name">AMIS: Tự động đồng bộ sản phẩm chưa map (30 phút)</field>
        <field name="model_id" ref="model_amis_callback_config"/>
        <field name="state">code</field>
        <field name="code">records = model.search([], limit=1)
if records:
    records.action_sync_catalog_unmapped_only()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_amis_sync_queue" model="ir.cron">
        <field name="name">AMIS: Xử lý hàng đợi đồng bộ kho</field>
        <field name="model_id" ref="model_amis_sync_job"/>
        <field name="state">code</field>
        <field name="code">model._process_pending()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_meinvoice_check_cqt_status" model="ir.cron">
        <field name="name">meInvoice: Kiểm tra trạng thái CQT hóa đơn đã phát hành</field>
        <field name="model_id" ref="model_amis_callback_config"/>
        <field name="state">code</field>
        <field name="code">model.action_check_meinvoice_status_cron()</field>
        <field name="interval_number">2</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>
</odoo>
