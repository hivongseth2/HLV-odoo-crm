<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">

    <!-- ═══════════════════════════════════════════════════════════════════
         Mẫu email — Hóa đơn nháp (chưa cấp mã)
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="mail_template_meinvoice_draft" model="mail.template">
        <field name="name">meInvoice: Thông báo hóa đơn điện tử (bản xem trước)</field>
        <field name="model_id" ref="model_meinvoice_invoice"/>
        <field name="subject">{{ user.company_id.name }} gửi bản xem trước hóa đơn điện tử cho {{ object.buyer_legal_name or object.buyer_full_name or object.partner_id.name or 'Quý khách' }}</field>
        <field name="email_from">{{ (user.email_formatted or user.email or '') }}</field>
        <field name="email_to">{{ (object.buyer_email or '') }}</field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
<div style="margin:0 auto;max-width:640px;font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#333;">
    <!-- Header -->
    <div style="background:#1565C0;padding:20px 28px;">
        <span style="font-size:15px;font-weight:bold;color:#fff;" t-out="user.company_id.name + ' thông báo gửi Hóa đơn giá trị gia tăng (bản xem trước) cho Quý khách'"/>
    </div>
    <!-- Body -->
    <div style="padding:24px 28px;background:#fff;border:1px solid #ddd;border-top:none;">
        <p style="color:#c62828;font-style:italic;margin:0 0 18px 0;">
            Chú ý: Đây là email tự động từ hệ thống, vui lòng không phản hồi (reply) lại email này
        </p>
        <p style="margin:0 0 4px 0;">
            <strong>Kính gửi Quý khách <t t-out="object.buyer_legal_name or object.buyer_full_name or object.partner_id.name or 'Quý khách'"/></strong>
        </p>
        <p style="margin:0 0 16px 0;">
            <t t-out="user.company_id.name"/> xin gửi cho Quý khách <strong>bản xem trước Hóa đơn giá trị gia tăng</strong> với các thông tin như sau:
        </p>
        <!-- Info box -->
        <div style="background:#e3f2fd;border:1px solid #90caf9;padding:16px 20px;margin:0 0 20px 0;">
            <table style="border-collapse:collapse;width:100%;font-size:14px;">
                <tr>
                    <td style="padding:5px 0;width:45%;color:#555;">Ký hiệu:</td>
                    <td style="padding:5px 0;font-weight:bold;" t-out="object.inv_series or ''"/>
                </tr>
                <tr>
                    <td style="padding:5px 0;color:#555;">Ngày:</td>
                    <td style="padding:5px 0;" t-out="object.inv_date or ''"/>
                </tr>
                <tr>
                    <td style="padding:5px 0;color:#555;">Hình thức thanh toán:</td>
                    <td style="padding:5px 0;" t-out="object.payment_method or ''"/>
                </tr>
                <tr>
                    <td style="padding:5px 0;color:#555;">Tổng tiền thanh toán:</td>
                    <td style="padding:5px 0;font-weight:bold;">
                        <t t-out="'{:,.0f}'.format(object.total_amount_oc or 0).replace(',', '.')"/> VND
                    </td>
                </tr>
            </table>
        </div>
        <p style="margin:0 0 16px 0;">
            Đây là <strong>bản xem trước chưa được Cơ quan Thuế cấp mã</strong>. Quý khách vui lòng kiểm tra, đối chiếu nội dung ghi trên hóa đơn (file PDF đính kèm).
            Nếu cần điều chỉnh thông tin, vui lòng liên hệ lại với chúng tôi trước khi hóa đơn được phát hành chính thức.
        </p>
        <p style="margin:0 0 4px 0;">Trân trọng kính chào!</p>
        <p style="margin:0;font-weight:bold;" t-out="user.company_id.name"/>
    </div>
    <!-- Footer -->
    <div style="background:#1565C0;padding:14px 28px;text-align:center;">
        <span style="color:#fff;font-weight:bold;font-size:13px;" t-out="user.company_id.name"/>
    </div>
</div>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         Mẫu email — Hóa đơn đã cấp mã (đã phát hành)
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="mail_template_meinvoice_published" model="mail.template">
        <field name="name">meInvoice: Hóa đơn điện tử đã cấp mã (bản chính thức)</field>
        <field name="model_id" ref="model_meinvoice_invoice"/>
        <field name="subject">{{ user.company_id.name }} gửi hóa đơn điện tử số {{ object.inv_no or '(đang cấp số)' }} cho {{ object.buyer_legal_name or object.buyer_full_name or object.partner_id.name or 'Quý khách' }}</field>
        <field name="email_from">{{ (user.email_formatted or user.email or '') }}</field>
        <field name="email_to">{{ (object.buyer_email or '') }}</field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
<div style="margin:0 auto;max-width:640px;font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#333;">
    <!-- Header -->
    <div style="background:#1565C0;padding:20px 28px;">
        <span style="font-size:15px;font-weight:bold;color:#fff;" t-out="user.company_id.name + ' thông báo gửi Hóa đơn giá trị gia tăng cho Quý khách'"/>
    </div>
    <!-- Body -->
    <div style="padding:24px 28px;background:#fff;border:1px solid #ddd;border-top:none;">
        <p style="color:#c62828;font-style:italic;margin:0 0 18px 0;">
            Chú ý: Đây là email tự động từ hệ thống, vui lòng không phản hồi (reply) lại email này
        </p>
        <p style="margin:0 0 4px 0;">
            <strong>Kính gửi Quý khách <t t-out="object.buyer_legal_name or object.buyer_full_name or object.partner_id.name or 'Quý khách'"/></strong>
        </p>
        <p style="margin:0 0 16px 0;">
            <t t-out="user.company_id.name"/> xin gửi cho Quý khách Hóa đơn giá trị gia tăng với các thông tin như sau:
        </p>
        <!-- Info box -->
        <div style="background:#e3f2fd;border:1px solid #90caf9;padding:16px 20px;margin:0 0 20px 0;">
            <table style="border-collapse:collapse;width:100%;font-size:14px;">
                <tr>
                    <td style="padding:5px 0;width:45%;color:#555;">Số:</td>
                    <td style="padding:5px 0;font-weight:bold;" t-out="object.inv_no or ''"/>
                </tr>
                <tr>
                    <td style="padding:5px 0;color:#555;">Ngày:</td>
                    <td style="padding:5px 0;" t-out="object.inv_date_result or object.inv_date or ''"/>
                </tr>
                <tr>
                    <td style="padding:5px 0;color:#555;">Ký hiệu:</td>
                    <td style="padding:5px 0;" t-out="object.inv_series_result or object.inv_series or ''"/>
                </tr>
                <tr>
                    <td style="padding:5px 0;color:#555;">Mã của cơ quan thuế:</td>
                    <td style="padding:5px 0;word-break:break-all;" t-out="object.inv_code or ''"/>
                </tr>
            </table>
        </div>
        <p style="margin:0 0 12px 0;">Để tra cứu và ký điện tử trên hóa đơn, Quý khách vui lòng nhấn nút:</p>
        <p style="margin:0 0 16px 0;">
            <a href="https://www.meinvoice.vn/tra-cuu" style="display:inline-block;background:#E65100;color:#fff;padding:10px 28px;text-decoration:none;font-weight:bold;font-size:14px;">TRA CỨU</a>
        </p>
        <p style="margin:0 0 16px 0;">
            Hoặc truy cập vào đường dẫn <a href="https://www.meinvoice.vn/tra-cuu" style="color:#1565C0;">https://www.meinvoice.vn/tra-cuu</a> và nhập mã CQT: <strong t-out="object.inv_code or ''"/>
        </p>
        <p style="margin:0 0 16px 0;">Quý khách vui lòng kiểm tra, đối chiếu nội dung ghi trên hóa đơn.</p>
        <p style="margin:0 0 4px 0;">Trân trọng kính chào!</p>
        <p style="margin:0;font-weight:bold;" t-out="user.company_id.name"/>
    </div>
    <!-- Footer -->
    <div style="background:#1565C0;padding:14px 28px;text-align:center;">
        <span style="color:#fff;font-weight:bold;font-size:13px;" t-out="user.company_id.name"/>
    </div>
</div>
        </field>
    </record>

</odoo>
