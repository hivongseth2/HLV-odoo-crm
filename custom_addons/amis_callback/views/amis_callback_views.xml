<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_amis_callback_log_tree" model="ir.ui.view">
        <field name="name">amis.callback.log.tree</field>
        <field name="model">amis.callback.log</field>
        <field name="arch" type="xml">
            <list string="Nhat ky AMIS Callback" default_order="received_at desc">
                <field name="received_at"/>
                <field name="name"/>
                <field name="state"/>
                <field name="signature_valid"/>
                <field name="data_type"/>
                <field name="org_company_code"/>
                <field name="input_success"/>
                <field name="response_success"/>
                <field name="detail_count"/>
            </list>
        </field>
    </record>

    <record id="view_amis_callback_log_form" model="ir.ui.view">
        <field name="name">amis.callback.log.form</field>
        <field name="model">amis.callback.log</field>
        <field name="arch" type="xml">
            <form string="Chi tiet AMIS Callback">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="received,validated,rejected,failed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="received_at" readonly="1"/>
                            <field name="request_path" readonly="1"/>
                            <field name="remote_addr" readonly="1"/>
                            <field name="app_id" readonly="1"/>
                            <field name="org_company_code" readonly="1"/>
                        </group>
                        <group>
                            <field name="data_type" readonly="1"/>
                            <field name="input_success" readonly="1"/>
                            <field name="input_error_code" readonly="1"/>
                            <field name="signature_valid" readonly="1"/>
                            <field name="response_success" readonly="1"/>
                            <field name="response_error_code" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Du lieu nhan vao">
                            <group>
                                <field name="input_error_message" readonly="1" nolabel="1"/>
                                <field name="signature" readonly="1"/>
                            </group>
                            <field name="data_payload" readonly="1" widget="text" nolabel="1"/>
                        </page>
                        <page string="Phan hoi">
                            <field name="response_error_message" readonly="1" nolabel="1"/>
                            <field name="raw_payload" readonly="1" widget="text" nolabel="1"/>
                        </page>
                        <page string="Chi tiet">
                            <field name="detail_line_ids" readonly="1">
                                <list>
                                    <field name="sequence"/>
                                    <field name="org_refid"/>
                                    <field name="success"/>
                                    <field name="error_code"/>
                                    <field name="error_message"/>
                                    <field name="session_id"/>
                                    <field name="voucher_type"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_amis_callback_log_search" model="ir.ui.view">
        <field name="name">amis.callback.log.search</field>
        <field name="model">amis.callback.log</field>
        <field name="arch" type="xml">
            <search string="Tim kiem nhat ky callback">
                <field name="name"/>
                <field name="org_company_code"/>
                <field name="data_type"/>
                <field name="state"/>
                <field name="signature_valid"/>
                <filter name="filter_valid" string="Signature hop le" domain="[('signature_valid', '=', True)]"/>
                <filter name="filter_invalid" string="Signature khong hop le" domain="[('signature_valid', '=', False)]"/>
                <filter name="filter_error" string="That bai" domain="[('state', '=', 'failed')]"/>
                <group expand="0" string="Nhom theo">
                    <filter name="group_state" string="Trang thai" context="{'group_by': 'state'}"/>
                    <filter name="group_data_type" string="Loai du lieu" context="{'group_by': 'data_type'}"/>
                    <filter name="group_company" string="Ma cong ty" context="{'group_by': 'org_company_code'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_amis_callback_log" model="ir.actions.act_window">
        <field name="name">Nhật ký AMIS Callback</field>
        <field name="res_model">amis.callback.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_amis_callback_log_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa có callback nào được nhận.</p>
            <p>Các request từ MISA sẽ hiển thị ở đây sau khi webhook được gọi.</p>
        </field>
    </record>

    <record id="view_amis_callback_config_form" model="ir.ui.view">
        <field name="name">amis.callback.config.form</field>
        <field name="model">amis.callback.config</field>
        <field name="arch" type="xml">
            <form string="Cấu hình AMIS Callback">
                <header>
                    <button name="action_connect_misa" type="object" string="Kết nối MISA" class="btn-primary"/>
                    <button name="action_connect_meinvoice" type="object" string="Kết nối meInvoice" class="btn-secondary"/>
                    <button name="action_sync_catalog_to_odoo" type="object" string="Đồng bộ danh mục hàng hóa" class="btn-secondary"/>
                    <button name="action_sync_catalog_unmapped_only" type="object" string="Đồng bộ sản phẩm mới" class="btn-secondary"/>
                    <button name="check_call_back_data" type="object" string="Kiểm tra Callback" class="btn-secondary"/>
                    <button name="delete_call_back_data" type="object" string="Xóa Callback" class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="app_id"/>
                            <field name="active"/>
                            <field name="api_url"/>
                            <field name="org_company_code"/>
                            <field name="access_code" password="True"/>
                            <field name="access_token" readonly="1"/>
                            <field name="token_expired_time" readonly="1"/>
                            <field name="misa_branch_id"/>
                            <field name="misa_stock_id"/>
                        </group>
                        <group>
                            <field name="callback_route" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="sync_incoming_po_enabled"/>
                            <field name="sync_outgoing_so_enabled"/>
                            <field name="sync_shopee_only"/>
                        </group>
                    </group>
                    <group string="Mapping khách hàng Shopee → MISA">
                        <group>
                            <field name="misa_shopee_milwaukee_account_object_id"/>
                            <field name="misa_shopee_hlv_account_object_id"/>
                            <field name="misa_shopee_dewalt_account_object_id"/>
                        </group>
                        <group string="Fallback (Test)">
                            <field name="misa_fallback_account_object_id"/>
                            <field name="misa_fallback_account_object_code"/>
                            <field name="misa_fallback_account_object_name"/>
                        </group>
                    </group>
                    <group string="meInvoice - Tên người mua mặc định theo kênh Shopee">
                        <group>
                            <field name="meinvoice_shopee_milwaukee_buyer_name"/>
                            <field name="meinvoice_shopee_hlv_buyer_name"/>
                            <field name="meinvoice_shopee_dewalt_buyer_name"/>
                        </group>
                        <group>
                            <field name="meinvoice_default_buyer_name"/>
                        </group>
                    </group>
                    <group string="Hóa đơn VAT kèm SAInvoice (cũ - ACT)">
                        <group>
                            <field name="sa_invoice_include_vat"/>
                            <field name="misa_inv_template_id"
                                   invisible="not sa_invoice_include_vat"/>
                            <field name="misa_inv_series"
                                   invisible="not sa_invoice_include_vat"/>
                        </group>
                    </group>
                    <group string="meInvoice - Hóa đơn điện tử đầu ra">
                        <group>
                            <field name="meinvoice_enabled"/>
                            <field name="meinvoice_api_url"/>
                            <field name="meinvoice_app_id"/>
                            <field name="meinvoice_taxcode"/>
                            <field name="meinvoice_username"/>
                            <field name="meinvoice_password" password="True"/>
                            <field name="meinvoice_token" readonly="1" invisible="not meinvoice_token"/>
                            <field name="meinvoice_token_acquired" readonly="1" invisible="not meinvoice_token_acquired"/>
                        </group>
                        <group>
                            <field name="meinvoice_inv_series"/>
                            <field name="meinvoice_sign_type"/>
                            <field name="meinvoice_stock_out_address"/>
                            <field name="meinvoice_stock_in_address"/>
                            <field name="meinvoice_is_pxk"/>
                            <field name="meinvoice_transport_means"
                                   invisible="not meinvoice_is_pxk"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_amis_callback_config_tree" model="ir.ui.view">
        <field name="name">amis.callback.config.tree</field>
        <field name="model">amis.callback.config</field>
        <field name="arch" type="xml">
            <list string="Cấu hình AMIS Callback">
                <field name="name"/>
                <field name="app_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_amis_callback_config" model="ir.actions.act_window">
        <field name="name">Cấu hình AMIS Callback</field>
        <field name="res_model">amis.callback.config</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>

    <!-- Stock Picking View inherit - add MISA sync button -->
    <record id="view_picking_form_amis_inherit" model="ir.ui.view">
        <field name="name">stock.picking.form.amis.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//button[@name='button_validate']" position="after">
                    <button name="action_test_outgoing_push" type="object" string="Xuất kho MISA" class="btn-secondary"
                        invisible="picking_type_code != 'outgoing'"/>
                </xpath>
            </data>
        </field>
    </record>

    <!-- Sale Order View inherit - add SAInvoice button -->
    <record id="view_sale_order_form_amis_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.amis.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_publish_meinvoice_invoice" type="object"
                            class="oe_stat_button" icon="fa-file-text-o"
                            invisible="not misa_sa_voucher_synced or misa_meinvoice_synced or state not in ('sale','done')">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_text">Phát hành</span>
                            <span class="o_stat_text">HĐĐT</span>
                        </div>
                    </button>
                    <button name="action_reset_meinvoice_invoice" type="object"
                            class="oe_stat_button" icon="fa-refresh"
                            invisible="not misa_meinvoice_synced"
                            confirm="Reset sẽ cho phép phát hành lại HĐĐT meInvoice. Tiếp tục?">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_text">Reset</span>
                            <span class="o_stat_text">meInvoice</span>
                        </div>
                    </button>
                    <!-- SA Invoice (ẩn, giữ code) -->
                    <button name="action_sync_misa_sa_invoice" type="object"
                            class="oe_stat_button" icon="fa-file-text-o"
                            invisible="True">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_text">Sync</span>
                            <span class="o_stat_text">Hóa đơn MISA</span>
                        </div>
                    </button>
                    <button name="action_sync_misa_sa_invoice" type="object"
                            class="oe_stat_button" icon="fa-check-circle"
                            invisible="True">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_text">Đã sync</span>
                            <span class="o_stat_text">Hóa đơn MISA</span>
                        </div>
                    </button>
                    <button name="action_reset_misa_sa_invoice" type="object"
                            class="oe_stat_button" icon="fa-refresh"
                            invisible="True"
                            confirm="Reset sẽ cho phép sync lại SAInvoice. Tiếp tục?">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_text">Reset</span>
                            <span class="o_stat_text">SAInvoice</span>
                        </div>
                    </button>
                </xpath>
                <xpath expr="//notebook" position="inside">
                    <page string="MISA" name="misa_info"
                          invisible="not misa_sa_voucher_synced and not misa_sa_invoice_synced and not misa_meinvoice_synced">
                        <group>
                            <group string="SAVoucher (Bán hàng)">
                                <field name="misa_sa_voucher_synced" readonly="1"/>
                                <field name="misa_sa_voucher_org_refid" readonly="1"/>
                            </group>
                            <group string="SAInvoice (Hóa đơn - ACT)">
                                <field name="misa_sa_invoice_synced" readonly="1"/>
                                <field name="misa_sa_invoice_org_refid" readonly="1"/>
                            </group>
                            <group string="meInvoice (Hóa đơn điện tử)">
                                <field name="misa_meinvoice_synced" readonly="1"/>
                                <field name="misa_meinvoice_ref_id" readonly="1"/>
                                <field name="misa_meinvoice_transaction_id" readonly="1"/>
                                <field name="misa_meinvoice_inv_no" readonly="1"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <!-- Queue View -->
    <record id="view_amis_sync_job_list" model="ir.ui.view">
        <field name="name">amis.sync.job.list</field>
        <field name="model">amis.sync.job</field>
        <field name="arch" type="xml">
            <list string="Hàng đợi đồng bộ MISA" default_order="create_date desc"
                  decoration-danger="status == 'error'"
                  decoration-success="status == 'done'"
                  decoration-muted="status == 'skipped'">
                <field name="create_date" string="Tạo lúc"/>
                <field name="picking_id" optional="show"/>
                <field name="sale_order_id" optional="show"/>
                <field name="direction"/>
                <field name="status"/>
                <field name="retry_count"/>
                <field name="processed_at" string="Xử lý lúc"/>
                <field name="error_msg" string="Lỗi" optional="show"/>
                <button name="action_retry" type="object" string="Thử lại"
                        invisible="status not in ('error',)" icon="fa-refresh"/>
                <button name="action_run_now" type="object" string="Chạy ngay"
                        invisible="status not in ('pending','error')" icon="fa-play"/>
            </list>
        </field>
    </record>

    <record id="view_amis_sync_job_form" model="ir.ui.view">
        <field name="name">amis.sync.job.form</field>
        <field name="model">amis.sync.job</field>
        <field name="arch" type="xml">
            <form string="Sync Job MISA">
                <header>
                    <button name="action_run_now" type="object" string="Chạy ngay"
                            invisible="status not in ('pending','error')" class="btn-primary"/>
                    <button name="action_retry" type="object" string="Thử lại"
                            invisible="status not in ('error',)" class="btn-secondary"/>
                    <field name="status" widget="statusbar" statusbar_visible="pending,done,error"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="picking_id"/>
                            <field name="sale_order_id"/>
                            <field name="direction"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="retry_count"/>
                            <field name="processed_at"/>
                        </group>
                    </group>
                    <group string="Lỗi" invisible="not error_msg">
                        <field name="error_msg" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_amis_sync_job" model="ir.actions.act_window">
        <field name="name">Hàng đợi đồng bộ MISA</field>
        <field name="res_model">amis.sync.job</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

    <menuitem id="menu_amis_callback_root" name="AMIS Callback" sequence="30" web_icon="amis_callback,static/description/icon.png"/>
    <menuitem id="menu_amis_callback_logs" name="Nhật ký callback" parent="menu_amis_callback_root" action="action_amis_callback_log" sequence="10"/>
    <menuitem id="menu_amis_sync_jobs" name="Hàng đợi đồng bộ MISA" parent="menu_amis_callback_root" action="action_amis_sync_job" sequence="15"/>
    <menuitem id="menu_amis_callback_config" name="Cấu hình" parent="menu_amis_callback_root" action="action_amis_callback_config" sequence="20" groups="base.group_system"/>
</odoo>
