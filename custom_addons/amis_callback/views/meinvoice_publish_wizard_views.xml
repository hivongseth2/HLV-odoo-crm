<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════════════════
         meinvoice.invoice — Hóa đơn điện tử (lưu trữ bền vững)
    ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Form view -->
    <record id="view_meinvoice_invoice_form" model="ir.ui.view">
        <field name="name">meinvoice.invoice.form</field>
        <field name="model">meinvoice.invoice</field>
        <field name="arch" type="xml">
            <form string="Hóa đơn điện tử meInvoice" delete="false">
                <header>
                    <button name="action_publish" type="object"
                            string="Gửi lên Cơ quan Thuế"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            groups="amis_callback.group_meinvoice_accountant"
                            confirm="Xác nhận gửi hóa đơn này lên Cơ quan Thuế? Thao tác không thể hoàn tác."/>
                    <button name="action_preview_invoice" type="object"
                            string="Xem trước HĐ"
                            invisible="state != 'draft'"/>
                    <button name="action_check_cqt_status" type="object"
                            string="Kiểm tra CQT"
                            invisible="state not in ('submitted','accepted','rejected')"/>
                    <button name="action_download_pdf" type="object"
                            string="Tải PDF"
                            invisible="state not in ('submitted','accepted','rejected')"/>
                    <button name="action_download_xml" type="object"
                            string="Tải XML"
                            invisible="state not in ('submitted','accepted','rejected')"/>
                    <button name="action_view_invoice" type="object"
                            string="Xem hóa đơn"
                            invisible="state not in ('submitted','accepted','rejected')"/>
                    <button name="action_send_mail_draft" type="object"
                            string="Email bản nháp"
                            class="btn-secondary"
                            invisible="state == 'cancelled'"
                            confirm="Gửi email thông báo lập hóa đơn (bản nháp) cho khách hàng?"/>
                    <button name="action_send_mail_published" type="object"
                            string="Email bản chính"
                            class="btn-secondary"
                            invisible="state not in ('submitted','accepted')"
                            confirm="Gửi email hóa đơn đã cấp mã (bản chính thức) cho khách hàng?"/>
                    <button name="action_open_send_mail_wizard" type="object"
                            string="Soạn email…"
                            invisible="state == 'cancelled'"/>
                    <button name="action_cancel" type="object"
                            string="Hủy"
                            invisible="state != 'draft'"
                            groups="amis_callback.group_meinvoice_accountant"
                            confirm="Hủy hóa đơn này?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,accepted,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="sale_order_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                        </group>
                        <group/>
                    </group>
                    <notebook>
                        <page string="Thông tin hóa đơn" name="invoice_info">
                            <group string="Thông tin phát hành">
                                <group>
                                    <field name="inv_series" readonly="state != 'draft'"/>
                                    <field name="inv_date" readonly="state != 'draft'"/>
                                    <field name="payment_method" readonly="state != 'draft'"/>
                                </group>
                            </group>
                            <group string="Thông tin người mua">
                                <group>
                                    <field name="buyer_legal_name" readonly="state != 'draft'"/>
                                    <field name="buyer_full_name" readonly="state != 'draft'"/>
                                    <field name="buyer_tax_code" readonly="state != 'draft'"/>
                                </group>
                                <group>
                                    <field name="buyer_address" readonly="state != 'draft'"/>
                                    <field name="buyer_phone" readonly="state != 'draft'"/>
                                    <field name="buyer_email" readonly="state != 'draft'"/>
                                </group>
                            </group>
                        </page>
                        <page string="Chi tiết hàng hóa" name="invoice_lines">
                            <field name="line_ids" nolabel="1" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sort_order" string="STT"/>
                                    <field name="item_code" string="Mã hàng"/>
                                    <field name="item_name" string="Tên hàng hóa/dịch vụ"/>
                                    <field name="unit_name" string="ĐVT"/>
                                    <field name="quantity" string="Số lượng"/>
                                    <field name="unit_price" string="Đơn giá"/>
                                    <field name="discount_rate" string="% CK"/>
                                    <field name="discount_amount_oc" string="Tiền CK"/>
                                    <field name="amount_without_vat_oc" string="Trước thuế"/>
                                    <field name="vat_rate_name" string="Thuế suất"/>
                                    <field name="vat_amount_oc" string="Tiền thuế"/>
                                    <field name="amount_oc" string="Thành tiền"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right" string=" ">
                                <field name="total_sale_oc" string="Tổng thành tiền"/>
                                <field name="total_discount_oc" string="Chiết khấu"/>
                                <field name="total_net_oc" string="Trước thuế"/>
                                <field name="total_vat_oc" string="Thuế GTGT"/>
                                <field name="total_amount_oc" class="oe_subtotal_footer_separator"/>
                                <field name="total_amount_in_words" string="Bằng chữ"/>
                            </group>
                        </page>
                        <page string="Kết quả phát hành" name="result_info"
                              invisible="state == 'draft'">
                            <group>
                                <group>
                                    <field name="inv_no" readonly="1" string="Số hóa đơn"/>
                                    <field name="inv_series_result" readonly="1" string="Ký hiệu"/>
                                    <field name="inv_date_result" readonly="1" string="Ngày HĐ"/>
                                </group>
                                <group>
                                    <field name="inv_code" readonly="1" string="Mã CQT"/>
                                    <field name="transaction_id" readonly="1" string="Transaction ID"/>
                                </group>
                            </group>
                            <group string="Trạng thái Cơ quan Thuế">
                                <group>
                                    <field name="state" readonly="1" widget="badge"
                                           decoration-info="state == 'submitted'"
                                           decoration-success="state == 'accepted'"
                                           decoration-danger="state == 'rejected'"/>
                                    <field name="cqt_status_desc" readonly="1" string="Mô tả"/>
                                </group>
                                <group>
                                    <field name="cqt_checked_at" readonly="1" string="Kiểm tra lúc"/>
                                    <field name="cqt_check_queued" readonly="1" string="Trong queue"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                    <group string="Email gửi khách hàng">
                        <group>
                            <field name="mail_sent" readonly="1"/>
                            <field name="mail_last_sent_to" readonly="1"/>
                        </group>
                        <group>
                            <field name="mail_last_sent_at" readonly="1"/>
                            <field name="mail_sent_count" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List view -->
    <record id="view_meinvoice_invoice_list" model="ir.ui.view">
        <field name="name">meinvoice.invoice.list</field>
        <field name="model">meinvoice.invoice</field>
        <field name="arch" type="xml">
            <list string="Hóa đơn điện tử meInvoice" default_order="create_date desc"
                  delete="false"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'submitted'"
                  decoration-success="state == 'accepted'"
                  decoration-danger="state == 'rejected'"
                  decoration-muted="state == 'cancelled'">
                <field name="create_date" string="Ngày tạo" optional="show"/>
                <field name="sale_order_id" string="Đơn hàng"/>
                <field name="partner_id" string="Khách hàng"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state == 'accepted'"
                       decoration-danger="state in ('rejected','cancelled')"/>
                <field name="inv_series" string="Ký hiệu"/>
                <field name="inv_date" string="Ngày HĐ"/>
                <field name="buyer_legal_name" string="Tên người mua"/>
                <field name="buyer_tax_code" string="MST" optional="show"/>
                <field name="total_amount_oc" string="Tổng tiền" widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="inv_no" string="Số HĐ"/>
                <field name="inv_code" string="Mã CQT" optional="show"/>
                <field name="cqt_status_desc" string="Kết quả CQT" optional="show"/>
                <field name="cqt_check_queued" string="Trong queue" optional="show" widget="boolean"/>
                <field name="cqt_checked_at" string="Check lúc" optional="hide"/>
                <field name="transaction_id" string="Transaction ID" optional="hide"/>
                <!-- virtual currency field for monetary widget -->
                <field name="currency_id" invisible="1"/>
                <button name="action_publish" type="object" string="Gửi CQT"
                        icon="fa-paper-plane"
                        invisible="state != 'draft'"
                        groups="amis_callback.group_meinvoice_accountant"
                        confirm="Gửi hóa đơn này lên Cơ quan Thuế?"/>
                <button name="action_preview_invoice" type="object" string="Xem trước"
                        icon="fa-eye"
                        invisible="state != 'draft'"/>
                <button name="action_check_cqt_status" type="object" string="CQT?"
                        icon="fa-refresh"
                        invisible="state not in ('submitted',)"/>
                <button name="action_download_pdf" type="object" string="PDF"
                        icon="fa-download"
                        invisible="state not in ('submitted','accepted','rejected')"/>
                <button name="action_view_invoice" type="object" string="Xem HĐ"
                        icon="fa-eye"
                        invisible="state not in ('submitted','accepted','rejected')"/>
                <button name="action_send_mail_draft" type="object" string="Mail nháp"
                        icon="fa-envelope-o"
                        invisible="state == 'cancelled'"
                        confirm="Gửi email bản nháp?"/>
                <button name="action_send_mail_published" type="object" string="Mail chính"
                        icon="fa-envelope"
                        invisible="state not in ('submitted','accepted')"
                        confirm="Gửi email bản chính thức?"/>
                <field name="mail_sent" string="Đã mail" optional="show" widget="boolean"/>
            </list>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_meinvoice_invoice_search" model="ir.ui.view">
        <field name="name">meinvoice.invoice.search</field>
        <field name="model">meinvoice.invoice</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm hóa đơn điện tử">
                <field name="sale_order_id" string="Đơn hàng"/>
                <field name="partner_id" string="Khách hàng"/>
                <field name="inv_no" string="Số hóa đơn"/>
                <field name="inv_series" string="Ký hiệu"/>
                <field name="buyer_legal_name" string="Tên người mua"/>
                <field name="buyer_tax_code" string="MST"/>
                <field name="transaction_id" string="Transaction ID"/>
                <separator/>
                <filter name="filter_draft" string="Nháp" domain="[('state','=','draft')]"/>
                <filter name="filter_submitted" string="Đã gửi CQT" domain="[('state','=','submitted')]"/>
                <filter name="filter_accepted" string="CQT chấp nhận" domain="[('state','=','accepted')]"/>
                <filter name="filter_rejected" string="CQT từ chối" domain="[('state','=','rejected')]"/>
                <filter name="filter_cancelled" string="Đã hủy" domain="[('state','=','cancelled')]"/>
                <filter name="filter_in_queue" string="Đang chờ CQT" domain="[('cqt_check_queued','=',True)]" help="Hóa đơn đang trong hàng đợi, cron sẽ tự kiểm tra kết quả CQT"/>
                <separator/>
                <filter name="filter_today" string="Hôm nay"
                        domain="[('create_date','&gt;=', (context_today()).strftime('%Y-%m-%d 00:00:00')),
                                 ('create_date','&lt;=', (context_today()).strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter name="filter_this_month" string="Tháng này"
                        domain="[('inv_date','&gt;=',(context_today()).strftime('%Y-%m-01'))]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_state" string="Trạng thái" context="{'group_by': 'state'}"/>
                    <filter name="group_partner" string="Khách hàng" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_inv_date" string="Ngày HĐ" context="{'group_by': 'inv_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action window (dùng cho menu chính) -->
    <record id="action_meinvoice_invoice" model="ir.actions.act_window">
        <field name="name">Hóa đơn điện tử</field>
        <field name="res_model">meinvoice.invoice</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_meinvoice_invoice_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_meinvoice_invoice_form')}),
        ]"/>
        <field name="search_view_id" ref="view_meinvoice_invoice_search"/>
        <field name="context">{'search_default_filter_draft': 0}</field>
    </record>
</odoo>
