<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_meinvoice_publish_wizard_form" model="ir.ui.view">
        <field name="name">meinvoice.publish.wizard.form</field>
        <field name="model">meinvoice.publish.wizard</field>
        <field name="arch" type="xml">
            <form string="Xem trước hóa đơn điện tử">
                <sheet>
                    <div class="oe_title">
                        <h1>Kiểm tra &amp; xác nhận phát hành HĐĐT</h1>
                        <p class="text-muted">
                            Đơn hàng: <strong><field name="sale_order_id" readonly="1" nolabel="1"/></strong>
                        </p>
                    </div>

                    <group string="Thông tin hóa đơn">
                        <group>
                            <field name="inv_series" string="Ký hiệu hóa đơn"/>
                            <field name="inv_date" string="Ngày phát hành"/>
                            <field name="payment_method" string="Phương thức thanh toán"/>
                        </group>
                    </group>

                    <group string="Thông tin người mua">
                        <group>
                            <field name="buyer_legal_name" string="Tên đơn vị/người mua"/>
                            <field name="buyer_full_name" string="Họ tên người nhận"/>
                            <field name="buyer_tax_code" string="Mã số thuế"/>
                        </group>
                        <group>
                            <field name="buyer_address" string="Địa chỉ"/>
                            <field name="buyer_phone" string="Số điện thoại"/>
                            <field name="buyer_email" string="Email"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Chi tiết hàng hóa">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="sort_order" string="STT" width="40"/>
                                    <field name="item_code" string="Mã hàng"/>
                                    <field name="item_name" string="Tên hàng hóa/dịch vụ"/>
                                    <field name="unit_name" string="ĐVT" width="60"/>
                                    <field name="quantity" string="SL" width="80"/>
                                    <field name="unit_price" string="Đơn giá" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="discount_rate" string="% CK" width="60"/>
                                    <field name="discount_amount_oc" string="Tiền CK" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="amount_without_vat_oc" string="Chưa thuế" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="vat_rate_name" string="Thuế suất" width="70"/>
                                    <field name="vat_amount_oc" string="Tiền thuế" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                </list>
                            </field>
                        </page>
                        <page string="Tổng cộng">
                            <group>
                                <group>
                                    <field name="total_sale_oc" string="Tổng thành tiền (trước CK)" readonly="1"/>
                                    <field name="total_discount_oc" string="Tổng chiết khấu" readonly="1"/>
                                    <field name="total_net_oc" string="Tổng chưa có thuế" readonly="1"/>
                                    <field name="total_vat_oc" string="Tổng thuế GTGT" readonly="1"/>
                                    <field name="total_amount_oc" string="Tổng cộng thanh toán" readonly="1"/>
                                </group>
                            </group>
                            <group>
                                <field name="total_amount_in_words" string="Số tiền bằng chữ" readonly="1" colspan="2"/>
                            </group>
                        </page>
                    </notebook>

                    <!-- invoice_data_json ẩn -->
                    <field name="invoice_data_json" invisible="1"/>
                </sheet>
                <footer>
                    <button name="action_confirm_publish" type="object"
                            string="Gửi tới Cơ quan Thuế" class="btn-primary"
                            confirm="Xác nhận phát hành hóa đơn điện tử? Hành động này sẽ gửi dữ liệu tới meInvoice và Cơ quan Thuế."/>
                    <button string="Huỷ" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
