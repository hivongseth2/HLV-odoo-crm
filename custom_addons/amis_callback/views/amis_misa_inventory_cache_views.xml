<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_amis_misa_inventory_cache_list" model="ir.ui.view">
        <field name="name">amis.misa.inventory.cache.list</field>
        <field name="model">amis.misa.inventory.cache</field>
        <field name="arch" type="xml">
            <list string="Cache hàng hóa MISA" default_order="write_date desc"
                  decoration-muted="is_deleted or misa_inactive">
                <field name="inventory_item_code"/>
                <field name="inventory_item_name"/>
                <field name="inventory_item_id"/>
                <field name="product_id"/>
                <field name="unit_name"/>
                <field name="main_unit_name"/>
                <field name="misa_inactive"/>
                <field name="is_deleted"/>
                <field name="misa_modified_date"/>
                <field name="misa_deleted_at"/>
                <field name="last_seen_at"/>
            </list>
        </field>
    </record>

    <record id="view_amis_misa_inventory_cache_form" model="ir.ui.view">
        <field name="name">amis.misa.inventory.cache.form</field>
        <field name="model">amis.misa.inventory.cache</field>
        <field name="arch" type="xml">
            <form string="Cache hàng hóa MISA">
                <sheet>
                    <group>
                        <group>
                            <field name="config_id"/>
                            <field name="product_id"/>
                            <field name="inventory_item_code"/>
                            <field name="inventory_item_name"/>
                            <field name="inventory_item_id"/>
                        </group>
                        <group>
                            <field name="unit_id"/>
                            <field name="unit_name"/>
                            <field name="main_unit_id"/>
                            <field name="main_unit_name"/>
                            <field name="misa_inactive"/>
                            <field name="is_deleted"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="misa_created_date"/>
                            <field name="misa_modified_date"/>
                            <field name="misa_deleted_at"/>
                            <field name="last_seen_at"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Quy đổi ĐVT">
                            <field name="unit_convert_json" nolabel="1" readonly="1"/>
                        </page>
                        <page string="Dữ liệu gốc">
                            <field name="raw_json" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_amis_misa_inventory_cache_search" model="ir.ui.view">
        <field name="name">amis.misa.inventory.cache.search</field>
        <field name="model">amis.misa.inventory.cache</field>
        <field name="arch" type="xml">
            <search string="Tìm cache hàng hóa MISA">
                <field name="inventory_item_code"/>
                <field name="inventory_item_name"/>
                <field name="inventory_item_id"/>
                <field name="product_id"/>
                <filter name="active_misa" string="Đang dùng" domain="[('is_deleted', '=', False), ('misa_inactive', '=', False)]"/>
                <filter name="inactive_misa" string="Ngừng dùng/xóa" domain="['|', ('is_deleted', '=', True), ('misa_inactive', '=', True)]"/>
                <filter name="mapped_odoo" string="Đã map Odoo" domain="[('product_id', '!=', False)]"/>
                <filter name="unmapped_odoo" string="Chưa map Odoo" domain="[('product_id', '=', False)]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_config" string="Cấu hình" context="{'group_by': 'config_id'}"/>
                    <filter name="group_unit" string="ĐVT" context="{'group_by': 'unit_name'}"/>
                    <filter name="group_deleted" string="Đã xóa" context="{'group_by': 'is_deleted'}"/>
                    <filter name="group_inactive" string="Ngừng dùng" context="{'group_by': 'misa_inactive'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_amis_misa_inventory_cache" model="ir.actions.act_window">
        <field name="name">Cache hàng hóa MISA</field>
        <field name="res_model">amis.misa.inventory.cache</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_amis_misa_inventory_cache_search"/>
        <field name="context">{'search_default_active_misa': 1}</field>
    </record>

    <record id="view_amis_callback_config_form_inventory_cache" model="ir.ui.view">
        <field name="name">amis.callback.config.form.inventory.cache</field>
        <field name="model">amis.callback.config</field>
        <field name="inherit_id" ref="amis_callback.view_amis_callback_config_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_sync_product_catalog_to_odoo']" position="after">
                <button name="action_sync_inventory_cache_incremental" type="object"
                        string="Cập nhật cache hàng hóa" class="btn-secondary"/>
                <button name="action_sync_inventory_cache_full" type="object"
                        string="Full sync cache hàng hóa" class="btn-secondary"/>
                <button name="action_open_inventory_cache" type="object"
                        string="Xem cache hàng hóa" class="btn-secondary"/>
            </xpath>
            <xpath expr="//field[@name='misa_stock_id']" position="after">
                <field name="misa_inventory_cache_last_sync_time" readonly="1"/>
                <field name="misa_inventory_cache_delete_last_sync_time" readonly="1"/>
                <field name="misa_inventory_cache_overlap_minutes"/>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_amis_misa_inventory_cache"
              name="Cache hàng hóa MISA"
              parent="amis_callback.menu_amis_callback_root"
              action="action_amis_misa_inventory_cache"
              sequence="19"
              groups="amis_callback.group_meinvoice_manager"/>
</odoo>
