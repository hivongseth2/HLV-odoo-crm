<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_amis_misa_inventory_cache_list" model="ir.ui.view">
        <field name="name">amis.misa.inventory.cache.list</field>
        <field name="model">amis.misa.inventory.cache</field>
        <field name="arch" type="xml">
            <list string="Cache hàng hóa MISA" default_order="write_date desc"
                  decoration-muted="is_deleted or misa_inactive">
                <field name="inventory_item_code"/>
                <field name="inventory_item_name"/>
                <field name="inventory_item_id"/>
                <field name="product_id"/>
                <field name="unit_name"/>
                <field name="main_unit_name"/>
                <field name="misa_inactive"/>
                <field name="is_deleted"/>
                <field name="misa_modified_date"/>
                <field name="misa_deleted_at"/>
                <field name="last_seen_at"/>
            </list>
        </field>
    </record>

    <record id="view_amis_misa_inventory_cache_form" model="ir.ui.view">
        <field name="name">amis.misa.inventory.cache.form</field>
        <field name="model">amis.misa.inventory.cache</field>
        <field name="arch" type="xml">
            <form string="Cache hàng hóa MISA">
                <sheet>
                    <group>
                        <group>
                            <field name="config_id"/>
                            <field name="product_id"/>
                            <field name="inventory_item_code"/>
                            <field name="inventory_item_name"/>
                            <field name="inventory_item_id"/>
                        </group>
                        <group>
                            <field name="unit_id"/>
                            <field name="unit_name"/>
                            <field name="main_unit_id"/>
                            <field name="main_unit_name"/>
                            <field name="misa_inactive"/>
                            <field name="is_deleted"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="misa_created_date"/>
                            <field name="misa_modified_date"/>
                            <field name="misa_deleted_at"/>
                            <field name="last_seen_at"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Quy đổi ĐVT">
                            <field name="unit_convert_json" nolabel="1" readonly="1"/>
                        </page>
                        <page string="Dữ liệu gốc">
                            <field name="raw_json" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_amis_misa_inventory_cache_search" model="ir.ui.view">
        <field name="name">amis.misa.inventory.cache.search</field>
        <field name="model">amis.misa.inventory.cache</field>
        <field name="arch" type="xml">
            <search string="Tìm cache hàng hóa MISA">
                <field name="inventory_item_code"/>
                <field name="inventory_item_name"/>
                <field name="inventory_item_id"/>
                <field name="product_id"/>
                <filter name="active_misa" string="Đang dùng" domain="[('is_deleted', '=', False), ('misa_inactive', '=', False)]"/>
                <filter name="inactive_misa" string="Ngừng dùng/xóa" domain="['|', ('is_deleted', '=', True), ('misa_inactive', '=', True)]"/>
                <filter name="mapped_odoo" string="Đã map Odoo" domain="[('product_id', '!=', False)]"/>
                <filter name="unmapped_odoo" string="Chưa map Odoo" domain="[('product_id', '=', False)]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_config" string="Cấu hình" context="{'group_by': 'config_id'}"/>
                    <filter name="group_unit" string="ĐVT" context="{'group_by': 'unit_name'}"/>
                    <filter name="group_deleted" string="Đã xóa" context="{'group_by': 'is_deleted'}"/>
                    <filter name="group_inactive" string="Ngừng dùng" context="{'group_by': 'misa_inactive'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_amis_misa_inventory_cache" model="ir.actions.act_window">
        <field name="name">Cache hàng hóa MISA</field>
        <field name="res_model">amis.misa.inventory.cache</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_amis_misa_inventory_cache_search"/>
        <field name="context">{'search_default_active_misa': 1}</field>
    </record>

    <record id="view_amis_callback_config_form_inventory_cache" model="ir.ui.view">
        <field name="name">amis.callback.config.form.inventory.cache</field>
        <field name="model">amis.callback.config</field>
        <field name="inherit_id" ref="amis_callback.view_amis_callback_config_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_enqueue_misa_mirror_incremental']" position="after">
                <button name="action_open_inventory_cache" type="object"
                        string="Xem cache hàng hóa" class="btn-secondary"/>
            </xpath>
            <xpath expr="//field[@name='misa_stock_id']" position="after">
                <field name="misa_unit_cache_last_sync_time" readonly="1"/>
                <field name="misa_unit_cache_delete_last_sync_time" readonly="1"/>
                <field name="misa_inventory_cache_last_sync_time" readonly="1"/>
                <field name="misa_inventory_cache_delete_last_sync_time" readonly="1"/>
                <field name="misa_vendor_cache_last_sync_time" readonly="1"/>
                <field name="misa_vendor_cache_delete_last_sync_time" readonly="1"/>
                <field name="misa_inventory_cache_overlap_minutes"/>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_amis_misa_inventory_cache"
              name="Cache hàng hóa MISA"
              parent="amis_callback.menu_amis_callback_root"
              action="action_amis_misa_inventory_cache"
              sequence="19"
              groups="amis_callback.group_meinvoice_manager"/>

    <record id="view_amis_misa_unit_cache_list" model="ir.ui.view">
        <field name="name">amis.misa.unit.cache.list</field>
        <field name="model">amis.misa.unit.cache</field>
        <field name="arch" type="xml">
            <list string="Cache ĐVT MISA" default_order="write_date desc"
                  decoration-muted="is_deleted or misa_inactive">
                <field name="unit_name"/>
                <field name="unit_id"/>
                <field name="uom_id"/>
                <field name="misa_inactive"/>
                <field name="is_deleted"/>
                <field name="misa_modified_date"/>
                <field name="misa_deleted_at"/>
                <field name="last_seen_at"/>
            </list>
        </field>
    </record>

    <record id="view_amis_misa_unit_cache_form" model="ir.ui.view">
        <field name="name">amis.misa.unit.cache.form</field>
        <field name="model">amis.misa.unit.cache</field>
        <field name="arch" type="xml">
            <form string="Cache ĐVT MISA">
                <sheet>
                    <group>
                        <group>
                            <field name="config_id"/>
                            <field name="uom_id"/>
                            <field name="unit_name"/>
                            <field name="unit_id"/>
                        </group>
                        <group>
                            <field name="misa_inactive"/>
                            <field name="is_deleted"/>
                            <field name="misa_created_date"/>
                            <field name="misa_modified_date"/>
                            <field name="misa_deleted_at"/>
                            <field name="last_seen_at"/>
                        </group>
                    </group>
                    <group string="Dữ liệu gốc">
                        <field name="raw_json" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_amis_misa_unit_cache_search" model="ir.ui.view">
        <field name="name">amis.misa.unit.cache.search</field>
        <field name="model">amis.misa.unit.cache</field>
        <field name="arch" type="xml">
            <search string="Tìm cache ĐVT MISA">
                <field name="unit_name"/>
                <field name="unit_id"/>
                <field name="uom_id"/>
                <filter name="active_misa" string="Đang dùng" domain="[('is_deleted', '=', False), ('misa_inactive', '=', False)]"/>
                <filter name="inactive_misa" string="Ngừng dùng/xóa" domain="['|', ('is_deleted', '=', True), ('misa_inactive', '=', True)]"/>
                <filter name="mapped_odoo" string="Đã map Odoo" domain="[('uom_id', '!=', False)]"/>
                <filter name="unmapped_odoo" string="Chưa map Odoo" domain="[('uom_id', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_amis_misa_unit_cache" model="ir.actions.act_window">
        <field name="name">Cache ĐVT MISA</field>
        <field name="res_model">amis.misa.unit.cache</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_amis_misa_unit_cache_search"/>
        <field name="context">{'search_default_active_misa': 1}</field>
    </record>

    <record id="view_amis_misa_vendor_cache_list" model="ir.ui.view">
        <field name="name">amis.misa.vendor.cache.list</field>
        <field name="model">amis.misa.vendor.cache</field>
        <field name="arch" type="xml">
            <list string="Cache nhà cung cấp MISA" default_order="write_date desc"
                  decoration-muted="is_deleted or misa_inactive">
                <field name="account_object_code"/>
                <field name="account_object_name"/>
                <field name="company_tax_code"/>
                <field name="partner_id"/>
                <field name="is_vendor"/>
                <field name="is_customer"/>
                <field name="misa_inactive"/>
                <field name="is_deleted"/>
                <field name="misa_modified_date"/>
                <field name="last_seen_at"/>
            </list>
        </field>
    </record>

    <record id="view_amis_misa_vendor_cache_form" model="ir.ui.view">
        <field name="name">amis.misa.vendor.cache.form</field>
        <field name="model">amis.misa.vendor.cache</field>
        <field name="arch" type="xml">
            <form string="Cache nhà cung cấp MISA">
                <sheet>
                    <group>
                        <group>
                            <field name="config_id"/>
                            <field name="partner_id"/>
                            <field name="account_object_code"/>
                            <field name="account_object_name"/>
                            <field name="account_object_id"/>
                            <field name="company_tax_code"/>
                        </group>
                        <group>
                            <field name="tel"/>
                            <field name="mobile"/>
                            <field name="email"/>
                            <field name="is_vendor"/>
                            <field name="is_customer"/>
                            <field name="misa_inactive"/>
                            <field name="is_deleted"/>
                        </group>
                    </group>
                    <group>
                        <field name="address"/>
                        <field name="ward_or_commune"/>
                        <field name="district"/>
                        <field name="province_or_city"/>
                        <field name="country"/>
                    </group>
                    <notebook>
                        <page string="Ngân hàng">
                            <field name="bank_line_ids" readonly="1">
                                <list string="Tài khoản ngân hàng MISA" create="false" edit="false" delete="false">
                                    <field name="active"/>
                                    <field name="acc_number"/>
                                    <field name="bank_name"/>
                                    <field name="bank_code"/>
                                    <field name="branch_name"/>
                                    <field name="bank_city"/>
                                    <field name="account_holder"/>
                                    <field name="partner_bank_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Dữ liệu gốc">
                            <field name="raw_json" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_amis_misa_vendor_cache_search" model="ir.ui.view">
        <field name="name">amis.misa.vendor.cache.search</field>
        <field name="model">amis.misa.vendor.cache</field>
        <field name="arch" type="xml">
            <search string="Tìm cache nhà cung cấp MISA">
                <field name="account_object_code"/>
                <field name="account_object_name"/>
                <field name="company_tax_code"/>
                <field name="partner_id"/>
                <filter name="vendor_only" string="Là nhà cung cấp" domain="[('is_vendor', '=', True)]"/>
                <filter name="active_misa" string="Đang dùng" domain="[('is_deleted', '=', False), ('misa_inactive', '=', False)]"/>
                <filter name="inactive_misa" string="Ngừng dùng/xóa" domain="['|', ('is_deleted', '=', True), ('misa_inactive', '=', True)]"/>
                <filter name="mapped_odoo" string="Đã map Odoo" domain="[('partner_id', '!=', False)]"/>
                <filter name="unmapped_odoo" string="Chưa map Odoo" domain="[('partner_id', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_amis_misa_vendor_cache" model="ir.actions.act_window">
        <field name="name">Cache nhà cung cấp MISA</field>
        <field name="res_model">amis.misa.vendor.cache</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_amis_misa_vendor_cache_search"/>
        <field name="context">{'search_default_vendor_only': 1, 'search_default_active_misa': 1}</field>
    </record>

    <menuitem id="menu_amis_misa_unit_cache"
              name="Cache ĐVT MISA"
              parent="amis_callback.menu_amis_callback_root"
              action="action_amis_misa_unit_cache"
              sequence="18"
              groups="amis_callback.group_meinvoice_manager"/>
    <menuitem id="menu_amis_misa_vendor_cache"
              name="Cache nhà cung cấp MISA"
              parent="amis_callback.menu_amis_callback_root"
              action="action_amis_misa_vendor_cache"
              sequence="21"
              groups="amis_callback.group_meinvoice_manager"/>
</odoo>
