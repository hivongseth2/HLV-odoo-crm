<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Wizard Form View -->
    <record id="view_misa_return_sale_sync_wizard_form" model="ir.ui.view">
        <field name="name">misa.return.sale.sync.wizard.form</field>
        <field name="model">misa.return.sale.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="Đồng bộ đề nghị trả hàng từ MISA">
                <group invisible="state == 'done'">
                    <group>
                        <field name="from_date" />
                        <field name="to_date" />
                    </group>
                </group>
                <group invisible="state != 'done'">
                    <field name="log_text" widget="text" readonly="1" nolabel="1" />
                </group>
                <field name="state" invisible="1" />
                <footer>
                    <button
                        name="action_sync"
                        string="Đồng bộ"
                        type="object"
                        class="btn-primary"
                        invisible="state == 'done'"
                    />
                    <button
                        name="action_reset"
                        string="Chạy lại"
                        type="object"
                        class="btn-secondary"
                        invisible="state != 'done'"
                    />
                    <button string="Đóng" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_misa_return_sale_sync_wizard" model="ir.actions.act_window">
        <field name="name">Đồng bộ từ MISA</field>
        <field name="res_model">misa.return.sale.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
