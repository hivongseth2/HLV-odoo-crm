<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Security Groups -->
    <record id="group_return_sale_request_user" model="res.groups">
        <field name="name">Đề nghị trả hàng: User</field>
        <field name="category_id" ref="base.module_category_inventory_inventory" />
    </record>

    <record id="group_return_sale_request_manager" model="res.groups">
        <field name="name">Đề nghị trả hàng: Manager</field>
        <field name="category_id" ref="base.module_category_inventory_inventory" />
        <field name="implied_ids" eval="[(4, ref('group_return_sale_request_user'))]" />
    </record>

    <!-- Record Rules -->
    <record id="return_sale_request_company_rule" model="ir.rule">
        <field name="name">Return Sale Request: Company Rule</field>
        <field name="model_id" ref="model_return_sale_request" />
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
    </record>
</odoo>
