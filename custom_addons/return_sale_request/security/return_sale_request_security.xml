<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Module Category -->
    <record id="module_category_return_sale_request" model="ir.module.category">
        <field name="name">Trả hàng bán</field>
        <field name="description">Quản lý đề nghị trả hàng bán.</field>
        <field name="sequence">10</field>
    </record>

    <!-- Security Groups -->
    <record id="group_return_sale_request_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_return_sale_request" />
    </record>

    <record id="group_return_sale_request_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_return_sale_request" />
        <field name="implied_ids" eval="[(4, ref('group_return_sale_request_user'))]" />
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
    </record>

    <!-- Record Rules -->
    <record id="return_sale_request_company_rule" model="ir.rule">
        <field name="name">Return Sale Request: Company Rule</field>
        <field name="model_id" ref="model_return_sale_request" />
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
    </record>
</odoo>
