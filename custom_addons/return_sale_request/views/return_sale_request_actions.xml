<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Server Action: Bulk Submit (Gửi duyệt hàng loạt) -->
    <record id="action_bulk_submit" model="ir.actions.server">
        <field name="name">Gửi duyệt hàng loạt</field>
        <field name="model_id" ref="model_return_sale_request" />
        <field name="binding_model_id" ref="model_return_sale_request" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
records.filtered(lambda r: r.state == 'draft').button_submit()
        </field>
    </record>

    <!-- Server Action: Bulk Approve (Phê duyệt hàng loạt) -->
    <record id="action_bulk_approve" model="ir.actions.server">
        <field name="name">Phê duyệt hàng loạt</field>
        <field name="model_id" ref="model_return_sale_request" />
        <field name="binding_model_id" ref="model_return_sale_request" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="groups_id" eval="[(4, ref('return_sale_request.group_return_sale_request_manager'))]" />
        <field name="code">
records.filtered(lambda r: r.state == 'to_approve').button_approve()
        </field>
    </record>

    <!-- Server Action: Bulk Confirm Incoming (Xác nhận nhập kho hàng loạt) -->
    <record id="action_bulk_confirm_incoming" model="ir.actions.server">
        <field name="name">Xác nhận nhập kho hàng loạt</field>
        <field name="model_id" ref="model_return_sale_request" />
        <field name="binding_model_id" ref="model_return_sale_request" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
records.filtered(lambda r: r.state == 'approved').button_confirm_incoming()
        </field>
    </record>

    <!-- Server Action: Bulk Done (Hoàn thành hàng loạt) -->
    <record id="action_bulk_done" model="ir.actions.server">
        <field name="name">Hoàn thành hàng loạt</field>
        <field name="model_id" ref="model_return_sale_request" />
        <field name="binding_model_id" ref="model_return_sale_request" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
records.filtered(lambda r: r.state == 'in_progress').button_done()
        </field>
    </record>

    <!-- Server Action: Bulk Reject (Từ chối hàng loạt) -->
    <record id="action_bulk_reject" model="ir.actions.server">
        <field name="name">Từ chối hàng loạt</field>
        <field name="model_id" ref="model_return_sale_request" />
        <field name="binding_model_id" ref="model_return_sale_request" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="groups_id" eval="[(4, ref('return_sale_request.group_return_sale_request_manager'))]" />
        <field name="code">
records.filtered(lambda r: r.state in ('to_approve', 'approved')).button_reject()
        </field>
    </record>

    <!-- Server Action: Bulk Reset to Draft (Đặt về nháp hàng loạt) -->
    <record id="action_bulk_draft" model="ir.actions.server">
        <field name="name">Đặt về nháp hàng loạt</field>
        <field name="model_id" ref="model_return_sale_request" />
        <field name="binding_model_id" ref="model_return_sale_request" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="groups_id" eval="[(4, ref('return_sale_request.group_return_sale_request_manager'))]" />
        <field name="code">
records.filtered(lambda r: r.state in ('to_approve', 'rejected') and not r.picking_in_id and not r.picking_out_id).button_draft()
        </field>
    </record>
</odoo>
