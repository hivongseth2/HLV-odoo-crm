<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Client action for quick preview panel -->
    <record id="action_hlv_po_preview_panel" model="ir.actions.client">
        <field name="name">Xem nhanh đơn mua</field>
        <field name="tag">hlv_po_preview_panel</field>
        <field name="target">current</field>
    </record>

    <!-- Inherit purchase order tree view to add preview button -->
    <record id="hlv_purchase_order_tree_preview" model="ir.ui.view">
        <field name="name">purchase.order.tree.hlv.preview</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <!-- Add preview button at the end -->
            <xpath expr="//list" position="inside">
                <button
                    type="action"
                    string="👁 Xem"
                    title="Xem sơ lược sản phẩm"
                    class="btn btn-sm btn-outline-primary hlv-po-quick-btn"
                    name="%(action_hlv_po_preview_panel)d"
                    context="{'active_id': id}"
                />
            </xpath>
        </field>
    </record>

    <!-- Inherit search view to add product search and status filters -->
    <record id="hlv_purchase_order_search_product" model="ir.ui.view">
        <field name="name">purchase.order.search.hlv.product</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <!-- Add product search field after partner_id -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="order_line" string="Sản phẩm"
                       filter_domain="['|', ('order_line.product_id.name', 'ilike', self), ('order_line.product_id.default_code', 'ilike', self)]"/>
            </xpath>

            <!-- Add separator and invoice status filters group -->
            <xpath expr="//separator[1]" position="before">
                <separator/>
                <filter string="Trạng thái thanh toán" name="filter_invoice_header" invisible="1"/>
                <filter string="Chưa lập hóa đơn" name="filter_invoice_no"
                        domain="[('invoice_status', '=', 'no')]"/>
                <filter string="Cần lập hóa đơn" name="filter_invoice_to_invoice"
                        domain="[('invoice_status', '=', 'to invoice')]"/>
                <filter string="Đã lập hóa đơn đầy đủ" name="filter_invoice_invoiced"
                        domain="[('invoice_status', '=', 'invoiced')]"/>
                <separator/>
                <filter string="Trạng thái nhập kho" name="filter_receipt_header" invisible="1"/>
                <filter string="Chờ nhận hàng" name="filter_receipt_pending"
                        domain="[('receipt_status', '=', 'pending')]"/>
                <filter string="Nhận một phần" name="filter_receipt_partial"
                        domain="[('receipt_status', '=', 'partial')]"/>
                <filter string="Đã nhận đủ" name="filter_receipt_full"
                        domain="[('receipt_status', '=', 'full')]"/>
            </xpath>

            <!-- Add group by for statuses -->
            <xpath expr="//group" position="inside">
                <filter string="Trạng thái thanh toán" name="groupby_invoice_status"
                        context="{'group_by': 'invoice_status'}"/>
                <filter string="Trạng thái nhập kho" name="groupby_receipt_status"
                        context="{'group_by': 'receipt_status'}"/>
            </xpath>
        </field>
    </record>

</odoo>
