#. module: llm_thread
#: code:addons/llm_thread/models/__init__.py:0
#, python-format
msgid "This conversation is currently generating a response. Please wait for it to complete before sending another message."
msgstr "Cuộc trò chuyện này đang tạo phản hồi. Vui lòng đợi hoàn tất trước khi gửi tin nhắn khác."

#. module: llm_thread
#: code:addons/llm_thread/models/__init__.py:0
#, python-format
msgid "Unable to process your request due to a system conflict. Please wait a moment and try again."
msgstr "Không thể xử lý yêu cầu do xung đột hệ thống. Vui lòng đợi một chút và thử lại."

#. module: llm_thread
#: code:addons/llm_thread/models/__init__.py:0
#, python-format
msgid "Your request could not be processed. Please refresh the page and try again."
msgstr "Không thể xử lý yêu cầu. Vui lòng tải lại trang và thử lại."

#. module: llm_thread
#: code:addons/llm_thread/models/__init__.py:0
#, python-format
