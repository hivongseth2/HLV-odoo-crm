msgstr "Cuộc trò chuyện"

#. module: llm_thread
#: model_terms:ir.ui.view,arch_db:llm_thread.llm_thread_views
msgid "Create your first chat thread!"
msgstr "Tạo cuộc trò chuyện đầu tiên!"

#. module: llm_thread
#: model_terms:ir.ui.view,arch_db:llm_thread.llm_thread_views
msgid "Start a conversation with any of your configured LLM providers."
msgstr "Bắt đầu trò chuyện với bất kỳ nhà cung cấp AI nào đã cấu hình."

#. module: llm_thread
#: model:ir.actions.client,name:llm_thread.action_llm_chat
