#. module: llm_thread
#: model:llm.thread,_description
msgid "LLM Chat Thread"
msgstr "Cuộc trò chuyện AI"

#. module: llm_thread
#: model:llm.thread,field_description:llm_thread.field_llm_thread__name
msgid "Title"
msgstr "Tiêu đề"

#. module: llm_thread
#: model:llm.thread,field_description:llm_thread.field_llm_thread__user_id
msgid "User"
msgstr "Người dùng"

#. module: llm_thread
#: model:llm.thread,field_description:llm_thread.field_llm_thread__provider_id
msgid "Provider"
msgstr "Nhà cung cấp"

#. module: llm_thread
#: model:llm.thread,field_description:llm_thread.field_llm_thread__model_id
msgid "Model"
msgstr "Mô hình"

#. module: llm_thread
#: model:llm.thread,field_description:llm_thread.field_llm_thread__res_model
msgid "Related Document Model"
msgstr "Mô hình tài liệu liên quan"

#. module: llm_thread
#: model:llm.thread,help:llm_thread.field_llm_thread__res_model
msgid "Technical name of the related model"
msgstr "Tên kỹ thuật của mô hình liên quan"

#. module: llm_thread
#: model:llm.thread,field_description:llm_thread.field_llm_thread__res_id
msgid "Related Document ID"
msgstr "ID tài liệu liên quan"

#. module: llm_thread
#: model:llm.thread,help:llm_thread.field_llm_thread__res_id
msgid "ID of the related record"
msgstr "ID của bản ghi liên quan"

#. module: llm_thread
#: model:llm.thread,field_description:llm_thread.field_llm_thread__tool_ids
msgid "Available Tools"
msgstr "Công cụ khả dụng"

#. module: llm_thread
#: model:llm.thread,help:llm_thread.field_llm_thread__tool_ids
msgid "Tools that can be used by the LLM in this thread"
msgstr "Công cụ mà AI có thể sử dụng trong cuộc trò chuyện này"

#. module: llm_thread
#: model:llm.thread,field_description:llm_thread.field_llm_thread__attachment_ids
msgid "All Thread Attachments"
msgstr "Tất cả tệp đính kèm"

#. module: llm_thread
#: model:llm.thread,help:llm_thread.field_llm_thread__attachment_ids
msgid "All attachments from all messages in this thread"
msgstr "Tất cả tệp đính kèm từ các tin nhắn trong cuộc trò chuyện"

#. module: llm_thread
#: model:llm.thread,field_description:llm_thread.field_llm_thread__attachment_count
msgid "Thread Attachments"
msgstr "Tệp đính kèm"

#. module: llm_thread
#: model:llm.thread,help:llm_thread.field_llm_thread__attachment_count
msgid "Total number of attachments in this thread"
msgstr "Tổng số tệp đính kèm trong cuộc trò chuyện"

#. module: llm_thread
#: code:addons/llm_thread/models/llm_thread.py
msgid "Unsupported file(s)"
msgstr "Tệp không được hỗ trợ"

#. module: llm_thread
#: code:addons/llm_thread/models/llm_thread.py
msgid "These files will be skipped."
msgstr "Các tệp này sẽ bị bỏ qua."

#. module: llm_thread
#: code:addons/llm_thread/models/llm_thread.py
msgid "Error"
msgstr "Lỗi"

#. module: llm_thread
#: code:addons/llm_thread/models/llm_thread.py
msgid "Please install the llm_assistant module for actual AI generation."
msgstr "Vui lòng cài đặt module llm_assistant để tạo AI thực tế."

#. module: llm_thread
#: code:addons/llm_thread/models/llm_thread.py
msgid "This conversation is currently generating a response. Please wait for it to complete before sending another message."
msgstr "Cuộc trò chuyện này đang tạo phản hồi. Vui lòng đợi hoàn tất trước khi gửi tin nhắn khác."

#. module: llm_thread
#: code:addons/llm_thread/models/llm_thread.py
msgid "Unable to process your request due to a system conflict. Please wait a moment and try again."
msgstr "Không thể xử lý yêu cầu do xung đột hệ thống. Vui lòng đợi một chút và thử lại."

#. module: llm_thread
#: code:addons/llm_thread/models/llm_thread.py
msgid "Your request could not be processed. Please refresh the page and try again."
msgstr "Không thể xử lý yêu cầu. Vui lòng tải lại trang và thử lại."

#. module: llm_thread
#: model:mail.message,field_description:llm_thread.field_mail_message__user_vote
msgid "User Vote"
msgstr "Đánh giá người dùng"

#. module: llm_thread
#: model:mail.message,help:llm_thread.field_mail_message__user_vote
msgid "Vote status given by the user. 0: No vote, 1: Upvoted, -1: Downvoted."
msgstr "Trạng thái đánh giá. 0: Chưa đánh giá, 1: Thích, -1: Không thích."

#. module: llm_thread
#: code:addons/llm_thread/models/mail_message.py
msgid "Voting is only allowed on messages generated by the assistant or a tool."
msgstr "Chỉ cho phép đánh giá tin nhắn do trợ lý hoặc công cụ tạo."

#. module: llm_thread
#: code:addons/llm_thread/models/mail_message.py
msgid "Invalid vote value. Must be an integer: 1 (up), -1 (down), or 0 (none)."
msgstr "Giá trị đánh giá không hợp lệ. Phải là số nguyên: 1 (thích), -1 (không thích), hoặc 0 (bỏ)."

#. module: llm_thread
#: code:addons/llm_thread/controllers/main.py
msgid "LLM Thread not found."
msgstr "Không tìm thấy cuộc trò chuyện AI."

#. module: llm_thread
#: model_terms:ir.ui.view,arch_db:llm_thread.llm_thread_views
msgid "Chat Title"
msgstr "Tiêu đề trò chuyện"

#. module: llm_thread
#: model:ir.actions.act_window,name:llm_thread.action_llm_threads
