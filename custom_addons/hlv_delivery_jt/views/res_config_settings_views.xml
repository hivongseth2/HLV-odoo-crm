<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_jt" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.jt</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='operations_setting_container']" position="after">
                <block title="J&amp;T Express" name="jt_setting_container">
                    <setting id="jt_environment_setting" string="Môi trường J&amp;T" help="Chọn môi trường Test hoặc Production">
                        <field name="jt_environment" widget="radio"/>
                    </setting>
                    <setting id="jt_auth_setting" string="Xác thực (System Parameters)" help="Cấu hình trong System Parameters">
                        <label for="jt_api_account_display" string="apiAccount (jnt_apiAccount)"/>
                        <field name="jt_api_account_display" readonly="1"/>
                        <label for="jt_private_key_display" string="privateKey (jnt_privateKey)"/>
                        <field name="jt_private_key_display" readonly="1"/>
                        <label for="jt_customer_code_display" string="customerCode (jnt_customerCode)"/>
                        <field name="jt_customer_code_display" readonly="1"/>
                        <label for="jt_password_display" string="password (jnt_password)"/>
                        <field name="jt_password_display" readonly="1"/>
                        <div class="mt-2">
                            <button name="action_check_jt_connection" type="object" string="Kiểm tra kết nối" class="btn-primary"/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
