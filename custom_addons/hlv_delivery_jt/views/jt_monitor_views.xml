<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View for J&T Monitor -->
        <record id="view_picking_tree_jt" model="ir.ui.view">
            <field name="name">stock.picking.tree.jt</field>
            <field name="model">stock.picking</field>
            <field name="arch" type="xml">
                <list string="J&amp;T Shipments" create="0">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="origin"/>
                    <field name="jt_bill_code" widget="badge"/>
                    <field name="jt_order_status" widget="badge" 
                           decoration-success="jt_order_status == 'Created'"
                           decoration-danger="jt_order_status == 'Cancelled'"/>
                    <field name="jt_total_fee" sum="Total Fee"/>
                    <field name="jt_cod_fee" sum="Total COD Fee"/>
                    <field name="jt_insurance_fee" sum="Total Insurance Fee"/>
                    <field name="state" invisible="1"/>
                </list>
            </field>
        </record>

        <!-- Search View for J&T Monitor -->
        <record id="view_picking_search_jt" model="ir.ui.view">
            <field name="name">stock.picking.search.jt</field>
            <field name="model">stock.picking</field>
            <field name="arch" type="xml">
                <search string="Search J&amp;T Shipments">
                    <field name="name"/>
                    <field name="jt_bill_code"/>
                    <field name="partner_id"/>
                    <group expand="0" string="Group By">
                        <filter string="Status" name="group_by_status" context="{'group_by': 'jt_order_status'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_jt_tracking" model="ir.actions.act_window">
            <field name="name">Quản lý Vận đơn J&amp;T</field>
            <field name="res_model">stock.picking</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('jt_bill_code', '!=', False)]</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('view_picking_tree_jt')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('stock.view_picking_form')})]"/>
            <field name="search_view_id" ref="view_picking_search_jt"/>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Chưa có đơn hàng J&amp;T nào được tạo.
              </p>
            </field>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_jt_tracking"
                  name="Quản lý J&amp;T"
                  parent="stock.menu_stock_warehouse_mgmt"
                  action="action_jt_tracking"
                  sequence="31"/>

        <!-- Server Action for Bulk Print -->
        <record id="action_jt_bulk_print_server" model="ir.actions.server">
            <field name="name">In hàng loạt J&amp;T</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="binding_model_id" ref="stock.model_stock_picking"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
                if records:
                    action = records.action_jt_bulk_print_labels()
            </field>
        </record>
    </data>
</odoo>
