<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_warehouse_form_jt_inherit" model="ir.ui.view">
        <field name="name">stock.warehouse.form.jt.inherit</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="J&amp;T Express" name="jt_config">
                    <group>
                        <group string="Địa chỉ gửi mặc định">
                            <field name="jnt_sender_name" placeholder="Tên người gửi"/>
                            <field name="jnt_sender_mobile" placeholder="Số điện thoại"/>
                            <field name="jnt_sender_address" placeholder="Địa chỉ chi tiết"/>
                            <field name="jnt_prov_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="jnt_city_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="jnt_area_id" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
