<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_warehouse_form_jt_inherit" model="ir.ui.view">
        <field name="name">stock.warehouse.form.jt.inherit</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="J&amp;T Express" name="jt_config">
                    <group>
                        <group string="Địa chỉ gửi mặc định">
                            <field name="jnt_prov_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="jnt_city_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="jnt_area_id" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                    </group>
                    <separator string="Danh sách Hồ sơ người gửi (Dùng chung J&amp;T &amp; GHN)"/>
                    <field name="sender_address_ids">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="sender_name"/>
                            <field name="sender_mobile"/>
                            <field name="sender_address"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
