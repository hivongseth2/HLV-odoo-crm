<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- We don't have the original GHN view IDs easily, so we can just add fields to the form via inherit -->
    <record id="ghn_ward_view_form_inherit_jnt" model="ir.ui.view">
        <field name="name">ghn.ward.form.inherit.jnt</field>
        <field name="model">ghn.ward</field>
        <field name="inherit_id" ref="hlv_delivery_ghn.ghn_ward_view_form" />
        <field name="arch" type="xml">
            <field name="ward_code" position="after">
                <field name="jnt_code"/>
            </field>
        </field>
    </record>

    <record id="ghn_district_view_form_inherit_jnt" model="ir.ui.view">
        <field name="name">ghn.district.form.inherit.jnt</field>
        <field name="model">ghn.district</field>
        <field name="inherit_id" ref="hlv_delivery_ghn.ghn_district_view_form" />
        <field name="arch" type="xml">
            <field name="district_id" position="after">
                <field name="jnt_code"/>
            </field>
        </field>
    </record>

    <record id="ghn_province_view_form_inherit_jnt" model="ir.ui.view">
        <field name="name">ghn.province.form.inherit.jnt</field>
        <field name="model">ghn.province</field>
        <field name="inherit_id" ref="hlv_delivery_ghn.ghn_province_view_form" />
        <field name="arch" type="xml">
            <field name="province_id" position="after">
                <field name="jnt_code"/>
            </field>
        </field>
    </record>
</odoo>
