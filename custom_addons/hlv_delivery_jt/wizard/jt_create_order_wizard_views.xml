<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="jt_create_order_wizard_view_form" model="ir.ui.view">
        <field name="name">jt.create.order.wizard.form</field>
        <field name="model">jt.create.order.wizard</field>
        <field name="arch" type="xml">
            <form string="Tạo đơn J&amp;T Express">
                <sheet>
                    <group>
                        <group string="Dịch vụ &amp; Thanh toán">
                            <field name="picking_id" readonly="1" force_save="1"/>
                            <field name="order_type"/>
                            <field name="product_type"/>
                            <field name="goods_type"/>
                            <field name="service_type"/>
                            <field name="delivery_type"/>
                            <field name="pay_type"/>
                        </group>
                        <group string="Phí &amp; Ghi chú">
                            <field name="cod_money"/>
                            <field name="is_insured"/>
                            <field name="goods_value" attrs="{'invisible': [('is_insured', '=', False)], 'required': [('is_insured', '=', True)]}"/>
                            <field name="remark"/>
                        </group>
                    </group>
                    <group string="Kích thước &amp; Khối lượng">
                        <group>
                            <field name="weight"/>
                            <field name="length"/>
                        </group>
                        <group>
                            <field name="width"/>
                            <field name="height"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_create_jt_order" type="object" string="Tạo đơn hàng" class="btn-primary"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
