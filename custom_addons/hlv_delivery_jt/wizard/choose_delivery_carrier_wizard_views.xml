<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="choose_delivery_carrier_wizard_view_form" model="ir.ui.view">
        <field name="name">choose.delivery.carrier.wizard.view.form</field>
        <field name="model">choose.delivery.carrier.wizard</field>
        <field name="arch" type="xml">
            <form string="Chọn đơn vị vận chuyển">
                <group>
                    <field name="carrier_type" widget="radio"/>
                    <field name="picking_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_confirm_carrier" string="Tiếp tục" type="object" class="btn-primary"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_choose_delivery_carrier_wizard" model="ir.actions.act_window">
        <field name="name">Chọn đơn vị vận chuyển</field>
        <field name="res_model">choose.delivery.carrier.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
