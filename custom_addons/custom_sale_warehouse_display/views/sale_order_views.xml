<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_tree_inherit_warehouse" model="ir.ui.view">
        <field name="name">sale.order.list.inherit.warehouse</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            
            <xpath expr="//list" position="inside">
                <button name="action_view_order_lines_popup" type="object" string="Xem SP" icon="fa-list-ul"/>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="warehouse_plan_names" string="Kho dự kiến" optional="show" decoration-info="1"/>
                
                <field name="warehouse_done_names" string="Kho đã xuất" optional="show" decoration-bf="1" decoration-success="warehouse_done_names != ''"/>
            </xpath>

        </field>
    </record>

    <record id="view_sales_order_filter_inherit_warehouse" model="ir.ui.view">
        <field name="name">sale.order.search.inherit.warehouse</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            
            <xpath expr="//field[@name='name']" position="after">
                <field name="warehouse_done_names" string="Tìm kho đã xuất" filter_domain="[('warehouse_done_names', 'ilike', self)]"/>
            </xpath>

            <xpath expr="//filter[@name='my_sale_orders_filter']" position="after">
                <separator/>
                <filter string="🔴 Đã xuất hôm nay" name="shipped_today"
                        domain="[('picking_ids.state','=','done'), 
                                 ('picking_ids.date_done', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')), 
                                 ('picking_ids.date_done', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                <separator/>
            </xpath>
            
            <xpath expr="//group" position="inside">
                 <filter string="Kho đã xuất" name="groupby_warehouse_done" context="{'group_by': 'warehouse_done_names'}"/>
            </xpath>

        </field>
    </record>
</odoo>