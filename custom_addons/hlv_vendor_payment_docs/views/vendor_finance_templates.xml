<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Không dùng định dạng "%s%%" trong biểu thức: Odoo nạp XML đổi "%%" thành "%" → lỗi lúc render. Ghép chuỗi.
         Kế thừa template trang NCC của chính repo (hlv_vendor_quotation) — xmlid do mình đặt, ổn định. -->

    <!-- CSS / JS của module trên mọi trang NCC (khung Thanh toán, tab Tài chính, xem nhanh chứng từ). ?v= = version +
         mã băm static của CHÍNH module này (services/asset_version.py). -->
    <template id="portal_layout_payment_assets" inherit_id="hlv_vendor_quotation.portal_layout" name="Báo giá NCC - CSS/JS thanh toán">
        <xpath expr="//head" position="inside">
            <t t-set="payment_assets" t-value="request.env['hlv.payment.document'].sudo()._hlv_asset_version()"/>
            <link rel="stylesheet" t-attf-href="/hlv_vendor_payment_docs/static/src/css/payment_docs.css?v=#{payment_assets}"/>
            <script defer="defer" t-attf-src="/hlv_vendor_payment_docs/static/src/js/doc_preview.js?v=#{payment_assets}"></script>
        </xpath>
    </template>

    <!-- Ảnh thu nhỏ một chứng từ: ảnh → hiện ảnh; PDF / Word → nhãn loại file. Bấm ảnh / PDF là xem nhanh trong trang
         (js/doc_preview.js), Word thì tải. Biến: doc, url (link mở file). -->
    <template id="doc_thumb" name="Chứng từ chi NCC - ảnh thu nhỏ">
        <t t-set="kind" t-value="doc._hlv_preview_kind()"/>
        <a t-attf-class="doc-thumb #{'doc-thumb-' + kind if kind != 'image' else ''}" t-att-href="url" target="_blank"
           t-att-data-doc-preview="kind" t-att-data-doc-name="doc.name" t-att-title="(doc.note + ' · ' + doc.name) if doc.note else doc.name">
            <img t-if="kind == 'image'" t-att-src="url" loading="lazy" alt=""/>
            <t t-else="" t-esc="doc._hlv_badge()"/>
        </a>
    </template>

    <!-- Tab "Tài chính" cạnh "Đơn mua hàng". -->
    <template id="portal_tabs_finance" inherit_id="hlv_vendor_quotation.portal_tabs" name="Báo giá NCC - tab Tài chính">
        <xpath expr="//a[contains(@t-att-href, 'don-mua')]" position="after">
            <a t-att-href="'%s/tai-chinh' % portal_base"
               t-attf-class="vq-section-tab #{'vq-section-tab-active' if active_tab == 'finance' else ''}">
                Tài chính <span class="vq-tab-count">(<t t-esc="access._hlv_finance_count()"/>)</span></a>
        </xpath>
    </template>

    <!-- Chi tiết đơn mua: mục "Uỷ nhiệm chi" trong phần thông tin đơn (trang NCC gọi đề nghị chi là "uỷ nhiệm chi" — cách
         NCC quen gọi) — mỗi đề nghị chi một chip "số · số tiền", màu theo trạng thái (xanh = đã chi, cam = đang xử lý),
         bấm vào mở thẳng trang đề nghị chi + chứng từ. -->
    <template id="portal_order_form_payment" inherit_id="hlv_vendor_quotation.portal_order_form"
              name="Báo giá NCC - đơn mua: đề nghị chi">
        <xpath expr="//dl[hasclass('vq-facts')]" position="inside">
            <t t-set="payment" t-value="order._hlv_payment_summary()"/>
            <div t-if="payment['requests']"><dt>Uỷ nhiệm chi</dt>
                <dd class="pay-chips">
                    <a t-foreach="payment['requests']" t-as="pr" t-att-href="'%s/tai-chinh/%s' % (portal_base, pr.id)"
                       t-attf-class="pay-chip #{'vq-pay-paid' if pr._hlv_is_paid() else 'vq-pay-processing'}"
                       t-att-title="pr._hlv_vendor_label() + ' · ' + fdate(pr.payment_date)">
                        <b t-esc="pr.name"/> · <t t-esc="fmt(round(pr.amount))"/></a>
                </dd></div>
            <!-- Phiếu trả công nợ nhiều đơn: chip hiện phần tiền trả vào CHÍNH đơn này. -->
            <div t-if="payment['debt_lines']"><dt>Trả công nợ</dt>
                <dd class="pay-chips">
                    <a t-foreach="payment['debt_lines']" t-as="line" t-att-href="'%s/tai-chinh/cong-no/%s' % (portal_base, line.payment_id.id)"
                       class="pay-chip vq-pay-paid" t-att-title="'Đã chi · ' + fdate(line.payment_id.payment_date)">
                        <b t-esc="line.payment_id.name"/> · <t t-esc="fmt(round(line.amount))"/></a>
                </dd></div>
        </xpath>
    </template>

    <template id="portal_finance" name="Báo giá NCC - tài chính">
        <t t-call="hlv_vendor_quotation.portal_layout">
            <t t-set="page_title" t-value="'Tài chính'"/>
            <t t-set="logged_in" t-value="True"/>
            <div class="vq-wrap">
                <t t-call="hlv_vendor_quotation.portal_tabs"/>
                <div class="vq-page-head">
                    <h1>Tài chính</h1>
                </div>

                <div class="vq-kpis">
                    <div class="vq-kpi"><span class="vq-kpi-num" t-esc="fmt(round(kpi['paid']))"/><span class="vq-kpi-label">đã chi</span></div>
                    <div class="vq-kpi" title="Uỷ nhiệm chi đã gửi kế toán, chưa duyệt chi">
                        <span class="vq-kpi-num" t-esc="fmt(round(kpi['processing']))"/><span class="vq-kpi-label">đang xử lý</span></div>
                    <div class="vq-kpi"><span class="vq-kpi-num" t-esc="fmt(round(kpi['orders_total']))"/><span class="vq-kpi-label">giá trị đơn mua đã xác nhận</span></div>
                    <div class="vq-kpi"><span class="vq-kpi-num" t-esc="fmt(round(kpi['remaining']))"/><span class="vq-kpi-label">còn lại (chưa chi)</span></div>
                </div>

                <form method="get" class="vq-history-filter" t-att-action="finance_url(q=None, status=None, docs=None, date_from=None, date_to=None, order=None, page=None)">
                    <label class="vq-filter-field vq-filter-search">
                        <span class="vq-label">Tìm</span>
                        <input type="search" name="q" class="vq-input" t-att-value="filters['q']" placeholder="Số uỷ nhiệm chi hoặc số đơn mua"/>
                    </label>
                    <label class="vq-filter-field">
                        <span class="vq-label">Đơn mua</span>
                        <select name="order" class="vq-input">
                            <option value="">Tất cả</option>
                            <option t-foreach="order_options" t-as="po" t-att-value="po.id"
                                    t-att-selected="po.id == filters['order']" t-esc="po.name"/>
                        </select>
                    </label>
                    <label class="vq-filter-field">
                        <span class="vq-label">Trạng thái</span>
                        <select name="status" class="vq-input">
                            <option value="">Tất cả</option>
                            <option value="da-chi" t-att-selected="filters['status'] == 'da-chi'">Đã chi</option>
                            <option value="dang-xu-ly" t-att-selected="filters['status'] == 'dang-xu-ly'">Đang xử lý</option>
                        </select>
                    </label>
                    <label class="vq-filter-field">
                        <span class="vq-label">Chứng từ</span>
                        <select name="docs" class="vq-input">
                            <option value="">Tất cả</option>
                            <option value="co" t-att-selected="filters['docs'] == 'co'">Có chứng từ</option>
                            <option value="chua" t-att-selected="filters['docs'] == 'chua'">Chưa có</option>
                        </select>
                    </label>
                    <label class="vq-filter-field">
                        <span class="vq-label">Từ ngày</span>
                        <input type="date" name="date_from" class="vq-input" t-att-value="filters['date_from'] and filters['date_from'].isoformat() or ''"/>
                    </label>
                    <label class="vq-filter-field">
                        <span class="vq-label">Đến ngày</span>
                        <input type="date" name="date_to" class="vq-input" t-att-value="filters['date_to'] and filters['date_to'].isoformat() or ''"/>
                    </label>
                    <div class="vq-filter-actions">
                        <button type="submit" class="vq-btn vq-btn-primary">Lọc</button>
                        <a class="vq-btn vq-btn-secondary" t-att-href="finance_url(q=None, status=None, docs=None, date_from=None, date_to=None, order=None, page=None)">Xoá lọc</a>
                    </div>
                </form>

                <p t-if="not requests" class="vq-empty">Không có khoản chi nào khớp bộ lọc.</p>
                <t t-else="">
                    <p class="vq-muted vq-small"><t t-esc="result_count"/> khoản chi</p>
                    <div class="vq-list-scroll">
                    <table class="vq-table vq-sheet">
                        <thead>
                            <tr>
                                <th class="vq-col-no">STT</th>
                                <th>Số uỷ nhiệm chi</th>
                                <th>Đơn mua</th>
                                <th>Ngày uỷ nhiệm chi</th>
                                <th class="vq-num">Số tiền</th>
                                <th>Hình thức</th>
                                <th>Trạng thái</th>
                                <th>Chứng từ</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="requests" t-as="pr">
                                <td class="vq-col-no" t-esc="pager['offset'] + pr_index + 1"/>
                                <td data-label="Số uỷ nhiệm chi" class="vq-nowrap"><a class="vq-doc-chip" t-att-href="entry_url(pr)"
                                       title="Xem khoản chi và chứng từ" t-esc="pr.name"/>
                                    <span t-if="pr._name == 'hlv.vendor.debt.payment'" class="pay-kind"
                                          title="Một khoản trả cho nhiều đơn mua">Công nợ</span></td>
                                <td data-label="Đơn mua"><t t-call="hlv_vendor_payment_docs.portal_order_links">
                                    <t t-set="links_orders" t-value="pr._hlv_orders()"/></t></td>
                                <td data-label="Ngày uỷ nhiệm chi" class="vq-nowrap" t-esc="fdate(pr.payment_date)"/>
                                <td class="vq-num" data-label="Số tiền" t-esc="fmt(round(pr.amount))"/>
                                <td data-label="Hình thức" t-esc="'Chuyển khoản' if pr.payment_method == 'bank' else 'Tiền mặt'"/>
                                <td data-label="Trạng thái">
                                    <span t-attf-class="vq-status #{'vq-pay-paid' if pr._hlv_is_paid() else 'vq-pay-processing'}" t-esc="pr._hlv_vendor_label()"/>
                                </td>
                                <td data-label="Chứng từ">
                                    <t t-set="docs" t-value="pr._hlv_vendor_documents()"/>
                                    <span t-if="not docs" class="vq-muted">—</span>
                                    <div t-else="" class="doc-thumbs">
                                        <t t-foreach="docs" t-as="doc">
                                            <t t-call="hlv_vendor_payment_docs.doc_thumb"><t t-set="url" t-value="doc_url(doc)"/></t>
                                        </t>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    </div>
                    <nav t-if="pager['page_count'] &gt; 1" class="vq-pager">
                        <a t-if="pager['page'] &gt; 1" t-att-href="finance_url(page=pager['page'] - 1)" class="vq-btn vq-btn-secondary">Trang trước</a>
                        <span class="vq-muted">Trang <t t-esc="pager['page']"/> / <t t-esc="pager['page_count']"/></span>
                        <a t-if="pager['page'] &lt; pager['page_count']" t-att-href="finance_url(page=pager['page'] + 1)" class="vq-btn vq-btn-secondary">Trang sau</a>
                    </nav>
                </t>
            </div>
        </t>
    </template>

    <!-- Một đề nghị chi phía NCC: trái là thông tin (số tiền, đơn mua, tài khoản), phải là chứng từ kế toán gửi — xem lớn
         ngay trong trang (ảnh / PDF), ảnh thu nhỏ bên dưới để chuyển chứng từ (?doc=). Word thì tải về. -->
    <template id="portal_finance_detail" name="Báo giá NCC - tài chính: một đề nghị chi">
        <t t-call="hlv_vendor_quotation.portal_layout">
            <t t-set="page_title" t-value="payment.name"/>
            <t t-set="logged_in" t-value="True"/>
            <div class="vq-wrap">
                <t t-call="hlv_vendor_quotation.portal_tabs"/>
                <nav class="vq-breadcrumb">
                    <a t-att-href="'%s/tai-chinh' % portal_base">Tài chính</a> / <span t-esc="payment.name"/>
                </nav>
                <div class="vq-page-head">
                    <h1 t-esc="payment.name"/>
                    <span t-attf-class="vq-status #{'vq-pay-paid' if payment._hlv_is_paid() else 'vq-pay-processing'}" t-esc="payment._hlv_vendor_label()"/>
                </div>

                <div class="unc-grid">
                    <section class="unc-card">
                        <h2 class="unc-card-title">Uỷ nhiệm chi</h2>
                        <p class="unc-amount"><t t-esc="fmt(round(payment.amount))"/> <small t-esc="payment.currency_id.name"/></p>
                        <dl class="unc-info">
                            <dt>Đơn mua hàng</dt>
                            <dd><t t-call="hlv_vendor_payment_docs.portal_order_links">
                                <t t-set="links_orders" t-value="payment.purchase_order_id"/>
                                <t t-set="visible_orders" t-value="payment.purchase_order_id"/></t></dd>
                            <dt>Ngày uỷ nhiệm chi</dt><dd t-esc="fdate(payment.payment_date)"/>
                            <dt>Hình thức</dt><dd t-esc="'Chuyển khoản' if payment.payment_method == 'bank' else 'Tiền mặt'"/>
                            <t t-if="payment.memo"><dt>Diễn giải</dt><dd class="vq-pre" t-esc="payment.memo"/></t>
                        </dl>
                    </section>

                    <t t-call="hlv_vendor_payment_docs.portal_doc_viewer"/>
                </div>
            </div>
        </t>
    </template>
    <!-- Cột chứng từ của một khoản chi phía NCC: xem lớn ngay trong trang (ảnh / PDF), ảnh thu nhỏ bên dưới để chuyển
         chứng từ (?doc=). Word thì tải về. Biến: documents, current, doc_url, detail_url. -->
    <template id="portal_doc_viewer" name="Báo giá NCC - tài chính: xem chứng từ">
        <section class="unc-card">
            <h2 class="unc-card-title">Chứng từ chi (UNC)</h2>
            <p t-if="not documents" class="vq-muted">Kế toán chưa gửi chứng từ cho khoản chi này.</p>
            <t t-else="">
                <t t-set="kind" t-value="current._hlv_preview_kind()"/>
                <div class="pay-viewer">
                    <a t-if="kind == 'image'" class="pay-viewer-link" target="_blank" t-att-href="doc_url(current)"
                       title="Bấm để mở ảnh ở tab mới"><img t-att-src="doc_url(current)" t-att-alt="current.name"/></a>
                    <iframe t-elif="kind == 'pdf'" t-att-src="doc_url(current)" t-att-title="current.name"/>
                    <div t-else="" class="pay-viewer-file">
                        <span class="doc-thumb doc-thumb-file" t-esc="current._hlv_badge()"/>
                        <span t-esc="current.name"/>
                        <a class="vq-btn vq-btn-primary" t-att-href="doc_url(current)" target="_blank">Tải về</a>
                    </div>
                </div>
                <p class="pay-viewer-caption"><b t-esc="current.name"/>
                    <t t-if="current.note"> · <t t-esc="current.note"/></t>
                    <span class="vq-muted"> · gửi <t t-esc="fdate(current.create_date)"/></span></p>
                <div t-if="len(documents) &gt; 1" class="pay-viewer-strip">
                    <a t-foreach="documents" t-as="doc" t-att-href="'%s?doc=%s' % (detail_url, doc.id)"
                       t-attf-class="doc-thumb #{'doc-thumb-' + doc._hlv_preview_kind() if doc._hlv_preview_kind() != 'image' else ''} #{'is-active' if doc == current else ''}"
                       t-att-title="doc.name">
                        <img t-if="doc._hlv_preview_kind() == 'image'" t-att-src="doc_url(doc)" loading="lazy" alt=""/>
                        <t t-else="" t-esc="doc._hlv_badge()"/>
                    </a>
                </div>
            </t>
        </section>
    </template>

    <!-- Số các đơn mua của một khoản chi: đơn NCC mở được trên trang thì là link, đơn khác chỉ ghi số. Biến: links_orders,
         visible_orders. -->
    <template id="portal_order_links" name="Báo giá NCC - tài chính: đơn mua của khoản chi">
        <span class="pay-chips">
            <t t-foreach="links_orders" t-as="po">
                <a t-if="po in visible_orders" class="vq-doc-chip" t-att-href="'%s/don-mua/%s' % (portal_base, po.id)" t-esc="po.name"/>
                <span t-else="" t-esc="po.name"/>
            </t>
        </span>
    </template>

    <!-- Một phiếu thanh toán công nợ phía NCC: trái là số tiền + các đơn được trả, phải là chứng từ. -->
    <template id="portal_finance_debt_detail" name="Báo giá NCC - tài chính: một phiếu thanh toán công nợ">
        <t t-call="hlv_vendor_quotation.portal_layout">
            <t t-set="page_title" t-value="payment.name"/>
            <t t-set="logged_in" t-value="True"/>
            <div class="vq-wrap">
                <t t-call="hlv_vendor_quotation.portal_tabs"/>
                <nav class="vq-breadcrumb">
                    <a t-att-href="'%s/tai-chinh' % portal_base">Tài chính</a> / <span t-esc="payment.name"/>
                </nav>
                <div class="vq-page-head">
                    <h1 t-esc="payment.name"/>
                    <span class="vq-status vq-pay-paid" t-esc="payment._hlv_vendor_label()"/>
                </div>

                <div class="unc-grid">
                    <section class="unc-card">
                        <h2 class="unc-card-title">Thanh toán công nợ</h2>
                        <p class="unc-amount"><t t-esc="fmt(round(payment.amount))"/> <small t-esc="payment.currency_id.name"/></p>
                        <dl class="unc-info">
                            <dt>Ngày chi</dt><dd t-esc="fdate(payment.payment_date)"/>
                            <dt>Hình thức</dt><dd t-esc="'Chuyển khoản' if payment.payment_method == 'bank' else 'Tiền mặt'"/>
                            <t t-if="payment.memo"><dt>Diễn giải</dt><dd class="vq-pre" t-esc="payment.memo"/></t>
                        </dl>
                        <table class="vq-table debt-lines">
                            <thead><tr><th>Đơn mua được trả</th><th class="vq-num">Số tiền</th></tr></thead>
                            <tbody>
                                <tr t-foreach="payment.line_ids" t-as="line">
                                    <td><t t-call="hlv_vendor_payment_docs.portal_order_links">
                                        <t t-set="links_orders" t-value="line.purchase_order_id"/></t></td>
                                    <td class="vq-num" t-esc="fmt(round(line.amount))"/>
                                </tr>
                            </tbody>
                            <tfoot t-if="round(payment.unallocated_amount)">
                                <tr><td>Trả trước (chưa vào đơn nào)</td><td class="vq-num" t-esc="fmt(round(payment.unallocated_amount))"/></tr>
                            </tfoot>
                        </table>
                    </section>

                    <t t-call="hlv_vendor_payment_docs.portal_doc_viewer"/>
                </div>
            </div>
        </t>
    </template>
</odoo>
