<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wordpress_update_stock_wizard_form" model="ir.ui.view">
        <field name="name">wordpress.update.stock.wizard.form</field>
        <field name="model">wordpress.update.stock.wizard</field>
        <field name="arch" type="xml">
            <form string="Cập nhật An toàn (WordPress)">
                <sheet>
                    <group>
                        <group string="Sản phẩm">
                            <field name="product_id" readonly="1"/>
                            <field name="current_status" string="Tình trạng cũ"/>
                            <field name="current_list_price" widget="monetary"/>
                            <field name="current_web_price" widget="monetary"/>
                            <field name="current_combo_price" widget="monetary"/>
                            <field name="current_listed_price" widget="monetary"/>
                            <field name="current_floor_ecommerce_price" widget="monetary"/>
                        </group>
                        <group string="Cập nhật Mới">
                            <field name="new_status" widget="radio" class="oe_inline"/>
                            <field name="new_list_price" widget="monetary" class="oe_inline" style="font-weight: bold; color: #28a745;"/>
                            <field name="new_web_price" widget="monetary" class="oe_inline" style="font-weight: bold; color: #0056b3;"/>
                            <field name="new_combo_price" widget="monetary" class="oe_inline" style="font-weight: bold; color: #17a2b8;"/>
                            <field name="new_listed_price" widget="monetary" class="oe_inline" style="font-weight: bold; color: #dc3545;"/>
                            <field name="new_floor_ecommerce_price" widget="monetary" class="oe_inline" style="font-weight: bold; color: #ffc107;"/>
                        </group>
                    </group>
                    
                    <label for="line_ids" string="Các sản phẩm Combo bị ảnh hưởng (Dự kiến)"/>
                    <field name="line_ids">
                        <list editable="bottom" create="0">
                            <field name="to_update" widget="boolean_toggle"/>
                            <field name="product_id" force_save="1" readonly="1"/>
                            
                            <field name="current_status" string="TT kho cũ" force_save="1" readonly="1" optional="show" widget="badge"
                                   decoration-success="current_status == 'instock'"
                                   decoration-danger="current_status == 'outofstock'"
                                   decoration-warning="current_status == 'discontinued'"/>
                                   
                            <field name="new_status" string="TT kho mới" force_save="1" readonly="1" optional="show" widget="badge"
                                   decoration-success="new_status == 'instock'"
                                   decoration-danger="new_status == 'outofstock'"
                                   decoration-warning="new_status == 'discontinued'"/>
                            
                            <field name="qty_in_combo" string="SL" force_save="1" readonly="1" optional="show"/>
                            
                            <field name="current_parent_list_price" string="Giá bán lẻ cũ" widget="monetary" force_save="1" readonly="1" optional="show"/>
                            <field name="new_parent_list_price" string="Giá bán lẻ mới" widget="monetary" decoration-bf="1" decoration-info="1" force_save="1" readonly="1" optional="show"/>
                            
                            <field name="current_parent_selling_price" string="Giá bán web cũ" widget="monetary" force_save="1" readonly="1" optional="show"/>
                            <field name="new_parent_selling_price" string="Giá bán web mới" widget="monetary" decoration-bf="1" decoration-info="1" force_save="1" readonly="1" optional="show"/>
                            
                            <field name="current_parent_listed_price" string="Giá niêm yết cũ" widget="monetary" force_save="1" readonly="1" optional="hide"/>
                            <field name="new_parent_listed_price" string="Giá niêm yết mới" widget="monetary" decoration-bf="1" force_save="1" readonly="1" optional="hide"/>
                            
                            <field name="current_parent_floor_ecommerce_price" string="Giá sàn TMDT cũ" widget="monetary" force_save="1" readonly="1" optional="hide"/>
                            <field name="new_parent_floor_ecommerce_price" string="Giá sàn TMDT mới" widget="monetary" decoration-bf="1" force_save="1" readonly="1" optional="hide"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Xác nhận &amp; Đồng bộ" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Hủy" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wordpress_update_stock_wizard" model="ir.actions.act_window">
        <field name="name">Cập nhật kho WordPress</field>
        <field name="res_model">wordpress.update.stock.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
