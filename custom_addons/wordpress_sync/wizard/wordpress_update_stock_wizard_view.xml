<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wordpress_update_stock_wizard_form" model="ir.ui.view">
        <field name="name">wordpress.update.stock.wizard.form</field>
        <field name="model">wordpress.update.stock.wizard</field>
        <field name="arch" type="xml">
            <form string="Cập nhật trạng thái kho WordPress">
                <group>
                    <field name="product_id"/>
                    <field name="current_status"/>
                    <field name="new_status"/>
                </group>
                
                <label for="line_ids" string="Các sản phẩm Combo bị ảnh hưởng (Sẽ được cập nhật theo)"/>
                <field name="line_ids">
                    <list editable="bottom" create="0">
                        <field name="to_update" widget="boolean_toggle"/>
                        <field name="product_id" force_save="1" readonly="1"/>
                        <field name="current_status" string="Trạng thái cũ" force_save="1" readonly="1"/>
                    </list>
                </field>
                
                <footer>
                    <button name="action_confirm" string="Xác nhận cập nhật" type="object" class="btn-primary"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wordpress_update_stock_wizard" model="ir.actions.act_window">
        <field name="name">Cập nhật kho WordPress</field>
        <field name="res_model">wordpress.update.stock.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
