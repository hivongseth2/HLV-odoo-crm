<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add Sync to WordPress button in Product Template Form -->
    <record id="view_product_template_inherit_wordpress" model="ir.ui.view">
        <field name="name">product.template.inherit.wordpress</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <!-- Add buttons only to the product.template form. -->
            <xpath expr="//form/header" position="inside">
                <button name="action_sync_to_wordpress"
                        type="object"
                        string="Sync Price to WP"
                        class="btn-primary"
                        title="Đồng bộ giá sản phẩm lên WordPress"/>
                <button name="action_sync_stock_to_wordpress"
                        type="object"
                        string="Sync Stock to WP"
                        class="btn-secondary"
                        title="Đồng bộ tình trạng kho lên WordPress"/>
            </xpath>
            
            <!-- Add combo price field in pricing section (New Row after List Price) -->
            <xpath expr="//div[field[@name='list_price']]" position="after">
                <label for="x_wp_combo_price" string="Giá bán trong combo"/>
                <div class="o_row">
                    <field name="x_wp_combo_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="computed_combo_selling_price" widget="monetary" options="{'currency_field': 'currency_id'}" class="oe_grey"/>
                </div>
                
                <label for="x_wp_stock_status" string="Tình trạng WordPress"/>
                <div class="o_row">
                    <field name="x_wp_stock_status" readonly="1" force_save="1"/>
                    <button name="%(wordpress_sync.action_wordpress_update_stock_wizard)d" 
                            string="Cập nhật an toàn" 
                            type="action" 
                            class="btn btn-secondary btn-sm"
                            icon="fa-shield"
                            help="Cập nhật trạng thái và đồng bộ các Combo cha liên quan"/>
                </div>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Web" name="wordpress_links">
                    <field name="x_wp_link_ids" readonly="1" nolabel="1">
                        <list>
                            <field name="config_id"/>
                            <field name="wc_sku"/>
                            <field name="wc_name"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'linked'"
                                   decoration-warning="state != 'linked'"/>
                            <field name="wc_status"/>
                            <field name="wc_url" widget="url" text="Mở"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- product_template_search_view có từ các bản Odoo rất cũ, id ổn định. -->
    <record id="view_product_template_search_inherit_wordpress" model="ir.ui.view">
        <field name="name">product.template.search.inherit.wordpress</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='filter_to_purchase']" position="after">
                <separator/>
                <filter string="Có trên web" name="wp_linked" domain="[('x_wp_link_ids', '!=', False)]"/>
                <filter string="Chưa có trên web" name="wp_not_linked" domain="[('x_wp_link_ids', '=', False)]"/>
                <filter string="Mã lệch với web" name="wp_code_issue"
                        domain="[('x_wp_link_ids.state', 'in', ('case_mismatch', 'duplicate'))]"/>
            </xpath>
        </field>
    </record>
</odoo>

