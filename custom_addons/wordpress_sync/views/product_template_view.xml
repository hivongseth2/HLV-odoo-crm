<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add Sync to WordPress button in Product Template Form -->
    <record id="view_product_template_inherit_wordpress" model="ir.ui.view">
        <field name="name">product.template.inherit.wordpress</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <!-- Add button in header area -->
            <xpath expr="//form/sheet" position="before">
                <header>
                    <button name="action_sync_to_wordpress"
                            type="object"
                            string="Sync to WordPress"
                            class="btn-primary"
                            title="Đồng bộ giá sản phẩm lên WordPress"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
