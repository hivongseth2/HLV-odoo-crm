<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add Sync to WordPress button in Product Template Form -->
    <record id="view_product_template_inherit_wordpress" model="ir.ui.view">
        <field name="name">product.template.inherit.wordpress</field>
        <field name="model">product.template</field>
        <field name="inherit_id">product.product_template_form_view</field>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='%(sale.action_sale_order_line)d']" position="after">
                <button name="action_sync_to_wordpress" type="object" string="🔄 Sync to WordPress" class="btn-primary" title="Manually sync this product to WordPress" />
            </xpath>
        </field>
    </record>

    <!-- Add price fields view inheritance (if needed) -->
    <record id="view_product_template_form_inherit_prices" model="ir.ui.view">
        <field name="name">product.template.form.inherit.prices</field>
        <field name="model">product.template</field>
        <field name="inherit_id">product.product_template_form_view</field>
        <field name="arch" type="xml">
            <!-- This just shows where the x_studio_ga_web and x_studio_gi_bn_thng_mi fields are located -->
            <!-- These are Studio fields, so they appear automatically in the form -->
            <!-- We don't need to add them here, just document that they're used -->
        </field>
    </record>
</odoo>
