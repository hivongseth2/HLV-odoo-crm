<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- WordPress Configuration Form View -->
    <record id="view_wordpress_config_form" model="ir.ui.view">
        <field name="name">wordpress.config.form</field>
        <field name="model">wordpress.config</field>
        <field name="arch" type="xml">
            <form string="Cấu hình WordPress">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="test_connection" type="object" class="oe_stat_button" icon="fa-globe">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Test kết nối</span>
                            </div>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Tắt" bg_color="text-bg-danger" invisible="active"/>

                    <div class="oe_title">
                        <h1>
                            <field name="name" class="oe_inline" placeholder="VD: Store chính"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Thông tin Store">
                            <field name="wc_domain" placeholder="https://hoanglongvu.com"/>
                            <field name="active"/>
                        </group>
                        <group string="API Credentials">
                            <field name="wc_key" password="True"/>
                            <field name="wc_secret" password="True"/>
                        </group>
                    </group>

                    <group string="Cài đặt nâng cao">
                        <group>
                            <field name="cache_purge_url" placeholder="/wp-json/litespeed/v1/purge?type=product&amp;sku="/>
                            <field name="sync_log_days"/>
                            <field name="max_retry_attempts"/>
                            <field name="retry_delay_seconds"/>
                            <field name="batch_size"/>
                            <field name="sync_delay"/>
                        </group>
                        <group>
                            <field name="last_sync_date" readonly="True"/>
                        </group>
                    </group>

                    <group string="Mẫu lỗi không retry">
                        <field name="no_retry_patterns" nolabel="1" placeholder="Mỗi dòng 1 pattern (plain text hoặc regex)&#10;VD: Không tìm thấy product trên WordPress&#10;Product không có SKU"/>
                    </group>
                    
                    <separator string="Cài đặt tự động đồng bộ"/>
                    
                    <group>
                        <group string="Tự động đồng bộ">
                            <field name="auto_sync_price" widget="boolean_toggle"/>
                            <field name="auto_sync_combo_stock" widget="boolean_toggle"/>
                            <field name="combo_stock_check_interval" invisible="not auto_sync_combo_stock"/>
                        </group>
                        <group string="Tình trạng kho">
                            <field name="sync_stock_based_on_quantity" widget="boolean_toggle"/>
                            <field name="stock_status_field" invisible="not sync_stock_based_on_quantity"/>
                        </group>
                    </group>
                    
                    <separator string="Giá sản phẩm Combo"/>
                    
                    <group>
                        <group string="Phương pháp tính giá">
                            <field name="combo_pricing_method" widget="radio"/>
                        </group>
                        <group string="Cấu hình">
                            <field name="combo_discount_percentage" 
                                   invisible="combo_pricing_method != 'discount_percentage'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- WordPress Configuration List View -->
    <record id="view_wordpress_config_tree" model="ir.ui.view">
        <field name="name">wordpress.config.list</field>
        <field name="model">wordpress.config</field>
        <field name="arch" type="xml">
            <list string="Cấu hình WordPress">
                <field name="name"/>
                <field name="wc_domain"/>
                <field name="active"/>
                <field name="last_sync_date"/>
            </list>
        </field>
    </record>

    <!-- Action to open WordPress Config -->
    <record id="action_wordpress_config" model="ir.actions.act_window">
        <field name="name">Cấu hình WordPress</field>
        <field name="res_model">wordpress.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo cấu hình WordPress đầu tiên
            </p>
            <p>
                Nhập thông tin WooCommerce API để đồng bộ giá sản phẩm.
            </p>
        </field>
    </record>

    <!-- Menu items - under Inventory/Configuration -->
    <menuitem
        id="menu_wordpress_sync"
        name="WordPress Sync"
        parent="stock.menu_stock_config_settings"
        sequence="99"/>

    <menuitem
        id="menu_wordpress_config"
        name="Cấu hình WooCommerce"
        parent="menu_wordpress_sync"
        action="action_wordpress_config"
        sequence="10"/>
</odoo>
