<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wordpress_product_link_list" model="ir.ui.view">
        <field name="name">wordpress.product.link.list</field>
        <field name="model">wordpress.product.link</field>
        <field name="arch" type="xml">
            <list string="Sản phẩm trên web" create="0" edit="0" delete="0"
                  decoration-muted="wc_status not in ('publish', False)">
                <field name="config_id" optional="show"/>
                <field name="wc_sku"/>
                <field name="wc_name"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'linked'"
                       decoration-warning="state in ('case_mismatch', 'duplicate')"
                       decoration-danger="state in ('orphan', 'no_sku')"/>
                <field name="product_id"/>
                <field name="product_code" optional="show"/>
                <field name="wc_type" optional="hide"/>
                <field name="wc_status" optional="show"/>
                <field name="wc_product_id" optional="hide"/>
                <field name="wc_url" widget="url" text="Mở" optional="show"/>
                <field name="last_seen" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_wordpress_product_link_search" model="ir.ui.view">
        <field name="name">wordpress.product.link.search</field>
        <field name="model">wordpress.product.link</field>
        <field name="arch" type="xml">
            <search string="Sản phẩm trên web">
                <field name="wc_sku"/>
                <field name="wc_name"/>
                <field name="product_id"/>
                <field name="config_id"/>
                <filter string="Cần xử lý" name="needs_attention" domain="[('state', '!=', 'linked')]"/>
                <separator/>
                <filter string="Đã khớp" name="linked" domain="[('state', '=', 'linked')]"/>
                <filter string="Lệch hoa/thường" name="case_mismatch" domain="[('state', '=', 'case_mismatch')]"/>
                <filter string="Trùng mã" name="duplicate" domain="[('state', '=', 'duplicate')]"/>
                <filter string="Odoo không có mã" name="orphan" domain="[('state', '=', 'orphan')]"/>
                <filter string="Web chưa nhập mã" name="no_sku" domain="[('state', '=', 'no_sku')]"/>
                <separator/>
                <filter string="Đang bán trên web" name="published" domain="[('wc_status', '=', 'publish')]"/>
                <filter string="Biến thể" name="variation" domain="[('wc_parent_id', '!=', 0)]"/>
                <group expand="0" string="Nhóm theo">
                    <filter string="Web" name="group_config" context="{'group_by': 'config_id'}"/>
                    <filter string="Khớp mã" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_wordpress_product_link" model="ir.actions.act_window">
        <field name="name">Sản phẩm trên web</field>
        <field name="res_model">wordpress.product.link</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_state': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa quét web nào
            </p>
            <p>
                Vào Cấu hình WooCommerce, bấm "Quét sản phẩm web" để kéo danh mục từ web về
                và khớp mã với sản phẩm Odoo.
            </p>
        </field>
    </record>

    <menuitem id="menu_wordpress_product_link"
              name="Sản phẩm trên web"
              parent="menu_wordpress_sync"
              action="action_wordpress_product_link"
              sequence="15"/>
</odoo>
