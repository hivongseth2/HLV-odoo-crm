<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="view_wordpress_sync_queue_tree" model="ir.ui.view">
            <field name="name">wordpress.sync.queue.list</field>
            <field name="model">wordpress.sync.queue</field>
            <field name="arch" type="xml">
                <list string="WordPress Sync Queue" decoration-danger="status=='failed'" decoration-info="status=='pending'" decoration-muted="status=='done'">
                    <field name="priority" widget="handle"/>
                    <field name="product_id"/>
                    <field name="sku"/>
                    <field name="sync_type"/>
                    <field name="status"/>
                    <field name="attempt_count"/>
                    <field name="next_execution"/>
                    <field name="last_error"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_wordpress_sync_queue_form" model="ir.ui.view">
            <field name="name">wordpress.sync.queue.form</field>
            <field name="model">wordpress.sync.queue</field>
            <field name="arch" type="xml">
                <form string="Queue Job">
                    <header>
                        <button name="process_queue" string="Process Now" type="object" class="oe_highlight" 
                                invisible="status in ('done')"/>
                        <field name="status" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="product_id"/>
                                <field name="sku"/>
                                <field name="sync_type"/>
                            </group>
                            <group>
                                <field name="next_execution"/>
                                <field name="attempt_count"/>
                                <field name="priority"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Log">
                                <field name="log" readonly="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_wordpress_sync_queue_search" model="ir.ui.view">
            <field name="name">wordpress.sync.queue.search</field>
            <field name="model">wordpress.sync.queue</field>
            <field name="arch" type="xml">
                <search string="Search Queue">
                    <field name="product_id"/>
                    <field name="sku"/>
                    <filter string="Pending" name="pending" domain="[('status', '=', 'pending')]"/>
                    <filter string="Failed" name="failed" domain="[('status', '=', 'failed')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_wordpress_sync_queue" model="ir.actions.act_window">
            <field name="name">Sync Queue</field>
            <field name="res_model">wordpress.sync.queue</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_pending': 1}</field>
        </record>

        <!-- Menu -->
        <menuitem id="menu_wordpress_sync_queue"
                  name="Hàng đợi đồng bộ"
                  parent="menu_wordpress_sync_root"
                  action="action_wordpress_sync_queue"
                  sequence="30"/>

        <!-- Cron Job -->
        <record id="ir_cron_wordpress_sync_queue" model="ir.cron">
            <field name="name">WordPress: Process Sync Queue</field>
            <field name="model_id" ref="model_wordpress_sync_queue"/>
            <field name="state">code</field>
            <field name="code">model.process_queue()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
        </record>
    </data>
</odoo>
