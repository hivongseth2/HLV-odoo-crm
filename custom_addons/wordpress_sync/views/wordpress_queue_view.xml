<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="view_wordpress_sync_queue_list" model="ir.ui.view">
            <field name="name">wordpress.sync.queue.list</field>
            <field name="model">wordpress.sync.queue</field>
            <field name="arch" type="xml">
                <list string="Hàng đợi đồng bộ" decoration-danger="status=='failed'" decoration-info="status=='pending'" decoration-success="status=='done'">
                    <field name="priority" widget="handle"/>
                    <field name="product_id"/>
                    <field name="sku"/>
                    <field name="sync_type"/>
                    <field name="status" widget="badge" decoration-success="status == 'done'" decoration-warning="status == 'pending'" decoration-danger="status == 'failed'"/>
                    <field name="attempt_count"/>
                    <field name="next_execution"/>
                    <field name="last_error"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_wordpress_sync_queue_form" model="ir.ui.view">
            <field name="name">wordpress.sync.queue.form</field>
            <field name="model">wordpress.sync.queue</field>
            <field name="arch" type="xml">
                <form string="Chi tiết Job">
                    <header>
                        <button name="process_queue" string="Chạy ngay" type="object" class="oe_highlight" 
                                invisible="status in ('done')"/>
                        <field name="status" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="product_id"/>
                                <field name="sku"/>
                                <field name="sync_type"/>
                            </group>
                            <group>
                                <field name="next_execution"/>
                                <field name="attempt_count"/>
                                <field name="priority"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Nhật ký">
                                <field name="log" readonly="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_wordpress_sync_queue_search" model="ir.ui.view">
            <field name="name">wordpress.sync.queue.search</field>
            <field name="model">wordpress.sync.queue</field>
            <field name="arch" type="xml">
                <search string="Tìm kiếm">
                    <field name="product_id"/>
                    <field name="sku"/>
                    <filter string="Chờ xử lý" name="pending" domain="[('status', '=', 'pending')]"/>
                    <filter string="Lỗi" name="failed" domain="[('status', '=', 'failed')]"/>
                    <group expand="0" string="Nhóm theo">
                        <filter string="Trạng thái" name="group_status" context="{'group_by': 'status'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_wordpress_sync_queue" model="ir.actions.act_window">
            <field name="name">Hàng đợi đồng bộ</field>
            <field name="res_model">wordpress.sync.queue</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_pending': 1}</field>
            <field name="help" type="html">
               <p class="o_view_nocontent_smiling_face">
                   Chưa có yêu cầu đồng bộ nào
               </p>
               <p>
                   Các thay đổi giá sẽ tự động xuất hiện ở đây.
                   Hệ thống tự động chạy mỗi 1 phút.
               </p>
            </field>
        </record>

        <!-- Server Action: Chạy ngay -->
        <record id="action_process_queue_server" model="ir.actions.server">
            <field name="name">Chạy ngay</field>
            <field name="model_id" ref="wordpress_sync.model_wordpress_sync_queue"/>
            <field name="binding_model_id" ref="wordpress_sync.model_wordpress_sync_queue"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
                for record in records:
                    record.process_queue()
            </field>
        </record>

        <!-- Menu -->
        <menuitem id="menu_wordpress_sync_queue"
                  name="Hàng đợi đồng bộ"
                  parent="menu_wordpress_sync"
                  action="action_wordpress_sync_queue"
                  sequence="30"/>

        <!-- Cron Job -->
        <record id="ir_cron_wordpress_sync_queue" model="ir.cron">
            <field name="name">WordPress: Process Sync Queue</field>
            <field name="model_id" ref="wordpress_sync.model_wordpress_sync_queue"/>
            <field name="state">code</field>
            <field name="code">model.process_queue()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
        </record>
    </data>
</odoo>
