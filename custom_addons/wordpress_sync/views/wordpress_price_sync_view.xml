<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Price Sync Wizard Form -->
    <record id="view_wordpress_price_sync_form" model="ir.ui.view">
        <field name="name">wordpress.price.sync.form</field>
        <field name="model">wordpress.price.sync</field>
        <field name="arch" type="xml">
            <form string="Đồng bộ giá lên WordPress">
                <group>
                    <!-- Ẩn field cấu hình nếu chỉ có 1 config -->
                    <field name="has_multiple_configs" invisible="1"/>
                    <group string="Cấu hình" invisible="not has_multiple_configs">
                        <field name="wordpress_config_id" required="True" options="{'no_create': True}"/>
                    </group>
                    <group string="Chế độ đồng bộ">
                        <field name="sync_mode" required="True" widget="radio"/>
                        <field name="product_id"
                               invisible="sync_mode != 'single'"
                               required="sync_mode == 'single'"
                               options="{'no_create': True}"/>
                    </group>
                </group>

                <footer>
                    <button name="action_sync" string="Đồng bộ ngay" type="object" class="btn-primary"/>
                    <button string="Hủy" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open Price Sync Wizard -->
    <record id="action_wordpress_price_sync" model="ir.actions.act_window">
        <field name="name">Đồng bộ giá lên WordPress</field>
        <field name="res_model">wordpress.price.sync</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu item for wizard -->
    <menuitem
        id="menu_wordpress_price_sync"
        name="Đồng bộ giá"
        parent="menu_wordpress_sync"
        action="action_wordpress_price_sync"
        sequence="20"/>
</odoo>
