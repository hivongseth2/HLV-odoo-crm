<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Price Sync Wizard Form -->
    <record id="view_wordpress_price_sync_form" model="ir.ui.view">
        <field name="name">wordpress.price.sync.form</field>
        <field name="model">wordpress.price.sync</field>
        <field name="arch" type="xml">
            <form string="Sync Prices to WordPress">
                <group>
                    <group string="Configuration">
                        <field name="wordpress_config_id" required="True" />
                    </group>
                    <group string="Sync Mode">
                        <field name="sync_mode" required="True" />
                        <field name="product_id" attrs="{'invisible': [('sync_mode', '!=', 'single')], 'required': [('sync_mode', '=', 'single')]}" />
                    </group>
                </group>

                <footer>
                    <button name="action_sync" string="🔄 Sync Now" type="object" class="btn-primary" />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open Price Sync Wizard -->
    <record id="action_wordpress_price_sync" model="ir.actions.act_window">
        <field name="name">Sync Prices to WordPress</field>
        <field name="res_model">wordpress.price.sync</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu item for wizard -->
    <menuitem
        id="menu_wordpress_price_sync"
        name="Sync Prices to WordPress"
        parent="menu_wordpress_sync"
        action="action_wordpress_price_sync"
        sequence="20" />
</odoo>
