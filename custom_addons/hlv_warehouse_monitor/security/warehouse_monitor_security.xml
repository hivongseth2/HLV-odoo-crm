<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  Security Groups                                       -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <record id="group_warehouse_monitor_user" model="res.groups">
        <field name="name">Warehouse Monitor User</field>
        <field name="category_id" ref="base.module_category_inventory_inventory"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_warehouse_monitor_manager" model="res.groups">
        <field name="name">Warehouse Monitor Manager</field>
        <field name="category_id" ref="base.module_category_inventory_inventory"/>
        <field name="implied_ids" eval="[(4, ref('hlv_warehouse_monitor.group_warehouse_monitor_user'))]"/>
    </record>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  Record Rules                                          -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <record id="rule_monitor_event_user" model="ir.rule">
        <field name="name">Monitor Event: User can see all events</field>
        <field name="model_id" ref="model_warehouse_monitor_event"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_warehouse_monitor_user'))]"/>
    </record>

</odoo>
