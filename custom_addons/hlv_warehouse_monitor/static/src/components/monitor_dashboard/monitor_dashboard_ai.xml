<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  AI Assistant Panel — right column sidebar             -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <t t-name="hlv_warehouse_monitor.AIAssistant">
        <div class="wm-ai-panel">

            <!-- Panel Header -->
            <div class="wm-ai-header">
                <div class="wm-ai-title-group">
                    <span class="wm-ai-robot-icon">🤖</span>
                    <span class="wm-ai-title">AI Trợ lý Kho</span>
                    <t t-if="state.aiPanel.cards.length > 0">
                        <span class="wm-ai-badge" t-esc="state.aiPanel.cards.length"/>
                    </t>
                </div>
                <t t-if="state.aiPanel.cards.length > 0">
                    <button class="wm-ai-clear-btn" t-on-click="() => this.clearAllInsights()"
                            title="Xóa tất cả">🗑</button>
                </t>
            </div>

            <!-- Thinking status bar -->
            <t t-if="state.aiPanel.isThinking">
                <div class="wm-ai-thinking-bar">
                    <span class="wm-ai-pulse-dot"/>
                    <span class="wm-ai-pulse-dot"/>
                    <span class="wm-ai-pulse-dot"/>
                    <span>AI đang phân tích...</span>
                </div>
            </t>

            <!-- Ask input -->
            <div class="wm-ai-ask-area">
                <input
                    class="wm-ai-input"
                    type="text"
                    placeholder="Hỏi AI về kho hàng..."
                    t-att-value="state.aiPanel.userQuestion"
                    t-on-input="(ev) => this.onAiQuestionInput(ev)"
                    t-on-keydown="(ev) => this.onAiQuestionKeydown(ev)"
                    t-att-disabled="state.aiPanel.isThinking ? 'disabled' : false"
                />
                <button class="wm-ai-send-btn"
                        t-on-click="() => this.askAI()"
                        t-att-disabled="state.aiPanel.isThinking ? 'disabled' : false"
                        title="Gửi câu hỏi">➤</button>
            </div>

            <!-- Cards List (vertical scroll) -->
            <div class="wm-ai-cards-area">

                <!-- Empty state -->
                <t t-if="!state.aiPanel.isThinking and state.aiPanel.cards.length === 0">
                    <div class="wm-ai-empty">
                        <span class="wm-ai-empty-icon">🤖</span>
                        <div class="wm-ai-empty-text">Đang chờ hoạt động kho...</div>
                        <div class="wm-ai-empty-hint">
                            AI tự phân tích khi có nhập/xuất/xác nhận đơn hàng.
                        </div>
                    </div>
                </t>

                <!-- Insight Cards -->
                <t t-foreach="state.aiPanel.cards" t-as="card" t-key="card.id">
                    <div t-att-class="'wm-ai-card wm-ai-card--' + card.priority">

                        <!-- Card top bar -->
                        <div class="wm-ai-card-topbar">
                            <div class="wm-ai-card-badges">
                                <t t-if="card.is_question">
                                    <span class="wm-ai-type-badge wm-ai-type--question">❓</span>
                                </t>
                                <t t-else="">
                                    <span t-att-class="'wm-ai-type-badge wm-ai-type--' + (card.event_type || 'other')"
                                          t-esc="(card.event_type || '').toUpperCase()"/>
                                </t>
                                <span t-att-class="'wm-ai-priority-badge wm-ai-priority--' + card.priority">
                                    <t t-if="card.priority === 'urgent'">🔴</t>
                                    <t t-elif="card.priority === 'high'">🟠</t>
                                    <t t-else="">🔵</t>
                                </span>
                                <span class="wm-ai-card-time" t-esc="this.formatTime(card.timestamp)"/>
                            </div>
                            <button class="wm-ai-dismiss-btn"
                                    t-on-click="() => this.dismissInsight(card.id)">✕</button>
                        </div>

                        <!-- Headline -->
                        <div class="wm-ai-card-headline" t-esc="card.headline"/>

                        <!-- Question (if user asked) -->
                        <t t-if="card.is_question and card.question">
                            <div class="wm-ai-question-text">💬 "<span t-esc="card.question"/>"</div>
                        </t>

                        <!-- AI Analysis -->
                        <div class="wm-ai-analysis" t-esc="card.analysis"/>

                        <!-- Suggested Actions -->
                        <t t-if="card.actions and card.actions.length > 0">
                            <ul class="wm-ai-actions-list">
                                <t t-foreach="card.actions" t-as="act" t-key="act_index">
                                    <li class="wm-ai-action-item">
                                        <span class="wm-ai-action-check">✅</span>
                                        <span t-esc="act"/>
                                    </li>
                                </t>
                            </ul>
                        </t>

                    </div>
                </t>

            </div>
        </div>
    </t>

</templates>
