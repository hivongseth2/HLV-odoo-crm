<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hlv_product_flow_analysis.SidebarSuppliers">
                <!-- Top NCC SL mua -->
                <div class="pf-sc-card">
                    <h4 class="pf-sc-title">
                        <i class="fa fa-truck me-1" style="color:#6f42c1;"/>Top NCC (SL mua)
                    </h4>
                    <div class="pf-hbar-chart pf-hbar-compact">
                        <t t-foreach="topSuppliersByQty" t-as="item" t-key="item.partner_id">
                            <div class="pf-hbar-row">
                                <div class="pf-hbar-label pf-hbar-label-sm" t-att-title="item.partner_name">
                                    <span class="pf-hbar-name" t-esc="item.partner_name"/>
                                </div>
                                <div class="pf-hbar-track">
                                    <div class="pf-hbar-fill pf-hbar-supplier-qty"
                                         t-att-style="'width:' + getBarWidth(item.total_qty, topSuppliersByQtyMax)">
                                        <span class="pf-hbar-val" t-esc="formatNumber(item.total_qty)"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                        <t t-if="topSuppliersByQty.length === 0">
                            <div class="pf-chart-empty">Chưa có dữ liệu</div>
                        </t>
                    </div>
                </div>

                <!-- Top NCC giá trị -->
                <div class="pf-sc-card">
                    <h4 class="pf-sc-title">
                        <i class="fa fa-money me-1" style="color:#e67700;"/>Top NCC (Giá trị)
                    </h4>
                    <div class="pf-hbar-chart pf-hbar-compact">
                        <t t-foreach="topSuppliersByAmount" t-as="item" t-key="item.partner_id">
                            <div class="pf-hbar-row">
                                <div class="pf-hbar-label pf-hbar-label-sm" t-att-title="item.partner_name">
                                    <span class="pf-hbar-name" t-esc="item.partner_name"/>
                                </div>
                                <div class="pf-hbar-track">
                                    <div class="pf-hbar-fill pf-hbar-supplier-amount"
                                         t-att-style="'width:' + getBarWidth(item.total_amount, topSuppliersByAmountMax)">
                                        <span class="pf-hbar-val" t-esc="formatCurrency(item.total_amount)"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                        <t t-if="topSuppliersByAmount.length === 0">
                            <div class="pf-chart-empty">Chưa có dữ liệu</div>
                        </t>
                    </div>
                </div>

                <!-- Top NCC tần suất -->
                <div class="pf-sc-card">
                    <h4 class="pf-sc-title">
                        <i class="fa fa-refresh me-1" style="color:#0ca678;"/>Top NCC (Tần suất)
                    </h4>
                    <div class="pf-hbar-chart pf-hbar-compact">
                        <t t-foreach="topSuppliersByFrequency" t-as="item" t-key="item.partner_id">
                            <div class="pf-hbar-row">
                                <div class="pf-hbar-label pf-hbar-label-sm" t-att-title="item.partner_name">
                                    <span class="pf-hbar-name" t-esc="item.partner_name"/>
                                </div>
                                <div class="pf-hbar-track">
                                    <div class="pf-hbar-fill pf-hbar-supplier-freq"
                                         t-att-style="'width:' + getBarWidth(item.move_count, topSuppliersByFrequencyMax)">
                                        <span class="pf-hbar-val"><t t-esc="item.move_count"/> lần</span>
                                    </div>
                                </div>
                            </div>
                        </t>
                        <t t-if="topSuppliersByFrequency.length === 0">
                            <div class="pf-chart-empty">Chưa có dữ liệu</div>
                        </t>
                    </div>
                </div>

                <!-- Mức độ tập trung NCC -->
                <div class="pf-sc-card">
                    <h4 class="pf-sc-title">
                        <i class="fa fa-pie-chart me-1" style="color:#4263eb;"/>Tập trung NCC
                    </h4>
                    <div class="pf-supplier-concentration">
                        <t t-if="supplierConcentration.count > 0">
                            <div class="pf-conc-summary">
                                <span class="pf-conc-total">
                                    Tổng: <strong t-esc="formatCurrency(supplierConcentration.total)"/>
                                </span>
                            </div>
                            <div class="pf-conc-bars">
                                <div class="pf-conc-row">
                                    <span class="pf-conc-label">Top 1</span>
                                    <div class="pf-conc-track">
                                        <div class="pf-conc-fill pf-conc-1" t-att-style="'width:' + supplierConcentration.top1 + '%'"/>
                                    </div>
                                    <span class="pf-conc-pct"><t t-esc="supplierConcentration.top1"/>%</span>
                                </div>
                                <div class="pf-conc-row">
                                    <span class="pf-conc-label">Top 3</span>
                                    <div class="pf-conc-track">
                                        <div class="pf-conc-fill pf-conc-3" t-att-style="'width:' + supplierConcentration.top3 + '%'"/>
                                    </div>
                                    <span class="pf-conc-pct"><t t-esc="supplierConcentration.top3"/>%</span>
                                </div>
                                <div class="pf-conc-row">
                                    <span class="pf-conc-label">Top 5</span>
                                    <div class="pf-conc-track">
                                        <div class="pf-conc-fill pf-conc-5" t-att-style="'width:' + supplierConcentration.top5 + '%'"/>
                                    </div>
                                    <span class="pf-conc-pct"><t t-esc="supplierConcentration.top5"/>%</span>
                                </div>
                            </div>
                            <div class="pf-conc-hint">
                                <i class="fa fa-info-circle me-1"/>
                                <t t-if="supplierConcentration.top1 > 50">
                                    <span class="text-danger">Phụ thuộc 1 NCC (<t t-esc="supplierConcentration.top1"/>%)</span>
                                </t>
                                <t t-elif="supplierConcentration.top3 > 80">
                                    <span class="text-warning">Top 3 chiếm <t t-esc="supplierConcentration.top3"/>%</span>
                                </t>
                                <t t-else="">
                                    <span class="text-success">Nguồn cung đa dạng</span>
                                </t>
                            </div>
                        </t>
                        <t t-if="supplierConcentration.count === 0">
                            <div class="pf-chart-empty">Chưa có dữ liệu</div>
                        </t>
                    </div>
                </div>
    </t>
</templates>