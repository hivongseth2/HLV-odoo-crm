<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hlv_product_flow_analysis.SidebarTrend">
                <!-- 1. SL Mua vs Bán theo tháng -->
                <div class="pf-sc-card">
                    <h4 class="pf-sc-title">
                        <i class="fa fa-line-chart me-1" style="color:#1971c2;"/>Biến động SL mua bán
                    </h4>
                    <div class="pf-chart-guide">
                        <i class="fa fa-question-circle me-1"/>So sánh SL mua/bán 6 tháng gần nhất. Xanh = Mua, Hồng = Bán.
                    </div>
                    <t t-if="trendMonthlyData.length > 0">
                        <div class="pf-trend-chart">
                            <t t-foreach="trendMonthlyData" t-as="m" t-key="m.month">
                                <div class="pf-trend-row">
                                    <div class="pf-trend-month" t-esc="m.month_label"/>
                                    <div class="pf-trend-bars">
                                        <div class="pf-trend-bar-wrap">
                                            <div class="pf-trend-bar pf-trend-buy"
                                                 t-att-style="'width:' + getBarWidth(m.buy_qty, trendMaxQty)"
                                                 t-att-title="'Mua: ' + formatNumber(m.buy_qty)">
                                                <span class="pf-trend-val" t-if="m.buy_qty > 0"
                                                      t-esc="formatNumber(m.buy_qty)"/>
                                            </div>
                                        </div>
                                        <div class="pf-trend-bar-wrap">
                                            <div class="pf-trend-bar pf-trend-sell"
                                                 t-att-style="'width:' + getBarWidth(m.sell_qty, trendMaxQty)"
                                                 t-att-title="'Bán: ' + formatNumber(m.sell_qty)">
                                                <span class="pf-trend-val" t-if="m.sell_qty > 0"
                                                      t-esc="formatNumber(m.sell_qty)"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                            <div class="pf-dual-legend">
                                <span><span class="pf-dual-leg-dot pf-trend-buy"/> Mua</span>
                                <span><span class="pf-dual-leg-dot pf-trend-sell"/> Bán</span>
                            </div>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="pf-chart-empty">Đang tải dữ liệu...</div>
                    </t>
                </div>

                <!-- 2. Số đơn PO / SO theo tháng -->
                <div class="pf-sc-card">
                    <h4 class="pf-sc-title">
                        <i class="fa fa-file-text-o me-1" style="color:#e67700;"/>Số đơn mua / bán
                    </h4>
                    <div class="pf-chart-guide">
                        <i class="fa fa-question-circle me-1"/>Số đơn mua hàng (PO) và đơn bán hàng (SO) mỗi tháng.
                    </div>
                    <t t-if="trendMonthlyData.length > 0">
                        <div class="pf-trend-chart">
                            <t t-foreach="trendMonthlyData" t-as="m" t-key="m.month">
                                <div class="pf-trend-row">
                                    <div class="pf-trend-month" t-esc="m.month_label"/>
                                    <div class="pf-trend-bars">
                                        <div class="pf-trend-bar-wrap">
                                            <div class="pf-trend-bar pf-trend-buy"
                                                 t-att-style="'width:' + getBarWidth(m.buy_count, trendMaxCount)"
                                                 t-att-title="'PO: ' + m.buy_count">
                                                <span class="pf-trend-val" t-if="m.buy_count > 0">
                                                    <t t-esc="m.buy_count"/> PO
                                                </span>
                                            </div>
                                        </div>
                                        <div class="pf-trend-bar-wrap">
                                            <div class="pf-trend-bar pf-trend-sell"
                                                 t-att-style="'width:' + getBarWidth(m.sell_count, trendMaxCount)"
                                                 t-att-title="'SO: ' + m.sell_count">
                                                <span class="pf-trend-val" t-if="m.sell_count > 0">
                                                    <t t-esc="m.sell_count"/> SO
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                            <div class="pf-dual-legend">
                                <span><span class="pf-dual-leg-dot pf-trend-buy"/> Đơn mua</span>
                                <span><span class="pf-dual-leg-dot pf-trend-sell"/> Đơn bán</span>
                            </div>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="pf-chart-empty">Chưa có dữ liệu</div>
                    </t>
                </div>

                <!-- 3. So với tháng trước -->
                <div class="pf-sc-card">
                    <h4 class="pf-sc-title">
                        <i class="fa fa-exchange me-1" style="color:#0ca678;"/>So với tháng trước
                    </h4>
                    <div class="pf-chart-guide">
                        <i class="fa fa-question-circle me-1"/>% thay đổi SL mua/bán và số đơn so tháng trước.
                    </div>
                    <t t-if="trendSummary.lastMonth">
                        <div class="pf-trend-compare">
                            <div class="pf-trend-cmp-row">
                                <span class="pf-trend-cmp-label">SL Mua</span>
                                <span class="pf-trend-cmp-prev"
                                      t-esc="formatNumber(trendSummary.prevMonth.buy_qty)"/>
                                <i class="fa fa-arrow-right pf-trend-cmp-arrow"/>
                                <span class="pf-trend-cmp-cur"
                                      t-esc="formatNumber(trendSummary.lastMonth.buy_qty)"/>
                                <span t-att-class="'pf-trend-cmp-pct ' + (trendSummary.buyChange >= 0 ? 'text-success' : 'text-danger')">
                                    <i t-att-class="'fa ' + (trendSummary.buyChange >= 0 ? 'fa-arrow-up' : 'fa-arrow-down')"/>
                                    <t t-esc="Math.abs(trendSummary.buyChange)"/>%
                                </span>
                            </div>
                            <div class="pf-trend-cmp-row">
                                <span class="pf-trend-cmp-label">SL Bán</span>
                                <span class="pf-trend-cmp-prev"
                                      t-esc="formatNumber(trendSummary.prevMonth.sell_qty)"/>
                                <i class="fa fa-arrow-right pf-trend-cmp-arrow"/>
                                <span class="pf-trend-cmp-cur"
                                      t-esc="formatNumber(trendSummary.lastMonth.sell_qty)"/>
                                <span t-att-class="'pf-trend-cmp-pct ' + (trendSummary.sellChange >= 0 ? 'text-success' : 'text-danger')">
                                    <i t-att-class="'fa ' + (trendSummary.sellChange >= 0 ? 'fa-arrow-up' : 'fa-arrow-down')"/>
                                    <t t-esc="Math.abs(trendSummary.sellChange)"/>%
                                </span>
                            </div>
                            <div class="pf-trend-cmp-row">
                                <span class="pf-trend-cmp-label">Đơn mua</span>
                                <span class="pf-trend-cmp-prev"
                                      t-esc="trendSummary.prevMonth.buy_count"/>
                                <i class="fa fa-arrow-right pf-trend-cmp-arrow"/>
                                <span class="pf-trend-cmp-cur"
                                      t-esc="trendSummary.lastMonth.buy_count"/>
                            </div>
                            <div class="pf-trend-cmp-row">
                                <span class="pf-trend-cmp-label">Đơn bán</span>
                                <span class="pf-trend-cmp-prev"
                                      t-esc="trendSummary.prevMonth.sell_count"/>
                                <i class="fa fa-arrow-right pf-trend-cmp-arrow"/>
                                <span class="pf-trend-cmp-cur"
                                      t-esc="trendSummary.lastMonth.sell_count"/>
                            </div>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="pf-chart-empty">Cần ít nhất 2 tháng dữ liệu</div>
                    </t>
                </div>

                <!-- 4. Số loại SP giao dịch -->
                <div class="pf-sc-card">
                    <h4 class="pf-sc-title">
                        <i class="fa fa-cubes me-1" style="color:#5f3dc4;"/>Số loại SP giao dịch
                    </h4>
                    <div class="pf-chart-guide">
                        <i class="fa fa-question-circle me-1"/>Số loại SP (SKU) được mua/bán mỗi tháng.
                    </div>
                    <t t-if="trendMonthlyData.length > 0">
                        <div class="pf-trend-chart">
                            <t t-foreach="trendMonthlyData" t-as="m" t-key="m.month">
                                <div class="pf-trend-row">
                                    <div class="pf-trend-month" t-esc="m.month_label"/>
                                    <div class="pf-trend-bars">
                                        <div class="pf-trend-bar-wrap">
                                            <div class="pf-trend-bar pf-trend-buy"
                                                 t-att-style="'width:' + getBarWidth(m.buy_products, trendMaxProducts)">
                                                <span class="pf-trend-val" t-if="m.buy_products > 0">
                                                    <t t-esc="m.buy_products"/> SP
                                                </span>
                                            </div>
                                        </div>
                                        <div class="pf-trend-bar-wrap">
                                            <div class="pf-trend-bar pf-trend-sell"
                                                 t-att-style="'width:' + getBarWidth(m.sell_products, trendMaxProducts)">
                                                <span class="pf-trend-val" t-if="m.sell_products > 0">
                                                    <t t-esc="m.sell_products"/> SP
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                            <div class="pf-dual-legend">
                                <span><span class="pf-dual-leg-dot pf-trend-buy"/> SP mua</span>
                                <span><span class="pf-dual-leg-dot pf-trend-sell"/> SP bán</span>
                            </div>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="pf-chart-empty">Chưa có dữ liệu</div>
                    </t>
                </div>
    </t>
</templates>
