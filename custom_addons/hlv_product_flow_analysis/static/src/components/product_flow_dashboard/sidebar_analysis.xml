<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hlv_product_flow_analysis.SidebarAnalysis">

                <!-- 1. Donut: Tỷ lệ Mua vs Bán -->
                <div class="pf-sc-card">
                    <h4 class="pf-sc-title">
                        <i class="fa fa-pie-chart me-1" style="color:#7048e8;"/>Tỷ lệ Mua vs Bán
                    </h4>
                    <div class="pf-chart-guide">
                        <i class="fa fa-question-circle me-1"/>Tổng SL mua và bán trong kỳ. So sánh tỷ trọng mua/bán để đánh giá cân đối.
                    </div>
                    <div class="pf-pie-container">
                        <div class="pf-pie-ring"
                             t-att-style="'--buy-deg:' + buySellRatioPie.buyDeg + 'deg'">
                            <div class="pf-pie-center">
                                <span class="pf-pie-total" t-esc="formatNumber(buySellRatioPie.buyQty + buySellRatioPie.sellQty)"/>
                                <span class="pf-pie-sublabel">Tổng SL</span>
                            </div>
                        </div>
                        <div class="pf-pie-legend">
                            <div class="pf-pie-leg-item">
                                <span class="pf-pie-leg-dot pf-leg-buy"/>
                                <span>Mua</span>
                                <strong><t t-esc="buySellRatioPie.buyPct"/>%</strong>
                                <span class="pf-pie-leg-val">(<t t-esc="formatNumber(buySellRatioPie.buyQty)"/>)</span>
                            </div>
                            <div class="pf-pie-leg-item">
                                <span class="pf-pie-leg-dot pf-leg-sell"/>
                                <span>Bán</span>
                                <strong><t t-esc="buySellRatioPie.sellPct"/>%</strong>
                                <span class="pf-pie-leg-val">(<t t-esc="formatNumber(buySellRatioPie.sellQty)"/>)</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. Donut: Phân bổ tần suất giao dịch -->
                <div class="pf-sc-card">
                    <h4 class="pf-sc-title">
                        <i class="fa fa-signal me-1" style="color:#e8590c;"/>Phân bổ tần suất
                    </h4>
                    <div class="pf-chart-guide">
                        <i class="fa fa-question-circle me-1"/>Nhóm SP theo số lần giao dịch (mua+bán): 1-2 lần / 3-5 / 6-10 / &gt;10 lần. Click để xem DS sản phẩm.
                    </div>
                    <div class="pf-freq-dist">
                        <div class="pf-freq-bar-stack">
                            <div class="pf-freq-seg pf-freq-rare pf-clickable" t-att-style="'width:' + frequencyPie.rare.pct + '%'"
                                 t-att-title="'1-2 lần: ' + frequencyPie.rare.count + ' SP'"
                                 t-on-click="() => this.drilldownFrequency('rare')"/>
                            <div class="pf-freq-seg pf-freq-low pf-clickable" t-att-style="'width:' + frequencyPie.low.pct + '%'"
                                 t-att-title="'3-5 lần: ' + frequencyPie.low.count + ' SP'"
                                 t-on-click="() => this.drilldownFrequency('low')"/>
                            <div class="pf-freq-seg pf-freq-med pf-clickable" t-att-style="'width:' + frequencyPie.medium.pct + '%'"
                                 t-att-title="'6-10 lần: ' + frequencyPie.medium.count + ' SP'"
                                 t-on-click="() => this.drilldownFrequency('medium')"/>
                            <div class="pf-freq-seg pf-freq-high pf-clickable" t-att-style="'width:' + frequencyPie.high.pct + '%'"
                                 t-att-title="'>10 lần: ' + frequencyPie.high.count + ' SP'"
                                 t-on-click="() => this.drilldownFrequency('high')"/>
                        </div>
                        <div class="pf-freq-legend">
                            <div class="pf-freq-leg-item pf-clickable" t-on-click="() => this.drilldownFrequency('rare')">
                                <span class="pf-freq-dot pf-freq-rare"/>
                                <span>1-2 lần</span>
                                <strong t-esc="frequencyPie.rare.count"/>
                            </div>
                            <div class="pf-freq-leg-item pf-clickable" t-on-click="() => this.drilldownFrequency('low')">
                                <span class="pf-freq-dot pf-freq-low"/>
                                <span>3-5 lần</span>
                                <strong t-esc="frequencyPie.low.count"/>
                            </div>
                            <div class="pf-freq-leg-item pf-clickable" t-on-click="() => this.drilldownFrequency('medium')">
                                <span class="pf-freq-dot pf-freq-med"/>
                                <span>6-10 lần</span>
                                <strong t-esc="frequencyPie.medium.count"/>
                            </div>
                            <div class="pf-freq-leg-item pf-clickable" t-on-click="() => this.drilldownFrequency('high')">
                                <span class="pf-freq-dot pf-freq-high"/>
                                <span>&gt;10 lần</span>
                                <strong t-esc="frequencyPie.high.count"/>
                            </div>
                        </div>
                        <div class="pf-freq-hint">
                            <i class="fa fa-info-circle me-1"/>
                            <t t-if="frequencyPie.rare.pct > 50">
                                <span class="text-warning"><t t-esc="frequencyPie.rare.pct"/>% SP chỉ giao dịch 1-2 lần → không nên ưu tiên kho</span>
                            </t>
                            <t t-elif="frequencyPie.high.pct > 30">
                                <span class="text-success"><t t-esc="frequencyPie.high.pct"/>% SP giao dịch &gt;10 lần → hàng chủ lực</span>
                            </t>
                            <t t-else="">
                                <span>Tổng <t t-esc="frequencyPie.total"/> SP giao dịch trong kỳ</span>
                            </t>
                        </div>
                    </div>
                </div>

                <!-- 3. Treemap: Cơ cấu hàng hóa -->
                <div class="pf-sc-card">
                    <h4 class="pf-sc-title">
                        <i class="fa fa-th-large me-1" style="color:#e03131;"/>Treemap: Cơ cấu hàng hóa
                    </h4>
                    <div class="pf-chart-guide">
                        <i class="fa fa-question-circle me-1"/>Diện tích ~ tổng SL mua+bán. Màu theo tần suất: đỏ ≥10, cam 5-9, vàng 2-4, xám 1 lần.
                    </div>
                    <t t-if="treemapData.rects.length > 0">
                        <div class="pf-svg-chart-wrap">
                            <svg class="pf-chart-svg" viewBox="0 0 300 200" preserveAspectRatio="xMidYMid meet">
                                <t t-foreach="treemapData.rects" t-as="r" t-key="r.id">
                                    <rect t-att-x="r.x" t-att-y="r.y" t-att-width="r.w" t-att-height="r.h"
                                          t-att-fill="r.color" stroke="#fff" stroke-width="1.5" rx="2" class="pf-tm-rect">
                                        <title t-esc="r.name + ': ' + formatNumber(r.qty) + ' (' + r.freq + ' lần)'"/>
                                    </rect>
                                    <t t-if="r.w > 35 &amp;&amp; r.h > 16">
                                        <text t-att-x="r.x + 4" t-att-y="r.y + 12"
                                              class="pf-tm-label" t-esc="r.label"/>
                                    </t>
                                    <t t-if="r.w > 50 &amp;&amp; r.h > 28">
                                        <text t-att-x="r.x + 4" t-att-y="r.y + 24"
                                              class="pf-tm-val" t-esc="formatNumber(r.qty)"/>
                                    </t>
                                </t>
                            </svg>
                        </div>
                        <div class="pf-tm-legend">
                            <span><span class="pf-tm-dot" style="background:#e03131;"/>≥10</span>
                            <span><span class="pf-tm-dot" style="background:#ff922b;"/>5-9</span>
                            <span><span class="pf-tm-dot" style="background:#fcc419;"/>2-4</span>
                            <span><span class="pf-tm-dot" style="background:#adb5bd;"/>1</span>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="pf-chart-empty">Chưa có dữ liệu</div>
                    </t>
                </div>

                <!-- 4. Scatter Plot: Mua vs Bán -->
                <div class="pf-sc-card">
                    <h4 class="pf-sc-title">
                        <i class="fa fa-dot-circle-o me-1" style="color:#2b8a3e;"/>Scatter: Mua vs Bán
                    </h4>
                    <div class="pf-chart-guide">
                        <i class="fa fa-question-circle me-1"/>Trục X = SL mua, Y = SL bán. Kích thước = tổng SL. Đường chéo = cân bằng mua/bán.
                    </div>
                    <t t-if="scatterPlotData.show">
                        <div class="pf-svg-chart-wrap">
                            <svg class="pf-chart-svg" t-att-viewBox="'0 0 ' + scatterPlotData.W + ' ' + scatterPlotData.H"
                                 preserveAspectRatio="xMidYMid meet">
                                <!-- Grid lines -->
                                <t t-foreach="scatterPlotData.xTicks" t-as="tk" t-key="tk.x">
                                    <line t-att-x1="tk.x" t-att-y1="scatterPlotData.pad.t"
                                          t-att-x2="tk.x" t-att-y2="scatterPlotData.axisBottom"
                                          stroke="#f1f3f5" stroke-width="0.5"/>
                                    <text t-att-x="tk.x" t-att-y="scatterPlotData.axisBottom + 14"
                                          class="pf-sc-tick" text-anchor="middle" t-esc="tk.label"/>
                                </t>
                                <t t-foreach="scatterPlotData.yTicks" t-as="tk" t-key="tk.y">
                                    <line t-att-x1="scatterPlotData.pad.l" t-att-y1="tk.y"
                                          t-att-x2="scatterPlotData.pad.l + scatterPlotData.plotW" t-att-y2="tk.y"
                                          stroke="#f1f3f5" stroke-width="0.5"/>
                                    <text t-att-x="scatterPlotData.pad.l - 4" t-att-y="tk.y + 3"
                                          class="pf-sc-tick" text-anchor="end" t-esc="tk.label"/>
                                </t>
                                <!-- Axes -->
                                <line t-att-x1="scatterPlotData.pad.l" t-att-y1="scatterPlotData.pad.t"
                                      t-att-x2="scatterPlotData.pad.l" t-att-y2="scatterPlotData.axisBottom"
                                      stroke="#ced4da" stroke-width="1"/>
                                <line t-att-x1="scatterPlotData.pad.l" t-att-y1="scatterPlotData.axisBottom"
                                      t-att-x2="scatterPlotData.pad.l + scatterPlotData.plotW" t-att-y2="scatterPlotData.axisBottom"
                                      stroke="#ced4da" stroke-width="1"/>
                                <!-- Diagonal reference (1:1) -->
                                <line t-att-x1="scatterPlotData.diagX1" t-att-y1="scatterPlotData.diagY1"
                                      t-att-x2="scatterPlotData.diagX2" t-att-y2="scatterPlotData.diagY2"
                                      stroke="#dee2e6" stroke-width="0.8" stroke-dasharray="4,3"/>
                                <!-- Axis labels -->
                                <text t-att-x="scatterPlotData.pad.l + scatterPlotData.plotW / 2"
                                      t-att-y="scatterPlotData.H - 2"
                                      class="pf-sc-axis-label" text-anchor="middle">SL Mua →</text>
                                <text x="10" t-att-y="scatterPlotData.pad.t + scatterPlotData.plotH / 2"
                                      class="pf-sc-axis-label" text-anchor="middle"
                                      transform="rotate(-90, 10, 110)">SL Bán →</text>
                                <!-- Points -->
                                <t t-foreach="scatterPlotData.points" t-as="pt" t-key="pt.id">
                                    <circle t-att-cx="pt.x" t-att-cy="pt.y" t-att-r="pt.r"
                                            t-att-fill="pt.color" opacity="0.7" stroke="#fff" stroke-width="0.5"
                                            class="pf-scatter-dot">
                                        <title t-esc="pt.name + ' | Mua: ' + formatNumber(pt.buyQty) + ' | Bán: ' + formatNumber(pt.sellQty)"/>
                                    </circle>
                                </t>
                            </svg>
                        </div>
                        <div class="pf-scatter-legend">
                            <span><span class="pf-tm-dot" style="background:#e03131;"/>Bán &gt; Mua</span>
                            <span><span class="pf-tm-dot" style="background:#2b8a3e;"/>Cân bằng</span>
                            <span><span class="pf-tm-dot" style="background:#339af0;"/>Mua &gt; Bán</span>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="pf-chart-empty">Chưa có dữ liệu</div>
                    </t>
                </div>

                <!-- 5. SVG Heatmap: Tổng quan đa chiều -->
                <div class="pf-sc-card">
                    <h4 class="pf-sc-title">
                        <i class="fa fa-th me-1" style="color:#845ef7;"/>Heatmap: Tổng quan đa chiều
                    </h4>
                    <div class="pf-chart-guide">
                        <i class="fa fa-question-circle me-1"/>Ma trận SP × chỉ số: SL mua, lần mua, SL bán, lần bán, tồn kho. Màu đậm = giá trị cao.
                    </div>
                    <t t-if="svgHeatmapData.show">
                        <div class="pf-svg-chart-wrap pf-svg-heatmap-wrap">
                            <svg class="pf-chart-svg" t-att-viewBox="'0 0 ' + svgHeatmapData.W + ' ' + svgHeatmapData.H"
                                 preserveAspectRatio="xMidYMid meet">
                                <!-- Metric column headers -->
                                <t t-foreach="svgHeatmapData.mLabels" t-as="ml" t-key="ml.text">
                                    <text t-att-x="ml.x" t-att-y="ml.y"
                                          class="pf-hm-header" text-anchor="middle" t-esc="ml.text"/>
                                </t>
                                <!-- Row labels -->
                                <t t-foreach="svgHeatmapData.rowLabels" t-as="rl" t-key="rl.text">
                                    <text t-att-x="rl.x" t-att-y="rl.y"
                                          class="pf-hm-row-label" t-esc="rl.text">
                                        <title t-esc="rl.title"/>
                                    </text>
                                </t>
                                <!-- Heatmap cells -->
                                <t t-foreach="svgHeatmapData.cells" t-as="c" t-key="c.key">
                                    <rect t-att-x="c.x" t-att-y="c.y" t-att-width="c.w" t-att-height="c.h"
                                          t-att-fill="c.fill" rx="2" class="pf-hm-svg-cell">
                                        <title t-esc="c.title"/>
                                    </rect>
                                    <text t-att-x="c.x + c.w / 2" t-att-y="c.y + c.h / 2 + 3.5"
                                          class="pf-hm-cell-text" text-anchor="middle" t-esc="c.val"/>
                                </t>
                            </svg>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="pf-chart-empty">Chưa có dữ liệu</div>
                    </t>
                </div>

                <!-- 6. Dual Bars: So sánh SL Mua vs Bán per product -->
                <div class="pf-sc-card">
                    <h4 class="pf-sc-title">
                        <i class="fa fa-exchange me-1" style="color:#1971c2;"/>Top SP: Mua vs Bán
                    </h4>
                    <div class="pf-chart-guide">
                        <i class="fa fa-question-circle me-1"/>Top <t t-esc="state.topN"/> SP có tổng giao dịch cao nhất. Thanh xanh = SL mua, thanh hồng = SL bán.
                    </div>
                    <div class="pf-dual-bars">
                        <t t-foreach="topBuySellComparison.items" t-as="item" t-key="item.product_id">
                            <div class="pf-dual-row">
                                <div class="pf-dual-label" t-att-title="item.product_name">
                                    <span t-esc="item.default_code || '?'"/>
                                </div>
                                <div class="pf-dual-tracks">
                                    <div class="pf-dual-track">
                                        <div class="pf-dual-fill pf-dual-buy"
                                             t-att-style="'width:' + getBarWidth(item.incoming_qty, topBuySellComparison.maxVal)">
                                            <span class="pf-dual-val" t-esc="formatNumber(item.incoming_qty)"/>
                                        </div>
                                    </div>
                                    <div class="pf-dual-track">
                                        <div class="pf-dual-fill pf-dual-sell"
                                             t-att-style="'width:' + getBarWidth(item.outgoing_qty, topBuySellComparison.maxVal)">
                                            <span class="pf-dual-val" t-esc="formatNumber(item.outgoing_qty)"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                        <div class="pf-dual-legend">
                            <span><span class="pf-dual-leg-dot pf-dual-buy"/> Mua</span>
                            <span><span class="pf-dual-leg-dot pf-dual-sell"/> Bán</span>
                        </div>
                    </div>
                </div>

                <!-- 7. Product Buy/Sell Heatmap (4 dimensions) -->
                <div class="pf-sc-card">
                    <h4 class="pf-sc-title">
                        <i class="fa fa-th me-1" style="color:#e64980;"/>Nhiệt: SL × Tần suất
                    </h4>
                    <div class="pf-chart-guide">
                        <i class="fa fa-question-circle me-1"/>Heatmap 4 chiều: SL mua, lần mua, SL bán, lần bán cho top 12 SP. Màu đậm = giá trị cao.
                    </div>
                    <t t-if="productBuySellHeat.items.length > 0">
                        <div class="pf-heatmap-wrap">
                            <table class="pf-heatmap pf-hm-product">
                                <thead>
                                    <tr>
                                        <th class="pf-hm-corner">SP</th>
                                        <th class="pf-hm-col-head"><span>SL Mua</span></th>
                                        <th class="pf-hm-col-head"><span>Lần Mua</span></th>
                                        <th class="pf-hm-col-head"><span>SL Bán</span></th>
                                        <th class="pf-hm-col-head"><span>Lần Bán</span></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="productBuySellHeat.items" t-as="p" t-key="p.product_id">
                                        <tr>
                                            <td class="pf-hm-row-head" t-att-title="p.product_name">
                                                <span t-esc="p.default_code || p.product_name.substring(0, 10)"/>
                                            </td>
                                            <td t-att-class="'pf-hm-cell pf-hm-buy-' + getHeatLevel(p.incoming_qty, productBuySellHeat.maxBuyQty)"
                                                t-att-title="'SL Mua: ' + formatNumber(p.incoming_qty)">
                                                <span t-esc="formatNumber(p.incoming_qty)"/>
                                            </td>
                                            <td t-att-class="'pf-hm-cell pf-hm-buyf-' + getHeatLevel(p.incoming_count, productBuySellHeat.maxBuyFreq)"
                                                t-att-title="'Lần mua: ' + p.incoming_count">
                                                <span t-esc="p.incoming_count"/>
                                            </td>
                                            <td t-att-class="'pf-hm-cell pf-hm-sell-' + getHeatLevel(p.outgoing_qty, productBuySellHeat.maxSellQty)"
                                                t-att-title="'SL Bán: ' + formatNumber(p.outgoing_qty)">
                                                <span t-esc="formatNumber(p.outgoing_qty)"/>
                                            </td>
                                            <td t-att-class="'pf-hm-cell pf-hm-sellf-' + getHeatLevel(p.outgoing_count, productBuySellHeat.maxSellFreq)"
                                                t-att-title="'Lần bán: ' + p.outgoing_count">
                                                <span t-esc="p.outgoing_count"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                        <div class="pf-hm-legend pf-hm-legend-multi">
                            <div>
                                <span class="pf-hm-legend-label">Mua:</span>
                                <span class="pf-hm-swatch pf-hm-buy-1"/>
                                <span class="pf-hm-swatch pf-hm-buy-4"/>
                            </div>
                            <div>
                                <span class="pf-hm-legend-label">Bán:</span>
                                <span class="pf-hm-swatch pf-hm-sell-1"/>
                                <span class="pf-hm-swatch pf-hm-sell-4"/>
                            </div>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="pf-chart-empty">Chưa có dữ liệu</div>
                    </t>
                </div>

                <!-- 8. Tối ưu mua hàng -->
                <div class="pf-sc-card">
                    <h4 class="pf-sc-title">
                        <i class="fa fa-shopping-cart me-1" style="color:#2b8a3e;"/>Tối ưu mua hàng
                    </h4>
                    <div class="pf-chart-guide">
                        <i class="fa fa-question-circle me-1"/>Đề xuất dựa trên: SL bán − SL mua − Tồn kho. Chỉ hiện SP bán thường xuyên mà tồn thấp (cần mua) hoặc mua nhiều mà tồn dư (giảm mua).
                    </div>
                    <t t-if="purchaseOptimization.underBuy.length > 0">
                        <div class="pf-opt-section">
                            <div class="pf-opt-label pf-opt-under">
                                <i class="fa fa-arrow-up me-1"/>Cần mua thêm (tồn không đủ)
                            </div>
                            <t t-foreach="purchaseOptimization.underBuy" t-as="p" t-key="p.product_id">
                                <div class="pf-opt-row">
                                    <span class="pf-opt-name" t-att-title="p.product_name">
                                        <span class="pf-code me-1" t-esc="p.default_code || '?'"/>
                                    </span>
                                    <span class="pf-opt-stats">
                                        <span class="pf-opt-sell">B: <t t-esc="formatNumber(p.sellQty)"/> (<t t-esc="p.sellFreq"/>x)</span>
                                        <span class="pf-opt-stock">Tồn: <t t-esc="formatNumber(p.stock)"/></span>
                                    </span>
                                    <span class="pf-opt-ratio text-danger">Thiếu <t t-esc="formatNumber(p.netNeed)"/></span>
                                </div>
                            </t>
                        </div>
                    </t>
                    <t t-if="purchaseOptimization.overBuy.length > 0">
                        <div class="pf-opt-section">
                            <div class="pf-opt-label pf-opt-over">
                                <i class="fa fa-arrow-down me-1"/>Nên giảm mua (tồn dư nhiều)
                            </div>
                            <t t-foreach="purchaseOptimization.overBuy" t-as="p" t-key="p.product_id">
                                <div class="pf-opt-row">
                                    <span class="pf-opt-name" t-att-title="p.product_name">
                                        <span class="pf-code me-1" t-esc="p.default_code || '?'"/>
                                    </span>
                                    <span class="pf-opt-stats">
                                        <span class="pf-opt-buy">M: <t t-esc="formatNumber(p.buyQty)"/> (<t t-esc="p.buyFreq"/>x)</span>
                                        <span class="pf-opt-sell">B: <t t-esc="formatNumber(p.sellQty)"/> (<t t-esc="p.sellFreq"/>x)</span>
                                        <span class="pf-opt-stock">Tồn: <t t-esc="formatNumber(p.stock)"/></span>
                                    </span>
                                    <span class="pf-opt-ratio text-warning"
                                          t-att-title="'Tồn kho gấp ' + p.stockCover + ' lần SL bán'"
                                          t-esc="p.stockCoverLabel"/>
                                </div>
                            </t>
                        </div>
                    </t>
                    <t t-if="purchaseOptimization.underBuy.length === 0 &amp;&amp; purchaseOptimization.overBuy.length === 0">
                        <div class="pf-chart-empty">
                            <i class="fa fa-check-circle me-1 text-success"/>Mua bán cân đối
                        </div>
                    </t>
                </div>

                <!-- 9. Original NCC × SP heatmap -->
                <div class="pf-sc-card">
                    <h4 class="pf-sc-title">
                        <i class="fa fa-th me-1" style="color:#e64980;"/>NCC × Sản phẩm (SL mua)
                    </h4>
                    <div class="pf-chart-guide">
                        <i class="fa fa-question-circle me-1"/>Ma trận NCC vs SP: hiển thị SL mua từ mỗi NCC cho từng SP. Màu đậm = mua nhiều hơn.
                    </div>
                    <t t-if="supplierProductHeatmap.rows.length > 0">
                        <div class="pf-heatmap-wrap">
                            <table class="pf-heatmap">
                                <thead>
                                    <tr>
                                        <th class="pf-hm-corner"/>
                                        <t t-foreach="supplierProductHeatmap.products" t-as="pr" t-key="pr.id">
                                            <th class="pf-hm-col-head" t-att-title="pr.name">
                                                <span t-esc="pr.name"/>
                                            </th>
                                        </t>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="supplierProductHeatmap.rows" t-as="row" t-key="row.supplierName">
                                        <tr>
                                            <td class="pf-hm-row-head" t-att-title="row.supplierName">
                                                <span t-esc="row.supplierName"/>
                                            </td>
                                            <t t-foreach="row.cells" t-as="cell" t-key="cell.productId">
                                                <td t-att-class="'pf-hm-cell ' + getHeatmapCellClass(cell.qty, supplierProductHeatmap.maxQty)"
                                                    t-att-title="(cell.qty > 0 ? formatNumber(cell.qty) : '-')">
                                                    <span t-if="cell.qty > 0" t-esc="formatNumber(cell.qty)"/>
                                                </td>
                                            </t>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                        <div class="pf-hm-legend">
                            <span class="pf-hm-legend-label">Ít</span>
                            <span class="pf-hm-swatch pf-hm-1"/>
                            <span class="pf-hm-swatch pf-hm-2"/>
                            <span class="pf-hm-swatch pf-hm-3"/>
                            <span class="pf-hm-swatch pf-hm-4"/>
                            <span class="pf-hm-legend-label">Nhiều</span>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="pf-chart-empty">Chưa có dữ liệu NCC</div>
                    </t>
                </div>
    </t>
</templates>