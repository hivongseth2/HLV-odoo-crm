<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View - Thêm trường print_sequence vào form chi tiết -->
        <record id="stock_picking_form_inherit_print_sequence" model="ir.ui.view">
            <field name="name">stock.picking.form.inherit.print.sequence</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <!-- Thêm vào sau trường origin_picking_id -->
                <xpath expr="//field[@name='origin']" position="after">
                    <field name="print_sequence" widget="integer" string="Thứ tự in"/>
                    <field name="print_sequence_note"/>
                </xpath>
            </field>
        </record>

        <!-- Search View - Thêm filter/search cho print_sequence -->
        <record id="stock_picking_search_inherit_print_sequence" model="ir.ui.view">
            <field name="name">stock.picking.search.inherit.print.sequence</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_search"/>
            <field name="arch" type="xml">
                <!-- Thêm filter cho print_sequence -->
                <xpath expr="//search" position="inside">
                    <separator/>
                    <filter name="has_print_sequence" string="Có thứ tự in" domain="[('print_sequence', '&gt;', 0)]"/>
                    <filter name="no_print_sequence" string="Chưa sắp xếp" domain="[('print_sequence', '=', 0)]"/>
                </xpath>
            </field>
        </record>

        <!-- Action View - Sắp xếp thứ tự in cho Outgoing Picking -->
        <record id="action_stock_picking_sortable_outgoing" model="ir.actions.act_window">
            <field name="name">Sắp xếp thứ tự in - Xuất kho</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">stock.picking</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('picking_type_id.code', '=', 'outgoing')]</field>
            <field name="context">{'search_default_outgoing': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Sắp xếp thứ tự in biên bản đi / Delivery Order
                </p>
                <p>
                    Bước 1: Nhập số thứ tự trong cột "Thứ tự in" (số nhỏ hơn sẽ in trước)<br/>
                    Bước 2: Click nút "In theo thứ tự" để in các phiếu đã sắp xếp<br/>
                    Hoặc dùng nút "Đánh số tự động" để tự động đánh số theo ngày tạo
                </p>
            </field>
        </record>

        <!-- Action View - Sắp xếp thứ tự in cho Internal Picking -->
        <record id="action_stock_picking_sortable_internal" model="ir.actions.act_window">
            <field name="name">Sắp xếp thứ tự in - Chuyển nội bộ</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">stock.picking</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('picking_type_id.code', '=', 'internal')]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Sắp xếp thứ tự in biên bản chuyển nội bộ
                </p>
            </field>
        </record>

        <!-- Menu Items -->
        <menuitem
            id="menu_picking_print_sequence"
            name="Sắp xếp thứ tự in"
            parent="stock.menu_stock_warehouse_mgmt"
            action="action_stock_picking_sortable_outgoing"
            sequence="20"/>

        <menuitem
            id="menu_picking_print_sequence_internal"
            name="Chuyển nội bộ"
            parent="menu_picking_print_sequence"
            action="action_stock_picking_sortable_internal"
            sequence="10"/>

        <!-- Button Actions in Form View -->
        <record id="stock_picking_form_inherit_buttons" model="ir.ui.view">
            <field name="name">stock.picking.form.inherit.buttons</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='button_validate']" position="before">
                    <button name="action_print_by_sequence" type="object" 
                            string="In theo thứ tự" class="btn-secondary"/>
                </xpath>
            </field>
        </record>

        <!-- Server action group - Các action hàng loạt -->
        <record id="action_stock_picking_auto_sequence" model="ir.actions.server">
            <field name="name">Đánh số thứ tự tự động</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="binding_view_types">list,tree</field>
            <field name="state">code</field>
            <field name="code"><![CDATA[
records_to_sequence = records.filtered(lambda p: p.print_sequence == 0)
if records_to_sequence:
    sorted_rec = records_to_sequence.sorted(key=lambda p: p.create_date)
    for idx, picking in enumerate(sorted_rec, 1):
        picking.print_sequence = idx
            ]]></field>
        </record>

        <record id="action_stock_picking_reset_sequence" model="ir.actions.server">
            <field name="name">Xóa thứ tự in</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="binding_view_types">list,tree</field>
            <field name="state">code</field>
            <field name="code"><![CDATA[
records.write({
    'print_sequence': 0,
    'print_sequence_note': ''
})
            ]]></field>
        </record>

    </data>
</odoo>
