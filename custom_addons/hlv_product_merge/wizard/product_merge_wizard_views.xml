<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hlv_product_merge_wizard_form" model="ir.ui.view">
        <field name="name">hlv.product.merge.wizard.form</field>
        <field name="model">hlv.product.merge.wizard</field>
        <field name="arch" type="xml">
            <form string="Gộp sản phẩm">
                <group>
                    <group string="Sản phẩm giữ lại">
                        <field name="base_product_id"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="base_uom_id"/>
                    </group>
                    <group string="Sản phẩm sẽ được gộp và lưu trữ">
                        <field name="source_product_id"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="source_uom_id"/>
                    </group>
                </group>

                <field name="is_uom_different" invisible="1"/>
                <div class="alert alert-warning" role="alert"
                     invisible="not is_uom_different">
                    Hai sản phẩm có đơn vị tính khác nhau. Số lượng đích đã được điền
                    ban đầu bằng tồn nguồn; hãy kiểm tra và chỉnh lại số quy đổi cho
                    từng vị trí/lô nếu tỷ lệ không phải 1:1.
                </div>
                <div class="alert alert-danger" role="alert"
                     invisible="not blocker_text">
                    <strong>Chưa thể gộp do còn chứng từ hoặc tồn giữ chỗ:</strong>
                    <field name="blocker_text" nolabel="1" readonly="1"/>
                </div>

                <separator string="Tồn kho hiện tại của sản phẩm được gộp"/>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="location_id"/>
                        <field name="lot_id" optional="show"/>
                        <field name="quant_count" optional="hide"/>
                        <field name="company_id" optional="hide"/>
                        <field name="source_quantity"/>
                        <field name="source_uom_id"/>
                        <field name="target_quantity"
                               readonly="not parent.is_uom_different"
                               decoration-danger="parent.is_uom_different and target_quantity == 0"/>
                        <field name="target_uom_id"/>
                    </list>
                </field>
                <div class="alert alert-info" role="alert">
                    Hệ thống sẽ kiểm tra lại đơn bán, đơn mua, phiếu kho/chuyển kho,
                    tồn giữ chỗ và số tồn ngay lúc xác nhận. Sản phẩm gốc được giữ lại;
                    sản phẩm còn lại sẽ được lưu trữ sau khi chuyển tồn thành công.
                </div>
                <group>
                    <field name="note" placeholder="Lý do hoặc ghi chú cho lần gộp này..."/>
                    <field name="confirm"/>
                </group>
                <footer>
                    <button name="action_confirm_merge"
                            type="object"
                            string="Gộp sản phẩm"
                            class="btn-primary"/>
                    <button string="Hủy" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hlv_product_merge_wizard" model="ir.actions.act_window">
        <field name="name">Gộp sản phẩm</field>
        <field name="res_model">hlv.product.merge.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_hlv_merge_product_variants" model="ir.actions.server">
        <field name="name">Gộp sản phẩm</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[(4, ref('stock.group_stock_manager'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_open_hlv_product_merge_wizard()</field>
    </record>

    <record id="action_hlv_merge_product_templates" model="ir.actions.server">
        <field name="name">Gộp sản phẩm</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[(4, ref('stock.group_stock_manager'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_open_hlv_product_merge_wizard()</field>
    </record>
</odoo>
