<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_cancel_request_tree" model="ir.ui.view">
        <field name="name">sale.order.cancel.request.tree</field>
        <field name="model">sale.order.cancel.request</field>
        <field name="arch" type="xml">
            <list string="Yêu cầu Hủy Đơn" decoration-info="state == 'draft'" decoration-muted="state == 'done'" decoration-danger="state == 'rejected'" decoration-warning="state in ('submitted', 'accountant_confirmed')" create="0">
                <field name="name"/>
                <field name="create_date" string="Ngày Yêu Cầu"/>
                <field name="salesperson_name"/>
                <field name="order_reference"/>
                <field name="type"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'submitted'" decoration-primary="state == 'accountant_confirmed'" decoration-success="state == 'done'" decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_sale_order_cancel_request_form" model="ir.ui.view">
        <field name="name">sale.order.cancel.request.form</field>
        <field name="model">sale.order.cancel.request</field>
        <field name="arch" type="xml">
            <form string="Yêu cầu Hủy Đơn" create="0">
                <header>
                    <button name="action_submit" string="Gửi Yêu Cầu" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_accountant_confirm" string="Kế Toán Xác Nhận" type="object" class="oe_highlight" invisible="state != 'submitted'"/>
                    <button name="action_warehouse_confirm" string="Kho Xác Nhận" type="object" class="oe_highlight" invisible="state != 'accountant_confirmed'"/>
                    <button name="action_reject" string="Từ Chối" type="object" invisible="state not in ('draft', 'submitted', 'accountant_confirmed')"/>
                    <button name="action_draft" string="Về Nháp" type="object" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,accountant_confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Mã Phiếu"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Thông tin Yêu cầu">
                            <field name="salesperson_name" readonly="state != 'draft'"/>
                            <field name="salesperson_zalo_uid" readonly="state != 'draft'" placeholder="Nhập Zalo UID để nhận thông báo"/>
                            <field name="type" readonly="state != 'draft'"/>
                            <field name="create_date" string="Ngày tạo" readonly="1"/>
                            <field name="state" invisible="1"/>
                        </group>
                        <group string="Thông tin Đơn hàng">
                            <field name="order_reference" readonly="state != 'draft'"/>
                            <field name="order_id" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Lý do / Nội dung"/>
                    <field name="reason" readonly="state != 'draft'" placeholder="Nhập lý do chi tiết..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sale_order_cancel_request_search" model="ir.ui.view">
        <field name="name">sale.order.cancel.request.search</field>
        <field name="model">sale.order.cancel.request</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm">
                <field name="name"/>
                <field name="salesperson_name"/>
                <field name="order_reference"/>
                <filter string="Nháp" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Đã Gửi" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="KT Đã Xác Nhận" name="accountant_confirmed" domain="[('state', '=', 'accountant_confirmed')]"/>
                <filter string="Hoàn Thành" name="done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <group expand="0" string="Nhóm Theo">
                    <filter string="Trạng Thái" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Loại" name="group_by_type" context="{'group_by': 'type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sale_order_cancel_request" model="ir.actions.act_window">
        <field name="name">Yêu cầu Hủy Đơn</field>
        <field name="res_model">sale.order.cancel.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sale_order_cancel_request_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Không có yêu cầu hủy đơn nào.
            </p>
        </field>
    </record>

    <menuitem id="menu_sale_order_cancel_request"
              name="Yêu cầu Hủy Đơn"
              parent="sale.menu_sale_config"
              action="action_sale_order_cancel_request"
              sequence="50"/>
</odoo>
