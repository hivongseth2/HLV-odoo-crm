<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="cancel_request_layout" name="Cancellation Request Layout" inherit_id="web.frontend_layout" primary="True">
        <xpath expr="//div[@id='wrapwrap']" position="before">
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
        </xpath>
        <xpath expr="//main" position="replace">
            <div id="wrap" class="o_portal_wrap">
                <div class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-lg-6 col-md-8">
                            <div class="card shadow-sm">
                                <div class="card-body p-4">
                                    <!-- Navigation Tabs -->
                                    <ul class="nav nav-pills mb-4 justify-content-center" style="border-bottom: 2px solid #e9ecef; padding-bottom: 15px;">
                                        <li class="nav-item mx-1">
                                            <a class="nav-link text-dark" href="/search_stock" style="font-weight: 500; font-size: 0.85rem;">Tra cứu tồn kho</a>
                                        </li>
                                        <li class="nav-item mx-1">
                                            <a class="nav-link text-dark" href="/misa/purchase/lookup" style="font-weight: 500; font-size: 0.85rem;">Tra cứu chứng từ</a>
                                        </li>
                                        <li class="nav-item mx-1">
                                            <a class="nav-link active bg-primary text-white" href="/search_invoice" style="font-weight: 600; font-size: 0.85rem;">Tra cứu hóa đơn</a>
                                        </li>
                                    </ul>
                                    <div class="text-center mb-4">
                                        <h3 class="text-primary">Yêu cầu Hủy/Sửa Đơn Hàng</h3>
                                    </div>
                                    <t t-out="0"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <template id="cancel_request_login" name="Login">
        <t t-call="hlv_order_cancel_request.cancel_request_layout">
            <form method="post" class="mt-4">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                
                <div class="mb-3">
                    <label for="password" class="form-label">Mật khẩu truy cập</label>
                    <input type="password" class="form-control" id="password" name="password" required="required" placeholder="Nhập mật khẩu..."/>
                </div>
                
                <t t-if="error">
                    <div class="alert alert-danger" role="alert">
                        <t t-esc="error"/>
                    </div>
                </t>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary">Đăng nhập</button>
                </div>
            </form>
        </t>
    </template>

    <template id="cancel_request_form" name="Request Form">
        <t t-call="hlv_order_cancel_request.cancel_request_layout">
            <style>
                .saler-dropdown-wrapper { position: relative; }
                .saler-dropdown {
                    position: absolute;
                    top: 100%;
                    left: 0;
                    right: 0;
                    max-height: 200px;
                    overflow-y: auto;
                    background: #fff;
                    border: 1px solid #ced4da;
                    border-radius: 0.375rem;
                    z-index: 1000;
                    display: none;
                    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
                }
                .saler-dropdown.show { display: block; }
                .saler-dropdown-item {
                    padding: 8px 12px;
                    cursor: pointer;
                }
                .saler-dropdown-item:hover { background: #f8f9fa; }
            </style>
            
            <form method="post" class="mt-2">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                
                <div class="mb-3 saler-dropdown-wrapper">
                    <label for="salesperson_name" class="form-label">Mã Sale <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="salesperson_name" name="salesperson_name" 
                           t-att-value="values.get('salesperson_name')" required="required" 
                           placeholder="Click để chọn mã sale..." autocomplete="off"/>
                    <div id="saler_dropdown" class="saler-dropdown"></div>
                </div>

                <div class="mb-3">
                    <label for="order_reference" class="form-label">Mã Đơn Hàng <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="order_reference" name="order_reference" t-att-value="values.get('order_reference')" required="required" placeholder="VD: SO12345"/>
                </div>

                <div class="mb-3">
                    <label class="form-label">Loại Yêu Cầu</label>
                    <div class="d-flex gap-3">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="type" id="type_cancel" value="cancel" checked="checked"/>
                            <label class="form-check-label" for="type_cancel">Hủy Đơn</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="type" id="type_modify" value="modify" t-att-checked="values.get('type') == 'modify'"/>
                            <label class="form-check-label" for="type_modify">Chỉnh Sửa</label>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="reason" class="form-label">Lý do / Nội dung <span class="text-danger">*</span></label>
                    <textarea class="form-control" id="reason" name="reason" rows="3" required="required" placeholder="Nhập lý do hủy hoặc nội dung cần sửa..."><t t-esc="values.get('reason')"/></textarea>
                </div>

                <t t-if="error and error.get('main')">
                    <div class="alert alert-danger" role="alert">
                        <t t-esc="error['main']"/>
                    </div>
                </t>

                <div class="d-grid gap-2 mt-4">
                    <button type="submit" class="btn btn-primary btn-lg">Gửi Yêu Cầu</button>
                </div>
            </form>

            <script type="text/javascript">
                (function() {
                    var input = document.getElementById('salesperson_name');
                    var dropdown = document.getElementById('saler_dropdown');
                    var allItems = [];
                    
                    function renderDropdown(items) {
                        dropdown.innerHTML = '';
                        items.forEach(function(item) {
                            var div = document.createElement('div');
                            div.className = 'saler-dropdown-item';
                            div.textContent = item;
                            div.addEventListener('click', function() {
                                input.value = item;
                                dropdown.classList.remove('show');
                            });
                            dropdown.appendChild(div);
                        });
                        if (items.length > 0) {
                            dropdown.classList.add('show');
                        } else {
                            dropdown.classList.remove('show');
                        }
                    }
                    
                    function loadAndShow() {
                        fetch('/cancel-request/autocomplete/saler?term=')
                            .then(function(r) { return r.json(); })
                            .then(function(data) {
                                allItems = data;
                                renderDropdown(data);
                            });
                    }
                    
                    // Show dropdown on click/focus
                    input.addEventListener('focus', loadAndShow);
                    input.addEventListener('click', function() {
                        if (!dropdown.classList.contains('show')) {
                            loadAndShow();
                        }
                    });
                    
                    // Filter on input
                    input.addEventListener('input', function() {
                        var val = input.value.toLowerCase();
                        var filtered = allItems.filter(function(item) {
                            return item.toLowerCase().indexOf(val) >= 0;
                        });
                        renderDropdown(filtered);
                    });
                    
                    // Hide on click outside
                    document.addEventListener('click', function(e) {
                        if (!input.contains(e.target) &amp;&amp; !dropdown.contains(e.target)) {
                            dropdown.classList.remove('show');
                        }
                    });
                })();
            </script>
        </t>
    </template>

    <template id="cancel_request_success" name="Success">
        <t t-call="hlv_order_cancel_request.cancel_request_layout">
            <div class="text-center py-4">
                <div class="text-success mb-3" style="font-size: 3rem;">
                    <i class="fa fa-check-circle"></i>
                </div>
                <h4 class="mb-3">Gửi yêu cầu thành công!</h4>
                <p class="text-muted mb-4">
                    Mã yêu cầu: <strong class="text-dark"><t t-esc="cancel_req.name if cancel_req else 'N/A'"/></strong><br/>
                    Thông báo đã được gửi đến Kế toán và Thủ kho.<br/>
                    Bạn sẽ nhận thông báo qua Zalo khi yêu cầu được xử lý xong.
                </p>
                <a href="/cancel-request/form" class="btn btn-outline-primary">Tạo yêu cầu mới</a>
            </div>
        </t>
    </template>
</odoo>
