<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="cancel_request_layout" name="Cancellation Request Layout" inherit_id="web.frontend_layout" primary="True">
        <xpath expr="//div[@id='wrapwrap']" position="before">
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
        </xpath>
        <xpath expr="//main" position="replace">
            <div id="wrap" class="o_portal_wrap">
                <div class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-lg-6 col-md-8">
                            <div class="card shadow-sm">
                                <div class="card-body p-4">
                                    <div class="text-center mb-4">
                                        <h3 class="text-primary">Yêu cầu Hủy/Sửa Đơn Hàng</h3>
                                    </div>
                                    <t t-out="0"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <template id="cancel_request_login" name="Login">
        <t t-call="hlv_order_cancel_request.cancel_request_layout">
            <form method="post" class="mt-4">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                
                <div class="mb-3">
                    <label for="password" class="form-label">Mật khẩu truy cập</label>
                    <input type="password" class="form-control" id="password" name="password" required="required" placeholder="Nhập mật khẩu..."/>
                </div>
                
                <t t-if="error">
                    <div class="alert alert-danger" role="alert">
                        <t t-esc="error"/>
                    </div>
                </t>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary">Đăng nhập</button>
                </div>
            </form>
        </t>
    </template>

    <template id="cancel_request_form" name="Request Form">
        <t t-call="hlv_order_cancel_request.cancel_request_layout">
            <form method="post" class="mt-2">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                
                <div class="mb-3">
                    <label for="salesperson_name" class="form-label">Mã Sale <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="salesperson_name" name="salesperson_name" 
                           t-att-value="values.get('salesperson_name')" required="required" 
                           placeholder="Nhập mã sale..." list="salesperson_list" autocomplete="off"/>
                    <datalist id="salesperson_list">
                        <!-- Populated by JS -->
                    </datalist>
                </div>

                <div class="mb-3">
                    <label for="salesperson_zalo_uid" class="form-label">Zalo UID của bạn <span class="text-muted">(để nhận thông báo)</span></label>
                    <input type="text" class="form-control" id="salesperson_zalo_uid" name="salesperson_zalo_uid" 
                           t-att-value="values.get('salesperson_zalo_uid')" 
                           placeholder="Nhập Zalo UID của bạn..."/>
                    <small class="text-muted">Nhập Zalo User ID để nhận thông báo khi yêu cầu được xử lý xong.</small>
                </div>

                <div class="mb-3">
                    <label for="order_reference" class="form-label">Mã Đơn Hàng <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="order_reference" name="order_reference" t-att-value="values.get('order_reference')" required="required" placeholder="VD: SO12345"/>
                </div>

                <div class="mb-3">
                    <label class="form-label">Loại Yêu Cầu</label>
                    <div class="d-flex gap-3">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="type" id="type_cancel" value="cancel" checked="checked"/>
                            <label class="form-check-label" for="type_cancel">Hủy Đơn</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="type" id="type_modify" value="modify" t-att-checked="values.get('type') == 'modify'"/>
                            <label class="form-check-label" for="type_modify">Chỉnh Sửa</label>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="reason" class="form-label">Lý do / Nội dung <span class="text-danger">*</span></label>
                    <textarea class="form-control" id="reason" name="reason" rows="3" required="required" placeholder="Nhập lý do hủy hoặc nội dung cần sửa..."><t t-esc="values.get('reason')"/></textarea>
                </div>

                <t t-if="error and error.get('main')">
                    <div class="alert alert-danger" role="alert">
                        <t t-esc="error['main']"/>
                    </div>
                </t>

                <div class="d-grid gap-2 mt-4">
                    <button type="submit" class="btn btn-primary btn-lg">Gửi Yêu Cầu</button>
                </div>
            </form>

            <script type="text/javascript">
                document.getElementById('salesperson_name').addEventListener('input', function(e) {
                    var val = e.target.value;
                    if (val.length &lt; 2) return;
                    
                    fetch('/cancel-request/autocomplete/saler?term=' + encodeURIComponent(val))
                        .then(response => response.json())
                        .then(data => {
                            var datalist = document.getElementById('salesperson_list');
                            datalist.innerHTML = '';
                            data.forEach(item => {
                                var option = document.createElement('option');
                                option.value = item;
                                datalist.appendChild(option);
                            });
                        });
                });
            </script>
        </t>
    </template>

    <template id="cancel_request_success" name="Success">
        <t t-call="hlv_order_cancel_request.cancel_request_layout">
            <div class="text-center py-4">
                <div class="text-success mb-3" style="font-size: 3rem;">
                    <i class="fa fa-check-circle"></i>
                </div>
                <h4 class="mb-3">Gửi yêu cầu thành công!</h4>
                <p class="text-muted mb-4">
                    Mã yêu cầu: <strong class="text-dark"><t t-esc="cancel_req.name if cancel_req else 'N/A'"/></strong><br/>
                    Thông báo đã được gửi đến Kế toán và Thủ kho.<br/>
                    <t t-if="cancel_req and cancel_req.salesperson_zalo_uid">
                        Bạn sẽ nhận thông báo qua Zalo khi yêu cầu được xử lý xong.
                    </t>
                </p>
                <a href="/cancel-request/form" class="btn btn-outline-primary">Tạo yêu cầu mới</a>
            </div>
        </t>
    </template>
</odoo>
