<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_report_access_right_tree" model="ir.ui.view">
        <field name="name">report.access.right.tree</field>
        <field name="model">report.access.right</field>
        <field name="arch" type="xml">
            <list>
                <field name="report_id"/>
                <field name="hide_based_on"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_report_access_right_form" model="ir.ui.view">
        <field name="name">report.access.right.form</field>
        <field name="model">report.access.right</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Activate"
                            class="btn-primary" invisible="status == 'active'"/>
                    <button name="action_inactivate" type="object" string="Deactivate"
                            class="btn-secondary" invisible="status == 'inactive'"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            class="btn-secondary" invisible="status == 'draft'"/>

                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,active,inactive"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="report_id" readonly="status != 'draft'"/>
                            <field name="hide_based_on"/>
                            <field name="hide_user_ids" invisible="hide_based_on != 'user'" widget="many2many_tags" readonly="status != 'draft'"
                                    options="{'no_create_edit': True}"/>
                            <field name="hide_company_ids" invisible="hide_based_on != 'company'" widget="many2many_tags" readonly="status != 'draft'"
                                    options="{'no_create_edit': True}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_report_access_right" model="ir.actions.act_window">
        <field name="name">Report Hide</field>
        <field name="res_model">report.access.right</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hide_report_root"
              name="Report Hide"
              groups="group_report_access_user_company"
              web_icon="axenor_print_action_hide,static/description/menu-icon.png"
              sequence="50"/>
    
    <menuitem id="menu_report_access_right"
              name="Report Hide : Access Config"
              action="action_report_access_right"
              parent="menu_hide_report_root"
              groups="group_report_access_user_company"
              sequence="50"/>
</odoo>
