#. module: bitsys_stock_lock
#: model:ir.model.fields,field_description:bitsys_stock_lock.field_product_product__is_negative_allowed
#: model:ir.model.fields,field_description:bitsys_stock_lock.field_product_template__is_negative_allowed
msgid "Allow Negative?"
msgstr "¿Permitir stock negativo?"

#. module: bitsys_stock_lock
#: model:ir.model.fields,help:bitsys_stock_lock.field_product_product__is_negative_allowed
#: model:ir.model.fields,help:bitsys_stock_lock.field_product_template__is_negative_allowed
msgid ""
"Enable this option to allow negative stock levels for this product. If not "
"enabled, stock moves that would result in negative stock are blocked, unless"
" allowed by the product."
msgstr ""
"Habilite esta opción para permitir niveles negativos de stock para este producto. Si no está habilitada, "
"los movimientos de stock que resulten en stock negativo se bloquearán, a menos que se permita por el producto."

