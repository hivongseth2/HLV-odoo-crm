msgid "Transfer"
msgstr "Transferir"

#. module: bitsys_stock_lock
#. odoo-python
#: code:addons/bitsys_stock_lock/models/stock_picking.py:0
msgid ""
"Cannot complete delivery for '%s' due to insufficient stock. Negative stock is not allowed."
msgstr ""
"No puedes validar la entrega para el producto '%s' porque el nivel de stock se volvería negativo y el stock negativo no está permitido para este producto."
