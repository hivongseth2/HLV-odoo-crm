<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_barcode" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hlv_barcode</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="HLV Mobile Barcode" string="HLV Mobile Barcode" name="hlv_mobile_barcode">
                    <block title="HLV Mobile Barcode" name="hlv_mobile_barcode_setting_container">
                        <setting string="Allowed Picking Types" help="Select which operations can be processed via Mobile Barcode App">
                            <field name="hlv_barcode_picking_type_ids" widget="many2many_tags"/>
                        </setting>
                        <setting string="Print after Packing" help="Enable option to print label after Put in Pack">
                            <field name="hlv_barcode_print_after_pack"/>
                        </setting>
                        <setting string="Phân quyền kho hàng" help="Phân quyền chi tiết cho từng người dùng tại từng kho">
                            <div class="mt-2">
                                <button name="%(hlv_warehouse_permission.action_warehouse_permission)d"
                                        type="action"
                                        string="Cấu hình phân quyền kho"
                                        class="btn-link"
                                        icon="fa-arrow-right"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
