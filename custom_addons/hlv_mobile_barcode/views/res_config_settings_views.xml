<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_barcode" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hlv_barcode</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="HLV Mobile Barcode" string="HLV Mobile Barcode" name="hlv_mobile_barcode">
                    <block title="HLV Mobile Barcode" name="hlv_mobile_barcode_setting_container">
                        <setting string="Allowed Picking Types" help="Select which operations can be processed via Mobile Barcode App">
                            <field name="hlv_barcode_picking_type_ids" widget="many2many_tags"/>
                        </setting>
                        <setting string="Print after Packing" help="Enable option to print label after Put in Pack">
                            <field name="hlv_barcode_print_after_pack"/>
                        </setting>
                        <setting string="Cho phép quét Kiện hàng" help="Quét mã vạch kiện (PACKxxx) để xử lý nhanh toàn bộ sản phẩm bên trong.">
                            <field name="hlv_barcode_allow_package_scan"/>
                        </setting>
                        <setting string="Hiển thị nút điều chỉnh số lượng nhanh" help="Hiển thị các nút -10, -1, +1, +10 trên màn hình quét mã vạch để chỉnh nhanh số lượng.">
                            <field name="hlv_barcode_show_qty_buttons"/>
                        </setting>
                        <setting string="Sử dụng phân quyền quét độc lập" help="Bật để dùng cấu hình phân quyền quét của riêng Mobile Barcode. Tắt để dùng phân quyền chung của hlv_warehouse_permission.">
                            <field name="hlv_barcode_use_independent_permissions"/>
                        </setting>
                        <setting string="Cấu hình phân quyền quét" help="Phân quyền chi tiết cho từng người dùng tại từng kho" invisible="not hlv_barcode_use_independent_permissions">
                            <div class="mt-2">
                                <button name="%(hlv_mobile_barcode.action_barcode_permission)d"
                                        type="action"
                                        string="Cấu hình phân quyền quét độc lập"
                                        class="btn-link"
                                        icon="fa-arrow-right"/>
                            </div>
                        </setting>
                        <setting string="Cấu hình phân quyền kho (Chung)" help="Sử dụng cấu hình phân quyền chung của module hlv_warehouse_permission" invisible="hlv_barcode_use_independent_permissions">
                            <div class="mt-2">
                                <button name="action_open_warehouse_permissions"
                                        type="object"
                                        string="Cấu hình phân quyền kho (Chung)"
                                        class="btn-link"
                                        icon="fa-arrow-right"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
