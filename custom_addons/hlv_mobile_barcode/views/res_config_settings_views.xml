<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_barcode" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hlv_barcode</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="HLV Mobile Barcode" string="HLV Mobile Barcode" name="hlv_mobile_barcode">
                    <block title="Thiết Lập Máy Quét Mã Vạch (Mobile Barcode)" name="hlv_mobile_barcode_setting_container">
                        <setting string="Các Loại Phiếu Được Quét" help="Chỉ những loại phiếu chọn ở đây (vd: Phiếu lấy hàng) mới được phép dùng máy quét. Bỏ trống = Cho phép tất cả.">
                            <field name="hlv_barcode_picking_type_ids" widget="many2many_tags"/>
                        </setting>
                        <setting string="Tự Động In Nhãn Sau Đóng Gói" help="Bật để máy tự động in nhãn dán ngay khi nhân viên vừa bấm nút 'Đóng Gói' xong.">
                            <field name="hlv_barcode_print_after_pack"/>
                        </setting>
                        <setting string="Người xử lý mặc định đơn Shopee" help="User này sẽ được assign tự động cho phiếu PICK của sale order có shopee_order_ref hoặc shopee_shop_id.">
                            <field name="hlv_barcode_shopee_default_picker_user_id" widget="many2one_avatar_user"/>
                        </setting>
                        <setting string="Cho Phép Quét Kiện Hàng" help="Bật để nhân viên quét 1 mã thùng/kiện và hệ thống tự hiểu tất cả đồ bên trong.">
                            <field name="hlv_barcode_allow_package_scan"/>
                        </setting>
                        <setting string="Hiện Nút Bấm Chỉnh Số Lượng" help="Bật để hiện các nút bấm +1, -1, +10 trên màn hình điện thoại/máy quét để bấm nhanh.">
                            <field name="hlv_barcode_show_qty_buttons"/>
                        </setting>
                        <setting string="Camera Mặc Định Bật" help="Bật: Camera tự mở sẵn khi vào phiếu. Tắt: Camera đóng sẵn, nhân viên bấm nút để bật khi cần.">
                            <field name="hlv_barcode_camera_default_on"/>
                        </setting>
                        <setting string="Chuyển Cùng Kho 1 Bước" help="Bật để chuyển giữa các vị trí trong cùng kho đi thẳng 1 bước. Tắt để cùng kho khác vị trí cũng tạo quy trình 2 bước qua Transit.">
                            <field name="hlv_barcode_same_warehouse_one_step"/>
                        </setting>
                        <setting string="Dùng Quyền Riêng Cho Máy Quét" help="Bật để dùng bảng phân quyền máy quét độc lập. Tắt để dùng chung với quyền kho trên máy tính.">
                            <field name="hlv_barcode_use_independent_permissions"/>
                        </setting>
                        <setting string="Cấu Hình Quyền Máy Quét" help="Bấm vào đây để cài đặt ai được phép quét/xác nhận phiếu ở kho nào (Quyền Độc Lập)." invisible="not hlv_barcode_use_independent_permissions">
                            <div class="mt-2">
                                <button name="%(hlv_mobile_barcode.action_barcode_permission)d"
                                        type="action"
                                        string="Cài đặt Quyền Máy Quét"
                                        class="btn-link"
                                        icon="fa-arrow-right"/>
                            </div>
                        </setting>
                        <setting string="Cấu Hình Quyền Kho Chung" help="Bấm vào đây để chỉnh quyền chung trên máy tính (do bạn đang tắt Quyền Riêng Máy Quét)." invisible="hlv_barcode_use_independent_permissions">
                            <div class="mt-2">
                                <button name="action_open_warehouse_permissions"
                                        type="object"
                                        string="Cài đặt Quyền Kho (Chung)"
                                        class="btn-link"
                                        icon="fa-arrow-right"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
