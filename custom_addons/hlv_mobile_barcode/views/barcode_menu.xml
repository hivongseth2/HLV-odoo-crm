<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- OWL Client Action for Barcode App -->
    <record id="action_hlv_mobile_barcode" model="ir.actions.client">
        <field name="name">Barcode Scanner</field>
        <field name="tag">hlv_mobile_barcode.BarcodeApp</field>
        <field name="target">fullscreen</field>
    </record>

    <!-- Menu Item on the Main App Switcher (Root) -->
    <menuitem id="menu_hlv_mobile_barcode_root"
              name="Mobile Barcode"
              action="action_hlv_mobile_barcode"
              web_icon="stock,static/description/icon.png"
              sequence="10"/>
</odoo>
