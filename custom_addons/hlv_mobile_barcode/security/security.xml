<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Group: allow access to Odoo's default Barcode app (/odoo/barcode) -->
    <record id="group_stock_barcode_default_user" model="res.groups">
        <field name="name">Truy cập Barcode mặc định Odoo</field>
        <field name="comment">Cho phép người dùng mở app Barcode mặc định của Odoo tại /odoo/barcode.</field>
        <field name="category_id" ref="base.module_category_inventory"/>
    </record>

    <!-- Nhóm: Quản lý phân quyền Barcode di động -->
    <record id="group_barcode_permission_manager" model="res.groups">
        <field name="name">Quản lý phân quyền Barcode di động</field>
        <field name="comment">Cho phép quản lý bảng phân quyền quét mã vạch trên điện thoại</field>
        <field name="category_id" ref="base.module_category_inventory"/>
    </record>

    <!-- Stock Manager tự động có quyền quản lý phân quyền Barcode -->
    <record id="stock.group_stock_manager" model="res.groups">
        <field name="implied_ids" eval="[
            (4, ref('group_barcode_permission_manager')),
            (3, ref('group_stock_barcode_default_user'))
        ]"/>
    </record>
</odoo>
