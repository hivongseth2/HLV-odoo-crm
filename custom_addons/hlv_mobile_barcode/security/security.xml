<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Nhóm: Quản lý phân quyền Barcode di động -->
    <record id="group_barcode_permission_manager" model="res.groups">
        <field name="name">Quản lý phân quyền Barcode di động</field>
        <field name="comment">Cho phép quản lý bảng phân quyền quét mã vạch trên điện thoại</field>
        <field name="category_id" ref="base.module_category_inventory"/>
    </record>

    <!-- Stock Manager tự động có quyền quản lý phân quyền Barcode -->
    <record id="stock.group_stock_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_barcode_permission_manager'))]"/>
    </record>
</odoo>
