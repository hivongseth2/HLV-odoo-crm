<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hlv_mobile_barcode.LocationMove">
        <div class="d-flex flex-column h-100" style="background: #f5f7fa; animation: fadeInSlideUp 0.3s ease-out;">
            <div class="p-3 bg-white shadow-sm border-bottom" style="z-index: 10;">
                <h5 class="mb-0 text-truncate" style="font-weight: 600; color: #714B67;">
                    <i class="fa fa-exchange me-2"/> Chuyển vị trí
                </h5>
            </div>
            
            <div class="flex-grow-1 p-3 overflow-auto">
                <div class="card border-0 shadow-sm mb-3" style="border-radius: 12px;">
                    <div class="card-body p-3">
                        <div class="mb-3 border-bottom pb-2">
                            <label class="text-muted small fw-bold text-uppercase mb-1">Sản phẩm</label>
                            <div class="fw-bold text-dark" style="font-size: 16px;">
                                <t t-esc="state.productName"/>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label class="text-muted small fw-bold text-uppercase mb-1">Từ vị trí (Mã vạch)</label>
                            <div class="input-group input-group-lg">
                                <input type="text" class="form-control bg-light" t-model="state.sourceLocationBarcode" placeholder="Quét hoặc nhập mã..."/>
                                <button class="btn btn-outline-secondary bg-white" type="button" t-on-click="scanSource" t-if="props.openCameraForInput">
                                    <i class="fa fa-camera text-primary"/>
                                </button>
                            </div>
                        </div>
                        
                        <div class="form-group mb-3">
                            <label class="text-muted small fw-bold text-uppercase mb-1">Đến vị trí (Mã vạch)</label>
                            <div class="input-group input-group-lg">
                                <input type="text" class="form-control bg-light" t-model="state.destLocationBarcode" placeholder="Quét hoặc nhập mã..."/>
                                <button class="btn btn-outline-secondary bg-white" type="button" t-on-click="scanDest" t-if="props.openCameraForInput">
                                    <i class="fa fa-camera text-primary"/>
                                </button>
                            </div>
                        </div>
                        
                        <div class="form-group mb-2">
                            <label class="text-muted small fw-bold text-uppercase mb-1">Số lượng</label>
                            <input type="number" class="form-control form-control-lg bg-light fw-bold" t-model="state.qty" min="0.01" step="0.01"/>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="bg-white p-3 border-top shadow-sm mt-auto" style="z-index: 10;">
                <div style="display: flex; gap: 10px;">
                    <button class="btn btn-light btn-lg" style="flex: 1; border-radius: 12px; font-weight: 600; color: #475569; background: #f1f5f9; border: none;" t-on-click="props.onBack" t-att-disabled="state.loading">
                        <i class="fa fa-times me-1"/> Hủy
                    </button>
                    <button class="btn o_btn_purple btn-lg text-white" style="flex: 1; border-radius: 12px; font-weight: 600; background-color: #714B67;" t-on-click="doMove" t-att-disabled="state.loading">
                        <t t-if="!state.loading"><i class="fa fa-check me-1"/> Xác nhận chuyển</t>
                        <t t-else=""><i class="fa fa-spin fa-spinner me-1"/> Đang xử lý...</t>
                    </button>
                </div>
            </div>
        </div>
    </t>
</templates>
