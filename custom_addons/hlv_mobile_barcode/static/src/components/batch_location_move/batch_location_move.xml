<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hlv_mobile_barcode.BatchLocationMove">
        <div class="subview-root">
            <div class="subview-scroll-area">
                <div class="card-box" style="margin-top: 10px;">
                    <div style="margin-bottom: 15px;">
                        <label style="font-size: 0.9rem; font-weight: 600; color: var(--text-muted); margin-bottom: 8px; display: block;">
                            Đang chuyển hàng từ vị trí
                        </label>
                        <div style="padding: 10px; background-color: #e8f5e9; border: 1px solid #c3e6cb; border-radius: 8px; display: flex; align-items: center;">
                            <i class="fa fa-map-marker-alt" style="color: var(--success-color); margin-right: 10px; font-size: 1.3rem;"></i>
                            <div style="font-weight: bold; color: var(--success-color); font-size: 1.1rem;"><t t-esc="props.sourceLocationName || props.sourceLocationBarcode"/></div>
                        </div>
                    </div>
                    
                    <t t-if="state.lines.length === 0">
                        <div style="text-align: center; padding: 20px; color: var(--text-muted);">
                            <i class="fa fa-barcode fa-3x" style="opacity: 0.2; margin-bottom: 10px;"></i>
                            <div>Chưa có sản phẩm nào được quét.</div>
                            <div style="font-size: 0.8rem; margin-top: 5px;">Hãy dùng camera phía trên để quét mã sản phẩm.</div>
                        </div>
                    </t>
                    
                    <t t-if="state.lines.length > 0">
                        <div style="font-size: 0.85rem; font-weight: 700; color: var(--text-muted); margin-bottom: 8px; border-bottom: 1px solid var(--border-color); padding-bottom: 4px;">
                            Danh sách sản phẩm sẽ chuyển (<t t-esc="state.lines.length"/>)
                        </div>
                        <div class="items-list" style="margin-top: 0;">
                            <div t-foreach="state.lines" t-as="line" t-key="line_index" class="item-card" style="border: 1px solid var(--border-color); padding: 8px; display: flex; align-items: center; justify-content: space-between;">
                                <div class="item-info" style="flex: 1; padding-right: 8px; min-width: 0;">
                                    <div class="item-name" style="font-size: 0.9rem; line-height: 1.3; overflow: hidden; text-overflow: ellipsis;"><t t-esc="line.product_name"/></div>
                                    <div class="item-barcode" style="margin-top: 3px; font-size: 0.75rem;"><i class="fa fa-barcode me-1"/> <t t-esc="line.barcode"/></div>
                                </div>
                                <div style="display: flex; align-items: center; gap: 6px; flex-shrink: 0;">
                                    <button class="btn btn-outline btn-sm" style="padding: 3px 6px;" t-on-click="() => this.decreaseQty(line)">
                                        <i class="fa fa-minus"></i>
                                    </button>
                                    <input type="number" class="form-control" style="width: 50px; text-align: center; font-weight: bold; padding: 3px;" t-model="line.qty" min="0"/>
                                    <button class="btn btn-outline btn-sm" style="padding: 3px 6px;" t-on-click="() => this.increaseQty(line)">
                                        <i class="fa fa-plus"></i>
                                    </button>
                                    <button class="btn btn-danger btn-sm" style="padding: 3px 6px;" t-on-click="() => this.removeLine(line_index)">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
                
                <div t-if="state.inPickingName" class="alert alert-success show" style="margin-top: 10px;">
                    <i class="fa fa-check-circle" style="font-size: 1.5rem;"></i>
                    <div>
                        <div style="font-weight: bold; margin-bottom: 4px;">Đã lấy hàng thành công!</div>
                        <div style="font-size: 0.9rem;">Mã phiếu nhập: <strong><t t-esc="state.inPickingName"/></strong></div>
                        <div style="font-size: 0.85rem; margin-top: 5px; opacity: 0.9;">Vui lòng quét mã trên bằng công cụ Quét Phiếu khi đến vị trí đích.</div>
                    </div>
                </div>
            </div>
            
            <!-- Fixed Footer -->
            <div class="subview-footer">
                <button class="btn btn-outline btn-lg" style="flex: 1;" t-on-click="props.onBack" t-att-disabled="state.loading">
                    <i class="fa fa-times"/> Hủy
                </button>
                <button class="btn btn-primary btn-lg" style="flex: 1; background-color: var(--info-color);" t-on-click="() => this.doMove(true)" t-att-disabled="state.loading or state.lines.length === 0">
                    <t t-if="!state.loading"><i class="fa fa-box"/> Đóng kiện</t>
                    <t t-else=""><i class="fa fa-spin fa-spinner"/></t>
                </button>
                <button class="btn btn-primary btn-lg" style="flex: 1;" t-on-click="() => this.doMove(false)" t-att-disabled="state.loading or state.lines.length === 0">
                    <t t-if="!state.loading"><i class="fa fa-check"/> Xác nhận</t>
                    <t t-else=""><i class="fa fa-spin fa-spinner"/></t>
                </button>
            </div>
        </div>
    </t>
</templates>
