<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hlv_mobile_barcode.BatchLocationMove">
        <div>
            <div class="shipper-container">
                <!-- Header -->
                <div class="shipper-header">
                    <div class="header-title">
                        <i class="fa fa-boxes"></i> Tạo lệnh chuyển hàng
                    </div>
                </div>
                
                <div class="card-box" style="margin-top: 15px;">
                    <div style="margin-bottom: 20px;">
                        <label style="font-size: 0.9rem; font-weight: 600; color: var(--text-muted); margin-bottom: 8px; display: block;">
                            Đang chuyển hàng từ vị trí
                        </label>
                        <div style="padding: 12px; background-color: #e8f5e9; border: 1px solid #c3e6cb; border-radius: 8px; display: flex; align-items: center;">
                            <i class="fa fa-map-marker-alt" style="color: var(--success-color); margin-right: 10px; font-size: 1.5rem;"></i>
                            <div>
                                <div style="font-weight: bold; color: var(--success-color); font-size: 1.2rem;"><t t-esc="props.sourceLocationName || props.sourceLocationBarcode"/></div>
                            </div>
                        </div>
                    </div>

                    <div style="margin-bottom: 20px;">
                        <label style="font-size: 0.9rem; font-weight: 600; color: var(--text-muted); margin-bottom: 8px; display: block;">Quét mã vạch sản phẩm để thêm</label>
                        
                        <!-- Inline Camera -->
                        <div t-if="state.showLocalCamera" class="camera-section active">
                            <div id="batch-location-move-camera-reader" class="camera-reader"></div>
                            <div class="camera-controls" style="padding: 10px; background: var(--light-bg); border-top: 1px solid var(--border-color); text-align: center;">
                                <button type="button" class="btn btn-secondary btn-sm" t-on-click="closeLocalCamera">
                                    <i class="fa fa-times me-1"/> Đóng Camera
                                </button>
                            </div>
                        </div>

                        <div class="input-group-row">
                            <button class="btn btn-primary" type="button" t-on-click="openLocalCamera" style="width: 100%;">
                                <i class="fa fa-camera"/> Bật máy quét Camera
                            </button>
                        </div>
                        
                        <!-- Manual Input for Hardware Scanners -->
                        <div class="input-group-row" style="margin-top: 10px;">
                            <input type="text" class="form-control" t-model="state.barcodeInput" placeholder="Hoặc dùng máy quét có dây..." t-on-keyup="onBarcodeInputKeyup" style="font-size: 1rem;"/>
                            <button class="btn btn-secondary" type="button" t-on-click="() => this.onBarcodeInputEnter()">
                                <i class="fa fa-arrow-right"></i>
                            </button>
                        </div>
                    </div>
                    
                    <t t-if="state.lines.length === 0">
                        <div style="text-align: center; padding: 30px; color: var(--text-muted);">
                            <i class="fa fa-barcode fa-3x" style="opacity: 0.2; margin-bottom: 10px;"></i>
                            <div>Chưa có sản phẩm nào được quét.</div>
                            <div style="font-size: 0.8rem; margin-top: 5px;">Hãy dùng máy quét hoặc bật camera để quét mã sản phẩm.</div>
                        </div>
                    </t>
                    
                    <t t-if="state.lines.length > 0">
                        <div style="font-size: 0.9rem; font-weight: 700; color: var(--text-muted); margin-bottom: 10px; border-bottom: 1px solid var(--border-color); padding-bottom: 5px;">
                            Danh sách sản phẩm sẽ chuyển (<t t-esc="state.lines.length"/>)
                        </div>
                        <div class="items-list" style="margin-top: 0;">
                            <div t-foreach="state.lines" t-as="line" t-key="line_index" class="item-card" style="border: 1px solid var(--border-color); padding: 10px; display: flex; align-items: center; justify-content: space-between;">
                                <div class="item-info" style="flex: 1; padding-right: 10px;">
                                    <div class="item-name" style="font-size: 0.95rem; line-height: 1.3;"><t t-esc="line.product_name"/></div>
                                    <div class="item-barcode" style="margin-top: 4px; font-size: 0.8rem;"><i class="fa fa-barcode me-1"/> <t t-esc="line.barcode"/></div>
                                </div>
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <button class="btn btn-outline btn-sm" style="padding: 4px 8px;" t-on-click="() => this.decreaseQty(line)">
                                        <i class="fa fa-minus"></i>
                                    </button>
                                    <input type="number" class="form-control" style="width: 60px; text-align: center; font-weight: bold; padding: 4px;" t-model="line.qty" min="0"/>
                                    <button class="btn btn-outline btn-sm" style="padding: 4px 8px;" t-on-click="() => this.increaseQty(line)">
                                        <i class="fa fa-plus"></i>
                                    </button>
                                    <button class="btn btn-danger btn-sm" style="padding: 4px 8px; margin-left: 5px;" t-on-click="() => this.removeLine(line_index)">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
                
                <div t-if="state.inPickingName" class="alert alert-success show" style="margin-top: 15px;">
                    <i class="fa fa-check-circle" style="font-size: 1.5rem;"></i>
                    <div>
                        <div style="font-weight: bold; margin-bottom: 4px;">Đã lấy hàng thành công!</div>
                        <div style="font-size: 0.9rem;">Mã phiếu nhập: <strong><t t-esc="state.inPickingName"/></strong></div>
                        <div style="font-size: 0.85rem; margin-top: 5px; opacity: 0.9;">Vui lòng quét mã trên bằng công cụ Quét Phiếu khi đến vị trí đích.</div>
                    </div>
                </div>
                
                <div style="display: flex; gap: 15px; margin-top: auto; padding-top: 20px;">
                    <button class="btn btn-outline btn-lg" style="flex: 1;" t-on-click="props.onBack" t-att-disabled="state.loading">
                        <i class="fa fa-times"/> Hủy
                    </button>
                    <button class="btn btn-primary btn-lg" style="flex: 1; background-color: var(--info-color);" t-on-click="() => this.doMove(true)" t-att-disabled="state.loading or state.lines.length === 0">
                        <t t-if="!state.loading"><i class="fa fa-box"/> Đóng thành kiện</t>
                        <t t-else=""><i class="fa fa-spin fa-spinner"/></t>
                    </button>
                    <button class="btn btn-primary btn-lg" style="flex: 1;" t-on-click="() => this.doMove(false)" t-att-disabled="state.loading or state.lines.length === 0">
                        <t t-if="!state.loading"><i class="fa fa-check"/> Xác nhận</t>
                        <t t-else=""><i class="fa fa-spin fa-spinner"/></t>
                    </button>
                </div>
            </div>
        </div>
    </t>
</templates>
