<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hlv_mobile_barcode.BarcodeApp">
        <div class="hlv-barcode-app" t-ref="app-container">
            <!-- Regular App Views -->
            <div class="shipper-container" t-if="!state.showCamera">
                <!-- Header -->
                <div class="shipper-header" t-if="state.currentView !== 'main'">
                    <div class="header-title">
                        <i class="fa fa-boxes"></i> Kho HLV
                    </div>
                    <div style="display: flex; gap: 10px;">
                        <div class="user-info" style="background: var(--primary-color); color: white;" t-on-click="openCamera">
                            <i class="fa fa-camera"></i> Quét mã
                        </div>
                        <div class="user-info" t-on-click="goToMain">
                            <i class="fa fa-home"></i> Trang chủ
                        </div>
                    </div>
                </div>

                <div class="hlv-barcode-content">
                    <!-- Main Screen -->
                    <div t-if="state.currentView === 'main'">
                        <div class="shipper-header">
                            <div class="header-title">
                                <i class="fa fa-barcode"></i> Máy quét mã vạch
                            </div>
                            <div class="user-info" t-on-click="openSettings">
                                <i class="fa fa-cog"></i> Cài đặt
                            </div>
                        </div>

                        <div class="card-box" style="text-align: center; padding-top: 40px; padding-bottom: 40px;" t-on-click="openCamera">
                            <i class="fa fa-barcode" style="font-size: 80px; color: var(--primary-color); margin-bottom: 20px;"></i>
                            <h3 style="color: var(--primary-color); margin-bottom: 10px;">Quét hoặc chạm</h3>
                            <p class="text-muted" style="margin-bottom: 30px;">Dùng máy quét hoặc nhấn để mở Camera</p>
                            
                            <div style="text-align: left; background: var(--light-bg); padding: 15px; border-radius: 8px;">
                                <div style="margin-bottom: 8px;"><i class="fa fa-check-circle" style="color: var(--success-color); margin-right: 8px;"></i> Quét <strong>sản phẩm</strong> để định vị</div>
                                <div style="margin-bottom: 8px;"><i class="fa fa-check-circle" style="color: var(--success-color); margin-right: 8px;"></i> Quét <strong>kiện hàng</strong> để mở</div>
                                <div style="margin-bottom: 8px;"><i class="fa fa-check-circle" style="color: var(--success-color); margin-right: 8px;"></i> Quét <strong>phiếu kho</strong> để xử lý</div>
                                <div><i class="fa fa-check-circle" style="color: var(--success-color); margin-right: 8px;"></i> Quét <strong>vị trí</strong> để chuyển hàng</div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Picking View Placeholder -->
                    <div t-elif="state.currentView === 'picking'">
                        <PickingScanner pickingId="state.pickingId" onBack="() => this.goBack()" lastScannedProduct="state.lastScannedProduct" scannedLocationName="state.scannedLocationName"/>
                    </div>
                    
                    <!-- Move Component -->
                    <LocationMove t-if="state.currentView === 'move'" productId="state.recordId" prefillLocationBarcode="state.prefillLocationBarcode" prefillLocationName="state.prefillLocationName" onBack="() => this.goBack()" registerScanner="(cb) => this.registerScanner(cb)"/>
                    
                    <!-- Batch Move Component -->
                    <BatchLocationMove t-if="state.currentView === 'batch_move'" sourceLocationBarcode="state.prefillLocationBarcode" sourceLocationName="state.prefillLocationName" onBack="() => this.goBack()" registerScanner="(cb) => this.registerScanner(cb)"/>
                    
                    <!-- Lookup Component -->
                    <InventoryLookup t-if="state.currentView === 'lookup'" t-key="state.lookupType + '_' + state.recordId" lookupType="state.lookupType" recordId="state.recordId" onBack="() => this.goBack()" onMove="(productId, locBarcode, locName) => this.goToMove(productId, locBarcode, locName)" onBatchMove="(locBarcode, locName) => this.goToBatchMove(locBarcode, locName)" onProductSelect="(productId, productName) => this.goToProductLookup(productId, productName)"/>
                </div>
            </div>

            <!-- Inline Camera View (replaces modal) -->
            <div class="shipper-container" t-if="state.showCamera" style="background: #f4f6f8; min-height: 100vh; display: flex; flex-direction: column;">
                <!-- Header -->
                <div class="shipper-header" style="background: #222; color: white;">
                    <div class="header-title"><i class="fa fa-camera"></i> Máy quét mã vạch</div>
                    <div class="user-info" t-on-click="closeCamera" style="background: var(--danger-color); color: white;">
                        <i class="fa fa-times"></i> Đóng
                    </div>
                </div>
                
                <!-- Body -->
                <div style="flex: 1; padding: 15px; display: flex; flex-direction: column; justify-content: center; background: #000;">
                    <!-- Fallback UI when permission is denied -->
                    <t t-if="state.cameraFallback">
                        <div style="background: white; padding: 30px 15px; border-radius: 8px; text-align: center;">
                            <i class="fa fa-camera-slash" style="font-size: 48px; color: var(--danger-color); margin-bottom: 15px;"/>
                            <h5 style="font-weight: 600; margin-bottom: 8px; color: var(--primary-color);">Không thể truy cập camera</h5>
                            <p style="color: var(--text-muted); font-size: 14px; margin-bottom: 25px;">Trình duyệt chưa cấp quyền cho trang web này. Vui lòng cấp quyền hoặc tải ảnh lên.</p>
                            
                            <input type="file" accept="image/*" capture="environment" id="cameraFileInput" style="display: none;" t-on-change="onFileSelected"/>
                            <label for="cameraFileInput" class="btn btn-primary">
                                <i class="fa fa-image"/> Chọn Ảnh / Chụp Ảnh
                            </label>
                        </div>
                    </t>
                    
                    <!-- Live Camera Feed -->
                    <div id="reader" style="width: 100%; border-radius: 8px; overflow: hidden; background: #000;" t-att-class="state.cameraFallback ? 'd-none' : ''"></div>
                </div>

                <!-- Footer: Manual Barcode Input -->
                <div style="padding: 15px; background: white; border-top: 1px solid #ddd;">
                    <div class="input-group-row" style="margin-bottom: 0;">
                        <input type="text" class="form-control" t-model="state.manualBarcode" placeholder="Nhập mã thủ công..." t-on-keyup="onManualBarcodeKeyup"/>
                        <button class="btn btn-secondary" t-on-click="processManualBarcode">
                            <i class="fa fa-arrow-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
