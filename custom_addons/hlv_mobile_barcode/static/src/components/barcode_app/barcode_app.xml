<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hlv_mobile_barcode.BarcodeApp">
        <div class="hlv-barcode-app" t-ref="app-container">
            <div class="hlv-barcode-header" t-if="state.currentView !== 'main'">
                <span t-if="state.currentView === 'picking'">Picking: <t t-esc="state.pickingName"/></span>
                <span t-elif="state.currentView === 'lookup'">Lookup: <t t-esc="state.lookupTitle"/></span>
                
                <button class="btn btn-sm btn-light" t-on-click="goToMain">
                    <i class="fa fa-home"/> Home
                </button>
            </div>
            
            <div class="hlv-barcode-content">
                <!-- Main Screen -->
                <div t-if="state.currentView === 'main'" class="o_barcode_main_menu">
                    <div class="o_barcode_card">
                        <div class="o_barcode_card_header">
                            <div>
                                <i class="fa fa-th" style="cursor: pointer; padding-right: 8px;" t-on-click="exitApp"/> 
                                Máy quét mã vạch
                            </div>
                            <button class="btn btn-light btn-sm o_barcode_settings_btn" t-on-click="openSettings">Cài đặt</button>
                        </div>
                        
                        <div class="o_barcode_card_body" t-on-click="openCamera">
                            <div class="o_barcode_icon_container">
                                <svg width="140" height="90" viewBox="0 0 140 90" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="o_barcode_icon">
                                    <rect x="0" y="0" width="8" height="90" rx="2"/>
                                    <rect x="14" y="0" width="4" height="90" rx="1"/>
                                    <rect x="24" y="0" width="12" height="90" rx="2"/>
                                    <rect x="42" y="0" width="6" height="90" rx="2"/>
                                    <rect x="54" y="0" width="14" height="90" rx="2"/>
                                    <rect x="74" y="0" width="4" height="90" rx="1"/>
                                    <rect x="84" y="0" width="8" height="90" rx="2"/>
                                    <rect x="98" y="0" width="16" height="90" rx="2"/>
                                    <rect x="120" y="0" width="4" height="90" rx="1"/>
                                    <rect x="130" y="0" width="10" height="90" rx="2"/>
                                </svg>
                                <div class="o_barcode_laser"></div>
                            </div>
                            <div class="o_barcode_subtitle">Quét hoặc chạm</div>
                        </div>
                        
                        <ul class="o_barcode_instructions">
                            <li>Quét một <strong>sản phẩm</strong> để định vị</li>
                            <li>Quét một <strong>kiện hàng</strong> để mở</li>
                            <li>Quét một <strong>phiếu xuất kho</strong> để mở</li>
                            <li>Quét một <strong>vị trí</strong> để tiến hành một lệnh chuyển hàng</li>
                            <li>Quét một <strong>loại hoạt động</strong> để bắt đầu</li>
                        </ul>
                        
                        <div class="o_barcode_card_footer">
                            <div class="input-group mb-3">
                                <input type="text" class="form-control" t-model="state.manualBarcode" placeholder="Nhập mã vạch thủ công..." t-on-keyup="onManualBarcodeKeyup"/>
                                <button class="btn o_btn_purple" t-on-click="processManualBarcode">
                                    <i class="fa fa-arrow-right"/>
                                </button>
                            </div>
                            <button class="btn o_btn_purple w-100" t-on-click="openCamera">Hoạt động (Camera)</button>
                        </div>
                    </div>
                </div>
                
                <!-- Picking View Placeholder -->
                <div t-elif="state.currentView === 'picking'">
                    <PickingScanner pickingId="state.pickingId" onBack="() => this.goToMain()" lastScannedProduct="state.lastScannedProduct"/>
                </div>
                
                <!-- Lookup View Placeholder -->
                <div t-elif="state.currentView === 'lookup'">
                    <InventoryLookup lookupType="state.lookupType" recordId="state.recordId" onBack="() => this.goToMain()" onMove="(productId) => this.goToMove(productId)"/>
                </div>
                
                <!-- Move View Placeholder -->
                <div t-elif="state.currentView === 'move'">
                    <LocationMove productId="state.recordId" onBack="() => this.goToMain()"/>
                </div>

                <!-- Camera Overlay -->
                <div t-if="state.showCamera" class="camera-modal" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: black; z-index: 9999; display: flex; flex-direction: column;">
                    <div style="padding: 15px; text-align: right; background: #333;">
                        <button class="btn btn-danger btn-lg" t-on-click="closeCamera"><i class="fa fa-times"/> Đóng Camera</button>
                    </div>
                    
                    <!-- Fallback if camera permission denied -->
                    <div t-if="state.cameraFallback" style="padding: 20px; text-align: center; color: white;">
                        <h4 class="mb-3">Không có quyền truy cập máy ảnh</h4>
                        <p>Trình duyệt đã bị từ chối quyền truy cập máy ảnh. Thay vì phải vào cài đặt cấp quyền lại, bạn có thể bấm nút bên dưới để sử dụng App Máy Ảnh mặc định của điện thoại để chụp mã vạch.</p>
                        <div class="mt-4">
                            <input type="file" accept="image/*" capture="environment" id="cameraFileInput" style="display: none;" t-on-change="onFileSelected"/>
                            <label for="cameraFileInput" class="btn btn-primary btn-lg" style="padding: 15px 30px; font-size: 18px; border-radius: 50px;">
                                <i class="fa fa-camera"/> Bật máy ảnh &amp; Chụp
                            </label>
                        </div>
                    </div>

                    <!-- Live Reader -->
                    <div id="reader" style="width: 100%; flex: 1; background: black;" t-att-class="state.cameraFallback ? 'd-none' : ''"></div>
                </div>
            </div>
        </div>
    </t>
</templates>
