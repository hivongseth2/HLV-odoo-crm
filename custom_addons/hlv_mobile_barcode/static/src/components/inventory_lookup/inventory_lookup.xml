<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hlv_mobile_barcode.InventoryLookup">
        <div class="lookup-container h-100 d-flex flex-column" style="background: #fff; height: 100vh; overflow: hidden;">
            <div class="lookup-header p-2 bg-white border-bottom" style="z-index: 10; flex-shrink: 0; display: flex; align-items: center; justify-content: space-between;">
                <h4 class="mb-0 text-truncate" style="color: #011627; font-weight: 500; font-size: 18px;">
                    Tra cứu: <t t-esc="state.title"/>
                </h4>
                <div>
                    <button t-if="props.lookupType === 'product'" class="btn btn-primary btn-sm me-2" t-on-click="() => props.onMove(props.recordId)">
                        Chuyển vị trí
                    </button>
                    <button class="btn btn-secondary btn-sm" t-on-click="props.onBack">
                        Quay lại
                    </button>
                </div>
            </div>
            
            <div class="lookup-body flex-grow-1 overflow-auto" style="padding: 0;">
                <div t-if="state.loading" class="text-center mt-5">
                    <i class="fa fa-spin fa-spinner fa-2x text-muted"/>
                </div>
                
                <div t-else="" class="table-responsive">
                    <t t-if="state.results.length === 0 and (!state.reservations or state.reservations.length === 0)">
                        <div class="p-4 text-center text-muted">Không tìm thấy dữ liệu tồn kho.</div>
                    </t>

                    <t t-if="state.results.length > 0">
                        <div class="bg-light p-2 border-bottom fw-bold text-uppercase" style="font-size: 12px; color: #495057;">
                            Tồn kho tại vị trí
                        </div>
                        <table class="table table-sm table-striped table-hover o_list_table mb-0">
                            <thead>
                                <tr>
                                    <th t-if="props.lookupType === 'product'">Vị trí</th>
                                    <th t-elif="props.lookupType === 'location' or props.lookupType === 'package'">Sản phẩm</th>
                                    <th>Kiện hàng</th>
                                    <th class="text-end">Số lượng</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="state.results" t-as="res" t-key="res_index" t-on-click="() => this.openLocation(res.location_id)" style="cursor: pointer;">
                                    <td t-if="props.lookupType === 'product'"><t t-esc="res.location_name"/></td>
                                    <td t-elif="props.lookupType === 'location' or props.lookupType === 'package'"><t t-esc="res.product_name"/></td>
                                    <td><t t-esc="res.package_name"/></td>
                                    <td class="text-end fw-bold"><t t-esc="res.quantity"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                    
                    <t t-if="props.lookupType === 'product' and state.reservations and state.reservations.length > 0">
                        <div class="bg-light p-2 border-bottom border-top fw-bold text-uppercase mt-2" style="font-size: 12px; color: #495057;">
                            Đang được giữ (Reserved)
                        </div>
                        <table class="table table-sm table-striped table-hover o_list_table mb-0">
                            <thead>
                                <tr>
                                    <th>Phiếu xuất / Đơn hàng</th>
                                    <th>Đối tác</th>
                                    <th>Trạng thái</th>
                                    <th class="text-end">Đang giữ</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="state.reservations" t-as="r" t-key="r_index" t-on-click="() => this.openPicking(r.picking_id)" style="cursor: pointer;">
                                    <td class="text-primary fw-bold"><t t-esc="r.picking"/></td>
                                    <td><t t-esc="r.partner or ''"/></td>
                                    <td>
                                        <span class="badge rounded-pill bg-info text-dark"><t t-esc="r.state_desc"/></span>
                                    </td>
                                    <td class="text-end">
                                        <strong><t t-esc="r.reserved"/></strong> / <t t-esc="r.demand"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                </div>
            </div>
        </div>
    </t>
</templates>
