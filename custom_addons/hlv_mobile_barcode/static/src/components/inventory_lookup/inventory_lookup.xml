<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hlv_mobile_barcode.InventoryLookup">
        <div style="display: flex; flex-direction: column; height: 100%;">
            <div class="shipper-container" style="flex: 1; padding-bottom: 15px;">
                <!-- Header -->
                <div class="shipper-header" style="flex-shrink: 0;">
                    <div class="header-title" style="font-size: 1rem;">
                        <i class="fa fa-search"></i> <t t-esc="state.title"/>
                    </div>
                    <div style="display: flex; gap: 8px;">
                        <button t-if="props.lookupType === 'product'" class="btn btn-primary" style="padding: 6px 12px; font-size: 0.85rem;" t-on-click="() => props.onMove(props.recordId)">
                            <i class="fa fa-exchange-alt"></i> Chuyển
                        </button>
                        <button t-if="props.lookupType === 'location'" class="btn btn-primary" style="padding: 6px 12px; font-size: 0.85rem;" t-on-click="() => props.onBatchMove(state.location_barcode, state.location_name)">
                            <i class="fa fa-boxes"></i> Tạo phiếu xuất (INT)
                        </button>
                        <button class="btn btn-outline" style="padding: 6px 12px; font-size: 0.85rem;" t-on-click="props.onBack">
                            <i class="fa fa-arrow-left"></i> Quay lại
                        </button>
                    </div>
                </div>
                
                <div class="card-box" style="margin-top: 10px; padding: 15px; display: flex; flex-direction: column; flex: 1; overflow: hidden; margin-bottom: 0;">
                    <div t-if="state.loading" style="text-align: center; padding: 30px;">
                        <i class="fa fa-spin fa-spinner fa-2x" style="color: var(--secondary-color);"></i>
                    </div>
                    
                    <div t-else="" class="scrollable-body" style="padding-right: 5px;">
                        <t t-if="state.results.length === 0 and (!state.reservations or state.reservations.length === 0)">
                            <div style="text-align: center; padding: 30px; color: var(--text-muted);">
                                <i class="fa fa-box-open fa-3x" style="opacity: 0.2; margin-bottom: 10px;"></i>
                                <div>Không tìm thấy dữ liệu tồn kho.</div>
                            </div>
                        </t>

                        <t t-if="state.results.length > 0">
                            <div style="font-size: 0.8rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 10px; border-bottom: 1px solid var(--border-color); padding-bottom: 5px;">
                                Tồn kho hiện tại
                            </div>
                            <div class="items-list" style="margin-top: 0; margin-bottom: 20px;">
                                <div t-foreach="state.results" t-as="res" t-key="res_index" class="item-card" t-on-click="props.lookupType === 'location' ? () => props.onProductSelect(res.product_id, res.product_name) : () => this.openLocation(res.quant_id)" style="cursor: pointer; border: 1px solid var(--border-color);">
                                    <div class="item-info">
                                        <div class="item-name" style="font-size: 1rem;">
                                            <t t-if="props.lookupType === 'product'"><t t-esc="res.location_name"/></t>
                                            <t t-else=""><t t-esc="res.product_name"/></t>
                                        </div>
                                        <div t-if="res.package_name" class="item-barcode" style="margin-top: 4px;">
                                            <i class="fa fa-box me-1"/> <t t-esc="res.package_name"/>
                                        </div>
                                    </div>
                                    <div style="font-weight: 700; font-size: 1.2rem; color: var(--success-color);">
                                        <t t-esc="res.quantity"/>
                                    </div>
                                    <i class="fa fa-chevron-right" style="color: #ccc; margin-left: 10px; font-size: 0.8rem;"></i>
                                </div>
                            </div>
                        </t>
                        
                        <t t-if="props.lookupType === 'product' and state.reservations and state.reservations.length > 0">
                            <div style="font-size: 0.8rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 10px; border-bottom: 1px solid var(--border-color); padding-bottom: 5px;">
                                Đang được giữ (Reserved)
                            </div>
                            <div class="items-list" style="margin-top: 0;">
                                <div t-foreach="state.reservations" t-as="r" t-key="r_index" class="item-card" t-on-click="() => this.openPicking(r.picking_id)" style="cursor: pointer; border: 1px solid var(--border-color);">
                                    <div class="item-info">
                                        <div class="item-name" style="color: var(--info-color);"><t t-esc="r.picking"/></div>
                                        <div class="item-barcode" style="margin-top: 2px;"><t t-esc="r.partner or ''"/></div>
                                    </div>
                                    <div style="text-align: right;">
                                        <div style="font-size: 0.75rem; background: var(--light-bg); padding: 2px 6px; border-radius: 4px; display: inline-block; margin-bottom: 4px; font-weight: 600; color: var(--text-color);">
                                            <t t-esc="r.state_desc"/>
                                        </div>
                                        <div style="font-size: 0.9rem; color: var(--text-muted);">
                                            <strong style="color: var(--text-color);"><t t-esc="r.reserved"/></strong> / <t t-esc="r.demand"/>
                                        </div>
                                    </div>
                                    <i class="fa fa-chevron-right" style="color: #ccc; margin-left: 10px; font-size: 0.8rem;"></i>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
