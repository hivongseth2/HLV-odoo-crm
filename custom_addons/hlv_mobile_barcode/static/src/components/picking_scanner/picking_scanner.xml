<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hlv_mobile_barcode.PickingScanner">
        <div>
            <div class="shipper-container" style="padding-bottom: 80px;">
                <div t-if="state.loading" style="text-align: center; padding: 50px;">
                    <i class="fa fa-spin fa-spinner fa-3x" style="color: var(--secondary-color);"></i>
                </div>
                
                <div t-elif="state.picking">
                    <!-- Step Header representing the picking -->
                    <div class="card-box" style="padding: 15px; margin-bottom: 15px;">
                        <div class="step-header" style="margin-bottom: 0; padding-bottom: 0; border-bottom: none;">
                            <div class="step-icon">
                                <i class="fa fa-clipboard-list"></i>
                            </div>
                            <div class="step-info">
                                <div class="step-title">Phiếu xuất/nhập</div>
                                <div class="step-desc" style="font-weight: 600; color: var(--text-color);"><t t-esc="state.picking.name"/></div>
                            </div>
                        </div>
                    </div>
                
                    <div class="card-box" style="padding: 15px;">
                        <div style="font-size: 0.8rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 10px; border-bottom: 1px solid var(--border-color); padding-bottom: 5px;">
                            Danh sách sản phẩm
                        </div>
                        <div class="items-list" style="margin-top: 0;">
                            <t t-foreach="state.picking.lines" t-as="line" t-key="line.move_id">
                                <div class="item-card-wrapper" style="border: 1px solid var(--border-color); border-radius: 8px; margin-bottom: 10px; overflow: hidden;">
                                    <div t-attf-class="item-card #{line.qty_done >= line.product_uom_qty and line.product_uom_qty > 0 ? 'scanned' : ''}" style="border: none; margin-bottom: 0;">
                                        <div class="item-info">
                                            <div class="item-name"><t t-esc="line.product_name"/></div>
                                            <div class="item-barcode"><t t-esc="line.product_barcode"/></div>
                                        </div>
                                        <div style="display: flex; align-items: center;">
                                            <div style="text-align: right; margin-right: 10px;">
                                                <div style="font-size: 1.1rem; font-weight: 700;">
                                                    <span t-attf-style="color: #{line.qty_done >= line.product_uom_qty and line.product_uom_qty > 0 ? 'var(--success-color)' : 'var(--text-color)'}">
                                                        <t t-esc="line.qty_done"/>
                                                    </span> 
                                                    <span style="color: var(--text-muted); font-size: 0.9rem;">/ <t t-esc="line.product_uom_qty"/></span>
                                                </div>
                                            </div>
                                            <i t-if="line.qty_done >= line.product_uom_qty and line.product_uom_qty > 0" class="fa fa-check-circle item-status-icon" style="margin-right: 10px;"></i>
                                            <button class="btn btn-outline btn-sm" style="padding: 4px 8px; color: var(--text-muted);" t-on-click="() => this.toggleEditLine(line.move_id)">
                                                <i class="fa fa-pencil-alt"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div t-if="state.editingLineId === line.move_id" style="background-color: var(--light-bg); padding: 10px; border-top: 1px solid var(--border-color);">
                                        <div style="display: flex; flex-wrap: wrap; gap: 5px; justify-content: center; margin-bottom: 10px;">
                                            <button class="btn btn-outline btn-sm" style="flex: 1; min-width: 40px;" t-on-click="() => this.adjustQty(line, -10)">-10</button>
                                            <button class="btn btn-outline btn-sm" style="flex: 1; min-width: 40px;" t-on-click="() => this.adjustQty(line, -1)">-1</button>
                                            <button class="btn btn-outline btn-sm" style="flex: 1; min-width: 40px;" t-on-click="() => this.adjustQty(line, -0.1)">-0.1</button>
                                            <input type="number" class="form-control" style="width: 70px; text-align: center; font-weight: bold; padding: 4px;" t-model="line.qty_done" t-on-change="(ev) => this.saveQty(line, ev)" min="0" step="any"/>
                                            <button class="btn btn-outline btn-sm" style="flex: 1; min-width: 40px;" t-on-click="() => this.adjustQty(line, 0.1)">+0.1</button>
                                            <button class="btn btn-outline btn-sm" style="flex: 1; min-width: 40px;" t-on-click="() => this.adjustQty(line, 1)">+1</button>
                                            <button class="btn btn-outline btn-sm" style="flex: 1; min-width: 40px;" t-on-click="() => this.adjustQty(line, 10)">+10</button>
                                        </div>
                                        <div style="text-align: right;">
                                            <button class="btn btn-danger btn-sm" t-on-click="() => this.deleteLine(line)">
                                                <i class="fa fa-trash"></i> Xóa
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
                
                <!-- Fixed Footer -->
                <div style="position: fixed; bottom: 0; left: 0; width: 100%; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px); border-top: 1px solid var(--border-color); padding: 15px; box-sizing: border-box; display: flex; gap: 10px; z-index: 100; padding-bottom: env(safe-area-inset-bottom, 15px);">
                    <button class="btn btn-outline" style="flex: 1; padding: 12px;" t-on-click="props.onBack">
                        <i class="fa fa-arrow-left"></i> Quay lại
                    </button>
                    <button class="btn btn-primary" style="flex: 1; padding: 12px; background-color: var(--info-color);" t-on-click="doPack">
                        <i class="fa fa-box"></i> Đóng gói
                    </button>
                    <button class="btn btn-success" style="flex: 1; padding: 12px;" t-on-click="doValidate">
                        <i class="fa fa-check"></i> Xác nhận
                    </button>
                </div>
            </div>
        </div>
    </t>
</templates>
