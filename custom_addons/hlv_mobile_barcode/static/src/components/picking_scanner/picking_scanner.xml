<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hlv_mobile_barcode.PickingScanner">
        <div class="picking-scanner-container" style="padding-bottom: 80px;">
            <div t-if="state.loading" class="text-center mt-5">
                <i class="fa fa-spin fa-spinner fa-3x"/>
            </div>
            <div t-elif="state.picking">
                <t t-foreach="state.picking.lines" t-as="line" t-key="line.move_id">
                    <div t-attf-class="picking-line #{line.qty_done >= line.product_uom_qty ? 'done' : ''}">
                        <div class="picking-line-title">
                            <t t-esc="line.product_name"/><br/>
                            <small class="text-muted"><t t-esc="line.product_barcode"/></small>
                        </div>
                        <div class="picking-line-qty">
                            <span t-attf-class="#{line.qty_done >= line.product_uom_qty ? 'done' : ''}">
                                <t t-esc="line.qty_done"/>
                            </span> / <t t-esc="line.product_uom_qty"/>
                        </div>
                    </div>
                </t>
            </div>
            
            <div class="hlv-barcode-footer" style="position: fixed; bottom: 0; width: 100%; left: 0; box-sizing: border-box;">
                <button class="btn btn-secondary btn-mobile-large" t-on-click="props.onBack">Back</button>
                <button class="btn btn-info btn-mobile-large" t-on-click="doPack">Pack</button>
                <button class="btn btn-success btn-mobile-large" t-on-click="doValidate">Validate</button>
            </div>
        </div>
    </t>
</templates>
