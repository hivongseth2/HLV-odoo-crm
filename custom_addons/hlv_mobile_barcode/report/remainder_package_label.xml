<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_remainder_package_label" model="ir.actions.report">
        <field name="name">Remainder Package Label</field>
        <field name="model">stock.quant.package</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hlv_mobile_barcode.report_remainder_package_label</field>
        <field name="print_report_name">'Remainder Package - %s' % (object.name)</field>
        <field name="paperformat_id" ref="hlv_pack_sequence.paperformat_package_label_80x80"/>
    </record>

    <template id="report_remainder_package_label">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="package">
                <div class="page" style="padding: 4mm; font-family: Arial, sans-serif;">
                    <div style="font-size: 18px; font-weight: 700; text-align: center;">
                        <t t-esc="package.name"/>
                    </div>
                    <div style="margin: 3mm 0; text-align: center;">
                        <span t-field="package.name"
                              t-options='{"widget": "barcode", "type": "Code128", "displayValue": True, "quiet": 1}'/>
                    </div>
                    <div style="font-size: 11px; margin-bottom: 2mm;">
                        <b>Vị trí:</b>
                        <t t-esc="package.location_id.display_name or ''"/>
                    </div>
                    <table style="width: 100%; font-size: 10px; border-collapse: collapse;">
                        <t t-foreach="package.quant_ids.filtered(lambda q: q.quantity &gt; 0)" t-as="quant">
                            <tr>
                                <td style="padding: 1mm 0; border-top: 1px solid #ddd;">
                                    <t t-esc="quant.product_id.display_name"/>
                                </td>
                                <td style="padding: 1mm 0; border-top: 1px solid #ddd; text-align: right;">
                                    <t t-esc="quant.quantity"/>
                                    <t t-esc="quant.product_id.uom_id.name"/>
                                </td>
                            </tr>
                        </t>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
