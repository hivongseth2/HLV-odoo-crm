<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shopee_result_viewer_form" model="ir.ui.view">
        <field name="name">shopee.result.viewer.form</field>
        <field name="model">shopee.result.viewer</field>
        <field name="arch" type="xml">
            <form string="Kết quả Shopee API">
                <sheet>
                    <h3 style="color:#ee4d2d;">
                        <field name="title" readonly="1" nolabel="1"/>
                    </h3>
                    <field name="result_json" readonly="1" nolabel="1"
                           widget="ace" options="{'mode': 'json'}"
                           style="height:460px; font-size:12px;"/>
                </sheet>
                <footer>
                    <button string="Đóng" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
