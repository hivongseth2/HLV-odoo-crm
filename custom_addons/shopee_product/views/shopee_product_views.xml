<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════
         SHOPEE.PRODUCT — LIST VIEW
    ═══════════════════════════════════════════════════════════════ -->
    <record id="view_shopee_product_list" model="ir.ui.view">
        <field name="name">shopee.product.list</field>
        <field name="model">shopee.product</field>
        <field name="arch" type="xml">
            <list string="Sản phẩm Shopee"
                  decoration-muted="item_status in ('SELLER_DELETE','SHOPEE_DELETE')"
                  decoration-warning="item_status == 'UNLIST'"
                  decoration-danger="item_status == 'BANNED'"
                  decoration-info="item_status == 'REVIEWING'">
                <field name="item_name" string="Sản phẩm Shopee"/>
                <field name="item_sku" string="SKU" optional="show"/>
                <field name="shop_id" string="Cửa hàng" optional="show"/>
                <field name="item_status" string="Trạng thái" widget="badge"
                       decoration-success="item_status == 'NORMAL'"
                       decoration-warning="item_status == 'UNLIST'"
                       decoration-danger="item_status in ('BANNED','SHOPEE_DELETE')"
                       decoration-muted="item_status == 'SELLER_DELETE'"
                       decoration-info="item_status == 'REVIEWING'"/>
                <field name="original_price" string="Giá gốc (đ)" widget="integer" optional="show"/>
                <field name="current_price" string="Giá bán (đ)" widget="integer"/>
                <field name="total_available_stock" string="Tồn kho"
                       decoration-danger="total_available_stock == 0"
                       decoration-warning="total_available_stock &lt; 5 and total_available_stock &gt; 0"/>
                  <field name="has_model" string="Có biến thể" widget="boolean_toggle" optional="show"/>
                  <field name="model_count" string="Dòng biến thể" optional="show"
                      decoration-danger="has_model and model_count == 0"
                      decoration-success="model_count &gt; 0"/>
                  <field name="mapped_product_count" string="Sản phẩm Odoo" optional="show"
                      decoration-success="mapped_product_count &gt; 0"/>
                  <field name="shopee_item_mapping_count" string="Liên kết" optional="show"
                      decoration-success="shopee_item_mapping_count &gt; 0"/>
                <field name="shopee_update_time" string="Cập nhật Shopee" optional="show"/>
                <field name="last_synced" string="Đồng bộ lần cuối" optional="show"/>
                <field name="shopee_item_id" string="Mã sản phẩm Shopee" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         SHOPEE.PRODUCT — FORM VIEW
    ═══════════════════════════════════════════════════════════════ -->
    <record id="view_shopee_product_form" model="ir.ui.view">
        <field name="name">shopee.product.form</field>
        <field name="model">shopee.product</field>
        <field name="arch" type="xml">
            <form string="Bàn làm việc sản phẩm Shopee">
                <header>
                        <button name="action_refresh_from_shopee" type="object"
                            string="Làm mới" class="btn btn-shopee" icon="fa-refresh" style="background:#ee4d2d;"/>
                    <button name="action_load_models" type="object"
                            string="Tải biến thể" class="btn btn-shopee-soft" icon="fa-list-ul"
                            invisible="not has_model"/>
                    <button name="action_push_price" type="object"
                            string="Đẩy giá" class="btn btn-shopee-soft" icon="fa-tag"
                            confirm="Cập nhật giá lên Shopee?"/>
                    <button name="action_push_stock" type="object"
                            string="Đẩy tồn kho" class="btn btn-shopee-soft" icon="fa-cubes"
                            confirm="Cập nhật tồn kho lên Shopee?"/>
                    <button name="action_open_shopee_item" type="object"
                            string="Xem Shopee" class="btn btn-shopee-soft" icon="fa-external-link"
                            invisible="not shopee_item_url"/>
                    <button name="action_delete_from_shopee" type="object"
                            string="Xóa khỏi Shopee" class="btn-danger" icon="fa-trash"
                            confirm="Sản phẩm sẽ bị xóa khỏi Shopee. Tiếp tục?"
                            invisible="item_status in ('SELLER_DELETE', 'SHOPEE_DELETE')"/>
                </header>

                <sheet>
                    <field name="shopee_item_url" invisible="1"/>

                    <div class="container-fluid px-0 o_shopee_workbench" style="background:#f7f8fa;">
                        <div class="p-4 mb-3 rounded-3 shadow-sm" style="background:#fef1ec; box-shadow:0 8px 24px rgba(238,77,45,.10);">
                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <span class="badge text-white" style="background:#ee4d2d;">Sản phẩm Shopee</span>
                                    <field name="item_status" widget="badge"
                                           decoration-success="item_status == 'NORMAL'"
                                           decoration-warning="item_status == 'UNLIST'"
                                           decoration-danger="item_status in ('BANNED','SHOPEE_DELETE')"
                                           decoration-muted="item_status == 'SELLER_DELETE'"
                                           decoration-info="item_status == 'REVIEWING'"/>
                                </div>
                                <div class="d-flex flex-wrap gap-2">
                                    <button name="action_refresh_from_shopee" type="object"
                                            string="Làm mới" class="btn btn-shopee" icon="fa-refresh" style="background:#ee4d2d;"/>
                                    <button name="action_load_models" type="object"
                                            string="Biến thể" class="btn btn-shopee-soft" icon="fa-list-ul"
                                            invisible="not has_model"/>
                                    <button name="action_open_shopee_item" type="object"
                                            string="Shopee" class="btn btn-shopee-soft" icon="fa-external-link"
                                            invisible="not shopee_item_url"/>
                                </div>
                            </div>
                            <div class="w-100">
                                <h1 class="display-6 fw-semibold mb-2 lh-sm" style="color:#222; white-space:normal; word-break:break-word; overflow-wrap:anywhere; max-width:100%;">
                                    <field name="item_name" nolabel="1" class="d-block w-100" placeholder="Tên sản phẩm Shopee" style="font-size:1.5rem;"/>
                                </h1>
                                <div class="d-flex flex-wrap gap-3" style="color:#6b7280;">
                                    <span><i class="fa fa-barcode me-1" style="color:#ee4d2d;"/> <field name="item_sku" nolabel="1" placeholder="SKU"/></span>
                                    <span><i class="fa fa-hashtag me-1" style="color:#ee4d2d;"/> <field name="shopee_item_id" nolabel="1" readonly="1"/></span>
                                    <span><i class="fa fa-shopping-bag me-1" style="color:#ee4d2d;"/> <field name="shop_id" nolabel="1" readonly="1" options="{'no_open': False}"/></span>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap mb-3 overflow-hidden rounded-3" style="border:2px solid #f5b8ac; background:#fde8e2;">
                            <button type="object" name="action_refresh_from_shopee" class="btn flex-fill text-center py-3 px-4" style="background:transparent; color:inherit; border:0; border-right:2px solid #f5b8ac; min-width:130px;">
                                <div class="fw-semibold small text-uppercase" style="color:#c0341b; letter-spacing:.06em;">Tồn kho</div>
                                <div class="fs-2 fw-bold" style="color:#ee4d2d;"><field name="total_available_stock" nolabel="1" readonly="1"/></div>
                            </button>
                            <button name="action_load_models" type="object" class="btn flex-fill text-center py-3 px-4" style="background:transparent; color:inherit; border:0; border-right:2px solid #f5b8ac; min-width:130px;" invisible="not has_model">
                                <div class="fw-semibold small text-uppercase" style="color:#c0341b; letter-spacing:.06em;">Biến thể</div>
                                <div class="fs-2 fw-bold" style="color:#ee4d2d;"><field name="model_count" nolabel="1" readonly="1"/></div>
                            </button>
                            <div class="flex-fill text-center py-3 px-4" style="border-right:2px solid #f5b8ac; min-width:130px;" invisible="has_model">
                                <div class="fw-semibold small text-uppercase" style="color:#c0341b; letter-spacing:.06em;">Biến thể</div>
                                <div class="fs-2 fw-bold" style="color:#ee4d2d;"><field name="model_count" nolabel="1" readonly="1"/></div>
                            </div>
                            <button type="object" name="action_open_shopee_item_mappings" class="btn flex-fill text-center py-3 px-4" style="background:transparent; color:inherit; border:0; border-right:2px solid #f5b8ac; min-width:130px;" invisible="not shopee_item_mapping_count">
                                <div class="fw-semibold small text-uppercase" style="color:#c0341b; letter-spacing:.06em;">Liên kết</div>
                                <div class="fs-2 fw-bold" style="color:#ee4d2d;"><field name="shopee_item_mapping_count" nolabel="1" readonly="1"/></div>
                            </button>
                            <div class="flex-fill text-center py-3 px-4" style="border-right:2px solid #f5b8ac; min-width:130px;" invisible="shopee_item_mapping_count">
                                <div class="fw-semibold small text-uppercase" style="color:#c0341b; letter-spacing:.06em;">Liên kết</div>
                                <div class="fs-2 fw-bold" style="color:#ee4d2d;"><field name="shopee_item_mapping_count" nolabel="1" readonly="1"/></div>
                            </div>
                            <button type="object" name="action_open_mapped_products" class="btn flex-fill text-center py-3 px-4" style="background:transparent; color:inherit; border:0; min-width:130px;" invisible="not mapped_product_count">
                                <div class="fw-semibold small text-uppercase" style="color:#c0341b; letter-spacing:.06em;">Sản phẩm Odoo</div>
                                <div class="fs-2 fw-bold" style="color:#ee4d2d;"><field name="mapped_product_count" nolabel="1" readonly="1"/></div>
                            </button>
                            <div class="flex-fill text-center py-3 px-4" style="min-width:130px;" invisible="mapped_product_count">
                                <div class="fw-semibold small text-uppercase" style="color:#c0341b; letter-spacing:.06em;">Sản phẩm Odoo</div>
                                <div class="fs-2 fw-bold" style="color:#ee4d2d;"><field name="mapped_product_count" nolabel="1" readonly="1"/></div>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-lg-4">
                                <div class="rounded-3 p-3 h-100 shadow-sm" style="background:#fef7f3; box-shadow:0 8px 20px rgba(15,23,42,.06);">
                                    <div class="fw-semibold mb-3" style="color:#ee4d2d;"><i class="fa fa-id-card-o me-1"/> Định danh</div>
                                    <div class="mb-3">
                                        <span class="d-block text-muted small">Danh mục Shopee</span>
                                        <field name="category_id" invisible="1"/>
                                        <field name="category_display" nolabel="1" readonly="1"/>
                                    </div>
                                    <div class="mb-3">
                                        <span class="d-block text-muted small">Có phân loại</span>
                                        <field name="has_model" nolabel="1" widget="boolean" readonly="1"/>
                                    </div>
                                    <div>
                                        <span class="d-block text-muted small">Cập nhật Shopee</span>
                                        <field name="shopee_update_time" nolabel="1" readonly="1"/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="rounded-3 p-3 h-100 shadow-sm" style="background:#f8fafc; box-shadow:0 8px 20px rgba(15,23,42,.06);">
                                    <div class="fw-semibold mb-3" style="color:#ee4d2d;"><i class="fa fa-line-chart me-1"/> Giá &amp; tồn</div>
                                    <div class="mb-3">
                                        <span class="d-block text-muted small">Giá gốc</span>
                                        <field name="original_price" nolabel="1" widget="integer"/>
                                    </div>
                                    <div class="mb-3">
                                        <span class="d-block text-muted small">Giá hiện tại</span>
                                        <field name="current_price" nolabel="1" widget="integer" readonly="1"/>
                                    </div>
                                    <div>
                                        <span class="d-block text-muted small">Tồn hiện tại</span>
                                        <field name="total_available_stock" nolabel="1" readonly="1"/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="rounded-3 p-3 h-100 shadow-sm" style="background:#fef7f3; box-shadow:0 8px 20px rgba(15,23,42,.06);">
                                    <div class="fw-semibold mb-3" style="color:#ee4d2d;"><i class="fa fa-link me-1"/> Liên kết Odoo</div>
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="text-muted small">Liên kết shopee.item</span>
                                            <button name="action_open_shopee_item_mappings" type="object" string="Mở" class="btn btn-link p-0" icon="fa-external-link" invisible="not shopee_item_mapping_count"/>
                                        </div>
                                        <field name="shopee_item_mapping_ids" nolabel="1" widget="many2many_tags" readonly="1" options="{'no_open': False}"/>
                                    </div>
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="text-muted small">Sản phẩm Odoo</span>
                                            <button name="action_open_mapped_products" type="object" string="Mở" class="btn btn-link p-0" icon="fa-external-link" invisible="not mapped_product_count"/>
                                        </div>
                                        <field name="mapped_product_ids" nolabel="1" widget="many2many_tags" readonly="1" options="{'no_open': False}"/>
                                    </div>
                                    <div>
                                        <span class="d-block text-muted small">Link thủ công</span>
                                        <field name="odoo_product_id" nolabel="1" options="{'no_create': True}"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Cấu hình cập nhật tồn kho và giá -->
                        <div class="row g-3 mb-3">
                            <div class="col-lg-6">
                                <div class="rounded-3 p-3 h-100 shadow-sm" style="background:#fef7f3; box-shadow:0 8px 20px rgba(15,23,42,.06);">
                                    <div class="fw-semibold mb-2" style="color:#ee4d2d;"><i class="fa fa-cubes me-1"/> Tồn kho — phương thức cập nhật</div>
                                    <field name="stock_update_mode" nolabel="1" widget="radio"/>
                                    <div invisible="stock_update_mode != 'warehouse'" class="mt-2">
                                        <field name="stock_warehouse_id" placeholder="Chọn kho hàng"/>
                                    </div>
                                    <div invisible="stock_update_mode != 'fixed_location'" class="mt-2">
                                        <field name="stock_location_id" placeholder="Chọn vị trí kho"/>
                                    </div>
                                    <div invisible="stock_update_mode != 'manual'" class="mt-2 d-flex gap-2 align-items-center">
                                        <field name="manual_stock" placeholder="0" nolabel="1"/>
                                        <button name="action_push_stock" type="object"
                                                string="Đẩy &amp; làm mới" class="btn btn-shopee btn-sm"
                                                icon="fa-arrow-up"
                                                confirm="Đẩy tồn kho thủ công lên Shopee?"/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="rounded-3 p-3 h-100 shadow-sm" style="background:#f8fafc; box-shadow:0 8px 20px rgba(15,23,42,.06);">
                                    <div class="fw-semibold mb-2" style="color:#ee4d2d;"><i class="fa fa-tag me-1"/> Giá — phương thức cập nhật</div>
                                    <field name="price_update_mode" nolabel="1" widget="radio"/>
                                    <div invisible="price_update_mode != 'price_field'" class="mt-2">
                                        <field name="price_field_id"
                                               options="{'no_create': True, 'no_open': True}"
                                               placeholder="Chọn cột giá (list_price, x_studio_gia_san_tmdt, ...)"/>
                                    </div>
                                    <div invisible="price_update_mode != 'manual'" class="mt-2 d-flex gap-2 align-items-center">
                                        <field name="manual_price" placeholder="0" nolabel="1"/>
                                        <button name="action_push_price" type="object"
                                                string="Đẩy &amp; làm mới" class="btn btn-shopee btn-sm"
                                                icon="fa-arrow-up"
                                                confirm="Đẩy giá thủ công lên Shopee?"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="rounded-3 p-3 mb-3 shadow-sm" style="background:#f8fafc; box-shadow:0 8px 20px rgba(15,23,42,.06);" invisible="not has_model">
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                                <div class="fw-semibold fs-5" style="color:#ee4d2d;"><i class="fa fa-sliders me-1"/> Giá &amp; tồn theo biến thể</div>
                                <div class="d-flex flex-wrap gap-2">
                                    <button name="action_push_price" type="object" string="Đẩy giá" class="btn btn-shopee" icon="fa-tag" confirm="Cập nhật giá lên Shopee?"/>
                                    <button name="action_push_stock" type="object" string="Đẩy tồn kho" class="btn btn-shopee" icon="fa-cubes" confirm="Cập nhật tồn kho lên Shopee?"/>
                                    <button name="action_fetch_variation_tree" type="object" string="Cây phân loại" class="btn btn-shopee-soft" icon="fa-sitemap"/>
                                </div>
                            </div>
                            <field name="model_ids" nolabel="1">
                                <list editable="bottom"
                                      decoration-danger="available_stock == 0"
                                      decoration-warning="available_stock &lt; 5 and available_stock &gt; 0">
                                    <field name="tier_label" string="Phân loại" readonly="1"/>
                                    <field name="model_sku" string="SKU"/>
                                    <field name="mapped_product_id" string="Sản phẩm Odoo" readonly="1" optional="show"/>
                                    <field name="model_status" string="Trạng thái" readonly="1" widget="badge"
                                           decoration-success="model_status == 'MODEL_NORMAL'"
                                           decoration-muted="model_status == 'MODEL_UNAVAILABLE'"/>
                                    <field name="current_price" string="Giá hiện tại" readonly="1" widget="integer"/>
                                    <field name="new_price" string="Giá mới" widget="integer"/>
                                    <field name="available_stock" string="Tồn hiện tại" readonly="1"/>
                                    <field name="new_stock" string="Tồn mới"/>
                                    <field name="shopee_model_id" string="Mã biến thể" readonly="1" optional="show"/>
                                    <field name="shopee_item_mapping_id" string="Liên kết" readonly="1" optional="hide"/>
                                    <field name="last_synced" string="Đồng bộ lần cuối" readonly="1" optional="hide"/>
                                </list>
                            </field>
                        </div>

                        <notebook>

                            <!-- ═══ Tab 1: Bình luận ════════════════════════════════════ -->
                            <page string="Bình luận" name="tab_comments">
                                <div class="p-3">
                                    <div class="rounded-3 p-4 shadow-sm" style="background:#fef7f3; border-left:4px solid #ee4d2d; box-shadow:0 8px 20px rgba(15,23,42,.06);">
                                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="rounded-circle d-inline-flex align-items-center justify-content-center flex-shrink-0" style="width:34px;height:34px;background:#fde8e2;color:#ee4d2d;font-size:15px;"><i class="fa fa-comments"/></span>
                                                <span class="fw-semibold fs-5" style="color:#222;">Bình luận</span>
                                            </div>
                                            <div class="d-flex flex-wrap gap-2">
                                                <button name="action_fetch_comments" type="object" string="Lấy bình luận" class="btn btn-shopee" icon="fa-comments"/>
                                                <button name="action_open_reply_comment_wizard" type="object" string="Trả lời" class="btn btn-shopee-soft" icon="fa-reply"/>
                                                <button name="action_open_shopee_item_mappings" type="object" string="Mở item liên kết" class="btn btn-shopee-soft" icon="fa-external-link" invisible="not shopee_item_mapping_count"/>
                                            </div>
                                        </div>
                                        <field name="shopee_item_mapping_ids" nolabel="1" widget="many2many_tags" readonly="1" options="{'no_open': False}"/>
                                    </div>
                                </div>
                            </page>

                            <!-- ═══ Tab 2: Ảnh ═════════════════════════════════════════ -->
                            <page string="Ảnh" name="tab_images">
                                <div class="p-3">
                                    <div class="rounded-3 p-4 shadow-sm" style="background:#f8fafc; box-shadow:0 8px 20px rgba(15,23,42,.06);">
                                        <div class="d-flex align-items-center gap-2 mb-3">
                                            <span class="rounded-circle d-inline-flex align-items-center justify-content-center flex-shrink-0" style="width:34px;height:34px;background:#fde8e2;color:#ee4d2d;font-size:15px;"><i class="fa fa-image"/></span>
                                            <span class="fw-semibold fs-5" style="color:#222;">Ảnh bộ sản phẩm</span>
                                        </div>
                                        <div class="mb-3">
                                            <span class="d-block text-muted small mb-1">Sản phẩm Odoo liên kết</span>
                                            <field name="mapped_product_ids" nolabel="1" widget="many2many_tags" readonly="1" options="{'no_open': False}"/>
                                        </div>
                                        <div class="d-flex flex-wrap gap-2">
                                            <button name="action_open_mapped_products" type="object" string="Mở Odoo" class="btn btn-shopee-soft" icon="fa-external-link" invisible="not mapped_product_count"/>
                                            <button name="action_fetch_kit_item_limit" type="object" string="Giới hạn bộ" class="btn btn-shopee" icon="fa-sliders"/>
                                            <button name="action_fetch_kit_item_info" type="object" string="Thông tin bộ" class="btn btn-shopee-soft" icon="fa-image"/>
                                            <button name="action_open_generate_kit_image_wizard" type="object" string="Tạo ảnh" class="btn btn-shopee-soft" icon="fa-magic"/>
                                        </div>
                                    </div>
                                </div>
                            </page>

                            <!-- ===== Tab 3: Thông tin khác ===== -->
                            <page string="Thông tin khác" name="tab_other">
                                <div class="p-3">

                                    <!-- Chất lượng nội dung &amp; Vi phạm -->
                                    <div class="row g-3 mb-3">
                                        <div class="col-lg-8">
                                            <div class="rounded-3 p-4 h-100 shadow-sm" style="background:#fef7f3; box-shadow:0 8px 20px rgba(15,23,42,.06);">
                                                <div class="d-flex align-items-center gap-2 mb-3">
                                                    <span class="rounded-circle d-inline-flex align-items-center justify-content-center flex-shrink-0" style="width:34px;height:34px;background:#fde8e2;color:#ee4d2d;font-size:15px;"><i class="fa fa-check-circle"/></span>
                                                    <span class="fw-semibold fs-5" style="color:#222;">Chất lượng nội dung</span>
                                                </div>
                                                <span class="d-block text-muted small mb-1">Tên sản phẩm</span>
                                                <field name="item_name" nolabel="1" readonly="1" class="d-block w-100 mb-3" style="white-space:normal; word-break:break-word; overflow-wrap:anywhere; line-height:1.5;"/>
                                                <span class="d-block text-muted small mb-1">SKU</span>
                                                <field name="item_sku" nolabel="1" class="mb-3"/>
                                                <div class="d-flex flex-wrap gap-2">
                                                    <button name="action_fetch_content_diagnosis" type="object" string="Chẩn đoán" class="btn btn-shopee" icon="fa-check-circle"/>
                                                    <button name="action_fetch_category_recommendation" type="object" string="Gợi ý danh mục" class="btn btn-shopee-soft" icon="fa-folder-open"/>
                                                    <button name="action_fetch_recommend_attributes" type="object" string="Gợi ý thuộc tính" class="btn btn-shopee-soft" icon="fa-list"/>
                                                    <button name="action_fetch_item_extra_info" type="object" string="Thông tin thêm" class="btn btn-shopee-soft" icon="fa-info-circle"/>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-4">
                                            <div class="rounded-3 p-4 h-100 shadow-sm" style="background:#f8fafc; box-shadow:0 8px 20px rgba(15,23,42,.06);">
                                                <div class="d-flex align-items-center gap-2 mb-3">
                                                    <span class="rounded-circle d-inline-flex align-items-center justify-content-center flex-shrink-0" style="width:34px;height:34px;background:#fde8e2;color:#ee4d2d;font-size:15px;"><i class="fa fa-ban"/></span>
                                                    <span class="fw-semibold fs-5" style="color:#222;">Vi phạm</span>
                                                </div>
                                                <span class="d-block text-muted small mb-1">Trạng thái</span>
                                                <div class="mb-2">
                                                    <field name="item_status" nolabel="1" readonly="1" widget="badge"
                                                           decoration-success="item_status == 'NORMAL'"
                                                           decoration-warning="item_status == 'UNLIST'"
                                                           decoration-danger="item_status in ('BANNED','SHOPEE_DELETE')"
                                                           decoration-muted="item_status == 'SELLER_DELETE'"
                                                           decoration-info="item_status == 'REVIEWING'"/>
                                                </div>
                                                <span class="d-block text-muted small mb-1">Cập nhật Shopee</span>
                                                <div class="mb-3"><field name="shopee_update_time" nolabel="1" readonly="1"/></div>
                                                <div class="d-flex flex-column gap-2">
                                                    <button name="action_fetch_violation_info" type="object" string="Thông tin vi phạm" class="btn btn-shopee" icon="fa-ban"/>
                                                    <button name="action_fetch_content_diagnosis" type="object" string="Kiểm tra lỗi nội dung" class="btn btn-shopee-outline" icon="fa-search"/>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Đẩy hiển thị &amp; Đồng bộ -->
                                    <div class="row g-3 mb-3">
                                        <div class="col-lg-6">
                                            <div class="rounded-3 p-4 h-100 shadow-sm" style="background:#f8fafc; box-shadow:0 8px 20px rgba(15,23,42,.06);">
                                                <div class="d-flex align-items-center gap-2 mb-3">
                                                    <span class="rounded-circle d-inline-flex align-items-center justify-content-center flex-shrink-0" style="width:30px;height:30px;background:#fde8e2;color:#ee4d2d;font-size:13px;"><i class="fa fa-rocket"/></span>
                                                    <span class="fw-semibold" style="color:#222;">Đẩy hiển thị</span>
                                                </div>
                                                <div class="d-flex flex-wrap gap-2">
                                                    <button name="action_refresh_from_shopee" type="object" string="Làm mới" class="btn btn-shopee" icon="fa-refresh"/>
                                                    <button name="action_fetch_boosted_list" type="object" string="Đang đẩy" class="btn btn-shopee-soft" icon="fa-rocket"/>
                                                    <button name="action_check_deboost_search" type="object" string="Kiểm tra hạ hạng" class="btn btn-shopee-soft" icon="fa-search"/>
                                                    <button name="action_open_shopee_item" type="object" string="Shopee" class="btn btn-shopee-soft" icon="fa-external-link" invisible="not shopee_item_url"/>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-6">
                                            <div class="rounded-3 p-4 h-100 shadow-sm" style="background:#f8fafc; box-shadow:0 8px 20px rgba(15,23,42,.06);">
                                                <div class="d-flex align-items-center gap-2 mb-3">
                                                    <span class="rounded-circle d-inline-flex align-items-center justify-content-center flex-shrink-0" style="width:30px;height:30px;background:#fde8e2;color:#ee4d2d;font-size:13px;"><i class="fa fa-clock-o"/></span>
                                                    <span class="fw-semibold" style="color:#222;">Đồng bộ</span>
                                                </div>
                                                <div class="text-muted small mb-2"><field name="last_synced" nolabel="1" readonly="1"/></div>
                                                <div class="d-flex flex-wrap gap-2">
                                                    <button name="action_fetch_item_limit" type="object" string="Giới hạn SP" class="btn btn-shopee" icon="fa-dashboard"/>
                                                    <button name="action_fetch_item_extra_info" type="object" string="Thông tin thêm" class="btn btn-shopee-soft" icon="fa-info-circle"/>
                                                    <button name="action_fetch_size_chart_list" type="object" string="Bảng kích thước" class="btn btn-shopee-soft" icon="fa-table"/>
                                                    <button name="action_open_size_chart_detail_wizard" type="object" string="Chi tiết KT" class="btn btn-shopee-soft" icon="fa-list-alt"/>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Dữ liệu JSON -->
                                    <div class="rounded-3 p-3 shadow-sm" style="background:#f8fafc; box-shadow:0 8px 20px rgba(15,23,42,.06);">
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <div class="fw-semibold" style="color:#ee4d2d;"><i class="fa fa-code me-1"/> Dữ liệu JSON</div>
                                            <div class="text-muted small" invisible="not last_api_synced_at">
                                                <i class="fa fa-clock-o me-1"/>
                                                Section: <field name="last_api_section" nolabel="1" readonly="1" class="d-inline"/>
                                                · Cập nhật: <field name="last_api_synced_at" nolabel="1" readonly="1" class="d-inline"/>
                                            </div>
                                        </div>
                                        <field name="raw_data" widget="json" readonly="1" nolabel="1"/>
                                    </div>

                                </div>
                            </page>

                        </notebook>
                    </div>
                </sheet>


                <chatter/>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         SHOPEE.PRODUCT — SEARCH VIEW
    ═══════════════════════════════════════════════════════════════ -->
    <record id="view_shopee_product_search" model="ir.ui.view">
        <field name="name">shopee.product.search</field>
        <field name="model">shopee.product</field>
        <field name="arch" type="xml">
            <search string="Tìm sản phẩm Shopee">
                <field name="item_name" string="Tên / SKU"
                       filter_domain="['|',('item_name','ilike',self),('item_sku','ilike',self)]"/>
                <field name="shopee_item_id" string="Item ID Shopee"/>
                <field name="shop_id" string="Cửa hàng"/>

                <separator/>
                <filter name="filter_normal" string="Đang bán"
                        domain="[('item_status','=','NORMAL')]"/>
                <filter name="filter_unlist" string="Đang ẩn"
                        domain="[('item_status','=','UNLIST')]"/>
                <filter name="filter_banned" string="Bị cấm"
                        domain="[('item_status','=','BANNED')]"/>
                <filter name="filter_reviewing" string="Đang duyệt"
                        domain="[('item_status','=','REVIEWING')]"/>
                <separator/>
                <filter name="filter_has_model" string="Có biến thể"
                        domain="[('has_model','=',True)]"/>
                <filter name="filter_no_odoo" string="Chưa link thủ công"
                    domain="[('odoo_product_id','=',False)]"/>
                <filter name="filter_out_of_stock" string="Hết hàng"
                        domain="[('total_available_stock','=',0)]"/>
                <separator/>
                <filter name="filter_deleted" string="Đã xóa"
                        domain="[('item_status','in',['SELLER_DELETE','SHOPEE_DELETE'])]"/>

                <group expand="0" string="Nhóm theo">
                    <filter name="group_shop" string="Cửa hàng"
                            context="{'group_by': 'shop_id'}"/>
                    <filter name="group_status" string="Trạng thái"
                            context="{'group_by': 'item_status'}"/>
                    <filter name="group_sync_date" string="Ngày đồng bộ"
                            context="{'group_by': 'last_synced:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         ACTION — Danh sách sản phẩm
    ═══════════════════════════════════════════════════════════════ -->
    <record id="action_shopee_product" model="ir.actions.act_window">
        <field name="name">Sản phẩm Shopee</field>
        <field name="res_model">shopee.product</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_shopee_product_search"/>
        <field name="context">{'search_default_filter_normal': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có sản phẩm Shopee nào.
            </p>
            <p>Nhấn <strong>Đồng bộ từ Shopee</strong> để kéo dữ liệu về.</p>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         ACTION — Mở wizard đồng bộ
    ═══════════════════════════════════════════════════════════════ -->
    <record id="action_shopee_product_sync_wizard" model="ir.actions.act_window">
        <field name="name">Đồng bộ sản phẩm Shopee</field>
        <field name="res_model">shopee.product.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         MENU
    ═══════════════════════════════════════════════════════════════ -->
    <menuitem id="menu_shopee_product"
              name="Sản phẩm"
              parent="shopee_webhook.menu_shopee_root"
              action="action_shopee_product"
              sequence="20"
              groups="sales_team.group_sale_salesman"/>

    <menuitem id="menu_shopee_product_sync"
              name="Đồng bộ từ Shopee"
              parent="shopee_webhook.menu_shopee_root"
              action="action_shopee_product_sync_wizard"
              sequence="21"
              groups="sales_team.group_sale_salesman"/>

</odoo>
