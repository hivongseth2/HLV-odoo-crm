<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════
         SHOPEE.PRODUCT — LIST VIEW
    ═══════════════════════════════════════════════════════════════ -->
    <record id="view_shopee_product_list" model="ir.ui.view">
        <field name="name">shopee.product.list</field>
        <field name="model">shopee.product</field>
        <field name="arch" type="xml">
            <list string="Sản phẩm Shopee"
                  decoration-muted="item_status in ('SELLER_DELETE','SHOPEE_DELETE')"
                  decoration-warning="item_status == 'UNLIST'"
                  decoration-danger="item_status == 'BANNED'"
                  decoration-info="item_status == 'REVIEWING'">
                <field name="item_name" string="Sản phẩm Shopee"/>
                <field name="item_sku" string="SKU" optional="show"/>
                <field name="shop_id" string="Shop" optional="show"/>
                <field name="item_status" string="Trạng thái" widget="badge"
                       decoration-success="item_status == 'NORMAL'"
                       decoration-warning="item_status == 'UNLIST'"
                       decoration-danger="item_status in ('BANNED','SHOPEE_DELETE')"
                       decoration-muted="item_status == 'SELLER_DELETE'"
                       decoration-info="item_status == 'REVIEWING'"/>
                <field name="original_price" string="Giá gốc (đ)" widget="integer" optional="show"/>
                <field name="current_price" string="Giá bán (đ)" widget="integer"/>
                <field name="total_available_stock" string="Tồn kho"
                       decoration-danger="total_available_stock == 0"
                       decoration-warning="total_available_stock &lt; 5 and total_available_stock &gt; 0"/>
                  <field name="has_model" string="Có biến thể" widget="boolean_toggle" optional="show"/>
                  <field name="model_count" string="Dòng biến thể" optional="show"
                      decoration-danger="has_model and model_count == 0"
                      decoration-success="model_count &gt; 0"/>
                  <field name="mapped_product_count" string="SP Odoo" optional="show"
                      decoration-success="mapped_product_count &gt; 0"/>
                  <field name="shopee_item_mapping_count" string="Mapping" optional="show"
                      decoration-success="shopee_item_mapping_count &gt; 0"/>
                <field name="shopee_update_time" string="Cập nhật Shopee" optional="show"/>
                <field name="last_synced" string="Đồng bộ lần cuối" optional="show"/>
                <field name="shopee_item_id" string="Item ID" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         SHOPEE.PRODUCT — FORM VIEW
    ═══════════════════════════════════════════════════════════════ -->
    <record id="view_shopee_product_form" model="ir.ui.view">
        <field name="name">shopee.product.form</field>
        <field name="model">shopee.product</field>
        <field name="arch" type="xml">
            <form string="Shopee Product Workbench">
                <header>
                    <button name="action_refresh_from_shopee" type="object"
                            string="Làm mới" class="btn-primary" icon="fa-refresh"/>
                    <button name="action_load_models" type="object"
                            string="Tải biến thể" class="btn-secondary" icon="fa-list-ul"
                            invisible="not has_model"/>
                    <button name="action_push_price" type="object"
                            string="Đẩy giá" class="btn-secondary" icon="fa-tag"
                            confirm="Cập nhật giá lên Shopee?"/>
                    <button name="action_push_stock" type="object"
                            string="Đẩy tồn kho" class="btn-secondary" icon="fa-cubes"
                            confirm="Cập nhật tồn kho lên Shopee?"/>
                    <button name="action_open_shopee_item" type="object"
                            string="Xem Shopee" class="btn-secondary" icon="fa-external-link"
                            invisible="not shopee_item_url"/>
                    <button name="action_delete_from_shopee" type="object"
                            string="Xóa khỏi Shopee" class="btn-danger" icon="fa-trash"
                            confirm="Sản phẩm sẽ bị xóa khỏi Shopee. Tiếp tục?"
                            invisible="item_status in ('SELLER_DELETE', 'SHOPEE_DELETE')"/>
                </header>

                <sheet>
                    <field name="shopee_item_url" invisible="1"/>

                    <div class="container-fluid px-0 o_shopee_workbench">
                        <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 p-3 mb-3 border rounded bg-100">
                            <div class="flex-grow-1 min-w-0">
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                    <span class="badge text-bg-light border">Shopee Product</span>
                                    <field name="item_status" widget="badge"
                                           decoration-success="item_status == 'NORMAL'"
                                           decoration-warning="item_status == 'UNLIST'"
                                           decoration-danger="item_status in ('BANNED','SHOPEE_DELETE')"
                                           decoration-muted="item_status == 'SELLER_DELETE'"
                                           decoration-info="item_status == 'REVIEWING'"/>
                                </div>
                                <h1 class="display-6 fw-semibold mb-2 lh-sm">
                                    <field name="item_name" nolabel="1" placeholder="Tên sản phẩm Shopee"/>
                                </h1>
                                <div class="d-flex flex-wrap gap-3 text-muted">
                                    <span><i class="fa fa-barcode me-1"/> <field name="item_sku" nolabel="1" placeholder="SKU"/></span>
                                    <span><i class="fa fa-hashtag me-1"/> <field name="shopee_item_id" nolabel="1" readonly="1"/></span>
                                    <span><i class="fa fa-shopping-bag me-1"/> <field name="shop_id" nolabel="1" readonly="1" options="{'no_open': False}"/></span>
                                </div>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                <button name="action_refresh_from_shopee" type="object"
                                        string="Làm mới" class="btn btn-primary" icon="fa-refresh"/>
                                <button name="action_load_models" type="object"
                                        string="Biến thể" class="btn btn-outline-primary" icon="fa-list-ul"
                                        invisible="not has_model"/>
                                <button name="action_open_shopee_item" type="object"
                                        string="Shopee" class="btn btn-outline-secondary" icon="fa-external-link"
                                        invisible="not shopee_item_url"/>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-6 col-lg-3">
                                <button type="object" name="action_refresh_from_shopee" class="btn w-100 text-start border bg-white p-3">
                                    <div class="text-muted small text-uppercase">Tồn kho</div>
                                    <div class="fs-3 fw-semibold"><field name="total_available_stock" nolabel="1" readonly="1"/></div>
                                </button>
                            </div>
                            <div class="col-6 col-lg-3">
                                <button name="action_load_models" type="object" class="btn w-100 text-start border bg-white p-3" invisible="not has_model">
                                    <div class="text-muted small text-uppercase">Biến thể</div>
                                    <div class="fs-3 fw-semibold"><field name="model_count" nolabel="1" readonly="1"/></div>
                                </button>
                                <div class="border bg-white p-3 rounded" invisible="has_model">
                                    <div class="text-muted small text-uppercase">Biến thể</div>
                                    <div class="fs-3 fw-semibold"><field name="model_count" nolabel="1" readonly="1"/></div>
                                </div>
                            </div>
                            <div class="col-6 col-lg-3">
                                <button type="object" name="action_open_shopee_item_mappings" class="btn w-100 text-start border bg-white p-3" invisible="not shopee_item_mapping_count">
                                    <div class="text-muted small text-uppercase">Mapping</div>
                                    <div class="fs-3 fw-semibold"><field name="shopee_item_mapping_count" nolabel="1" readonly="1"/></div>
                                </button>
                                <div class="border bg-white p-3 rounded" invisible="shopee_item_mapping_count">
                                    <div class="text-muted small text-uppercase">Mapping</div>
                                    <div class="fs-3 fw-semibold"><field name="shopee_item_mapping_count" nolabel="1" readonly="1"/></div>
                                </div>
                            </div>
                            <div class="col-6 col-lg-3">
                                <button type="object" name="action_open_mapped_products" class="btn w-100 text-start border bg-white p-3" invisible="not mapped_product_count">
                                    <div class="text-muted small text-uppercase">SP Odoo</div>
                                    <div class="fs-3 fw-semibold"><field name="mapped_product_count" nolabel="1" readonly="1"/></div>
                                </button>
                                <div class="border bg-white p-3 rounded" invisible="mapped_product_count">
                                    <div class="text-muted small text-uppercase">SP Odoo</div>
                                    <div class="fs-3 fw-semibold"><field name="mapped_product_count" nolabel="1" readonly="1"/></div>
                                </div>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-lg-4">
                                <div class="border rounded bg-white p-3 h-100">
                                    <div class="fw-semibold mb-3">Identity</div>
                                    <div class="mb-3">
                                        <span class="d-block text-muted small">Danh mục Shopee</span>
                                        <field name="category_id" nolabel="1" readonly="1"/>
                                    </div>
                                    <div class="mb-3">
                                        <span class="d-block text-muted small">Có phân loại</span>
                                        <field name="has_model" nolabel="1" widget="boolean" readonly="1"/>
                                    </div>
                                    <div>
                                        <span class="d-block text-muted small">Cập nhật Shopee</span>
                                        <field name="shopee_update_time" nolabel="1" readonly="1"/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="border rounded bg-white p-3 h-100">
                                    <div class="fw-semibold mb-3">Giá &amp; tồn</div>
                                    <div class="mb-3">
                                        <span class="d-block text-muted small">Giá gốc</span>
                                        <field name="original_price" nolabel="1" widget="integer"/>
                                    </div>
                                    <div class="mb-3">
                                        <span class="d-block text-muted small">Giá hiện tại</span>
                                        <field name="current_price" nolabel="1" widget="integer" readonly="1"/>
                                    </div>
                                    <div>
                                        <span class="d-block text-muted small">Tồn hiện tại</span>
                                        <field name="total_available_stock" nolabel="1" readonly="1"/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="border rounded bg-white p-3 h-100">
                                    <div class="fw-semibold mb-3">Liên kết Odoo</div>
                                    <div class="mb-3">
                                        <span class="d-block text-muted small">Mapping shopee.item</span>
                                        <field name="shopee_item_mapping_ids" nolabel="1" widget="many2many_tags" readonly="1"/>
                                    </div>
                                    <div class="mb-3">
                                        <span class="d-block text-muted small">Sản phẩm Odoo</span>
                                        <field name="mapped_product_ids" nolabel="1" widget="many2many_tags" readonly="1"/>
                                    </div>
                                    <div>
                                        <span class="d-block text-muted small">Link thủ công</span>
                                        <field name="odoo_product_id" nolabel="1" options="{'no_create': True}"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="border rounded bg-white p-3 mb-3" invisible="not has_model">
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                                <div class="fw-semibold fs-5">Giá &amp; tồn theo biến thể</div>
                                <div class="d-flex flex-wrap gap-2">
                                    <button name="action_push_price" type="object" string="Đẩy giá" class="btn btn-primary" icon="fa-tag" confirm="Cập nhật giá lên Shopee?"/>
                                    <button name="action_push_stock" type="object" string="Đẩy tồn kho" class="btn btn-primary" icon="fa-cubes" confirm="Cập nhật tồn kho lên Shopee?"/>
                                </div>
                            </div>
                            <field name="model_ids" nolabel="1">
                                <list editable="bottom"
                                      decoration-danger="available_stock == 0"
                                      decoration-warning="available_stock &lt; 5 and available_stock &gt; 0">
                                    <field name="tier_label" string="Phân loại" readonly="1"/>
                                    <field name="model_sku" string="SKU"/>
                                    <field name="mapped_product_id" string="Sản phẩm Odoo" readonly="1" optional="show"/>
                                    <field name="model_status" string="Trạng thái" readonly="1" widget="badge"
                                           decoration-success="model_status == 'MODEL_NORMAL'"
                                           decoration-muted="model_status == 'MODEL_UNAVAILABLE'"/>
                                    <field name="current_price" string="Giá hiện tại" readonly="1" widget="integer"/>
                                    <field name="new_price" string="Giá mới" widget="integer"/>
                                    <field name="available_stock" string="Tồn hiện tại" readonly="1"/>
                                    <field name="new_stock" string="Tồn mới"/>
                                    <field name="shopee_model_id" string="Model ID" readonly="1" optional="show"/>
                                    <field name="shopee_item_mapping_id" string="Mapping" readonly="1" optional="hide"/>
                                    <field name="last_synced" string="Đồng bộ lần cuối" readonly="1" optional="hide"/>
                                </list>
                            </field>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-xl-4 col-lg-6">
                                <div class="border rounded bg-white p-3 h-100">
                                    <div class="fw-semibold mb-3"><i class="fa fa-check-circle me-1"/> Content quality</div>
                                    <span class="d-block text-muted small">Tên sản phẩm</span>
                                    <field name="item_name" nolabel="1"/>
                                    <span class="d-block text-muted small mt-3">SKU</span>
                                    <field name="item_sku" nolabel="1"/>
                                </div>
                            </div>
                            <div class="col-xl-4 col-lg-6">
                                <div class="border rounded bg-white p-3 h-100">
                                    <div class="fw-semibold mb-3"><i class="fa fa-ban me-1"/> Violation</div>
                                    <field name="item_status" nolabel="1" readonly="1"/>
                                    <field name="shopee_update_time" nolabel="1" readonly="1"/>
                                </div>
                            </div>
                            <div class="col-xl-4 col-lg-6">
                                <div class="border rounded bg-white p-3 h-100">
                                    <div class="fw-semibold mb-3"><i class="fa fa-comments me-1"/> Comment</div>
                                    <field name="shopee_item_mapping_ids" nolabel="1" widget="many2many_tags" readonly="1"/>
                                </div>
                            </div>
                            <div class="col-xl-4 col-lg-6">
                                <div class="border rounded bg-white p-3 h-100">
                                    <div class="fw-semibold mb-3"><i class="fa fa-rocket me-1"/> Boost</div>
                                    <div class="d-flex flex-wrap gap-2">
                                        <button name="action_refresh_from_shopee" type="object" string="Làm mới" class="btn btn-outline-primary" icon="fa-refresh"/>
                                        <button name="action_open_shopee_item" type="object" string="Shopee" class="btn btn-outline-secondary" icon="fa-external-link" invisible="not shopee_item_url"/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xl-4 col-lg-6">
                                <div class="border rounded bg-white p-3 h-100">
                                    <div class="fw-semibold mb-3"><i class="fa fa-image me-1"/> Kit image</div>
                                    <field name="mapped_product_ids" nolabel="1" widget="many2many_tags" readonly="1"/>
                                </div>
                            </div>
                            <div class="col-xl-4 col-lg-6">
                                <div class="border rounded bg-white p-3 h-100">
                                    <div class="fw-semibold mb-3"><i class="fa fa-clock-o me-1"/> Đồng bộ</div>
                                    <field name="last_synced" nolabel="1" readonly="1"/>
                                </div>
                            </div>
                        </div>

                        <div class="border rounded bg-white p-3">
                            <div class="fw-semibold mb-3">Raw JSON</div>
                            <field name="raw_data" widget="json" readonly="1" nolabel="1"/>
                        </div>
                    </div>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         SHOPEE.PRODUCT — SEARCH VIEW
    ═══════════════════════════════════════════════════════════════ -->
    <record id="view_shopee_product_search" model="ir.ui.view">
        <field name="name">shopee.product.search</field>
        <field name="model">shopee.product</field>
        <field name="arch" type="xml">
            <search string="Tìm sản phẩm Shopee">
                <field name="item_name" string="Tên / SKU"
                       filter_domain="['|',('item_name','ilike',self),('item_sku','ilike',self)]"/>
                <field name="shopee_item_id" string="Item ID Shopee"/>
                <field name="shop_id" string="Cửa hàng"/>

                <separator/>
                <filter name="filter_normal" string="Đang bán"
                        domain="[('item_status','=','NORMAL')]"/>
                <filter name="filter_unlist" string="Đang ẩn"
                        domain="[('item_status','=','UNLIST')]"/>
                <filter name="filter_banned" string="Bị cấm"
                        domain="[('item_status','=','BANNED')]"/>
                <filter name="filter_reviewing" string="Đang duyệt"
                        domain="[('item_status','=','REVIEWING')]"/>
                <separator/>
                <filter name="filter_has_model" string="Có biến thể"
                        domain="[('has_model','=',True)]"/>
                <filter name="filter_no_odoo" string="Chưa link thủ công"
                    domain="[('odoo_product_id','=',False)]"/>
                <filter name="filter_out_of_stock" string="Hết hàng"
                        domain="[('total_available_stock','=',0)]"/>
                <separator/>
                <filter name="filter_deleted" string="Đã xóa"
                        domain="[('item_status','in',['SELLER_DELETE','SHOPEE_DELETE'])]"/>

                <group expand="0" string="Nhóm theo">
                    <filter name="group_shop" string="Cửa hàng"
                            context="{'group_by': 'shop_id'}"/>
                    <filter name="group_status" string="Trạng thái"
                            context="{'group_by': 'item_status'}"/>
                    <filter name="group_sync_date" string="Ngày đồng bộ"
                            context="{'group_by': 'last_synced:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         ACTION — Danh sách sản phẩm
    ═══════════════════════════════════════════════════════════════ -->
    <record id="action_shopee_product" model="ir.actions.act_window">
        <field name="name">Sản phẩm Shopee</field>
        <field name="res_model">shopee.product</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_shopee_product_search"/>
        <field name="context">{'search_default_filter_normal': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có sản phẩm Shopee nào.
            </p>
            <p>Nhấn <strong>Đồng bộ từ Shopee</strong> để kéo dữ liệu về.</p>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         ACTION — Mở wizard đồng bộ
    ═══════════════════════════════════════════════════════════════ -->
    <record id="action_shopee_product_sync_wizard" model="ir.actions.act_window">
        <field name="name">Đồng bộ sản phẩm Shopee</field>
        <field name="res_model">shopee.product.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         MENU
    ═══════════════════════════════════════════════════════════════ -->
    <menuitem id="menu_shopee_product"
              name="Sản phẩm"
              parent="shopee_webhook.menu_shopee_root"
              action="action_shopee_product"
              sequence="20"
              groups="sales_team.group_sale_salesman"/>

    <menuitem id="menu_shopee_product_sync"
              name="Đồng bộ từ Shopee"
              parent="shopee_webhook.menu_shopee_root"
              action="action_shopee_product_sync_wizard"
              sequence="21"
              groups="sales_team.group_sale_salesman"/>

</odoo>
