<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════════
         SHOPEE.PRODUCT.CREATE.WIZARD — FORM VIEW
    ═══════════════════════════════════════════════════════════════ -->
    <record id="view_shopee_product_create_wizard_form" model="ir.ui.view">
        <field name="name">shopee.product.create.wizard.form</field>
        <field name="model">shopee.product.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Tạo sản phẩm lên Shopee" class="o_shopee_create_wizard">
                <sheet>
                    <div class="sp-create-head">
                        <div>
                            <div class="sp-eyebrow">Shopee Seller Center</div>
                            <h2>Tạo sản phẩm Shopee từ Odoo</h2>
                        </div>
                        <div class="sp-head-actions">
                            <button name="action_sync_categories" type="object" string="Tải danh mục" class="btn btn-shopee-soft" icon="fa-download" invisible="not shop_id"/>
                            <button name="action_suggest_category" type="object" string="Gợi ý danh mục" class="btn btn-shopee" icon="fa-magic" invisible="not shop_id or not item_name"/>
                        </div>
                    </div>

                    <!-- Nguồn & cửa hàng -->
                    <div class="sp-section sp-section-compact">
                        <div class="sp-section-title">Nguồn &amp; cửa hàng</div>
                        <group>
                            <field name="product_template_id" options="{'no_create': True}"/>
                            <field name="shop_id" options="{'no_create': True}"/>
                        </group>
                    </div>

                    <!-- Thông tin sản phẩm -->
                    <div class="sp-section">
                        <div class="sp-section-title">Thông tin cơ bản</div>
                        <div class="sp-two-col">
                            <div class="sp-panel">
                            <field name="item_name"/>
                            <field name="item_sku"/>
                            <field name="original_price"/>
                            <field name="weight"/>
                            <field name="initial_stock"/>
                            <label for="shopee_category_id"/>
                            <div class="o_row">
                                <field name="shopee_category_id"
                                       options="{'no_create': True}"
                                       placeholder="Gõ để tìm danh mục lá…"/>
                                <button name="action_sync_categories" type="object"
                                        string="↻ Tải danh mục" class="btn-link"
                                        invisible="not shop_id"/>
                                <button name="action_suggest_category" type="object"
                                        string="🪄 Gợi ý" class="btn-link"
                                        invisible="not shop_id or not item_name"/>
                            </div>
                            <field name="category_id" readonly="1"
                                   invisible="not category_id"/>
                            <field name="category_suggestion" readonly="1"
                                   invisible="not category_suggestion"
                                   widget="text"/>
                            <label for="shopee_brand_id"/>
                            <div class="o_row">
                                <field name="shopee_brand_id"
                                       options="{'no_create': True}"
                                       placeholder="Chọn brand từ Shopee…"/>
                                <button name="action_reload_brand_attributes" type="object"
                                        string="↻ Brand/thuộc tính" class="btn-link"
                                        invisible="not category_id"/>
                            </div>
                            <field name="brand_id" readonly="1" invisible="1"/>
                            <field name="brand_name" readonly="1" invisible="1"/>
                            <field name="upload_product_image"/>
                            </div>
                            <div class="sp-panel sp-description-panel">
                            <div class="sp-field-label">Mô tả sản phẩm</div>
                            <field name="description" widget="text" nolabel="1"
                                   placeholder="Mô tả sản phẩm (tuỳ chọn)…"/>
                            </div>
                        </div>
                    </div>

                    <!-- Thuộc tính -->
                    <div class="sp-section">
                        <div class="sp-section-title">Thông tin chi tiết</div>
                        <div class="sp-help-line">Các thuộc tính bắt buộc được lấy tự động theo ngành hàng. Trường có dấu <span class="text-danger fw-bold">*</span> là bắt buộc.</div>
                            <field name="attribute_line_ids" nolabel="1" mode="kanban">
                                <kanban class="o_shopee_attr_kanban" create="false" delete="false" group_create="false" records_draggable="false">
                                    <field name="is_mandatory"/>
                                    <field name="attribute_name"/>
                                    <field name="input_type"/>
                                    <field name="shopee_attribute_id"/>
                                    <field name="value_id"/>
                                    <field name="value_text"/>
                                    <field name="attribute_id"/>
                                    <templates>
                                        <t t-name="card">
                                            <div class="sp-attr-card">
                                                <div class="sp-attr-label">
                                                    <t t-if="record.is_mandatory.raw_value"><span class="sp-req">*</span></t>
                                                    <span class="sp-attr-name"><field name="attribute_name"/></span>
                                                </div>
                                                <div class="sp-attr-input">
                                                    <field name="value_id" nolabel="1" options="{'no_create': True, 'no_open': True}" placeholder="Chọn giá trị…"/>
                                                    <field name="value_text" nolabel="1" placeholder="Hoặc nhập giá trị…"/>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                    </div>

                    <!-- Vận chuyển -->
                    <div class="sp-section">
                        <div class="sp-section-title">Vận chuyển</div>
                        <div class="sp-help-line">
                                Bật kênh vận chuyển muốn áp dụng cho sản phẩm.
                                Danh sách tự động lấy từ Shopee khi chọn cửa hàng.
                        </div>
                            <button name="action_reload_logistics" type="object"
                                    string="↻ Tải lại danh sách"
                                    class="btn-link"
                                    invisible="not shop_id"/>
                            <field name="logistic_line_ids" nolabel="1" mode="kanban">
                                <kanban class="o_shopee_logi_kanban" create="false" delete="false" group_create="false" records_draggable="false">
                                    <field name="channel_id"/>
                                    <field name="channel_name"/>
                                    <field name="cod_enabled"/>
                                    <field name="selected"/>
                                    <templates>
                                        <t t-name="card">
                                            <div class="sp-logi-card" t-att-class="record.selected.raw_value ? 'sp-logi-on' : ''">
                                                <div class="sp-logi-main">
                                                    <div class="sp-logi-name"><field name="channel_name"/></div>
                                                    <div class="sp-logi-meta">
                                                        <t t-if="record.cod_enabled.raw_value">
                                                            <span class="sp-logi-chip sp-logi-cod"><i class="fa fa-money me-1" title="Hỗ trợ COD" role="img" aria-label="COD"/>COD</span>
                                                        </t>
                                                    </div>
                                                </div>
                                                <div class="sp-logi-toggle">
                                                    <field name="selected" widget="boolean_toggle" nolabel="1"/>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                    </div>
                </sheet>
                <footer>
                    <button name="action_create_shopee_product" type="object"
                            string="Tạo sản phẩm Shopee" class="btn-primary"
                            data-hotkey="v"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"
                            data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         SERVER ACTION — gắn vào product.template (Actions menu)
    ═══════════════════════════════════════════════════════════════ -->
    <record id="action_open_shopee_create_wizard_from_product" model="ir.actions.server">
        <field name="name">Tạo sản phẩm Shopee</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">form,list</field>
        <field name="state">code</field>
        <field name="code">
product_id = records[:1].id if records else False
action = {
    'type': 'ir.actions.act_window',
    'name': 'Tạo sản phẩm Shopee',
    'res_model': 'shopee.product.create.wizard',
    'view_mode': 'form',
    'target': 'new',
    'context': {'default_product_template_id': product_id},
}
        </field>
    </record>
</odoo>
