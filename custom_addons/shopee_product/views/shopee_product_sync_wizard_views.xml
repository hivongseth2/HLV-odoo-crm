<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shopee_product_sync_wizard_form" model="ir.ui.view">
        <field name="name">shopee.product.sync.wizard.form</field>
        <field name="model">shopee.product.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="Đồng bộ Sản phẩm Shopee">
                <sheet>
                    <!-- Input form (ẩn sau khi sync xong) -->
                    <group invisible="state != 'draft'">
                        <group string="Cửa hàng">
                            <field name="shop_id" string="Cửa hàng Shopee"/>
                        </group>
                        <group string="Trạng thái cần sync">
                            <field name="sync_normal" string="Đang bán (NORMAL)"/>
                            <field name="sync_unlist" string="Đang ẩn (UNLIST)"/>
                            <field name="sync_banned" string="Bị cấm (BANNED)"/>
                            <field name="sync_reviewing" string="Đang duyệt (REVIEWING)"/>
                        </group>
                    </group>

                    <group string="Lọc theo thời gian cập nhật" invisible="state != 'draft'">
                        <field name="filter_by_update_time" string="Bật lọc theo thời gian"/>
                        <field name="update_time_from" string="Từ ngày"
                               invisible="not filter_by_update_time"/>
                        <field name="update_time_to" string="Đến ngày"
                               invisible="not filter_by_update_time"/>
                    </group>

                    <!-- Kết quả sau khi sync -->
                    <group invisible="state == 'draft'">
                        <group string="Kết quả đồng bộ">
                            <field name="result_created" string="Sản phẩm tạo mới" readonly="1"/>
                            <field name="result_updated" string="Sản phẩm cập nhật" readonly="1"/>
                        </group>
                    </group>
                    <group invisible="state == 'draft'">
                        <field name="result_message" string="Chi tiết" readonly="1" nolabel="1"
                               widget="text"/>
                    </group>
                </sheet>
                <footer>
                    <!-- Nút khi chưa sync -->
                    <button name="action_sync"
                            string="Bắt đầu đồng bộ"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button string="Huỷ"
                            class="btn-secondary"
                            special="cancel"
                            invisible="state != 'draft'"/>

                    <!-- Nút sau khi sync xong -->
                    <button name="action_open_products"
                            string="Xem sản phẩm"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'done'"/>
                    <button string="Đóng"
                            class="btn-secondary"
                            special="cancel"
                            invisible="state == 'draft'"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
