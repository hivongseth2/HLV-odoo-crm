<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ─── List view ─── -->
    <record id="view_misa_crm_webhook_log_list" model="ir.ui.view">
        <field name="name">misa.crm.webhook.log.list</field>
        <field name="model">misa.crm.webhook.log</field>
        <field name="arch" type="xml">
            <list string="MISA CRM Webhook Logs"
                  decoration-danger="state == 'error'"
                  decoration-success="state == 'done'"
                  decoration-muted="state in ('ignored', 'received')"
                  decoration-warning="state == 'processing'">
                <field name="create_date" string="Thời gian nhận" optional="show"/>
                <field name="event_type"  string="Sự kiện"        optional="show"/>
                <field name="app_id"      string="AppID"           optional="show"/>
                <field name="crm_object_id" string="ID CRM"        optional="show"/>
                <field name="state" string="Trạng thái" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'error'"
                       decoration-warning="state == 'processing'"
                       decoration-muted="state in ('ignored','received')"/>
                <field name="partner_id"    string="Khách hàng Odoo" optional="show"/>
                <field name="sale_order_id" string="Đơn hàng Odoo"   optional="show"/>
                <field name="note"          string="Ghi chú"         optional="show"/>
                <field name="processed_date" string="Thời gian xử lý" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ─── Form view ─── -->
    <record id="view_misa_crm_webhook_log_form" model="ir.ui.view">
        <field name="name">misa.crm.webhook.log.form</field>
        <field name="model">misa.crm.webhook.log</field>
        <field name="arch" type="xml">
            <form string="Chi tiết Webhook Log">
                <header>
                    <button name="action_retry"
                            string="🔄 Thử lại"
                            type="object"
                            class="btn-warning"
                            invisible="state not in ('error', 'ignored')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="received,processing,done,error"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Thông tin sự kiện">
                            <field name="event_type"    readonly="1"/>
                            <field name="app_id"        readonly="1"/>
                            <field name="crm_object_id" readonly="1"/>
                            <field name="http_method"   readonly="1"/>
                            <field name="http_status"   readonly="1"/>
                        </group>
                        <group string="Kết quả xử lý">
                            <field name="state" widget="badge"
                                   decoration-success="state == 'done'"
                                   decoration-danger="state == 'error'"
                                   decoration-warning="state == 'processing'"
                                   decoration-muted="state in ('ignored','received')"
                                   readonly="1"/>
                            <field name="partner_id"    readonly="1"/>
                            <field name="sale_order_id" readonly="1"/>
                            <field name="create_date"   readonly="1"/>
                            <field name="processed_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Ghi chú / Lỗi"
                           invisible="not note and not error_message">
                        <field name="note" readonly="1" nolabel="1"
                               invisible="not note"/>
                        <field name="error_message" readonly="1" nolabel="1"
                               invisible="not error_message"
                               widget="text"
                               class="text-danger"/>
                    </group>
                    <group string="Raw Payload (JSON)">
                        <field name="raw_payload" readonly="1" nolabel="1"
                               widget="code" options="{'lang': 'json'}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ─── Search view ─── -->
    <record id="view_misa_crm_webhook_log_search" model="ir.ui.view">
        <field name="name">misa.crm.webhook.log.search</field>
        <field name="model">misa.crm.webhook.log</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm Log Webhook">
                <field name="event_type" string="Loại sự kiện"/>
                <field name="crm_object_id" string="ID CRM"/>
                <field name="app_id" string="AppID"/>
                <field name="partner_id" string="Khách hàng"/>
                <field name="sale_order_id" string="Đơn hàng"/>
                <separator/>
                <filter name="filter_done"    string="✅ Thành công"  domain="[('state','=','done')]"/>
                <filter name="filter_error"   string="❌ Lỗi"        domain="[('state','=','error')]"/>
                <filter name="filter_received" string="📥 Mới nhận" domain="[('state','=','received')]"/>
                <filter name="filter_ignored" string="⏭ Bỏ qua"    domain="[('state','=','ignored')]"/>
                <separator/>
                <filter name="filter_customer" string="🧑 Khách hàng" domain="[('event_type','like','customer')]"/>
                <filter name="filter_order"    string="📦 Đơn hàng"   domain="[('event_type','like','order')]"/>
                <separator/>
                <filter name="filter_today" string="Hôm nay"
                        domain="[('create_date','&gt;=', (context_today()).strftime('%Y-%m-%d 00:00:00'))]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_state"      string="Trạng thái" context="{'group_by': 'state'}"/>
                    <filter name="group_event_type" string="Loại sự kiện" context="{'group_by': 'event_type'}"/>
                    <filter name="group_date"       string="Ngày nhận" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ─── Action ─── -->
    <record id="action_misa_crm_webhook_log" model="ir.actions.act_window">
        <field name="name">Webhook Log</field>
        <field name="res_model">misa.crm.webhook.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_misa_crm_webhook_log_search"/>
        <field name="context">{'search_default_filter_error': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có webhook nào được nhận.
            </p>
            <p>
                Cấu hình Webhook URL trong AMIS CRM để bắt đầu nhận sự kiện.
            </p>
        </field>
    </record>
</odoo>
