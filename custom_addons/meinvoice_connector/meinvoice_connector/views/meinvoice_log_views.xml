<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_meinvoice_log_list" model="ir.ui.view">
        <field name="name">meinvoice.log.list</field>
        <field name="model">meinvoice.log</field>
        <field name="arch" type="xml">
            <list string="Lịch sử MEinvoice" decoration-danger="state == 'error'"
                  decoration-success="state == 'success'">
                <field name="create_date" string="Thời gian"/>
                <field name="move_id" string="Hóa đơn"/>
                <field name="action" string="Hành động"/>
                <field name="state" string="Kết quả" widget="badge"
                       decoration-success="state == 'success'"
                       decoration-danger="state == 'error'"/>
                <field name="transaction_id" string="Transaction ID"/>
                <field name="message" string="Thông tin"/>
                <field name="create_uid" string="Người thực hiện"/>
            </list>
        </field>
    </record>

    <record id="view_meinvoice_log_form" model="ir.ui.view">
        <field name="name">meinvoice.log.form</field>
        <field name="model">meinvoice.log</field>
        <field name="arch" type="xml">
            <form string="Chi tiết Log MEinvoice">
                <sheet>
                    <group>
                        <group>
                            <field name="move_id" readonly="1"/>
                            <field name="action" readonly="1"/>
                            <field name="state" readonly="1" widget="badge"
                                   decoration-success="state == 'success'"
                                   decoration-danger="state == 'error'"/>
                            <field name="transaction_id" readonly="1"/>
                            <field name="create_date" readonly="1"/>
                            <field name="create_uid" readonly="1"/>
                        </group>
                        <group>
                            <field name="message" readonly="1"/>
                        </group>
                    </group>
                    <group string="Dữ liệu kỹ thuật">
                        <field name="request_data" readonly="1" widget="code" lang="json"/>
                        <field name="response_data" readonly="1" widget="code" lang="json"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Menu action -->
    <record id="action_meinvoice_log" model="ir.actions.act_window">
        <field name="name">Lịch sử MEinvoice</field>
        <field name="res_model">meinvoice.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

    <!-- Menu item dưới Kế toán -->
    <menuitem id="menu_meinvoice_log"
              name="Lịch sử MEinvoice"
              parent="account.menu_finance"
              action="action_meinvoice_log"
              sequence="100"
              groups="account.group_account_user"/>
</odoo>
