<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Default config params -->
    <record id="param_meinvoice_environment" model="ir.config_parameter">
        <field name="key">meinvoice.environment</field>
        <field name="value">sandbox</field>
    </record>
    <record id="param_meinvoice_invoice_name" model="ir.config_parameter">
        <field name="key">meinvoice.invoice_name</field>
        <field name="value">Hóa đơn giá trị gia tăng</field>
    </record>
    <record id="param_meinvoice_auto_publish" model="ir.config_parameter">
        <field name="key">meinvoice.auto_publish</field>
        <field name="value">False</field>
    </record>
</odoo>
