<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_meinvoice_cancel_wizard_form" model="ir.ui.view">
        <field name="name">meinvoice.cancel.wizard.form</field>
        <field name="model">meinvoice.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Hủy Hóa Đơn Điện Tử">
                <sheet>
                    <group>
                        <field name="move_id" readonly="1"/>
                        <field name="reason" placeholder="Nhập lý do hủy hóa đơn..."/>
                    </group>
                    <div class="alert alert-warning" role="alert">
                        ⚠️ Thao tác này sẽ hủy hóa đơn điện tử trên hệ thống MEinvoice.
                        Hành động không thể hoàn tác. Vui lòng xác nhận lý do hủy.
                    </div>
                </sheet>
                <footer>
                    <button name="action_confirm_cancel"
                            string="Xác nhận Hủy"
                            type="object"
                            class="btn-danger"/>
                    <button string="Đóng" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
