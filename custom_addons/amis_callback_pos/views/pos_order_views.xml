<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View riêng (không inherit view POS core) để kế toán theo dõi HĐĐT của đơn POS. -->
    <record id="view_pos_order_meinvoice_list" model="ir.ui.view">
        <field name="name">pos.order.meinvoice.list</field>
        <field name="model">pos.order</field>
        <field name="arch" type="xml">
            <list string="HĐĐT đơn POS" create="false" edit="false" delete="false"
                  decoration-danger="meinvoice_review_needed"
                  decoration-warning="meinvoice_status == 'error'">
                <field name="name"/>
                <field name="date_order"/>
                <field name="partner_id"/>
                <field name="amount_total" sum="Tổng"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" optional="hide"/>
                <field name="meinvoice_status" widget="badge"
                       decoration-success="meinvoice_status == 'published'"
                       decoration-info="meinvoice_status == 'draft'"
                       decoration-danger="meinvoice_status == 'error'"/>
                <field name="meinvoice_review_needed" string="Cần xem" widget="boolean"/>
                <field name="meinvoice_review_note"/>
                <button name="action_view_meinvoice_invoices" type="object" string="Hóa đơn"
                        icon="fa-file-text-o" invisible="meinvoice_status == 'none'"/>
                <button name="action_create_meinvoice_draft" type="object" string="Tạo HĐĐT"
                        icon="fa-plus" invisible="meinvoice_status != 'none'"
                        groups="amis_callback.group_meinvoice_accountant"
                        confirm="Tạo hóa đơn điện tử nháp cho đơn này?"/>
                <button name="action_meinvoice_review_done" type="object" string="Đã xử lý"
                        icon="fa-check" invisible="not meinvoice_review_needed"
                        groups="amis_callback.group_meinvoice_accountant"/>
            </list>
        </field>
    </record>

    <record id="view_pos_order_meinvoice_search" model="ir.ui.view">
        <field name="name">pos.order.meinvoice.search</field>
        <field name="model">pos.order</field>
        <field name="arch" type="xml">
            <search string="HĐĐT đơn POS">
                <field name="name"/>
                <field name="pos_reference"/>
                <field name="partner_id"/>
                <field name="meinvoice_review_note"/>
                <filter name="filter_review" string="Kế toán cần xem"
                        domain="[('meinvoice_review_needed', '=', True)]"/>
                <filter name="filter_no_invoice" string="Chưa có HĐĐT"
                        domain="[('state', 'in', ('paid', 'done', 'invoiced')), ('meinvoice_invoice_ids', '=', False)]"/>
                <filter name="filter_publish_error" string="Chưa tự phát hành được"
                        domain="[('meinvoice_invoice_ids', 'any', [('state', '=', 'draft'), ('pos_publish_error', '!=', False)])]"/>
                <separator/>
                <filter name="filter_date_order" string="Ngày đơn" date="date_order"/>
            </search>
        </field>
    </record>

    <record id="action_pos_order_meinvoice" model="ir.actions.act_window">
        <field name="name">HĐĐT đơn POS</field>
        <field name="res_model">pos.order</field>
        <field name="view_mode">list</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_pos_order_meinvoice_list')})]"/>
        <field name="search_view_id" ref="view_pos_order_meinvoice_search"/>
        <field name="domain">[('state', '!=', 'cancel')]</field>
        <field name="context">{'search_default_filter_review': 1}</field>
    </record>

    <menuitem id="menu_pos_order_meinvoice" name="HĐĐT đơn POS"
              parent="amis_callback.menu_amis_callback_root"
              action="action_pos_order_meinvoice" sequence="19"
              groups="amis_callback.group_meinvoice_user"/>
</odoo>
