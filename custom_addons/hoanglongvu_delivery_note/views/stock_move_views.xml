<odoo>
  <data>

    <!-- Kế thừa form để thêm nút in Delivery Note -->
    <record id="view_picking_form_inherit_delivery_note" model="ir.ui.view">
      <field name="name">stock.picking.form.inherit.delivery.note</field>
      <field name="model">stock.picking</field>
      <field name="inherit_id" ref="stock.view_picking_form"/>
      <field name="arch" type="xml">
        <xpath expr="//header/button[@name='button_validate']" position="after">
          <button name="print_delivery_note"
                  type="object"
                  string="In Delivery Note"
                  class="btn-secondary"
               />
        </xpath>
      </field>
    </record>

    <!-- Kế thừa tree view của move_ids_without_package -->
   <record id="view_move_picking_tree_inherit_logistic_tag" model="ir.ui.view">
      <field name="name">stock.move.tree.inherit.logistic.tag</field>
      <field name="model">stock.move</field>
      <field name="inherit_id" ref="stock.view_move_picking_tree"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='quantity_done']" position="after">
          <button name="print_logistic_tag_line"
                  type="object"
                  string="Tag"
                  icon="fa-print"
                  class="btn-sm btn-link"/>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
