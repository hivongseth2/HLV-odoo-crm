<odoo>
  <data>
    <!-- Thêm button vào stock.move.line operations list -->
    <record id="view_move_line_operations_inherit_logistic_tag" model="ir.ui.view">
      <field name="name">stock.move.line.operations.inherit.logistic.tag</field>
      <field name="model">stock.move.line</field>
      <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='quantity']" position="after">
          <button name="print_logistic_tag_line"
                  type="object"
                  string="Tag"
                  title="In Logistic Tag"
                  icon="fa-print"
                  class="btn-sm btn-link"
             />
        </xpath>
      </field>
    </record>

    <!-- Thêm button vào picking form header -->
    <record id="view_picking_form_inherit_delivery_note" model="ir.ui.view">
      <field name="name">stock.picking.form.inherit.delivery.note</field>
      <field name="model">stock.picking</field>
      <field name="inherit_id" ref="stock.view_picking_form"/>
      <field name="arch" type="xml">
        <xpath expr="//header/button[@name='button_validate']" position="after">
          <button name="print_delivery_note"
                  type="object"
                  string="In Delivery Note"
                  class="btn-secondary"
                 />
        </xpath>
      </field>
    </record>
  </data>
</odoo>
