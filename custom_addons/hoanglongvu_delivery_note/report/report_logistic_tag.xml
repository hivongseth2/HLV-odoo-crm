<odoo>
  <data>
    <template id="report_logistic_tag">
      <t t-call="web.basic_layout">
        <div class="page">
          <h3>LOGISTIC TAG</h3>
          <p><strong>Supplier:</strong> Hoàng Long Vũ</p>
          <p><strong>Buyer PO:</strong> <t t-esc="o.picking_id.origin"/></p>
          <p><strong>Receiver:</strong> <t t-esc="o.picking_id.partner_id.name"/></p>
          <p><strong>Shipment:</strong> <t t-esc="o.picking_id.name"/></p>

          <table border="1" width="100%">
            <thead>
              <tr>
                <th>Item</th>
                <th>Description</th>
                <th>Qty</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><t t-esc="o.product_id.default_code"/></td>
                <td><t t-esc="o.product_id.display_name"/></td>
                <td><t t-esc="o.quantity_done"/></td>
              </tr>
            </tbody>
          </table>

          <div>
            <img t-att-src="'/report/barcode/Code128/%s' % o.picking_id.name"/>
          </div>
        </div>
      </t>
    </template>
  </data>
</odoo>
