<odoo>
  <data>
    <record id="action_report_delivery_note" model="ir.actions.report">
      <field name="name">Biên Bản Giao Nhận Hàng</field>
      <field name="model">stock.picking</field>
      <field name="report_type">qweb-pdf</field>
      <field name="report_name">hoanglongvu_delivery_note.report_delivery_note</field>
      <field name="binding_model_id" ref="stock.model_stock_picking"/>
      <field name="binding_type">report</field>
    </record>

    <record id="action_report_logistic_tag" model="ir.actions.report">
      <field name="name">Logistic Tag</field>
      <field name="model">stock.move</field>
      <field name="report_type">qweb-pdf</field>
      <field name="report_name">hoanglongvu_delivery_note.report_logistic_tag</field>
      <field name="binding_model_id" ref="stock.model_stock_move"/>
      <field name="binding_type">report</field>
      <field name="paperformat_id" ref="hoanglongvu_delivery_note.paperformat_logistic_tag"/>
    </record>

    <!-- Paper format cho logistic tag -->
    <record id="paperformat_logistic_tag" model="report.paperformat">
      <field name="name">Logistic Tag Format</field>
      <field name="format">custom</field>
      <field name="page_height">150</field>
      <field name="page_width">100</field>
      <field name="orientation">Portrait</field>
      <field name="margin_top">5</field>
      <field name="margin_bottom">5</field>
      <field name="margin_left">5</field>
      <field name="margin_right">5</field>
      <field name="header_line" eval="False"/>
      <field name="header_spacing">0</field>
    </record>
  </data>
</odoo>
