<odoo>
  <data>
    <template id="report_delivery_note">
      <t t-call="web.basic_layout">
        <t t-foreach="docs" t-as="o">
          <div class="page" style="font-family: Arial, sans-serif; font-size: 11px;">
            
            <!-- Header với logo và thông tin công ty -->
            <table style="width:100%; margin-bottom: 8px;">
              <tr>
                <td style="width: 12%; vertical-align: top;">
                  <!-- Logo từ company -->
                  <t t-if="o.company_id.logo">
                    <img t-att-src="image_data_uri(o.company_id.logo)" style="max-width: 70px; max-height: 50px;"/>
                  </t>
                  <t t-else="">
                    <div style="width: 70px; height: 50px; border: 1px solid #ccc; text-align: center; line-height: 50px; font-size: 9px;">
                      Your logo
                    </div>
                  </t>
                </td>
                <td style="width: 60%; vertical-align: top; padding-left: 8px;">
                  <h3 style="margin: 0; font-weight: bold; font-size: 14px;" t-esc="o.company_id.name"/>
                  <p style="margin: 1px 0; font-size: 10px;">
                    <span t-esc="o.company_id.street or ''"/>
                    <t t-if="o.company_id.street2">, <span t-esc="o.company_id.street2"/></t>
                    <t t-if="o.company_id.city">, <span t-esc="o.company_id.city"/></t>
                    <t t-if="o.company_id.state_id">, <span t-esc="o.company_id.state_id.name"/></t>
                  </p>
                  <p style="margin: 1px 0; font-size: 10px;">
                    <t t-if="o.company_id.phone">Điện thoại: <span t-esc="o.company_id.phone"/></t>
                    <t t-if="o.company_id.email"> FAX: .</t>
                  </p>
                </td>
                <td style="width: 28%; vertical-align: top; text-align: right;">
                  <!-- Barcode -->
                  <div style="text-align: right;">
                    <img t-att-src="'/report/barcode/Code128/%s' % o.name" style="width:150px; height: 35px;"/>
                    <div style="font-size: 9px; margin-top: 2px;">
                      <span t-esc="o.name"/>
                    </div>
                  </div>
                </td>
              </tr>
            </table>

            <!-- Đường kẻ ngang -->
            <hr style="border: 1px solid black; margin: 8px 0;"/>

            <!-- Tiêu đề chính -->
            <table style="width: 100%; margin-bottom: 8px;">
              <tr>
                <td style="width: 70%; text-align: center;">
                  <h3 style="margin: 0; font-weight: bold; font-size: 14px;">BIÊN BẢN GIAO NHẬN HÀNG (Delivery Note)</h3>
                </td>
                <td style="width: 30%; text-align: right; font-weight: bold; font-size: 11px;">
                  Số BBGH (Shipment Order No.) : <span t-esc="o.name"/>
                </td>
              </tr>
            </table>

            <!-- Bảng thông tin 3 cột -->
            <table style="width:100%; border:2px solid black; border-collapse:collapse; margin-bottom: 8px;">
              <tr>
                <td style="border:1px solid black; padding: 6px; width: 33.33%; vertical-align: top; font-size: 10px;">
                  <strong>Nhà cung cấp (Supplier)</strong> : <span t-esc="o.company_id.partner_id.ref or o.company_id.id"/><br/><br/>
                  <strong>Delivery type</strong> : <span t-esc="o.picking_type_id.name or ''"/>
                </td>
                <td style="border:1px solid black; padding: 6px; width: 33.33%; vertical-align: top; font-size: 10px;">
                  <strong>Bên bán hàng (Seller)</strong> : <span t-esc="o.company_id.name"/><br/><br/>
                  <strong>Marketing Team</strong> : <span t-esc="o.sale_id.team_id.name if o.sale_id else 'Sales'"/><br/><br/>
                  <strong>Marketing PIC</strong> : <span t-esc="o.sale_id.user_id.name if o.sale_id else o.user_id.name or ''"/>
                </td>
                <td style="border:1px solid black; padding: 6px; width: 33.33%; vertical-align: top; font-size: 10px;">
                  <strong>Bên mua hàng (Buyer)</strong> : <span t-esc="o.partner_id.name"/><br/><br/>
                  <strong>Nhà máy (Plant)</strong> : <span t-esc="o.location_dest_id.name"/><br/><br/>
                  <strong>Bộ phận (Dept)</strong> : <span t-esc="o.sale_id.team_id.name if o.sale_id else 'N/A'"/><br/><br/>
                  <strong>Người phụ trách (PIC)</strong> : <span t-esc="o.partner_id.name"/>
                </td>
              </tr>
            </table>

            <!-- Bảng sản phẩm chi tiết -->
            <table style="width:100%; border:2px solid black; border-collapse:collapse; margin-bottom: 8px;">
              <thead>
                <tr style="background-color: #f0f0f0;">
                  <th style="border:1px solid black; padding: 4px; font-size: 9px; text-align: center; width: 4%;">TT<br/>(No)</th>
                  <th style="border:1px solid black; padding: 4px; font-size: 9px; text-align: center; width: 8%;">Ngày PO<br/>(PO Date)</th>
                  <th style="border:1px solid black; padding: 4px; font-size: 9px; text-align: center; width: 10%;">Số PO<br/>(IMV PO#)</th>
                  <th style="border:1px solid black; padding: 4px; font-size: 9px; text-align: center; width: 10%;">Mã hàng<br/>(Item Code)</th>
                  <th style="border:1px solid black; padding: 4px; font-size: 9px; text-align: center; width: 20%;">[Maker] Tên hàng<br/>([Maker] Item Name)</th>
                  <th style="border:1px solid black; padding: 4px; font-size: 9px; text-align: center; width: 18%;">[Model] Quy cách<br/>([Model] Spec.)</th>
                  <th style="border:1px solid black; padding: 4px; font-size: 9px; text-align: center; width: 6%;">ĐVT<br/>(Unit)</th>
                  <th style="border:1px solid black; padding: 4px; font-size: 9px; text-align: center; width: 6%;">SL<br/>(Q'ty)</th>
                  <th style="border:1px solid black; padding: 4px; font-size: 9px; text-align: center; width: 10%;">Buyer PO No<br/>(PO Seq)</th>
                  <th style="border:1px solid black; padding: 4px; font-size: 9px; text-align: center; width: 8%;">Ghi chú<br/>(Remark)</th>
                </tr>
              </thead>
              <tbody>
                <t t-if="o.move_line_ids and len(o.move_line_ids) > 0">
                  <tr t-foreach="o.move_line_ids" t-as="line">
                    <td style="border:1px solid black; padding: 3px; text-align: center; font-size: 9px;">
                      <span t-esc="line_index + 1"/>
                    </td>
                    <td style="border:1px solid black; padding: 3px; text-align: center; font-size: 9px;">
                      <span t-esc="o.scheduled_date.strftime('%Y%m%d') if o.scheduled_date else ''"/>
                    </td>
                    <td style="border:1px solid black; padding: 3px; text-align: center; font-size: 9px;">
                      <span t-esc="o.origin or o.name"/>
                    </td>
                    <td style="border:1px solid black; padding: 3px; text-align: center; font-size: 9px;">
                      <span t-esc="line.product_id.default_code or ''"/>
                    </td>
                    <td style="border:1px solid black; padding: 3px; font-size: 9px;">
                      <span t-esc="line.product_id.name or ''"/>
                    </td>
                    <td style="border:1px solid black; padding: 3px; font-size: 8px;">
                      <span t-esc="line.product_id.description_sale or line.product_id.description or ''"/>
                    </td>
                    <td style="border:1px solid black; padding: 3px; text-align: center; font-size: 9px;">
                      <span t-esc="line.product_uom_id.name or ''"/>
                    </td>
                    <td style="border:1px solid black; padding: 3px; text-align: center; font-size: 9px;">
                      <span t-esc="int(line.qty_done or line.product_uom_qty or 0)"/>
                    </td>
                    <td style="border:1px solid black; padding: 3px; text-align: center; font-size: 8px;">
                      <span t-esc="o.sale_id.client_order_ref if o.sale_id else ''"/>
                    </td>
                    <td style="border:1px solid black; padding: 3px; font-size: 8px;">
                      <span t-esc="''"/>
                    </td>
                  </tr>
                </t>
                <t t-else="">
                  <tr>
                    <td colspan="10" style="border:1px solid black; padding: 15px; text-align:center; font-style: italic;">
                      Không có dữ liệu sản phẩm
                    </td>
                  </tr>
                </t>
              </tbody>
            </table>

            <!-- Địa chỉ giao hàng -->
            <div style="margin-bottom: 10px; font-size: 10px;">
              <strong>Giao hàng đến (Delivery to) :</strong>
              <t t-if="o.partner_id">
                <span t-esc="o.partner_id.street or ''"/>
                <t t-if="o.partner_id.street2">, <span t-esc="o.partner_id.street2"/></t>
                <t t-if="o.partner_id.city">, <span t-esc="o.partner_id.city"/></t>
                <t t-if="o.partner_id.state_id">, <span t-esc="o.partner_id.state_id.name"/></t>
                <t t-if="o.partner_id.country_id">, <span t-esc="o.partner_id.country_id.name"/></t>
                <br/>
                <span t-esc="o.partner_id.name"/> / <span t-esc="o.partner_id.phone or o.partner_id.mobile or ''"/>
              </t>
            </div>

            <!-- Phần ký tên -->
            <div style="margin-top: 15px; font-size: 10px;">
              <strong>Ký và ghi rõ họ tên (Sign here):</strong>
            </div>
            
            <table style="width:100%; border:2px solid black; border-collapse:collapse; margin-top: 8px; height: 100px;">
              <tr>
                <td style="border:1px solid black; text-align:center; vertical-align: top; padding: 8px; width: 25%;">
                  <strong>Nhà cung cấp</strong><br/>
                  <em>(Supplier signature)</em><br/><br/><br/>
                  <div style="margin-top: 30px;">
                    <em>Date : ....../......./</em>
                  </div>
                </td>
                <td style="border:1px solid black; text-align:center; vertical-align: top; padding: 8px; width: 25%;">
                  <strong>IMV Thủ Kho</strong><br/>
                  <em>(IMV Warehouse signature)</em><br/><br/><br/>
                  <div style="margin-top: 30px;">
                    <em>Date : ....../......./</em>
                  </div>
                </td>
                <td style="border:1px solid black; text-align:center; vertical-align: top; padding: 8px; width: 25%;">
                  <strong>Khách hàng-Thủ kho</strong><br/>
                  <em>(Customer Warehouse Signature)</em><br/><br/><br/>
                  <div style="margin-top: 30px;">
                    <em>Date : ....../......./</em>
                  </div>
                </td>
                <td style="border:1px solid black; text-align:center; vertical-align: top; padding: 8px; width: 25%;">
                  <strong>Khách hàng - Người nhận hàng</strong><br/>
                  <em>(Customer - Receiver's signature)</em><br/><br/><br/>
                  <div style="margin-top: 30px;">
                    <em>Date : ....../......./</em>
                  </div>
                </td>
              </tr>
            </table>

          </div>
        </t>
      </t>
    </template>
  </data>
</odoo>
