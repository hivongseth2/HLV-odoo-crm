<odoo>
    <template id="mobile_barcode_lite_page" name="Mobile Barcode Lite App">
        <html>
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
                <title>Barcode Mobile App</title>
                <link rel="stylesheet" href="/hlv_mobile_barcode_lite/static/src/css/mobile_barcode.css?v=20260419"/>
            </head>
            <body class="hlv-mobile-wrap">
                <div class="hlv-app-container">

                    <!-- SCREEN 1: LOGIN SCREEN -->
                    <div id="login-screen" class="hlv-screen hlv-screen-active">
                        <div class="hlv-screen-header">
                            <h1>LogiPrecision</h1>
                            <p>Barcode Warehouse Scanner</p>
                        </div>
                        <div class="hlv-screen-body">
                            <div class="hlv-login-form">
                                <label>Database</label>
                                <input id="hlv_db" type="text" t-att-value="default_db" placeholder="e.g., odoo_db" class="hlv-input"/>

                                <label>Username</label>
                                <input id="hlv_login" type="text" t-att-value="default_login" placeholder="e.g., admin" class="hlv-input"/>

                                <label>Password</label>
                                <input id="hlv_password" type="password" placeholder="••••••" class="hlv-input"/>

                                <button id="hlv_btn_login" class="hlv-btn hlv-btn-primary hlv-btn-large">
                                    Đăng Nhập
                                </button>
                                <div id="hlv_login_error" class="hlv-error-msg" style="display: none;"></div>
                            </div>
                        </div>
                    </div>

                    <!-- SCREEN 2: WORKFLOW SELECTOR SCREEN -->
                    <div id="workflow-screen" class="hlv-screen">
                        <div class="hlv-screen-header">
                            <button class="hlv-btn-back" id="hlv_btn_back_workflow">← Đăng Xuất</button>
                            <h2>Chọn Tác Vụ</h2>
                        </div>
                        <div class="hlv-screen-body">
                            <div class="hlv-workflow-grid">
                                <div class="hlv-workflow-card" data-workflow="picking">
                                    <div class="hlv-workflow-icon">📦</div>
                                    <div class="hlv-workflow-name">Lấy Hàng</div>
                                    <div class="hlv-workflow-sub">Picking</div>
                                </div>
                                <div class="hlv-workflow-card" data-workflow="receiving">
                                    <div class="hlv-workflow-icon">📥</div>
                                    <div class="hlv-workflow-name">Nhận Hàng</div>
                                    <div class="hlv-workflow-sub">Receiving</div>
                                </div>
                                <div class="hlv-workflow-card" data-workflow="transfer">
                                    <div class="hlv-workflow-icon">🔄</div>
                                    <div class="hlv-workflow-name">Chuyển Kho</div>
                                    <div class="hlv-workflow-sub">Transfer</div>
                                </div>
                                <div class="hlv-workflow-card" data-workflow="product_locator">
                                    <div class="hlv-workflow-icon">🔍</div>
                                    <div class="hlv-workflow-name">Vị Trí Sản Phẩm</div>
                                    <div class="hlv-workflow-sub">Locator</div>
                                </div>
                                <div class="hlv-workflow-card" data-workflow="shipment">
                                    <div class="hlv-workflow-icon">📬</div>
                                    <div class="hlv-workflow-name">Quét Kiện</div>
                                    <div class="hlv-workflow-sub">Shipment</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- SCREEN 3: SLIP/ORDER SCAN SCREEN -->
                    <div id="slip-scan-screen" class="hlv-screen">
                        <div class="hlv-screen-header">
                            <button class="hlv-btn-back" id="hlv_btn_back_slip">← Quay Lại</button>
                            <h2 id="hlv_slip_title">Quét Phiếu</h2>
                        </div>
                        <div class="hlv-screen-body">
                            <div class="hlv-scan-section">
                                <div class="hlv-camera-preview">SCAN ZONE</div>
                                <input id="hlv_slip_scan_input" type="text" placeholder="Quét SO / PO / Shipment ID..." class="hlv-scan-input" autocomplete="off"/>
                                <button id="hlv_btn_slip_scan" class="hlv-btn hlv-btn-primary">Quét</button>
                            </div>
                            <div id="hlv_slip_preview" class="hlv-slip-preview" style="display: none;">
                                <div class="hlv-slip-header">
                                    <div class="hlv-slip-id"><strong id="hlv_slip_id_display">SO-001</strong></div>
                                    <div class="hlv-slip-status" id="hlv_slip_status_display">pending</div>
                                </div>
                                <div class="hlv-slip-items">
                                    <div class="hlv-slip-count">
                                        <span id="hlv_slip_item_count">5</span> items
                                    </div>
                                </div>
                                <button id="hlv_btn_continue_detail" class="hlv-btn hlv-btn-success">Tiếp Tục Quét Chi Tiết →</button>
                            </div>
                        </div>
                    </div>

                    <!-- SCREEN 4: DETAIL SCAN SCREEN (Product Scanning) -->
                    <div id="detail-scan-screen" class="hlv-screen">
                        <div class="hlv-screen-header">
                            <button class="hlv-btn-back" id="hlv_btn_back_detail">← Quay Lại</button>
                            <div>
                                <h2 id="hlv_detail_title">Quét Chi Tiết</h2>
                                <div class="hlv-detail-progress">
                                    <span id="hlv_detail_scanned">0</span> / <span id="hlv_detail_required">5</span> items
                                </div>
                            </div>
                        </div>
                        <div class="hlv-screen-body">
                            <div class="hlv-scan-section">
                                <div class="hlv-camera-preview">SCAN ZONE</div>
                                <input id="hlv_detail_scan_input" type="text" placeholder="Quét mã vạch sản phẩm..." class="hlv-scan-input" autocomplete="off"/>
                                <button id="hlv_btn_detail_scan" class="hlv-btn hlv-btn-primary">Quét</button>
                            </div>
                            <div id="hlv_detail_cards" class="hlv-detail-cards"></div>
                            <div class="hlv-detail-actions">
                                <button id="hlv_btn_clear_staging" class="hlv-btn hlv-btn-secondary">Xoá Tất Cả</button>
                                <button id="hlv_btn_confirm_detail" class="hlv-btn hlv-btn-success">Xác Nhận →</button>
                            </div>
                        </div>
                    </div>

                    <!-- SCREEN 5: CONFIRMATION SCREEN -->
                    <div id="confirm-screen" class="hlv-screen">
                        <div class="hlv-screen-header">
                            <button class="hlv-btn-back" id="hlv_btn_back_confirm">← Quay Lại</button>
                            <h2>Xác Nhận</h2>
                        </div>
                        <div class="hlv-screen-body">
                            <div class="hlv-confirm-section">
                                <h3>Thông Tin Phiếu</h3>
                                <div class="hlv-confirm-detail">
                                    <div class="hlv-detail-row">
                                        <span>Phiếu ID:</span>
                                        <strong id="hlv_confirm_slip_id">SO-001</strong>
                                    </div>
                                    <div class="hlv-detail-row">
                                        <span>Công Việc:</span>
                                        <strong id="hlv_confirm_workflow">Picking</strong>
                                    </div>
                                    <div class="hlv-detail-row">
                                        <span>Tổng Items:</span>
                                        <strong id="hlv_confirm_item_count">5</strong>
                                    </div>
                                </div>

                                <h3>Chi Tiết Quét</h3>
                                <div id="hlv_confirm_items" class="hlv-confirm-items"></div>

                                <h3>Payload JSON</h3>
                                <details class="hlv-collapse">
                                    <summary>Xem Payload</summary>
                                    <pre id="hlv_confirm_payload" class="hlv-payload-preview">{}</pre>
                                </details>
                            </div>
                            <div class="hlv-confirm-actions">
                                <button id="hlv_btn_cancel_confirm" class="hlv-btn hlv-btn-secondary">Huỷ Bỏ</button>
                                <button id="hlv_btn_submit_confirm" class="hlv-btn hlv-btn-success hlv-btn-large">Xác Nhận Gửi</button>
                            </div>
                            <div id="hlv_confirm_error" class="hlv-error-msg" style="display: none;"></div>
                        </div>
                    </div>

                    <!-- SCREEN 6: SUCCESS/RESULT SCREEN -->
                    <div id="result-screen" class="hlv-screen">
                        <div class="hlv-screen-body hlv-screen-body-center">
                            <div class="hlv-result-box">
                                <div class="hlv-result-icon" id="hlv_result_icon">✓</div>
                                <h2 id="hlv_result_title">Thành Công!</h2>
                                <p id="hlv_result_msg">5 items confirmed</p>
                                <div class="hlv-result-details" id="hlv_result_details"></div>
                            </div>
                            <div class="hlv-result-actions">
                                <button id="hlv_btn_scan_again" class="hlv-btn hlv-btn-primary">Quét Tiếp</button>
                                <button id="hlv_btn_logout" class="hlv-btn hlv-btn-secondary">Đăng Xuất</button>
                            </div>
                        </div>
                    </div>

                </div>

                <script src="/hlv_mobile_barcode_lite/static/src/js/app.js?v=20260419"></script>
            </body>
        </html>
    </template>
</odoo>
