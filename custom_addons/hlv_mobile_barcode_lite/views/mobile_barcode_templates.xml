<odoo>
    <template id="mobile_barcode_lite_page" name="Mobile Barcode Lite">
        <html>
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>Barcode Mobile App</title>
                <link rel="stylesheet" href="/hlv_mobile_barcode_lite/static/src/css/mobile_barcode.css"/>
            </head>
            <body class="hlv-mobile-wrap">
                <div class="hlv-phone-shell">
                    <header class="hlv-appbar">
                        <div class="hlv-appbar-left">
                            <div class="hlv-hamburger"></div>
                            <strong>LogiPrecision</strong>
                        </div>
                        <div class="hlv-avatar">W</div>
                    </header>

                    <section class="hlv-auth-sheet">
                        <div class="hlv-auth-grid">
                            <input id="hlv_db" type="text" t-att-value="default_db" placeholder="Database"/>
                            <input id="hlv_login" type="text" t-att-value="default_login" placeholder="Login"/>
                            <input id="hlv_password" type="password" placeholder="Password"/>
                            <input id="hlv_mode" type="text" value="prod" placeholder="Mode"/>
                        </div>
                    </section>

                    <section class="hlv-scan-hero">
                        <div class="hlv-camera-preview">SCAN ZONE</div>
                        <div class="hlv-scan-input-row">
                            <input id="hlv_scan_input" type="text" placeholder="Quet ma (SO/PO/SP/Location/Shipment)" autocomplete="off"/>
                            <button id="hlv_scan_btn">Scan</button>
                        </div>
                        <div class="hlv-scan-meta">
                            <span id="hlv_scan_hint">Che do Lay hang: quet SO ID truoc.</span>
                            <span id="hlv_scan_last">Last scan: -</span>
                        </div>
                    </section>

                    <nav class="hlv-tabbar" id="hlv_tabs">
                        <button class="active" data-tab="picking">Lay hang</button>
                        <button data-tab="receiving">Nhan hang</button>
                        <button data-tab="transfer">Chuyen kho</button>
                        <button data-tab="product_locator">Vi tri SP</button>
                        <button data-tab="shipment_scan">Quet kien</button>
                    </nav>

                    <main class="hlv-main">
                        <section class="hlv-panel active" data-panel="picking">
                            <div class="hlv-panel-title">Phieu lay hang</div>
                            <div class="hlv-chip-row">
                                <input id="hlv_so_id" type="number" placeholder="SO ID"/>
                                <button data-action="listSaleLines">Tai line</button>
                                <button data-action="doPicking" class="hlv-btn-primary">Xac nhan</button>
                            </div>
                        </section>

                        <section class="hlv-panel" data-panel="receiving">
                            <div class="hlv-panel-title">Phieu nhan hang</div>
                            <div class="hlv-chip-row">
                                <input id="hlv_po_id" type="number" placeholder="PO ID"/>
                                <button data-action="listPurchaseLines">Tai line</button>
                                <button data-action="doReceiving" class="hlv-btn-primary">Xac nhan</button>
                            </div>
                        </section>

                        <section class="hlv-panel" data-panel="transfer">
                            <div class="hlv-panel-title">Chuyen kho noi bo</div>
                            <div class="hlv-transfer-grid">
                                <input id="hlv_src_wh_name" type="text" placeholder="Kho nguon"/>
                                <input id="hlv_dst_wh_name" type="text" placeholder="Kho dich"/>
                                <input id="hlv_transfer_source" type="number" placeholder="Source location"/>
                                <input id="hlv_transfer_destination" type="number" placeholder="Destination location"/>
                            </div>
                            <div class="hlv-chip-row">
                                <button data-action="setSourceFromScan">Gan source tu scan</button>
                                <button data-action="setDestinationFromScan">Gan dich tu scan</button>
                                <button data-action="doTransfer" class="hlv-btn-primary">Chuyen kho</button>
                            </div>
                        </section>

                        <section class="hlv-panel" data-panel="product_locator">
                            <div class="hlv-panel-title">Tra vi tri san pham</div>
                            <div class="hlv-transfer-grid">
                                <input id="hlv_inventory_product_code" type="text" placeholder="Product barcode"/>
                                <input id="hlv_inventory_location_name" type="text" placeholder="Ten location"/>
                                <input id="hlv_location_barcode" type="text" placeholder="Scan location"/>
                                <input id="hlv_location_wh_name" type="text" placeholder="Warehouse filter"/>
                            </div>
                            <div class="hlv-chip-row">
                                <button data-action="scanProducts">Thong tin SP</button>
                                <button data-action="inventoryByLocation">Ton theo vi tri</button>
                                <button data-action="scanLocation">Tim vi tri</button>
                            </div>
                        </section>

                        <section class="hlv-panel" data-panel="shipment_scan">
                            <div class="hlv-panel-title">Quet kien hang</div>
                            <div class="hlv-transfer-grid">
                                <input id="hlv_shipment_so_id" type="number" placeholder="SO ID"/>
                                <input id="hlv_shipment_name" type="text" placeholder="Shipment code"/>
                            </div>
                            <div class="hlv-chip-row">
                                <button data-action="listShipments">Chi tiet kien</button>
                                <button data-action="finderSearch">Finder search</button>
                            </div>
                        </section>

                        <section class="hlv-stage-card">
                            <div class="hlv-section-head">
                                <strong>Danh sach quet</strong>
                                <button id="hlv_clear_stage">Clear</button>
                            </div>
                            <div id="hlv_stage_cards" class="hlv-stage-cards"></div>
                            <pre id="hlv_stage_preview" class="hlv-hidden">{}</pre>
                        </section>

                        <details class="hlv-advanced">
                            <summary>Advanced payload</summary>
                            <textarea id="hlv_picking_lines">[{"normal":[{"product_id":1,"qty_done":1}]}]</textarea>
                            <textarea id="hlv_receiving_lines">[{"normal":[{"product_id":1,"qty_done":1,"expiry_date":""}]}]</textarea>
                            <textarea id="hlv_transfer_lines">[{"product_code":"123456789","lot_or_serial":"none","lot_serial":"","quantity":1,"note":""}]</textarea>
                            <input id="hlv_product_codes" type="text" placeholder="code1,code2"/>
                            <textarea id="hlv_finder_payload">{"items":[],"criteria":{"is_and":true,"criteria":[]}}</textarea>
                        </details>

                        <section class="hlv-console-card">
                            <div class="hlv-section-head">
                                <strong>Ket qua</strong>
                                <button id="hlv_clear_output">Xoa</button>
                            </div>
                            <pre id="hlv_output">Ready.</pre>
                        </section>
                    </main>
                </div>
                <script type="text/javascript" src="/hlv_mobile_barcode_lite/static/src/js/mobile_barcode.js"></script>
            </body>
        </html>
    </template>
</odoo>
