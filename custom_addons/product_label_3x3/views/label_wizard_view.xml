<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_label_wizard_form" model="ir.ui.view">
        <field name="name">product.template.label.wizard.form</field>
        <field name="model">product.template.label.wizard</field>
        <field name="arch" type="xml">
            <form string="In Tem Sản Phẩm 3x3">
                <group>
                    <group>
                        <field name="print_type" widget="radio"/>
                        <field name="qty_per_product"/>
                    </group>
                </group>
                <group string="Danh sách sản phẩm">
                    <field name="product_tmpl_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_print_labels" string="In Tem" type="object" class="btn-primary"/>
                    <button string="Hủy bỏ" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_product_template_label_wizard" model="ir.actions.act_window">
        <field name="name">In Tem 3x3 (35x22mm)</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.template.label.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
    </record>
</odoo>
