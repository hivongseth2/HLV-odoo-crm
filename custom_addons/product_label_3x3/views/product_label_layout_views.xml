<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_label_layout_form_3x3" model="ir.ui.view">
        <field name="name">product.label.layout.form.3x3</field>
        <field name="model">product.label.layout</field>
        <field name="inherit_id" ref="product.product_label_layout_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='print_format']" position="after">
                <field name="print_type" widget="radio" attrs="{'invisible': [('print_format', '!=', '3x3_35x22')]}"/>
            </xpath>
        </field>
    </record>
</odoo>
