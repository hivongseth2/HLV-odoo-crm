<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_picking_export_wizard_form" model="ir.ui.view">
    <field name="name">picking.export.wizard.form</field>
    <field name="model">picking.export.wizard</field>
    <field name="arch" type="xml">
      <form string="Xuất Excel lệnh xuất kho">
        <group>
          <group>
            <field name="date_from"/>
            <field name="date_to"/>
          </group>
          <group>
            <field name="warehouse_ids" 
                   widget="many2many_tags"
                   domain="[('company_id','in', allowed_company_ids)]"
                   placeholder="Để trống = Tất cả kho"/>
            <field name="state_filter"/>
          </group>
        </group>

        <footer>
          <button string="Xuất Excel (.xlsx)" type="object" name="action_export" class="btn-primary"/>
          <button string="Xuất JSON" type="object" name="action_export_json" class="btn-secondary"/>
          <button string="Đóng" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <!-- ✅ New View for POS Export -->
  <record id="view_picking_export_pos_wizard_form" model="ir.ui.view">
    <field name="name">picking.export.pos.wizard.form</field>
    <field name="model">picking.export.wizard</field>
    <field name="arch" type="xml">
      <form string="Xuất hóa đơn POS (Excel)">
        <group>
          <group>
            <field name="date_from"/>
            <field name="date_to"/>
          </group>
          <group>
            <field name="warehouse_ids" 
                   widget="many2many_tags"
                   domain="[('company_id','in', allowed_company_ids)]"
                   placeholder="Để trống = Tất cả kho"/>
            <field name="state_filter"/>
          </group>
        </group>

        <footer>
          <button string="Xuất Excel (Mẫu POS)" type="object" name="action_export_pos_template" class="btn-primary"/>
          <button string="Đóng" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>