<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_picking_export_wizard_form" model="ir.ui.view">
    <field name="name">picking.export.wizard.form</field>
    <field name="model">picking.export.wizard</field>
    <field name="arch" type="xml">
      <form string="Xuất Excel lệnh xuất kho">
        <group>
          <group>
            <field name="date_from"/>
            <field name="date_to"/>
          </group>
          <group>
            <field name="warehouse_scope"/>
            <field name="warehouse_ids"
                   domain="[('company_id','in', allowed_company_ids)]"
                   invisible="warehouse_scope == 'all'"
                   required="warehouse_scope == 'some'"/>
          </group>
        </group>

        <group>
          <group>
            <field name="picking_type_id" domain="[('code','=','outgoing')]"/>
          </group>
          <group>
            <field name="state_filter"/>
          </group>
        </group>

        <footer>
          <button string="Xuất Excel" type="object" name="action_export" class="btn-primary"/>
          <button string="Đóng" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
