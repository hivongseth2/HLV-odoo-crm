<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_picking_export_wizard_form" model="ir.ui.view">
    <field name="name">picking.export.wizard.form</field>
    <field name="model">picking.export.wizard</field>
    <field name="arch" type="xml">
      <form string="Xuất Excel lệnh xuất kho">
        <group>
          <field name="date_from"/>
          <field name="date_to"/>
          <field name="picking_type_id"/>
          <field name="state_filter"/>
        </group>
        <footer>
          <button string="Xuất Excel" type="object" name="action_export" class="btn-primary"/>
          <button string="Đóng" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_picking_export_wizard" model="ir.actions.act_window">
    <field name="name">Xuất Excel lệnh xuất kho</field>
    <field name="res_model">picking.export.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
