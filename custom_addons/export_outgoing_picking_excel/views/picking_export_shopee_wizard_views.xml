<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Form View -->
  <record id="view_picking_export_shopee_wizard_form" model="ir.ui.view">
    <field name="name">picking.export.shopee.wizard.form</field>
    <field name="model">picking.export.shopee.wizard</field>
    <field name="arch" type="xml">
      <form string="Xuất lệnh xuất kho Shopee">
        <group>
          <group>
            <field name="date_from"/>
            <field name="date_to"/>
          </group>
          <group>
            <field name="warehouse_ids" 
                   widget="many2many_tags"
                   domain="[('company_id','in', allowed_company_ids)]"
                   placeholder="Để trống = Tất cả kho"/>
            <field name="state_filter"/>
          </group>
        </group>

        <footer>
          <button string="Xuất Excel (.xlsx)" type="object" name="action_export" class="btn-primary"/>
          <button string="Đóng" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <!-- Action -->
  <record id="action_picking_export_shopee_wizard" model="ir.actions.act_window">
    <field name="name">Xuất lệnh xuất kho Shopee</field>
    <field name="res_model">picking.export.shopee.wizard</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="view_picking_export_shopee_wizard_form"/>
    <field name="target">new</field>
  </record>

  <!-- Menu Item -->
  <menuitem id="menu_picking_export_shopee_excel"
            name="Xuất lệnh xuất kho Shopee"
            parent="menu_export_excel_root"
            action="action_picking_export_shopee_wizard"
            sequence="2"/>
</odoo>
