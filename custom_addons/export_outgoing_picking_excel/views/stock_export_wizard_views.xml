<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_stock_export_wizard_form" model="ir.ui.view">
    <field name="name">stock.export.wizard.form</field>
    <field name="model">stock.export.wizard</field>
    <field name="arch" type="xml">
      <form string="Xuất Excel Kho (Nội bộ &amp; Xuất bán)">
        <group>
          <group>
            <field name="date_from"/>
            <field name="date_to"/>
          </group>
          <group>

            <field name="warehouse_ids" 
                   widget="many2many_tags"
                   domain="[('company_id','in', allowed_company_ids)]"
                   placeholder="Để trống = Tất cả kho"/>
            <field name="state_filter"/>
          </group>
        </group>

        <footer>
          <button string="Xuất Excel (Mẫu Xuất Kho)" type="object" name="action_export_stock_template" class="btn-primary"/>
          <button string="Đóng" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_stock_export_wizard" model="ir.actions.act_window">
    <field name="name">Xuất import MISA (xuất kho)</field>
    <field name="res_model">stock.export.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

  <menuitem id="menu_stock_export_wizard"
            name="Xuất import MISA (xuất kho)"
            parent="export_outgoing_picking_excel.menu_export_excel_root"
            action="action_stock_export_wizard"
            sequence="100"/>
</odoo>
