<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Form View cho Purchase Export Wizard -->
  <record id="view_purchase_export_wizard_form" model="ir.ui.view">
    <field name="name">purchase.export.wizard.form</field>
    <field name="model">purchase.export.wizard</field>
    <field name="arch" type="xml">
      <form string="Xuất Excel lệnh mua hàng">
        <group>
          <group>
            <field name="date_from"/>
            <field name="date_to"/>
          </group>
        </group>

        <footer>
          <button string="Xuất Excel" type="object" name="action_export" class="btn-primary"/>
          <button string="Đóng" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <!-- Action cho Purchase Export Wizard -->
  <record id="action_purchase_export_wizard" model="ir.actions.act_window">
    <field name="name">Xuất Excel lệnh mua hàng</field>
    <field name="res_model">purchase.export.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    <field name="binding_model_id" ref="purchase.model_purchase_order"/>
  </record>

  <!-- Menu Item trong Purchase -->
  <menuitem
    id="menu_purchase_export_wizard"
    name="Xuất Excel lệnh mua hàng"
    parent="purchase.menu_purchase_root"
    action="action_purchase_export_wizard"
    sequence="100"/>
</odoo>
