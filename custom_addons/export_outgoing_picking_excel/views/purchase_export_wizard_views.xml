<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Form view cho wizard xuất Excel lệnh mua hàng -->
  <record id="view_purchase_export_wizard_form" model="ir.ui.view">
    <field name="name">purchase.export.wizard.form</field>
    <field name="model">purchase.export.wizard</field>
    <field name="arch" type="xml">
      <form string="Xuất Excel lệnh mua hàng">
        <group>
          <group>
            <field name="date_from"/>
            <field name="date_to"/>
          </group>
        </group>

        <footer>
          <button string="Xuất Excel" type="object" name="action_export" class="btn-primary"/>
          <button string="Đóng" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <!-- Action mở wizard -->
  <record id="action_purchase_export_wizard" model="ir.actions.act_window">
    <field name="name">Xuất lệnh mua hàng (Excel)</field>
    <field name="res_model">purchase.export.wizard</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="view_purchase_export_wizard_form"/>
    <field name="target">new</field>
  </record>

  <!-- Menu item chung với các wizard khác trong Kho hàng > Công cụ Excel -->
  <menuitem id="menu_purchase_export_wizard"
            name="Xuất lệnh mua hàng (Excel)"
            action="action_purchase_export_wizard"
            parent="menu_export_excel_root"
            sequence="3"/>
</odoo>
