<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. WIZARD: CẬP NHẬT DỮ LIỆU (REFRESH) -->
    <record id="view_out_return_report_refresh_wizard_form" model="ir.ui.view">
        <field name="name">out.return.report.refresh.wizard.form</field>
        <field name="model">out.return.report.refresh.wizard</field>
        <field name="arch" type="xml">
            <form string="Cập nhật dữ liệu báo cáo">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="warehouse_ids" 
                               widget="many2many_tags"
                               domain="[('company_id','in', allowed_company_ids)]"
                               placeholder="Để trống = Tất cả kho"/>
                    </group>
                </group>
                <footer>
                    <button string="Cập nhật" type="object" name="action_refresh_data" class="btn-primary"/>
                    <button string="Đóng" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_out_return_report_refresh_wizard" model="ir.actions.act_window">
        <field name="name">Cập nhật dữ liệu</field>
        <field name="res_model">out.return.report.refresh.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


    <!-- 2. WIZARD: XUẤT EXCEL (EXPORT) -->
    <record id="view_out_return_report_export_wizard_form" model="ir.ui.view">
        <field name="name">out.return.report.export.wizard.form</field>
        <field name="model">out.return.report.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Xuất Excel Báo cáo">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <footer>
                    <button string="Xuất Excel" type="object" name="action_export_excel" class="btn-primary"/>
                    <button string="Đóng" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_out_return_report_export_wizard" model="ir.actions.act_window">
        <field name="name">Xuất Excel</field>
        <field name="res_model">out.return.report.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


    <!-- 3. REPORT LIST VIEW (STORED MODEL) -->
    <record id="view_out_return_report_view_list" model="ir.ui.view">
        <field name="name">out.return.report.view.list</field>
        <field name="model">out.return.report.view</field>
        <field name="arch" type="xml">
            <list string="Báo cáo xuất kho và trả hàng" create="false" edit="false" delete="true">
                <header>
                    <button name="%(action_out_return_report_refresh_wizard)d" 
                            string="Cập nhật dữ liệu" 
                            type="action" 
                            class="btn-primary"/>
                    <button name="%(action_out_return_report_export_wizard)d" 
                            string="Xuất Excel" 
                            type="action" 
                            class="btn-secondary"/>
                </header>
                <field name="out_picking_name"/>
                <field name="out_picking_date"/>
                <field name="partner_name"/>
                <field name="out_qty_total" sum="Tổng"/>
                <field name="has_return"/>
                <field name="return_picking_name"/>
                <field name="return_picking_date"/>
                <field name="product_code"/>
                <field name="product_name"/>
                <field name="return_qty" sum="Tổng"/>
            </list>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_out_return_report_view_search" model="ir.ui.view">
        <field name="name">out.return.report.view.search</field>
        <field name="model">out.return.report.view</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm">
                <field name="out_picking_name"/>
                <field name="return_picking_name"/>
                <field name="partner_name"/>
                <field name="product_code"/>
                <field name="product_name"/>
                <filter string="Có trả hàng" name="has_return" domain="[('has_return', '=', True)]"/>
                <separator/>
                <filter string="Tháng này" name="this_month" domain="[
                    ('out_picking_date', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d')),
                    ('out_picking_date', '&lt;=', (context_today() + relativedelta(day=1, months=1, days=-1)).strftime('%Y-%m-%d'))
                ]"/>
                <group expand="0" string="Group By">
                    <filter string="Khách hàng" name="group_partner" context="{'group_by': 'partner_name'}"/>
                    <filter string="Ngày xuất" name="group_date" context="{'group_by': 'out_picking_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACTION MENU -->
    <record id="action_out_return_report_view" model="ir.actions.act_window">
        <field name="name">Báo cáo xuất kho và trả hàng</field>
        <field name="res_model">out.return.report.view</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_out_return_report_view_search"/>
        <field name="context">{'search_default_has_return': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có dữ liệu báo cáo.
            </p>
            <p>
                Nhấn vào nút "Cập nhật dữ liệu" để tải báo cáo mới nhất.
            </p>
        </field>
    </record>

    <!-- MENU ITEM -->
    <menuitem id="menu_out_return_report"
              name="Báo cáo xuất kho và trả hàng"
              parent="sale.menu_sale_report"
              action="action_out_return_report_view"
              sequence="100"/>
</odoo>

