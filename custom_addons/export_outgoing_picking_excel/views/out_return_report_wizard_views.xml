<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View for Report Lines -->
    <record id="view_out_return_report_line_list" model="ir.ui.view">
        <field name="name">out.return.report.line.list</field>
        <field name="model">out.return.report.line</field>
        <field name="arch" type="xml">
            <list string="Báo cáo xuất kho và trả hàng" create="false" edit="false">
                <header>
                    <button name="action_open_export_wizard" type="object" string="Xuất Excel" class="btn-primary"/>
                </header>
                <field name="out_picking_name" string="Mã phiếu xuất"/>
                <field name="out_picking_origin" string="Mã báo giá"/>
                <field name="out_picking_date" string="Ngày xuất"/>
                <field name="partner_name" string="Khách hàng"/>
                <field name="return_picking_name" string="Mã phiếu trả"/>
                <field name="return_picking_date" string="Ngày trả"/>
                <field name="product_code" string="Mã SP"/>
                <field name="product_name" string="Tên SP"/>
                <field name="product_uom" string="ĐVT"/>
                <field name="out_qty" string="SL xuất"/>
                <field name="return_qty" string="SL trả" sum="Tổng"/>
            </list>
        </field>
    </record>

    <!-- Search View for Report Lines -->
    <record id="view_out_return_report_line_search" model="ir.ui.view">
        <field name="name">out.return.report.line.search</field>
        <field name="model">out.return.report.line</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm báo cáo">
                <field name="out_picking_name" string="Mã phiếu xuất"/>
                <field name="out_picking_origin" string="Mã báo giá"/>
                <field name="partner_name" string="Khách hàng"/>
                <field name="return_picking_name" string="Mã phiếu trả"/>
                <field name="product_code" string="Mã SP"/>
                <field name="product_name" string="Tên SP"/>
                <filter name="filter_has_return" string="Có trả hàng" domain="[('has_return', '=', True)]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_out_picking" string="Phiếu xuất" context="{'group_by': 'out_picking_id'}"/>
                    <filter name="group_return_picking" string="Phiếu trả" context="{'group_by': 'return_picking_id'}"/>
                    <filter name="group_partner" string="Khách hàng" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_product" string="Sản phẩm" context="{'group_by': 'product_id'}"/>
                    <filter name="group_out_date" string="Ngày xuất" context="{'group_by': 'out_picking_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action for List View (Main menu action) -->
    <record id="action_out_return_report_line_list" model="ir.actions.act_window">
        <field name="name">Báo cáo xuất kho và trả hàng</field>
        <field name="res_model">out.return.report.line</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_out_return_report_line_search"/>
        <field name="context">{'search_default_filter_has_return': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có dữ liệu báo cáo
            </p>
            <p>
                Dữ liệu sẽ được tự động cập nhật hàng ngày hoặc bạn có thể chạy thủ công qua Scheduled Actions.
            </p>
        </field>
    </record>

    <!-- Form View for Export Wizard -->
    <record id="view_out_return_report_wizard_form" model="ir.ui.view">
        <field name="name">out.return.report.wizard.form</field>
        <field name="model">out.return.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Xuất Excel báo cáo">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="warehouse_ids" 
                               widget="many2many_tags"
                               domain="[('company_id','in', allowed_company_ids)]"
                               placeholder="Để trống = Tất cả kho"/>
                    </group>
                </group>
                <footer>
                    <button string="Xuất Excel" type="object" name="action_export_excel" class="btn-primary"/>
                    <button string="Đóng" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action for Export Wizard -->
    <record id="action_out_return_report_wizard" model="ir.actions.act_window">
        <field name="name">Xuất Excel báo cáo</field>
        <field name="res_model">out.return.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu under Sale > Reporting - Now links to List View -->
    <menuitem id="menu_out_return_report"
              name="Báo cáo xuất kho và trả hàng"
              parent="sale.menu_sale_report"
              action="action_out_return_report_line_list"
              sequence="100"/>

    <!-- Cron Job to update report data daily -->
    <record id="ir_cron_update_out_return_report" model="ir.cron">
        <field name="name">Cập nhật báo cáo xuất kho và trả hàng</field>
        <field name="model_id" ref="model_out_return_report_line"/>
        <field name="state">code</field>
        <field name="code">model._cron_update_report_data()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
