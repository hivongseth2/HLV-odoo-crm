    <!-- (Giữ) Server Action: sẽ xuất hiện trong Action menu khi ở list hoặc form -->
    <record id="action_server_open_export_wizard" model="ir.actions.server">
      <field name="name">Xuất Excel lệnh xuất kho</field>
      <field name="model_id" ref="stock.model_stock_picking"/>
      <field name="binding_model_id" ref="stock.model_stock_picking"/>
      <field name="binding_type">action</field>
      <field name="state">code</field>
      <field name="code">action = env.ref('export_outgoing_picking_excel.action_picking_export_wizard').read()[0]</field>
    </record>
  
    <!-- ✅ Menu riêng dưới "Báo cáo" (không cần chọn dòng, mở wizard trực tiếp) -->
    <menuitem id="menu_export_excel_root"
              name="Công cụ Excel"
              parent="stock.menu_stock_root"
              sequence="98"/>
    <menuitem id="menu_export_outgoing_picking_excel"
              name="Xuất lệnh xuất kho (Excel)"
              parent="menu_export_excel_root"
              action="action_picking_export_wizard"
              sequence="1"/>
