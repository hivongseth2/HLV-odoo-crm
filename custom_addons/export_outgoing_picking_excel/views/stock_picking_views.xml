<odoo>
    <!-- ✅ Action mở wizard -->
    <record id="action_picking_export_wizard" model="ir.actions.act_window">
      <field name="name">Xuất lệnh xuất kho (Excel)</field>
      <field name="res_model">picking.export.wizard</field>
      <field name="view_mode">form</field>
      <field name="view_id" ref="export_outgoing_picking_excel.view_picking_export_wizard_form"/>
      <field name="target">new</field>
    </record>
  
    <!-- ✅ Action báo cáo tồn kho -->
    <record id="action_inventory_report_wizard" model="ir.actions.act_window">
      <field name="name">Báo cáo tồn kho (Excel)</field>
      <field name="res_model">inventory.report.wizard</field>
      <field name="view_mode">form</field>
      <field name="view_id" ref="export_outgoing_picking_excel.view_inventory_report_wizard_form"/>
      <field name="target">new</field>
    </record>
  
    <!-- ✅ Menu mở wizard trực tiếp -->
    <menuitem id="menu_export_excel_root"
              name="Công cụ Excel"
              parent="stock.menu_stock_root"
              sequence="98"/>
    <menuitem id="menu_export_outgoing_picking_excel"
              name="Xuất lệnh xuất kho (Excel)"
              parent="menu_export_excel_root"
              action="action_picking_export_wizard"
              sequence="1"/>
    
    <!-- ✅ New Action & Menu for Sales Report Export -->
    <record id="action_picking_export_sales_report_wizard" model="ir.actions.act_window">
      <field name="name">Báo cáo bán hàng (Excel)</field>
      <field name="res_model">picking.export.sales.report.wizard</field>
      <field name="view_mode">form</field>
      <field name="view_id" ref="export_outgoing_picking_excel.view_picking_export_sales_report_wizard_form"/>
      <field name="target">new</field>
    </record>

    <menuitem id="menu_export_sales_report_excel"
              name="Báo cáo bán hàng (Excel)"
              parent="menu_export_excel_root"
              action="action_picking_export_sales_report_wizard"
              sequence="2"/>
              
    <!-- ✅ New Action & Menu for POS Export -->
    <record id="action_picking_export_pos_wizard" model="ir.actions.act_window">
      <field name="name">Xuất đơn hàng POS (Excel)</field>
      <field name="res_model">picking.export.wizard</field>
      <field name="view_mode">form</field>
      <field name="view_id" ref="export_outgoing_picking_excel.view_picking_export_pos_wizard_form"/>
      <field name="target">new</field>
    </record>

    <menuitem id="menu_export_pos_excel"
              name="Xuất đơn hàng POS (Excel)"
              parent="menu_export_excel_root"
              action="action_picking_export_pos_wizard"
              sequence="3"/>

    <!-- ✅ New Action & Menu for POS CRM Export -->
    <record id="action_picking_export_pos_crm_wizard" model="ir.actions.act_window">
      <field name="name">Xuất đơn hàng POS CRM (Excel)</field>
      <field name="res_model">picking.export.wizard</field>
      <field name="view_mode">form</field>
      <field name="view_id" ref="export_outgoing_picking_excel.view_picking_export_pos_crm_wizard_form"/>
      <field name="target">new</field>
    </record>

    <menuitem id="menu_export_pos_crm_excel"
              name="Xuất đơn hàng POS CRM (Excel)"
              parent="menu_export_excel_root"
              action="action_picking_export_pos_crm_wizard"
              sequence="4"/>

    <menuitem id="menu_inventory_report_excel"

              name="Báo cáo tồn kho (Excel)"
              parent="menu_export_excel_root"
              action="action_inventory_report_wizard"
              sequence="2"/>
  </odoo>
  