<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_inventory_report_wizard_form" model="ir.ui.view">
    <field name="name">inventory.report.wizard.form</field>
    <field name="model">inventory.report.wizard</field>
    <field name="arch" type="xml">
      <form string="Báo cáo tồn kho Excel">
        <group>
          <group>
            <field name="report_date"/>
          </group>
          <group>
            <field name="warehouse_ids" 
                   widget="many2many_tags"
                   domain="[('company_id','in', allowed_company_ids)]"
                   placeholder="Để trống = Tất cả kho"/>
          </group>
        </group>

        <separator string="Thông tin báo cáo"/>
        <div class="alert alert-info" role="alert">
          <p><strong>Báo cáo sẽ hiển thị:</strong></p>
          <ul>
            <li>Tồn kho đầu ngày (0h của ngày đã chọn)</li>
            <li>Số lượng xuất kho từ 0h đến thời điểm xuất file</li>
            <li>Tồn kho hiện tại (tại thời điểm xuất file)</li>
            <li>Chi tiết đơn hàng (có thể click để xem chi tiết)</li>
          </ul>
        </div>

        <footer>
          <button string="Xuất Excel" type="object" name="action_export" class="btn-primary"/>
          <button string="Đóng" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
