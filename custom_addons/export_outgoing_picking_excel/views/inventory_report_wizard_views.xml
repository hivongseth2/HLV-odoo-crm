<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_inventory_report_wizard_form" model="ir.ui.view">
    <field name="name">inventory.report.wizard.form</field>
    <field name="model">inventory.report.wizard</field>
    <field name="arch" type="xml">
      <form string="Báo cáo tồn kho Excel">
        <group>
          <group>
            <field name="report_date"/>
          </group>
          <group>
            <field name="warehouse_ids" 
                   widget="many2many_tags"
                   domain="[('company_id','in', allowed_company_ids)]"
                   placeholder="Để trống = Tất cả kho"/>
          </group>
        </group>

        <separator string="Thông tin báo cáo"/>
        <div class="alert alert-info" role="alert">
          <p><strong>Báo cáo sẽ hiển thị:</strong></p>
          <ul>
            <li><strong>Tồn đầu ngày (0h)</strong> - Số lượng tồn kho lúc 0h của ngày đã chọn</li>
            <li><strong>Số lượng nhập</strong> - Tổng nhập từ tất cả nguồn (nhập từ NCC, trả hàng, chuyển kho, v.v.)</li>
            <li><strong>Số lượng xuất</strong> - Tổng xuất cho khách hàng trong ngày</li>
            <li><strong>Tồn hiện tại</strong> - Số lượng tồn tại thời điểm xuất báo cáo</li>
            <li><strong>Chi tiết đơn xuất</strong> - Danh sách mã đơn xuất kho</li>
          </ul>
          <p class="mt-2"><em>Công thức: Tồn đầu + Nhập - Xuất = Tồn cuối</em></p>
        </div>

        <footer>
          <button string="Xuất Excel" type="object" name="action_export" class="btn-primary"/>
          <button string="Đóng" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
