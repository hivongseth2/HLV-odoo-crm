<odoo>
  <!-- Tree view: liệt kê video đã quay -->
  <record id="view_packaging_video_tree" model="ir.ui.view">
    <field name="name">warehouse.video.packaging.tree</field>
    <field name="model">warehouse.video.packaging</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="video_state"/>
        <field name="video_url"/>
        <field name="create_date"/>
      </tree>
    </field>
  </record>

  <!-- Form view: chi tiết 1 video -->
  <record id="view_packaging_video_form" model="ir.ui.view">
    <field name="name">warehouse.video.packaging.form</field>
    <field name="model">warehouse.video.packaging</field>
    <field name="arch" type="xml">
      <form>
        <group>
          <field name="name"/>
          <field name="video_state" readonly="1"/>
          <field name="video_url" readonly="1"/>
        </group>
      </form>
    </field>
  </record>

  <!-- Action mở danh sách video -->
  <record id="action_packaging_video_list" model="ir.actions.act_window">
    <field name="name">Video Đóng Hàng</field>
    <field name="res_model">warehouse.video.packaging</field>
    <field name="view_mode">tree,form</field>
    <field name="target">current</field>
  </record>

  <!-- Menu hiển thị -->
  <menuitem id="menu_packaging_video_root"
            name="Video Đóng Hàng"
            parent="stock.menu_stock_root"
            sequence="999"
            action="action_packaging_video_list"/>
</odoo>
