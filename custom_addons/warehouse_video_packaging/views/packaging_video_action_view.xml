<odoo>
  <!-- Tree view: list all videos -->
  <record id="view_stock_picking_video_tree_custom" model="ir.ui.view">
    <field name="name">stock.picking.video.tree.custom</field>
    <field name="model">stock.picking</field>
    <field name="arch" type="xml">
      <tree string="Video Đóng Gói">
        <field name="name"/>
        <field name="video_file_name"/>
        <field name="video_state"/>
        <field name="video_url"/>
        <field name="create_date"/>
      </tree>
    </field>
  </record>

  <!-- Form view: show video info -->
  <record id="view_stock_picking_video_form_custom" model="ir.ui.view">
    <field name="name">stock.picking.video.form.custom</field>
    <field name="model">stock.picking</field>
    <field name="arch" type="xml">
      <form string="Chi Tiết Video">
        <sheet>
          <group>
            <field name="name"/>
            <field name="video_file_name"/>
            <field name="video_state"/>
            <field name="video_url"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Action mở list -->
  <record id="action_stock_picking_video_list_custom" model="ir.actions.act_window">
    <field name="name">Quản Lý Video Đóng Hàng</field>
    <field name="res_model">stock.picking</field>
    <field name="view_mode">tree,form</field>
    <field name="view_id" ref="view_stock_picking_video_tree_custom"/>
    <field name="target">current</field>
  </record>

  <!-- Menu -->
  <menuitem
    id="menu_stock_picking_video_root_custom"
    name="Video Đóng Gói Hàng"
    parent="stock.menu_stock_root"
    action="action_stock_picking_video_list_custom"
  />
</odoo>
