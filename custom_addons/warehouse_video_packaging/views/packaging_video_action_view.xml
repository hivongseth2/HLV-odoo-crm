
<odoo>
<!-- list -->
  <record id="view_warehouse_video_session_list" model="ir.ui.view">
    <field name="name">warehouse.video.session.list</field>
    <field name="model">warehouse.video.session</field>
    <field name="arch" type="xml">
      <list string="Sessions">
        <field name="barcode"/>
        <field name="state"/>
        <field name="file_name"/>
        <field name="file_url"/>
        <field name="start_time"/>
        <field name="end_time"/>
      </list>
    </field>
  </record>
<!-- form -->
<record id="view_warehouse_video_session_form" model="ir.ui.view">
  <field name="name">warehouse.video.session.form</field>
  <field name="model">warehouse.video.session</field>
  <field name="arch" type="xml">
    <form string="Session Detail">
      <sheet>
        <group>
          <field name="barcode"/>
          <field name="state"/>
          <field name="file_name"/>
          <field name="file_url"/>
          <field name="start_time"/>
          <field name="end_time"/>
        </group>
        <!-- ✅ Footer PHẢI NẰM TRONG sheet -->
        <footer>
          <button name="start_recording_button" type="object"
                  string="Bắt đầu quay" class="btn-primary"
                  invisible="state != 'idle'"/>

          <button name="stop_recording_button" type="object"
                  string="Dừng quay" class="btn-danger"
                  invisible="state != 'recording'"/>

        </footer>
      </sheet>
    </form>
  </field>
</record>

  <!--  -->

<record id="action_warehouse_video_session" model="ir.actions.act_window">
  <field name="name">Video Đóng Gói</field>
  <field name="res_model">warehouse.video.session</field>
  <field name="view_mode">list,form</field>
</record>

<menuitem
  id="menu_warehouse_video_session"
  name="Video Đóng Gói"
  parent="stock.menu_stock_root"
   sequence="99"
  action="action_warehouse_video_session"/>

</odoo>
