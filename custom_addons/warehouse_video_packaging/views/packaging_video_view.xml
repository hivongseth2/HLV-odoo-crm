<odoo>
  <record id="view_stock_picking_form_inherit_video" model="ir.ui.view">
    <field name="name">stock.picking.form.video.inherit</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_form"/>
    <field name="arch" type="xml">
      <xpath expr="//form/sheet/notebook" position="inside">
        <page string="Packaging Video">
          <group>
            <field name="video_state" readonly="1"/>
            <field name="video_path" readonly="1"/>
          </group>
        </page>
      </xpath>
    </field>
  </record>
</odoo>