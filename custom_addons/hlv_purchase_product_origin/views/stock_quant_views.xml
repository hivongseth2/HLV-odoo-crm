<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_quant_tree_product_origin" model="ir.ui.view">
        <field name="name">stock.quant.list.product.origin</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_id']" position="after">
                <field name="origin_country_id"
                       string="Xuất xứ"
                       readonly="1"
                       optional="show"
                       groups="stock.group_production_lot"/>
            </xpath>
        </field>
    </record>

    <record id="stock_quant_search_product_origin" model="ir.ui.view">
        <field name="name">stock.quant.search.product.origin</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.quant_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_id']" position="after">
                <field name="origin_country_id" string="Xuất xứ"/>
            </xpath>
            <xpath expr="//filter[@name='productgroup']" position="after">
                <filter name="groupby_origin_country"
                        string="Xuất xứ"
                        context="{'group_by': 'origin_country_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
