<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_product_origin" model="ir.ui.view">
        <field name="name">purchase.order.form.product.origin</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="before">
                <field name="line_number" string="STT" readonly="1" width="50px"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="after">
                <field name="origin_country_id"
                       string="Xuất xứ"
                       optional="show"
                       readonly="state in ('purchase', 'to approve', 'done', 'cancel') or is_downpayment"
                       options="{'no_create': True, 'no_open': True}"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='product_id']" position="after">
                <field name="origin_country_id"
                       string="Xuất xứ"
                       readonly="state in ('purchase', 'to approve', 'done', 'cancel') or is_downpayment"
                       options="{'no_create': True, 'no_open': True}"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_line_tree_product_origin" model="ir.ui.view">
        <field name="name">purchase.order.line.list.product.origin</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="before">
                <field name="line_number" string="STT" readonly="1" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="origin_country_id" string="Xuất xứ" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
