<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_product_origin"
              inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_line_number" class="text-center">
                <strong>STT</strong>
            </th>
        </xpath>
        <xpath expr="//th[@name='th_description']" position="after">
            <th name="th_origin_country" class="text-start">
                <strong>Xuất xứ</strong>
            </th>
        </xpath>
        <xpath expr="//td[@id='product']" position="before">
            <td class="text-center">
                <span t-field="line.line_number"/>
            </td>
        </xpath>
        <xpath expr="//td[@id='product']" position="after">
            <td class="text-start">
                <span t-field="line.origin_country_id"/>
            </td>
        </xpath>
    </template>
</odoo>
