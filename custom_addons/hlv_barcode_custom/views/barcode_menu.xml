<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Client Action for the Barcode App -->
    <record id="action_hlv_barcode_custom_app" model="ir.actions.client">
        <field name="name">HLV Barcode</field>
        <field name="tag">hlv_barcode_custom_app</field>
        <field name="target">fullscreen</field>
