    <!-- Root Menu -->
    <menuitem id="menu_hlv_barcode_custom_root"
              name="HLV Barcode"
              action="action_hlv_barcode_custom_app"
              web_icon="hlv_barcode_custom,static/description/icon.png"
              sequence="5"
              groups="stock.group_stock_user"/>
</odoo>
