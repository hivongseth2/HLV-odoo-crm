<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="hlv_barcode_custom.barcode_app">
    <div class="hlv-bc-app">
        <!-- Loading Overlay -->
        <div t-if="state.is_loading" class="hlv-bc-loading">
            <div class="hlv-bc-spinner"/>
            <span>Đang xử lý...</span>
        </div>

        <!-- Feedback Toast -->
        <div t-if="state.feedback_visible"
             t-attf-class="hlv-bc-toast hlv-bc-toast-{{state.feedback_type}}">
            <span t-esc="state.feedback_message"/>
        </div>

        <!-- Popups -->
        <t t-if="state.error_popup" t-call="hlv_barcode_custom.error_popup"/>
        <t t-if="state.search_popup" t-call="hlv_barcode_custom.search_popup"/>
        <t t-if="state.numpad_popup" t-call="hlv_barcode_custom.numpad_popup"/>

        <!-- VIEWS -->
        <t t-if="state.view === 'home'" t-call="hlv_barcode_custom.home_view"/>
        <t t-if="state.view === 'picking_list'" t-call="hlv_barcode_custom.picking_list_view"/>
        <t t-if="state.view === 'scanning'" t-call="hlv_barcode_custom.scanning_view"/>
    </div>
</t>

<!-- ==================== HOME VIEW ==================== -->
<t t-name="hlv_barcode_custom.home_view">
    <div class="hlv-bc-home">
        <!-- Brand Header -->
        <div class="hlv-bc-home-header">
            <div class="hlv-bc-brand">
                <div class="hlv-bc-brand-icon">📦</div>
                <span class="hlv-bc-brand-name">HLV Barcode</span>
            </div>
            <div class="hlv-bc-home-subtitle">Quản lý kho hàng thông minh</div>
        </div>

        <!-- Search Bar -->
        <div class="hlv-bc-search-bar">
            <div class="hlv-bc-search-wrap">
                <span class="hlv-bc-search-icon">🔍</span>
                <input type="text"
                       t-ref="barcodeInput"
                       placeholder="Quét mã phiếu hoặc mã sản phẩm..."
                       t-att-value="state.barcode_value"
                       t-on-input="onBarcodeInput"
                       t-on-keydown="onBarcodeKeydown"
                       autocomplete="off"/>
            </div>
        </div>

        <!-- Warehouse list (when no warehouse selected) -->
        <t t-if="!state.selected_warehouse">
            <div class="hlv-bc-section-title">Chọn Kho</div>
            <div class="hlv-bc-warehouse-list">
                <t t-foreach="state.warehouses" t-as="wh" t-key="wh.warehouse_id">
                    <div class="hlv-bc-warehouse-card"
                         t-on-click="() => this.selectWarehouse(wh)">
                        <div class="hlv-bc-wh-icon">🏭</div>
                        <div class="hlv-bc-wh-info">
                            <div class="hlv-bc-wh-name" t-esc="wh.warehouse_name"/>
                            <div class="hlv-bc-wh-types-count">
                                <t t-esc="wh.picking_types.length"/> hoạt động
                            </div>
                        </div>
                        <div t-if="getWarehouseCount(wh) > 0" class="hlv-bc-card-badge">
                            <t t-esc="getWarehouseCount(wh)"/>
                        </div>
                        <div class="hlv-bc-wh-arrow">→</div>
                    </div>
                </t>
            </div>
        </t>

        <!-- Picking types for selected warehouse -->
        <t t-if="state.selected_warehouse">
            <div class="hlv-bc-wh-back-row">
                <button class="hlv-bc-nav-back" t-on-click="goBackFromWarehouse">←</button>
                <div class="hlv-bc-wh-back-title" t-esc="state.selected_warehouse.warehouse_name"/>
            </div>
            <div class="hlv-bc-menu-grid">
                <t t-foreach="state.selected_warehouse.picking_types" t-as="pt" t-key="pt.id">
                    <div t-attf-class="hlv-bc-menu-card hlv-bc-card-{{pt.code}}"
                         t-on-click="() => this.openPickingTypeList(pt)">
                        <div class="hlv-bc-card-icon-wrap">
                            <t t-esc="getPickingTypeIcon(pt.code)"/>
                        </div>
                        <div class="hlv-bc-card-title"><t t-esc="pt.name"/></div>
                        <div class="hlv-bc-card-desc"><t t-esc="getPickingTypeCodeLabel(pt.code)"/></div>
                        <div t-if="pt.count > 0" class="hlv-bc-card-badge">
                            <t t-esc="pt.count"/>
                        </div>
                    </div>
                </t>
            </div>
        </t>
    </div>
</t>

<!-- ==================== PICKING LIST VIEW ==================== -->
<t t-name="hlv_barcode_custom.picking_list_view">
    <div class="hlv-bc-picking-list">
        <!-- Navbar -->
        <div class="hlv-bc-navbar">
            <button class="hlv-bc-nav-back" t-on-click="goHome">←</button>
            <div>
                <div class="hlv-bc-nav-title" t-if="state.picking_type_filter"
                     t-esc="state.picking_type_filter.name"/>
                <div class="hlv-bc-nav-subtitle" t-if="state.picking_type_filter"
                     t-esc="getPickingTypeCodeLabel(state.picking_type_filter.code)"/>
            </div>
        </div>

        <!-- Type info card -->
        <div class="hlv-bc-type-header">
            <div class="hlv-bc-type-card">
                <div class="hlv-bc-type-icon" t-if="state.picking_type_filter">
                    <t t-esc="getPickingTypeIcon(state.picking_type_filter.code)"/>
                </div>
                <div class="hlv-bc-type-info">
                    <div class="hlv-bc-type-name" t-if="state.picking_type_filter"
                         t-esc="state.picking_type_filter.name"/>
                    <div class="hlv-bc-type-code" t-if="state.picking_type_filter"
                         t-esc="getPickingTypeCodeLabel(state.picking_type_filter.code)"/>
                </div>
            </div>
        </div>

        <!-- Search in list -->
        <div class="hlv-bc-scan-input-area">
            <div class="hlv-bc-scan-input-wrap">
                <span class="hlv-bc-scan-input-icon">🔍</span>
                <input type="text"
                       t-ref="barcodeInput"
                       placeholder="Quét mã phiếu để mở nhanh..."
                       t-att-value="state.barcode_value"
                       t-on-input="onBarcodeInput"
                       t-on-keydown="onBarcodeKeydown"
                       autocomplete="off"/>
            </div>
        </div>

        <!-- List title -->
        <div class="hlv-bc-list-title">
            <span class="hlv-bc-list-label">Danh sách Phiếu</span>
            <span class="hlv-bc-list-count" t-if="state.pickings.length > 0">
                <t t-esc="state.pickings.length"/> phiếu
            </span>
        </div>

        <!-- Picking Cards -->
        <div class="hlv-bc-picking-cards">
            <t t-if="state.pickings.length === 0 and !state.is_loading">
                <div class="hlv-bc-empty">
                    <span class="hlv-bc-empty-icon">📋</span>
                    <p>Không có phiếu nào đang chờ xử lý</p>
                </div>
            </t>
            <t t-foreach="state.pickings" t-as="p" t-key="p.id">
                <div class="hlv-bc-picking-card">
                    <div class="hlv-bc-pick-header">
                        <span class="hlv-bc-pick-name" t-esc="p.name"/>
                        <span t-attf-class="hlv-bc-state-badge hlv-bc-state-{{p.state}}"
                              t-esc="p.state_label || p.state"/>
                    </div>
                    <div class="hlv-bc-pick-meta">
                        <div t-if="p.scheduled_date" class="hlv-bc-pick-meta-item">
                            📅 <span t-esc="p.scheduled_date.substring(0,10)"/>
                        </div>
                        <div t-if="p.partner_name" class="hlv-bc-pick-meta-item">
                            👤 <span t-esc="p.partner_name"/>
                        </div>
                        <div t-if="p.location_dest_name" class="hlv-bc-pick-meta-item">
                            📍 <span t-esc="p.location_dest_name"/>
                        </div>
                    </div>
                    <div t-if="p.priority === '1'" class="hlv-bc-priority-badge"
                         style="margin-top:8px;">
                        ‼ Ưu tiên cao
                    </div>
                    <div class="hlv-bc-pick-action">
                        <button class="hlv-bc-btn-start"
                                t-on-click="() => this.openPicking(p.id)">
                            <t t-if="p.state === 'assigned'">Bắt đầu</t>
                            <t t-else="">Tiếp tục</t>
                        </button>
                    </div>
                </div>
            </t>
        </div>
    </div>
</t>

<!-- ==================== SCANNING VIEW ==================== -->
<t t-name="hlv_barcode_custom.scanning_view">
    <div class="hlv-bc-scanning">
        <!-- Navbar -->
        <div class="hlv-bc-navbar">
            <button class="hlv-bc-nav-back" t-on-click="goBackFromScan">←</button>
            <div>
                <div class="hlv-bc-nav-title" t-esc="state.picking.name"/>
            </div>
            <button t-if="state.config.camera_enabled"
                    t-attf-class="hlv-bc-btn-camera-toggle {{state.camera_active ? 'active' : ''}}"
                    t-on-click="toggleCamera">
                <t t-if="state.camera_active">⏹ Tắt Camera</t>
                <t t-else="">📷 Camera</t>
            </button>
        </div>

        <!-- Embedded Camera (inline, not overlay) -->
        <div t-if="state.camera_active" class="hlv-bc-camera-inline">
            <div class="hlv-bc-camera-viewport">
                <video t-ref="cameraVideo" autoplay="true" playsinline="true" muted="true"/>
                <div class="hlv-bc-scan-frame">
                    <div class="hlv-bc-scan-line"/>
                </div>
            </div>
            <div class="hlv-bc-camera-status" t-if="state.camera_status"
                 t-esc="state.camera_status"/>
        </div>

        <!-- Picking Info - Compact single line -->
        <div class="hlv-bc-scan-pick-compact">
            <span class="hlv-bc-scan-pick-type" t-esc="state.picking.picking_type_name"/>
            <span class="hlv-bc-compact-sep">•</span>
            <span t-esc="state.picking.location_name"/>
            <span class="hlv-bc-compact-arrow">→</span>
            <span t-esc="state.picking.location_dest_name"/>
            <span t-if="state.picking.priority === '1'" class="hlv-bc-priority-badge">‼</span>
        </div>

        <!-- Active location indicator -->
        <div t-if="state.scanned_location" class="hlv-bc-location-prompt hlv-bc-location-prompt-success">
            <span class="hlv-bc-loc-prompt-icon">📍</span>
            <span class="hlv-bc-loc-prompt-text">Vị trí hiện tại:</span>
            <span class="hlv-bc-loc-prompt-value" t-esc="state.scanned_location"/>
        </div>

        <!-- Progress -->
        <div class="hlv-bc-progress-section">
            <div class="hlv-bc-progress-header">
                <span class="hlv-bc-progress-label">Tiến trình quét</span>
                <span class="hlv-bc-progress-count">
                    <t t-esc="getDoneLines()"/> / <t t-esc="state.lines.length"/> sản phẩm
                </span>
            </div>
            <div class="hlv-bc-progress-track">
                <div class="hlv-bc-progress-fill"
                     t-attf-style="width: {{ getTotalDemand() > 0 ? Math.min(100, (getTotalScanned() / getTotalDemand()) * 100) : 0 }}%"/>
            </div>
        </div>

        <!-- Scan Input -->
        <div class="hlv-bc-scan-input-area">
            <div class="hlv-bc-scan-input-wrap">
                <span class="hlv-bc-scan-input-icon">📷</span>
                <input type="text"
                       t-ref="barcodeInput"
                       t-att-placeholder="getScanPlaceholder()"
                       t-att-value="state.barcode_value"
                       t-on-input="onBarcodeInput"
                       t-on-keydown="onBarcodeKeydown"
                       autocomplete="off"/>
            </div>
        </div>

        <!-- Product List Title -->
        <div class="hlv-bc-product-list-title">
            <span class="hlv-bc-pl-label">Danh sách sản phẩm</span>
        </div>

        <!-- Product Lines -->
        <div class="hlv-bc-product-list">
            <t t-foreach="state.lines" t-as="line" t-key="line.move_id">
                <div t-attf-class="hlv-bc-product-row hlv-bc-row-{{getLineStatus(line)}} {{state.last_scanned_move_id === line.move_id ? 'hlv-bc-row-flash' : ''}}">
                    <div class="hlv-bc-row-main">
                        <!-- Product Image -->
                        <div class="hlv-bc-row-img">
                            <img t-if="line.product_image"
                                 t-att-src="getProductImageUrl(line.product_id)"
                                 alt=""/>
                            <span t-else="" class="hlv-bc-row-img-placeholder">📦</span>
                        </div>

                        <!-- Product Info -->
                        <div class="hlv-bc-row-info">
                            <div class="hlv-bc-product-name" t-esc="line.product_name"/>
                            <div t-if="line.product_default_code" class="hlv-bc-product-sku">
                                SKU: <t t-esc="line.product_default_code"/>
                            </div>
                            <div t-attf-class="hlv-bc-row-status status-{{getLineStatus(line)}}">
                                <t t-if="getLineStatus(line) === 'done'">✓ Hoàn thành</t>
                                <t t-elif="getLineStatus(line) === 'partial'">● Đang quét</t>
                                <t t-else="">○ Chờ quét</t>
                            </div>
                        </div>

                        <!-- Quantity -->
                        <div class="hlv-bc-row-qty"
                             t-on-click="() => this.openNumpad(line.move_id)">
                            <div class="hlv-bc-qty-display">
                                <span class="hlv-bc-qty-done-val"
                                      t-esc="(line.quantity_done || 0).toFixed(line.is_decimal ? 1 : 0)"/>
                                <span class="hlv-bc-qty-sep">/</span>
                                <span t-esc="line.demand.toFixed(line.is_decimal ? 1 : 0)"/>
                            </div>
                            <div class="hlv-bc-qty-status-text"
                                 t-att-style="getLineStatus(line) === 'done' ? 'color:#059669' : getLineStatus(line) === 'partial' ? 'color:#4f46e5' : 'color:#94a3b8'">
                                <t t-esc="line.uom_name"/>
                            </div>
                        </div>
                    </div>

                    <!-- Sub-location info (from move_lines) -->
                    <div class="hlv-bc-row-location-info">
                        📍 <t t-esc="line.location_name"/> → <t t-esc="line.location_dest_name"/>
                    </div>
                    <!-- Show all sub-locations with planned qty -->
                    <t t-if="line.move_lines and line.move_lines.length > 0">
                        <div class="hlv-bc-row-sub-locations">
                            <t t-foreach="line.move_lines" t-as="sml" t-key="sml.id">
                                <div t-attf-class="hlv-bc-sub-loc-row {{state.scanned_location and sml.location_name === state.scanned_location ? 'hlv-bc-sub-loc-active' : ''}}">
                                    <span class="hlv-bc-sub-loc-from" t-esc="sml.location_name"/>
                                    <span class="hlv-bc-sub-loc-arrow">→</span>
                                    <span class="hlv-bc-sub-loc-to" t-esc="sml.location_dest_name"/>
                                    <span class="hlv-bc-sub-loc-qty">
                                        <t t-esc="sml.quantity"/> <t t-esc="line.uom_name"/>
                                    </span>
                                    <span t-if="sml.lot_name" class="hlv-bc-sub-loc-lot">
                                        Lot: <t t-esc="sml.lot_name"/>
                                    </span>
                                </div>
                            </t>
                        </div>
                    </t>

                    <!-- Quick +/- buttons -->
                    <div class="hlv-bc-row-actions">
                        <button class="hlv-bc-btn-qty hlv-bc-btn-minus"
                                t-on-click="() => this.decrementQty(line.move_id)">−1</button>
                        <button class="hlv-bc-btn-qty hlv-bc-btn-plus"
                                t-on-click="() => this.incrementQty(line.move_id)">+1</button>
                        <t t-if="line.is_decimal">
                            <button class="hlv-bc-btn-qty hlv-bc-btn-minus"
                                    t-on-click="() => this.decrementDecimal(line.move_id)">
                                −<t t-esc="state.config.decimal_step"/>
                            </button>
                            <button class="hlv-bc-btn-qty hlv-bc-btn-plus"
                                    t-on-click="() => this.incrementDecimal(line.move_id)">
                                +<t t-esc="state.config.decimal_step"/>
                            </button>
                        </t>
                    </div>
                </div>
            </t>

            <t t-if="state.lines.length === 0">
                <div class="hlv-bc-empty">
                    <span class="hlv-bc-empty-icon">📋</span>
                    <p>Không có dòng sản phẩm nào</p>
                </div>
            </t>
        </div>

        <!-- Bottom Bar -->
        <div class="hlv-bc-bottom-bar">
            <button t-attf-class="hlv-bc-btn-validate {{!isAllDone() ? 'disabled' : ''}}"
                    t-on-click="validatePicking"
                    t-att-disabled="!isAllDone()">
                ⚙ Xác nhận hoàn tất
            </button>
            <div t-if="!isAllDone()" class="hlv-bc-validate-hint">
                Quét tất cả mặt hàng để hoàn tất
            </div>
        </div>
    </div>
</t>

<!-- ==================== ERROR POPUP ==================== -->
<t t-name="hlv_barcode_custom.error_popup">
    <div class="hlv-bc-overlay" t-on-click="closeErrorPopup">
        <div class="hlv-bc-error-dialog" t-on-click.stop="">
            <div class="hlv-bc-error-icon">⚠️</div>
            <div t-if="state.error_popup.title" class="hlv-bc-error-title" t-esc="state.error_popup.title"/>
            <div class="hlv-bc-error-message" t-esc="state.error_popup.message"/>
            <button class="hlv-bc-btn-close-error" t-on-click="closeErrorPopup">Đóng</button>
        </div>
    </div>
</t>

<!-- ==================== PRODUCT SEARCH POPUP ==================== -->
<t t-name="hlv_barcode_custom.search_popup">
    <div class="hlv-bc-overlay" t-on-click="closeSearchPopup">
        <div class="hlv-bc-search-dialog" t-on-click.stop="">
            <div class="hlv-bc-search-header">
                <h3>Thông tin Tồn kho</h3>
                <button class="hlv-bc-btn-close" t-on-click="closeSearchPopup">✕</button>
            </div>

            <div class="hlv-bc-search-product-info">
                <div class="hlv-bc-search-product-img">
                    <img t-if="state.search_popup.product.has_image"
                         t-att-src="getProductImageUrl(state.search_popup.product.id)" alt=""/>
                    <span t-else="">📦</span>
                </div>
                <div>
                    <div class="hlv-bc-search-product-name" t-esc="state.search_popup.product.name"/>
                    <div t-if="state.search_popup.product.default_code" class="hlv-bc-search-product-code">
                        SKU: <t t-esc="state.search_popup.product.default_code"/>
                    </div>
                    <div t-if="state.search_popup.product.barcode" class="hlv-bc-search-product-barcode">
                        Barcode: <t t-esc="state.search_popup.product.barcode"/>
                    </div>
                    <div t-if="state.search_popup.product.is_bom_component" class="hlv-bc-bom-info">
                        🧩 Combo/Kit: <strong t-esc="state.search_popup.product.bom_kit_name"/>
                    </div>
                </div>
            </div>

            <div class="hlv-bc-search-total">
                <span class="hlv-bc-total-label">Tổng tồn kho:</span>
                <span class="hlv-bc-total-value">
                    <t t-esc="state.search_popup.product.total_qty.toFixed(2)"/>
                    <t t-esc="state.search_popup.product.uom_name"/>
                </span>
            </div>

            <div class="hlv-bc-search-locations-title">Chi tiết theo vị trí:</div>
            <t t-if="state.search_popup.locations.length === 0">
                <div style="font-size:14px;color:#94a3b8;text-align:center;padding:16px;">Không có tồn kho.</div>
            </t>
            <t t-foreach="state.search_popup.locations" t-as="loc" t-key="loc.location_id">
                <div class="hlv-bc-loc-row">
                    <span class="hlv-bc-loc-name" t-esc="loc.location_name"/>
                    <div class="hlv-bc-loc-qtys">
                        <span class="hlv-bc-loc-qty"><t t-esc="loc.quantity.toFixed(1)"/></span>
                        <span class="hlv-bc-loc-available"><t t-esc="loc.available.toFixed(1)"/> khả dụng</span>
                    </div>
                </div>
            </t>
        </div>
    </div>
</t>

<!-- ==================== NUMPAD POPUP ==================== -->
<t t-name="hlv_barcode_custom.numpad_popup">
    <div class="hlv-bc-overlay" t-on-click="closeNumpad">
        <div class="hlv-bc-numpad-dialog" t-on-click.stop="">
            <div class="hlv-bc-numpad-header">
                <h3 t-esc="state.numpad_popup.product_name"/>
                <div class="hlv-bc-numpad-demand">
                    Yêu cầu: <t t-esc="state.numpad_popup.demand"/> <t t-esc="state.numpad_popup.uom_name"/>
                </div>
            </div>

            <div class="hlv-bc-numpad-display">
                <input type="text" readonly="readonly"
                       t-att-value="state.numpad_value"
                       class="hlv-bc-numpad-input"/>
            </div>

            <div class="hlv-bc-numpad-keys">
                <t t-foreach="['7','8','9','4','5','6','1','2','3','C','0','.']" t-as="k" t-key="k">
                    <button t-attf-class="hlv-bc-numpad-key {{k === 'C' ? 'hlv-bc-key-clear' : ''}}"
                            t-on-click="() => this.onNumpadKey(k)">
                        <t t-esc="k"/>
                    </button>
                </t>
                <button class="hlv-bc-numpad-key hlv-bc-key-backspace"
                        t-on-click="() => this.onNumpadKey('⌫')">⌫</button>
                <button class="hlv-bc-numpad-key hlv-bc-key-confirm"
                        t-on-click="confirmNumpad">✓</button>
            </div>

            <button class="hlv-bc-btn-cancel-numpad" t-on-click="closeNumpad">Hủy</button>
        </div>
    </div>
</t>

</templates>
