<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Thêm CSS vào bundle report -->
  <template id="hlv_tnr_assets_common"
            inherit_id="web.report_assets_common"
            name="HLV | Times New Roman for Reports">
    <xpath expr="." position="inside">
      <link rel="stylesheet" type="text/css" href="/hlv_font/static/src/css/font.css"/>
    </xpath>
  </template>

  <!-- (Tùy môi trường) Nếu instance bạn có bundle này thì kế thừa thêm -->
  <template id="hlv_tnr_assets_pdf"
            inherit_id="web.report_assets_pdf"
            name="HLV | Times New Roman for PDF"
            priority="20">
    <xpath expr="." position="inside">
      <link rel="stylesheet" type="text/css" href="/hlv_font/static/src/css/font.css"/>
    </xpath>
  </template>
</odoo>
