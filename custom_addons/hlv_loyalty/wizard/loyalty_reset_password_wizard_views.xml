<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hlv_loyalty_reset_password_wizard_form" model="ir.ui.view">
        <field name="name">hlv.loyalty.reset.password.wizard.form</field>
        <field name="model">hlv.loyalty.reset.password.wizard</field>
        <field name="arch" type="xml">
            <form string="Reset mật khẩu">
                <group>
                    <field name="account_id" readonly="1"/>
                    <field name="new_password" password="True" required="1"/>
                    <field name="confirm_password" password="True" required="1"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Xác nhận reset" type="object" class="btn-primary"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
