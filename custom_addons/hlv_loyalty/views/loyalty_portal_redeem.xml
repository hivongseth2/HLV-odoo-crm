<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ================================================================
     loyalty_portal_redeem.xml  —  /loyalty/redeem
     Mini-hero + sticky tab strip + animated cards  (v2)
================================================================ -->
<template id="loyalty_portal_redeem" name="Loyalty Portal - Đổi thưởng">
    <t t-call="hlv_loyalty.loyalty_public_layout">

        <!-- ── Top bar ── -->
        <div class="sr-topbar">
            <a href="/loyalty/dashboard" class="sr-topbar-back">
                <span class="ms" style="font-size:20px">arrow_back</span> Quay về Dashboard
            </a>
            <div class="sr-topbar-right">
                <span class="sr-topbar-name">Xin chào, <strong><t t-out="partner.name"/></strong></span>
                <a href="/loyalty/logout" class="sr-topbar-logout">Đăng xuất</a>
            </div>
        </div>

        <!-- ── Mini Hero ── -->
        <div class="sr-rdm-hero">
            <div class="sr-rdm-hero-inner">
                <div class="sr-rdm-hero-left">
                    <h1 class="sr-rdm-hero-ttl">
                        <span class="ms ms-fill">redeem</span> Đổi thưởng
                    </h1>
                    <p class="sr-rdm-hero-sub">Dùng điểm đổi thưởng để nhận quà hoặc quy đổi thành hiện kim.</p>
                </div>
                <div class="sr-rdm-stats">
                    <div class="sr-rdm-stat sr-rdm-stat-exchange">
                        <span class="ms ms-fill sr-rdm-stat-icon">swap_horiz</span>
                        <div>
                            <div class="sr-rdm-stat-lbl">Điểm khả dụng</div>
                            <div class="sr-rdm-stat-val"><t t-out="'{:,}'.format(exchange_available_points)"/></div>
                            <div class="sr-rdm-stat-unit">sau khi trừ điểm treo</div>
                        </div>
                    </div>
                    <t t-if="reward_pending_points &gt; 0">
                        <div class="sr-rdm-stat sr-rdm-stat-pending">
                            <span class="ms sr-rdm-stat-icon">pending_actions</span>
                            <div>
                                <div class="sr-rdm-stat-lbl">Đang treo</div>
                                <div class="sr-rdm-stat-val">-<t t-out="'{:,}'.format(reward_pending_points)"/></div>
                                <div class="sr-rdm-stat-unit">điểm ở yêu cầu chờ xử lý</div>
                            </div>
                        </div>
                    </t>
                    <t t-if="pending_points &gt; 0">
                        <div class="sr-rdm-stat sr-rdm-stat-pending">
                            <span class="ms sr-rdm-stat-icon">hourglass_top</span>
                            <div>
                                <div class="sr-rdm-stat-lbl">Chờ xác nhận</div>
                                <div class="sr-rdm-stat-val">+<t t-out="'{:,}'.format(pending_points)"/></div>
                                <div class="sr-rdm-stat-unit">điểm đang chờ</div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
            <div class="sr-rdm-hero-wm" aria-hidden="true"><span class="ms ms-xl">redeem</span></div>
        </div>

        <!-- ── Tab strip (sticky) ── -->
        <div class="sr-rdm-tab-strip">
            <div class="sr-rdm-tab-inner">
                <a t-att-href="'/loyalty/redeem?tab=gift'"
                   t-att-class="'sr-rdm-tab' + (' active' if active_tab == 'gift' else '')">
                    <span class="ms">redeem</span> Đổi quà
                    <t t-if="packages">
                        <span class="sr-rdm-tab-badge"><t t-out="len(packages)"/></span>
                    </t>
                </a>
                <a t-att-href="'/loyalty/redeem?tab=cash'"
                   t-att-class="'sr-rdm-tab' + (' active' if active_tab == 'cash' else '')">
                    <span class="ms">payments</span> Đổi hiện kim
                </a>
                <a t-att-href="'/loyalty/redeem?tab=history'"
                   t-att-class="'sr-rdm-tab' + (' active' if active_tab == 'history' else '')">
                    <span class="ms">history</span> Yêu cầu của tôi
                    <t t-if="my_requests">
                        <t t-set="pending_cnt" t-value="len([r for r in my_requests if r.state == 'pending'])"/>
                        <t t-if="pending_cnt > 0">
                            <span class="sr-rdm-tab-badge"><t t-out="pending_cnt"/></span>
                        </t>
                    </t>
                </a>
            </div>
        </div>

        <!-- ── Body ── -->
        <div class="sr-rdm-body">

            <!-- Flash messages -->
            <t t-if="success_msg">
                <div class="sr-flash sr-flash-ok">
                    <span class="ms">check_circle</span>
                    <span><t t-out="success_msg"/></span>
                </div>
            </t>
            <t t-if="error_msg">
                <div class="sr-flash sr-flash-err">
                    <span class="ms">error</span>
                    <span><t t-out="error_msg"/></span>
                </div>
            </t>

            <!-- ═══════════════ TAB: ĐỔI QUÀ ═══════════════ -->
            <t t-if="active_tab == 'gift'">
                <div class="sr-rdm-pane">
                    <t t-if="packages">
                        <div class="sr-pkg-grid">
                            <t t-foreach="packages" t-as="pkg">
                                <t t-set="can_redeem" t-value="exchange_available_points >= pkg.points_required"/>
                                <div t-att-class="'sr-pkg-card' + ('' if can_redeem else ' sr-pkg-disabled')">
                                    <div class="sr-pkg-top">
                                        <div class="sr-pkg-icon-wrap">
                                            <span class="ms ms-fill">redeem</span>
                                        </div>
                                        <div class="sr-pkg-pts">
                                            <div class="sr-pkg-pts-num"><t t-out="'{:,}'.format(pkg.points_required)"/></div>
                                            <div class="sr-pkg-pts-lbl">điểm đổi thưởng</div>
                                        </div>
                                    </div>
                                    <div class="sr-pkg-name"><t t-out="pkg.name"/></div>
                                    <div class="sr-pkg-desc">
                                        <t t-if="pkg.reward_type == 'free_shipping'">Miễn phí vận chuyển</t>
                                        <t t-elif="pkg.reward_type == 'gift'">
                                            Quà tặng kèm<t t-if="pkg.gift_product_id">: <t t-out="pkg.gift_product_id.name"/></t>
                                        </t>
                                        <t t-elif="pkg.discount_type == 'fixed'">
                                            Voucher giảm <strong><t t-out="'{:,.0f}'.format(pkg.discount_value)"/>đ</strong>
                                            <t t-if="pkg.min_order_amount > 0"><br/><span style="font-size:.75rem">Đơn từ <t t-out="'{:,.0f}'.format(pkg.min_order_amount)"/>đ</span></t>
                                        </t>
                                        <t t-else="">
                                            Voucher giảm <strong><t t-out="pkg.discount_value"/>%</strong>
                                            <t t-if="pkg.max_discount_amount > 0"><br/><span style="font-size:.75rem">Tối đa <t t-out="'{:,.0f}'.format(pkg.max_discount_amount)"/>đ</span></t>
                                        </t>
                                    </div>
                                    <div class="sr-pkg-divider"/>
                                    <t t-if="can_redeem">
                                        <form t-att-action="'/loyalty/redeem/gift'" method="post" class="sr-pkg-form"
                                              t-att-data-pkg-name="pkg.name"
                                              t-att-data-pts="pkg.points_required"
                                              onsubmit="return confirm('Xác nhận đổi ' + this.dataset.pts + ' điểm lấy gói: ' + this.dataset.pkgName + '?')">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <input type="hidden" name="package_id" t-att-value="pkg.id"/>
                                            <button type="submit" class="sr-pkg-btn">
                                                <span class="ms" style="font-size:16px">redeem</span> Đổi ngay
                                            </button>
                                        </form>
                                    </t>
                                    <t t-else="">
                                        <div class="sr-pkg-insufficient">
                                            <span class="ms" style="font-size:15px">lock</span>
                                            Cần thêm <t t-out="'{:,}'.format(pkg.points_required - exchange_available_points)"/> điểm
                                        </div>
                                    </t>
                                </div>
                            </t>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="sr-rdm-empty">
                            <span class="ms">redeem</span>
                            <p>Chưa có gói quà nào khả dụng.</p>
                        </div>
                    </t>
                </div>
            </t>

            <!-- ═══════════════ TAB: ĐỔI TIỀN ═══════════════ -->
            <t t-if="active_tab == 'cash'">
                <div class="sr-rdm-pane">
                    <div class="sr-cash-layout">
                    <div class="sr-cash-wrap">
                        <form action="/loyalty/redeem/cash" method="post" class="sr-cash-form" id="cash-form">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                            <div class="sr-cf-card">
                                <h3 class="sr-cf-title">
                                    <span class="ms">swap_horiz</span> Số điểm muốn đổi
                                </h3>
                                <div class="sr-cf-field">
                                    <label class="sr-cf-label" for="pts_input">
                                        Số điểm đổi thưởng <span class="sr-required">*</span>
                                    </label>
                                    <input id="pts_input" type="number" name="points_to_redeem"
                                           class="sr-cf-input" min="1"
                                           t-att-max="exchange_available_points"
                                           placeholder="Nhập số điểm..."
                                           required="required"
                                           t-att-value="form_vals.get('points_to_redeem', '')"/>
                                    <!-- Số điểm khả dụng/đang treo đã hiện ở khối thống kê đầu trang
                                         (sr-rdm-stats) — ở đây chỉ nhắc lại NGẮN mức tối đa được nhập,
                                         tránh lặp lại nguyên câu 2 lần trên cùng 1 màn hình. -->
                                    <div class="sr-cf-hint">
                                        Tối đa <strong><t t-out="'{:,}'.format(exchange_available_points)"/> điểm</strong>.
                                        <t t-if="reward_pending_points &gt; 0">
                                            (đang treo <t t-out="'{:,}'.format(reward_pending_points)"/> điểm)
                                        </t>
                                    </div>
                                    <t t-if="program and program.cash_rate_per_point > 0">
                                        <div class="sr-cash-preview sr-cash-preview-zero" id="cash-preview">
                                            <span class="ms">payments</span>
                                            <span>Bạn sẽ nhận:</span>
                                            <span class="sr-cash-preview-val" id="preview-val">0đ</span>
                                        </div>
                                        <div class="sr-cf-hint">
                                            Tối đa quy đổi được:
                                            <strong><t t-out="'{:,.0f}'.format(exchange_available_points * program.cash_rate_per_point)"/>đ</strong>
                                        </div>
                                    </t>
                                </div>
                            </div>

                            <div class="sr-cf-card">
                                <h3 class="sr-cf-title">
                                    <span class="ms">account_balance</span> Thông tin nhận hiện kim
                                </h3>

                                <t t-if="bank_mode == 'confirm'">
                                    <!-- Khối xác nhận STK mặc định — view riêng (sr-bank-confirm),
                                         không dùng lại style hàng list của trang chi tiết yêu cầu.
                                         Số tài khoản ẩn theo mặc định, chỉ hiện đủ khi bấm 'Xem đầy đủ'. -->
                                    <input type="hidden" name="use_saved_bank" value="1"/>
                                    <div class="sr-cf-field">
                                        <div class="sr-bank-confirm">
                                            <div class="sr-bank-confirm-chip">
                                                <span class="ms ms-fill">account_balance</span>
                                            </div>
                                            <div class="sr-bank-confirm-info">
                                                <div class="sr-bank-confirm-bank"><t t-out="default_bank_name"/></div>
                                                <div class="sr-bank-confirm-numrow">
                                                    <span class="sr-bank-confirm-num" id="cash-stk-masked"><t t-out="default_account_number_masked"/></span>
                                                    <button type="button" class="sr-bank-confirm-eye" id="cash-stk-reveal"
                                                            t-att-data-full="default_account_number" aria-label="Xem đầy đủ số tài khoản">
                                                        <span class="ms" id="cash-stk-reveal-icon">visibility</span>
                                                        <span id="cash-stk-reveal-label">Xem đầy đủ</span>
                                                    </button>
                                                </div>
                                                <div class="sr-bank-confirm-holder"><t t-out="default_account_name"/></div>
                                            </div>
                                        </div>
                                        <div class="sr-cf-hint">
                                            Vui lòng kiểm tra thông tin nhận tiền phía trên. Nếu chính xác, bấm
                                            <strong>Gửi yêu cầu</strong> để hoàn tất.
                                        </div>
                                        <a t-att-href="'/loyalty/redeem?tab=cash&amp;bank_mode=edit'" class="sr-rq-toggle-btn" style="margin-top:10px">
                                            <span class="ms" style="font-size:16px">edit</span> Cập nhật thông tin nhận tiền
                                        </a>
                                    </div>
                                </t>
                                <t t-else="">
                                    <input type="hidden" name="use_saved_bank" value="0"/>
                                    <t t-if="has_default_bank">
                                        <div class="sr-cf-edit-banner">
                                            <span class="ms" style="font-size:16px">info</span>
                                            Thông tin nhận tiền hiện tại đã được điền sẵn bên dưới. Vui lòng chỉnh sửa nếu cần thay đổi.
                                        </div>
                                    </t>
                                    <div class="sr-cf-field">
                                        <label class="sr-cf-label">Ngân hàng <span class="sr-required">*</span></label>
                                        <input type="text" name="bank_name" class="sr-cf-input"
                                               placeholder="VD: Vietcombank, Techcombank, BIDV..."
                                               required="required" t-att-value="form_vals.get('bank_name') or default_bank_name"/>
                                    </div>
                                    <div class="sr-cf-field">
                                        <label class="sr-cf-label">Số tài khoản <span class="sr-required">*</span></label>
                                        <input type="text" name="account_number" class="sr-cf-input"
                                               placeholder="Nhập số tài khoản..."
                                               required="required" t-att-value="form_vals.get('account_number') or default_account_number"/>
                                    </div>
                                    <div class="sr-cf-field">
                                        <label class="sr-cf-label">Tên chủ tài khoản <span class="sr-required">*</span></label>
                                        <input type="text" name="account_name" class="sr-cf-input"
                                               placeholder="Nhập đúng tên chủ tài khoản..."
                                               required="required" t-att-value="form_vals.get('account_name') or default_account_name"/>
                                        <div class="sr-cf-hint">Tên phải khớp với tên đăng ký tại ngân hàng.</div>
                                    </div>
                                    <div class="sr-cf-field">
                                        <label style="display:flex;align-items:center;gap:8px;font-weight:600;font-size:.83rem;cursor:pointer">
                                            <input type="checkbox" name="save_default" value="1" checked="checked"/>
                                            Lưu thông tin này làm mặc định cho các lần đổi sau
                                        </label>
                                        <t t-if="has_default_bank">
                                            <div class="sr-cf-hint">
                                                <a t-att-href="'/loyalty/redeem?tab=cash'">Quay lại thông tin nhận tiền mặc định</a>
                                            </div>
                                        </t>
                                    </div>
                                </t>

                                <div class="sr-cf-field">
                                    <label class="sr-cf-label">Ghi chú</label>
                                    <textarea name="customer_note" class="sr-cf-input sr-cf-textarea"
                                              placeholder="Ghi chú thêm (nếu có)..."><t t-out="form_vals.get('customer_note', '')"/></textarea>
                                </div>
                            </div>

                            <div class="sr-cf-actions">
                                <button type="submit" class="sr-cf-submit">
                                    <span class="ms">send</span> Gửi yêu cầu
                                </button>
                            </div>
                        </form>
                    </div><!-- /sr-cash-wrap -->

                    <!-- Right panel — CHỈ còn quy trình xử lý (thông tin duy nhất chưa xuất
                         hiện ở nơi khác trên trang); số điểm/số tiền tối đa đã có ở khối
                         thống kê đầu trang + preview bên form, không lặp lại ở đây nữa. -->
                    <div class="sr-cash-side">
                        <div class="sr-cash-side-inner">
                            <div class="sr-cash-side-ttl">
                                <span class="ms" style="font-size:18px">checklist</span> Quy trình xử lý
                            </div>
                            <div class="sr-cash-side-steps">
                                <div class="sr-css-step">
                                    <span class="ms sr-css-step-icon">edit_note</span>
                                    <span>Nhập số điểm và thông tin ngân hàng</span>
                                </div>
                                <div class="sr-css-step">
                                    <span class="ms sr-css-step-icon">send</span>
                                    <span>Gửi yêu cầu</span>
                                </div>
                                <div class="sr-css-step">
                                    <span class="ms sr-css-step-icon">verified</span>
                                    <span>Chờ admin xác nhận và chuyển khoản</span>
                                </div>
                            </div>
                        </div>
                    </div><!-- /sr-cash-side -->
                    </div><!-- /sr-cash-layout -->
                </div>
                <t t-if="program and program.cash_rate_per_point > 0">
                    <script>
                    (function(){
                        var rate = <t t-out="program.cash_rate_per_point"/>;
                        var max  = <t t-out="exchange_available_points"/>;
                        var inp  = document.getElementById('pts_input');
                        var prv  = document.getElementById('cash-preview');
                        var val  = document.getElementById('preview-val');
                        if(!inp || !prv || !val) return;
                        function fmt(n){ return n.toLocaleString('vi-VN') + 'đ'; }
                        function update(){
                            var pts = Math.min(parseInt(inp.value) || 0, max);
                            val.textContent = fmt(pts * rate);
                            prv.classList.toggle('sr-cash-preview-zero', pts === 0);
                        }
                        inp.addEventListener('input', update);
                        update();
                    })();
                    </script>
                </t>
                <script>
                (function(){
                    var btn = document.getElementById('cash-stk-reveal');
                    var span = document.getElementById('cash-stk-masked');
                    var icon = document.getElementById('cash-stk-reveal-icon');
                    var label = document.getElementById('cash-stk-reveal-label');
                    if(!btn || !span || !icon || !label) return;
                    var masked = span.textContent;
                    var full = btn.getAttribute('data-full') || '';
                    var revealed = false;
                    btn.addEventListener('click', function(){
                        revealed = !revealed;
                        span.textContent = revealed ? full : masked;
                        icon.textContent = revealed ? 'visibility_off' : 'visibility';
                        label.textContent = revealed ? 'Ẩn số tài khoản' : 'Xem đầy đủ số tài khoản';
                    });
                })();
                </script>
            </t>

            <!-- ═══════════════ TAB: YÊU CẦU CỦA TÔI ═══════════════ -->
            <t t-if="active_tab == 'history'">
                <div class="sr-rdm-pane">
                    <t t-if="my_requests">
                        <div class="sr-req-list">
                            <t t-foreach="my_requests" t-as="rq">
                                <div class="sr-req-card">
                                    <div class="sr-rq-head">
                                        <div class="sr-rq-name">
                                            <span class="ms">
                                                <t t-if="rq.request_type == 'gift'">redeem</t>
                                                <t t-else="">payments</t>
                                            </span>
                                            <strong><t t-out="rq.name"/></strong>
                                            <span t-att-class="'sr-rq-type-badge rq-type-' + rq.request_type">
                                                <t t-if="rq.request_type == 'gift'">Đổi quà</t>
                                                <t t-else="">Đổi hiện kim</t>
                                            </span>
                                        </div>
                                        <span t-att-class="'sr-rq-state rq-st-' + rq.state">
                                            <span class="sr-rq-dot"/>
                                            <t t-if="rq.state == 'pending'">Chờ duyệt</t>
                                            <t t-elif="rq.state == 'done'">Đã xử lý</t>
                                            <t t-else="">Đã hủy</t>
                                        </span>
                                    </div>
                                    <div class="sr-rq-body">
                                        <div class="sr-rq-row">
                                            <span class="sr-rq-lbl">Điểm sử dụng:</span>
                                            <span class="sr-rq-val"><t t-out="'{:,}'.format(rq.points_required)"/> điểm đổi thưởng</span>
                                        </div>
                                        <t t-if="rq.request_type == 'gift' and rq.package_id">
                                            <div class="sr-rq-row">
                                                <span class="sr-rq-lbl">Gói quà:</span>
                                                <span class="sr-rq-val"><t t-out="rq.package_id.name"/></span>
                                            </div>
                                        </t>
                                        <!-- Chỉ hiện trạng thái thanh toán khi yêu cầu ĐÃ được duyệt/xử lý —
                                             yêu cầu còn 'Chờ duyệt' thì chưa có gì để nói đã/chưa thanh toán,
                                             hiện ra dễ gây hiểu lầm là chưa được duyệt bị "quên" thanh toán. -->
                                        <t t-if="rq.request_type == 'cash' and rq.state == 'done'">
                                            <div class="sr-rq-row">
                                                <span class="sr-rq-lbl">Thanh toán:</span>
                                                <t t-set="is_paid" t-value="payment_status_by_request.get(rq.id)"/>
                                                <span t-att-class="'sr-pay-badge ' + ('sr-pay-done' if is_paid else 'sr-pay-pending')">
                                                    <span class="ms" style="font-size:14px">
                                                        <t t-if="is_paid">check_circle</t>
                                                        <t t-else="">schedule</t>
                                                    </span>
                                                    <t t-if="is_paid">Đã thanh toán</t>
                                                    <t t-else="">Chưa thanh toán</t>
                                                </span>
                                            </div>
                                        </t>
                                        <t t-if="rq.state == 'done' and rq.voucher_id">
                                            <div class="sr-rq-row sr-rq-voucher">
                                                <span class="sr-rq-lbl">Voucher:</span>
                                                <span class="sr-rq-vcode">
                                                    <span class="ms">confirmation_number</span>
                                                    <t t-out="rq.voucher_id.code"/>
                                                </span>
                                            </div>
                                        </t>
                                        <t t-if="rq.admin_note">
                                            <div class="sr-rq-row">
                                                <span class="sr-rq-lbl">Phản hồi:</span>
                                                <span class="sr-rq-val"><t t-out="rq.admin_note"/></span>
                                            </div>
                                        </t>
                                        <div class="sr-rq-date">
                                            <span class="ms" style="font-size:13px">calendar_today</span>
                                            <t t-out="fmt_vn_date(rq.date_request)"/> · <t t-out="fmt_vn_time(rq.date_request)"/>
                                            <t t-if="rq.date_done">
                                                <span style="margin:0 4px">→</span> Xử lý: <t t-out="fmt_vn_date(rq.date_done)"/>
                                            </t>
                                        </div>
                                        <div class="sr-rq-actions">
                                            <a t-att-href="'/loyalty/redeem/request/%s' % rq.id" class="sr-rq-detail-link">
                                                <span class="ms" style="font-size:15px">visibility</span> Xem chi tiết
                                            </a>
                                            <t t-if="rq.state == 'pending'">
                                                <form t-att-action="'/loyalty/redeem/request/%s/cancel' % rq.id"
                                                      method="post"
                                                      class="sr-rq-cancel-form"
                                                      onsubmit="return confirm('Hủy yêu cầu đổi thưởng này?')">
                                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                    <button type="submit" class="sr-rq-cancel-btn">
                                                        Hủy yêu cầu
                                                    </button>
                                                </form>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="sr-rdm-empty">
                            <span class="ms">inbox</span>
                            <p>Bạn chưa có yêu cầu đổi thưởng nào.</p>
                        </div>
                    </t>
                </div>
            </t>

        </div><!-- /sr-rdm-body -->
    </t>
</template>

</odoo>

