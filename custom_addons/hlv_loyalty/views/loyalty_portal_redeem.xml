<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ================================================================
     loyalty_portal_redeem.xml
     Reward redemption page at /loyalty/redeem
================================================================ -->
<template id="loyalty_portal_redeem" name="Loyalty Portal - Đổi thưởng">
    <t t-call="hlv_loyalty.loyalty_public_layout">

        <!-- Top bar -->
        <div class="sr-topbar">
            <a href="/loyalty/dashboard" class="sr-topbar-back">
                <span class="ms" style="font-size:20px">arrow_back</span> Quay về Dashboard
            </a>
            <div class="sr-topbar-right">
                <span class="sr-topbar-name">Xin chào, <strong><t t-out="partner.name"/></strong></span>
                <a href="/loyalty/logout" class="sr-topbar-logout">Đăng xuất</a>
            </div>
        </div>

        <!-- Body -->
        <div class="sr-body" style="padding-top:28px">

            <!-- Balance reminder -->
            <div class="sr-redeem-balance">
                <div class="sr-rb-item">
                    <span class="ms ms-fill" style="color:var(--c-pri);font-size:22px">swap_horiz</span>
                    <div>
                        <div class="sr-rb-lbl">Điểm đổi thưởng</div>
                        <div class="sr-rb-val"><t t-out="'{:,}'.format(exchange_points)"/> điểm</div>
                    </div>
                </div>
                <t t-if="pending_points > 0">
                    <div class="sr-rb-item sr-rb-pending">
                        <span class="ms" style="color:#d67000;font-size:20px">hourglass_top</span>
                        <div>
                            <div class="sr-rb-lbl">Chờ xác nhận</div>
                            <div class="sr-rb-val" style="color:#d67000">+<t t-out="'{:,}'.format(pending_points)"/> điểm</div>
                        </div>
                    </div>
                </t>
                <t t-if="program and program.cash_rate_per_point">
                    <div class="sr-rb-item">
                        <span class="ms" style="color:#6c757d;font-size:20px">info</span>
                        <div>
                            <div class="sr-rb-lbl">Tỷ lệ đổi tiền</div>
                            <div class="sr-rb-val" style="font-size:.88rem;color:#6c757d">
                                1 điểm = <t t-out="'{:,.0f}'.format(program.cash_rate_per_point)"/>đ
                            </div>
                        </div>
                    </div>
                </t>
            </div>

            <!-- Flash messages -->
            <t t-if="success_msg">
                <div class="sr-flash sr-flash-ok">
                    <span class="ms">check_circle</span>
                    <span><t t-out="success_msg"/></span>
                </div>
            </t>
            <t t-if="error_msg">
                <div class="sr-flash sr-flash-err">
                    <span class="ms">error</span>
                    <span><t t-out="error_msg"/></span>
                </div>
            </t>

            <!-- Tab selector -->
            <div class="sr-tab-pills">
                <a t-att-href="'/loyalty/redeem?tab=gift'"
                   t-att-class="'sr-tab-pill' + (' active' if active_tab == 'gift' else '')">
                    <span class="ms">redeem</span> Đổi quà
                </a>
                <a t-att-href="'/loyalty/redeem?tab=cash'"
                   t-att-class="'sr-tab-pill' + (' active' if active_tab == 'cash' else '')">
                    <span class="ms">payments</span> Đổi tiền
                </a>
                <a t-att-href="'/loyalty/redeem?tab=history'"
                   t-att-class="'sr-tab-pill' + (' active' if active_tab == 'history' else '')">
                    <span class="ms">history</span> Yêu cầu của tôi
                </a>
            </div>

            <!-- ═══════════════════ TAB: ĐỔI QUÀ ═══════════════════ -->
            <t t-if="active_tab == 'gift'">
                <t t-if="packages">
                    <div class="sr-pkg-grid">
                        <t t-foreach="packages" t-as="pkg">
                            <t t-set="can_redeem" t-value="exchange_points >= pkg.points_required"/>
                            <div t-att-class="'sr-pkg-card' + ('' if can_redeem else ' sr-pkg-disabled')">
                                <div class="sr-pkg-top">
                                    <span class="ms ms-fill" style="font-size:32px;color:var(--c-pri)">redeem</span>
                                    <div class="sr-pkg-pts">
                                        <span class="sr-pkg-pts-num"><t t-out="'{:,}'.format(pkg.points_required)"/></span>
                                        <span class="sr-pkg-pts-lbl"> điểm ĐT</span>
                                    </div>
                                </div>
                                <div class="sr-pkg-name"><t t-out="pkg.name"/></div>
                                <div class="sr-pkg-desc">
                                    <t t-if="pkg.reward_type == 'free_shipping'">Miễn phí vận chuyển</t>
                                    <t t-elif="pkg.reward_type == 'gift'">
                                        Quà tặng kèm
                                        <t t-if="pkg.gift_product_id">: <t t-out="pkg.gift_product_id.name"/></t>
                                    </t>
                                    <t t-elif="pkg.discount_type == 'fixed'">
                                        Voucher giảm <strong><t t-out="'{:,.0f}'.format(pkg.discount_value)"/>đ</strong>
                                        <t t-if="pkg.min_order_amount > 0"> (đơn từ <t t-out="'{:,.0f}'.format(pkg.min_order_amount)"/>đ)</t>
                                    </t>
                                    <t t-else="">
                                        Voucher giảm <strong><t t-out="pkg.discount_value"/>%</strong>
                                        <t t-if="pkg.max_discount_amount > 0"> (tối đa <t t-out="'{:,.0f}'.format(pkg.max_discount_amount)"/>đ)</t>
                                    </t>
                                </div>
                                <t t-if="can_redeem">
                                    <form t-att-action="'/loyalty/redeem/gift'" method="post" class="sr-pkg-form">
                                        <input type="hidden" name="csrf_token"
                                               t-att-value="request.csrf_token()"/>
                                        <input type="hidden" name="package_id"
                                               t-att-value="pkg.id"/>
                                        <button type="submit" class="sr-pkg-btn">
                                            <span class="ms">redeem</span> Đổi ngay
                                        </button>
                                    </form>
                                </t>
                                <t t-else="">
                                    <div class="sr-pkg-insufficient">
                                        <span class="ms" style="font-size:16px">lock</span>
                                        Cần thêm <t t-out="'{:,}'.format(pkg.points_required - exchange_points)"/> điểm
                                    </div>
                                </t>
                            </div>
                        </t>
                    </div>
                </t>
                <t t-else="">
                    <div class="sr-empty">
                        <span class="ms" style="font-size:48px;opacity:.3">redeem</span>
                        <p>Chưa có gói quà nào khả dụng.</p>
                    </div>
                </t>
            </t>

            <!-- ═══════════════════ TAB: ĐỔI TIỀN ═══════════════════ -->
            <t t-if="active_tab == 'cash'">
                <div class="sr-cash-wrap">
                    <form action="/loyalty/redeem/cash" method="post" class="sr-cash-form">
                        <input type="hidden" name="csrf_token"
                               t-att-value="request.csrf_token()"/>

                        <div class="sr-cf-section">
                            <h4 class="sr-cf-title">
                                <span class="ms">swap_horiz</span> Số điểm muốn đổi
                            </h4>
                            <div class="sr-cf-field">
                                <label class="sr-cf-label">Số điểm đổi thưởng <span class="sr-required">*</span></label>
                                <input type="number" name="points_to_redeem"
                                       class="sr-cf-input"
                                       min="1"
                                       t-att-max="exchange_points"
                                       placeholder="Nhập số điểm..."
                                       required="required"
                                       t-att-value="form_vals.get('points_to_redeem', '')"/>
                                <div class="sr-cf-hint">
                                    Bạn hiện có <strong><t t-out="'{:,}'.format(exchange_points)"/> điểm</strong> đổi thưởng.
                                    <t t-if="program and program.cash_rate_per_point > 0">
                                        Tỷ lệ: 1 điểm = <strong><t t-out="'{:,.0f}'.format(program.cash_rate_per_point)"/>đ</strong>.
                                    </t>
                                </div>
                            </div>
                        </div>

                        <div class="sr-cf-section">
                            <h4 class="sr-cf-title">
                                <span class="ms">account_balance</span> Thông tin nhận tiền
                            </h4>
                            <div class="sr-cf-field">
                                <label class="sr-cf-label">Ngân hàng <span class="sr-required">*</span></label>
                                <input type="text" name="bank_name" class="sr-cf-input"
                                       placeholder="Vd: Vietcombank, Techcombank..."
                                       required="required"
                                       t-att-value="form_vals.get('bank_name', '')"/>
                            </div>
                            <div class="sr-cf-field">
                                <label class="sr-cf-label">Số tài khoản <span class="sr-required">*</span></label>
                                <input type="text" name="account_number" class="sr-cf-input"
                                       placeholder="Nhập số tài khoản..."
                                       required="required"
                                       t-att-value="form_vals.get('account_number', '')"/>
                            </div>
                            <div class="sr-cf-field">
                                <label class="sr-cf-label">Tên chủ tài khoản <span class="sr-required">*</span></label>
                                <input type="text" name="account_name" class="sr-cf-input"
                                       placeholder="Nhập tên chủ tài khoản..."
                                       required="required"
                                       t-att-value="form_vals.get('account_name', '')"/>
                            </div>
                            <div class="sr-cf-field">
                                <label class="sr-cf-label">Ghi chú (nếu có)</label>
                                <textarea name="customer_note" class="sr-cf-input sr-cf-textarea"
                                          placeholder="Ghi chú thêm cho yêu cầu của bạn..."><t t-out="form_vals.get('customer_note', '')"/></textarea>
                            </div>
                        </div>

                        <div class="sr-cf-actions">
                            <button type="submit" class="sr-cf-submit">
                                <span class="ms">send</span> Gửi yêu cầu
                            </button>
                        </div>
                    </form>
                </div>
            </t>

            <!-- ═══════════════════ TAB: YÊU CẦU CỦA TÔI ════════════ -->
            <t t-if="active_tab == 'history'">
                <t t-if="my_requests">
                    <div class="sr-req-list">
                        <t t-foreach="my_requests" t-as="rq">
                            <div t-att-class="'sr-req-card sr-rq-' + rq.state">
                                <div class="sr-rq-head">
                                    <div class="sr-rq-name">
                                        <span class="ms" style="font-size:16px">
                                            <t t-if="rq.request_type == 'gift'">redeem</t>
                                            <t t-else="">payments</t>
                                        </span>
                                        <strong><t t-out="rq.name"/></strong>
                                        <span t-att-class="'sr-rq-type-badge rq-type-' + rq.request_type">
                                            <t t-if="rq.request_type == 'gift'">Đổi quà</t>
                                            <t t-else="">Đổi tiền</t>
                                        </span>
                                    </div>
                                    <span t-att-class="'sr-rq-state rq-st-' + rq.state">
                                        <t t-if="rq.state == 'pending'">
                                            <span class="ms" style="font-size:14px">hourglass_top</span> Chờ duyệt
                                        </t>
                                        <t t-elif="rq.state == 'done'">
                                            <span class="ms" style="font-size:14px">check_circle</span> Đã xử lý
                                        </t>
                                        <t t-else="">
                                            <span class="ms" style="font-size:14px">cancel</span> Đã hủy
                                        </t>
                                    </span>
                                </div>
                                <div class="sr-rq-body">
                                    <div class="sr-rq-row">
                                        <span class="sr-rq-lbl">Điểm sử dụng:</span>
                                        <span class="sr-rq-val"><t t-out="'{:,}'.format(rq.points_required)"/> điểm ĐT</span>
                                    </div>
                                    <t t-if="rq.request_type == 'gift' and rq.package_id">
                                        <div class="sr-rq-row">
                                            <span class="sr-rq-lbl">Gói quà:</span>
                                            <span class="sr-rq-val"><t t-out="rq.package_id.name"/></span>
                                        </div>
                                    </t>
                                    <t t-if="rq.request_type == 'cash'">
                                        <div class="sr-rq-row">
                                            <span class="sr-rq-lbl">Giá trị:</span>
                                            <span class="sr-rq-val"><t t-out="'{:,.0f}'.format(rq.cash_value)"/>đ</span>
                                        </div>
                                        <div class="sr-rq-row">
                                            <span class="sr-rq-lbl">Ngân hàng:</span>
                                            <span class="sr-rq-val">
                                                <t t-out="rq.bank_name or ''"/> –
                                                <t t-out="rq.account_number or ''"/>
                                                (<t t-out="rq.account_name or ''"/>)
                                            </span>
                                        </div>
                                    </t>
                                    <t t-if="rq.state == 'done' and rq.voucher_id">
                                        <div class="sr-rq-row sr-rq-voucher">
                                            <span class="sr-rq-lbl">Voucher:</span>
                                            <span class="sr-rq-val sr-rq-vcode">
                                                <span class="ms" style="font-size:14px">confirmation_number</span>
                                                <t t-out="rq.voucher_id.code"/>
                                            </span>
                                        </div>
                                    </t>
                                    <t t-if="rq.admin_note">
                                        <div class="sr-rq-row">
                                            <span class="sr-rq-lbl">Phản hồi:</span>
                                            <span class="sr-rq-val"><t t-out="rq.admin_note"/></span>
                                        </div>
                                    </t>
                                    <div class="sr-rq-date">
                                        <span class="ms" style="font-size:13px">calendar_today</span>
                                        <t t-out="fmt_vn_date(rq.date_request)"/> · <t t-out="fmt_vn_time(rq.date_request)"/>
                                        <t t-if="rq.date_done">
                                            → Xử lý: <t t-out="fmt_vn_date(rq.date_done)"/>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>
                <t t-else="">
                    <div class="sr-empty">
                        <span class="ms" style="font-size:48px;opacity:.3">inbox</span>
                        <p>Bạn chưa có yêu cầu đổi thưởng nào.</p>
                    </div>
                </t>
            </t>

        </div><!-- /sr-body -->
    </t>
</template>

</odoo>
