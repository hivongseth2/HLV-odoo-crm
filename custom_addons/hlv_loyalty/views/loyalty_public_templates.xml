<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ===== SHARED LAYOUT ===== -->
<template id="loyalty_public_layout" name="Loyalty Public Layout">
    <t t-call="web.layout">
        <t t-set="head">
            <meta name="viewport" content="width=device-width, initial-scale=1"/>
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
            <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@600;700;800;900&amp;family=Inter:wght@400;500;600&amp;display=swap"/>
            <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"/>
            <style>
/* ── Palette ── */
:root {
    --c-pri:    #000666;
    --c-pri-c:  #1a237e;
    --c-sec:    #765a22;
    --c-sec-c:  #ffd793;
    --c-surf:   #f8f9fa;
    --c-surf-lo:#f3f4f5;
    --c-surf-0: #ffffff;
    --c-surf-hi:#e7e8e9;
    --c-ink:    #191c1d;
    --c-ink-v:  #454652;
    --c-out:    #c6c5d4;
}
*  { box-sizing: border-box; }
body { margin:0; font-family:'Inter','Segoe UI',sans-serif;
       background:var(--c-surf); color:var(--c-ink); }
h1,h2,h3,h4 { font-family:'Manrope','Segoe UI',sans-serif; margin:0; line-height:1.15; }
a { color:inherit; }

/* Material Symbols */
.ms { font-family:'Material Symbols Outlined'; font-weight:normal; font-style:normal;
      font-size:24px; line-height:1; letter-spacing:normal; text-transform:none;
      display:inline-block; white-space:nowrap; direction:ltr;
      -webkit-font-smoothing:antialiased; vertical-align:middle; }
.ms-fill { font-variation-settings:'FILL' 1; }
.ms-sm   { font-size:14px; }
.ms-lg   { font-size:40px; }
.ms-xl   { font-size:300px; }

/* ── Hero (Home) ── */
.sr-hero {
    background: linear-gradient(135deg,#000666 0%,#1a237e 55%,#251800 100%);
    padding: 80px 24px 120px;
    text-align: center;
    position: relative;
    overflow: hidden;
}
.sr-hero-inner { position:relative; z-index:1; max-width:760px; margin:0 auto; }
.sr-hero-title {
    font-size: clamp(2rem,5vw,3.5rem);
    font-weight: 900;
    color: #fff;
    letter-spacing: -0.5px;
    margin-bottom: 16px;
}
.sr-hero-sub {
    color: #8690ee;
    font-size: 1.05rem;
    font-weight: 500;
    max-width: 540px;
    margin: 0 auto 48px;
    line-height: 1.65;
}

/* Glass search bar */
.sr-search-wrap { max-width: 680px; margin: 0 auto; }
.sr-glass {
    display: flex;
    align-items: center;
    background: rgba(255,255,255,.12);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 60px;
    padding: 8px;
    box-shadow: 0 16px 48px rgba(0,0,0,.3);
}
.sr-glass-field {
    flex: 1; display:flex; align-items:center; gap:10px; padding:10px 16px;
}
.sr-glass-field .ms { color:rgba(255,255,255,.45); flex-shrink:0; }
.sr-glass-field input {
    flex:1; background:transparent; border:none; outline:none;
    color:#fff; font-size:1rem; font-family:'Inter',sans-serif; min-width:0;
}
.sr-glass-field input::placeholder { color:rgba(255,255,255,.4); }
.sr-glass-btn {
    padding:14px 32px;
    background: var(--c-sec);
    color: #fff;
    border: none;
    border-radius: 60px;
    font-family: 'Manrope',sans-serif;
    font-weight: 800;
    font-size: .95rem;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    transition: background .2s;
}
.sr-glass-btn:hover { background: #8a6a28; }

.sr-search-hints {
    display:flex; justify-content:center; gap:24px;
    margin-top:14px;
    color:rgba(255,255,255,.5); font-size:.82rem; font-weight:500;
}
.sr-hint { display:flex; align-items:center; gap:6px; }
.sr-hint .ms { font-size:14px; color:rgba(255,255,255,.7); }

.sr-error {
    max-width:680px; margin:16px auto 0; padding:12px 20px;
    background:rgba(186,26,26,.2); border:1px solid rgba(186,26,26,.4);
    border-radius:12px; color:#fff; font-size:.9rem;
}

/* ── Section Wrapper ── */
.sr-section { padding:48px 24px 64px; }
.sr-section-bg { background:var(--c-surf-lo); }
.sr-cont { max-width:1200px; margin:0 auto; }
.sr-sec-title { font-size:1.75rem; font-weight:800; color:var(--c-ink); margin-bottom:8px; }
.sr-divider { width:80px; height:4px; background:var(--c-sec); border-radius:4px; margin-bottom:32px; }

/* ── Tier Grid ── */
.sr-tier-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:32px; }
.sr-tier-card {
    background:var(--c-surf-0);
    border-radius:8px;
    padding:32px;
    position:relative;
    transition:transform .3s cubic-bezier(.4,0,.2,1), box-shadow .3s;
}
.sr-tier-card:hover { transform:translateY(-8px); box-shadow:0 20px 50px rgba(0,6,102,.12); }
.sr-tier-card.dark { background:var(--c-pri); color:#fff; }
.sr-tier-card.dark .tc-desc,
.sr-tier-card.dark .tc-pts-unit,
.sr-tier-card.dark .tc-benefit { color:rgba(255,255,255,.65); }
.sr-tier-card.dark .tc-pts-num { color:#fff; }
.sr-tier-card.dark .tc-bar-bg { background:rgba(255,255,255,.1); }
.sr-tier-card.current { box-shadow:0 0 0 2px var(--c-sec),0 8px 32px rgba(0,6,102,.1); }

/* Floating icon box (top-left) */
.tc-icon {
    position:absolute; top:-16px; left:-16px;
    width:64px; height:64px; border-radius:8px;
    display:flex; align-items:center; justify-content:center;
    transform:rotate(12deg); transition:transform .3s;
}
.sr-tier-card:hover .tc-icon { transform:rotate(0deg); }
.tc-icon .ms { font-size:28px; }
.tc-icon .fa  { font-size:24px; }
.tc-tier-img {
    width:100px;
    height:100px;
    object-fit:contain;
    display:block;
}

/* Tier icon clickable */
.tc-icon-btn { cursor:pointer; }
.tc-icon-btn:focus { outline:none; box-shadow:0 0 0 3px rgba(118,90,34,.5); border-radius:8px; }

/* Benefits popup */
.tc-benefits-popup {
    display:none;
    position:absolute; top:52px; left:12px;
    background:var(--c-surf-0); border-radius:10px; padding:16px 18px;
    box-shadow:0 8px 32px rgba(0,6,102,.18); border:1px solid var(--c-out);
    min-width:200px; max-width:280px; z-index:200; text-align:left;
}
.tc-pop-dark { background:var(--c-pri-c) !important; border-color:rgba(255,255,255,.15) !important; color:#fff; }
.tc-benefits-popup.open { display:block; }
.tc-pop-title { font-size:.75rem; font-weight:900; letter-spacing:1.5px; text-transform:uppercase;
                margin-bottom:10px; color:var(--c-ink-v); }
.tc-pop-dark .tc-pop-title { color:rgba(255,255,255,.5); }
.tc-pop-list { list-style:none; padding:0; margin:0; }
.tc-pop-item { display:flex; align-items:center; gap:10px; padding:7px 0;
               border-bottom:1px solid var(--c-surf-hi); font-size:.875rem; }
.tc-pop-item:last-child { border-bottom:none; }
.tc-pop-dark .tc-pop-item { border-color:rgba(255,255,255,.1); }
.tc-pop-item .fa { font-size:14px; flex-shrink:0; }
.tc-pop-empty { font-size:.85rem; color:var(--c-ink-v); }

/* Tier badge (top-right) */
.tc-badge {
    position:absolute; top:12px; right:12px;
    font-size:10px; font-weight:900; letter-spacing:1px;
    padding:4px 8px; border-radius:4px; text-transform:uppercase;
}
.tc-badge.popular { background:var(--c-sec-c); color:#5c420c; }
.tc-badge.you     { background:var(--c-sec);   color:#fff; }

.tc-name { font-size:1.5rem; font-weight:900; margin:36px 0 4px; }
.sr-tier-card.dark .tc-name { color:#fff; }
.tc-desc { font-size:.875rem; color:var(--c-ink-v); margin-bottom:24px; }
.tc-pts-wrap { margin-bottom:24px; }
.tc-pts-num  { font-size:2.5rem; font-weight:900; line-height:1; color:var(--c-ink); }
.tc-pts-unit { font-size:.9rem; color:var(--c-ink-v); }
.tc-benefits { list-style:none; padding:0; margin:0 0 24px; }
.tc-benefit  { display:flex; align-items:flex-start; gap:10px;
               font-size:.875rem; color:var(--c-ink-v); padding:5px 0; }
.tc-benefit .ms { font-size:16px; flex-shrink:0; margin-top:1px; }
.tc-benefit .fa  { font-size:16px; flex-shrink:0; margin-top:1px; }
.tc-bar-bg { width:100%; height:12px; background:var(--c-surf-hi); border-radius:8px; overflow:hidden; }
.tc-bar-fill { height:100%; border-radius:8px; transition:width .5s ease; }
.tc-bar-label { font-size:10px; font-weight:900; letter-spacing:1px;
                text-transform:uppercase; margin-top:6px; text-align:right; display:block; }

/* ── Result Hero ── */
.sr-result-hero {
    background: linear-gradient(135deg,#000666 0%,#1a237e 100%);
    padding: 48px 32px 96px;
    position: relative;
    overflow: hidden;
}
.sr-rc { max-width:1100px; margin:0 auto; position:relative; z-index:1; }
.sr-breadcrumb { display:flex; align-items:center; gap:6px;
                 color:rgba(255,255,255,.5); font-size:.85rem; margin-bottom:24px; }
.sr-breadcrumb a    { color:rgba(255,255,255,.5); text-decoration:none; }
.sr-breadcrumb a:hover { color:rgba(255,255,255,.85); }
.sr-breadcrumb .ms  { font-size:14px; }
.sr-result-top { display:flex; flex-wrap:wrap; justify-content:space-between;
                 align-items:flex-start; gap:24px; }
.sr-cust-name {
    font-size: clamp(1.75rem,4vw,3rem);
    font-weight: 900; color:#fff; letter-spacing:-.5px; margin-bottom:14px;
}
.sr-cust-meta { display:flex; flex-wrap:wrap; gap:20px; }
.sr-meta-item { display:flex; align-items:center; gap:8px;
                color:rgba(255,255,255,.75); font-weight:500; font-size:.9rem; }
.sr-meta-item .ms { color:var(--c-sec-c); font-size:18px; }

/* Balance glass pill */
.sr-bal-pill {
    background: rgba(255,255,255,.1);
    backdrop-filter: blur(20px); -webkit-backdrop-filter:blur(20px);
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 60px;
    padding: 20px 32px 20px 20px;
    display: flex; align-items:center; gap:20px; flex-shrink:0;
}
.sr-bal-avatar {
    position:relative; width:80px; height:80px; border-radius:50%;
    border:4px solid rgba(118,90,34,.3); background:rgba(118,90,34,.1);
    display:flex; align-items:center; justify-content:center; flex-shrink:0;
}
.sr-bal-avatar .ms { color:var(--c-sec-c); font-size:36px; }
.sr-bal-avatar-img {
    width:46px;
    height:46px;
    object-fit:contain;
    display:block;
}
.sr-bal-tier-tag {
    position:absolute; bottom:-4px; right:-4px;
    background:#fff; color:var(--c-pri);
    font-size:9px; font-weight:900;
    padding:2px 8px; border-radius:99px;
    box-shadow:0 2px 8px rgba(0,0,0,.2); white-space:nowrap;
}
.sr-bal-lbl  { color:rgba(255,255,255,.5); font-size:10px; font-weight:700;
               letter-spacing:2px; text-transform:uppercase; margin-bottom:4px; }
.sr-bal-num  { font-family:'Manrope',sans-serif; font-size:2.5rem;
               font-weight:900; color:#fff; line-height:1; }
.sr-bal-unit { color:var(--c-sec-c); font-weight:700; font-size:1rem; }
.sr-wm { position:absolute; right:-60px; top:-60px; opacity:.06; pointer-events:none; }

/* ── Result Body ── */
.sr-body { max-width:1100px; margin:-64px auto 0; padding:0 32px 80px; position:relative; z-index:10; }
.sr-main-row { display:grid; grid-template-columns:2fr 1fr; gap:24px; margin-bottom:40px; }

/* White card */
.sr-card {
    background:var(--c-surf-0); border-radius:12px; padding:32px;
    box-shadow:0 4px 24px rgba(0,6,102,.06); position:relative; overflow:hidden;
}
.sr-card-title { font-size:1.375rem; font-weight:800; color:var(--c-pri); margin-bottom:4px; }
.sr-card-sub   { color:var(--c-ink-v); font-size:.9rem; margin:0; line-height:1.5; }
.sr-card-sub strong { color:var(--c-pri); font-weight:700; }

.sr-pc-header { display:flex; justify-content:space-between; align-items:flex-end; gap:16px; margin-bottom:24px; }
.sr-pc-need { text-align:right; flex-shrink:0; }
.sr-pc-need-lbl { font-size:.8rem; font-weight:700; color:var(--c-ink-v); }
.sr-pc-need-num { font-family:'Manrope',sans-serif; font-size:1.5rem; font-weight:900; color:var(--c-sec); }
.sr-prog-bg { width:100%; height:16px; background:var(--c-surf-hi); border-radius:8px;
              overflow:hidden; margin-bottom:10px; }
.sr-prog-fill { height:100%; border-radius:8px;
                box-shadow:0 0 15px rgba(118,90,34,.4); transition:width .8s ease; }
.sr-prog-labels { display:flex; justify-content:space-between;
                  font-size:10px; font-weight:900; letter-spacing:1px;
                  text-transform:uppercase; color:var(--c-ink-v); }
.sr-ghost { position:absolute; right:-40px; bottom:-40px; opacity:.03; pointer-events:none; }

/* Top-tier reached card */
.sr-top-tier { text-align:center; padding:48px 32px; }

/* Quick actions panel */
.sr-actions {
    background: var(--c-pri); color:#fff; border-radius:12px; padding:32px;
    display:flex; flex-direction:column;
}
.sr-actions-title { font-size:1.1rem; font-weight:800; margin-bottom:20px; }
.sr-actions-grid  { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
.sr-act-btn {
    background:rgba(255,255,255,.1); border:none; border-radius:8px;
    padding:16px; display:flex; flex-direction:column; align-items:center; gap:8px;
    color:#fff; font-size:.8rem; font-weight:600; font-family:'Inter',sans-serif;
    cursor:default; text-decoration:none; transition:background .2s;
}
.sr-act-btn:hover { background:rgba(255,255,255,.18); color:#fff; }
.sr-act-btn .ms { color:var(--c-sec-c); font-size:22px; }

/* ── History Table ── */
.sr-hist-section { margin-bottom:40px; }
.sr-hist-header  { display:flex; justify-content:space-between; align-items:center;
                   padding:0 4px; margin-bottom:20px; }
.sr-hist-title   { font-size:1.375rem; font-weight:800; color:var(--c-pri); }
.sr-tbl-wrap { background:var(--c-surf-0); border-radius:12px;
               box-shadow:0 4px 24px rgba(0,6,102,.06); overflow:auto; }
.sr-tbl      { width:100%; border-collapse:collapse; min-width:540px; }
.sr-tbl th   { padding:16px 24px; font-size:10px; font-weight:900;
               text-transform:uppercase; letter-spacing:2px; color:var(--c-ink-v);
               background:var(--c-surf-lo); text-align:left; white-space:nowrap; }
.sr-tbl td   { padding:18px 24px; border-top:1px solid var(--c-surf-hi); }
.sr-tbl tr:hover td { background:var(--c-surf); }
.td-date     { font-weight:700; color:var(--c-ink); }
.td-time     { font-size:.75rem; color:var(--c-ink-v); margin-top:2px; }
.sr-badge    { display:inline-flex; align-items:center; gap:5px;
               padding:4px 12px; border-radius:999px; font-size:.75rem; font-weight:700; white-space:nowrap; }
.sr-badge .ms { font-size:13px; }
.badge-earn   { background:#e0e0ff; color:#343d96; }
.badge-redeem { background:#ffd793; color:#5c420c; }
.badge-return { background:#ffdad6; color:#93000a; }
.badge-manual { background:#edeeef; color:#454652; }
.td-pts      { font-family:'Manrope',sans-serif; font-weight:900; font-size:1rem; }
.td-pts.pos  { color:var(--c-sec); }
.td-pts.neg  { color:#ba1a1a; }
.td-desc     { font-size:.875rem; color:var(--c-ink-v); }
.td-status   { font-size:.8rem; font-weight:700; color:var(--c-pri); text-align:right; }
.sr-empty    { padding:48px; text-align:center; color:var(--c-ink-v); }
.sr-empty .ms { font-size:48px; display:block; margin-bottom:12px; opacity:.4; }

/* ── Vouchers ── */
.sr-voucher-section {
    background:var(--c-surf-0); border-radius:12px; padding:24px 32px;
    box-shadow:0 4px 24px rgba(0,6,102,.06); margin-bottom:40px;
}
.sr-vs-title    { font-size:1rem; font-weight:800; margin-bottom:16px; }
.sr-voucher-list { display:flex; flex-wrap:wrap; gap:12px; }
.sr-voucher-pill {
    display:inline-flex; align-items:center; gap:8px;
    background:#f0fff4; border:2px dashed #198754;
    border-radius:8px; padding:10px 16px;
}
.sr-voucher-pill .ms { color:#198754; font-size:18px; }
.sr-v-code { font-family:monospace; font-weight:700; font-size:1rem; color:#198754; }
.sr-v-val  { font-size:.8rem; color:#198754; font-weight:600; }

/* ── Smooth scroll ── */
html { scroll-behavior: smooth; }
.scroll-mt { scroll-margin-top: 32px; }

/* ── Responsive ── */
@media (max-width:900px) {
    .sr-main-row { grid-template-columns:1fr; }
}
@media (max-width:768px) {
    .sr-body { padding:0 16px 60px; margin-top:-48px; }
    .sr-result-hero { padding:32px 20px 80px; }
    .sr-card, .sr-actions { padding:20px; }
    .sr-bal-pill { flex-direction:column; border-radius:16px; align-items:flex-start; }
    .sr-glass { flex-direction:column; border-radius:16px; align-items:stretch; }
    .sr-glass-btn { border-radius:8px; text-align:center; }
    .sr-tbl th,.sr-tbl td { padding:12px 16px; }
    .sr-tier-grid { grid-template-columns:1fr 1fr; gap:20px; }
}
@media (max-width:480px) {
    .sr-tier-grid { grid-template-columns:1fr; }
    .sr-hero { padding:60px 16px 100px; }
}
            </style>
        </t>
        <t t-out="0"/>
        <script>
(function () {
    function init() {
        document.querySelectorAll('.tc-icon-btn').forEach(function (btn) {
            btn.addEventListener('click', function (e) {
                e.stopPropagation();
                var card = btn.closest('.sr-tier-card');
                if (!card) return;
                var popup = card.querySelector('.tc-benefits-popup');
                if (!popup) return;
                var isOpen = popup.classList.contains('open');
                document.querySelectorAll('.tc-benefits-popup.open').forEach(function (p) { p.classList.remove('open'); });
                if (!isOpen) popup.classList.add('open');
            });
            btn.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); btn.click(); }
            });
        });
        document.addEventListener('click', function () {
            document.querySelectorAll('.tc-benefits-popup.open').forEach(function (p) { p.classList.remove('open'); });
        });
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                document.querySelectorAll('.tc-benefits-popup.open').forEach(function (p) { p.classList.remove('open'); });
            }
        });
    }
    if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', init); }
    else { init(); }
})();
        </script>
    </t>
</template>

<!-- ===== HOME PAGE ===== -->
<template id="loyalty_public_home" name="Tra cuu Loyalty">
    <t t-call="hlv_loyalty.loyalty_public_layout">

        <!-- Hero -->
        <section class="sr-hero">
            <div class="sr-hero-inner">
                <h1 class="sr-hero-title">Trang tra cứu hạng khách hàng</h1>
                <p class="sr-hero-sub">Khám phá đặc quyền và hành trình thăng hạng của bạn tại Hoàng Long Vũ.</p>
                <div class="sr-search-wrap">
                    <form action="/loyalty/search" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="sr-glass">
                            <div class="sr-glass-field">
                                <span class="ms">person_search</span>
                                <input type="text" name="keyword" autocomplete="off"
                                       placeholder="Nhập số điện thoại hoặc email của bạn..."
                                       t-att-value="keyword or ''"/>
                            </div>
                            <button type="submit" class="sr-glass-btn">Tra cứu ngay</button>
                        </div>
                    </form>
                    <div class="sr-search-hints">
                        <span class="sr-hint">
                            <span class="ms ms-fill ms-sm">check_circle</span> Bảo mật thông tin
                        </span>
                        <span class="sr-hint">
                            <span class="ms ms-fill ms-sm">check_circle</span> Kết quả tức thì
                        </span>
                    </div>
                    <t t-if="error"><div class="sr-error"><t t-out="error"/></div></t>
                </div>
            </div>
        </section>

        <!-- Tier Cards -->
        <section class="sr-section">
            <div class="sr-cont">
                <h2 class="sr-sec-title">Hệ thống cấp bậc thành viên</h2>
                <div class="sr-divider"></div>
                <div class="sr-tier-grid">
                    <t t-foreach="tiers" t-as="tier">
                        <t t-set="is_dark"    t-value="tier_last"/>
                        <t t-set="is_popular" t-value="not tier_last and not tier_first and tier_index == tier_size - 2"/>
                        <t t-set="tc_color"   t-value="tier.badge_color or '#cd7f32'"/>
                        <div t-att-class="'sr-tier-card' + (' dark' if is_dark else '')">
                            <t t-if="is_popular">
                                <span class="tc-badge popular">MOST POPULAR</span>
                            </t>
                            <!-- Floating icon (click to view benefits) -->
                            <div t-att-class="'tc-icon tc-icon-btn'"
                                 t-att-style="'background:' + tc_color + ('18' if not is_dark else '; background:rgba(255,255,255,.08)')"
                                 title="Xem quyền lợi hạng" tabindex="0" role="button">
                                <t t-if="tier.image_url">
                                    <img class="tc-tier-img"
                                         t-att-src="tier.image_url"
                                         t-att-alt="tier.name or 'Tier icon'"/>
                                </t>
                                <t t-else="">
                                    <i t-att-class="'fa ' + (tier.icon or 'fa-medal')"
                                       t-att-style="'color:' + ('rgba(255,220,80,.9)' if is_dark else tc_color)"/>
                                </t>
                            </div>
                            <!-- Benefits popup (positioned relative to card) -->
                            <div t-att-class="'tc-benefits-popup' + (' tc-pop-dark' if is_dark else '')">
                                <div class="tc-pop-title">Quyền lợi hạng <t t-out="tier.name"/></div>
                                <t t-if="tier.benefit_ids">
                                    <ul class="tc-pop-list">
                                        <t t-foreach="tier.benefit_ids" t-as="b">
                                            <li class="tc-pop-item">
                                                <i t-att-class="'fa ' + (b.icon or 'fa-check')"
                                                   t-att-style="'color:' + tc_color"/>
                                                <span><t t-out="b.name"/></span>
                                            </li>
                                        </t>
                                    </ul>
                                </t>
                                <t t-else="">
                                    <span class="tc-pop-empty">Chưa có quyền lợi nào.</span>
                                </t>
                            </div>
                            <h3 class="tc-name"><t t-out="tier.name"/></h3>
                            <p class="tc-desc"><t t-out="tier.description or ''"/></p>
                            <div class="tc-pts-wrap">
                                <span class="tc-pts-num"><t t-out="'{:,}'.format(tier.min_points)"/></span>
                                <span class="tc-pts-unit"> điểm</span>
                            </div>
                            <t t-if="tier.benefit_ids">
                                <ul class="tc-benefits">
                                    <t t-foreach="tier.benefit_ids" t-as="b">
                                        <li class="tc-benefit">
                                                          <i t-att-class="'fa ' + (b.icon or 'fa-check')"
                                                              t-att-style="'color:' + tc_color"/>
                                            <t t-out="b.name"/>
                                        </li>
                                    </t>
                                </ul>
                            </t>
                            <div class="tc-bar-bg">
                                <div class="tc-bar-fill"
                                     t-att-style="'background:linear-gradient(90deg,' + tc_color + ',' + tc_color + 'aa); width:' + ('100%' if tier_first else '0%')"/>
                            </div>
                            <t t-if="tier_first">
                                <span class="tc-bar-label" t-att-style="'color:' + tc_color">ACTIVE TIER</span>
                            </t>
                            <t t-elif="tier.min_points">
                                <span class="tc-bar-label" style="color:var(--c-ink-v)">
                                    <t t-out="'{:,}'.format(tier.min_points)"/> PTS TO GO
                                </span>
                            </t>
                        </div>
                    </t>
                </div>
            </div>
        </section>

    </t>
</template>

<!-- ===== RESULT PAGE ===== -->
<template id="loyalty_public_result" name="Ket qua tra cuu Loyalty">
    <t t-call="hlv_loyalty.loyalty_public_layout">

        <!-- Hero -->
        <section class="sr-result-hero">
            <div class="sr-rc">
                <nav class="sr-breadcrumb">
                    <a href="/loyalty">Members</a>
                    <span class="ms ms-sm">chevron_right</span>
                    <span>Trang thông tin chi tiết</span>
                </nav>
                <div class="sr-result-top">
                    <div>
                        <h1 class="sr-cust-name"><t t-out="partner.name"/></h1>
                        <div class="sr-cust-meta">
                            <t t-if="masked_phone">
                                <span class="sr-meta-item">
                                    <span class="ms">call</span>
                                    <t t-out="masked_phone"/>
                                </span>
                            </t>
                            <t t-if="masked_email">
                                <span class="sr-meta-item">
                                    <span class="ms">mail</span>
                                    <t t-out="masked_email"/>
                                </span>
                            </t>
                            <t t-if="partner.ref">
                                <span class="sr-meta-item">
                                    <span class="ms">verified_user</span>
                                    ID: <t t-out="partner.ref"/>
                                </span>
                            </t>
                        </div>
                    </div>
                    <!-- Balance pill -->
                    <div class="sr-bal-pill">
                        <div class="sr-bal-avatar">
                            <t t-if="partner.loyalty_tier_id and partner.loyalty_tier_id.image_url">
                                <img class="sr-bal-avatar-img"
                                     t-att-src="partner.loyalty_tier_id.image_url"
                                     t-att-alt="partner.loyalty_tier_id.name or 'Tier image'"/>
                            </t>
                            <t t-else="">
                                <span class="ms ms-fill ms-lg">workspace_premium</span>
                            </t>
                            <t t-if="partner.loyalty_tier_id">
                                <span class="sr-bal-tier-tag">
                                    <t t-out="(partner.loyalty_tier_id.name or '').upper()"/>
                                </span>
                            </t>
                        </div>
                        <div>
                            <div class="sr-bal-lbl">Current Balance</div>
                            <div>
                                <span class="sr-bal-num"><t t-out="'{:,}'.format(partner.loyalty_total_points)"/></span>
                                <span class="sr-bal-unit"> PTS</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Watermark -->
            <div class="sr-wm" aria-hidden="true">
                <span class="ms ms-xl">stat_3</span>
            </div>
        </section>

        <!-- Body -->
        <div class="sr-body">

            <!-- Row: Progress + Actions -->
            <div class="sr-main-row">
                <!-- Progress card -->
                <t t-if="next_tier">
                    <t t-set="pts"      t-value="partner.loyalty_total_points"/>
                    <t t-set="cur_min"  t-value="partner.loyalty_tier_id.min_points if partner.loyalty_tier_id else 0"/>
                    <t t-set="needed"   t-value="next_tier.min_points - cur_min"/>
                    <t t-set="pct"      t-value="min(100, int((pts - cur_min) * 100 / max(needed, 1)))"/>
                    <t t-set="grad_s"   t-value="partner.loyalty_tier_id.badge_color if partner.loyalty_tier_id else '#cd7f32'"/>
                    <t t-set="grad_e"   t-value="next_tier.badge_color or '#d4a017'"/>
                    <div class="sr-card">
                        <div class="sr-pc-header">
                            <div>
                                <h3 class="sr-card-title">Tiến trình hạng <t t-out="next_tier.name"/></h3>
                                <p class="sr-card-sub">
                                    Tích lũy thêm
                                    <strong><t t-out="'{:,}'.format(next_tier.min_points - pts)"/> điểm</strong>
                                    để thăng hạng
                                </p>
                            </div>
                            <div class="sr-pc-need">
                                <div class="sr-pc-need-lbl">Cần thiết</div>
                                <div class="sr-pc-need-num"><t t-out="'{:,}'.format(next_tier.min_points)"/> PTS</div>
                            </div>
                        </div>
                        <div class="sr-prog-bg">
                            <div class="sr-prog-fill"
                                 t-att-style="'width:' + str(pct) + '%; background:linear-gradient(90deg,' + grad_s + ',' + grad_e + ')'"/>
                        </div>
                        <div class="sr-prog-labels">
                            <span>
                                <t t-out="partner.loyalty_tier_id.name if partner.loyalty_tier_id else 'Mới'"/>
                                (<t t-out="'{:,}'.format(cur_min)"/>)
                            </span>
                            <span>
                                <t t-out="next_tier.name"/> (<t t-out="'{:,}'.format(next_tier.min_points)"/>)
                            </span>
                        </div>
                        <div class="sr-ghost" aria-hidden="true">
                            <span class="ms" style="font-size:200px">trophy</span>
                        </div>
                    </div>
                </t>
                <t t-else="">
                    <div class="sr-card sr-top-tier">
                        <span class="ms ms-lg ms-fill" style="color:var(--c-sec);display:block;margin-bottom:12px;">emoji_events</span>
                        <h3 class="sr-card-title">Chúc mừng!</h3>
                        <p class="sr-card-sub">Bạn đã đạt cấp bậc cao nhất
                            <t t-if="partner.loyalty_tier_id">
                                — <strong><t t-out="partner.loyalty_tier_id.name"/></strong>
                            </t>
                        </p>
                    </div>
                </t>

                <!-- Quick info panel -->
                <div class="sr-actions">
                    <h3 class="sr-actions-title">Thao tác nhanh</h3>
                    <div class="sr-actions-grid">
                        <a href="/loyalty" class="sr-act-btn">
                            <span class="ms">search</span>
                            <span>Tra cứu lại</span>
                        </a>
                        <a href="#loyalty-history" class="sr-act-btn">
                            <span class="ms">history</span>
                            <span>Lịch sử</span>
                        </a>
                        <a href="#loyalty-vouchers" class="sr-act-btn">
                            <span class="ms">redeem</span>
                            <t t-if="active_vouchers">
                                <span><t t-out="len(active_vouchers)"/> Voucher</span>
                            </t>
                            <t t-else=""><span>Voucher</span></t>
                        </a>
                        <a href="#loyalty-tiers" class="sr-act-btn">
                            <span class="ms ms-fill">workspace_premium</span>
                            <t t-if="partner.loyalty_tier_id">
                                <span><t t-out="partner.loyalty_tier_id.name"/></span>
                            </t>
                            <t t-else=""><span>Ưu đãi hạng</span></t>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Vouchers -->
            <div id="loyalty-vouchers" class="sr-voucher-section scroll-mt">
                <h3 class="sr-vs-title">
                    <t t-if="active_vouchers">
                        Voucher đang có (<t t-out="len(active_vouchers)"/>)
                    </t>
                    <t t-else="">Voucher của bạn</t>
                </h3>
                <t t-if="active_vouchers">
                    <div class="sr-voucher-list">
                        <t t-foreach="active_vouchers" t-as="v">
                            <div class="sr-voucher-pill">
                                <span class="ms">confirmation_number</span>
                                <span class="sr-v-code"><t t-out="v.code"/></span>
                                <span class="sr-v-val">
                                    <t t-if="v.reward_type == 'free_shipping'">
                                        Miễn phí vận chuyển
                                    </t>
                                    <t t-elif="v.reward_type == 'gift'">
                                        Quà tặng kèm
                                        <t t-if="v.gift_product_id">
                                            (<t t-out="v.gift_qty"/> x <t t-out="v.gift_product_id.name"/>)
                                        </t>
                                    </t>
                                    <t t-elif="v.discount_type == 'fixed'">
                                        – <t t-out="'{:,.0f}'.format(v.discount_value)"/>đ
                                    </t>
                                    <t t-else="">– <t t-out="v.discount_value"/>%
                                        <t t-if="v.max_discount_amount">
                                            (tối đa <t t-out="'{:,.0f}'.format(v.max_discount_amount)"/>đ)
                                        </t>
                                    </t>
                                    <t t-if="v.date_expiry">
                                        · HSD <t t-out="v.date_expiry.strftime('%d/%m/%Y')"/>
                                    </t>
                                </span>
                            </div>
                        </t>
                    </div>
                </t>
                <t t-else="">
                    <div class="sr-empty" style="padding:24px">
                        <span class="ms" style="font-size:36px;display:block;margin-bottom:8px;opacity:.4">redeem</span>
                        <p style="margin:0;font-size:.9rem">Bạn chưa có Voucher nào. Tích điểm để đổi Voucher!</p>
                    </div>
                </t>
            </div>

            <!-- History -->
            <div id="loyalty-history" class="sr-hist-section scroll-mt">
                <div class="sr-hist-header">
                    <h3 class="sr-hist-title">Lịch sử tích lũy gần đây</h3>
                </div>
                <div class="sr-tbl-wrap">
                    <t t-if="recent_history">
                        <table class="sr-tbl">
                            <thead>
                                <tr>
                                    <th>Ngày giao dịch</th>
                                    <th>Loại hình</th>
                                    <th>Số điểm</th>
                                    <th>Nội dung chi tiết</th>
                                    <th style="text-align:right">Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="recent_history" t-as="h">
                                    <tr>
                                        <td>
                                            <div class="td-date"><t t-out="h.date.strftime('%d Thg %m, %Y')"/></div>
                                            <div class="td-time"><t t-out="h.date.strftime('%H:%M')"/></div>
                                        </td>
                                        <td>
                                            <t t-if="h.transaction_type == 'earn'">
                                                <span class="sr-badge badge-earn">
                                                    <span class="ms">shopping_bag</span> Mua hàng
                                                </span>
                                            </t>
                                            <t t-elif="h.transaction_type == 'redeem'">
                                                <span class="sr-badge badge-redeem">
                                                    <span class="ms">redeem</span> Đổi Voucher
                                                </span>
                                            </t>
                                            <t t-elif="h.transaction_type == 'return'">
                                                <span class="sr-badge badge-return">
                                                    <span class="ms">undo</span> Hoàn hàng
                                                </span>
                                            </t>
                                            <t t-else="">
                                                <span class="sr-badge badge-manual">
                                                    <span class="ms">edit_note</span> Thủ công
                                                </span>
                                            </t>
                                        </td>
                                        <td t-att-class="'td-pts ' + ('pos' if h.point_amount > 0 else 'neg')">
                                            <t t-out="('+' if h.point_amount > 0 else '') + '{:,}'.format(h.point_amount)"/>
                                        </td>
                                        <td class="td-desc"><t t-out="h.description or ''"/></td>
                                        <td class="td-status">Hoàn tất</td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                    <t t-else="">
                        <div class="sr-empty">
                            <span class="ms">inbox</span>
                            <p>Chưa có giao dịch điểm nào.</p>
                        </div>
                    </t>
                </div>
            </div>
        </div>

        <!-- Tier reference footer -->
        <section id="loyalty-tiers" class="sr-section sr-section-bg scroll-mt">
            <div class="sr-cont">
                <h2 class="sr-sec-title">Hệ thống cấp bậc thành viên</h2>
                <div class="sr-divider"></div>
                <div class="sr-tier-grid">
                    <t t-foreach="tiers" t-as="tier">
                        <t t-set="is_dark"    t-value="tier_last"/>
                        <t t-set="is_current" t-value="partner.loyalty_tier_id and tier.id == partner.loyalty_tier_id.id"/>
                        <t t-set="tc_color"   t-value="tier.badge_color or '#cd7f32'"/>
                        <div t-att-class="'sr-tier-card' + (' dark' if is_dark else '') + (' current' if is_current else '')">
                            <t t-if="is_current">
                                <span class="tc-badge you">BẠN</span>
                            </t>
                            <!-- Floating icon (click to view benefits) -->
                            <div t-att-class="'tc-icon tc-icon-btn'"
                                 t-att-style="'background:' + tc_color + ('18' if not is_dark else '; background:rgba(255,255,255,.08)')"
                                 title="Xem quyền lợi hạng" tabindex="0" role="button">
                                <t t-if="tier.image_url">
                                    <img class="tc-tier-img"
                                         t-att-src="tier.image_url"
                                         t-att-alt="tier.name or 'Tier icon'"/>
                                </t>
                                <t t-else="">
                                    <i t-att-class="'fa ' + (tier.icon or 'fa-medal')"
                                       t-att-style="'color:' + ('rgba(255,220,80,.9)' if is_dark else tc_color)"/>
                                </t>
                            </div>
                            <!-- Benefits popup (positioned relative to card) -->
                            <div t-att-class="'tc-benefits-popup' + (' tc-pop-dark' if is_dark else '')">
                                <div class="tc-pop-title">Quyền lợi hạng <t t-out="tier.name"/></div>
                                <t t-if="tier.benefit_ids">
                                    <ul class="tc-pop-list">
                                        <t t-foreach="tier.benefit_ids" t-as="b">
                                            <li class="tc-pop-item">
                                                <i t-att-class="'fa ' + (b.icon or 'fa-check')"
                                                   t-att-style="'color:' + tc_color"/>
                                                <span><t t-out="b.name"/></span>
                                            </li>
                                        </t>
                                    </ul>
                                </t>
                                <t t-else="">
                                    <span class="tc-pop-empty">Chưa có quyền lợi nào.</span>
                                </t>
                            </div>
                            <h3 class="tc-name"><t t-out="tier.name"/></h3>
                            <p class="tc-desc"><t t-out="tier.description or ''"/></p>
                            <div class="tc-pts-wrap">
                                <span class="tc-pts-num"><t t-out="'{:,}'.format(tier.min_points)"/></span>
                                <span class="tc-pts-unit"> điểm</span>
                            </div>
                            <t t-if="tier.benefit_ids">
                                <ul class="tc-benefits">
                                    <t t-foreach="tier.benefit_ids" t-as="b">
                                        <li class="tc-benefit">
                                                          <i t-att-class="'fa ' + (b.icon or 'fa-check')"
                                                              t-att-style="'color:' + tc_color"/>
                                            <t t-out="b.name"/>
                                        </li>
                                    </t>
                                </ul>
                            </t>
                        </div>
                    </t>
                </div>
            </div>
        </section>

    </t>
</template>

</odoo>
