<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="loyalty_public_layout" name="Loyalty Public Layout">
    <t t-call="web.layout">
        <t t-set="head">
            <style>
                body { background: #f4f6f9; font-family: 'Segoe UI', sans-serif; }
                .loyalty-hero {
                    background: linear-gradient(135deg, #1a2342 0%, #2d3f6e 60%, #c8a415 100%);
                    color: #fff;
                    padding: 48px 0 36px;
                    text-align: center;
                }
                .loyalty-hero h1 { font-size: 2.2rem; font-weight: 800; letter-spacing: 1px; }
                .loyalty-hero p { opacity: .85; font-size: 1.05rem; }
                .search-box {
                    background: #fff;
                    border: 2px solid #dee2e6;
                    padding: 32px;
                    max-width: 560px;
                    margin: -28px auto 0;
                    position: relative;
                    z-index: 2;
                }
                .tier-card {
                    border: 2px solid #dee2e6;
                    padding: 20px;
                    text-align: center;
                    background: #fff;
                    transition: box-shadow .2s;
                }
                .tier-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,.1); }
                .tier-badge {
                    display: inline-block;
                    padding: 6px 18px;
                    font-weight: 700;
                    font-size: .85rem;
                    letter-spacing: 1px;
                    text-transform: uppercase;
                    color: #fff;
                }
                .points-bar { height: 10px; background: #e9ecef; }
                .points-bar-fill { height: 100%; transition: width .6s; }
                .result-card { background: #fff; border: 2px solid #dee2e6; padding: 28px; }
                .history-row-earn { color: #198754; }
                .history-row-deduct { color: #dc3545; }
                .voucher-pill {
                    display: inline-block;
                    border: 2px dashed #198754;
                    padding: 8px 16px;
                    font-family: monospace;
                    font-size: 1.1rem;
                    font-weight: 700;
                    color: #198754;
                    background: #f0fff4;
                    margin: 4px;
                }
            </style>
        </t>
        <t t-out="0"/>
    </t>
</template>

<!-- Trang chủ tra cứu -->
<template id="loyalty_public_home" name="Tra cứu Loyalty">
    <t t-call="hlv_loyalty.loyalty_public_layout">
        <!-- Hero -->
        <div class="loyalty-hero">
            <div class="container">
                <h1><i class="fa fa-star me-2"/>Chương trình Khách hàng thân thiết</h1>
                <p>Tích điểm mỗi đơn hàng, đổi ưu đãi hấp dẫn</p>
            </div>
        </div>

        <div class="container py-5">
            <!-- Search box -->
            <div class="search-box shadow-sm mb-5">
                <h5 class="fw-bold mb-3 text-center">Tra cứu điểm &amp; hạng thành viên</h5>
                <form action="/loyalty/search" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="input-group">
                        <input type="text" name="keyword" class="form-control form-control-lg"
                               placeholder="Nhập số điện thoại hoặc email..."
                               t-att-value="keyword or ''"/>
                        <button type="submit" class="btn btn-warning btn-lg fw-bold px-4">
                            <i class="fa fa-search me-1"/> Tra cứu
                        </button>
                    </div>
                    <t t-if="error">
                        <div class="alert alert-danger mt-3 mb-0">
                            <i class="fa fa-exclamation-circle me-1"/><t t-out="error"/>
                        </div>
                    </t>
                </form>
            </div>

            <!-- Bảng hạng thành viên -->
            <h5 class="fw-bold text-uppercase mb-3"
                style="letter-spacing:1px; color:#6c757d; border-bottom:2px solid #dee2e6; padding-bottom:8px;">
                Các hạng thành viên
            </h5>
            <div class="row g-3 mb-5">
                <t t-foreach="tiers" t-as="tier">
                    <div class="col-6 col-md-3">
                        <div class="tier-card">
                            <div class="tier-badge mb-3"
                                 t-att-style="'background-color:' + (tier.badge_color or '#cd7f32')">
                                <t t-if="tier.image_url">
                                    <img t-att-src="tier.image_url" style="height:24px; vertical-align:middle; margin-right:4px;" t-att-alt="tier.name"/>
                                </t>
                                <t t-else="">
                                    <i t-att-class="'fa ' + (tier.icon or 'fa-medal') + ' me-1'"/>
                                </t>
                                <t t-out="tier.name"/>
                            </div>
                            <div class="text-muted small fw-bold mb-1">
                                Từ <span class="text-dark"><t t-out="'{:,}'.format(tier.min_points)"/></span> điểm
                            </div>
                            <div class="text-muted small"><t t-out="tier.description or ''"/></div>
                            <t t-if="tier.benefit_ids">
                                <ul class="text-start small mt-3 mb-0 ps-3">
                                    <t t-foreach="tier.benefit_ids" t-as="b">
                                        <li><i t-att-class="'fa ' + (b.icon or 'fa-check') + ' text-success me-1'"/>
                                            <t t-out="b.name"/>
                                        </li>
                                    </t>
                                </ul>
                            </t>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>
</template>

<!-- Trang kết quả -->
<template id="loyalty_public_result" name="Kết quả tra cứu Loyalty">
    <t t-call="hlv_loyalty.loyalty_public_layout">
        <div class="loyalty-hero">
            <div class="container">
                <h1><i class="fa fa-star me-2"/>Thông tin thành viên</h1>
                <p>Chương trình Khách hàng thân thiết</p>
            </div>
        </div>

        <div class="container py-5">
            <!-- Nút tra cứu lại -->
            <div class="mb-4">
                <a href="/loyalty" class="btn btn-outline-secondary btn-sm">
                    <i class="fa fa-arrow-left me-1"/> Tra cứu lại
                </a>
            </div>

            <div class="row g-4">
                <!-- Cột trái: thông tin tổng quan -->
                <div class="col-md-4">
                    <div class="result-card mb-4">
                        <h6 class="fw-bold text-uppercase small mb-3"
                            style="letter-spacing:1px; color:#6c757d;">Khách hàng</h6>
                        <div class="fs-5 fw-bold mb-1"><t t-out="partner.name"/></div>
                        <div class="text-muted small mb-3">
                            <t t-if="partner.phone">
                                <i class="fa fa-phone me-1"/><t t-out="partner.phone"/><br/>
                            </t>
                            <t t-if="partner.email">
                                <i class="fa fa-envelope me-1"/><t t-out="partner.email"/>
                            </t>
                        </div>

                        <!-- Hạng thành viên -->
                        <t t-if="partner.loyalty_tier_id">
                        <div class="tier-badge w-100 d-block text-center py-2 mb-3"
                                 t-att-style="'background-color:' + (partner.loyalty_tier_id.badge_color or '#cd7f32')">
                                <t t-if="partner.loyalty_tier_id.image_url">
                                    <img t-att-src="partner.loyalty_tier_id.image_url"
                                         style="height:22px; vertical-align:middle; margin-right:6px;"
                                         t-att-alt="partner.loyalty_tier_id.name"/>
                                </t>
                                Hạng <t t-out="partner.loyalty_tier_id.name"/>
                            </div>
                        </t>

                        <!-- Điểm to -->
                        <div class="text-center py-3 border"
                             style="background:#fffbea;">
                            <div class="text-muted small fw-bold text-uppercase"
                                 style="letter-spacing:1px;">Tổng điểm tích lũy</div>
                            <div class="fw-bold" style="font-size:3rem; color:#d4af37; line-height:1.1">
                                <t t-out="'{:,}'.format(partner.loyalty_total_points)"/>
                            </div>
                            <div class="text-muted small">điểm</div>
                        </div>

                        <!-- Progress lên hạng kế -->
                        <t t-if="next_tier">
                            <div class="mt-3">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="text-muted">Tiến đến hạng</span>
                                    <span class="fw-bold"><t t-out="next_tier.name"/></span>
                                </div>
                                <div class="points-bar">
                                    <t t-set="pct" t-value="min(100, int(partner.loyalty_total_points * 100 / next_tier.min_points)) if next_tier.min_points else 100"/>
                                    <div class="points-bar-fill"
                                         t-att-style="'width:' + str(pct) + '%; background:' + (next_tier.badge_color or '#cd7f32')"/>
                                </div>
                                <div class="text-muted small mt-1 text-end">
                                    Cần thêm
                                    <strong><t t-out="'{:,}'.format(next_tier.min_points - partner.loyalty_total_points)"/></strong>
                                    điểm
                                </div>
                            </div>
                        </t>
                    </div>

                    <!-- Voucher đang có -->
                    <t t-if="active_vouchers">
                        <div class="result-card">
                            <h6 class="fw-bold text-uppercase small mb-3"
                                style="letter-spacing:1px; color:#6c757d;">
                                <i class="fa fa-ticket me-1"/>Voucher đang có
                                (<t t-out="len(active_vouchers)"/>)
                            </h6>
                            <t t-foreach="active_vouchers" t-as="v">
                                <div>
                                    <span class="voucher-pill"><t t-out="v.code"/></span>
                                    <span class="small text-muted ms-1">
                                        <t t-if="v.discount_type == 'fixed'">
                                            Giảm <t t-out="'{:,.0f}'.format(v.discount_value)"/> đ
                                        </t>
                                        <t t-else="">
                                            Giảm <t t-out="v.discount_value"/>%
                                        </t>
                                        <t t-if="v.date_expiry">
                                            · HSD: <t t-out="v.date_expiry.strftime('%d/%m/%Y')"/>
                                        </t>
                                    </span>
                                </div>
                            </t>
                        </div>
                    </t>
                </div>

                <!-- Cột phải: lịch sử -->
                <div class="col-md-8">
                    <div class="result-card">
                        <h6 class="fw-bold text-uppercase small mb-3"
                            style="letter-spacing:1px; color:#6c757d;">
                            <i class="fa fa-history me-1"/>Lịch sử điểm gần nhất
                        </h6>
                        <t t-if="recent_history">
                            <table class="table table-sm table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Ngày</th>
                                        <th>Loại</th>
                                        <th class="text-end">Điểm</th>
                                        <th>Mô tả</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="recent_history" t-as="h">
                                        <tr t-att-class="'history-row-earn' if h.point_amount > 0 else 'history-row-deduct'">
                                            <td class="small"><t t-out="h.date.strftime('%d/%m/%Y')"/></td>
                                            <td>
                                                <t t-if="h.transaction_type == 'earn'">
                                                    <span class="badge bg-success">Tích điểm</span>
                                                </t>
                                                <t t-elif="h.transaction_type == 'redeem'">
                                                    <span class="badge bg-warning text-dark">Đổi Voucher</span>
                                                </t>
                                                <t t-elif="h.transaction_type == 'return'">
                                                    <span class="badge bg-danger">Hoàn hàng</span>
                                                </t>
                                                <t t-else="">
                                                    <span class="badge bg-info">Thủ công</span>
                                                </t>
                                            </td>
                                            <td class="text-end fw-bold">
                                                <t t-out="('+' if h.point_amount > 0 else '') + str(h.point_amount)"/>
                                            </td>
                                            <td class="small text-muted"><t t-out="h.description or ''"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <div class="text-muted text-center py-4">
                                <i class="fa fa-inbox fa-2x mb-2 d-block"/>
                                Chưa có giao dịch điểm nào.
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </div>
    </t>
</template>
</odoo>
