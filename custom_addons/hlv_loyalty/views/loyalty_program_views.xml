<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_loyalty_program_form" model="ir.ui.view">
        <field name="name">hlv.loyalty.program.form</field>
        <field name="model">hlv.loyalty.program</field>
        <field name="arch" type="xml">
            <form string="Chương trình Loyalty">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Tên chương trình..."/>
                        </h1>
                    </div>
                    <field name="currency_id" invisible="1"/>

                    <!-- Banner công thức tích điểm -->
                    <div class="row g-0 mb-4 border">
                        <div class="col bg-primary text-white p-4 text-center">
                            <div class="fw-bold small text-uppercase mb-2"
                                 style="letter-spacing:1px; opacity:.8">Mỗi</div>
                            <div class="fs-2 fw-bold">
                                <field name="earning_amount" widget="monetary"
                                       options="{'currency_field': 'currency_id'}"
                                       nolabel="1"/>
                            </div>
                            <div class="small mt-1" style="opacity:.85">chi tiêu</div>
                        </div>
                        <div class="col-auto d-flex align-items-center justify-content-center
                                    px-4 bg-light border-start border-end text-muted fw-bold fs-2">
                            →
                        </div>
                        <div class="col bg-success text-white p-4 text-center">
                            <div class="fw-bold small text-uppercase mb-2"
                                 style="letter-spacing:1px; opacity:.8">Nhận được</div>
                            <div class="fs-2 fw-bold">
                                <field name="earning_points" nolabel="1"/>
                            </div>
                            <div class="small mt-1" style="opacity:.85">điểm tích lũy</div>
                        </div>
                        <div class="col bg-info text-white p-4 text-center">
                            <div class="fw-bold small text-uppercase mb-2"
                                 style="letter-spacing:1px; opacity:.8">Voucher có hạn</div>
                            <div class="fs-2 fw-bold">
                                <field name="voucher_validity_days" nolabel="1"/>
                            </div>
                            <div class="small mt-1" style="opacity:.85">ngày</div>
                        </div>
                    </div>

                    <group>
                        <group string="Cấu hình chi tiết">
                            <field name="discount_per_point"/>
                            <field name="earning_amount" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="earning_points"/>
                            <field name="voucher_validity_days"/>
                        </group>
                        <group string="Hệ thống">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Gói đổi Voucher" name="voucher_packages">
                            <field name="voucher_package_ids">
                                <list editable="bottom" decoration-muted="not active">
                                    <field name="name"/>
                                    <field name="points_required"/>
                                    <field name="discount_type" widget="badge"
                                           decoration-success="discount_type == 'fixed'"
                                           decoration-info="discount_type == 'percent'"/>
                                    <field name="discount_value"/>
                                    <field name="max_discount_amount"
                                           invisible="discount_type != 'percent'"/>
                                    <field name="apply_on"/>
                                    <field name="min_order_amount"/>
                                    <field name="validity_days"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Ghi chú" name="notes">
                            <field name="note" placeholder="Ghi chú về chương trình..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_loyalty_program_list" model="ir.ui.view">
        <field name="name">hlv.loyalty.program.list</field>
        <field name="model">hlv.loyalty.program</field>
        <field name="arch" type="xml">
            <list string="Chương trình Loyalty" decoration-muted="not active">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="earning_amount" string="Mỗi (đ)"/>
                <field name="earning_points" string="= Điểm"/>
                <field name="voucher_validity_days" string="Hạn Voucher (ngày)"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_loyalty_program" model="ir.actions.act_window">
        <field name="name">Chương trình Loyalty</field>
        <field name="res_model">hlv.loyalty.program</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo chương trình Khách hàng thân thiết đầu tiên!
            </p>
        </field>
    </record>
</odoo>
