<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_loyalty_voucher_form" model="ir.ui.view">
        <field name="name">loyalty.voucher.form</field>
        <field name="model">loyalty.voucher</field>
        <field name="arch" type="xml">
            <form string="Voucher Loyalty">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="active,used,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="code" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Thông tin Voucher">
                            <field name="partner_id"/>
                            <field name="package_id"/>
                            <field name="program_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Giá trị &amp; Thời hạn">
                            <field name="discount_type"/>
                            <field name="discount_value"/>
                            <field name="max_discount_amount"
                                   invisible="discount_type != 'percent'"/>
                            <field name="min_order_amount"/>
                            <field name="date_issued"/>
                            <field name="date_expiry"/>
                        </group>
                    </group>
                    <group string="Thông tin sử dụng"
                           invisible="state != 'used'">
                        <group>
                            <field name="used_sale_order_id"/>
                            <field name="used_date"/>
                            <field name="used_company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_loyalty_voucher_list" model="ir.ui.view">
        <field name="name">loyalty.voucher.list</field>
        <field name="model">loyalty.voucher</field>
        <field name="arch" type="xml">
            <list string="Voucher Loyalty"
                  decoration-muted="state == 'expired' or state == 'cancelled'"
                  decoration-success="state == 'active'"
                  decoration-info="state == 'used'">
                <field name="code" widget="badge"/>
                <field name="partner_id"/>
                <field name="package_id"/>
                <field name="discount_type"/>
                <field name="discount_value"/>
                <field name="date_issued"/>
                <field name="date_expiry"
                       decoration-danger="date_expiry and date_expiry &lt; current_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-info="state == 'used'"
                       decoration-muted="state == 'expired'"
                       decoration-danger="state == 'cancelled'"/>
                <field name="used_sale_order_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_loyalty_voucher_search" model="ir.ui.view">
        <field name="name">loyalty.voucher.search</field>
        <field name="model">loyalty.voucher</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm Voucher">
                <field name="code"/>
                <field name="partner_id"/>
                <field name="package_id"/>
                <filter string="Khả dụng" name="filter_active"
                        domain="[('state', '=', 'active')]"/>
                <filter string="Đã sử dụng" name="filter_used"
                        domain="[('state', '=', 'used')]"/>
                <filter string="Hết hạn" name="filter_expired"
                        domain="[('state', '=', 'expired')]"/>
                <separator/>
                <filter string="Sắp hết hạn (7 ngày)" name="filter_expiring_soon"
                        domain="[('state', '=', 'active'), ('date_expiry', '!=', False), ('date_expiry', '&lt;=', (context_today() + datetime.timedelta(days=7)).strftime('%%Y-%%m-%%d'))]"/>
                <separator/>
                <group expand="0" string="Nhóm theo">
                    <filter string="Khách hàng" name="group_partner"
                            context="{'group_by': 'partner_id'}"/>
                    <filter string="Trạng thái" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Gói Voucher" name="group_package"
                            context="{'group_by': 'package_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_loyalty_voucher" model="ir.actions.act_window">
        <field name="name">Voucher</field>
        <field name="res_model">loyalty.voucher</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_loyalty_voucher_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có Voucher nào được phát hành.
            </p>
            <p>Voucher được tạo khi khách hàng đổi điểm tích lũy.</p>
        </field>
    </record>
</odoo>
