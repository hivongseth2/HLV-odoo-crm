<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ================================================================
     loyalty_portal_vouchers_full.xml
     Full active vouchers page at /loyalty/vouchers
================================================================ -->
<template id="loyalty_portal_vouchers_full" name="Loyalty Portal - Toàn bộ Voucher">
    <t t-call="hlv_loyalty.loyalty_public_layout">

        <!-- Top bar -->
        <div class="sr-topbar">
            <a href="/loyalty/dashboard" class="sr-topbar-back">
                <span class="ms" style="font-size:20px">arrow_back</span> Quay về Dashboard
            </a>
            <div class="sr-topbar-right">
                <span class="sr-topbar-name">Xin chào, <strong><t t-out="partner.name"/></strong></span>
                <a href="/loyalty/logout" class="sr-topbar-logout">Đăng xuất</a>
            </div>
        </div>

        <!-- Body -->
        <div class="sr-body" style="padding-top:32px">
            <div class="sr-voucher-section">
                <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:20px">
                    <h3 class="sr-vs-title" style="margin-bottom:0;font-size:1.375rem;color:var(--c-pri)">
                        Voucher đang hiệu lực
                        <t t-if="all_vouchers">
                            (<t t-out="len(all_vouchers)"/> voucher)
                        </t>
                    </h3>
                </div>
                <t t-if="all_vouchers">
                    <div class="sr-voucher-list">
                        <t t-foreach="all_vouchers" t-as="v">
                            <div class="sr-voucher-card">
                                <div class="sr-vc-header">
                                    <span class="ms" style="font-size:28px;color:#198754">confirmation_number</span>
                                    <span class="sr-v-code" style="font-size:1.15rem"><t t-out="v.code"/></span>
                                </div>
                                <div class="sr-vc-value">
                                    <t t-if="v.reward_type == 'free_shipping'">Miễn phí vận chuyển</t>
                                    <t t-elif="v.reward_type == 'gift'">
                                        Quà tặng kèm
                                        <t t-if="v.gift_product_id">
                                            (<t t-out="v.gift_qty"/> x <t t-out="v.gift_product_id.name"/>)
                                        </t>
                                    </t>
                                    <t t-elif="v.discount_type == 'fixed'">
                                        Giảm <t t-out="'{:,.0f}'.format(v.discount_value)"/>đ
                                    </t>
                                    <t t-else="">
                                        Giảm <t t-out="v.discount_value"/>%
                                        <t t-if="v.max_discount_amount">
                                            (tối đa <t t-out="'{:,.0f}'.format(v.max_discount_amount)"/>đ)
                                        </t>
                                    </t>
                                </div>
                                <t t-if="v.date_expiry">
                                    <div class="sr-vc-expiry">
                                        <span class="ms" style="font-size:14px">schedule</span>
                                        HSD: <t t-out="v.date_expiry.strftime('%d/%m/%Y')"/>
                                    </div>
                                </t>
                            </div>
                        </t>
                    </div>
                </t>
                <t t-else="">
                    <div class="sr-empty">
                        <span class="ms" style="font-size:64px;display:block;margin-bottom:16px;opacity:.35">redeem</span>
                        <p style="margin:0;font-size:1rem">Bạn chưa có Voucher nào. Tích điểm để đổi Voucher!</p>
                        <a href="/loyalty/dashboard" style="display:inline-block;margin-top:16px;padding:10px 24px;background:var(--c-pri);color:#fff;border-radius:8px;text-decoration:none;font-weight:600">
                            Quay về Dashboard
                        </a>
                    </div>
                </t>
            </div>

            <!-- Voucher đã sử dụng / hết hạn -->
            <t t-if="inactive_vouchers">
                <div class="sr-voucher-section" style="margin-top:24px">
                    <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px">
                        <h3 class="sr-vs-title" style="margin-bottom:0;font-size:1.1rem;color:#6c757d">
                            <span class="ms" style="font-size:18px;vertical-align:-4px">history</span>
                            Voucher đã sử dụng / không còn hiệu lực
                            (<t t-out="len(inactive_vouchers)"/>)
                        </h3>
                    </div>
                    <div class="sr-voucher-list">
                        <t t-foreach="inactive_vouchers" t-as="v">
                            <div class="sr-voucher-card" style="opacity:.55;background:#f8f9fa;border-color:#ced4da">
                                <div class="sr-vc-header">
                                    <span class="ms" style="font-size:28px;color:#adb5bd">confirmation_number</span>
                                    <span class="sr-v-code" style="font-size:1.15rem;color:#6c757d;text-decoration:line-through"><t t-out="v.code"/></span>
                                </div>
                                <div class="sr-vc-value" style="color:#6c757d">
                                    <t t-if="v.reward_type == 'free_shipping'">Miễn phí vận chuyển</t>
                                    <t t-elif="v.reward_type == 'gift'">Quà tặng kèm</t>
                                    <t t-elif="v.discount_type == 'fixed'">Giảm <t t-out="'{:,.0f}'.format(v.discount_value)"/>đ</t>
                                    <t t-else="">Giảm <t t-out="v.discount_value"/>%</t>
                                </div>
                                <div style="margin-top:6px;font-size:.8rem">
                                    <span t-if="v.state == 'used'" style="color:#0d6efd">✓ Đã sử dụng<t t-if="v.used_date"> – <t t-out="v.used_date.strftime('%d/%m/%Y')"/></t></span>
                                    <span t-elif="v.state == 'expired'" style="color:#dc3545">⌛ Hết hạn<t t-if="v.date_expiry"> – <t t-out="v.date_expiry.strftime('%d/%m/%Y')"/></t></span>
                                    <span t-else="" style="color:#6c757d">× Đã hủy</span>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </t>
        </div>

    </t>
</template>

</odoo>
