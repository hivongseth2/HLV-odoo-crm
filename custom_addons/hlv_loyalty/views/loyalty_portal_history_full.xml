<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ================================================================
     loyalty_portal_history_full.xml
     Full transaction history page at /loyalty/history
================================================================ -->
<template id="loyalty_portal_history_full" name="Loyalty Portal - Toàn bộ lịch sử">
    <t t-call="hlv_loyalty.loyalty_public_layout">

        <!-- Top bar -->
        <div class="sr-topbar">
            <a href="/loyalty/dashboard" class="sr-topbar-back">
                <span class="ms" style="font-size:20px">arrow_back</span> Quay về Dashboard
            </a>
            <div class="sr-topbar-right">
                <span class="sr-topbar-name">Xin chào, <strong><t t-out="partner.name"/></strong></span>
                <a href="/loyalty/logout" class="sr-topbar-logout">Đăng xuất</a>
            </div>
        </div>

        <!-- Body -->
        <div class="sr-body" style="padding-top:32px">
            <div class="sr-hist-section">

                <!-- Tóm tắt 2 loại điểm — chỉ hiện khi khách bấm vào xem lịch sử -->
                <div class="sr-hist-pts-summary">
                    <div class="sr-hist-pts-item">
                        <span class="ms ms-fill">swap_horiz</span>
                        <div>
                            <div class="sr-hist-pts-num"><t t-out="'{:,}'.format(exchange_available_points)"/></div>
                            <div class="sr-hist-pts-lbl">Điểm đổi thưởng khả dụng</div>
                        </div>
                    </div>
                    <div class="sr-hist-pts-item">
                        <span class="ms ms-fill">trending_up</span>
                        <div>
                            <div class="sr-hist-pts-num"><t t-out="'{:,}'.format(partner.loyalty_total_points)"/></div>
                            <div class="sr-hist-pts-lbl">Điểm xếp hạng</div>
                        </div>
                    </div>
                </div>

                <div class="sr-hist-toolbar">
                    <div class="sr-hist-header">
                        <h3 class="sr-hist-title">
                            Toàn bộ lịch sử tích lũy
                            <t t-if="all_history">
                                (<t t-out="len(all_history)"/> giao dịch)
                            </t>
                        </h3>
                    </div>

                    <!-- Filter bar: 2 dropdown gọn kiểu "6 tháng gần nhất ▾" -->
                    <div class="sr-filter-bar">
                        <div class="sr-filter-select-wrap">
                            <select class="sr-filter-select"
                                    t-attf-onchange="location.href='/loyalty/history?pt='+this.value+'&amp;st=#{active_st}'">
                                <option value="all" t-att-selected="active_pt == 'all'">Tất cả loại điểm</option>
                                <option value="ranking" t-att-selected="active_pt == 'ranking'">Tích lũy</option>
                                <option value="exchange" t-att-selected="active_pt == 'exchange'">Đổi thưởng</option>
                            </select>
                            <span class="ms sr-filter-select-chevron">expand_more</span>
                        </div>
                        <div class="sr-filter-select-wrap">
                            <select class="sr-filter-select"
                                    t-attf-onchange="location.href='/loyalty/history?pt=#{active_pt}&amp;st='+this.value">
                                <option value="all" t-att-selected="active_st == 'all'">Tất cả trạng thái</option>
                                <option value="pending" t-att-selected="active_st == 'pending'">Chờ xác nhận</option>
                                <option value="confirmed" t-att-selected="active_st == 'confirmed'">Hoàn tất</option>
                                <option value="cancelled" t-att-selected="active_st == 'cancelled'">Đã hủy</option>
                            </select>
                            <span class="ms sr-filter-select-chevron">expand_more</span>
                        </div>
                    </div>
                </div>

                <div class="sr-tbl-wrap">
                    <t t-if="all_history">
                        <table class="sr-tbl">
                            <thead>
                                <tr>
                                    <th>Ngày giao dịch</th>
                                    <th>Loại hình</th>
                                    <th>Nội dung chi tiết</th>
                                    <th class="th-pts-ranking"><span class="ms" style="font-size:14px">trending_up</span> Điểm TL</th>
                                    <th class="th-pts-exchange"><span class="ms" style="font-size:14px">swap_horiz</span> Điểm ĐT</th>
                                    <th style="text-align:right">Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="all_history" t-as="h">
                                    <tr t-att-class="'row-pt-ranking' if h.point_type == 'ranking' else 'row-pt-exchange'">
                                        <td>
                                            <div class="td-date"><t t-out="fmt_vn_date(h.date)"/></div>
                                            <div class="td-time"><t t-out="fmt_vn_time(h.date)"/></div>
                                        </td>
                                        <td>
                                            <t t-if="h.transaction_type == 'earn'">
                                                <span class="sr-badge badge-earn"><span class="ms">shopping_bag</span> Mua hàng</span>
                                            </t>
                                            <t t-elif="h.transaction_type == 'redeem'">
                                                <span class="sr-badge badge-redeem"><span class="ms">redeem</span> Đổi thưởng</span>
                                            </t>
                                            <t t-elif="h.transaction_type == 'return'">
                                                <span class="sr-badge badge-return"><span class="ms">undo</span> Hoàn hàng</span>
                                            </t>
                                            <t t-else="">
                                                <span class="sr-badge badge-manual"><span class="ms">edit_note</span> Thủ công</span>
                                            </t>
                                        </td>
                                        <td class="td-desc"><t t-out="h.description or ''"/></td>
                                        <!-- Điểm Tích lũy (ranking) -->
                                        <td t-att-class="'td-pts th-pts-ranking ' + ('pos' if h.point_amount > 0 else 'neg') if h.point_type == 'ranking' else 'td-pts-empty'">
                                            <t t-if="h.point_type == 'ranking'">
                                                <t t-out="('+' if h.point_amount > 0 else '') + '{:,}'.format(h.point_amount)"/>
                                            </t>
                                            <t t-else=""><span class="td-dash">–</span></t>
                                        </td>
                                        <!-- Điểm Đổi thưởng (exchange) -->
                                        <td t-att-class="'td-pts th-pts-exchange ' + ('pos' if h.point_amount > 0 else 'neg') if h.point_type == 'exchange' else 'td-pts-empty'">
                                            <t t-if="h.point_type == 'exchange'">
                                                <t t-out="('+' if h.point_amount > 0 else '') + '{:,}'.format(h.point_amount)"/>
                                            </t>
                                            <t t-else=""><span class="td-dash">–</span></t>
                                        </td>
                                        <td class="td-status">
                                            <t t-out="dict(pending='Chờ XN', confirmed='Hoàn tất', cancelled='Đã hủy').get(h.state, h.state)"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <!-- Mobile card view (hidden on desktop) -->
                        <div class="sr-hist-cards">
                            <t t-foreach="all_history" t-as="h">
                                <div t-att-class="'sr-hist-card ' + ('row-pt-ranking' if h.point_type == 'ranking' else 'row-pt-exchange')">
                                    <div class="shc-left">
                                        <span t-att-class="'shc-pts ' + ('pos' if h.point_amount > 0 else 'neg')">
                                            <t t-out="('+' if h.point_amount > 0 else '') + '{:,}'.format(h.point_amount)"/>
                                        </span>
                                        <t t-if="h.point_type == 'ranking'">
                                            <span class="sr-badge badge-pt-ranking" style="font-size:.62rem;padding:2px 7px"><span class="ms">trending_up</span> Tích lũy</span>
                                        </t>
                                        <t t-else="">
                                            <span class="sr-badge badge-pt-exchange" style="font-size:.62rem;padding:2px 7px"><span class="ms">swap_horiz</span> Đổi thưởng</span>
                                        </t>
                                    </div>
                                    <div class="shc-body">
                                        <div class="shc-desc"><t t-out="h.description or ''"/></div>
                                        <div class="shc-meta">
                                            <span class="shc-date"><t t-out="fmt_vn_date(h.date)"/> · <t t-out="fmt_vn_time(h.date)"/></span>
                                            <span t-att-class="'shc-status ' + ('shc-st-done' if h.state == 'confirmed' else ('shc-st-pending' if h.state == 'pending' else 'shc-st-cancelled'))">
                                                <t t-out="dict(pending='Chờ XN', confirmed='Hoàn tất', cancelled='Đã hủy').get(h.state, h.state)"/>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="sr-empty">
                            <span class="ms">inbox</span>
                            <p>Không có giao dịch nào khớp với bộ lọc.</p>
                        </div>
                    </t>
                </div>
            </div>
        </div>

    </t>
</template>

</odoo>
