<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_loyalty_history_form" model="ir.ui.view">
        <field name="name">hlv.loyalty.history.form</field>
        <field name="model">hlv.loyalty.history</field>
        <field name="arch" type="xml">
            <form string="Chi tiết giao dịch điểm" create="0">
                <header>
                    <button name="action_confirm" string="Xác nhận điểm"
                            type="object" class="btn-primary"
                            invisible="state != 'pending'"
                            groups="hlv_loyalty.group_loyalty_operator"/>
                    <button name="action_recalculate_points" string="Tính lại điểm"
                            type="object" class="btn-secondary"
                            invisible="state != 'pending' or point_type != 'exchange'"
                            groups="hlv_loyalty.group_loyalty_operator"
                            confirm="Tính lại điểm đổi thưởng theo dữ liệu mới nhất của đơn bán hàng (CK loyalty, combo/kit,...)? Chỉ áp dụng cho điểm đang chờ xác nhận."/>
                    <button name="action_cancel" string="Hủy"
                            type="object" class="btn-secondary"
                            invisible="state != 'pending'"
                            groups="hlv_loyalty.group_loyalty_operator"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,confirmed"/>
                </header>
                <sheet>
                    <!-- Banner điểm giao dịch -->
                    <div class="row g-0 mb-4">
                        <div class="col text-center p-4 border"
                             style="background: #f8f9fa;">
                            <div class="fw-bold small text-uppercase mb-1"
                                 style="letter-spacing:1px; color:#6c757d">Loại giao dịch</div>
                            <field name="transaction_type" widget="badge"
                                   decoration-success="transaction_type == 'earn'"
                                   decoration-warning="transaction_type == 'redeem'"
                                   decoration-danger="transaction_type == 'return'"
                                   decoration-info="transaction_type == 'transfer'"
                                   decoration-muted="transaction_type == 'manual'"
                                   nolabel="1"/>
                        </div>
                        <div class="col text-center p-4 border border-start-0"
                             style="background: #f8f9fa;">
                            <div class="fw-bold small text-uppercase mb-1"
                                 style="letter-spacing:1px; color:#6c757d">Biến động điểm</div>
                            <div class="fs-2 fw-bold"
                                 style="color: point_amount > 0 ? '#198754' : '#dc3545'">
                                <field name="point_amount" nolabel="1"/>
                            </div>
                        </div>
                        <div class="col text-center p-4 border border-start-0"
                             style="background: #f8f9fa;">
                            <div class="fw-bold small text-uppercase mb-1"
                                 style="letter-spacing:1px; color:#6c757d">Ngày giao dịch</div>
                            <div class="fs-5 fw-bold">
                                <field name="date" nolabel="1"/>
                            </div>
                        </div>
                    </div>

                    <group>
                        <group string="Thông tin giao dịch">
                            <field name="partner_id"/>
                            <field name="account_id"/>
                            <field name="date"/>
                            <field name="point_amount"/>
                            <field name="point_type" widget="badge"
                                   decoration-info="point_type == 'ranking'"
                                   decoration-success="point_type == 'exchange'"/>
                            <field name="transaction_type" widget="badge"
                                   decoration-success="transaction_type == 'earn'"
                                   decoration-warning="transaction_type == 'redeem'"
                                   decoration-danger="transaction_type == 'return'"
                                   decoration-info="transaction_type == 'transfer'"
                                   decoration-muted="transaction_type == 'manual'"/>
                            <field name="description"/>
                        </group>
                        <group string="Tham chiếu">
                            <field name="picking_id"/>
                            <field name="sale_order_id"/>
                            <field name="voucher_id"/>
                        </group>
                    </group>
                    <group string="Công thức tính điểm" invisible="not point_formula_html and not point_formula">
                        <field name="point_formula_html" nolabel="1" widget="html" invisible="not point_formula_html"/>
                        <field name="point_formula" nolabel="1" widget="text" invisible="point_formula_html"/>
                    </group>
                    <group string="Thông tin đối soát" groups="base.group_multi_company">
                        <group>
                            <field name="company_id"/>
                            <field name="sale_company_id"/>
                            <field name="delivery_company_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_loyalty_history_list" model="ir.ui.view">
        <field name="name">hlv.loyalty.history.list</field>
        <field name="model">hlv.loyalty.history</field>
        <field name="arch" type="xml">
            <list string="Lịch sử điểm Loyalty" create="0"
                  decoration-muted="state == 'cancelled'"
                  decoration-warning="state == 'pending'"
                  decoration-success="point_amount &gt; 0 and state == 'confirmed'"
                  decoration-danger="point_amount &lt; 0 and state == 'confirmed'">
                <field name="date"/>
                <field name="partner_id"/>
                <field name="account_id" optional="show"/>
                <field name="point_type" widget="badge"
                       decoration-info="point_type == 'ranking'"
                       decoration-success="point_type == 'exchange'"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'pending'"
                       decoration-success="state == 'confirmed'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="transaction_type" widget="badge"
                       decoration-success="transaction_type == 'earn'"
                       decoration-warning="transaction_type == 'redeem'"
                       decoration-danger="transaction_type == 'return'"
                       decoration-info="transaction_type == 'transfer'"
                       decoration-muted="transaction_type == 'manual'"/>
                <field name="point_amount" sum="Tổng điểm"/>
                <field name="description"/>
                <field name="point_formula" optional="hide"/>
                <field name="picking_id" optional="show"/>
                <field name="sale_order_id" optional="show"/>
                <field name="voucher_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="sale_company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="delivery_company_id" groups="base.group_multi_company" optional="hide"/>
                <button name="action_confirm" string="Xác nhận" type="object"
                        icon="fa-check" class="btn-sm btn-success"
                        invisible="state != 'pending'"
                        groups="sales_team.group_sale_manager"/>
                <button name="action_recalculate_points" string="Tính lại điểm" type="object"
                        icon="fa-refresh" class="btn-sm"
                        invisible="state != 'pending' or point_type != 'exchange'"
                        groups="sales_team.group_sale_manager"
                        confirm="Tính lại điểm đổi thưởng theo dữ liệu mới nhất của đơn bán hàng?"/>
                <button name="action_cancel" string="Hủy" type="object"
                        icon="fa-times" class="btn-sm"
                        invisible="state != 'pending'"
                        groups="sales_team.group_sale_manager"/>
            </list>
        </field>
    </record>

    <!-- Graph View -->
    <record id="view_loyalty_history_graph" model="ir.ui.view">
        <field name="name">hlv.loyalty.history.graph</field>
        <field name="model">hlv.loyalty.history</field>
        <field name="arch" type="xml">
            <graph string="Thống kê điểm Loyalty" type="bar">
                <field name="date" type="row" interval="month"/>
                <field name="point_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="view_loyalty_history_pivot" model="ir.ui.view">
        <field name="name">hlv.loyalty.history.pivot</field>
        <field name="model">hlv.loyalty.history</field>
        <field name="arch" type="xml">
            <pivot string="Phân tích điểm Loyalty" display_quantity="1">
                <field name="partner_id" type="row"/>
                <field name="transaction_type" type="col"/>
                <field name="point_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_loyalty_history_search" model="ir.ui.view">
        <field name="name">hlv.loyalty.history.search</field>
        <field name="model">hlv.loyalty.history</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm lịch sử điểm">
                <field name="partner_id"/>
                <field name="account_id"/>
                <field name="picking_id"/>
                <field name="sale_order_id"/>
                <field name="description"/>
                <filter string="Chờ xác nhận" name="filter_pending"
                        domain="[('state', '=', 'pending')]"/>
                <filter string="Đã xác nhận" name="filter_confirmed"
                        domain="[('state', '=', 'confirmed')]"/>
                <separator/>
                <filter string="Điểm xếp hạng" name="filter_ranking"
                        domain="[('point_type', '=', 'ranking')]"/>
                <filter string="Điểm đổi thưởng" name="filter_exchange"
                        domain="[('point_type', '=', 'exchange')]"/>
                <separator/>
                <filter string="Tích điểm" name="filter_earn"
                        domain="[('transaction_type', '=', 'earn')]"/>
                <filter string="Đổi thưởng" name="filter_redeem"
                        domain="[('transaction_type', '=', 'redeem')]"/>
                <filter string="Hoàn hàng" name="filter_return"
                        domain="[('transaction_type', '=', 'return')]"/>
                <filter string="Chuyển điểm" name="filter_transfer"
                        domain="[('transaction_type', '=', 'transfer')]"/>
                <filter string="Thủ công" name="filter_manual"
                        domain="[('transaction_type', '=', 'manual')]"/>
                <separator/>
                <filter string="Cộng điểm" name="filter_positive"
                        domain="[('point_amount', '&gt;', 0)]"/>
                <filter string="Trừ điểm" name="filter_negative"
                        domain="[('point_amount', '&lt;', 0)]"/>
                <separator/>
                <group expand="0" string="Nhóm theo">
                    <filter string="Khách hàng" name="group_partner"
                            context="{'group_by': 'partner_id'}"/>
                    <filter string="Tài khoản Loyalty" name="group_account"
                            context="{'group_by': 'account_id'}"/>
                    <filter string="Loại giao dịch" name="group_type"
                            context="{'group_by': 'transaction_type'}"/>
                    <filter string="Chi nhánh" name="group_company"
                            context="{'group_by': 'company_id'}"/>
                    <filter string="Tháng" name="group_date"
                            context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_loyalty_history" model="ir.actions.act_window">
        <field name="name">Lịch sử điểm</field>
        <field name="res_model">hlv.loyalty.history</field>
        <field name="view_mode">list,graph,pivot,form</field>
        <field name="search_view_id" ref="view_loyalty_history_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có giao dịch điểm nào.
            </p>
            <p>Điểm sẽ được tích tự động khi giao hàng thành công.</p>
        </field>
    </record>
</odoo>
