<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kế thừa Form Sale Order - Thêm nút áp dụng Voucher -->
    <record id="view_sale_order_form_inherit_loyalty" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.loyalty</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Thêm cột CK Loyalty vào dòng sản phẩm -->
            <xpath expr="//field[@name='order_line']/list//field[@name='discount']" position="after">
                <field name="loyalty_discount_pct" string="CK Loyalty (%)" optional="show"
                       column_invisible="parent.state not in ['sale','done','draft','sent']"/>
            </xpath>
            <!-- Thêm trường Voucher vào phần thông tin đơn hàng -->
            <xpath expr="//group[@name='sale_header']" position="inside">
                <label for="loyalty_voucher_code" string="Mã Voucher"/>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <field name="loyalty_voucher_code" placeholder="Nhập mã Voucher..."
                           class="oe_inline" invisible="loyalty_voucher_id"/>
                    <field name="loyalty_voucher_id" readonly="1" class="oe_inline"
                           invisible="not loyalty_voucher_id" options="{'no_open': False}"/>
                    <button name="action_apply_loyalty_voucher" type="object"
                            string="Áp dụng" class="btn btn-primary"
                            icon="fa-check"
                            invisible="loyalty_voucher_id"/>
                    <button name="action_remove_loyalty_voucher" type="object"
                            string="Xóa Voucher" class="btn btn-secondary"
                            icon="fa-times"
                            invisible="not loyalty_voucher_id"
                            confirm="Bạn có chắc muốn xóa Voucher khỏi đơn hàng?"/>
                </div>
            </xpath>
            <!-- Tab chọn tài khoản Loyalty cộng điểm cho đơn này -->
            <xpath expr="//notebook" position="inside">
                <page string="Tài khoản cộng điểm Loyalty" name="loyalty_account_lines">
                    <field name="loyalty_root_partner_id" invisible="1"/>
                    <p class="text-muted">
                        Chọn 1 hoặc nhiều tài khoản Loyalty để chia điểm của đơn này theo %.
                        % tự điền theo cấu hình mặc định của tài khoản, có thể sửa lại.
                        Nếu để trống, toàn bộ điểm sẽ cộng cho tài khoản mặc định của công ty.
                    </p>
                    <field name="loyalty_account_line_ids">
                        <list editable="bottom">
                            <field name="account_id" options="{'no_create': True}"/>
                            <field name="earning_pct" string="% cộng điểm"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
