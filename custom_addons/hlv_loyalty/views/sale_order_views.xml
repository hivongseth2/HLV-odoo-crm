<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kế thừa Form Sale Order - Thêm nút áp dụng Voucher -->
    <record id="view_sale_order_form_inherit_loyalty" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.loyalty</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Thêm trường Voucher vào phần thông tin đơn hàng -->
            <xpath expr="//group[@name='sale_header']" position="inside">
                <label for="loyalty_voucher_code" string="Mã Voucher"/>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <field name="loyalty_voucher_code" placeholder="Nhập mã Voucher..."
                           class="oe_inline" invisible="loyalty_voucher_id"/>
                    <field name="loyalty_voucher_id" readonly="1" class="oe_inline"
                           invisible="not loyalty_voucher_id" options="{'no_open': False}"/>
                    <button name="action_apply_loyalty_voucher" type="object"
                            string="Áp dụng" class="btn btn-primary"
                            icon="fa-check"
                            invisible="loyalty_voucher_id"/>
                    <button name="action_remove_loyalty_voucher" type="object"
                            string="Xóa Voucher" class="btn btn-secondary"
                            icon="fa-times"
                            invisible="not loyalty_voucher_id"
                            confirm="Bạn có chắc muốn xóa Voucher khỏi đơn hàng?"/>
                </div>
                <div invisible="state not in ['sale', 'done']">
                    <button name="action_backfill_loyalty_points" type="object"
                            string="Tạo bù điểm Loyalty" class="btn btn-link"
                            icon="fa-refresh"
                            confirm="Tính lại và tạo bổ sung điểm Loyalty (đặc biệt là điểm đổi thưởng) còn thiếu cho các phiếu đã giao của đơn này. Điểm đã có sẵn sẽ KHÔNG bị thay đổi. Tiếp tục?"
                            help="Dùng khi phiếu đã giao chỉ tích được điểm xếp hạng mà thiếu điểm đổi thưởng (VD: bảng 'Tài khoản cộng điểm Loyalty' bên dưới được cấu hình/sửa số tiền SAU khi đã giao hàng)."/>
                </div>
            </xpath>
            <!-- Tab chọn tài khoản Loyalty cộng điểm cho đơn này -->
            <xpath expr="//notebook" position="inside">
                <page string="Tài khoản cộng điểm Loyalty" name="loyalty_account_lines">
                    <field name="loyalty_root_partner_id" invisible="1"/>
                    <p class="text-muted">
                        Chọn 1 hoặc nhiều tài khoản Loyalty và nhập SỐ TIỀN mỗi tài khoản được
                        cộng điểm đổi thưởng NẾU đơn này giao đủ 100%. Khi 1 phiếu xuất kho giao
                        được X% giá trị đơn, tài khoản nhận đúng X% số tiền đã nhập (quy đổi ra
                        điểm theo cấu hình chương trình Loyalty) — giao nhiều lần thì nhận nhiều lần,
                        mỗi lần theo đúng % đã giao lần đó.
                        VD: đơn 3.000.000đ, tài khoản A được gán 200.000đ, giao 1.000.000đ (33%)
                        thì tài khoản A nhận khoảng 66.000đ lần này.
                        Điểm xếp hạng của cả đơn cũng được chia giữa các tài khoản theo đúng tỷ lệ
                        số tiền đã nhập ở đây.
                        Nếu để trống bảng này, đơn chỉ tính điểm xếp hạng (100% cho tài khoản mặc
                        định của công ty) — KHÔNG có điểm đổi thưởng.
                    </p>
                    <field name="loyalty_account_line_ids">
                        <list editable="bottom">
                            <field name="account_id" options="{'no_create': True}"/>
                            <field name="earning_amount" string="Số tiền cộng điểm" widget="monetary"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
