<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ── Form view ── -->
<record id="hlv_loyalty_portal_account_form" model="ir.ui.view">
    <field name="name">hlv.loyalty.portal.account.form</field>
    <field name="model">hlv.loyalty.portal.account</field>
    <field name="arch" type="xml">
        <form string="Tài khoản Portal Loyalty">
            <header>
                <button name="action_reset_password_wizard"
                        string="Reset Mật khẩu"
                        type="object"
                        class="btn-secondary"
                        groups="sales_team.group_sale_manager"/>
                <button name="action_recalculate_points_wizard"
                        string="Tính lại điểm"
                        type="object"
                        class="btn-secondary"
                        invisible="not active"
                        groups="sales_team.group_sale_manager"/>
                <button name="action_open_point_transfer_wizard"
                        string="Chuyển điểm"
                        type="object"
                        class="btn-secondary"
                        invisible="not active"
                        groups="hlv_loyalty.group_loyalty_operator"/>
            </header>
            <sheet>
                <div class="oe_title">
                    <label for="username" string="Tên đăng nhập"/>
                    <h1><field name="username" placeholder="vd: nguyenvan_a"/></h1>
                </div>
                <group>
                    <group string="Thông tin tài khoản">
                        <field name="partner_id" domain="[('is_company','=',True),('parent_id','=',False),('active','=',True)]" context="{'show_vat': True}"/>
                        <field name="buyer_name" placeholder="VD: Anh A - phòng thu mua 1"/>
                        <field name="portal_phone" placeholder="vd: 0912345678"/>
                        <field name="default_earning_pct" placeholder="VD: 5 = 5%"/>
                        <field name="is_default"/>
                        <field name="active"/>
                    </group>
                    <group string="Mật khẩu">
                        <field name="password_hash" string="Hash (chỉ đọc)" readonly="1"/>
                    </group>
                </group>
                <group string="Điểm Loyalty của tài khoản này">
                    <group>
                        <field name="loyalty_total_points" readonly="1"/>
                        <field name="loyalty_exchange_points" readonly="1"/>
                    </group>
                    <group>
                        <field name="loyalty_pending_points" readonly="1"/>
                        <field name="loyalty_reward_pending_points" readonly="1"/>
                        <field name="loyalty_exchange_available_points" readonly="1"/>
                    </group>
                </group>
            </sheet>
        </form>
    </field>
</record>

<!-- ── List view ── -->
<record id="hlv_loyalty_portal_account_list" model="ir.ui.view">
    <field name="name">hlv.loyalty.portal.account.list</field>
    <field name="model">hlv.loyalty.portal.account</field>
    <field name="arch" type="xml">
        <list string="Tài khoản Portal Loyalty" editable="bottom">
            <field name="partner_id" domain="[('is_company','=',True),('parent_id','=',False),('active','=',True)]" context="{'show_vat': True}"/>
            <field name="buyer_name" string="Tên thu mua" optional="show"/>
            <field name="username"/>
            <field name="portal_phone"/>
            <field name="default_earning_pct" string="% mặc định" optional="show"/>
            <field name="is_default" optional="show"/>
            <field name="loyalty_total_points" string="Điểm xếp hạng" sum="Tổng" optional="show"/>
            <field name="loyalty_exchange_points" string="Điểm đổi thưởng" sum="Tổng" optional="show"/>
            <field name="active"/>
            <button name="action_reset_password_wizard" string="Reset mật khẩu"
                    type="object" icon="fa-key" class="btn-sm"
                    groups="sales_team.group_sale_manager"/>
            <button name="action_recalculate_points_wizard" string="Tính lại điểm"
                    type="object" icon="fa-refresh" class="btn-sm"
                    invisible="not active"
                    groups="sales_team.group_sale_manager"/>
            <button name="action_open_point_transfer_wizard" string="Chuyển điểm"
                    type="object" icon="fa-exchange" class="btn-sm"
                    invisible="not active"
                    groups="hlv_loyalty.group_loyalty_operator"/>
        </list>
    </field>
</record>

<!-- ── Action ── -->
<record id="action_hlv_loyalty_portal_account" model="ir.actions.act_window">
    <field name="name">Tài khoản Portal Loyalty</field>
    <field name="res_model">hlv.loyalty.portal.account</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'active_test': False}</field>
</record>

<!-- ── Menu ── -->
<menuitem
    id="menu_hlv_loyalty_portal_account"
    name="Tài khoản Portal"
    parent="menu_loyalty_config"
    action="action_hlv_loyalty_portal_account"
    sequence="20"
    groups="sales_team.group_sale_manager"
/>

</odoo>
