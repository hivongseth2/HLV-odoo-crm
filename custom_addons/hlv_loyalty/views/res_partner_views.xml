<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View quản lý khách hàng tích điểm -->
    <record id="view_loyalty_partner_list" model="ir.ui.view">
        <field name="name">loyalty.partner.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Khách hàng tích điểm"
                  decoration-muted="loyalty_total_points == 0"
                  default_order="loyalty_total_points desc">
                <field name="name" string="Khách hàng"/>
                <field name="parent_id" string="Công ty mẹ" optional="show"/>
                <field name="phone" optional="show"/>
                <field name="email" optional="hide"/>
                <field name="loyalty_total_points" string="Điểm xếp hạng" sum="Tổng"/>
                <field name="loyalty_exchange_points" string="Điểm đổi thưởng" sum="Tổng" optional="show"/>
                <field name="loyalty_voucher_count" string="Voucher hiện có"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_loyalty_partner_search" model="ir.ui.view">
        <field name="name">loyalty.partner.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Tìm khách hàng">
                <field name="name"/>
                <field name="parent_id" string="Công ty mẹ"/>
                <field name="phone"/>
                <filter string="Có điểm" name="filter_has_points"
                        domain="[('loyalty_total_points', '&gt;', 0)]"/>
                <filter string="Là công ty" name="filter_company"
                        domain="[('is_company', '=', True)]"/>
                <filter string="Là liên hệ" name="filter_contact"
                        domain="[('is_company', '=', False)]"/>
                <separator/>
                <group expand="0" string="Nhóm theo">
                    <filter string="Công ty mẹ" name="group_parent"
                            context="{&#39;group_by&#39;: &#39;parent_id&#39;}"/>
                    <filter string="Công ty (Odoo)" name="group_company"
                            context="{&#39;group_by&#39;: &#39;company_id&#39;}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_loyalty_partner_overview" model="ir.actions.act_window">
        <field name="name">Khách hàng tích điểm</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_loyalty_partner_list"/>
        <field name="search_view_id" ref="view_loyalty_partner_search"/>
        <field name="domain">[('loyalty_total_points', '&gt;', 0)]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có khách hàng nào tích điểm.
            </p>
        </field>
    </record>

    <!-- Kế thừa Form Khách hàng - Thêm Smart Buttons &amp; Tab Loyalty -->
    <record id="view_partner_form_inherit_loyalty" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.loyalty</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Smart Buttons -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_loyalty_history" type="object"
                        class="oe_stat_button" icon="fa-star">
                    <div class="o_stat_info">
                        <field name="loyalty_total_points" class="o_stat_value"/>
                        <span class="o_stat_text">Điểm xếp hạng</span>
                    </div>
                </button>
                <div class="oe_stat_button" icon="fa-trophy"
                        invisible="not loyalty_tier_id">
                    <div class="o_stat_info">
                        <field name="loyalty_tier_id" class="o_stat_value" readonly="1"/>
                        <span class="o_stat_text">Hạng</span>
                    </div>
                </div>
                <button name="action_view_loyalty_vouchers" type="object"
                        class="oe_stat_button" icon="fa-ticket">
                    <div class="o_stat_info">
                        <field name="loyalty_voucher_count" class="o_stat_value"/>
                        <span class="o_stat_text">Voucher</span>
                    </div>
                </button>
            </xpath>

            <!-- Tab Loyalty -->
            <xpath expr="//notebook" position="inside">
                <page string="Loyalty" name="loyalty_tab" invisible="parent_id != False">

                    <!-- Panel tổng điểm + nút đổi -->
                    <div class="row g-0 mb-3 border">
                        <div class="col-auto bg-warning text-dark p-4 text-center"
                             style="min-width: 160px;">
                            <div class="fw-bold small text-uppercase mb-1"
                                 style="letter-spacing:1px; opacity:.7">Điểm xếp hạng</div>
                            <div class="fw-bold" style="font-size:2.5rem; line-height:1.1">
                                <field name="loyalty_total_points" readonly="1" nolabel="1"/>
                            </div>
                            <div class="small mt-1" style="opacity:.8">điểm</div>
                        </div>
                        <div class="col-auto bg-success text-white p-4 text-center border-start"
                             style="min-width: 160px;">
                            <div class="fw-bold small text-uppercase mb-1"
                                 style="letter-spacing:1px; opacity:.85">Điểm đổi thưởng</div>
                            <div class="fw-bold" style="font-size:2.5rem; line-height:1.1">
                                <field name="loyalty_exchange_points" readonly="1" nolabel="1"/>
                            </div>
                            <div class="small mt-1" style="opacity:.85">
                                (<field name="loyalty_pending_points" readonly="1" nolabel="1"/> chờ xác nhận)
                            </div>
                        </div>
                        <div class="col d-flex align-items-center px-4 bg-light border-start">
                            <div>
                                <div class="fw-bold mb-1">Đổi điểm lấy Voucher giảm giá</div>
                                <div class="text-muted small mb-3">
                                    Sử dụng điểm đổi thưởng để đổi Voucher áp dụng cho đơn hàng.
                                </div>
                                <button name="action_open_redeem_wizard" type="object"
                                        string="Đổi Voucher ngay"
                                        class="btn btn-warning fw-bold"
                                        icon="fa-exchange"/>
                                <button name="action_open_point_adjustment_wizard" type="object"
                                        string="Điều chỉnh điểm"
                                        class="btn btn-outline-secondary fw-bold ms-2"
                                        icon="fa-sliders"
                                        groups="sales_team.group_sale_manager"/>
                            </div>
                        </div>
                    </div>

                    <!-- Lịch sử giao dịch -->
                    <div class="fw-bold text-uppercase small mb-2"
                         style="letter-spacing:1px; color:#6c757d; border-bottom:2px solid #dee2e6; padding-bottom:6px;">
                        Lịch sử giao dịch gần nhất
                    </div>
                    <field name="loyalty_history_ids" readonly="1" nolabel="1">
                        <list create="0" delete="0" limit="10"
                              decoration-success="point_amount &gt; 0"
                              decoration-danger="point_amount &lt; 0">
                            <field name="date" string="Ngày"/>
                            <field name="transaction_type" widget="badge"
                                   decoration-success="transaction_type == 'earn'"
                                   decoration-warning="transaction_type == 'redeem'"
                                   decoration-danger="transaction_type == 'return'"
                                   decoration-info="transaction_type == 'manual'"/>
                            <field name="point_amount" string="Điểm" sum="Tổng"/>
                            <field name="description" string="Mô tả"/>
                            <field name="company_name" groups="base.group_multi_company"
                                   string="Chi nhánh"/>
                        </list>
                    </field>

                    <!-- Voucher đang có -->
                    <div class="fw-bold text-uppercase small mb-2 mt-3"
                         style="letter-spacing:1px; color:#6c757d; border-bottom:2px solid #dee2e6; padding-bottom:6px;">
                        Voucher đang có
                    </div>
                    <field name="loyalty_voucher_ids" readonly="1" nolabel="1"
                           domain="[('state', '=', 'active')]">
                        <list create="0" delete="0"
                              decoration-success="state == 'active'"
                              decoration-muted="state != 'active'">
                            <field name="code" widget="badge"/>
                            <field name="package_id" string="Gói"/>
                            <field name="discount_type" widget="badge"
                                   decoration-success="discount_type == 'fixed'"
                                   decoration-info="discount_type == 'percent'"/>
                            <field name="discount_value" string="Giá trị"/>
                            <field name="date_expiry" string="Hết hạn"
                                   decoration-danger="date_expiry and date_expiry &lt; current_date"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'active'"
                                   decoration-info="state == 'used'"
                                   decoration-muted="state == 'expired'"/>
                        </list>
                    </field>
                    <!-- Tài khoản Portal Loyalty -->
                    <div class="fw-bold text-uppercase small mb-2 mt-3"
                         style="letter-spacing:1px; color:#6c757d; border-bottom:2px solid #dee2e6; padding-bottom:6px;">
                        Cấu hình Loyalty
                    </div>
                    <group>
                        <group>
                            <field name="loyalty_default_discount"
                                   string="% Chiết khấu mặc định (Loyalty)"
                                   widget="percentage"
                                   help="Nhập theo %, VD: 5 = 5%. Dùng để tính điểm khi dòng hàng không có CK Loyalty."/>
                        </group>
                    </group>
                    <!-- Tài khoản Portal Loyalty -->
                    <div class="fw-bold text-uppercase small mb-2 mt-3"
                         style="letter-spacing:1px; color:#6c757d; border-bottom:2px solid #dee2e6; padding-bottom:6px;">
                        Tài khoản Portal
                    </div>
                    <field name="loyalty_portal_account_ids" nolabel="1"
                           groups="sales_team.group_sale_manager">
                        <list editable="bottom">
                            <field name="username" placeholder="Tên đăng nhập..."/>
                            <field name="active" optional="show"/>
                            <field name="password_hash" string="Mật khẩu" readonly="1"
                                   optional="hide"/>
                            <button name="action_reset_password_wizard"
                                    string="Reset mật khẩu"
                                    type="object"
                                    icon="fa-key"
                                    class="btn-sm"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
