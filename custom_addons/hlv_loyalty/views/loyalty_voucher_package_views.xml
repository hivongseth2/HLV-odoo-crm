<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_loyalty_voucher_package_form" model="ir.ui.view">
        <field name="name">loyalty.voucher.package.form</field>
        <field name="model">loyalty.voucher.package</field>
        <field name="arch" type="xml">
            <form string="Gói đổi Voucher">
                <sheet>
                    <group>
                        <group string="Thông tin gói">
                            <field name="name"/>
                            <field name="program_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                        <group string="Quy đổi">
                            <field name="points_required"/>
                            <field name="discount_type"/>
                            <field name="discount_value"/>
                            <field name="max_discount_amount"
                                   invisible="discount_type != 'percent'"/>
                            <field name="validity_days"/>
                        </group>
                    </group>
                    <group string="Phạm vi áp dụng">
                        <field name="apply_on" widget="radio"/>
                        <field name="product_category_ids" widget="many2many_tags"
                               invisible="apply_on != 'category'"/>
                        <field name="min_order_amount"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_loyalty_voucher_package_list" model="ir.ui.view">
        <field name="name">loyalty.voucher.package.list</field>
        <field name="model">loyalty.voucher.package</field>
        <field name="arch" type="xml">
            <list string="Gói đổi Voucher">
                <field name="name"/>
                <field name="program_id"/>
                <field name="points_required"/>
                <field name="discount_type"/>
                <field name="discount_value"/>
                <field name="max_discount_amount"/>
                <field name="min_order_amount"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_loyalty_voucher_package" model="ir.actions.act_window">
        <field name="name">Gói đổi Voucher</field>
        <field name="res_model">loyalty.voucher.package</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo gói đổi Voucher đầu tiên!
            </p>
        </field>
    </record>
</odoo>
