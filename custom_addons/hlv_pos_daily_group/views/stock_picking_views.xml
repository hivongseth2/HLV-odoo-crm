<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_pos_payment" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.pos.payment</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="x_pos_payment_method" readonly="1" invisible="not x_pos_payment_method"/>
            </xpath>
        </field>
    </record>
</odoo>
