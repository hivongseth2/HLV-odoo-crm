<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add AI resource stat button to product template form -->
    <record id="view_product_template_form_llm" model="ir.ui.view">
        <field name="name">product.template.form.llm</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <button name="action_open_documents" position="before">
                <button name="action_view_llm_resources" type="object"
                        class="oe_stat_button" icon="fa-robot"
                        invisible="llm_resource_count == 0">
                    <field name="llm_resource_count" widget="statinfo"
                           string="Tài nguyên AI"/>
                </button>
            </button>
        </field>
    </record>

    <!-- Server action appears in Action menu on the Documents list page -->
    <record id="action_sync_product_docs_to_knowledge" model="ir.actions.server">
        <field name="name">Đồng bộ → AI Knowledge</field>
        <field name="model_id" ref="product.model_product_document"/>
        <field name="binding_model_id" ref="product.model_product_document"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_sync_and_index()</field>
    </record>

</odoo>
