<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Mỗi lượt tra tối đa 100 hóa đơn chưa thu (xoay vòng, chưa tra bao giờ được ưu tiên). Nút
         "Tra lại MISA" trên từng hóa đơn của trang dùng khi cần số mới ngay. -->
    <record id="ir_cron_misa_sale_payment_scan" model="ir.cron">
        <field name="name">MISA - Tra thu tiền theo dòng đơn bán</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="state">code</field>
        <field name="code">model._cron_scan_misa_sale_payment()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
</odoo>
