
<odoo>
    <template id="report_logistic_tag_document">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="line">
                <div class="page">
                    <h3>Logistic Tag</h3>
                    <table>
                        <tr><td>Delivery Date:</td><td><t t-esc="line.picking_id.scheduled_date"/></td></tr>
                        <tr><td>Order No.:</td><td><t t-esc="line.picking_id.name"/></td></tr>
                        <tr><td>Item:</td><td><t t-esc="line.product_id.display_name"/></td></tr>
                        <tr><td>Lot:</td><td><t t-esc="line.lot_id.name or ''"/></td></tr>
                        <tr><td>Qty:</td><td><t t-esc="line.qty_done"/> <t t-esc="line.product_uom_id.name"/></td></tr>
                        <tr><td>Warehouse:</td><td><t t-esc="line.picking_id.picking_type_id.warehouse_id.name"/></td></tr>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <report
        id="action_report_logistic_tag"
        string="Logistic Tag"
        model="stock.move.line"
        report_type="qweb-pdf"
        name="logistic_tag_report.report_logistic_tag_document"
        file="logistic_tag_report.report_logistic_tag_document"
        print_report_name="'Logistic Tag - %s' % (object.picking_id.name)"
    />
</odoo>
