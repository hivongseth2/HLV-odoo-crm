<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t
        t-name="hlv_chatter_collapse.ChatterCollapse"
        t-inherit="mail.Chatter"
        t-inherit-mode="extension"
    >
        <xpath expr="//button[hasclass('o-mail-Chatter-sendMessage')]" position="before">
            <button
                t-if="props.isChatterAside"
                type="button"
                class="o-hlv-Chatter-toggle btn btn-secondary text-action flex-shrink-0 me-1"
                t-att-title="hlvChatterToggleTitle"
                t-att-aria-label="hlvChatterToggleTitle"
                t-att-aria-expanded="!hlvChatterCollapse.collapsed"
                t-on-click="toggleHlvChatter"
            >
                <i
                    class="fa"
                    t-att-class="hlvChatterCollapse.collapsed ? 'fa-chevron-left' : 'fa-chevron-right'"
                    aria-hidden="true"
                />
            </button>
        </xpath>
    </t>
</templates>
