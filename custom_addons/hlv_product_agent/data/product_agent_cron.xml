<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Chế độ Claude API: sale gửi tin là Odoo chạy ngay trong luồng nền (runner.wake);
         cron 1 phút chỉ để vớt tin sót và dọn lượt treo. Lưu cài đặt là bật/tắt cron theo chế độ
         (res.config.settings.set_values); noupdate để nâng cấp module không bật/tắt lại. -->
    <record id="ir_cron_product_agent_api" model="ir.cron">
        <field name="name">Trợ lý tạo mã hàng: trả lời bằng Claude API</field>
        <field name="model_id" ref="model_hlv_product_agent_api_runner"/>
        <field name="state">code</field>
        <field name="code">model._cron_run_queue()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <!-- Tắt sẵn: mặc định chạy bằng máy văn phòng. Chọn Claude API trong Cài đặt là bật. -->
        <field name="active" eval="False"/>
    </record>

    <!-- Mỗi giờ Claude đọc các tên loại hàng MỚI trong kho, ghi cách sale hay gọi vào bảng tên gọi
         khác (quet_san_pham dùng để tìm không sót). Hết loại mới thì chạy không, không tốn token. -->
    <record id="ir_cron_product_agent_study_catalog" model="ir.cron">
        <field name="name">Trợ lý tạo mã hàng: học tên gọi khác của loại hàng</field>
        <field name="model_id" ref="model_hlv_product_name_type"/>
        <field name="state">code</field>
        <field name="code">model._cron_study_catalog()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
