<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hlv_product_chat_session_list" model="ir.ui.view">
        <field name="name">hlv.product.chat.session.list</field>
        <field name="model">hlv.product.chat.session</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="last_activity"/>
                <field name="sale_name"/>
                <field name="user_id" optional="show"/>
                <field name="name"/>
                <field name="state" widget="badge" decoration-info="state == 'processing'"/>
                <field name="closed" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_hlv_product_chat_session_form" model="ir.ui.view">
        <field name="name">hlv.product.chat.session.form</field>
        <field name="model">hlv.product.chat.session</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sale_name"/>
                            <field name="sale_code"/>
                            <field name="user_id"/>
                            <field name="last_activity"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="closed"/>
                            <field name="claude_session_id"/>
                        </group>
                    </group>
                    <field name="message_ids">
                        <list decoration-muted="role == 'event'" decoration-bf="role == 'user'">
                            <field name="create_date" string="Lúc"/>
                            <field name="role"/>
                            <field name="content"/>
                            <field name="attachment_ids" widget="many2many_tags"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hlv_product_chat_session_search" model="ir.ui.view">
        <field name="name">hlv.product.chat.session.search</field>
        <field name="model">hlv.product.chat.session</field>
        <field name="arch" type="xml">
            <search>
                <field name="sale_name"/>
                <field name="user_id"/>
                <field name="name"/>
                <field name="message_ids" string="Nội dung tin" filter_domain="[('message_ids.content', 'ilike', self)]"/>
                <filter name="has_misa_write" string="Có tạo/sửa MISA"
                        domain="[('message_ids', 'any', [('role', '=', 'event'), ('content', 'ilike', 'trên MISA')])]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_sale" string="Nhân viên" context="{'group_by': 'sale_name'}"/>
                    <filter name="group_user" string="Tài khoản" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hlv_product_chat_session" model="ir.actions.act_window">
        <field name="name">Hội thoại tạo mã hàng</field>
        <field name="res_model">hlv.product.chat.session</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
