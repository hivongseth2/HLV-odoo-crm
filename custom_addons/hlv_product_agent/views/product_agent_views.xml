<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hlv_product_agent_list" model="ir.ui.view">
        <field name="name">hlv.product.agent.list</field>
        <field name="model">hlv.product.agent</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="agent_status" widget="badge"
                       decoration-success="agent_status == 'alive'"
                       decoration-danger="agent_status == 'dead'"/>
                <field name="last_seen"/>
                <field name="version"/>
            </list>
        </field>
    </record>

    <record id="view_hlv_product_agent_form" model="ir.ui.view">
        <field name="name">hlv.product.agent.form</field>
        <field name="model">hlv.product.agent</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_regenerate_token" type="object" string="Sinh lại token"
                            confirm="Agent đang chạy sẽ mất quyền ngay, phải dán token mới vào agent.yaml. Tiếp tục?"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="agent_status" widget="badge"
                                   decoration-success="agent_status == 'alive'"
                                   decoration-danger="agent_status == 'dead'"/>
                        </group>
                        <group>
                            <field name="last_seen"/>
                            <field name="version"/>
                        </group>
                    </group>
                    <group string="Kết nối">
                        <field name="token" widget="CopyClipboardChar"/>
                    </group>
                    <div class="text-muted">
                        Dán token vào <code>agent.yaml</code> trên máy chạy Claude
                        (xem <code>hlv_product_agent/agent/README.md</code>).
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hlv_product_agent" model="ir.actions.act_window">
        <field name="name">Máy chạy Claude</field>
        <field name="res_model">hlv.product.agent</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
