<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hlv_product_agent_list" model="ir.ui.view">
        <field name="name">hlv.product.agent.list</field>
        <field name="model">hlv.product.agent</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="agent_status" widget="badge"
                       decoration-success="agent_status == 'alive'"
                       decoration-danger="agent_status == 'dead'"/>
                <field name="last_seen"/>
                <field name="version"/>
            </list>
        </field>
    </record>

    <record id="view_hlv_product_agent_form" model="ir.ui.view">
        <field name="name">hlv.product.agent.form</field>
        <field name="model">hlv.product.agent</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_enroll_code" type="object" string="Tạo mã cài đặt"
                            class="btn-primary"/>
                    <button name="action_regenerate_token" type="object" string="Sinh lại token"
                            confirm="Agent đang chạy sẽ mất quyền ngay, phải dán token mới vào agent.yaml. Tiếp tục?"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="agent_status" widget="badge"
                                   decoration-success="agent_status == 'alive'"
                                   decoration-danger="agent_status == 'dead'"/>
                        </group>
                        <group>
                            <field name="last_seen"/>
                            <field name="version"/>
                        </group>
                    </group>
                    <div class="alert alert-success" role="alert" invisible="not enroll_code">
                        <b>Cài agent</b> — trên máy chạy Claude, mở <b>PowerShell</b> (không cần
                        quyền admin) và dán lệnh:
                        <field name="setup_command" readonly="1" nolabel="1" widget="CopyClipboardChar"/>
                        Khi script hỏi, gõ mã cài đặt:
                        <b><field name="enroll_code" readonly="1" nolabel="1" class="oe_inline"/></b>
                        (hết hạn lúc <field name="enroll_code_expiry" readonly="1" nolabel="1" class="oe_inline"/>)
                    </div>
                    <div class="alert alert-info" role="alert" invisible="enroll_code">
                        Bấm <b>Tạo mã cài đặt</b> ở trên để lấy lệnh cài cho máy chạy Claude.
                        Máy đã cài rồi mà muốn lên bản agent / tài liệu quy tắc mới: chạy lại
                        đúng lệnh cài, script dùng lại token cũ, không cần mã.
                    </div>
                    <group string="Kết nối">
                        <field name="token" widget="CopyClipboardChar"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hlv_product_agent" model="ir.actions.act_window">
        <field name="name">Máy chạy Claude</field>
        <field name="res_model">hlv.product.agent</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
