<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hlv_product_agent_log_list" model="ir.ui.view">
        <field name="name">hlv.product.agent.log.list</field>
        <field name="model">hlv.product.agent.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-info="action == 'update'"
                  decoration-warning="action == 'create' and not in_odoo">
                <field name="create_date" string="Lúc"/>
                <field name="sale_name"/>
                <field name="sale_code" optional="hide"/>
                <field name="user_id" optional="hide"/>
                <field name="action" widget="badge"/>
                <field name="product_code"/>
                <field name="product_name"/>
                <field name="category_name"/>
                <field name="unit" optional="hide"/>
                <field name="misa_id" optional="show"/>
                <field name="updated_field" optional="hide"/>
                <field name="old_value" optional="hide"/>
                <field name="new_value" optional="hide"/>
                <field name="in_odoo" widget="boolean"/>
                <field name="session_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_hlv_product_agent_log_form" model="ir.ui.view">
        <field name="name">hlv.product.agent.log.form</field>
        <field name="model">hlv.product.agent.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group string="Hàng">
                            <field name="action"/>
                            <field name="product_code"/>
                            <field name="product_name"/>
                            <field name="category_name"/>
                            <field name="category_id"/>
                            <field name="unit"/>
                            <field name="misa_id"/>
                        </group>
                        <group string="Ai, lúc nào">
                            <field name="create_date" string="Lúc"/>
                            <field name="sale_name"/>
                            <field name="sale_code"/>
                            <field name="user_id"/>
                            <field name="session_id"/>
                            <field name="odoo_product_id"/>
                        </group>
                    </group>
                    <group string="Sửa" invisible="action != 'update'">
                        <field name="updated_field"/>
                        <field name="old_value"/>
                        <field name="new_value"/>
                    </group>
                    <group string="Thông số" invisible="not description">
                        <field name="description" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hlv_product_agent_log_search" model="ir.ui.view">
        <field name="name">hlv.product.agent.log.search</field>
        <field name="model">hlv.product.agent.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_code"/>
                <field name="product_name"/>
                <field name="sale_name"/>
                <field name="misa_id"/>
                <filter name="created" string="Tạo mới" domain="[('action', '=', 'create')]"/>
                <filter name="updated" string="Sửa" domain="[('action', '=', 'update')]"/>
                <separator/>
                <filter name="not_in_odoo" string="Chưa về Odoo" domain="[('in_odoo', '=', False)]"/>
                <separator/>
                <filter name="create_date" string="Ngày" date="create_date"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_sale" string="Nhân viên" context="{'group_by': 'sale_name'}"/>
                    <filter name="group_user" string="Tài khoản" context="{'group_by': 'user_id'}"/>
                    <filter name="group_category" string="Nhóm hàng" context="{'group_by': 'category_name'}"/>
                    <filter name="group_day" string="Ngày" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hlv_product_agent_log" model="ir.actions.act_window">
        <field name="name">Hàng tạo / sửa qua trợ lý</field>
        <field name="res_model">hlv.product.agent.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
