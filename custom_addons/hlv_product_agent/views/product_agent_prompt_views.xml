<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===================== Prompt ===================== -->
    <record id="view_hlv_product_agent_prompt_list" model="ir.ui.view">
        <field name="name">hlv.product.agent.prompt.list</field>
        <field name="model">hlv.product.agent.prompt</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="write_date" string="Sửa lần cuối"/>
                <field name="write_uid" string="Người sửa"/>
            </list>
        </field>
    </record>

    <record id="view_hlv_product_agent_prompt_form" model="ir.ui.view">
        <field name="name">hlv.product.agent.prompt.form</field>
        <field name="model">hlv.product.agent.prompt</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_apply_now" type="object" string="Áp dụng ngay cho cuộc chat đang mở"
                            class="btn-primary"
                            confirm="Mọi cuộc chat đang mở sẽ chuyển sang prompt mới từ tin kế tiếp (Claude mở phiên mới, đọc lại các tin gần nhất). Tiếp tục?"/>
                    <button name="action_reset_default" type="object" string="Khôi phục mặc định"
                            confirm="Đưa phần này về bản mặc định đi kèm module? Bản hiện tại vẫn còn trong tab Lịch sử."/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Lưu xong, agent tự tải prompt mới trong vài giây. Bản mới áp dụng cho
                        <b>cuộc chat mới</b>; cuộc đang dở vẫn dùng bản cũ cho tới khi sale bấm
                        "Cuộc mới" — hoặc bấm <b>Áp dụng ngay</b> ở trên.
                        Ngoại lệ đặt tên / mã cho từng dòng hàng: sửa ở menu
                        <b>Quy tắc riêng theo dòng hàng</b>, không cần sửa tài liệu A.
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <notebook>
                        <page string="Nội dung" name="content">
                            <field name="content" nolabel="1" widget="text" class="font-monospace"/>
                        </page>
                        <page string="Prompt hoàn chỉnh" name="preview">
                            <group>
                                <field name="built_version"/>
                            </group>
                            <field name="built_preview" nolabel="1" readonly="1" class="font-monospace"/>
                        </page>
                        <page string="Lịch sử" name="history">
                            <field name="revision_ids" readonly="1">
                                <list>
                                    <field name="create_date" string="Bản lưu lúc"/>
                                    <field name="create_uid" string="Lưu bởi"/>
                                    <field name="content" string="Nội dung (bản cũ)"/>
                                    <button name="action_restore" type="object" string="Khôi phục bản này"
                                            icon="fa-undo"
                                            confirm="Quay lại bản này? Bản đang dùng sẽ được lưu vào lịch sử."/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hlv_product_agent_prompt" model="ir.actions.act_window">
        <field name="name">Prompt trợ lý</field>
        <field name="res_model">hlv.product.agent.prompt</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============ Quy tắc riêng theo dòng hàng ============ -->
    <record id="view_hlv_product_naming_rule_list" model="ir.ui.view">
        <field name="name">hlv.product.naming.rule.list</field>
        <field name="model">hlv.product.naming.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="match"/>
                <field name="code_rule"/>
                <field name="name_rule" optional="show"/>
                <field name="example_code" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_hlv_product_naming_rule_form" model="ir.ui.view">
        <field name="name">hlv.product.naming.rule.form</field>
        <field name="model">hlv.product.naming.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Quy tắc ở đây được ghép vào prompt ngay sau tài liệu A và <b>thắng tài liệu A</b>
                        ở điểm nó nói tới; điểm nào để trống thì vẫn theo tài liệu A.
                        Viết như đang dặn một nhân viên mới, kèm một ví dụ đúng.
                        Áp dụng cho cuộc chat mới (xem nút "Áp dụng ngay" ở Prompt trợ lý).
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="match"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Quy tắc">
                        <field name="code_rule" placeholder="VD: Không nối hậu tố hãng vào mã; chỉ dùng mã model."/>
                        <field name="name_rule" placeholder="Để trống nếu tên vẫn theo quy tắc chung."/>
                        <field name="note"/>
                    </group>
                    <group string="Ví dụ đúng">
                        <field name="example_input" placeholder="khoan pin milwaukee fpd3-502x"/>
                        <field name="example_name" placeholder="Máy khoan pin FPD3-502X MILWAUKEE"/>
                        <field name="example_code"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hlv_product_naming_rule_search" model="ir.ui.view">
        <field name="name">hlv.product.naming.rule.search</field>
        <field name="model">hlv.product.naming.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="inactive" string="Đang tắt" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_hlv_product_naming_rule" model="ir.actions.act_window">
        <field name="name">Quy tắc riêng theo dòng hàng</field>
        <field name="res_model">hlv.product.naming.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
