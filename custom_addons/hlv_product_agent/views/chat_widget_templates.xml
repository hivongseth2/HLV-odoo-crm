<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="product_chat_widget" name="Khung chat trợ lý">
        <div class="hlv-pa-chat" data-open="1" data-tab="chat">
            <!-- Bảng trợ lý vẽ (show_panel): nổi trên trang, kéo / phóng to / đóng được. HTML
                 của Claude nằm trong iframe sandbox: không chạy script, không cùng nguồn với trang. -->
            <div class="hlv-pa-board" data-open="0">
                <div class="hlv-pa-board-head" title="Kéo để di chuyển">
                    <span class="hlv-pa-board-title"/>
                    <button type="button" class="hlv-pa-board-max" title="Phóng to / thu nhỏ">
                        <i class="fa fa-expand"/>
                    </button>
                    <button type="button" class="hlv-pa-board-close" title="Đóng bảng">
                        <i class="fa fa-times"/>
                    </button>
                </div>
                <iframe class="hlv-pa-board-frame" sandbox="" title="Bảng của trợ lý"/>
            </div>
            <div class="hlv-pa-panel">
                <div class="hlv-pa-resize" title="Kéo để đổi độ rộng"/>
                <div class="hlv-pa-tabs">
                    <button type="button" class="hlv-pa-new" title="Bắt đầu cuộc trò chuyện mới">
                        <i class="fa fa-plus"/> Cuộc mới
                    </button>
                    <button type="button" class="hlv-pa-tab active" data-tab="chat">Trò chuyện</button>
                    <button type="button" class="hlv-pa-tab" data-tab="history">Lịch sử</button>
                    <button type="button" class="hlv-pa-tab" data-tab="created">Hàng đã tạo</button>
                    <!-- Tài khoản dùng chung nhiều sale: tên người đang chat, bấm vào để đổi người. -->
                    <div class="hlv-pa-who">
                        <button type="button" class="hlv-pa-switch hlv-pa-who-name" title="Bấm để đổi người"/>
                    </div>
                </div>
                <div class="hlv-pa-status"/>
                <div class="hlv-pa-picker">
                    <div class="hlv-pa-picker-title">Tài khoản này dùng chung. Anh/chị là ai?</div>
                    <div class="hlv-pa-picker-hint">Chọn một lần trên máy này; mỗi người một cuộc chat riêng.</div>
                    <div class="hlv-pa-picker-list"/>
                </div>
                <div class="hlv-pa-messages"/>
                <div class="hlv-pa-pane hlv-pa-pane-history"/>
                <div class="hlv-pa-pane hlv-pa-pane-created"/>
                <div class="hlv-pa-previews"/>
                <div class="hlv-pa-input">
                    <label class="hlv-pa-attach" title="Đính kèm ảnh (hoặc dán ảnh vào ô chat)">
                        <i class="fa fa-camera"/>
                        <input type="file" accept="image/*" multiple="multiple" class="d-none"/>
                    </label>
                    <textarea rows="2" maxlength="4000"
                              placeholder="Hỏi trợ lý: tồn kho, giá, tạo mã hàng..." title="Enter để gửi, Shift+Enter xuống dòng"/>
                    <button type="button" class="hlv-pa-send" title="Gửi">
                        <i class="fa fa-paper-plane"/>
                    </button>
                </div>
            </div>
        </div>
    </template>

    <!-- Khai view riêng kế thừa trang tra tồn của module HLV (xmlid ổn định do ta tự đặt).
         Khung chat là cột phải NẰM TRONG container của trang (product_chat.css chia lưới hai
         cột khi container có khung chat — portal không có khung chat thì trang giữ nguyên). Chỉ nhân viên nội bộ thấy: portal không được dùng tool MISA. -->
    <template id="inventory_page_product_chat" inherit_id="website_public_inventory_18.inventory_page">
        <xpath expr="(//div[hasclass('container-fluid')])[1]" position="inside">
            <t t-if="not request.env.user.share">
                <t t-call="hlv_product_agent.product_chat_widget"/>
            </t>
        </xpath>
    </template>
</odoo>
