<odoo>
  <record id="res_config_settings_view_barcode" model="ir.ui.view">
    <field name="name">res.config.settings.view.barcode</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="base_setup.action_general_configuration"/>
    <field name="arch" type="xml">
      <xpath expr="//div[hasclass('app_settings_block')]" position="inside">
        <div class="app_settings_block" data-string="Đóng gói" string="Đóng gói"
             data-key="custom_barcode_scan_redirect">
          <h2>Cài đặt đóng gói</h2>
          <div class="row mt16 o_settings_container">
            <div class="col-12 col-lg-6 o_setting_box">
              <div class="o_setting_left_pane">
                <field name="require_assigned_packer"/>
              </div>
              <div class="o_setting_right_pane">
                <label for="require_assigned_packer"/>
                <div class="text-muted">
                  Nếu bật, chỉ người được gán vào "Người đóng hàng" mới có thể vào trang đóng gói.
                  Admin luôn được phép truy cập.
                </div>
              </div>
            </div>
          </div>
        </div>
      </xpath>
    </field>
  </record>
</odoo>
