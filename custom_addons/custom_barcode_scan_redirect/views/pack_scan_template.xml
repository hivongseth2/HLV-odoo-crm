<odoo>
  <template id="pack_scan_template" name="Pack Scan Template">
    <t t-call="web.layout">
      <t t-set="css_files" t-value="[
        '/custom_barcode_scan_redirect/static/src/css/scan_pack.css'
      ]"/>
      <t t-foreach="css_files" t-as="href">
        <link rel="stylesheet" type="text/css" t-att-href="href"/>
      </t>

      <div class="oe_structure pack-screen">
        <!-- Topbar -->
        <div class="pack-topbar">
          <div class="left">
            <h2>Đóng gói: <span class="hl" t-esc="picking.name"/></h2>
            <div class="sub">
              <span>Từ phiếu Pick:</span>
              <strong class="text-brand" t-esc="origin_pick_name"/>
            </div>
    
          </div>
          <div class="right">
            <span t-if="drive_connected" class="badge badge-ok">Drive đã kết nối</span>
            <span t-if="not drive_connected" class="badge badge-warn">Chưa kết nối Drive</span>
            <button id="btnPrintLabel" class="btn-secondary" title="In nhãn dán sản phẩm">In nhãn</button>
            <button id="btnPartialPack" class="btn-secondary" title="Tạo partial pack">Pack 1 phần</button>
            <button id="btnDriveSwitch" class="btn-secondary">Đổi tài khoản Drive</button>
          </div>
        </div>

        <!-- Main grid -->
        <div class="pack-grid">
          <!-- Left: list -->
          <div class="scan-wrapper card">
            <input id="pack_barcode_input" placeholder="Quét mã sản phẩm..." autofocus="autofocus"/>

            <ul id="product_list" class="product-list">
          <t t-foreach="lines" t-as="line">
            <t t-set="ml" t-value="line.move_line_ids and line.move_line_ids[0]"/>
            <li t-att-data-barcode="line.product_id.barcode" class="product-item" t-att-data-line-id="ml.id">
              <div style="flex: 1; max-width: 70%;">
                <strong><t t-esc="line.product_id.display_name"/></strong>
              </div>
              <div style="display: flex; align-items: center; gap: 5px;">
                <button class="btn-minus" 
                        t-att-data-barcode="line.product_id.barcode" 
                        t-att-data-line-id="ml.id">−</button>
                <span class="done"><t t-esc="sum(line.move_line_ids.mapped('qty_done'))"/></span> /
                <span><t t-esc="line.product_uom_qty"/></span>
                <button class="btn-plus" 
                        t-att-data-barcode="line.product_id.barcode" 
                        t-att-data-line-id="ml.id">+</button>
              </div>
            </li>
          </t>

        </ul>
            <div class="actions">
              <button id="complete_pack_btn" class="btn-primary">Hoàn tất</button>
            </div>
          </div>

          <!-- Right: recording -->
          <div class="recording-pane card">
                <div class="rec-header">
              <span id="recStatus" class="rec-dot">●</span>
              <span id="recText">Đang chuẩn bị camera...</span>
              <span id="recCountdown" class="rec-countdown" title="Tự dừng sau 5 phút">05:00</span>
            </div>

            <video id="recPreview" autoplay="autoplay" muted="muted" playsinline="playsinline"></video>
            <div class="rec-hint">Video sẽ tự upload ngầm ngay khi đang quay.</div>
          </div>
        </div>

        <script>
          const pickingId = <t t-esc="picking.id"/>;
          const originPickName = "<t t-esc='origin_pick_name'/>";
          const driveConnected = <t t-esc="1 if drive_connected else 0"/>;
        </script>
        <div id="toastHost" class="toast-host" aria-live="polite" aria-atomic="true"></div>

        <script src="/custom_barcode_scan_redirect/static/src/js/scan_pack.js"></script>
      </div>
      <!-- PANEL danh sách PACK khác (góc phải) -->
<div class="pack-side-panel">
  <div class="panel-header">
    <div class="panel-title">Gói hàng cùng đơn</div>
    <button type="button" onclick="togglePanelVisibility(this)" class="panel-toggle-btn">
      Ẩn
    </button>
  </div>
  <div class="panel-body">
    <!-- Section 1: Current Picking Packages -->
    <t t-if="picking_packages">
      <div class="panel-section">
        <div class="panel-section-title">Gói hàng đơn này</div>
      </div>
      <ul class="panel-packages-list">
        <t t-foreach="picking_packages" t-as="pkg">
          <li class="package-item-card" t-att-data-package-id="pkg['id']">
            <div class="package-item-header">
              <strong class="package-item-name" t-esc="pkg['name']"/>
              <span class="package-item-qty"><t t-esc="pkg['qty']"/> SP</span>
            </div>
            <button class="btn-package-edit" t-att-data-package-id="pkg['id']" onclick="openPackageEditModal(event)">
              Chỉnh sửa
            </button>
          </li>
        </t>
      </ul>
    </t>
    
    <!-- Empty state for current picking -->
    <t t-if="not picking_packages">
      <div class="panel-section">
        <div class="panel-section-title">Gói hàng đơn này</div>
      </div>
      <div class="panel-empty-state">
        Chưa có gói hàng. Quét sản phẩm và nhấn "Pack 1 phần" để tạo.
      </div>
    </t>
    
    <!-- Section 2: Related Pickings/Sibling Packs -->
    <t t-if="sibling_packs">
      <div class="panel-section panel-section-related">
        <div class="panel-section-title">Đơn hàng khác cùng order</div>
      </div>
      <ul class="panel-packages-list">
        <t t-foreach="sibling_packs" t-as="sp">
          <li class="sibling-package-item" t-att-data-package-id="sp['id']">
            <div class="sibling-package-header">
              <a t-att-href="'/custom_barcode_scan/pack_view/%s' % sp['id']" class="sibling-package-name">
                <t t-esc="sp['name']"/>
              </a>
              <span t-attf-class="package-status #{'status-ready' if sp['state'] in ['assigned','in_progress'] else ('status-pending' if sp['state'] in ['waiting','confirmed'] else 'status-done')}">
                <t t-esc="sp['state_label']"/>
              </span>
            </div>
          </li>
        </t>
      </ul>
    </t>
  </div>
</div>

    <!-- MODAL: Edit Package - Modern Design -->
    <div id="packageEditModal" class="modern-modal-overlay">
      <div class="modern-modal-backdrop"></div>
      <div class="modern-modal-container">
        <!-- Modal Header with Glass Effect -->
        <div class="modern-modal-header">
          <div class="modal-header-content">
            <div class="modal-icon-area">
              <div class="modal-package-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                  <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                  <line x1="12" y1="22.08" x2="12" y2="12"></line>
                </svg>
              </div>
              <div class="modal-icon-glow"></div>
            </div>
            <div class="modal-title-area">
              <h1 class="modern-modal-title">
                <span id="modalPackageName">PACK0000001</span>
              </h1>
              <p class="modern-modal-subtitle">Quản lý sản phẩm trong gói hàng</p>
            </div>
          </div>
          <button onclick="closePackageEditModal()" class="modern-modal-close">
            <span class="close-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </span>
            <div class="close-ripple"></div>
          </button>
        </div>

        <!-- Modal Body with Modern Sections -->
        <div class="modern-modal-body">
          <!-- Current Items Section -->
          <div class="modern-section current-items-section">
            <div class="section-header-modern">
              <div class="section-title-area">
                <h2 class="modern-section-title">
                  <span class="title-icon">📦</span>
                  Sản phẩm hiện có
                </h2>
                <div class="section-accent-line"></div>
              </div>
              <div class="items-counter-modern" id="itemCountBadge">
                <span class="counter-number">0</span>
                <span class="counter-label">items</span>
              </div>
            </div>

            <div class="items-container-modern">
              <div id="packageItemsList" class="modern-items-grid">
                <!-- Items will be populated by JavaScript -->
              </div>

              <!-- Empty State -->
              <div id="emptyStateItems" class="modern-empty-state" style="display: none;">
                <div class="empty-icon">
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                    <line x1="7" y1="7" x2="7.01" y2="7"></line>
                  </svg>
                </div>
                <h3>Chưa có sản phẩm nào</h3>
                <p>Thêm sản phẩm vào gói hàng bên dưới</p>
              </div>
            </div>
          </div>

          <!-- Add Items Section -->
          <div class="modern-section add-items-section">
            <div class="section-header-modern">
              <div class="section-title-area">
                <h2 class="modern-section-title">
                  <span class="title-icon">➕</span>
                  Thêm sản phẩm mới
                </h2>
                <div class="section-accent-line accent-add"></div>
              </div>
            </div>

            <div class="add-form-modern">
              <div class="form-row">
                <div class="form-group-modern">
                  <label class="modern-label">Chọn sản phẩm</label>
                  <div class="select-wrapper">
                    <select id="addItemSelect" class="modern-select">
                      <option value="">-- Chọn sản phẩm --</option>
                      <!-- Options will be populated by JavaScript -->
                    </select>
                    <div class="select-arrow">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                      </svg>
                    </div>
                  </div>
                </div>

                <div class="form-group-modern qty-group">
                  <label class="modern-label">Số lượng</label>
                  <div class="qty-input-wrapper">
                    <button type="button" class="qty-btn qty-minus" onclick="adjustQty(-1)">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                      </svg>
                    </button>
                    <input id="addItemQty" type="number" min="1" value="1" class="modern-qty-input"/>
                    <button type="button" class="qty-btn qty-plus" onclick="adjustQty(1)">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                      </svg>
                    </button>
                  </div>
                </div>
              </div>

              <button onclick="addItemToPackage()" class="modern-add-btn">
                <span class="btn-icon">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </span>
                <span class="btn-text">Thêm vào gói</span>
                <div class="btn-shine"></div>
              </button>
            </div>
          </div>
        </div>

        <!-- Modal Footer with Modern Actions -->
        <div class="modern-modal-footer">
          <div class="footer-actions">
            <button onclick="closePackageEditModal()" class="modern-btn modern-btn-secondary">
              <span class="btn-content">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
                <span>Hủy</span>
              </span>
            </button>

            <!-- Tách đơn tạm thời disable (chức năng chưa dùng) -->
            <!-- <button onclick="splitPackageFromModal()" class="modern-btn modern-btn-warning">
              <span class="btn-content">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                  <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                </svg>
                <span>Tách đơn</span>
              </span>
            </button> -->

            <button onclick="savePackageChanges()" class="modern-btn modern-btn-primary">
              <span class="btn-content">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                  <polyline points="17 21 17 13 7 13 7 21"></polyline>
                  <polyline points="7 3 7 8 15 8"></polyline>
                </svg>
                <span>Lưu thay đổi</span>
              </span>
              <div class="btn-glow"></div>
            </button>
          </div>
        </div>
      </div>
    </div>

    </t>
  </template>
</odoo>
