<odoo>
  <template id="pack_scan_template" name="Pack Scan Template">
    <t t-call="web.layout">
      <t t-set="css_files" t-value="[
        '/custom_barcode_scan_redirect/static/src/css/scan_pack.css'
      ]"/>
      <t t-foreach="css_files" t-as="href">
        <link rel="stylesheet" type="text/css" t-att-href="href"/>
      </t>

      <div class="oe_structure pack-screen">
        <!-- Topbar -->
        <div class="pack-topbar">
          <div class="left">
            <h2>Đóng gói: <span class="hl" t-esc="picking.name"/></h2>
            <div class="sub">
              <span>Từ phiếu Pick:</span>
              <strong class="text-brand" t-esc="origin_pick_name"/>
            </div>
    
          </div>
          <div class="right">
            <span t-if="drive_connected" class="badge badge-ok">Drive đã kết nối</span>
            <span t-if="not drive_connected" class="badge badge-warn">Chưa kết nối Drive</span>
            <button id="btnPrintLabel" title="In nhãn dán sản phẩm">In nhãn</button>
            <button id="btnPartialPack" title="Tạo partial pack">Đóng gói</button>
            <button id="btnDriveSwitch">Đổi tài khoản Drive</button>
          </div>
        </div>

        <!-- Main grid -->
        <div class="pack-grid">
          <!-- Left: list -->
          <div class="scan-wrapper card">
            <input id="pack_barcode_input" placeholder="Quét mã sản phẩm..." autofocus="autofocus"/>

            <ul id="product_list" class="product-list">
          <t t-foreach="lines" t-as="line">
            <t t-set="unassigned_mls" t-value="line.move_line_ids.filtered(lambda x: not x.result_package_id)"/>
            <t t-set="ml" t-value="unassigned_mls and unassigned_mls[0] or (line.move_line_ids and line.move_line_ids[0])"/>
            <li t-att-data-barcode="line.product_id.barcode" class="product-item" t-att-data-line-id="ml.id">
              <div style="flex: 1; max-width: 70%;">
                <strong><t t-esc="line.product_id.display_name"/></strong>
                <div style="font-size: 0.85rem; color: #666; margin-top: 2px;">
                  Barcode: <span t-if="line.product_id.barcode" t-esc="line.product_id.barcode"/>
                  <span t-else="" style="color: #dc3545; font-style: italic;">Không có</span>
                </div>
              </div>
              <div style="display: flex; align-items: center; gap: 5px;">
                <button class="btn-minus" 
                        t-att-data-barcode="line.product_id.barcode" 
                        t-att-data-line-id="ml.id">−</button>
                <span class="done"><t t-esc="sum(line.move_line_ids.mapped('qty_done'))"/></span> /
                <span><t t-esc="line.product_uom_qty"/></span>
                <button class="btn-plus" 
                        t-att-data-barcode="line.product_id.barcode" 
                        t-att-data-line-id="ml.id">+</button>
              </div>
            </li>
          </t>

        </ul>
            <div class="actions">
              <button id="complete_pack_btn">Hoàn tất</button>
            </div>
          </div>

          <!-- Right: recording -->
          <div class="recording-pane card">
                <div class="rec-header">
              <span id="recStatus" class="rec-dot">●</span>
              <span id="recText">Đang chuẩn bị camera...</span>
              <span id="recCountdown" class="rec-countdown" title="Tự dừng sau 5 phút">05:00</span>
            </div>

            <video id="recPreview" autoplay="autoplay" muted="muted" playsinline="playsinline"></video>
            <div class="rec-hint">Video sẽ tự upload ngầm ngay khi đang quay.</div>
          </div>
        </div>

        <script>
          const pickingId = <t t-esc="picking.id"/>;
          const originPickName = "<t t-esc='origin_pick_name'/>";
          const driveConnected = <t t-esc="1 if drive_connected else 0"/>;
        </script>
        <div id="toastHost" class="toast-host" aria-live="polite" aria-atomic="true"></div>

        <script src="/custom_barcode_scan_redirect/static/src/js/scan_pack.js"></script>
      </div>
      <!-- PANEL danh sách PACK khác (góc phải) -->
<div class="pack-side-panel">
  <div class="panel-header">
    <div class="panel-title">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: #228be6;"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
      Gói hàng
    </div>
    <button type="button" onclick="togglePanelVisibility(this)" class="panel-toggle-btn" title="Ẩn panel">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
    </button>
  </div>

  <div class="panel-body">
    <!-- Section 1: Current Picking Packages -->
    <t t-if="picking_packages">
      <div class="panel-section-title" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.6px; color: #868e96; margin-bottom: 0.75rem; font-weight: 700;">Gói hàng hiện tại</div>
      <ul class="panel-packages-list" style="list-style: none; padding: 0; margin: 0;">
        <t t-foreach="picking_packages" t-as="pkg">
          <li class="package-item-card" t-att-data-package-id="pkg['id']">
            <div class="package-item-header">
              <strong class="package-item-name" t-esc="pkg['name']"/>
              <span class="package-item-qty">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
                <t t-esc="pkg['qty']"/>
              </span>
            </div>
            
            <div class="package-items-preview">
              <t t-if="pkg.get('package_lines')">
                <t t-foreach="pkg['package_lines']" t-as="line">
                  <div class="preview-item" style="display: flex; justify-content: space-between; margin-bottom: 0.35rem; align-items: center;">
                    <span class="preview-item-name" t-esc="line['product_name']" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 75%; color: #495057;"/>
                    <span class="preview-item-qty" style="font-weight: 600; color: #343a40; background: #f1f3f5; padding: 0.1rem 0.4rem; border-radius: 4px; font-size: 0.75rem;">x<t t-esc="line['product_qty']"/></span>
                  </div>
                </t>
              </t>
              <t t-elif="pkg.get('move_line_ids')">
                <t t-foreach="pkg['move_line_ids']" t-as="line">
                  <div class="preview-item" style="display: flex; justify-content: space-between; margin-bottom: 0.35rem; align-items: center;">
                    <span class="preview-item-name" t-esc="line['product_name']" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 75%; color: #495057;"/>
                    <span class="preview-item-qty" style="font-weight: 600; color: #343a40; background: #f1f3f5; padding: 0.1rem 0.4rem; border-radius: 4px; font-size: 0.75rem;">x<t t-esc="line['product_qty']"/></span>
                  </div>
                </t>
              </t>
              <t t-else="">
                <div class="preview-empty">
                  Chưa có chi tiết sản phẩm
                </div>
              </t>
            </div>

            <button class="btn-package-edit" t-att-data-package-id="pkg['id']" onclick="openPackageEditModal(event)">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
              Chỉnh sửa
            </button>
          </li>
        </t>
      </ul>
    </t>
    
    <!-- Empty state for current picking -->
    <t t-if="not picking_packages">
      <div class="panel-section-title" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.6px; color: #868e96; margin-bottom: 0.75rem; font-weight: 700;">Gói hàng hiện tại</div>
      <div class="panel-empty-state">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="empty-icon"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
        <p style="margin: 0; font-size: 0.9rem; line-height: 1.5;">Chưa có gói hàng.<br/>Quét sản phẩm và nhấn <strong>"Pack 1 phần"</strong> để tạo.</p>
      </div>
    </t>
    
    <!-- Section 2: Related Pickings/Sibling Packs -->
    <t t-if="sibling_packs">
      <div class="panel-section panel-section-related">
        <div class="panel-section-title">Đơn hàng khác cùng Order</div>
        <ul class="panel-packages-list">
          <t t-foreach="sibling_packs" t-as="sp">
            <li class="sibling-package-item" t-att-data-package-id="sp['id']">
              <div class="sibling-package-header">
                <div class="icon-wrapper" style="background: #f8f9fa; padding: 0.4rem; border-radius: 6px; color: #868e96;">
                   <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path><polyline points="13 2 13 9 20 9"></polyline></svg>
                </div>
                <a t-att-href="'/custom_barcode_scan/pack_view/%s' % sp['id']" class="sibling-package-name">
                  <t t-esc="sp['name']"/>
                </a>
              </div>
              <span t-attf-class="package-status #{'status-ready' if sp['state'] in ['assigned','in_progress'] else ('status-pending' if sp['state'] in ['waiting','confirmed'] else 'status-done')}">
                <t t-esc="sp['state_label']"/>
              </span>
            </li>
          </t>
        </ul>
      </div>
    </t>
  </div>
</div>

    <!-- MODAL: Edit Package -->
    <div id="packageEditModal" class="modal-overlay">
      <div class="modal-container">
        <!-- Header -->
        <div class="modal-header">
          <div class="modal-title-section">
            <h2 class="modal-title">
              <span id="modalPackageName">PACK...</span>
            </h2>
            <p class="modal-subtitle">Quản lý sản phẩm trong gói hàng</p>
          </div>
          <button onclick="closePackageEditModal()" class="modal-close">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
        </div>

        <!-- Content -->
        <div class="modal-content">
          
          <!-- Current Items Card -->
          <div class="modal-card">
            <div class="section-header">
              <h3 class="section-title">Sản phẩm hiện có trong kiện</h3>
              <span class="item-count-badge" id="itemCountBadge">0</span>
            </div>
            <div id="packageItemsList" class="items-list">
              <!-- Items will be populated by JavaScript -->
            </div>
          </div>

          <!-- Add Items Card -->
          <div class="modal-card">
            <div class="section-header">
              <h3 class="section-title">Thêm sản phẩm chưa đóng gói</h3>
            </div>
            <div class="add-form">
              <div class="form-grid">
                <div class="form-group">
                  <label class="form-label">Chọn sản phẩm</label>
                  <select id="addItemSelect" class="form-select">
                    <option value="">-- Chọn sản phẩm --</option>
                  </select>
                </div>
                <div class="form-group form-group-qty">
                  <label class="form-label">Số lượng</label>
                  <input id="addItemQty" type="number" min="1" value="1" class="form-input-qty"/>
                </div>
              </div>
              <button onclick="addItemToPackage()" class="btn-add">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                Thêm vào gói
              </button>
            </div>
          </div>

        </div>

        <!-- Footer Actions -->
        <div class="modal-footer">
          <button onclick="closePackageEditModal()" class="btn btn-secondary">
            Hủy
          </button>
          <button onclick="savePackageChanges()" class="btn btn-primary">
            Lưu thay đổi
          </button>
        </div>
      </div>
    </div>

    </t>
  </template>
</odoo>
