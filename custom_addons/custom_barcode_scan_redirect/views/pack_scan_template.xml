<odoo>
  <template id="pack_scan_template" name="Pack Scan Template">
    <t t-call="web.layout">
      <t t-set="css_files" t-value="[
        '/custom_barcode_scan_redirect/static/src/css/scan_pack.css'
      ]"/>
      <t t-foreach="css_files" t-as="href">
        <link rel="stylesheet" type="text/css" t-att-href="href"/>
      </t>

      <div class="oe_structure">
        <div class="scan-wrapper">
          <h2>
            🚚 Đóng Gói Phiếu: <span><t t-esc="picking.name"/></span>
          </h2>

          <input id="pack_barcode_input" placeholder="Quét mã sản phẩm..." autofocus="autofocus" />

        <ul id="product_list">
          <t t-set="move_lines" t-value="sum([line.move_line_ids for line in lines], request.env['stock.move.line'])"/>
          <t t-foreach="move_lines" t-as="ml">
            <li t-att-data-barcode="ml.product_id.barcode" class="product-item" t-att-data-line-id="ml.id">
              <div style="flex: 1; max-width: 70%;">
                <strong><t t-esc="ml.product_id.display_name"/></strong>
              </div>
              <div style="display: flex; align-items: center; gap: 5px;">
                <button class="btn-minus" t-att-data-barcode="ml.product_id.barcode">−</button>
                <span class="done"><t t-esc="ml.qty_done"/></span> /
                <span><t t-esc="ml.move_id.product_uom_qty"/></span>
                <button class="btn-plus" t-att-data-barcode="ml.product_id.barcode">＋</button>
              </div>
            </li>
          </t>
        </ul>


          <div style="text-align: center;">
            <button id="complete_pack_btn">✅ Hoàn tất</button>
          </div>
        </div>

        <script src="/custom_barcode_scan_redirect/static/src/js/scan_pack.js"></script>
      </div>
    </t>
  </template>
</odoo>
