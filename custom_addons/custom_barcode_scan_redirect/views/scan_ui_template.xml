
<odoo>
  <template id="scan_ui_template" name="Custom Barcode Scan UI">
    <t t-call="web.layout">
      <div class="scan-wrapper">
        <h2>📦 Quét Phiếu Kho</h2>
        <div class="scan-input-group">
          <input type="text" id="barcode_input" placeholder="Nhập hoặc quét mã phiếu..." autofocus="autofocus" />
          <button onclick="triggerScan()">Quét</button>
        </div>
        <div id="scan_status" class="scan-status"></div>
      </div>
      <script type="text/javascript" src="/custom_barcode_scan_redirect/static/src/js/scan_ui.js"/>
    </t>
  </template>
</odoo>