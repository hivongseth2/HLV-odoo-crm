<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 16:30 UTC = 23:30 giờ VN, chạy sau khi kho đã đóng cửa nên số liệu
             trong ngày đã chốt. -->
        <record id="ir_cron_audit_missing_pack_videos" model="ir.cron">
            <field name="name">Pack Video: Đối soát phiếu thiếu video đóng gói</field>
            <field name="model_id" ref="model_custom_barcode_scan_redirect_video_audit"/>
            <field name="state">code</field>
            <field name="code">model._cron_audit_missing_videos()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 16:30:00')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
