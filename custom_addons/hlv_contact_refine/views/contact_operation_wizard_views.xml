<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hlv_contact_vietqr_wizard_form" model="ir.ui.view">
        <field name="name">hlv.contact.vietqr.wizard.form</field>
        <field name="model">hlv.contact.vietqr.wizard</field>
        <field name="arch" type="xml">
            <form string="Tạo liên hệ từ mã số thuế">
                <sheet>
                    <group>
                        <field name="tax_code"
                               placeholder="Ví dụ: 3603151043"
                               options="{'trim': True}"/>
                    </group>
                    <div class="text-muted">
                        Hệ thống sẽ lấy tên doanh nghiệp và địa chỉ từ VietQR,
                        sau đó tạo một liên hệ công ty mới.
                    </div>
                </sheet>
                <footer>
                    <button name="action_fetch_and_create"
                            type="object"
                            string="Lấy dữ liệu và tạo liên hệ"
                            class="btn-primary"/>
                    <button string="Hủy" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hlv_contact_vietqr_wizard" model="ir.actions.act_window">
        <field name="name">Tạo liên hệ từ MST</field>
        <field name="res_model">hlv.contact.vietqr.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_hlv_contact_vietqr_wizard_form"/>
        <field name="target">new</field>
    </record>

    <record id="view_hlv_contact_merge_wizard_form" model="ir.ui.view">
        <field name="name">hlv.contact.merge.wizard.form</field>
        <field name="model">hlv.contact.merge.wizard</field>
        <field name="arch" type="xml">
            <form string="Gộp liên hệ">
                <sheet>
                    <group>
                        <field name="destination_partner_id" options="{'no_create': True}"/>
                        <field name="source_partner_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="note" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_merge" type="object" string="Gộp" class="btn-primary"/>
                    <button string="Hủy" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_hlv_contact_split_wizard_form" model="ir.ui.view">
        <field name="name">hlv.contact.split.wizard.form</field>
        <field name="model">hlv.contact.split.wizard</field>
        <field name="arch" type="xml">
            <form string="Tách / chuyển dữ liệu khách hàng">
                <sheet>
                    <group>
                        <field name="source_partner_id" options="{'no_create': True}"/>
                        <field name="split_mode" widget="radio"/>
                    </group>
                    <group string="Công ty nhận dữ liệu" invisible="split_mode != 'existing'">
                        <field name="destination_partner_id" options="{'no_create': True}"/>
                    </group>
                    <group string="Tạo công ty mới" invisible="split_mode != 'new'">
                        <field name="new_name"/>
                        <field name="new_vat"/>
                        <field name="new_ref"/>
                    </group>
                    <notebook>
                        <page string="Nạp đơn từ Excel">
                            <group>
                                <field name="excel_file" filename="excel_filename"/>
                                <field name="excel_filename" invisible="1"/>
                                <button name="action_load_sale_orders_from_excel"
                                        type="object"
                                        string="Nạp đơn từ file"
                                        class="btn-secondary"
                                        invisible="not excel_file"/>
                            </group>
                            <group>
                                <field name="excel_row_count" readonly="1"/>
                                <field name="excel_match_count" readonly="1"/>
                            </group>
                            <field name="excel_message" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Chuyển dữ liệu">
                            <group>
                                <field name="child_partner_ids" widget="many2many_tags" domain="[('parent_id', '=', source_partner_id)]"/>
                                <field name="sale_order_ids" domain="[('partner_id', 'child_of', source_partner_id)]"/>
                                <field name="purchase_order_ids" domain="[('partner_id', 'child_of', source_partner_id)]"/>
                            </group>
                        </page>
                        <page string="Ghi chú">
                            <field name="note" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_split" type="object" string="Chuyển dữ liệu" class="btn-primary"/>
                    <button string="Hủy" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
