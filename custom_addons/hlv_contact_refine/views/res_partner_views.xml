<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add generic filter for top-level contacts -->
    <record id="view_res_partner_filter_refine" model="ir.ui.view">
        <field name="name">res.partner.select.refine</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='type_person']" position="before">
                <filter string="Liên hệ chính" name="filter_only_parents" domain="[('parent_id', '=', False)]"/>
                <filter string="Địa chỉ giao hàng" name="filter_type_delivery" domain="[('type', '=', 'delivery')]"/>
                <separator/>
            </xpath>
            <xpath expr="//search" position="inside">
                <searchpanel>
                    <field name="company_type" icon="fa-users" enable_counters="1"/>
                    <field name="hlv_filter_tag_ids" string="Phân loại" icon="fa-tags" select="multi" enable_counters="1"/>
                </searchpanel>
            </xpath>
        </field>
    </record>

    <!-- Set this filter as default for the Contacts app action -->
    <record id="contacts.action_contacts" model="ir.actions.act_window">
        <!-- Ensure default_is_company is True so new contacts are companies by default -->
        <field name="context">{'default_is_company': True, 'search_default_filter_only_parents': 1}</field>
    </record>
</odoo>
