<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_refresh_contact_classification" model="ir.actions.server">
        <field name="name">Quét lại phân loại liên hệ</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = model.action_hlv_refresh_contact_classification()</field>
    </record>

    <record id="action_convert_to_company" model="ir.actions.server">
        <field name="name">Quét lại phân loại liên hệ</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = model.action_hlv_refresh_contact_classification()</field>
    </record>

    <record id="action_hlv_open_merge_wizard" model="ir.actions.server">
        <field name="name">Gộp liên hệ</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_hlv_open_merge_wizard()</field>
    </record>

    <record id="action_hlv_open_split_wizard" model="ir.actions.server">
        <field name="name">Tách thành khách hàng mới</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">action = record.action_hlv_open_split_wizard()</field>
    </record>

    <record id="action_misa_contact_bulk_sync" model="ir.actions.server">
        <field name="name">Cập nhật thông tin từ MISA</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">action = model.action_misa_update_bulk()</field>
    </record>

    <menuitem id="menu_convert_company_scan"
              name="Quét lại phân loại liên hệ"
              parent="contacts.res_partner_menu_config"
              action="action_refresh_contact_classification"
              sequence="50"/>

    <menuitem id="menu_misa_contact_bulk_sync"
              name="Cập nhật thông tin từ MISA"
              parent="contacts.res_partner_menu_config"
              action="action_misa_contact_bulk_sync"
              sequence="60"/>
</odoo>
