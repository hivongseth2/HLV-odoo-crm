<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- API Groups -->
        <record id="group_api_user" model="res.groups">
            <field name="name">API User</field>
            <field name="category_id" ref="base.module_category_technical_settings"/>
        </record>

        <record id="group_api_manager" model="res.groups">
            <field name="name">API Manager</field>
            <field name="category_id" ref="base.module_category_technical_settings"/>
            <field name="implied_ids" eval="[(4, ref('group_api_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Record Rules -->
        <record id="api_namespace_rule_user" model="ir.rule">
            <field name="name">API Namespace: User can see allowed namespaces</field>
            <field name="model_id" ref="model_api_namespace"/>
            <field name="domain_force">[('user_ids', 'in', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_api_user'))]"/>
        </record>

        <record id="api_namespace_rule_manager" model="ir.rule">
            <field name="name">API Namespace: Manager can see all</field>
            <field name="model_id" ref="model_api_namespace"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_api_manager'))]"/>
        </record>

        <record id="api_access_rule_user" model="ir.rule">
            <field name="name">API Access: User can see allowed</field>
            <field name="model_id" ref="model_api_access"/>
            <field name="domain_force">[('namespace_id.user_ids', 'in', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_api_user'))]"/>
        </record>

        <record id="api_access_rule_manager" model="ir.rule">
            <field name="name">API Access: Manager can see all</field>
            <field name="model_id" ref="model_api_access"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_api_manager'))]"/>
        </record>

        <record id="api_log_rule_user" model="ir.rule">
            <field name="name">API Log: User can see own logs</field>
            <field name="model_id" ref="model_api_log"/>
            <field name="domain_force">[('namespace_id.user_ids', 'in', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_api_user'))]"/>
        </record>

        <record id="api_log_rule_manager" model="ir.rule">
            <field name="name">API Log: Manager can see all</field>
            <field name="model_id" ref="model_api_log"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_api_manager'))]"/>
        </record>
    </data>
</odoo>
