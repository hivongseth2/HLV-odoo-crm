<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_api_log_list" model="ir.ui.view">
        <field name="name">api.log.list</field>
        <field name="model">api.log</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="true">
                <field name="create_date"/>
                <field name="namespace_id"/>
                <field name="request"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_api_log_form" model="ir.ui.view">
        <field name="name">api.log.form</field>
        <field name="model">api.log</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="true">
                <sheet>
                    <group>
                        <field name="create_date" readonly="1"/>
                        <field name="namespace_id" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Request">
                            <group>
                                <field name="request" readonly="1"/>
                                <field name="request_data" readonly="1" widget="text"/>
                            </group>
                        </page>
                        <page string="Response">
                            <field name="response_data" readonly="1" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_api_log_search" model="ir.ui.view">
        <field name="name">api.log.search</field>
        <field name="model">api.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="namespace_id"/>
                <field name="request"/>
                <filter string="Today" name="today" 
                        domain="[('create_date', '&gt;=', datetime.datetime.now().strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter string="Last 7 Days" name="week"
                        domain="[('create_date', '&gt;=', (datetime.datetime.now() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter string="This Month" name="month"
                        domain="[('create_date', '&gt;=', (datetime.datetime.now().replace(day=1)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Namespace" name="groupby_namespace" context="{'group_by': 'namespace_id'}"/>
                    <filter string="Date" name="groupby_date" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_api_log" model="ir.actions.act_window">
        <field name="name">API Logs</field>
        <field name="res_model">api.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_api_log_search"/>
        <field name="context">{'search_default_today': 1}</field>
    </record>
</odoo>
