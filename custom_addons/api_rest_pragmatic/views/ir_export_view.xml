<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_pragmatic_ir_export_form" model="ir.ui.view">
        <field name="name">pragmatic.ir.export.form</field>
        <field name="model">ir.exports</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="export_fields"  widget="one2many">
                            <list editable="bottom">
                                <field name="name"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
