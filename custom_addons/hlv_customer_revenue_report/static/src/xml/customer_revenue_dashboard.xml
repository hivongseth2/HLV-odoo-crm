<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hlv_customer_revenue_report.Dashboard">
        <div class="hcr-dashboard">
            <div class="hcr-header">
                <h3 class="hcr-title">Doanh thu theo khách hàng</h3>
                <div class="hcr-toolbar">
                    <div class="hcr-search-wrap">
                        <input type="text" class="form-control hcr-search-input"
                               placeholder="Tìm khách hàng (VD: BM WINDOW)..."
                               t-att-value="state.searchTerm"
                               t-on-input="onSearchInput"
                               t-on-blur="onSearchBlur"/>
                        <div class="hcr-suggestions" t-if="state.showSuggestions">
                            <div t-foreach="state.suggestions" t-as="item" t-key="item.id"
                                 class="hcr-suggestion-item"
                                 t-on-click="() => this.selectCustomer(item)">
                                <t t-esc="item.name"/>
                            </div>
                        </div>
                    </div>
                    <input type="date" class="form-control hcr-date-input" t-model="state.dateFrom" t-on-change="onDateChange"/>
                    <span class="hcr-date-sep">→</span>
                    <input type="date" class="form-control hcr-date-input" t-model="state.dateTo" t-on-change="onDateChange"/>
                    <button class="btn btn-primary hcr-export-btn" t-on-click="exportExcel" t-att-disabled="!state.partnerId">
                        <i class="fa fa-file-excel-o"/> Xuất Excel
                    </button>
                </div>
            </div>

            <div class="hcr-empty" t-if="!state.partnerId">
                <i class="fa fa-search"/>
                <p>Nhập tên khách hàng để xem doanh thu theo tháng (đặt hàng / trả hàng / xuất ròng).</p>
            </div>

            <t t-if="state.partnerId">
                <div class="hcr-customer-banner">
                    <i class="fa fa-building"/> <b t-esc="state.partnerName"/>
                </div>

                <div class="hcr-loading" t-if="state.isLoading">
                    <i class="fa fa-spinner fa-spin"/> Đang tải dữ liệu...
                </div>

                <t t-if="!state.isLoading">
                    <table class="table table-sm hcr-table" t-if="state.months.length">
                        <thead>
                            <tr>
                                <th>Tháng</th>
                                <th class="hcr-col-num">Số đơn</th>
                                <th class="hcr-col-num">SL xuất kho</th>
                                <th class="hcr-col-num">SL trả hàng</th>
                                <th class="hcr-col-num">SL thực xuất</th>
                                <th class="hcr-col-num">Tiền đặt hàng (gộp)</th>
                                <th class="hcr-col-num">Tiền trả hàng</th>
                                <th class="hcr-col-num">Doanh thu xuất ròng</th>
                                <th class="hcr-col-action"/>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="state.months" t-as="month" t-key="month.month_label"
                                class="hcr-row" t-on-click="() => this.openMonthDrawer(month)">
                                <td><b t-esc="month.month_label"/></td>
                                <td class="hcr-col-num" t-esc="month.order_count"/>
                                <td class="hcr-col-num" t-esc="formatNumber(month.qty_delivered)"/>
                                <td class="hcr-col-num" t-esc="formatNumber(month.qty_returned)"/>
                                <td class="hcr-col-num" t-esc="formatNumber(month.qty_net)"/>
                                <td class="hcr-col-num" t-esc="formatCurrency(month.amount_gross)"/>
                                <td class="hcr-col-num hcr-negative" t-esc="formatCurrency(month.amount_returned)"/>
                                <td class="hcr-col-num hcr-net" t-esc="formatCurrency(month.amount_net)"/>
                                <td class="hcr-col-action"><i class="fa fa-chevron-right"/></td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr class="hcr-total-row">
                                <td><b>Tổng cộng</b></td>
                                <td class="hcr-col-num" t-esc="totals.order_count"/>
                                <td class="hcr-col-num" t-esc="formatNumber(totals.qty_delivered)"/>
                                <td class="hcr-col-num" t-esc="formatNumber(totals.qty_returned)"/>
                                <td class="hcr-col-num" t-esc="formatNumber(totals.qty_net)"/>
                                <td class="hcr-col-num" t-esc="formatCurrency(totals.amount_gross)"/>
                                <td class="hcr-col-num hcr-negative" t-esc="formatCurrency(totals.amount_returned)"/>
                                <td class="hcr-col-num hcr-net" t-esc="formatCurrency(totals.amount_net)"/>
                                <td class="hcr-col-action"/>
                            </tr>
                        </tfoot>
                    </table>

                    <div class="hcr-empty" t-if="!state.months.length">
                        <i class="fa fa-inbox"/>
                        <p>Không có dữ liệu xuất kho cho khách hàng này trong khoảng thời gian đã chọn.</p>
                    </div>
                </t>
            </t>

            <!-- Drawer chi tiết đơn hàng của 1 tháng -->
            <div class="hcr-drawer-overlay" t-if="state.drawerOpen" t-on-click="onDrawerOverlayClick">
                <div class="hcr-drawer">
                    <div class="hcr-drawer-header">
                        <div>
                            <h5 class="m-0">Chi tiết đơn hàng</h5>
                            <small t-if="state.drawerMonth" t-esc="state.drawerMonth.month_label"/>
                        </div>
                        <i class="fa fa-times hcr-drawer-close" t-on-click="closeDrawer"/>
                    </div>
                    <div class="hcr-drawer-body">
                        <div class="hcr-loading" t-if="state.drawerLoading">
                            <i class="fa fa-spinner fa-spin"/> Đang tải...
                        </div>
                        <table class="table table-sm" t-if="!state.drawerLoading and state.drawerRows.length">
                            <thead>
                                <tr>
                                    <th>Đơn hàng</th>
                                    <th class="hcr-col-num">SL xuất</th>
                                    <th class="hcr-col-num">SL trả</th>
                                    <th class="hcr-col-num">SL ròng</th>
                                    <th class="hcr-col-num">Tiền gộp</th>
                                    <th class="hcr-col-num">Tiền trả</th>
                                    <th class="hcr-col-num">Tiền ròng</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="state.drawerRows" t-as="line"
                                    t-key="line.sale_order_id || line.sale_order_name"
                                    class="hcr-drawer-row" t-on-click="() => this.openSaleOrder(line.sale_order_id)">
                                    <td class="hcr-order-link" t-esc="line.sale_order_name"/>
                                    <td class="hcr-col-num" t-esc="formatNumber(line.qty_delivered)"/>
                                    <td class="hcr-col-num" t-esc="formatNumber(line.qty_returned)"/>
                                    <td class="hcr-col-num" t-esc="formatNumber(line.qty_net)"/>
                                    <td class="hcr-col-num" t-esc="formatCurrency(line.amount_gross)"/>
                                    <td class="hcr-col-num hcr-negative" t-esc="formatCurrency(line.amount_returned)"/>
                                    <td class="hcr-col-num hcr-net" t-esc="formatCurrency(line.amount_net)"/>
                                </tr>
                            </tbody>
                        </table>
                        <div class="hcr-empty" t-if="!state.drawerLoading and !state.drawerRows.length">
                            <p>Không có đơn hàng nào trong tháng này.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
