<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="pos_customer_type_view_tree" model="ir.ui.view">
        <field name="name">pos.customer.type.list</field>
        <field name="model">pos.customer.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="color"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="pos_customer_type_view_form" model="ir.ui.view">
        <field name="name">pos.customer.type.form</field>
        <field name="model">pos.customer.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Nhập tên loại khách hàng..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="color"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="pos_customer_type_action" model="ir.actions.act_window">
        <field name="name">Loại khách hàng</field>
        <field name="res_model">pos.customer.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo loại khách hàng đầu tiên
            </p>
            <p>
                Loại khách hàng dùng để phân loại khách hàng trên POS.
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="pos_customer_type_menu"
              name="Loại khách hàng"
              parent="point_of_sale.menu_point_config_product"
              action="pos_customer_type_action"
              sequence="30"/>
</odoo>
