<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Add Customer Type Header to Partner List -->
    <t t-name="hlv_pos_customer_type.PartnerList" t-inherit="point_of_sale.PartnerList" t-inherit-mode="extension" owl="1">
        <xpath expr="//th[contains(@class, 'partner-line-email')]" position="before">
            <th class="partner-line-type py-2">Loại KH</th>
        </xpath>
    </t>

    <!-- Add Customer Type Value to Partner Line -->
    <t t-name="hlv_pos_customer_type.PartnerLine" t-inherit="point_of_sale.PartnerLine" t-inherit-mode="extension" owl="1">
        <xpath expr="//td[contains(@class, 'partner-line-email')]" position="before">
            <td class="partner-line-type">
                <t t-if="props.partner.pos_customer_type">
                    <span class="badge text-bg-info" t-if="props.partner.pos_customer_type == 'cash'">Tiền mặt</span>
                    <span class="badge text-bg-warning" t-if="props.partner.pos_customer_type == 'bank'">Chuyển khoản</span>
                </t>
            </td>
        </xpath>
        
        <!-- For Mobile View (Optional: display in partner-info div) -->
        <xpath expr="//div[contains(@class, 'partner-line-email')]" position="before">
             <div class="partner-line-type p-1" t-if="props.partner.pos_customer_type">
                <i class="fa fa-fw fa-tag me-2" />
                <span t-if="props.partner.pos_customer_type == 'cash'">Tiền mặt</span>
                <span t-if="props.partner.pos_customer_type == 'bank'">Chuyển khoản</span>
            </div>
        </xpath>
    </t>

</templates>
