<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Add Customer Type Header to Partner List -->
    <t t-name="hlv_pos_customer_type.PartnerList" t-inherit="point_of_sale.PartnerList" t-inherit-mode="extension" owl="1">
        <!-- Insert before the empty action column at the end -->
        <xpath expr="//th[last()]" position="before">
            <th class="partner-line-type py-2">Loại KH</th>
        </xpath>
    </t>

    <!-- Add Customer Type Value to Partner Line with Inline Editing -->
    <t t-name="hlv_pos_customer_type.PartnerLine" t-inherit="point_of_sale.PartnerLine" t-inherit-mode="extension" owl="1">
        <!-- Insert before the FIRST action cell (Checkmark/Action) to avoid splitting them -->
        <xpath expr="//td[contains(@class, 'edit-partner-button-cell')][1]" position="before">
            <td class="partner-line-type" t-on-click="onToggleCustomerType" style="cursor: pointer;">
                <t t-set="typeName" t-value="getCustomerTypeName()"/>
                <t t-set="typeColor" t-value="getCustomerTypeColor()"/>
                <t t-if="typeName">
                    <span t-attf-class="badge text-bg-{{ typeColor }}" t-esc="typeName"/>
                </t>
                <t t-else="">
                    <span class="badge text-bg-secondary" style="opacity: 0.5;">- Chọn -</span>
                </t>
            </td>
        </xpath>
        
        <!-- For Mobile View -->
        <xpath expr="//div[hasclass('partner-info')]/div[1]" position="inside">
            <t t-set="typeName" t-value="getCustomerTypeName()"/>
            <div class="partner-line-type p-1" t-if="typeName" t-on-click="onToggleCustomerType">
                <i class="fa fa-fw fa-tag me-2" />
                <span t-esc="typeName"/>
            </div>
        </xpath>
    </t>

</templates>

