<odoo>
  <template id="report_stock_picking_label_document">
    <t t-call="web.basic_layout">
      <main>
        <t t-foreach="docs" t-as="o">
          <div style="width: 100mm; height: 50mm; font-size: 15pt; page-break-after: always; padding: 1mm;">
            <strong>Đơn hàng:</strong> <t t-esc="o.name"/><br/>
            <div style="margin-top: 4mm;">
              <img t-att-src="'/report/barcode/Code128/%s' % o.name" style="width:100%; height:25mm;"/>
            </div>
          </div>
        </t>
      </main>
    </t>
  </template>
</odoo>
