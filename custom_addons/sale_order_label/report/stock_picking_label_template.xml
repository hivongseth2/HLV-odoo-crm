<odoo>
  <template id="report_stock_picking_label_document">
    <t t-call="web.basic_layout">
      <main>
        <t t-foreach="docs" t-as="o">
          <div style="width: 100mm; height: 50mm; font-size: 12pt; page-break-after: always; padding: 3mm; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center;">
            <div style="margin-bottom: 5mm;">
              <strong style="font-size: 14pt;">Đơn hàng:</strong> <span style="font-size: 14pt;"><t t-esc="o.name"/></span>
            </div>
            <div style="width: 90mm;">
              <img t-att-src="'/report/barcode/Code128/%s' % o.name" style="width:100%; height:18mm;" />
            </div>
          </div>
        </t>
      </main>
    </t>
  </template>
</odoo>
