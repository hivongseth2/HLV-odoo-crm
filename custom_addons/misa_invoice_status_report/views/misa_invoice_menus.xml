<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Server action: mở action_misa_invoice_status_report với domain đã áp mốc ngày đối soát -->
    <record id="action_server_misa_invoice_list_menu" model="ir.actions.server">
        <field name="name">Danh sách phiếu</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="state">code</field>
        <field name="code">action = model.get_misa_invoice_report_action()</field>
    </record>

    <!-- App độc lập: root không có parent -->
    <menuitem id="menu_misa_invoice_root"
              name="Đối soát XHD MISA"
              sequence="70"/>

    <menuitem id="menu_misa_invoice_dashboard"
              name="Tổng quan"
              parent="menu_misa_invoice_root"
              action="action_misa_invoice_dashboard"
              sequence="10"/>

    <menuitem id="menu_misa_invoice_status_report"
              name="Danh sách phiếu"
              parent="menu_misa_invoice_root"
              action="action_server_misa_invoice_list_menu"
              sequence="20"/>
</odoo>
