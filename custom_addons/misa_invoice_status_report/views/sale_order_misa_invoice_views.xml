<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ Report: list ĐƠN HÀNG (key = sale.order) ============ -->
    <record id="view_misa_invoice_order_report_list" model="ir.ui.view">
        <field name="name">sale.order.misa.invoice.status.list</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <list string="Đơn hàng liên quan đối soát MISA" create="0" delete="0"
                  decoration-danger="misa_invoice_state == 'missing'"
                  decoration-warning="misa_invoice_state in ('requested', 'partial')"
                  decoration-success="misa_invoice_state == 'invoiced'"
                  decoration-muted="misa_invoice_state == 'not_checked'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date_order"/>
                <field name="misa_invoice_picking_ids" widget="many2many_tags" optional="show"/>
                <field name="amount_total" sum="Tổng tiền đơn"/>
                <field name="misa_invoice_amount" string="Đã xuất HĐ MISA" sum="Tổng đã xuất HĐ"/>
                <field name="misa_invoice_outstanding_amount" string="Chưa xuất HĐ" sum="Tổng chưa xuất HĐ"/>
                <field name="misa_invoice_state" widget="badge"
                       decoration-danger="misa_invoice_state == 'missing'"
                       decoration-warning="misa_invoice_state in ('requested', 'partial')"
                       decoration-success="misa_invoice_state == 'invoiced'"
                       decoration-muted="misa_invoice_state == 'not_checked'"/>
            </list>
        </field>
    </record>

    <!-- ============ Report: search ĐƠN HÀNG ============ -->
    <record id="view_misa_invoice_order_report_search" model="ir.ui.view">
        <field name="name">sale.order.misa.invoice.status.search</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm đơn hàng đối soát MISA">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="misa_invoice_picking_ids" string="Phiếu xuất kho"/>
            </search>
        </field>
    </record>

    <!-- ============ Action (mở từ nút "Xem tất cả đơn hàng" trên dashboard) ============ -->
    <record id="action_misa_invoice_order_report" model="ir.actions.act_window">
        <field name="name">Đơn hàng liên quan đối soát MISA</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_misa_invoice_order_report_list"/>
        <field name="search_view_id" ref="view_misa_invoice_order_report_search"/>
    </record>
</odoo>
