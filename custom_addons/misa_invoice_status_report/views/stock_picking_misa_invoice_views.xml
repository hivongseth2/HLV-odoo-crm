<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ Form view: thêm nút + tab tình trạng HĐ MISA ============ -->
    <record id="view_picking_form_misa_invoice_inherit" model="ir.ui.view">
        <field name="name">stock.picking.form.misa.invoice.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//button[@name='button_validate']" position="after">
                    <button name="action_check_misa_invoice_status" type="object"
                            string="Kiểm tra HĐ MISA" class="btn-secondary"
                            invisible="picking_type_code != 'outgoing' or state != 'done'"/>
                    <button name="action_mark_misa_invoice_exception" type="object"
                            string="Đánh dấu ngoại lệ" class="btn-secondary"
                            groups="misa_invoice_status_report.group_misa_invoice_reconciliation"
                            invisible="picking_type_code != 'outgoing' or state != 'done' or misa_invoice_exception"/>
                    <button name="action_unmark_misa_invoice_exception" type="object"
                            string="Bỏ ngoại lệ" class="btn-secondary"
                            groups="misa_invoice_status_report.group_misa_invoice_reconciliation"
                            invisible="not misa_invoice_exception"/>
                    <button name="action_open_misa_invoice_manual_link_wizard" type="object"
                            string="Gắn mã đề nghị (đã xuất HĐ thủ công)" class="btn-secondary"
                            groups="misa_invoice_status_report.group_misa_invoice_reconciliation"
                            invisible="picking_type_code != 'outgoing' or state != 'done' or misa_invoice_state == 'invoiced'"/>
                </xpath>
                <xpath expr="//notebook" position="inside">
                    <page string="Hóa đơn MISA" name="misa_invoice_status"
                          invisible="picking_type_code != 'outgoing'">
                        <group>
                            <group string="Tình trạng">
                                <field name="misa_invoice_state" widget="badge"
                                       decoration-danger="misa_invoice_state == 'missing'"
                                       decoration-warning="misa_invoice_state == 'requested'"
                                       decoration-success="misa_invoice_state == 'invoiced'"
                                       decoration-muted="misa_invoice_state == 'not_checked'"
                                       readonly="1"/>
                                <field name="misa_invoice_last_checked" readonly="1"/>
                                <field name="misa_invoice_request_refid" readonly="1"/>
                                <field name="misa_invoice_manual_refno" readonly="1"
                                       invisible="not misa_invoice_manual_refno"/>
                                <field name="misa_invoice_sale_order_ids" widget="many2many_tags" readonly="1"/>
                                <field name="misa_invoice_saler_code" readonly="1"/>
                            </group>
                            <group string="Hóa đơn (nếu đã xuất)">
                                <field name="misa_invoice_no" readonly="1"/>
                                <field name="misa_invoice_date" readonly="1"/>
                                <field name="misa_invoice_amount" readonly="1"/>
                                <field name="misa_invoice_amount_diff" readonly="1"
                                       invisible="misa_invoice_state != 'invoiced'"
                                       decoration-danger="misa_invoice_amount_mismatch"/>
                            </group>
                        </group>
                        <group string="Xuất hóa đơn gộp chung" invisible="not misa_invoice_master_picking_id and not misa_invoice_covered_picking_ids">
                            <field name="misa_invoice_master_picking_id" readonly="1"
                                   invisible="not misa_invoice_master_picking_id"
                                   string="Phiếu gốc (đề nghị HĐ nằm ở phiếu này)"/>
                            <field name="misa_invoice_covered_picking_ids" readonly="1" widget="many2many_tags"
                                   invisible="not misa_invoice_covered_picking_ids"
                                   string="Đề nghị HĐ này gộp chung cho các phiếu"/>
                        </group>
                        <group string="Ngoại lệ" invisible="not misa_invoice_exception">
                            <field name="misa_invoice_exception_reason" readonly="1" nolabel="1"/>
                            <field name="misa_invoice_exception_by_id" readonly="1"/>
                            <field name="misa_invoice_exception_date" readonly="1"/>
                        </group>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <!-- ============ Report: list ============ -->
    <record id="view_misa_invoice_status_report_list" model="ir.ui.view">
        <field name="name">stock.picking.misa.invoice.status.list</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <list string="Đối soát xuất hóa đơn MISA" create="0" delete="0"
                  decoration-danger="misa_invoice_state == 'missing' and not misa_invoice_exception"
                  decoration-warning="misa_invoice_state == 'requested' and not misa_invoice_exception"
                  decoration-success="misa_invoice_state == 'invoiced' and not misa_invoice_amount_mismatch"
                  decoration-muted="misa_invoice_exception">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="misa_invoice_sale_order_ids" widget="many2many_tags" optional="show"/>
                <field name="misa_invoice_saler_code" optional="show"/>
                <field name="picking_type_id" optional="hide"/>
                <field name="date_done" string="Ngày xuất kho"/>
                <field name="misa_invoice_state" widget="badge"
                       decoration-danger="misa_invoice_state == 'missing'"
                       decoration-warning="misa_invoice_state == 'requested'"
                       decoration-success="misa_invoice_state == 'invoiced'"
                       decoration-muted="misa_invoice_state == 'not_checked'"/>
                <field name="misa_invoice_no" optional="show"/>
                <field name="misa_invoice_date" optional="show"/>
                <field name="x_studio_tng_tin_sau_thu" string="Tiền Odoo xuất kho" optional="show" sum="Tổng tiền Odoo"/>
                <field name="misa_invoice_amount" optional="show" sum="Tổng tiền HĐ"/>
                <field name="misa_invoice_amount_mismatch" widget="boolean_toggle" readonly="1" optional="show"/>
                <field name="misa_invoice_multi_order_group" widget="boolean_toggle" readonly="1" optional="hide"/>
                <field name="misa_invoice_group_order_names" string="Đơn bán trong nhóm gộp" optional="show"/>
                <field name="misa_invoice_master_picking_id" string="Phiếu gốc" optional="hide"/>
                <field name="misa_invoice_covered_picking_ids" widget="many2many_tags" string="Phiếu đi kèm" optional="hide"/>
                <field name="misa_invoice_manual_refno" string="Mã đề nghị (gắn tay)" optional="hide"/>
                <field name="misa_invoice_last_checked"/>
                <field name="misa_invoice_exception" widget="boolean_toggle" readonly="1"/>
                <button name="action_check_misa_invoice_status" type="object"
                        string="Kiểm tra ngay" class="btn-link"/>
                <button name="action_open_misa_invoice_manual_link_wizard" type="object"
                        string="Gắn mã đề nghị" class="btn-link"
                        groups="misa_invoice_status_report.group_misa_invoice_reconciliation"
                        invisible="misa_invoice_state == 'invoiced'"/>
            </list>
        </field>
    </record>

    <!-- ============ Report: search ============ -->
    <record id="view_misa_invoice_status_report_search" model="ir.ui.view">
        <field name="name">stock.picking.misa.invoice.status.search</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm đối soát xuất hóa đơn MISA">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="misa_invoice_sale_order_ids"/>
                <field name="misa_invoice_saler_code"/>
                <field name="misa_invoice_no"/>
                <field name="date_done"/>
                <filter string="Chưa có đề nghị" name="filter_missing"
                        domain="[('misa_invoice_state', '=', 'missing')]"/>
                <filter string="Đã đề nghị, chờ HĐ" name="filter_requested"
                        domain="[('misa_invoice_state', '=', 'requested')]"/>
                <filter string="Đã xuất HĐ" name="filter_invoiced"
                        domain="[('misa_invoice_state', '=', 'invoiced')]"/>
                <separator/>
                <filter string="Lệch tiền với MISA" name="filter_mismatch"
                        domain="[('misa_invoice_amount_mismatch', '=', True)]"/>
                <filter string="Đã đánh dấu ngoại lệ" name="filter_exception"
                        domain="[('misa_invoice_exception', '=', True)]"/>
                <filter string="Chưa đánh dấu ngoại lệ" name="filter_no_exception"
                        domain="[('misa_invoice_exception', '=', False)]"/>
                <filter string="Gộp chung nhiều đơn bán" name="filter_multi_order_group"
                        domain="[('misa_invoice_multi_order_group', '=', True)]"/>
                <filter string="Đã gắn mã đề nghị thủ công" name="filter_manual_refno"
                        domain="[('misa_invoice_manual_refno', '!=', False)]"/>
                <separator/>
                <filter string="Ngày xuất kho" name="filter_date_done" date="date_done"/>
                <separator/>
                <group expand="1" string="Nhóm theo">
                    <filter string="Trạng thái" name="groupby_state" context="{'group_by': 'misa_invoice_state'}"/>
                    <filter string="Kho" name="groupby_warehouse" context="{'group_by': 'picking_type_id'}"/>
                    <filter string="Nhân viên sale" name="groupby_saler" context="{'group_by': 'misa_invoice_saler_code'}"/>
                    <filter string="Khách hàng" name="groupby_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Tháng xuất kho" name="groupby_date_done" context="{'group_by': 'date_done:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============ Action (danh sách chi tiết) ============ -->
    <record id="action_misa_invoice_status_report" model="ir.actions.act_window">
        <field name="name">Danh sách phiếu</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_misa_invoice_status_report_list"/>
        <field name="search_view_id" ref="view_misa_invoice_status_report_search"/>
        <field name="domain">[('picking_type_id.code', '=', 'outgoing'), ('state', '=', 'done')]</field>
        <field name="context">{'search_default_filter_no_exception': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smile">
                Danh sách được đối soát tự động mỗi 30 phút (chỉ quét các phiếu chưa xuất hóa đơn).
                Xem cột "MISA kiểm tra lúc" trên từng dòng để biết dữ liệu tính tới thời điểm nào,
                hoặc chọn dòng rồi dùng menu ⚙ Hành động &gt; "Kiểm tra MISA ngay" để chủ động fetch mới nhất.
            </p>
        </field>
    </record>

    <!-- ============ Bulk manual refresh từ menu ⚙ Hành động ============ -->
    <record id="action_server_misa_invoice_status_refresh" model="ir.actions.server">
        <field name="name">Kiểm tra MISA ngay</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_check_misa_invoice_status()</field>
    </record>

    <!-- ============ Đánh dấu/bỏ ngoại lệ hàng loạt từ menu ⚙ Hành động (chỉ nhóm Đối soát XHD) ============ -->
    <record id="action_server_misa_invoice_mark_exception" model="ir.actions.server">
        <field name="name">Đánh dấu ngoại lệ</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_mark_misa_invoice_exception()</field>
        <field name="groups_id" eval="[(4, ref('misa_invoice_status_report.group_misa_invoice_reconciliation'))]"/>
    </record>

    <record id="action_server_misa_invoice_unmark_exception" model="ir.actions.server">
        <field name="name">Bỏ ngoại lệ</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_unmark_misa_invoice_exception()</field>
        <field name="groups_id" eval="[(4, ref('misa_invoice_status_report.group_misa_invoice_reconciliation'))]"/>
    </record>
</odoo>
