<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_misa_invoice_exception_wizard_form" model="ir.ui.view">
        <field name="name">misa.invoice.exception.wizard.form</field>
        <field name="model">misa.invoice.exception.wizard</field>
        <field name="arch" type="xml">
            <form string="Đánh dấu ngoại lệ xuất hóa đơn MISA">
                <group>
                    <field name="picking_ids" widget="many2many_tags" readonly="1"/>
                    <field name="reason" placeholder="Vì sao chấp nhận chờ xuất hóa đơn cho (các) phiếu này?" nolabel="1"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Xác nhận" type="object" class="btn-primary"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
