<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_misa_invoice_status_scan" model="ir.cron">
        <field name="name">MISA Invoice Status Scan</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="state">code</field>
        <field name="code">model._cron_scan_misa_invoice_status()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_misa_customs_pending_scan" model="ir.cron">
        <field name="name">MISA Customs Invoice Pending Match Scan</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="state">code</field>
        <field name="code">model._cron_scan_misa_customs_pending()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
</odoo>
