<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Thêm cấu hình môi trường Sandbox/Production vào shopee.shop form -->
    <record id="view_shopee_shop_env_ext" model="ir.ui.view">
        <field name="name">shopee.shop.env.ext</field>
        <field name="model">shopee.shop</field>
        <field name="inherit_id" ref="sale_shopee.shopee_shop_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='account_id']" position="after">
                <field name="is_sandbox" widget="boolean_toggle"
                       string="Môi trường Sandbox (Test)"
                       help="Bật nếu đang dùng Test Partner_id — sẽ gọi https://openplatform.sandbox.test-stable.shopee.sg thay vì Production URL."/>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_refresh_shopee_token" type="object"
                        string="Làm mới Token Shopee"
                        class="btn btn-warning"
                        icon="fa-refresh"
                        confirm="Gọi Shopee API để lấy access_token mới bằng refresh_token hiện tại?"/>
            </xpath>
        </field>
    </record>
</odoo>
