<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- TREE VIEW (Bulk Editor) -->
        <record id="view_product_template_bulk_tree" model="ir.ui.view">
            <field name="name">product.template.bulk.tree</field>
            <field name="model">product.template</field>
            <field name="arch" type="xml">
                <list string="Sửa nhanh sản phẩm" editable="bottom" multi_edit="1" sample="1">
                    <field name="default_code" optional="show" width="100px" string="Mã nội bộ"/>
                    <field name="name" optional="show" string="Tên sản phẩm"/>
                    <field name="barcode" optional="show" string="Mã vạch"/>
                    <field name="list_price" string="Giá bán lẻ" optional="show" widget="monetary"/>
                    <field name="x_studio_ga_web" string="Giá Web" optional="show" widget="monetary"/>
                    <field name="x_studio_ga_hng_nim_yt" string="Giá Niêm Yết" optional="show" widget="monetary"/>
                    <field name="x_studio_ga_bn_thng_mi" string="Giá Thương Mại" optional="show" widget="monetary"/>
                    <field name="uom_id" optional="hide" string="Đơn vị tính"/>
                    <field name="active" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                </list>
            </field>
        </record>

        <!-- ACTION -->
        <record id="action_product_bulk_editor" model="ir.actions.act_window">
            <field name="name">Sửa nhanh sản phẩm</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">product.template</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_product_template_bulk_tree"/>
            <field name="domain">['|', ('active', '=', True), ('active', '=', False)]</field> <!-- Show archived too if needed, or default -->
            <field name="context">{'search_default_filter_to_sell': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Tạo sản phẩm mới
                </p>
            </field>
        </record>

        <!-- MENU -->
        <menuitem id="menu_product_bulk_editor_root"
                  name="Sửa Nhanh (Bulk)"
                  web_icon="product_bulk_editor,static/description/icon.png"
                  sequence="5"/>

        <menuitem id="menu_product_bulk_editor_action"
                  name="Bảng giá sản phẩm"
                  parent="menu_product_bulk_editor_root"
                  action="action_product_bulk_editor"
                  sequence="10"/>

    </data>
</odoo>
