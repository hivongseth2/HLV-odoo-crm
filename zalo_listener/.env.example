# Chép thành .env rồi điền. File .env KHÔNG commit (đã có trong .gitignore).
# Địa chỉ Odoo (không có / ở cuối)
ODOO_URL=https://ten-database.odoo.com
# Khoá lấy ở Odoo: Cài đặt → Mua hàng → Hỏi giá NCC → Khoá máy nghe Zalo
ODOO_KEY=
# Tên máy nghe hiện trong Odoo (menu Zalo nhóm NCC → Máy nghe)
LISTENER_NAME=may-nghe-1
# Thư mục dữ liệu: SQLite, cookie đăng nhập, ảnh / file, log. Để ở ổ máy — KHÔNG đặt trong Google Drive / Dropbox.
DATA_DIR=./data
# Bao nhiêu giây đẩy tin về Odoo một lần
PUSH_INTERVAL_S=15
